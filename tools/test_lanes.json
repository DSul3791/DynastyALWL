{
	"version": 1,
	"note": "Hand-kept rules for tools/tests_for_diff.py and tools/run_tests.sh (gate fix, Tyler 25 Oct 2026; owners Sal, Kathleen, Sonny review their parts). Test names are src/worldgen/tools/<name>.gd without .gd. A name that does not exist is reported by `tests_for_diff.py --check-lanes`. The selector adds to these by following the files each test loads (preload, load, res:// strings, class_name use, directories); anything it cannot place means MORE tests, never fewer.",
	"timing": ["test_animals", "test_npcs", "test_bed", "test_fish_schools"],
	"retry": ["test_animals", "test_npcs", "test_bed", "test_fish_schools"],
	"serial_extra": [],
	"serial_note": "The serial lane = the timing tests plus every test the scan finds writing a fixed file outside user:// (listed under `serial` by --print-lanes). Each parallel job also gets its own data dir, so user:// folders never collide.",
	"slow": ["test_worldgen", "test_head_pond_fill", "test_water_soak", "test_drainage_flow", "test_tile_lakes"],
	"release": ["test_head_pond_fill", "test_water_soak", "test_drainage_flow", "test_tile_lakes"],
	"slow_triggers": ["src/worldgen/**", "src/water/**", "data/water/**", "data/water_settle.json", "data/water_flow.json", "addons/**", "worlds/**"],
	"slow_mode": "closure",
	"tooling_globs": ["tools/test_lanes.json", "tools/run_tests.sh", "tools/run_one_test.sh", "tools/test_args.txt", "tools/godot_slot.sh", "tools/tests_for_diff.py", "tools/selftest_gate_tools.sh"],
	"slow_exclude": ["src/worldgen/tools/**"],
	"offline_globs": ["tools/erosion_precarve/**", "tools/**/*.py", "tools/merge_day.sh", "tools/merge_watch.sh", "tools/merge_watch_loop.sh", "tools/rebake_check.sh", "tools/world_alive.sh", "tools/world_alive.gd", "TARGETS.md", "MERGE_WATCH.md", "WORLD_ALIVE_LOG.md", "TYLER_*.md"],
	"always": ["test_inventory", "test_server_items", "test_items_persistence", "test_save_compat", "test_structure_look", "test_placement_rules", "test_new_player", "test_skills", "test_first_hour", "test_playability_bot", "test_block_roundtrip"],
	"item_group": {
		"checks": ["validate_items"],
		"paths": ["data/items/**", "src/shared/item_table.gd", "src/shared/recipe_table.gd"],
		"name_patterns": ["items", "inventory", "craft", "recipe", "blueprint", "structure", "bed", "eat", "fish", "bow", "traps", "carcass", "hunt", "vitals", "shore", "dishes", "sickness", "spoilage", "stations", "trade", "worn", "offhand", "pick_axes", "thatch", "campfire", "hammer", "auto_", "first_hour", "new_player", "coin", "tool_looks", "showroom", "forge", "ladder", "tier", "persistence", "save_compat", "placed_clearing", "placement"]
	},
	"path_rules": [
		{
			"why": "drainage and live water code: the small fast tests that replaced the big tile tests",
			"paths": ["src/worldgen/tile/tile_drainage.gd", "src/worldgen/tile/drainage_*.gd", "src/water/**", "data/water_settle.json", "data/water_flow.json", "data/water/**"],
			"tests": ["test_drainage_small", "test_water_small", "test_water_hub_small", "test_drainage_natural", "test_drainage_fill"]
		},
		{
			"why": "Kathleen: looks and pieces",
			"paths": ["src/client/piece_look.gd", "src/client/basic_look.gd", "src/client/building_look.gd", "src/client/inventory_view.gd", "src/client/*_look.gd", "src/client/avatar*", "src/client/**/avatar*", "src/client/held_item.gd", "src/client/look_table.gd", "data/items/looks.json", "data/items/structures.json", "data/items/clothing.json", "data/look/**"],
			"tests": ["test_tool_looks", "test_pick_axes", "test_look_table", "test_structure_look", "test_thatch_pieces", "test_placement_rules", "test_blueprints", "test_hammer_list"],
			"checks": ["check_look_names.py", "warnings"]
		},
		{
			"why": "sound slots read client sources as text",
			"paths": ["data/sound/**", "src/client/slot_sounds.gd", "src/client/placed_sounds.gd", "src/client/animal_view.gd", "src/client/sound_test_menu.gd", "scenes/terrain_client/terrain_client.gd"],
			"tests": ["test_slot_sounds", "test_batch3_slots"]
		},
		{
			"why": "protocol and net constants are used everywhere",
			"paths": ["src/stream/terrain_net.gd", "PROTOCOL.md"],
			"tests": ["@all_fast"]
		}
	],
	"extra_inputs": [
		{
			"why": "Tyler: the playability bot reads CONTROLS.md and the recipes",
			"paths": ["CONTROLS.md"],
			"tests": ["test_playability_bot"]
		},
		{
			"why": "Sonny: baked tiles, water and plan inputs",
			"paths": ["worlds/base_world/tiles/**", "worlds/base_world/water/**", "worlds/base_world/plan/*.json", "data/water_settle.json", "addons/**"],
			"tests": ["test_worldgen", "test_head_pond_fill", "test_water_soak", "test_drainage_flow", "test_drainage_natural", "test_tile_lakes", "test_river_ore", "test_river_surface", "test_tile_height_format", "test_spawn_dry", "test_gen_core"],
			"pin": true
		}
	],
	"shared_all": ["project.godot", "tools/warning_baseline.txt"],
	"bake_regex": "^(src/worldgen/(tile|plan|sketch|tables|matrix|settings)/|src/worldgen/runtime/(terrain_layout|terrain_generator|flora_placer|tile_terrain_data)\\.gd|worlds/base_world/)|(world_elevation|river_network)\\.gd$",
	"docs_globs": ["docs/**", "tech/**", "design/**", "proposed_removals/**", "art/**/*.md", "*.md", "**/*.md", "*.txt", "**/*.txt"],
	"known_prefixes": ["src/", "scenes/", "data/", "tools/", "assets/", "addons/", "worlds/", "art/", ".github/"],
	"known_files": ["CONTROLS.md", "project.godot", "export_presets.cfg", ".gitignore", ".gitattributes", "icon.svg", "icon.svg.import"],
	"picture_paths": ["data/items/looks.json", "data/items/clothing.json", "data/look/**", "src/client/*_look.gd", "src/client/avatar*", "src/client/inventory_view.gd", "src/client/held_item.gd", "src/debug/item_cam.gd", "assets/models/**"],
	"timeout_s": {"fast": 300, "timing": 300, "slow": 1500}
}
