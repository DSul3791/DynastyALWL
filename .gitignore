# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Baked tile files (large, rebuilt by the generator)
worlds/*/tiles/*
# Except the starter tile, so every session has it without rebaking (about 9 MB;
# each rebake adds that much to the history, so commit it only after real changes).
!worlds/base_world/tiles/tile_3_4.tile
# The eight neighbors of the starter tile too (owner commits all nine after a bake).
!worlds/base_world/tiles/tile_2_3.tile
!worlds/base_world/tiles/tile_2_4.tile
!worlds/base_world/tiles/tile_2_5.tile
!worlds/base_world/tiles/tile_3_3.tile
!worlds/base_world/tiles/tile_3_5.tile
!worlds/base_world/tiles/tile_4_3.tile
!worlds/base_world/tiles/tile_4_4.tile
!worlds/base_world/tiles/tile_4_5.tile
godot_path.txt

# Godot import settings for the generated sounds: each machine writes its own
# (they differ between Windows and the Linux cloud build), so they are not tracked.
assets/audio/**/*.import
__pycache__/

# Real admin keys never go in the repository (data/admin.example.json shows the shape)
data/admin.json
crash_reports/telemetry_server_*.log
crash_reports/*.txt

# Once-per-run bake setup cache (src/worldgen/tile/setup_cache.gd)
worlds/*/setup_cache/
