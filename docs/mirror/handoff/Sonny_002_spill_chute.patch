+# A plunge pool that is not closed: its water would rise to the lowest rim around it, and when that
+# rim is not the river's own way out it spills a second way (build 617: the south valley below the
+# head pond, a 300 m fall of thin water down bare slope). Finds that lowest other rim by a minimax
+# flood from the pool (the highest ground on the cheapest way out in each direction) and, when it
+# is about as low as the river's own way out, returns a river dictionary for a clean chute from
+# that saddle down the fall line; else {}.
+func _find_spill(carved: PackedFloat32Array, centre: Vector2, points: PackedVector2Array, parent_area: float) -> Dictionary:
+	var reach: int = int(round(float(_rules.get("spill_radius_m", 96.0)) / spacing_m))
+	var margin: int = 24
+	var ci: int = int(round(centre.x))
+	var cj: int = int(round(centre.y))
+
+	if ci - reach < margin or cj - reach < margin or ci + reach >= samples - margin or cj + reach >= samples - margin:
+		return {}
+
+	# The river's way on, as a bearing from the pool.
+	var downstream: Vector2 = Vector2.ZERO
+
+	for point in points:
+		if point.distance_to(centre) * spacing_m > float(_rules.get("spill_radius_m", 96.0)) * 0.6 and (point - centre).dot(downstream) >= 0.0:
+			downstream = (point - centre).normalized()
+			break
+
+	if downstream == Vector2.ZERO:
+		return {}
+
+	var side: int = reach * 2 + 1
+	var cost: PackedFloat32Array = PackedFloat32Array()
+	cost.resize(side * side)
+	cost.fill(INF)
+	var parent: PackedInt32Array = PackedInt32Array()
+	parent.resize(side * side)
+	parent.fill(-1)
+	var done: PackedByteArray = PackedByteArray()
+	done.resize(side * side)
+	var start: int = reach * side + reach
+	cost[start] = carved[cj * samples + ci]
+
+	while true:
+		var pick: int = -1
+		var pick_cost: float = INF
+
+		for n in range(side * side):
+			if done[n] == 0 and cost[n] < pick_cost:
+				pick_cost = cost[n]
+				pick = n
+
+		if pick < 0:
+			break
+
+		done[pick] = 1
+		var px: int = pick % side
+		var pz: int = floori(float(pick) / float(side))
+
+		for dz in range(-1, 2):
+			for dx in range(-1, 2):
+				var qx: int = px + dx
+				var qz: int = pz + dz
+
+				if (dx == 0 and dz == 0) or qx < 0 or qz < 0 or qx >= side or qz >= side:
+					continue
+
+				var q: int = qz * side + qx
+				var through: float = maxf(pick_cost, carved[(cj + qz - reach) * samples + ci + qx - reach])
+
+				if done[q] == 0 and through < cost[q]:
+					cost[q] = through
+					parent[q] = pick
+
+	var min_angle: float = cos(deg_to_rad(float(_rules.get("spill_min_angle_deg", 75.0))))
+	var exit_cost: float = INF
+	var best: int = -1
+	var best_cost: float = INF
+
+	for n in range(side * side):
+		var nx: int = n % side - reach
+		var nz: int = floori(float(n) / float(side)) - reach
+
+		if maxi(absi(nx), absi(nz)) != reach or is_inf(cost[n]):
+			continue
+
+		var along: float = Vector2(float(nx), float(nz)).normalized().dot(downstream)
+
+		if along > min_angle:
+			exit_cost = minf(exit_cost, cost[n])
+		elif cost[n] < best_cost:
+			best_cost = cost[n]
+			best = n
+
+	if best < 0 or best_cost > exit_cost + float(_rules.get("spill_margin_m", 3.0)):
+		return {}
+
+	# The saddle: the highest cell on the cheapest way out.
+	var saddle: int = best
+	var walk: int = best
+
+	while walk >= 0:
+		if carved[(cj + floori(float(walk) / float(side)) - reach) * samples + ci + walk % side - reach] >= carved[(cj + floori(float(saddle) / float(side)) - reach) * samples + ci + saddle % side - reach]:
+			saddle = walk
+
+		walk = parent[walk]
+
+	var here: Vector2i = Vector2i(ci + saddle % side - reach, cj + floori(float(saddle) / float(side)) - reach)
+	var path: PackedVector2Array = PackedVector2Array([Vector2(here)])
+	var seen: Dictionary = {here: true}
+	var flat_slope: float = float(_rules.get("spill_flat_slope", 0.04))
+	var window: int = 12
+
+	for step in range(int(_rules.get("spill_max_cells", 400))):
+		var lowest: Vector2i = here
+		var best_drop: float = 0.0
+		var here_h: float = carved[here.y * samples + here.x]
+
+		for dz in range(-1, 2):
+			for dx in range(-1, 2):
+				var next: Vector2i = here + Vector2i(dx, dz)
+
+				if (dx == 0 and dz == 0) or seen.has(next):
+					continue
+
+				var drop: float = (here_h - carved[next.y * samples + next.x]) / (1.41421 if dx != 0 and dz != 0 else 1.0)
+
+				if drop > best_drop:
+					best_drop = drop
+					lowest = next
+
+		if lowest == here:
+			break
+
+		here = lowest
+		seen[here] = true
+		path.append(Vector2(here))
+		var idx: int = here.y * samples + here.x
+
+		if here.x < margin or here.y < margin or here.x >= samples - margin or here.y >= samples - margin or water_class[idx] != 0 or _ocean[idx] == 1:
+			break
+
+		if path.size() > window + 8:
+			var back: Vector2 = path[path.size() - 1 - window]
+			var fall: float = (carved[int(back.y) * samples + int(back.x)] - carved[idx]) / (float(window) * spacing_m)
+
+			if fall < flat_slope:
+				break
+
+	if path.size() < 16:
+		return {}
+
+	# Smooth the staircase of the grid path.
+	for _pass in range(3):
+		var soft: PackedVector2Array = path.duplicate()
+
+		for k in range(1, path.size() - 1):
+			soft[k] = (path[k - 1] + path[k] * 2.0 + path[k + 1]) * 0.25
+
+		path = soft
+
+	var areas: PackedFloat32Array = PackedFloat32Array()
+	areas.resize(path.size())
+	areas.fill(maxf(parent_area * float(_rules.get("spill_area_share", 0.4)), float(_rules.get("river_start_km2", 0.05))))
+	return {"points": path, "areas": areas, "source": false, "spill": true}
+
+
 func _stream_depth(depth: float, width: float, flow_factor: float = 1.0) -> float:
 	var q_max: float = float(_rules.get("spring_base_m3s", 3.0)) * float(_rules.get("spring_rate_max", 20.0)) * flow_factor
 	var flow_depth: float = pow(q_max / (1.7 * maxf(width, 1.0)), 2.0 / 3.0)
@@ -1380,6 +1560,10 @@ func _terrace(
 	var face_slope: float = float(_rules.get("terrace_face_bank", 30.0))
 	var width_min: float = float(_rules.get("terrace_width_min_m", 16.0))
 	var width_max: float = float(_rules.get("terrace_width_max_m", 24.0))
+
+	if _spill_mode:
+		width_min = spacing_m
+		width_max = float(_rules.get("spill_chute_width_m", 16.0))
 	var used: PackedInt32Array = PackedInt32Array()
 
 	for k in range(points.size()):
