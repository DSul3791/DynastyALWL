# Auto detect text files and perform LF normalization
* text=auto
*.bat text eol=crlf
*.sh text eol=lf
tools/godot text eol=lf
*.import text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.yaml text eol=lf
# The animal models, bought and Dave's own (Dave 23 and 28 Nov 2026: in the repository through Git LFS, R-REPO-PUBLIC); their .import notes stay plain text. Clones that do
# not need the models skip them: tools/skip_models.sh.
assets/animals/**/*.fbx filter=lfs diff=lfs merge=lfs -text
assets/animals/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/animals/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/animals/**/*.png filter=lfs diff=lfs merge=lfs -text
