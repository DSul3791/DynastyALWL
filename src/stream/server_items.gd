	_characters[key]["new_player"] = true
	_characters[key]["comfort"] = 0.0   # a fresh start empties the comfort meter
	_characters[key]["tried"] = {}
	_characters[key]["grace_s"] = _eat_cfg_value("first_hour_s", 3600.0)
	_vitals[key] = _new_vitals()
	_soak.erase(peer)
	_craft_queues.erase(key)
	_asleep.erase(peer)
	_admin_mode_on.erase(peer)
	_known[peer] = {}
	send_full.call(peer, _inventories[key].to_bytes())
	_send_favs(peer, _inventories[key])
	_vitals_sent.erase(peer)
	_sync_vitals(peer, true)
	_sync_energy(peer, true)
	_sync_warmth(peer, true)
	_sync_sick(peer, true)
	_sync_worn(peer, true)
	_sync_craft_queue(peer)
	_dirty = true
	_say(peer, "You start again as a new player. Admin mode is off.")


func _new_vitals() -> Dictionary:
	return {"fed": float(_vitals_cfg.get("stomach_cap_kcal", 2400)), "weight": float(_vitals_cfg.get("start_weight_kg", 75)), "health": float(_vitals_cfg.get("health_max", 100)), "wet": float(_vitals_cfg.get("thirst", {}).get("cap_ml", 2400)), "energy": 100.0, "warmth": 100.0, "sick": 0.0}


# How hard the player is working, 0 to 1: movement speed from position reports, lifted by recent tool work.
func exertion_of(peer: int) -> float:
	if int(_strain.get(peer, {}).get("state", 0)) >= 2 or strain_going(peer):
		return 0.0

	return minf(effort_of(peer), 1.0)


# The same without the ceiling (a heavy pack can push it past 1): what strain builds on.
func effort_of(peer: int) -> float:
	var level: float = float(_exertion.get(peer, 0.0))

	if Time.get_ticks_msec() < int(_work_until.get(peer, 0)):
		level = maxf(level, float(_work_level.get(peer, 0.6)))

	# Vomiting and diarrhoea keep the body working at least exertion_floor (data/items/sickness.json) until the sickness fades.
	if float(vitals_of(peer).get("sick", 0.0)) > 0.0:
		level = maxf(level, float(_sick_cfg.get("exertion_floor", 0.5)))

	# Shivering is work (data/items/warmth.json shiver_effort), more the colder.
	if not _warmth_cfg.is_empty():
		var cold_at: float = float(_warmth_cfg.get("cold_at", 40.0))
		var warmth: float = float(vitals_of(peer).get("warmth", 100.0))

		if warmth >= float(_body_cfg().get("shiver_stop_at", -1.0)):   # the body stops shivering deep in the cold (docs/design/body_in_weather_design.md 4)
			level += float(_warmth_cfg.get("shiver_effort", 0.15)) * maxf(cold_at - warmth, 0.0) / maxf(cold_at, 1.0)

		level += float(_layers_cfg().get("heat_effort", 0.5)) * float(_overheat.get(peer, 0.0))   # too warmly dressed for the heat is work too

	# Armour past effort_free_kg is work on the move (protection.json): plate tires; clothing and light leather never make a walk non-restful.
	level += float(_moving.get(peer, 0.0)) * float(_protection_cfg.get("effort_per_kg", 0.0)) * maxf(_armour_kg(peer) - float(_protection_cfg.get("effort_free_kg", 0.0)), 0.0)

	# A pack past 80 percent of the limit is work for anyone on the move, even at a crawl: load_effort x fraction^power added.
	if not _carry_cfg.is_empty():
		level += float(_moving.get(peer, 0.0)) * float(_carry_cfg.get("load_effort", 0.45)) * pow(_load_ratio(peer), float(_carry_cfg.get("load_effort_power", 1.5)))
		level += float(_moving.get(peer, 0.0)) * _carts.pull_effort(peer)   # a loaded cart in hand

	return level


# How far into the hindering band the load is: 0 up to 80 percent of the limit, 1 at the limit.
var _load_cache: Dictionary = {}     # peer -> load ratio, valid only during one _vitals_tick (it asks four times per player)
var _in_vitals: bool = false
var _kg_cache: Dictionary = {}       # peer -> carried kg, valid only during one _vitals_tick
var _cover_cache: Dictionary = {}    # position -> cover_at, valid only during one _vitals_tick (warmth and soak asked three times per player)
# Also kept for one _vitals_tick only (soak at 64 players, 26 Nov 2026: vitals 123 ms a second, the largest server part; each look asked
# these five to eight times a player): the worn numbers and the Rested row (the armour now follows _dress_of). Nothing inside the tick changes what is
# worn, and the comfort meter's write drops that player's Rested row. A death inside the tick runs outside them (_vitals_tick).
var _worn_cache: Dictionary = {}     # peer -> worn_of
var _rested_cache: Dictionary = {}   # peer -> rested_tier
var vitals_memo: bool = true         # false: the kept readings (these and _dress_of) worked out live each time (test_vitals_tick_cost compares the two)
var _unit_kg: Dictionary = {}        # item number -> [kilograms of one, holds water]: weight_of walks the suffix list; weights.json does not change
var _unit_kg_cfg: Dictionary = {}    # the _carry_cfg and table _unit_kg was worked out from (a test may swap either)
var _unit_kg_table = null


func _vitals_caches_clear() -> void:
	_load_cache.clear()
	_kg_cache.clear()
	_cover_cache.clear()
	_worn_cache.clear()
	_rested_cache.clear()


func _vitals_forget(peer: int) -> void:
	_load_cache.erase(peer)
	_kg_cache.erase(peer)
	_worn_cache.erase(peer)
	_rested_cache.erase(peer)


# cover_at at `pos`, worked out once per position during a _vitals_tick. Nothing that changes cover (building, felling) runs inside it.
func _vitals_cover(pos: Vector3) -> float:
	if not cover_at.is_valid():
		return 0.0

	if not _in_vitals:
		return float(cover_at.call(pos))

	if not _cover_cache.has(pos):
		_cover_cache[pos] = float(cover_at.call(pos))

	return float(_cover_cache[pos])


func _load_ratio(peer: int) -> float:
	if _carry_cfg.is_empty():
		return 0.0

	if _in_vitals and _load_cache.has(peer):
		return float(_load_cache[peer])

	var body: float = _carry_body(peer)
	var ratio: float = CarryRules.load_fraction(carried_kg_of(peer), body, _carry_cfg)

	if _in_vitals:
		_load_cache[peer] = ratio

	return ratio


# Stance changes (0 stand, 1 crouch, 2 sit, 3 lie). Fainted or waking players cannot choose; the answer
# (the confirmed stance) goes back in the next strain message.
func _set_stance(peer: int, wanted: int) -> void:
	if wanted < 0 or wanted > 3 or not _peer_key.has(peer) or _forced_sleep(peer):
		return

	if int(_strain.get(peer, {}).get("state", 0)) < 2 and not strain_going(peer):
		_stance[peer] = wanted

		if wanted != 3:
			_end_sleep(peer)

	_strain_sent.erase(peer)


# --- Sleep (job 86, data/items/sleep.json) ---
func sleeping_of(peer: int) -> bool:
	return _asleep.has(peer)


# --- Energy (job 95, data/items/energy.json) ---
func energy_of(peer: int) -> float:
	return float(vitals_of(peer).get("energy", 100.0))


func _forced_sleep(peer: int) -> bool:
	return _asleep.has(peer) and bool(_asleep[peer].get("forced", false))


# Drains with game time by exertion, refills by resting; at 0 the character collapses asleep until the pool is full again.
func _energy_tick(peer: int, v: Dictionary, _spent: float, game_s: float) -> void:
	if _energy_cfg.is_empty():
		return

	var e: float = float(v.get("energy", 100.0))
	var hours: float = game_s / 3600.0
	var drain: Dictionary = _energy_cfg.get("drain_per_game_day", {})
	var rec: Dictionary = _energy_cfg.get("recover_per_game_hour", {})
	e -= (float(drain.get("rest", 12.0)) + float(drain.get("work", 42.0)) * exertion_of(peer)) * game_s / 86400.0 * minf(float(rested_tier(peer).get("exhaustion_mult", 1.0)), food_mult(peer, "exhaustion_mult"))   # Rested or Bread and grains, the larger, never both
	var stance: int = int(_stance.get(peer, 0))

	if _forced_sleep(peer):
		e += float(rec.get("sleep", 12.5)) * hours
	elif _asleep.has(peer):
		e += lerpf(float(rec.get("lie", 8.3)), float(rec.get("sleep", 12.5)), clampf(_sleep_quality(peer), 0.0, 1.0)) * hours
	elif stance == 3 and not crawling_of(peer):
		e += float(rec.get("sleep", 12.5) if on_good_bed(peer) else rec.get("lie", 8.3)) * hours
	elif stance == 2 and e < float(_energy_cfg.get("sit_cap", 75.0)):
		e = minf(e + float(rec.get("sit", 9.4)) * hours, float(_energy_cfg.get("sit_cap", 75.0)))

	e = clampf(e, 0.0, 100.0)
	v["energy"] = e

	if e <= 0.0 and not _forced_sleep(peer) and int(_strain.get(peer, {}).get("state", 0)) < 2:
		_stance[peer] = 3
		_asleep[peer] = {"rested": 0.0, "forced": true, "t": 0.0}
		save_soon()   # lying down to sleep
		_note_shelter(peer)
		_strain_sent.erase(peer)
		_say(peer, "You collapse with exhaustion")
	elif _forced_sleep(peer) and _night_left <= 0.0 and e >= float(_energy_cfg.get("forced", {}).get("wake_at", 100.0)) and float(_strain.get(peer, {}).get("s", 0.0)) <= 0.02:
		_end_sleep(peer)
		_strain_sent.erase(peer)
		_say(peer, "You wake rested")

	_sync_energy(peer, false)


func _sync_energy(peer: int, force: bool) -> void:
	if not send_energy.is_valid():
		return

	var pct: int = int(ceil(clampf(energy_of(peer), 0.0, 100.0)))

	if force or int(_energy_sent.get(peer, -1)) != pct:
		_energy_sent[peer] = pct
		send_energy.call(peer, pct)


# An energy supplement (vitals.json energy_aids; master s3.16 [D17]): no permanent cost and never refused. Its energy comes at once only
# when its food group's slot is newly filled or had run out (step "fresh"), so it cannot stand in for sleep.
# A medicine or energy aid that is also a drink (the herbal teas, vitals.json drink: a cup of water, coordinator ruling for Dave, 23 Nov 2026)
# adds its millilitres to thirst, up to the cap, beside its cure or energy. True when it added any.
func _tea_quenches(v: Dictionary, item_id: String) -> bool:
	var ml: int = VitalsRules.drink_value(item_id, _vitals_cfg)
	var cap: float = float(_vitals_cfg.get("thirst", {}).get("cap_ml", 2400))

	if ml <= 0 or float(v.get("wet", 0.0)) >= cap - 1.0:
		return false

	v["wet"] = minf(float(v.get("wet", 0.0)) + float(ml), cap)
	return true


func _use_energy_aid(peer: int, inv, slot: int, v: Dictionary, aid: Dictionary, step: Dictionary) -> void:
	var item_id: String = table.id_of(inv.numbers[slot])
	_last_eat[peer] = Time.get_ticks_msec()
	inv.take_from_slot(slot, 1)

	if FoodEffects.profile(item_id, _food_cfg).is_empty() or bool(step.get("fresh", false)):   # a declined question (step {}) gives no energy either
		v["energy"] = minf(float(v.get("energy", 100.0)) + float(aid.get("energy", 0)), 100.0)
	else:
		_say(peer, "It does not lift you again so soon.")

	if _tea_quenches(v, item_id):   # a herbal tea is a cup of water too
		_sync_vitals(peer, true)

	_food_apply(peer, item_id, step, false)
	_sync_energy(peer, true)
	_dirty = true


# a = 1: fall asleep (lying, not fainted, not in rain on open ground); a = 0: wake.
func _sleep(peer: int, want: int) -> void:
	if not _peer_key.has(peer) or _sleep_cfg.is_empty():
		return

	if want == 0:
		if not _forced_sleep(peer):
			_wake(peer, "You wake, not fully rested" if energy_of(peer) < 99.0 else "")
		elif energy_of(peer) >= float(_energy_cfg.get("forced", {}).get("manual_wake_at", 30.0)) and float(_strain.get(peer, {}).get("s", 0.0)) <= 0.3:
			# Dave 2026-10-22: after an exhaustion collapse the sleeper may wake early once the energy is back to manual_wake_at.
			_end_sleep(peer)
			_strain_sent.erase(peer)
			_say(peer, "You wake, not fully rested")

		return

	if _asleep.has(peer):
		return

	if int(_stance.get(peer, 0)) != 3 or int(_strain.get(peer, {}).get("state", 0)) >= 2:
		return

	if _sleep_quality(peer) < 0.0:
		_say(peer, "Rain falls on you: find cover to sleep")
		return

	# Dave 2026-10-21: with full energy you cannot sleep, unless exertion is high: then a short nap brings it down fast.
	var nap: Dictionary = _sleep_cfg.get("nap", {})
	var strain_now: float = float(_strain.get(peer, {}).get("s", 0.0))
	var exertion_share: float = strain_now / maxf(float(_exertion_cfg.get("over_on", 1.0)), 0.01)
	var napping: bool = false

	if not nap.is_empty() and energy_of(peer) >= float(nap.get("energy_full", 99.0)):
		if exertion_share <= float(nap.get("exertion_min", 0.75)):
			_say(peer, str(nap.get("say_rested", "You are well rested, you really can't sleep right now")))
			return

		napping = true

	_asleep[peer] = {"rested": 0.0, "t": 0.0}
	save_soon()   # lying down to sleep

	if napping:
		var end_strain: float = float(nap.get("exertion_end", 0.25)) * float(_exertion_cfg.get("over_on", 1.0))
		_asleep[peer]["nap"] = true
		_asleep[peer]["nap_end"] = end_strain
		_asleep[peer]["nap_rate"] = maxf(strain_now - end_strain, 0.0) / maxf(float(nap.get("target_s", 10.0)), 1.0)

	_waking.erase(peer)
	_strain_sent.erase(peer)
	_note_shelter(peer)
	_say(peer, "You lie down for a nap" if napping else "You fall asleep")


# Dave 2026-10-21: a dead character comes back at the last shelter they slept in. Sleeping within SHELTER_NOTE_M of a standing
# shelter structure (structures.json "shelter", the lean-to) keeps its spot in the character row (characters.json "shelter").
const SHELTER_NOTE_M := 3.0


func _shelter_near(pos: Vector3) -> int:
	var best: int = -1
	var best_d: float = SHELTER_NOTE_M

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or not bool(_structures.get(str(it["struct"]["kind"]), {}).get("shelter", false)):
			continue

		var d: float = Vector2(it["pos"].x - pos.x, it["pos"].z - pos.z).length()

		if d < best_d:
			best_d = d
			best = id

	return best


# The places a character rested or built a shelter (characters.json "rests", newest last, at most REST_POINTS_MAX): [x, y, z, "shelter" or "fire"].
# A player whose saved spot is now built over with no clear room near it comes back at the nearest of these (rest_point_for, _safe_resume).
const REST_POINTS_MAX := 12


func _record_rest(key: String, pos: Vector3, kind: String) -> void:
	if not _characters.has(key):
		return

	var rests: Array = _characters[key].get("rests", [])

	for r in rests:
		if Vector3(float(r[0]), float(r[1]), float(r[2])).distance_to(pos) < 1.0:
			return

	rests.append([pos.x, pos.y, pos.z, kind])

	while rests.size() > REST_POINTS_MAX:
		rests.remove_at(0)

	_characters[key]["rests"] = rests
	_dirty = true


# Where a character whose saved spot is built over comes back: the nearest of their rest and shelter points (by distance from `from`) that still stands,
# in front of it; with none, their last shelter or the world spawn. Computed when they rejoin, never stored.
func rest_point_for(peer: int, from: Vector3) -> Vector3:
	var best: Vector3 = Vector3.ZERO
	var best_d: float = INF

	for r in _characters.get(_peer_key.get(peer, ""), {}).get("rests", []):
		var spot: Vector3 = Vector3(float(r[0]), float(r[1]), float(r[2]))
		var landing: Vector3 = Vector3.INF

		if str(r[3]) == "shelter":
			var id: int = _shelter_near(spot)

			var found_def: Dictionary = _structures.get(str(_items[id]["struct"]["kind"]), {}) if id >= 0 else {}

			if id >= 0 and _shelter_floor(_items[id]["pos"], found_def).distance_to(spot) <= 0.5:
				var def: Dictionary = found_def
				var yaw: float = deg_to_rad(float(_items[id]["struct"]["yaw"]))
				landing = spot + Vector3(cos(yaw), 0.0, sin(yaw)) * (maxf(float(def.get("half_x", 1.0)), float(def.get("half_z", 1.0))) + 1.5)
		else:
			for id in _items:
				if _items[id].has("fire") and _items[id]["pos"].distance_to(spot) <= 0.5:
					landing = spot + Vector3(1.5, 0.0, 0.0)
					break

		if landing != Vector3.INF and landing.distance_to(from) < best_d:
			best_d = landing.distance_to(from)
			best = landing

	return best if best_d < INF else respawn_for(peer)


# Where a shelter is rested in or returned to: its spot, but for a roof panel or corner (its spot is its middle, metres above the floor it covers) the floor under it, the
# foundation top there else the ground, so a player never wakes or respawns in mid-air under a roof that sits on a wall top.
func _shelter_floor(pos: Vector3, def: Dictionary) -> Vector3:
	if not str(def.get("piece_kind", "")) in [PlacementRules.ROOF_PANEL_KIND, PlacementRules.ROOF_HIP_KIND]:
		return pos

	var top: float = PlacementRules.foundation_top(_structures_cfg, pos, _foundation_rows())

	if is_nan(top) and ground_height.is_valid():
		top = float(ground_height.call(pos.x, pos.z))

	return pos if is_nan(top) else Vector3(pos.x, top, pos.z)


func _note_shelter(peer: int) -> void:
	if not _peer_pos.has(peer) or not _characters.has(_peer_key.get(peer, "")):
		return

	var id: int = _shelter_near(_peer_pos[peer])

	if id < 0:
		for fire_id in _items:
			if _items[fire_id].has("fire") and _items[fire_id]["pos"].distance_to(_peer_pos[peer]) <= SHELTER_NOTE_M:
				_record_rest(str(_peer_key[peer]), _items[fire_id]["pos"], "fire")
				break

		return

	var p: Vector3 = _shelter_floor(_items[id]["pos"], _structures.get(str(_items[id]["struct"]["kind"]), {}))
	_record_rest(str(_peer_key[peer]), p, "shelter")

	var row: Dictionary = _characters[_peer_key[peer]]

	if row.get("shelter", []) != [p.x, p.y, p.z]:
		row["shelter"] = [p.x, p.y, p.z]
		_dirty = true


# The spawn point a player chooses (Dave 31 Oct 2026): E on a placed bed offers "Set this bed as your spawn point" (ACT_SET_SPAWN). One per character, saved in
# characters.json "spawn_bed" [x, y, z]; a new choice unsets the old; if that bed is taken down or destroyed the character comes back at the spawn pad.
func set_spawn_bed(peer: int, bed_id: int) -> bool:
	var it: Dictionary = _items.get(bed_id, {})
	var key: String = str(_peer_key.get(peer, ""))

	if it.is_empty() or not it.has("struct") or not _is_bed_kind(str(it["struct"].get("kind", ""))) or key == "" or not _characters.has(key) or not _peer_pos.has(peer):
		return false

	if _peer_pos[peer].distance_to(it["pos"]) > Interact.server_reach_m() + 1.0:
		_say(peer, "Too far from the bed.")
		return false

	var p: Vector3 = it["pos"]
	_characters[key]["spawn_bed"] = [p.x, p.y, p.z]
	_dirty = true
	_say(peer, "Spawn point set")
	return true


# The bed standing at the saved spawn spot, 0 when it is gone.
func _spawn_bed_id(peer: int) -> int:
	var saved: Array = _characters.get(_peer_key.get(peer, ""), {}).get("spawn_bed", [])

	if saved.size() != 3:
		return 0

	var spot := Vector3(float(saved[0]), float(saved[1]), float(saved[2]))

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and _is_bed_kind(str(it["struct"].get("kind", ""))) and it["pos"].distance_to(spot) <= 0.5:
			return id

	return 0


var _bed_deaths: Dictionary = {}    # player key -> msecs of the recent deaths that came back at their bed (bed.json respawn)


# A bed that keeps killing its sleeper (the danger is still there): after max_in_window deaths inside window_s the next one comes back elsewhere. Counts the death when it says yes.
func _bed_death_allowed(key: String) -> bool:
	var cfg: Dictionary = _bed_cfg.get("respawn", {})
	var now: int = Time.get_ticks_msec()
	var window_ms: int = int(float(cfg.get("window_s", 600.0)) * 1000.0)
	var recent: Array = (_bed_deaths.get(key, []) as Array).filter(func(t): return now - int(t) < window_ms)
	_bed_deaths[key] = recent

	if recent.size() >= int(cfg.get("max_in_window", 2)):
		return false

	recent.append(now)
	return true


# A free place beside the bed: a ring from landing_m out to search_m, nearest first, on ground within 2 m of the bed's height and not inside a structure; none free = the bed's own spot
# plus 0.3 m (the old behaviour), never the void.
func _bed_landing(bed: Vector3) -> Vector3:
	var cfg: Dictionary = _bed_cfg.get("respawn", {})
	var r: float = float(cfg.get("landing_m", 1.2))
	var max_r: float = float(cfg.get("search_m", 3.0))

	var rows: Array = _foundation_rows()   # a bed in a house: the player lands on the floor beside it, not inside the slab at the generated ground

	while r <= max_r + 0.001:
		for k in 8:
			var a: float = TAU * float(k) / 8.0
			var spot: Vector3 = bed + Vector3(cos(a) * r, 0.0, sin(a) * r)
			var ground: float = _remains_surface(spot, rows) if ground_height.is_valid() else bed.y

			if not is_nan(ground) and absf(ground - bed.y) < 2.0 and not _blocked_spot(spot, bed):
				return Vector3(spot.x, ground + 0.1, spot.z)

		r += 0.5

	return bed + Vector3(0.0, 0.3, 0.0)


func _blocked_spot(spot: Vector3, bed: Vector3) -> bool:
	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or absf(it["pos"].y - spot.y) > 3.0:
			continue

		var def: Dictionary = _structures.get(str(it["struct"].get("kind", "")), {})

		if bool(def.get("walkover", false)):
			continue

		var reach: float = maxf(float(def.get("footprint_x", 1.0)), float(def.get("footprint_z", 1.0))) * 0.5

		if Vector2(it["pos"].x - bed.x, it["pos"].z - bed.z).length() < reach:
			continue   # the shelter the bed stands in (a lean-to): landing under its roof is the point

		if Vector2(it["pos"].x - spot.x, it["pos"].z - spot.z).length() < reach + 0.35:
			return true

	return false


# Where this character comes back: at their spawn bed if they set one and it still stands (a bed that is gone is forgotten and the spawn pad is used), else just in front of
# their last shelter if it still stands, else the world spawn.
func respawn_for(peer: int, dying: bool = false) -> Vector3:
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})

	if (row.get("spawn_bed", []) as Array).size() == 3:
		var bed: int = _spawn_bed_id(peer)

		if bed == 0:
			row.erase("spawn_bed")
			_dirty = true
			return respawn_point

		if not dying or _bed_death_allowed(str(_peer_key.get(peer, ""))):
			return _bed_landing(_items[bed]["pos"])
		# else: the third death in the window falls through to the shelter rule or the world spawn below (the bed stays set)

	var saved: Array = _characters.get(_peer_key.get(peer, ""), {}).get("shelter", [])

	if saved.size() != 3:
		return respawn_point

	var spot := Vector3(float(saved[0]), float(saved[1]), float(saved[2]))
	var id: int = _shelter_near(spot)

	var def: Dictionary = _structures.get(str(_items[id]["struct"]["kind"]), {}) if id >= 0 else {}

	if id < 0 or _shelter_floor(_items[id]["pos"], def).distance_to(spot) > 0.5:
		return respawn_point

	var yaw: float = deg_to_rad(float(_items[id]["struct"]["yaw"]))
	var out: float = maxf(float(def.get("half_x", 1.0)), float(def.get("half_z", 1.0))) + 1.5
	return spot + Vector3(cos(yaw), 0.0, sin(yaw)) * out


func _wake(peer: int, why: String) -> void:
	if not _end_sleep(peer):
		return

	_strain_sent.erase(peer)
	_say(peer, why if why != "" else "You wake")


# Sleep ends (any reason): the wake fade starts. True when the player was asleep.
func _end_sleep(peer: int) -> bool:
	if not _asleep.erase(peer):
		return false

	_waking[peer] = {"t": 0.0}
	save_soon()   # waking: the night's rest
	return true


# Real seconds until a sleeper wakes by themselves: the longer of the energy still to fill (at the rate sleeping here refills
# it, game hours at 24:1) and the exertion still to rest off (strain falls at the lying rate times the sleep multiplier).
func sleep_eta(peer: int) -> float:
	if not _asleep.has(peer):
		return 0.0

	if bool(_asleep[peer].get("nap", false)):
		var left: float = maxf(float(_strain.get(peer, {}).get("s", 0.0)) - float(_asleep[peer]["nap_end"]), 0.0)
		return left / maxf(float(_asleep[peer]["nap_rate"]), 0.001)

	var rec: Dictionary = _energy_cfg.get("recover_per_game_hour", {})
	var rate: float = float(rec.get("sleep", 12.5)) if _forced_sleep(peer) else lerpf(float(rec.get("lie", 8.3)), float(rec.get("sleep", 12.5)), clampf(_sleep_quality(peer), 0.0, 1.0))
	var energy_s: float = maxf(100.0 - energy_of(peer), 0.0) / maxf(rate, 0.1) * 3600.0 / GAME_RATE
	var cfg: Dictionary = _exertion_cfg
	var strain: float = float(_strain.get(peer, {}).get("s", 0.0))
	var fall: float = float(cfg.get("fall_per_s", 0.05)) * (float(_sleep_cfg.get("strain_mult", 6.0)) if not _forced_sleep(peer) else float(cfg.get("lie_fall_mult", 3.0))) * maxf(float(cfg.get("rest_effort", 0.52)), 0.1)
	return maxf(energy_s, strain / maxf(fall, 0.001)) + float(_sleep_cfg.get("rested_s", 1.5))


# 1 under a roof or crown, the open-dry value in the open, -1 when rain reaches the sleeper (cannot sleep there).
# A bed is a structure whose comfort kind (comfort.json) is of class "bed": the rough bed, the straw bed, the feather bed, the canopy bed. Sleep, the good-bed bonuses, the
# spawn point and the bed-in-a-shelter placement all find any of them.
func _is_bed_kind(kind: String) -> bool:
	if kind == "rough_bed":
		return true

	return str(_comfort_kind(str(_structures.get(kind, {}).get("comfort", kind))).get("class", "")) == "bed"


# The rough bed under a lying player (bed.json): the world id of the nearest placed rough_bed within reach, or 0. Looked up at most every
# recheck_s; a bed that is gone (taken up, destroyed) is dropped from the cache at once, so nothing keeps a sleeper "in bed".
func _bed_of(peer: int) -> int:
	if _bed_cfg.is_empty() or int(_stance.get(peer, 0)) != 3 or not _peer_pos.has(peer):
		_bed_cache.erase(peer)
		return 0

	var now: int = Time.get_ticks_msec()
	var entry: Dictionary = _bed_cache.get(peer, {})

	if not entry.is_empty() and int(entry["id"]) != 0 and not _items.has(int(entry["id"])):
		entry = {}

	if not entry.is_empty() and now < int(entry["until"]):
		return int(entry["id"])

	var here: Vector3 = _peer_pos[peer]
	var reach: float = float(_bed_cfg.get("reach_m", 1.2))
	var best: int = 0
	var best_d: float = INF

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or not _is_bed_kind(str(it["struct"].get("kind", ""))):
			continue

		var d: float = Vector2(it["pos"].x - here.x, it["pos"].z - here.z).length()

		if d <= reach and d < best_d and absf(it["pos"].y - here.y) < 3.0:
			best = int(id)
			best_d = d

	_bed_cache[peer] = {"id": best, "until": now + int(float(_bed_cfg.get("recheck_s", 1.5)) * 1000.0)}
	return best


# A lying player on a rough bed that has cover over it (roof or crown): the only case the bed's advantages apply.
func on_good_bed(peer: int) -> bool:
	return _bed_of(peer) != 0 and cover_at.is_valid() and float(cover_at.call(_peer_pos[peer])) > 0.5


# True when that good bed stands in a closed room: a roof (cover 2.0, a built one) and walls_needed wall pieces near it. Animals do not sense the sleeper.
func _bed_room_closed(peer: int) -> bool:
	if not on_good_bed(peer) or float(cover_at.call(_peer_pos[peer])) < 1.5:
		return false

	var here: Vector3 = _peer_pos[peer]
	var radius: float = float(_bed_cfg.get("walls_radius_m", 3.0))
	var walls: int = 0

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and str(_structures.get(str(it["struct"].get("kind", "")), {}).get("piece_kind", "")) == "wall" and Vector2(it["pos"].x - here.x, it["pos"].z - here.z).length() <= radius:
			walls += 1

	return walls >= int(_bed_cfg.get("walls_needed", 3))


# How fast food and water drain right now: bed.json drain_mult asleep or lying on a good bed, asleep_ground_mult asleep anywhere else, 1 otherwise.
func _drain_mult(peer: int) -> float:
	if _bed_cfg.is_empty():
		return 1.0

	if on_good_bed(peer):
		return float(_bed_cfg.get("drain_mult", 0.5))

	return float(_bed_cfg.get("asleep_ground_mult", 1.0)) if _asleep.has(peer) else 1.0


func _sleep_quality(peer: int) -> float:
	var q: Dictionary = _sleep_cfg.get("quality", {})
	var covered: bool = cover_at.is_valid() and _peer_pos.has(peer) and float(cover_at.call(_peer_pos[peer])) > 0.5

	if covered:
		return float(_bed_cfg.get("quality", 1.0)) if on_good_bed(peer) else float(q.get("covered", 1.0))

	if _rain_here(_peer_pos.get(peer, Vector3.ZERO)) >= float(_sleep_cfg.get("rain_wakes", 0.2)):
		return -1.0   # a bedroll is not a roof

	if _has_bedroll(peer):
		return float(_sleep_cfg.get("bedroll", {}).get("open_dry", q.get("open_dry", 0.6)))

	return float(q.get("open_dry", 0.6))


# A Bedroll in the pack (sleep.json "bedroll", Part C plan 5): better sleep on open dry ground and a little warmth lying down. Not a bed: no
# spawn point, and nothing that asks "on a good bed" counts it.
func _has_bedroll(peer: int) -> bool:
	var id: String = str(_sleep_cfg.get("bedroll", {}).get("item", "bedroll"))
	return count_for(peer, id) > 0 or worn_of(peer).has(table.number_of(id))   # in the pack or strapped to the worn pack (catalog Phase 5)


# Who is where and under which key: for the NPC runner and the admin check.
func peer_positions() -> Array:
	return _peer_pos.values()


# Stances in the same order as peer_positions (0 stand, 1 crouch, 2 sit, 3 lie): wildlife notices a crouching player later.
func peer_stances() -> Array:
	var out: Array = []

	for peer in _peer_pos:
		var stance: int = int(_stance.get(peer, 0))

		if stance == 3 and on_good_bed(peer):
			stance = 5 if _bed_room_closed(peer) else 4   # 4 lying on a covered bed, 5 in a closed room: server_animals reads them as lying, harder to sense

		out.append(stance)

	return out


# The hunting skill's effect on stalking (skills.json actions.stalk) for each player, in the same order as peer_positions: a
# skilled hunter rustles less pushing through bushes (server_animals _sample_noise).
func peer_stalk_factors() -> Array:
	var out: Array = []

	for peer in _peer_pos:
		out.append(skill_factor(peer, "stalk"))

	return out


# What the wolf pack brain may know about each player: where, how they stand, health share, whether they carry raw meat, a
# spear or a torch on the hotbar (the server does not know the selected slot).
# The wolves ask every frame; the carried gear is worked out again only when the pack or what they wear changed (a native hash of the pack's
# slots, counts, wear and instance data and the worn rows): walking every player's pack and bags each frame took a fifth of the server's main
# thread at 16 players (load test 23 Nov 2026).
var _wolf_gear: Dictionary = {}   # peer -> [signature, meat, meat_cooked, spear] (the torch is torch_burning, read live)


func wolf_info() -> Array:
	var out: Array = []
	var gear_now: Dictionary = {}

	for peer in _peer_pos:
		var inv = inventory_of(peer)

		if inv == null:
			continue

		var sig: int = hash([inv.numbers, inv.counts, inv.wear, inv.inst, _characters.get(_peer_key.get(peer, ""), {}).get("worn", [])])
		var gear: Array = _wolf_gear.get(peer, [])

		if gear.is_empty() or int(gear[0]) != sig:
			gear = [sig, carried_count(peer, "raw_meat") > 0, carried_count(peer, "roast_meat") > 0, _tool_slot(inv, "spear") >= 0]

		gear_now[peer] = gear
		var v: Dictionary = vitals_of(peer)
		out.append({"peer": peer, "pos": _peer_pos[peer], "stance": int(_stance.get(peer, 0)),
			"hp": float(v.get("health", 100.0)) / maxf(float(_vitals_cfg.get("health_max", 100)), 1.0),
			"meat": gear[1], "meat_cooked": gear[2], "spear": gear[3], "torch": torch_burning(peer)})   # a torch or lantern burning in hand, as the keep-off ring (fire_spots): not one put out or left on the hotbar

	_wolf_gear = gear_now   # a player who left is dropped
	return out


# A trail sign the player spotted (protocol 153): Tracking once per sign (server_traps.gd sign_found).
func sign_spotted(peer: int, at: Vector2) -> bool:
	return _traps.sign_found(peer, at)


# An animal near a player stepped from `from` to `to` (server_animals.gd snare_pass): a set trap it has just come up to may take it.
func animal_passed(animal_id: int, sp: String, from: Vector3, to: Vector3) -> void:
	if _traps != null:
		_traps.on_pass(animal_id, sp, from, to)


# World ids that may lie within r (flat) of a point, for the animals' searches (finding 8, docs/ai-team/audits/2026-11-18_oversized_reactions_audit.md):
# the last world sync's NEAR_M cells that the circle touches, plus every id made since that sync; every id when no sync has filed a grid yet.
# The caller checks each id is still there and how far it is.
func _ids_near(centre: Vector3, r: float) -> Array:
	if _sync_grid.is_empty():
		return _items.keys()

	var out: Array = _cells_near(centre, r)

	for id in range(_sync_grid_next, _next_id):
		out.append(id)

	return out


# Loose food lying on the ground within r of a point, for a fox to smell: [[world id, position], ...]. Chests, remains, fires and
# placed things are not loose; whatever is in a chest or a pack is safe.
func loose_food_near(centre: Vector3, r: float) -> Array:
	var out: Array = []

	for id in _ids_near(centre, r):
		if _is_loose_food(id) and Vector2(_items[id]["pos"].x - centre.x, _items[id]["pos"].z - centre.z).length() <= r:
			out.append([id, _items[id]["pos"]])

	return out


# Where loose food `id` lies, or null when it is gone (taken, eaten, picked up) or is no longer loose food: a fox after it reads it by id.
func loose_food_pos(id: int) -> Variant:
	return _items[id]["pos"] if _is_loose_food(id) else null


func _is_loose_food(id: int) -> bool:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or it.has("struct") or it.has("fire") or it.has("tree") or it.has("boulder") or it.has("scatter"):
		return false

	return str(table.entry(table.id_of(int(it["number"]))).get("kind", "")) == "food"


# A thief takes a loose item whole: [item number, count], or [] when it is no longer there.
func take_loose(id: int) -> Array:
	if not _items.has(id):
		return []

	var it: Dictionary = _items[id]
	var out: Array = [int(it["number"]), int(it["count"])]
	_items.erase(id)
	_dirty = true
	return out


# Goblins steal (docs/design/goblin_stealing_design.md, Dave 8 Nov 2026): loose small things lying on the ground within r of a point,
# [[world id, position, dropped by (character key or ""), item kind, item id], ...]. Not structures, fires, trees, boulders, natural scatter or the showroom; not a shoulder carry (logs); not a
# structure, placeable or container item. Whatever is in a chest or a pack is safe. Light and den piles are the goblin's own checks.
const STEAL_NEVER_KINDS := ["structure", "placeable", "container"]


func stealable_near(centre: Vector3, r: float) -> Array:
	var out: Array = []

	for id in _ids_near(centre, r):
		if not _items.has(id):
			continue   # taken since the last sync filed it

		var it: Dictionary = _items[id]

		if it.has("struct") or it.has("fire") or it.has("tree") or it.has("boulder") or it.has("scatter") or it.has("showroom") or it.has("inst") or int(it["count"]) <= 0:
			continue   # an item with instance data is never stolen: a goblin's loot keeps only the item number, so it would lose it

		if Vector2(it["pos"].x - centre.x, it["pos"].z - centre.z).length() > r:
			continue

		var row: Dictionary = table.entry(table.id_of(int(it["number"])))

		if row.is_empty() or row.has("carry") or STEAL_NEVER_KINDS.has(str(row.get("kind", ""))):
			continue

		out.append([id, it["pos"], str(it.get("by", "")), str(row.get("kind", "")), table.id_of(int(it["number"]))])

	return out


# A goblin takes one piece of a loose stack: [item number, 1], or [] when it is no longer there. The rest of the stack stays.
func take_one(id: int) -> Array:
	if not _items.has(id) or int(_items[id]["count"]) <= 0:
		return []

	var it: Dictionary = _items[id]
	it["count"] = int(it["count"]) - 1

	if int(it["count"]) <= 0:
		_items.erase(id)

	_dirty = true
	return [int(it["number"]), 1]


# Whether a burning placed fire (a campfire, a hearth, a forge: not a torch bearer) lies within r of a point (flat distance). A goblin
# band does not come back to a cave while one burns this near its mouth (Dave 8 Nov 2026, decision 13).
func lit_fire_near(point: Vector3, r: float) -> bool:
	for row in _lit_rows():
		if Vector2(row[0].x - point.x, row[0].z - point.z).length() <= r:
			return true

	return false


# Wolves steal: every raw and roast meat leaves the pack and the bags carried in it or worn (they smell it there too). Returns how many pieces went.
func take_all_meat(peer: int) -> int:
	var total: int = 0

	for id in ["raw_meat", "roast_meat"]:
		var n: int = count_for(peer, id)

		if n > 0 and take_from(peer, id, n):
			total += n

		total += _take_from_bags(peer, table.number_of(id))

	return total


# How many of an item a player carries: the pack, the bags in it and the worn bags (catalog Phase 5).
func carried_count(peer: int, id: String) -> int:
	var inv = inventory_of(peer)
	var number: int = table.number_of(id)

	if inv == null or number <= 0:
		return 0

	var total: int = inv.count_of(number)

	for slot in inv.slot_count:
		total += _rows_count(inv.inst_of(slot).get("bag", []), number)

	for raw in _characters.get(_peer_key.get(peer, ""), {}).get("worn", []):
		if typeof(raw) == TYPE_ARRAY and (raw as Array).size() > 3 and typeof(raw[3]) == TYPE_DICTIONARY:
			total += _rows_count(raw[3].get("bag", []), number)

	return total


static func _rows_count(rows: Array, number: int) -> int:
	var total: int = 0

	for row in rows:
		total += int(row[1]) if int(row[0]) == number else 0

	return total


# Takes every unit of an item out of the bags a player carries (in the pack and worn); returns how many. Outside an action, so it writes back itself.
func _take_from_bags(peer: int, number: int) -> int:
	var inv = inventory_of(peer)

	if inv == null or number <= 0:
		return 0

	var taken: int = 0
	var before: Array = _snapshot(inv)

	for slot in inv.slot_count:
		var held: int = _rows_count(inv.inst_of(slot).get("bag", []), number)

		if held > 0:
			var bag = BagRules.open(table, inv.numbers[slot], inv.inst[slot])
			bag.remove(number, held)
			inv.inst[slot] = BagRules.store(bag, inv.inst[slot])
			taken += held

	_send_changes(peer, inv, before)

	for place in worn_of(peer).size():
		var bag = _worn_bag(peer, place)
		var held: int = bag.count_of(number) if bag != null else 0

		if held > 0:
			bag.remove(number, held)
			taken += held

		_end_bag_edit(peer)

	return taken


# An attack on a player: wolf bites (data/animals/animals.json "wolves"), big game and goblin charges. Never a fall, cold, hunger or sickness,
# which take health directly. Worn armour stops its share first (protection_of in the attack's damage mode: `mode`, else protection.json
# attack_modes by the cause, else its default_mode; `pen` is a weapon's armour penetration), and every piece that protects wears by the hit.
# Not lethal: health stops at maim_hp and the bite reports "maimed" (a crippling injury; the pack then backs off). Lethal (a player already
# maimed): with death.json stop_at_1 (on) it stops at 1 and reports "maimed" again; off, health can reach zero and the character dies.
# `from` is where the blow came from (the attacker's position; NO_FROM when unknown): a raised shield stops its share of a blow from the front
# (shield_share). Returns "hurt", "maimed" or "dead".
func hurt_player(peer: int, amount: float, lethal: bool, cause: String, floor_hp: float = 25.0, mode: String = "", pen: float = 0.0, from: Vector3 = NO_FROM) -> String:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty() or _parked.has(peer):
		return "hurt"   # an absent player (a dropped line, ABSENT_MS): a blow from an attacker that still held it as its target lands on nothing

	if _cold_out.has(peer) or bool(_strain.get(peer, {}).get("rescued", false)):
		return "hurt"   # passed out from cold or water: nothing hurts them until they are up again, the wake after the rescue included (coordinator 27 Nov 2026)

	var guard: float = shield_share(peer, from)   # a raised shield takes its share of a blow from the front first, and wears by it

	if guard > 0.0:
		_wear_shield(peer, guard * amount)
		amount *= 1.0 - guard

	var stopped: float = protection_of(peer, mode if mode != "" else attack_mode(cause), pen)
	_wear_armour(peer, amount)
	amount *= 1.0 - stopped
	amount *= comfort_bonus(peer, "damage_taken_mult")   # the comfort meter: at 10 health counts double (half harm), saved health never changes
	var before: float = float(v["health"])
	v["health"] = before - amount

	if hurt_heard.is_valid():
		hurt_heard.call(peer, amount)   # the others near hear the blow land (server_action_cues.gd hurt)

	if lethal and bool(_death_cfg.get("stop_at_1", false)):
		lethal = false   # nothing kills (death.json stop_at_1, Dave 23 Nov 2026): a lethal blow stops at 1 and counts as crippling again
		floor_hp = 1.0

	if lethal and float(v["health"]) <= 0.0:
		v["health"] = 0.0
		_sync_vitals(peer, true)
		return "dead" if kill(peer, cause) else "hurt"

	if not _forced_sleep(peer):
		_end_sleep(peer)   # any blow wakes a sleeper, maiming ones too

	if not lethal and float(v["health"]) <= floor_hp:
		v["health"] = minf(before, floor_hp)
		_say(peer, "The wolves have crippled you. Get away while you can." if cause == "wolves" else "You are badly hurt. Get away while you can.")
		v["limp"] = float(_vitals_cfg.get("limp", {}).get("seconds", 600.0))
		_sync_limp(peer, false)
		_sync_vitals(peer, true)
		return "maimed"

	_sync_vitals(peer, false)
	return "hurt"


const NO_FROM := Vector3.INF   # hurt_player: the blow's origin is not known, so no shield can be judged against it
const HAND_SHIELD_UP := 4       # held_item.gd HAND_SHIELD_UP: the client says B is held with a shield in the left hand (protocol 159 held_item)


# The pack slot of the shield this player holds raised, -1 for none: the client's shield-up flag (hand_flags, protocol 159) with a shield
# (items.json "block") in the left hand (left_hand_number: only while the pack still holds it) that is not broken.
func _raised_shield_slot(peer: int) -> int:
	if (hand_flags(peer) & HAND_SHIELD_UP) == 0:
		return -1

	var number: int = left_hand_number(peer)
	var inv = inventory_of(peer)

	if number <= 0 or inv == null or float(table.entry(table.id_of(number)).get("block", 0.0)) <= 0.0:
		return -1

	for slot in range(inv.slot_count):
		if inv.numbers[slot] == number and not _is_broken(inv, slot):
			return slot

	return -1


# The share of a blow from `from` that this player's raised shield stops (coordinator for Dave, 23 Nov 2026, provisional): the shield's
# items.json block when the attacker stands within the front arc (protection.json shield_arc_deg, 120) of the way the body faces; nothing
# from the side or behind, nothing when the origin or facing is unknown.
func shield_share(peer: int, from: Vector3) -> float:
	if not from.is_finite() or not yaw_of.is_valid():
		return 0.0

	var slot: int = _raised_shield_slot(peer)
	var pos: Variant = position_of(peer)

	if slot < 0 or pos == null:
		return 0.0

	var block: float = clampf(float(table.entry(table.id_of(inventory_of(peer).numbers[slot])).get("block", 0.0)), 0.0, 0.95)
	var to: Vector2 = Vector2(from.x - (pos as Vector3).x, from.z - (pos as Vector3).z)

	if to.length() < 0.05:
		return block   # the attacker is on top of the player: the shield is between them

	var yaw: float = float(yaw_of.call(peer))
	var facing: Vector2 = Vector2(-sin(yaw), -cos(yaw))   # the body faces -Z turned by its yaw (server_action_cues.gd hands_of)
	var half: float = deg_to_rad(float(_protection_cfg.get("shield_arc_deg", 120.0)) * 0.5)
	return block if absf(facing.angle_to(to)) <= half else 0.0


# The raised shield takes the blow it stopped: wear by protection.json wear_per_damage, as worn armour; at its maximum a wooden one is gone,
# a metal one stays in the pack, broken, until it is repaired (_tool_broke).
func _wear_shield(peer: int, blocked: float) -> void:
	var slot: int = _raised_shield_slot(peer)
	var inv = inventory_of(peer)

	if slot < 0 or inv.max_durability(slot) <= 0:
		return

	var before: Array = _snapshot(inv)
	inv.wear[slot] = mini(inv.wear[slot] + maxi(1, int(round(blocked * float(_protection_cfg.get("wear_per_damage", 1.0))))), inv.max_durability(slot))
	_dirty = true

	if _is_broken(inv, slot):
		_tool_broke(peer, inv, slot, table.entry(table.id_of(inv.numbers[slot])))

	_send_changes(peer, inv, before)


# The damage mode of an attack by its cause (an animal species or "wolves"; protection.json attack_modes, else default_mode).
func attack_mode(cause: String) -> String:
	return str(_protection_cfg.get("attack_modes", {}).get(cause, _protection_cfg.get("default_mode", "blunt")))


# One blow of a weapon row (items.json damage, damage_mode, pen): its damage with the craftsmanship bonus (master s2.9 item 4), its damage mode
# and its armour penetration. A blow on a player goes through hurt_player with this mode and pen.
static func weapon_blow(entry: Dictionary, item_inst: Dictionary) -> Dictionary:
	return {"damage": float(entry.get("damage", 0.0)) + SmithingRules.damage_bonus(item_inst), "mode": str(entry.get("damage_mode", "blunt")), "pen": float(entry.get("pen", 0.0))}


# The share of a hit in `mode` the worn pieces stop (master s3.7 rules 1-3; data/items/protection.json): per slot, each sound piece's
# protect[mode] x cover x (1 - pen), layered largest first with diminishing returns (_layered at layer_keep) and capped at slot_cap; the slots
# weighted by where blows land (slots); the whole capped at cap, so no outfit is immune. A broken piece stops nothing.
func protection_of(peer: int, mode: String, pen: float = 0.0) -> float:
	var by_slot: Dictionary = {}

	for piece in worn_slots_of(peer):
		if int(piece[0]) <= 0:
			continue

		var entry: Dictionary = table.entry(table.id_of(int(piece[0])))
		var stop: float = float(entry.get("protect", {}).get(mode, 0.0)) * float(entry.get("cover", 1.0)) * clampf(1.0 - pen, 0.0, 1.0)
		var most: int = SmithingRules.max_of(entry, piece[3])

		if stop <= 0.0 or (most > 0 and int(piece[2]) >= most):
			continue

		var slot: String = str(entry.get("slot", ""))

		if not by_slot.has(slot):
			by_slot[slot] = []

		by_slot[slot].append(stop)

	var total: float = 0.0

	for slot in by_slot:
		total += float(_protection_cfg.get("slots", {}).get(slot, 0.0)) * minf(_layered(by_slot[slot], float(_protection_cfg.get("layer_keep", 0.5))), float(_protection_cfg.get("slot_cap", 0.85)))

	return clampf(total, 0.0, float(_protection_cfg.get("cap", 0.75)))


# A hit wears every worn piece that protects and has a durability by its damage x wear_per_damage x the piece's cover (at least 1). A piece that
# breaks stays worn and protects nothing until it is taken off and mended at its repair_station (master s3.7 rule 4); a disposable one is gone.
func _wear_armour(peer: int, amount: float) -> void:
	var worn: Array = worn_slots_of(peer)
	var changed: bool = false
	var gone: bool = false

	for i in worn.size():
		var number: int = int(worn[i][0])
		var entry: Dictionary = table.entry(table.id_of(number)) if number > 0 else {}
		var most: int = SmithingRules.max_of(entry, worn[i][3]) if number > 0 else 0

		if most <= 0 or (entry.get("protect", {}) as Dictionary).is_empty() or int(worn[i][2]) >= most:
			continue

		worn[i][2] = mini(int(worn[i][2]) + maxi(1, int(round(amount * float(_protection_cfg.get("wear_per_damage", 1.0)) * float(entry.get("cover", 1.0))))), most)
		changed = true

		if int(worn[i][2]) >= most:
			if SmithingRules.disposable(entry):
				_say(peer, "Your %s broke and is gone." % table.sentence_name(number))
				worn[i] = [0, 0, 0, {}]
				gone = true
			else:
				_say(peer, "Your %s broke. %s" % [table.sentence_name(number), _repair_hint(entry)])

	if changed:
		_characters[_peer_key[peer]]["worn"] = worn
		_dirty = true

	if gone:
		_sync_worn(peer, true)


# Kilograms of armour worn (weights.json; pieces with protect and a durability): its weight is work on the move (effort_of).
func _armour_kg(peer: int) -> float:
	var total: float = 0.0

	if _carry_cfg.is_empty():
		return total

	if vitals_memo:
		return float(_dress_of(peer)["armour"])

	return _armour_kg_of(worn_of(peer))


func _armour_kg_of(worn: Array) -> float:
	var total: float = 0.0

	for number in worn:
		var entry: Dictionary = table.entry(table.id_of(number)) if number > 0 else {}

		if entry.has("protect") and int(entry.get("durability", 0)) > 0:
			total += CarryRules.weight_of(table.id_of(number), _carry_cfg)

	return total


# What follows from the worn pieces alone, worked out again only when what is worn changes (vitals cut 2, 26 Nov 2026: insulation, heat
# load, rain shed, armour, the carry bonus and the comfort meter's dressed points were each walked over every worn piece several times a
# look, about 7 ms a pass at 64 players). The insulation keeps each slot's [warmth, wet_keep] in worn order, since the soak changes it.
var _dress: Dictionary = {}          # peer -> {"worn", "armour", "heat" (slot -> values), "shed", "bonus", "dressed", "fine", "slots"}
var _dress_from: Array = []          # [_warmth_cfg, _carry_cfg, table] the kept rows were worked out with (a test may swap one)


func _dress_of(peer: int) -> Dictionary:
	if _dress_from.size() != 3 or not is_same(_dress_from[0], _warmth_cfg) or not is_same(_dress_from[1], _carry_cfg) or not is_same(_dress_from[2], table):
		_dress.clear()
		_dress_from = [_warmth_cfg, _carry_cfg, table]

	var worn: Array = worn_of(peer)
	var kept: Dictionary = _dress.get(peer, {})

	if not kept.is_empty() and kept["worn"] == worn:
		return kept

	var slots: Dictionary = {}       # slot -> [[warmth, wet_keep], ...] in worn order, slots in first-worn order (as _layered_worn)
	var heat_by_slot: Dictionary = {}
	var covered: Dictionary = {}
	var fine: bool = true
	var shed: float = 0.0

	for number in worn:
		if number <= 0:
			continue

		var entry: Dictionary = table.entry(table.id_of(number))
		var slot: String = str(entry.get("slot", ""))
		var fabric: Dictionary = _fabric(entry)

		if not slots.has(slot):
			slots[slot] = []
			heat_by_slot[slot] = []

		slots[slot].append([float(entry.get("warmth", 0.0)), float(fabric.get("wet_keep", 1.0))])
		heat_by_slot[slot].append(float(entry.get("warmth", 0.0)) * (1.0 - float(fabric.get("breath", 1.0))))

		if slot == "body":
			shed = maxf(shed, float(fabric.get("rain_shed", 0.0)))

		if slot in ["body", "legs", "feet"]:
			covered[slot] = true
			fine = fine and str(entry.get("fabric", "")) != "plant"

	kept = {"worn": worn, "armour": _armour_kg_of(worn) if not _carry_cfg.is_empty() else 0.0, "heat": heat_by_slot,
			"shed": clampf(shed, 0.0, 1.0), "bonus": CarryRules.carry_bonus_kg(worn, table), "dressed": covered.size() == 3, "fine": fine, "slots": slots}
	_dress[peer] = kept
	return kept


# For the dialogue effects (authored lines only): how many of an item the pack holds, and give or take some.
# `ready_only`: a Maturing stack (master s3.14) does not count, for what an NPC asks or takes in payment.
func count_for(peer: int, id: String, ready_only: bool = false) -> int:
	var inv = inventory_of(peer)
	return inv.count_of(table.number_of(id), false, ready_only) if inv != null and table.number_of(id) > 0 else 0


# Bandit camps stage 4b (only while bandits.json robbery.enabled; docs/design/BANDIT_CAMPS.md): the `stacks` most valuable stacks of the pack
# (value x count) are taken whole, keeping wear and instance data, for the camp's stash. Never the item in hand, never a bag holding things,
# never coins (they live in the purse). Returns [{"id", "count", "wear", "inst"}].
func rob_stacks(peer: int, stacks: int) -> Array:
	var inv = inventory_of(peer)

	if inv == null or stacks <= 0:
		return []

	var held: int = int(_held.get(peer, 0))
	var rows: Array = []

	for i in inv.slot_count:
		var number: int = inv.numbers[i]

		if number == 0 or number == held or not (inv.inst_of(i).get("bag", []) as Array).is_empty():
			continue

		rows.append([int(table.entry(table.id_of(number)).get("value", 0)) * int(inv.counts[i]), i])

	rows.sort_custom(func(x, y): return int(x[0]) > int(y[0]) or (int(x[0]) == int(y[0]) and int(x[1]) < int(y[1])))
	var out: Array = []
	var before: Array = _snapshot(inv)

	for row in rows.slice(0, stacks):
		var gone: Dictionary = inv.take_from_slot(int(row[1]), inv.counts[int(row[1])])
		out.append({"id": table.id_of(int(gone["number"])), "count": int(gone["count"]), "wear": int(gone.get("wear", 0)), "inst": gone.get("inst", {})})

	if not out.is_empty():
		_send_changes(peer, inv, before)
		_dirty = true   # the pack is saved without them (the stash is saved by the camp)

	return out


func give_to(peer: int, id: String, count: int) -> void:
	if id.begins_with("coin_"):
		_add_coin(peer, id, count, SRC_REWARD)
		return

	var inv = inventory_of(peer)

	if inv == null or table.number_of(id) <= 0:
		return

	var before: Array = _snapshot(inv)
	var left: int = inv.add(table.number_of(id), count)   # a reward is handed over whatever the load (as before protocol 116); only MAX_SLOTS leaves any

	if left > 0:
		drop_in_world(table.number_of(id), left, _peer_pos.get(peer, Vector3.ZERO))

	_gain_source = SRC_REWARD
	_send_changes(peer, inv, before)
	_gain_source = SRC_PICKUP
	_dirty = true


# --- money and reputation (Dave 2026-10-21; data/items/coins.json, data/npcs/reputation.json, items/COINS.md) ---

func coin_copper(id: String) -> int:
	for row in _coins_cfg.get("ladder", []):
		if str(row["id"]) == id:
			return int(row["copper"])

	return 0


# The purse: the coins as held, {coin id: count} (characters.json "purse"). Coins are not item stacks: the purse is part of the character row.
# Coins keep the denomination they came in (Dave, 14 Nov 2026: "if I have gathered 200 copper I should have 200 copper until the next time I am
# talking to a vendor"); only a trader changes them into the fewest coins (redenominate, called when a trader's talk or trade window opens).
func purse_of(peer: int) -> Dictionary:
	return _characters.get(_peer_key.get(peer, ""), {}).get("purse", {})


# The purse's worth in copper.
func coins_of(peer: int) -> int:
	var total: int = 0
	var held: Dictionary = purse_of(peer)

	for id in held:
		total += int(held[id]) * coin_copper(str(id))

	return total


# The fewest coins worth `copper`, as [[coin item id, count], ...], richest first.
func purse_breakdown(copper: int) -> Array:
	var out: Array = []
	var left: int = copper

	for row in _coins_cfg.get("ladder", []):
		var each: int = maxi(int(row["copper"]), 1)

		if left >= each:
			@warning_ignore("integer_division")
			out.append([str(row["id"]), left / each])
			left = left % each

	return out


# Puts `count` coins of one kind in the purse as they are, and tells the feed. The purse's worth never passes max_copper.
func _add_coin(peer: int, id: String, count: int, source: String) -> void:
	var key: String = _peer_key.get(peer, "")
	var each: int = coin_copper(id)

	if count <= 0 or each <= 0 or not _characters.has(key):
		return

	@warning_ignore("integer_division")
	count = mini(count, maxi(int(_coins_cfg.get("max_copper", 100000000)) - coins_of(peer), 0) / each)

	if count <= 0:
		return

	var held: Dictionary = purse_of(peer).duplicate()
	held[id] = int(held.get(id, 0)) + count
	_characters[key]["purse"] = held
	_dirty = true
	sync_purse(peer)

	if send_received.is_valid():
		send_received.call(peer, id, count, source)


# Pays `copper` into the purse as that many copper coins (goal rewards, a trader's payment); a trader changes them later.
func add_coins(peer: int, copper: int, source: String = "pickup") -> void:
	_add_coin(peer, "coin_copper", copper, source)


# Takes `copper` out of the purse, all or nothing: the cheapest coins go first, and a bigger coin broken for the last of it gives its change
# back as the fewest coins. Coins the payment does not reach stay as they were.
func take_coins(peer: int, copper: int) -> bool:
	var key: String = _peer_key.get(peer, "")

	if copper < 0 or not _characters.has(key) or coins_of(peer) < copper:
		return false

	var held: Dictionary = purse_of(peer).duplicate()
	var need: int = copper
	var rows: Array = _coins_cfg.get("ladder", []).duplicate()
	rows.sort_custom(func(x, y): return int(x["copper"]) < int(y["copper"]))

	for row in rows:
		var id: String = str(row["id"])
		var each: int = maxi(int(row["copper"]), 1)

		if need <= 0 or int(held.get(id, 0)) <= 0:
			continue

		@warning_ignore("integer_division")
		var used: int = mini(int(held[id]), (need + each - 1) / each)
		held[id] = int(held[id]) - used
		need -= used * each

		if int(held[id]) <= 0:
			held.erase(id)

	for change in purse_breakdown(-need):   # need is 0 or minus the change owed
		held[change[0]] = int(held.get(change[0], 0)) + int(change[1])

	_characters[key]["purse"] = held
	_dirty = true
	sync_purse(peer)
	return true


# At a trader (a talk or trade window opening): the purse becomes the fewest coins of the same worth.
func redenominate(peer: int) -> void:
	var key: String = _peer_key.get(peer, "")

	if not _characters.has(key):
		return

	var held: Dictionary = {}

	for row in purse_breakdown(coins_of(peer)):
		held[row[0]] = int(row[1])

	if held != purse_of(peer):
		_characters[key]["purse"] = held
		_dirty = true
		sync_purse(peer)


# A purse row from characters.json: known coin ids with a positive count. An older row's "coins" (a copper worth) becomes the fewest coins.
func _clean_purse(row: Dictionary) -> Dictionary:
	var held: Dictionary = {}
	var raw: Variant = row.get("purse", {})

	if typeof(raw) == TYPE_DICTIONARY:
		for id in raw:
			if coin_copper(str(id)) > 0 and int(raw[id]) > 0:
				held[str(id)] = int(raw[id])

	if not row.has("purse"):
		for pair in purse_breakdown(maxi(int(row.get("coins", 0)), 0)):
			held[pair[0]] = int(pair[1])

	return held


# The copper amount in words, richest coin first: "2 silver, 3 bronze".
func _coin_words(copper: int) -> String:
	var parts: PackedStringArray = PackedStringArray()

	for row in purse_breakdown(copper):
		parts.append("%d %s" % [int(row[1]), str(_coin_name(str(row[0])))])

	return ", ".join(parts) if not parts.is_empty() else "nothing"


func _coin_name(id: String) -> String:
	for row in _coins_cfg.get("ladder", []):
		if str(row["id"]) == id:
