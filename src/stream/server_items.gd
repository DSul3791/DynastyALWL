func _sync_breath(peer: int, tenths: int) -> void:
	# While diving, a change of half a second or more; the hide message once.
	var last: int = int(_breath_sent.get(peer, -1))

	if tenths == last or (tenths >= 0 and last >= 0 and absi(tenths - last) < 5 and tenths != 0):
		return

	_breath_sent[peer] = tenths

	if send_breath.is_valid():
		send_breath.call(peer, tenths)


# Whether a path patch has its centre within data/path_speed.json range_m of the player, checked at most once a second per player, among the
# grid cells round the player that the last full sync filed and the ids made since (_ids_near; it walked every world item, per player, every
# second: audit 18 Nov 2026 finding 3). Before the first sync there is no grid: every item, as before.
func _on_path(peer: int, position: Vector3) -> bool:
	var now: int = Time.get_ticks_msec()
	var cached: Array = _on_path_cache.get(peer, [])

	if not cached.is_empty() and now - int(cached[0]) < 1000:
		return bool(cached[1])

	var reach: float = float(_path_cfg.get("range_m", 3.0))
	var found: bool = false
	var road: bool = false

	for id in _ids_near(position, reach):
		if not _items.has(id):
			continue

		var other: Dictionary = _items[id]

		if other.has("struct") and str(other["struct"]["kind"]) == "path_patch" and Vector2(other["pos"].x - position.x, other["pos"].z - position.z).length() <= reach:
			found = true
			road = bool(other["struct"].get("road", false))

			if road:
				break

	_on_path_cache[peer] = [now, found, road]
	return found


# Bandit site traffic (docs/design/BANDIT_CAMPS.md): a player on a surveyed road counts "road", on a hand path "path", pulling a loaded cart
# along either "cart"; off every path "" (the mover is forgotten). Reuses the once-a-second path look-up above.
func _note_road_trip(peer: int, position: Vector3) -> void:
	if not road_trip.is_valid():
		return

	if not _on_path(peer, position):
		road_trip.call(peer, position, "")
		return

	var pulling: bool = _carts.puller_of.has(peer) and float(_carts.pulls.get(int(_carts.puller_of[peer]), {}).get("share", 0.0)) > 0.0   # the load share the cart's last move worked out: no item scan per report
	road_trip.call(peer, position, "cart" if pulling else ("road" if bool(_on_path_cache[peer][2]) else "path"))


# What of the world items round `at` a person would mark on a map (server_map.gd landmarks, Dave 23 Nov 2026): [kind, x, z, label] rows.
# A campfire (not a camp's own fire or a bandit camp's signs); a rock with ore in it (or a fallen star) started and not finished, as
# "ore_rock:<ore>"; and every path patch as "path", or "road" for a surveyed road. The NEAR_M grid of the last world sync: no scan of the world.
func map_marks_near(at: Vector3, r: float) -> Array:
	var out: Array = []

	for id in _ids_near(at, r):
		var it: Dictionary = _items.get(id, {})

		if it.is_empty() or Vector2(it["pos"].x - at.x, it["pos"].z - at.z).length() > r:
			continue

		if it.has("fire"):
			if not it["fire"].has("camp") and not it["fire"].has("marks"):
				out.append(["campfire", it["pos"].x, it["pos"].z, ""])
		elif it.has("boulder"):
			var info: Dictionary = it["boulder"]

			if info.has("ore") and int(it["count"]) < int(info.get("total", 0)) and int(it["count"]) > 0 and MAP_ORE_LABELS.has(str(info["ore"])):
				out.append(["ore_rock:" + str(info["ore"]), it["pos"].x, it["pos"].z, MAP_ORE_LABELS[str(info["ore"])]])
		elif it.has("struct") and str(it["struct"].get("kind", "")) == "path_patch":
			out.append(["road" if bool(it["struct"].get("road", false)) else "path", it["pos"].x, it["pos"].z, ""])

	return out


const MAP_ORE_LABELS := {"copper": "Copper", "tin": "Tin", "iron": "Iron", "coal": "Coal", "salt": "Salt", "meteorite": "Meteorite"}   # boulders.json ore items


func _map_catch(peer: int, from: Variant) -> void:
	if fish_caught.is_valid() and from is Vector3:
		fish_caught.call(peer, from)   # good fishing spots on the Map (server_map note_catch)


# Metres from a spot to the nearest surveyed road patch within r, or INF (a bandit site stands off a road).
func road_distance(at: Vector3, r: float) -> float:
	var near: Vector3 = road_point(at, r)
	return Vector2(near.x - at.x, near.z - at.z).length() if near.x != INF else INF


# The nearest surveyed road patch's position within r of `at`, or Vector3.INF (where a bandit camp's tracks leave the road).
func road_point(at: Vector3, r: float) -> Vector3:
	var best: float = INF
	var best_at: Vector3 = Vector3.INF

	for id in _ids_near(at, r):
		if _items.has(id) and _items[id].has("struct") and str(_items[id]["struct"]["kind"]) == "path_patch" and bool(_items[id]["struct"].get("road", false)):
			var d: float = Vector2(_items[id]["pos"].x - at.x, _items[id]["pos"].z - at.z).length()

			if d < best:
				best = d
				best_at = _items[id]["pos"]

	return best_at if best <= r else Vector3.INF


# True when a placed building (SurveyLine.is_building: not a path, bed, remains or carcass; a campfire counts, as on the survey line) stands
# within r of a spot.
func building_near(at: Vector3, r: float) -> bool:
	for id in _ids_near(at, r):
		if not _items.has(id) or not (_items[id].has("struct") or _items[id].has("fire")) or _items[id].get("fire", {}).has("marks"):
			continue   # a bandit camp's boot prints are not a building

		var kind: String = str(_items[id]["struct"]["kind"]) if _items[id].has("struct") else ""

		if (kind == "" or SurveyLine.is_building(kind, _structures.get(kind, {}))) and Vector2(_items[id]["pos"].x - at.x, _items[id]["pos"].z - at.z).length() <= r:
			return true

	return false


# Effort (0 to 1) for a ground speed: straight lines through exertion.json effort_by_speed ([speed m/s, effort] pairs).
func _effort_at_speed(speed: float) -> float:
	var anchors: Array = _exertion_cfg.get("effort_by_speed", [[0.2, 0.0], [3.2, 0.4], [9.0, 1.0]])

	if speed <= float(anchors[0][0]):
		return float(anchors[0][1])

	for n in range(1, anchors.size()):
		if speed <= float(anchors[n][0]):
			var from: Array = anchors[n - 1]
			var to: Array = anchors[n]
			return lerpf(float(from[1]), float(to[1]), (speed - float(from[0])) / (float(to[0]) - float(from[0])))

	return float(anchors[anchors.size() - 1][1])


var _snow_memo: Dictionary = {}     # peer -> [the metre cell last asked about, whether its surface is snow]


# Is the ground under `position` snow or glacial ice (snow_walk.json soils)? Asked once per metre cell the player enters.
func _on_snow(peer: int, position: Vector3) -> bool:
	if not ground_material.is_valid():
		return false

	var cell: Vector2i = Vector2i(floori(position.x), floori(position.z))
	var memo: Array = _snow_memo.get(peer, [])

	if (memo.is_empty() or memo[0] != cell) and not _tile_ready_at(position):
		return not memo.is_empty() and bool(memo[1])   # the tile is being read on a worker: as the last cell until it is in memory

	if memo.is_empty() or memo[0] != cell:
		memo = [cell, SnowWalk.name_is_snow(str(ground_material.call(position.x, position.z)))]
		_snow_memo[peer] = memo

	return bool(memo[1])


func _note_motion(peer: int, position: Vector3) -> void:
	var now: int = Time.get_ticks_msec()
	var last: Array = _motion.get(peer, [])

	if not last.is_empty() and now > int(last[1]):
		var dt: float = float(now - int(last[1])) / 1000.0
		var speed: float = Vector2(position.x - last[0].x, position.z - last[0].z).length() / dt
		_speed3[peer] = lerpf(float(_speed3.get(peer, 0.0)), Vector3(position.x - last[0].x, position.y - last[0].y, position.z - last[0].z).length() / dt, clampf(dt * 2.0, 0.0, 1.0))
		var target: float = _effort_at_speed(speed)                      # standing 0, walking 0.4, running 1 (data)

		if _on_path(peer, position):
			target *= float(_path_cfg.get("exertion_factor", 1.0))   # a trodden path eases the going (data/path_speed.json)

		target *= SnowWalk.effort_mult(_on_snow(peer, position), SnowWalk.shod(worn_of(peer), table))   # snow is heavy going, snowshoes ease it (Part C plan 7)

		if bool(_swimming.get(peer, false)):
			target = SwimRules.effort(speed)                              # strokes and treading water are work

		# Crawling (lying and moving, Dave QA #10, 25 Nov 2026) is work like walking (exertion.json crawl_effort), and not resting (crawling_of). A crawler's pace is
		# read from the velocity its client sent with the position (_peer_move), not from the arrival times: two reports bunched by the network would read a 0.4 m/s
		# crawl as twice that and stand the crawler up (review of PR #1939).
		var told: Vector3 = _peer_move.get(peer, [Vector3.ZERO])[0]
		var lying_pace: float = minf(speed, Vector2(told.x, told.z).length())
		var crawl: bool = int(_stance.get(peer, 0)) == 3 and lying_pace > float(_exertion_cfg.get("crawl_from_mps", 0.15)) and not _asleep.has(peer) and int(_strain.get(peer, {}).get("state", 0)) < 2

		if crawl:
			target = maxf(target, float(_exertion_cfg.get("crawl_effort", 0.4)))
			_crawling[peer] = true
		else:
			_crawling.erase(peer)
		_exertion[peer] = lerpf(float(_exertion.get(peer, 0.0)), target, clampf(dt * 0.25, 0.0, 1.0))
		_moving[peer] = lerpf(float(_moving.get(peer, 0.0)), 1.0 if speed > 0.4 else 0.0, clampf(dt * 1.0, 0.0, 1.0))

		# Walking off stands a sitting or lying player up.
		if int(_stance.get(peer, 0)) >= 2 and (lying_pace if int(_stance.get(peer, 0)) == 3 else speed) > float(_exertion_cfg.get("stand_up_speed_mps", 1.5)) and int(_strain.get(peer, {}).get("state", 0)) < 2 and not _forced_sleep(peer):
			_stance[peer] = 0
			_asleep.erase(peer)
			_crawling.erase(peer)
			_strain_sent.erase(peer)

	_motion[peer] = [position, now]


# Vitals spread over frames (load test 23 Nov 2026, docs/design/SERVER_SCALE.md). Each frame owes players * delta / SLOW_TICK_S looks
# (kept as a fraction between frames, at most every player once a frame); they go round the players in turn, each with its own seconds
# since its last look, so its drains, warmth and comfort come out the same as one look a quarter second. A long frame (a test's tick(1.0))
# looks at every player with the whole time, as the slow tick did. The lit-fire list is made again once a quarter second, not every frame.
var _vit_spent: Dictionary = {}    # peer -> seconds since its last vitals look
var _vit_owed: float = 0.0         # looks owed, carried between frames
var _vit_next: int = 0             # where the turn is in the player list
var _vit_lit_age: float = 0.0      # seconds since the lit-fire list was last dropped


func _vitals_spread(delta: float) -> void:
	var peers: Array = _peer_key.keys()
	_vit_lit_age += delta

	for peer in _vit_spent.keys():
		if not _peer_key.has(peer):
			_vit_spent.erase(peer)

	if peers.is_empty():
		_vit_owed = 0.0
		return

	for peer in peers:
		_vit_spent[peer] = float(_vit_spent.get(peer, 0.0)) + delta

	_vit_owed = minf(_vit_owed + float(peers.size()) * delta / SLOW_TICK_S, float(peers.size()))
	var n: int = int(_vit_owed)

	if n <= 0:
		return

	_vit_owed -= float(n)
	var due: Array = []
	var spent_of: Dictionary = {}

	for i in n:
		if _vit_next >= peers.size():
			_vit_next = 0

		var peer: int = int(peers[_vit_next])
		_vit_next += 1
		due.append(peer)
		spent_of[peer] = float(_vit_spent[peer])
		_vit_spent[peer] = 0.0

	var lit_fresh: bool = _vit_lit_age >= SLOW_TICK_S

	if lit_fresh:
		_vit_lit_age = 0.0

	_vitals_tick(SLOW_TICK_S, due, spent_of, lit_fresh)


# `only` (with `spent_of`, peer -> its own seconds since its last vitals): those players only, each by its own elapsed time (_vitals_spread).
# Empty: every player by `spent`, as before (tests call it so).
func _vitals_tick(spent: float, only: Array = [], spent_of: Dictionary = {}, lit_fresh: bool = true) -> void:
	var health_max: float = float(_vitals_cfg.get("health_max", 100))
	var base_spent: float = spent
	var game_s: float = spent * GAME_RATE
	_vitals_caches_clear()

	if lit_fresh:
		_lit_valid = false

	_in_vitals = true

	if weather_now.is_valid() and float((weather_now.call() as Dictionary).get("rain", 0.0)) > 0.05:   # starter-calendar: the fallback rain memory when no rain_hours_at is set (tests)
		_last_rain_s = _now_game_s()

	for peer in (_peer_key.keys() if only.is_empty() else only):
		if not _peer_key.has(peer):
			continue   # left since it was picked

		spent = float(spent_of.get(peer, base_spent))
		game_s = spent * GAME_RATE
		var v: Dictionary = _vitals.get(_peer_key[peer], {})

		if v.is_empty() or _parked.has(peer):
			continue   # an absent player's body is out of the world: nothing drains or chills

		var crow: Dictionary = _characters.get(_peer_key[peer], {})

		if float(crow.get("grace_s", 0.0)) > 0.0:   # online time only: this loop runs for connected peers
			crow["grace_s"] = maxf(float(crow["grace_s"]) - spent, 0.0)
			_dirty = _dirty or float(crow["grace_s"]) <= 0.0

		var burn_per_day: float = float(_vitals_cfg.get("rest_kcal_per_kg_day", 22)) * float(v["weight"]) + float(_vitals_cfg.get("work_kcal_day", 1500)) * exertion_of(peer)
		var drain_mult: float = _drain_mult(peer) * minf(float(rested_tier(peer).get("hunger_thirst_mult", 1.0)), food_mult(peer, "hunger_thirst_mult"))   # Rested or a Beverage, the larger, never both
		var burn: float = burn_per_day * game_s / 86400.0 * drain_mult
		v["fed"] = float(v["fed"]) - burn

		if float(v["fed"]) < 0.0:
			# Empty: the shortfall comes off the body.
			v["weight"] = clampf(float(v["weight"]) + float(v["fed"]) / float(_vitals_cfg.get("kcal_per_kg", 7700)), float(_vitals_cfg.get("min_weight_kg", 40)), float(_vitals_cfg.get("max_weight_kg", 150)))
			v["fed"] = 0.0

		var thirst: Dictionary = _vitals_cfg.get("thirst", {})
		var dry_per_day: float = float(thirst.get("rest_ml_day", 1000)) + float(thirst.get("work_ml_day", 1200)) * exertion_of(peer)
		v["wet"] = maxf(float(v["wet"]) - dry_per_day * game_s / 86400.0 * drain_mult, 0.0)

		_warmth_tick(peer, v, spent, game_s)
		_carry_notice(peer)
		_sick_due_tick(peer, v, game_s)
		_sick_tick(peer, v, spent, game_s)

		if float(v["fed"]) > 0.0 and float(v["wet"]) > 0.0 and float(v.get("warmth", 100.0)) >= float(_warmth_cfg.get("cold_at", 40.0)):
			var regen: float = float(_vitals_cfg.get("health_regen_per_s", 0.05))

			if _asleep.has(peer):
				regen *= 1.0 + (float(_sleep_cfg.get("regen_mult", 2.0)) - 1.0) * maxf(_sleep_quality(peer), 0.0)

			if on_good_bed(peer):
				regen *= float(_bed_cfg.get("regen_mult", 1.0))   # asleep or just lying on it

			var rested: Dictionary = rested_tier(peer)

			if not rested.is_empty():   # the Rested buff: the larger of the two, never the product (comfort spec)
				regen = maxf(regen, float(_vitals_cfg.get("health_regen_per_s", 0.05)) * float(rested.get("regen_mult", 1.0)))

			regen = maxf(regen, float(_vitals_cfg.get("health_regen_per_s", 0.05)) * food_mult(peer, "regen_mult"))   # food the same way: the larger, never the product

			v["health"] = clampf(float(v["health"]) + regen * spent, 0.0, health_max)

		_energy_tick(peer, v, spent, game_s)
		_comfort_meter_tick(peer, v, spent)
		_breath_tick(peer, v, spent)

		if float(v["health"]) <= 0.0:
			_in_vitals = false   # a death empties the pack and the comfort meter: kill reads everything live, and this player's kept readings go
			var died: bool = kill(peer, str(_death_cause.get(peer, "drowning")))
			_in_vitals = true
			_vitals_forget(peer)

			if died:
				continue

		_limp_tick(peer, v, spent)
		_sync_vitals(peer, false)
		_strain_tick(peer, spent)

	_in_vitals = false


# --- Sickness (Dave 2026-10-21; data/items/sickness.json) ---
# `sick` in the vitals is the game seconds of sickness left (0 = well).

func make_sick(peer: int, hours: float = -1.0, say_start: bool = true) -> void:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty() or _sick_cfg.is_empty():
		return

	if say_start and float(v.get("sick", 0.0)) <= 0.0:
		_say(peer, str(_sick_cfg.get("say_start", "You feel sick.")))

	v["sick"] = maxf(float(v.get("sick", 0.0)), (hours if hours > 0.0 else float(_sick_cfg.get("duration_h", 24.0))) * 3600.0)
	_symptom_in[peer] = float(_sick_cfg.get("symptom_every_s", 90.0)) * 0.5
	_sync_sick(peer, true)
	_dirty = true


# A crippling injury (vitals.json "limp"): `limp` seconds left in the vitals, speed_share of normal speed while it lasts; it ends
# when the time runs out or health has climbed back to heal_at of the maximum.
func limp_share(peer: int) -> float:
	var cfg: Dictionary = _vitals_cfg.get("limp", {})
	return float(cfg.get("speed_share", 0.5)) if float(vitals_of(peer).get("limp", 0.0)) > 0.0 else 1.0


func _limp_tick(peer: int, v: Dictionary, spent: float) -> void:
	var left: float = float(v.get("limp", 0.0))

	if left <= 0.0:
		_sync_limp(peer, false)   # also clears a limp the client still holds after a death
		return

	var cfg: Dictionary = _vitals_cfg.get("limp", {})
	left -= spent

	if float(v["health"]) >= float(_vitals_cfg.get("health_max", 100)) * float(cfg.get("heal_at", 0.6)):
		left = 0.0

	v["limp"] = maxf(left, 0.0)

	if left <= 0.0:
		_say(peer, "Your leg has healed enough to walk on.")

	_sync_limp(peer, false)


func _sync_limp(peer: int, force: bool) -> void:
	if not send_limp.is_valid():
		return

	var percent: int = int(round(limp_share(peer) * 100.0))

	if force or int(_limp_sent.get(peer, -1)) != percent:
		_limp_sent[peer] = percent
		send_limp.call(peer, percent)


func is_sick(peer: int) -> bool:
	return float(vitals_of(peer).get("sick", 0.0)) > 0.0


func _sick_tick(peer: int, v: Dictionary, spent: float, game_s: float) -> void:
	var left: float = float(v.get("sick", 0.0))

	if left <= 0.0 or _sick_cfg.is_empty():
		return

	left -= game_s * (float(_sick_cfg.get("sleep_mult", 4.0)) if _asleep.has(peer) else 1.0)
	_symptom_in[peer] = float(_symptom_in.get(peer, float(_sick_cfg.get("symptom_every_s", 90.0)))) - spent

	if left <= 0.0:
		v["sick"] = 0.0
		_symptom_in.erase(peer)
		_say(peer, str(_sick_cfg.get("say_well", "You feel well again")))
	else:
		v["sick"] = left

		if float(_symptom_in[peer]) <= 0.0:
			_symptom_in[peer] = float(_sick_cfg.get("symptom_every_s", 90.0))
			var symptoms: Array = _sick_cfg.get("symptoms", [])

			if not symptoms.is_empty():
				var symptom: Dictionary = symptoms[int(_symptom_count(peer)) % symptoms.size()]
				v["fed"] = maxf(float(v["fed"]) - float(symptom.get("fed_kcal", 0)), 0.0)
				v["wet"] = maxf(float(v["wet"]) - float(symptom.get("wet_ml", 0)), 0.0)
				_say(peer, str(symptom.get("say", "")))
				think(peer, str(symptom.get("kind", "")))

	_sync_sick(peer, false)


var _symptoms_seen: Dictionary = {}
var _voice_cfg: Dictionary = {}
var _voice_last: Dictionary = {}    # peer -> the last inner-voice line, so it does not repeat


# The inner voice speaks: a line of `kind` goes to the player as audio id plus subtitle (design: DESIGN_IDEAS 6.14, sparing and
# never twice in a row). Returns the text.
func think(peer: int, kind: String) -> String:
	var text: String = inner_voice(peer, kind)

	if text != "" and send_thought.is_valid():
		send_thought.call(peer, voice_line_id(text), text, kind)

	return text


# A stable id for a line, so adding or reordering lines in inner_voice.json never moves a recording to the wrong text.
func voice_line_id(text: String) -> String:
	return text.md5_text().substr(0, 8)


# One inner-voice joke for a symptom kind (data/items/inner_voice.json), never the one just shown.
func inner_voice(peer: int, kind: String) -> String:
	if _voice_cfg.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/inner_voice.json"))
		_voice_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {"none": true}

	var lines: Array = _voice_cfg.get(kind, [])

	if lines.is_empty():
		return ""

	var pick: String = str(lines[_fate_rng.randi() % lines.size()])   # luck-exempt: flavour text
	var guard: int = 0

	while pick == str(_voice_last.get(peer, "")) and lines.size() > 1 and guard < 20:
		pick = str(lines[_fate_rng.randi() % lines.size()])   # luck-exempt: flavour text
		guard += 1

	_voice_last[peer] = pick
	return pick


func _symptom_count(peer: int) -> int:
	_symptoms_seen[peer] = int(_symptoms_seen.get(peer, -1)) + 1
	return int(_symptoms_seen[peer])


# --- Clothing and equipment (data/items/clothing.json; items of kind clothing or gear with a slot and a wear_layer; layers M001-T11) ---

func _clothing_cfg() -> Dictionary:
	if _clothing.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/clothing.json"))
		_clothing = parsed if typeof(parsed) == TYPE_DICTIONARY else {"slots": [], "worn": []}

	return _clothing


# The body slots an item's `slot` may name.
func _clothing_slots() -> Array:
	return _clothing_cfg().get("slots", [])


# The worn positions ("slot:layer") in record and wire order. Append-only, so a save of any version lines up with it.
func _worn_places() -> Array:
	return _clothing_cfg().get("worn", [])


# The worn position an item goes to, from its slot and wear_layer (none: the slot's first layer); -1 if it is not worn.
func _place_of(number: int) -> int:
	var entry: Dictionary = table.entry(table.id_of(number))
	var slot: String = str(entry.get("slot", ""))
	var layers: Array = _clothing_cfg().get("layers", {}).get(slot, [])

	if layers.is_empty():
		return -1

	return _worn_places().find("%s:%s" % [slot, str(entry.get("wear_layer", layers[0]))])


# Every position a piece worn at `place` fills: its own, and the same layer of each slot in its `spans` (a Dress: body and legs base).
func _covers(number: int, place: int) -> Array:
	var out: Array = [place]
	var layer: String = str(_worn_places()[place]).get_slice(":", 1)

	for slot in table.entry(table.id_of(number)).get("spans", []):
		var other: int = _worn_places().find("%s:%s" % [str(slot), layer])

		if other >= 0:
			out.append(other)

	return out


# The item numbers a character wears, one per worn position; old saves have none. Read straight off the record (slot arrays, or an old bare
# number): it runs on every position report, carry and warmth check, so it builds no slot arrays.
func worn_of(peer: int) -> Array:
	if _in_vitals and vitals_memo and _worn_cache.has(peer):
		return (_worn_cache[peer] as Array).duplicate()   # a copy, as a fresh list always was: no caller can change the kept one

	var list: Array = _characters.get(_peer_key.get(peer, ""), {}).get("worn", [])
	var out: Array = []

	for i in _worn_places().size():
		var raw: Variant = list[i] if i < list.size() else 0
		var head: Variant = raw[0] if typeof(raw) == TYPE_ARRAY and not (raw as Array).is_empty() else raw
		out.append(maxi(int(head), 0) if typeof(head) == TYPE_INT or typeof(head) == TYPE_FLOAT else 0)

	if _in_vitals:
		_worn_cache[peer] = out.duplicate()

	return out


# What a character wears as slot arrays [number, 1, wear, inst], one per worn position ([0, 0, 0, {}] for nothing; catalog Phase 1b).
func worn_slots_of(peer: int) -> Array:
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})
	var list: Array = row.get("worn", [])
	var out: Array = []

	for i in _worn_places().size():
		out.append(_worn_entry(list[i] if i < list.size() else 0))

	return out


# One worn slot from the record or a save: a slot array, or an old bare item number, which reads as [number, 1, 0, {}]. The inst is taken as it
# is (the record is clean; _clean_worn cleans a save's), since worn_of runs on every carry and warmth check.
static func _worn_entry(raw: Variant) -> Array:
	var whole: bool = typeof(raw) == TYPE_ARRAY and not (raw as Array).is_empty()
	var row: Array = raw if whole else [raw]
	var number: int = int(row[0]) if typeof(row[0]) == TYPE_INT or typeof(row[0]) == TYPE_FLOAT else 0

	if number <= 0:
		return [0, 0, 0, {}]

	var used: int = int(row[2]) if row.size() > 2 and (typeof(row[2]) == TYPE_INT or typeof(row[2]) == TYPE_FLOAT) else 0
	return [number, 1, maxi(used, 0), row[3] if row.size() > 3 and typeof(row[3]) == TYPE_DICTIONARY else {}]


# A saved worn list, cleaned: each piece in its own position. An older save's eight columns are the first eight positions, so a piece there is
# in its slot's base layer (a cloak in the old outer column in body outer); one whose layer is another (a helm saved in the head column) moves to
# its own position when that is free. A piece that fits nowhere is left off, with a warning.
func _clean_worn(raw: Variant) -> Array:
	var places: Array = _worn_places()
	var out: Array = []
	var moved: Array = []

	for i in places.size():
		out.append([0, 0, 0, {}])

	for i in places.size():
		var entry: Array = _worn_entry(raw[i] if typeof(raw) == TYPE_ARRAY and i < raw.size() else 0)
		var number: int = table.current_number(int(entry[0]))   # worn Hide leggings come back as Hide trousers

		if number <= 0 or table.id_of(number) == "":
			continue

		var piece: Array = [number, 1, int(entry[2]), InventoryScript.clean_inst_of(table, number, entry[3])]   # a worn non-bag drops an older save's `bag`
		var own: int = _place_of(number)

		if own == i:
			out[i] = piece
		else:
			moved.append([own, piece])

	for row in moved:
		if int(row[0]) >= 0 and int(out[int(row[0])][0]) == 0:
			out[int(row[0])] = row[1]
		else:
			push_warning("characters.json: worn %s fits no free position, left off" % table.id_of(int(row[1][0])))

	return out


func _layers_cfg() -> Dictionary:
	return _warmth_cfg.get("layers", {})


# A worn piece's fabric row (warmth.json layers fabrics; items.json `fabric`), {} for none.
func _fabric(entry: Dictionary) -> Dictionary:
	return _layers_cfg().get("fabrics", {}).get(str(entry.get("fabric", "")), {})


# One slot's layers with diminishing returns (master s3.7 rule 1, s3.8 design 2: never full stacking): largest first, each further one
# counts `keep` times the one before (warmth.json layers layer_keep unless given; armour passes protection.json layer_keep).
func _layered(values: Array, keep: float = -1.0) -> float:
	values.sort()
	values.reverse()

	if keep < 0.0:
		keep = float(_layers_cfg().get("layer_keep", 0.6))

	var share: float = 1.0
	var total: float = 0.0

	for value in values:
		total += float(value) * share
		share *= keep

	return total


# A value of every worn piece (`value_of(items.json entry)`), layered per body slot, the slots added up.
func _layered_worn(peer: int, value_of: Callable) -> float:
	var by_slot: Dictionary = {}

	for number in worn_of(peer):
		if number > 0:
			var entry: Dictionary = table.entry(table.id_of(number))
			var slot: String = str(entry.get("slot", ""))

			if not by_slot.has(slot):
				by_slot[slot] = []

			by_slot[slot].append(float(value_of.call(entry)))

	var total: float = 0.0

	for slot in by_slot:
		total += _layered(by_slot[slot])

	return total


# Share of body heat the worn pieces keep, 0..max_insulation (warmth.json): layered per slot, each piece's warmth cut toward its fabric's
# wet_keep as the body is soaked. The `insulation_of` hook, when set, takes over.
func insulation_worn(peer: int) -> float:
	var soak: float = clampf(float(_soak.get(peer, 0.0)), 0.0, 1.0)

	if vitals_memo:
		var slots: Dictionary = _dress_of(peer)["slots"]
		var total: float = 0.0

		for slot in slots:
			var values: Array = []

			for piece in slots[slot]:
				values.append(float(piece[0]) * lerpf(1.0, float(piece[1]), soak))

			total += _layered(values)

		return minf(total, float(_warmth_cfg.get("max_insulation", 0.85)))

	var kept: Callable = func(entry: Dictionary) -> float: return float(entry.get("warmth", 0.0)) * lerpf(1.0, float(_fabric(entry).get("wet_keep", 1.0)), soak)
	return minf(_layered_worn(peer, kept), float(_warmth_cfg.get("max_insulation", 0.85)))


# How much heat the worn pieces trap in warm air, 0..max_insulation: their warmth times (1 - breath), layered the same way (fur hot, linen cool).
func heat_load(peer: int) -> float:
	if vitals_memo:   # the kept per-slot values, layered and capped live (layer_keep and max_insulation read now, as without the row)
		var by_slot: Dictionary = _dress_of(peer)["heat"]
		var total: float = 0.0

		for slot in by_slot:
			total += _layered((by_slot[slot] as Array).duplicate())

		return minf(total, float(_warmth_cfg.get("max_insulation", 0.85)))

	var trapped: Callable = func(entry: Dictionary) -> float: return float(entry.get("warmth", 0.0)) * (1.0 - float(_fabric(entry).get("breath", 1.0)))
	return minf(_layered_worn(peer, trapped), float(_warmth_cfg.get("max_insulation", 0.85)))


# The share of falling rain the worn body pieces keep off: the best shedder's rain_shed (an Oilcloth - Cloak), 0 with none.
func rain_shed(peer: int) -> float:
	if vitals_memo:
		return float(_dress_of(peer)["shed"])

	var best: float = 0.0

	for number in worn_of(peer):
		if number > 0:
			var entry: Dictionary = table.entry(table.id_of(number))

			if str(entry.get("slot", "")) == "body":
				best = maxf(best, float(_fabric(entry).get("rain_shed", 0.0)))

	return clampf(best, 0.0, 1.0)


# The body weight the carry limit is worked out from (cap = ratio x body): the real weight plus what the worn pack's weight spreading adds
# (items.json carry_bonus_kg on the four back packs: Simple 5, Improved 15, Quality 30, Advanced 50 kg; Dave 15 Nov 2026). No back pack has slots of its own (Dave 13 Nov 2026), and
# the pack's slot count only follows what it holds (protocol 116).
func _carry_body(peer: int) -> float:
	if vitals_memo:   # CarryRules.carry_body_kg with the carry bonus kept
		return float(vitals_of(peer).get("weight", 75.0)) + float(_dress_of(peer)["bonus"]) / maxf(float(_carry_cfg.get("carry_kg_per_body_kg", 0.7)), 0.01)

	return CarryRules.carry_body_kg(float(vitals_of(peer).get("weight", 75.0)), worn_of(peer), table, _carry_cfg)


# ACT_WEAR: the piece in a pack slot goes to its slot-and-layer. Every worn piece sharing a position with it comes off into the pack (the one in
# that layer; a Dress filling body and legs base), each into a pack slot (worn pieces never stack; the slot the new piece leaves counts, and the
# pack grows for the rest, protocol 116). Only a pack at MAX_SLOTS can lack the room: then nothing moves, so nothing is lost or doubled.
func _wear(peer: int, inv, slot: int) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _characters.has(_peer_key.get(peer, "")):
		return

	var number: int = inv.numbers[slot]
	var place: int = _place_of(number)

	if place < 0:
		_say(peer, "You cannot wear that.")
		return

	var worn: Array = worn_slots_of(peer)
	var refusal: String = _hang_refusal(worn, place)

	if refusal != "":
		_say(peer, refusal)
		_reject(peer, 3)
		return

	var covers: Array = _covers(number, place)
	var off: Array = []

	for i in worn.size():
		if int(worn[i][0]) > 0 and _covers(int(worn[i][0]), i).any(func(at: int) -> bool: return covers.has(at)):
			off.append(i)

	var room: int = (1 if inv.counts[slot] == 1 else 0) + (InventoryScript.MAX_SLOTS - inv.slot_count if inv.grows else 0)

	for i in inv.usable:
		if inv.numbers[i] == 0:
			room += 1

	if off.size() > room:
		_say(peer, "Your pack has no room for what that replaces.")
		_reject(peer, 3)
		return

	var piece: Dictionary = inv.take_from_slot(slot, 1)

	for i in off:
		inv.add(int(worn[i][0]), 1, int(worn[i][2]), worn[i][3])
		worn[i] = [0, 0, 0, {}]

	worn[place] = [number, 1, int(piece["wear"]), piece["inst"]]
	_characters[_peer_key[peer]]["worn"] = worn
	_dirty = true
	_sync_worn(peer, true)


# ACT_UNWEAR: the piece in one worn position back into the pack (each layer comes off on its own); the pack grows for it, and only one at
# MAX_SLOTS refuses.
func _unwear(peer: int, inv, place: int) -> void:
	var worn: Array = worn_slots_of(peer)

	if place < 0 or place >= worn.size() or int(worn[place][0]) == 0 or not _characters.has(_peer_key.get(peer, "")):
		return

	for hung in _attach_cfg():
		if str(_attach_cfg()[hung][0]) == str(_worn_places()[place]) and int(worn[_worn_places().find(hung)][0]) > 0:
			_say(peer, "Take off what hangs on it first.")
			_reject(peer, 3)
			return

	if inv.add(int(worn[place][0]), 1, int(worn[place][2]), worn[place][3]) > 0:
		_say(peer, "Your pack is full.")
		_reject(peer, 3)
		return

	worn[place] = [0, 0, 0, {}]
	_characters[_peer_key[peer]]["worn"] = worn
	_dirty = true
	_sync_worn(peer, true)


func _sync_worn(peer: int, force: bool) -> void:
	if not send_worn.is_valid() or not _peer_key.has(peer):
		return

	var numbers: PackedInt32Array = PackedInt32Array()
	var insts: Dictionary = {}

	for entry in worn_slots_of(peer):
		if not (entry[3] as Dictionary).is_empty():
			insts[numbers.size()] = entry[3]

		numbers.append(int(entry[0]))

	var extra: PackedByteArray = InventoryScript.inst_bytes(insts)   # protocol 106: the worn pieces' instance data, as inventory bytes carry it

	if force or _worn_sent.get(peer, []) != [numbers, extra]:
		_worn_sent[peer] = [numbers, extra]
		send_worn.call(peer, numbers, extra)


# --- Attachment points and bags (catalog Phase 5, master s3.9 rules 1-5; clothing.json attach, belt_points, bags; src/shared/bag_rules.gd) ---

# clothing.json attach: worn position -> [the position it hangs on, what is said without it] (a pouch on the belt, a bedroll on a worn pack).
func _attach_cfg() -> Dictionary:
	return _clothing_cfg().get("attach", {})


# Why a piece may not go to worn position `place` ("" when it may): it hangs on a piece that is not worn, or the belt's points are all taken
# (clothing.json belt_points of the belt_hangs positions; a quiver needs no belt, but on a belt it takes a point).
func _hang_refusal(worn: Array, place: int) -> String:
	var at: String = str(_worn_places()[place])
	var needs: Array = _attach_cfg().get(at, [])

	if not needs.is_empty() and int(worn[_worn_places().find(str(needs[0]))][0]) == 0:
		return str(needs[1])

	var hangs: Array = _clothing_cfg().get("belt_hangs", [])

	if hangs.has(at) and int(worn[place][0]) == 0 and int(worn[_worn_places().find("waist:base")][0]) > 0:
		var used: int = hangs.filter(func(p: String) -> bool: return int(worn[_worn_places().find(p)][0]) > 0).size()

		if used >= int(_clothing_cfg().get("belt_points", 3)):
			return "Your belt has no free point. Take something off it first."

	return ""


# The worn bag at `place` as an inventory of its own slots, or null when no bag is worn there. One action works on one copy (a Take all moves
# many stacks), which _end_bag_edit writes back into the worn record when the action ends.
func _worn_bag(peer: int, place: int):
	if _bag_edit.has(peer) and int(_bag_edit[peer][0]) == place:
		return _bag_edit[peer][1]

	var worn: Array = worn_slots_of(peer)

	if place < 0 or place >= worn.size() or BagRules.slots_of(table, int(worn[place][0])) <= 0:
		return null

	_end_bag_edit(peer)
	var bag = BagRules.open(table, int(worn[place][0]), worn[place][3])
	_bag_edit[peer] = [place, bag]
	return bag


func _end_bag_edit(peer: int) -> void:
	if not _bag_edit.has(peer):
		return

	var place: int = int(_bag_edit[peer][0])
	var bag = _bag_edit[peer][1]
	_bag_edit.erase(peer)
	var worn: Array = worn_slots_of(peer)

	if place >= worn.size() or BagRules.slots_of(table, int(worn[place][0])) <= 0:
		return

	var stored: Dictionary = BagRules.store(bag, worn[place][3])

	if stored != worn[place][3]:
		worn[place] = [int(worn[place][0]), 1, int(worn[place][2]), stored]
		_characters[_peer_key[peer]]["worn"] = worn
		_dirty = true
		_sync_worn(peer, false)


# The item number of the bag a container id names (-1 - worn position), 0 for none.
func _bag_number(peer: int, id: int) -> int:
	var worn: Array = worn_of(peer)
	return int(worn[-1 - id]) if id < 0 and -1 - id < worn.size() else 0


# Why the worn bag `id` does not take an item ("" when it does): no bag in a bag, and each bag's bag_takes (BagRules.refusal).
func _bag_refusal(peer: int, id: int, number: int) -> String:
	return BagRules.refusal(table, _carry_cfg, _clothing_cfg().get("bags", {}), _bag_number(peer, id), number)


# A worn quiver (a bag that takes arrows) as an inventory, or null: the bow draws from it first (master s3.9 rule 4).
func _worn_quiver(peer: int):
	var worn: Array = worn_of(peer)

	for place in worn.size():
		if int(worn[place]) > 0 and str(table.entry(table.id_of(int(worn[place]))).get("bag_takes", "")) == "arrow":
			return _worn_bag(peer, place)

	return null


# Ages what a bag holds where the bag is (pack, chest, ground, worn). True when anything aged; `holder` gets the bag's new instance data.
func _spoil_bag(number: int, item_inst: Dictionary, units: int, holder: Array) -> bool:
	if not item_inst.has("bag"):
		return false

	var bag = BagRules.open(table, number, item_inst)

	if not _spoil_inventory(bag, units):
		return false

	holder.append(BagRules.store(bag, item_inst))
	return true


func _sync_sick(peer: int, force: bool) -> void:
	if not send_sick.is_valid():
		return

	var hours: int = int(ceil(float(vitals_of(peer).get("sick", 0.0)) / 3600.0))

	if force or int(_sick_sent.get(peer, -1)) != hours:
		_sick_sent[peer] = hours
		send_sick.call(peer, hours)


# --- Warmth (job 92; data/items/warmth.json) ---

# The positions of the burning fires. Inside one _vitals_tick they are listed once for all players (the soak test found warmth
# scanning every world record per player); anywhere else the scan is live.
func _lit_fires() -> Array:
	var found: Array = []
	var now: int = Time.get_ticks_msec()

	for peer in _torch_seen:      # a bearer of a burning torch keeps wolves off like a small fire
		if now - int(_torch_seen[peer]) <= TORCH_REPORT_MS and _peer_pos.has(peer):
			found.append(_peer_pos[peer])

	for row in _lit_rows():
		found.append(row[0])

	for row in _guard_cache_rows:   # a lit torch post or other placed light with protect_m keeps them off too (buildables plan, batch B4); filled by the _lit_rows scan just above
		found.append(row[0])

	return found


# [[position, keep-off metres], ...] of everything _lit_fires lists, with fire_protect_m's radius, from one pass over the world items (the server
# works it out a few times a second for the animals: _lit_fires and fire_protect_m per fire walked every record several times a frame; load test
# 23 Nov 2026).
func fire_spots() -> Array:
	var spots: Array = []
	var now: int = Time.get_ticks_msec()

	for peer in _torch_seen:
		if now - int(_torch_seen[peer]) <= TORCH_REPORT_MS and _peer_pos.has(peer):
			spots.append([_peer_pos[peer], TORCH_PROTECT_M])

	for row in _lit_rows():
		spots.append([row[0], float(((_cooking.get("fire_tiers", {}) as Dictionary).get(_fire_class_of_state(int(row[1])), {}) as Dictionary).get("protect_m", 10.0))])

	for row in _guard_cache_rows:
		spots.append([row[0], float(row[1])])

	return spots


# How far wolves keep from the lit fire at this spot: its tier's protect_m (cooking.json fire_tiers; 10 m when unknown).
func fire_protect_m(at: Vector3) -> float:
	for peer in _torch_seen:
		if _peer_pos.has(peer) and (_peer_pos[peer] as Vector3).is_equal_approx(at):
			return TORCH_PROTECT_M

	for row in _lit_rows():
		if (row[0] as Vector3).is_equal_approx(at):
			return float(((_cooking.get("fire_tiers", {}) as Dictionary).get(_fire_class_of_state(int(row[1])), {}) as Dictionary).get("protect_m", 10.0))

	for row in _guard_rows():
		if (row[0] as Vector3).is_equal_approx(at):
			return float(row[1])

	return 10.0


var _lit_valid: bool = false
var lit_scans: int = 0         # walks of every record for the lit fires (_lit_rows), for the tests
var _lit_scope: bool = false   # the goals tick keeps one fire list for all its players, as the vitals pass does (soak 26 Nov 2026: the night walk and the hints
                               # walked every record once a player for the lit fires, 165 ms a second at 64 players)
var _rain_rng: RandomNumberGenerator = RandomNumberGenerator.new()


# [position, lit state] of every burning fire (warmth reads the tier's heat and reach from cooking.json fire_tiers). Cached inside one vitals tick.
var _lit_cache_rows: Array = []


func _lit_rows() -> Array:
	if (_in_vitals or _lit_scope) and _lit_valid:
		return _lit_cache_rows

	var found: Array = []
	lit_scans += 1
	_coal_cache_rows = []
	_guard_cache_rows = []
	_heat_cache_rows = []

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("fire") and fire_is_lit(int(it["fire"]["state"])):
			found.append([it["pos"], int(it["fire"]["state"])])
		elif it.has("fire") and int(it["fire"]["state"]) == FIRE_STATE_COALS:
			_coal_cache_rows.append(it["pos"])
		elif it.has("struct") and bool(it["struct"].get("lit", false)):
			var lit_def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

			if float(lit_def.get("protect_m", 0.0)) > 0.0:
				_guard_cache_rows.append([it["pos"], float(lit_def["protect_m"])])

			if lit_def.has("heat_tier"):   # a lit Fireplace or brazier warms as a campfire of that size (structures.json note_fire_lights)
				_heat_cache_rows.append([it["pos"], str(lit_def["heat_tier"])])

	if _in_vitals or _lit_scope:
		_lit_cache_rows = found
		_lit_valid = true

	return found


# The positions of glowing coals (state 76): they warm coals.heat_c within coals.heat_m and keep nothing off. The same scan as _lit_rows.
var _coal_cache_rows: Array = []
var _guard_cache_rows: Array = []   # [position, protect_m] of every lit placed light whose structures.json row has protect_m (the same scan)
var _heat_cache_rows: Array = []    # [position, fire_tiers class] of every lit placed light whose row has heat_tier (the same scan)


# [position, cooking.json fire_tiers row] of everything burning that warms a body: lit campfires by their tier, lit Fireplaces and braziers
# by their heat_tier (warmth_target and drying by a fire read the same list).
func _heat_rows() -> Array:
	var tiers: Dictionary = _cooking.get("fire_tiers", {})
	var rows: Array = []

	for row in _lit_rows():
		rows.append([row[0], tiers.get(_fire_class_of_state(int(row[1])), {})])

	for row in _heat_cache_rows:
		rows.append([row[0], tiers.get(str(row[1]), {})])

	return rows


func _guard_rows() -> Array:
	if not ((_in_vitals or _lit_scope) and _lit_valid):
		_lit_rows()

	return _guard_cache_rows


func _coal_rows() -> Array:
	if not ((_in_vitals or _lit_scope) and _lit_valid):
		_lit_rows()

	return _coal_cache_rows


# The warmth the body is heading for here and now: 100 on a mild day, less as the cold stress grows.
func warmth_target(peer: int) -> float:
	var cfg: Dictionary = _warmth_cfg
	var pos: Vector3 = _peer_pos.get(peer, Vector3.ZERO)
	var weather: Dictionary = _weather_here(pos)
	var covered: bool = _vitals_cover(pos) > 0.5
	var cave_c: float = float(cave_mean_c.call(pos)) if cave_mean_c.is_valid() else NAN
	# The weather's temp_c already carries the day and night swing (one temperature, docs/design/one_temperature.md), at the spot's height (_air_here).
	var air: float = _air_here(pos, weather, float(cfg.get("comfort_c", 15.0)))
	var roofed: bool = _vitals_cover(pos) > 1.5
	var wind: float = float(weather.get("wind", 0.0)) * (float(cfg.get("covered_wind_share", 0.3)) if roofed else 1.0)

	# In a cave (Jamie's caves page, #664): the air sits at the island's year mean for its height (cave_mean_c, Climate.year_mean_c), with no
	# day and night swing and no rain cooling, and no wind reaches in.
	if not is_nan(cave_c):
		var mouth_air: Dictionary = _cave_mouth_air(pos, air)   # in from the mouth the outside air still reaches, with a small draught (#709)
		wind = float(mouth_air.get("wind", 0.0))
		air = float(mouth_air.get("air_c", cave_c))
	var feels: float = air - wind * float(cfg.get("wind_chill_c", 6.0))
	var radius: float = float(cfg.get("fire_radius_m", 4.0))

	# Overdressed in warm air (fur too hot, linen cool; warmth.json layers): kept for effort_of until the next reading. The air and wind only:
	# a fire's heat is the warmth a dressed body seeks, never a heat load.
	var hot: float = feels - float(cfg.get("comfort_c", 15.0))
	_overheat[peer] = heat_load(peer) * minf(hot / maxf(float(_layers_cfg().get("heat_span_c", 10.0)), 0.01), 1.0) if hot > 0.0 and not bool(_swimming.get(peer, false)) else 0.0

	var heat: float = 0.0

	for row in _heat_rows():
		var tier_row: Dictionary = row[1]
		var reach: float = float(tier_row.get("heat_radius_m", radius))

		if (row[0] as Vector3).distance_to(pos) <= reach:
			heat = maxf(heat, float(tier_row.get("heat_c", cfg.get("fire_c", 20.0))))

	var coals: Dictionary = _coals_cfg()

	for at in _coal_rows():
		if (at as Vector3).distance_to(pos) <= float(coals.get("heat_m", 1.5)):
			heat = maxf(heat, float(coals.get("heat_c", 8.0)))

	feels += heat

	var stress: float = maxf(float(cfg.get("comfort_c", 15.0)) - feels, 0.0)

	if on_good_bed(peer):
		stress *= 1.0 - float(_bed_cfg.get("warmth_bonus", 0.0))
	elif (_asleep.has(peer) or int(_stance.get(peer, 0)) == 3) and _has_bedroll(peer):
		stress *= 1.0 - float(_sleep_cfg.get("bedroll", {}).get("warmth_bonus", 0.0))   # rolled up in it: half a bed's warmth
	stress *= float(rested_tier(peer).get("cold_stress_mult", 1.0))   # Rested: the cold bites a little less
	var precip: float = maxf(float(weather.get("rain", 0.0)), float(weather.get("snow", 0.0)))

	# Wet from rain or snow (Dave 5 Nov, rain card: "Rain x1.5"; only shelter dries you, slowly under a tree or roof, fast by a fire): the chill follows
	# how soaked the player is (_update_soak), not only the rain falling this moment. A peer the tick has not seen yet uses the rain falling now.
	var soak: float = float(_soak[peer]) if _soak.has(peer) else (minf(precip * 2.0, 1.0) if precip > 0.05 and not covered else 0.0)

	var body: Dictionary = _body_cfg()

	if soak > 0.0:
		# Wet plus wind is what kills (docs/design/body_in_weather_design.md 3): the wind pumps through wet cloth.
		stress *= 1.0 + (float(cfg.get("rain_mult", 1.5)) - 1.0) * soak + float(body.get("wet_wind_gain", 0.0)) * soak * wind

	_wet_wind[peer] = not body.is_empty() and soak >= float(body.get("wet_wind_say_soak", 0.5)) and wind >= float(body.get("wet_wind_say_wind", 0.3)) and not roofed and not bool(_swimming.get(peer, false))   # under a roof the line would send them where they are

	var insulation: float = clampf(float(insulation_of.call(peer)) if insulation_of.is_valid() else insulation_worn(peer), 0.0, float(cfg.get("max_insulation", 0.85)))

	if not body.is_empty():
		# Soaked in a gale, clothes keep a tenth of their insulation (Pugh, Four Inns 1964: "nearly nothing").
		insulation *= 1.0 - float(body.get("wet_strip", 0.9)) * soak * minf(wind / maxf(float(body.get("wet_strip_wind", 0.6)), 0.01), 1.0)

	if bool(_swimming.get(peer, false)):
		# In the water the cold follows the WATER's temperature, not the air's (Tyler): a lagged, damped copy of the air at sea level.
		var sea_air: float = float((_weather_here(Vector3(pos.x, 0.0, pos.z)) if weather_at.is_valid() else (weather_now.call() if weather_now.is_valid() else weather)).get("temp_c", float(cfg.get("comfort_c", 15.0))))   # the sea-level weather of the swimmer's own row, as the design says (not the spot's height)
		var water_c: float = maxf(float(cfg.get("water_base_c", 6.0)) + float(cfg.get("water_follow", 0.5)) * (sea_air - float(cfg.get("water_base_c", 6.0))), 1.0)

		if bool(_cave_pool.get(peer, false)):
			water_c = cave_c if not is_nan(cave_c) else float(cfg.get("cave_pool_c", 2.0))   # a cave pool is at the cave air's year mean (Jamie #664, CONTRADICTIONS.md), not the weather (BUG-008)
		stress = maxf(float(cfg.get("water_comfort_c", 26.0)) - water_c, 0.0) * float(cfg.get("water_gain", 5.0)) / maxf(float(cfg.get("gain", 3.0)), 0.01)

	return clampf(100.0 - stress * float(cfg.get("gain", 3.0)) * (1.0 - insulation), 0.0, 100.0)


# Cold down to 1 point: the player passes out (the over-exertion faint's look: movement locked, the HUD fading to the heartbeat; nothing can
# hurt them while out), then wakes at the nearest goblin camp, bandit camp or the starter town with a message (Dave 23 Nov 2026: "you will then
# wake up at the nearest goblin camp or bandit camp or temple ... or at the starter spawn"). warmth.json pass_out. Dave 23 Nov 2026: the whole pack
# is kept and the player is simply rescued wherever they wake, no capture or theft for now ("bandits might steal it in the future. and goblins will
# depend on if they are the good type or the bad type"): the wake place's kind (_cold_out_tick) is where that would hang. Not built.
func _cold_pass_out(peer: int) -> void:
	_cold_out[peer] = 0.0
	var st: Dictionary = _strain.get(peer, {})

	if st.is_empty():
		st = {"s": 0.0, "state": 0, "t": 0.0}
		_strain[peer] = st

	st["state"] = 2   # fainted: the client locks movement and fades the HUD (exertion.json faint_s)
	st["t"] = 0.0
	_strain_sent.erase(peer)
	_end_sleep(peer)
	var cfg: Dictionary = _warmth_cfg.get("pass_out", {})
	_say(peer, str(cfg.get("say_out_water", "The water closes over you. You black out.")) if _out_water.has(peer) else str(cfg.get("say_out", "The cold takes you. You pass out.")))
	print("%s: peer %d passed out at %s" % ["Water" if _out_water.has(peer) else "Cold", peer, str(_peer_pos.get(peer, "?"))])


func _cold_out_tick(peer: int, v: Dictionary, spent: float, hurt_at: float) -> void:
	var cfg: Dictionary = _warmth_cfg.get("pass_out", {})
	_cold_out[peer] = float(_cold_out[peer]) + spent

	if float(_cold_out[peer]) < float(cfg.get("out_s", 6.0)):
		return

	_cold_out.erase(peer)
	var water: bool = _out_water.has(peer)
	_out_water.erase(peer)
	var here: Vector3 = _peer_pos.get(peer, respawn_point)
	var best: Array = []

	for spot in (rescue_spots.call(here) if rescue_spots.is_valid() else []):
		if best.is_empty() or (spot[0] as Vector3).distance_to(here) < (best[0] as Vector3).distance_to(here):
			best = spot

	# No camp and no town square anywhere (a test world): they come to where they lay, never at the spawn (nothing is based on the spawn).
	var to: Vector3 = best[0] if not best.is_empty() else here
	var kind: String = str(best[1]) if not best.is_empty() else "here"   # later: a bandit camp may take from the pack, a goblin camp by its goblins' type (not built)

	if water and best.is_empty():
		to = _dry_shore(here)   # no place to be carried to: the nearest dry shore, never the spawn (coordinator 23 Nov 2026)
	v["health"] = maxf(float(v["health"]), float(cfg.get("wake_health", 10.0)))
	v["warmth"] = maxf(float(v.get("warmth", 0.0)), hurt_at + float(cfg.get("wake_warmth_over", 5.0)))
	_cold_level.erase(peer)
	_wet_wind_told.erase(peer)
	# Not winded (the faint was the cold's, not exertion's), but still lying and out of their hands while the sight comes back (strain state 3,
	# exertion.json wake_s): Dave 27 Nov 2026, R-CORE-PASS-OUT: "they should lay there. they can only get back up once their vision fully recovers."
	_strain[peer] = {"s": 0.0, "state": 3, "t": 0.0, "rescued": true}
	_stance[peer] = 3
	_strain_sent.erase(peer)
	_peer_pos[peer] = to
	_resume_to.erase(peer)
	_motion.erase(peer)

	if water:   # carried out of the water: breathing again (the client's next report says where the head is; with no shore found, a full breath to swim up awake)
		_head_under[peer] = false
		_suffocate.erase(peer)
		_breath.erase(peer)
		_sync_breath(peer, -1)

	_sync_vitals(peer, true)
	_sync_warmth(peer, true)
	_dirty = true

	if send_died.is_valid() and not to.is_equal_approx(here):
		send_died.call(peer, "passed out", to)   # the client moves the body there and waits for the ground, as after a death (no death screen)

	if water:
		_say(peer, str((cfg.get("say_wake_water", {}) as Dictionary).get(kind, "You wake up coughing water. Someone pulled you from the water and brought you here.")))
	else:
		_say(peer, str((cfg.get("say_wake", {}) as Dictionary).get(kind, "You wake up feeling pain through your bones. A traveler found you frozen almost to death and brought you here.")))

	print("%s: peer %d woke at the %s at %s" % ["Water" if water else "Cold", peer, kind, str(to)])


# Where a rod's float sits while its line is in the water (waiting or biting), INF otherwise: the others draw the line and the float
# (server_players.gd cast_code, protocol 162). Look only.
func fishing_float(peer: int) -> Vector3:
	var state: Dictionary = _fishing.get(peer, {})

	if not (str(state.get("phase", "")) in ["wait", "bite"]) or not state.has("float"):
		return Vector3.INF

	return state["float"]


# The float's spot for a cast from `from` toward `at` (the client's cast point, 4 m ahead of the eye): at most `reach` m off level, on the
# water's face there (the nearest lake or river surface; the sea's 0 m; else a metre under the body's middle, about the feet).
func _float_spot(from: Vector3, at: Vector3, reach: float) -> Vector3:
	var flat: Vector2 = Vector2(at.x - from.x, at.z - from.z)

	if not at.is_finite() or flat.length() < 0.5:
		flat = Vector2(0.0, -3.0)

	flat = flat.limit_length(minf(reach, 12.0))
	var spot: Vector3 = Vector3(from.x + flat.x, from.y - 1.0, from.z + flat.y)
	var y: float = float(fresh_water_y.call(spot, 6.0)) if fresh_water_y.is_valid() else NAN

	if is_finite(y) and absf(y - spot.y) < 12.0:
		spot.y = y
	elif water_kind_at.is_valid() and str((water_kind_at.call(spot.x, spot.z) as Dictionary).get("kind", "")).begins_with("sea") and absf(spot.y) < 12.0:
		spot.y = 0.0

	return spot


func passed_out(peer: int) -> bool:
	return _cold_out.has(peer)


# Fainted from strain, or passed out from cold or in water, and not yet up again (strain state 2 fainted, 3 waking): the others see the body lying.
func fainted_of(peer: int) -> bool:
	return int(_strain.get(peer, {}).get("state", 0)) >= 2


# Passing out from strain: past the faint threshold, before the black is full (state 2). The body is already out of the player's hands
# (Dave 25 Nov 2026, QA #19): lying, no stance choice, no effort; the client locks movement and actions (strain stance bit 16).
func strain_going(peer: int) -> bool:
	var st: Dictionary = _strain.get(peer, {})
	return bool(st.get("going", false)) and int(st.get("state", 0)) <= 1


# The nearest dry ground to `from` (no more than SHORE_DRY_M of water over it), searched in rings SHORE_STEP_M apart out to SHORE_MAX_M (points
# about a tenth of the radius apart, never under SHORE_STEP_M), 2 m over the ground as every wake spot is set down (_rescue_ground,
# dug_out_height); `from` when none is found or the ground and water are not known. A water pass-out with no rescue place wakes there.
const SHORE_STEP_M := 3.0
const SHORE_MAX_M := 200.0
const SHORE_DRY_M := 0.05

func _dry_shore(from: Vector3) -> Vector3:
	if not ground_height.is_valid() or not water_depth_at.is_valid():
		return from

	var r: float = SHORE_STEP_M

	while r <= SHORE_MAX_M:
		var steps: int = maxi(int(ceil(TAU * r / maxf(SHORE_STEP_M, r * 0.1))), 8)

		for i in steps:
			var a: float = TAU * float(i) / float(steps)
			var x: float = from.x + cos(a) * r
			var z: float = from.z + sin(a) * r
			var g: float = float(ground_height.call(x, z))

			if not is_nan(g) and float(water_depth_at.call(Vector3(x, g, z))) <= SHORE_DRY_M:
				return Vector3(x, g + 2.0, z)

		r += SHORE_STEP_M

	return from


func _warmth_tick(peer: int, v: Dictionary, spent: float, game_s: float) -> void:
	if _warmth_cfg.is_empty():
		return

	var cfg: Dictionary = _warmth_cfg
	_update_soak(peer, game_s)
	var w: float = float(v.get("warmth", 100.0))
	var target: float = warmth_target(peer)
	var tau_h: float = float(cfg.get("tau_warm_h", 0.5)) if target > w else (float(cfg.get("tau_water_h", 0.7)) if bool(_swimming.get(peer, false)) else float(cfg.get("tau_cool_h", 3.0)))
	w += (target - w) * (1.0 - exp(-(game_s / 3600.0) / maxf(tau_h, 0.01)))
	w = clampf(w, 0.0, 100.0)
	v["warmth"] = w
	var hurt_at: float = float(cfg.get("hurt_at", 20.0))

	if _cold_out.has(peer):
		_cold_out_tick(peer, v, spent, hurt_at)
		return

	if w < hurt_at:
		# Cold costs health, slowly, more the colder; like hunger it stops at 1.
		var severe_mult: float = float(_body_cfg().get("severe_hurt_mult", 2.0)) if cold_stage(peer) == 3 else 1.0   # severe cold (docs/design/body_in_weather_design.md 4)
		v["health"] = maxf(float(v["health"]) - float(cfg.get("hurt_per_s", 0.15)) * spent * (hurt_at - w) / maxf(hurt_at, 1.0) * 2.0 * severe_mult * comfort_bonus(peer, "damage_taken_mult"), 1.0)

		# Only with a known position: never moved to the spawn point (review 23 Nov 2026).
		if float(v["health"]) <= 1.0 and bool(cfg.get("pass_out", {}).get("enabled", false)) and rescue_spots.is_valid() and _peer_pos.has(peer):
			_cold_pass_out(peer)
			return

	# Messages with two levels each way, so a player on the edge is not nagged; with body_703 on, a third for severe cold.
	var level: int = int(_cold_level.get(peer, 0))
	var body: Dictionary = _body_cfg()

	if not body.is_empty() and level < 3 and w < float(body.get("severe_at", 8.0)):
		_cold_level[peer] = 3
		_say(peer, str(body.get("say_severe", "You have stopped shivering. Get to a fire, now.")))
	elif level == 3 and w >= float(body.get("severe_clear", 14.0)):
		_cold_level[peer] = 2
	elif level < 2 and w < hurt_at:
		_cold_level[peer] = 2
		_say(peer, str(cfg.get("say_freezing", "You are freezing")))
	elif level == 0 and w < float(cfg.get("cold_at", 40.0)):
		_cold_level[peer] = 1
		_say(peer, str(cfg.get("say_cold", "You are getting cold")))
	elif level == 2 and w >= float(cfg.get("hurt_clear", 32.0)):
		_cold_level[peer] = 1
	elif level == 1 and w >= float(cfg.get("cold_clear", 52.0)):
		_cold_level[peer] = 0
		_say(peer, str(cfg.get("say_warm", "You feel warm again")))
		_wet_wind_told.erase(peer)

	# Why the clothes do not help (coordinator 23 Nov 2026): soaked in the wind, said once a cold spell beside the cold lines.
	if int(_cold_level.get(peer, 0)) > 0 and bool(_wet_wind.get(peer, false)) and not _wet_wind_told.has(peer) and not body.is_empty():
		_wet_wind_told[peer] = true
		_say(peer, str(body.get("say_wet_wind", "You are soaked and the wind cuts through your clothes. Get under a roof or to a fire.")))

	_sync_warmth(peer, false)
	_sync_soak(peer, false)


# The air in a cave at this point (docs/design/cave_climate_design.md; Jamie #709, coordinator 8 Nov 2026): {"air_c", "wind" (0..1, the mouth's
# draught), "dry_share"} blended in from the mouth by warmth.json cave_climate; without cave_climate (or the cave_air callable) the flat cave of #667: the year
# mean, no wind, no drying. outside_c is the day's air at the point as warmth_target works it out.
func _cave_mouth_air(pos: Vector3, outside_c: float) -> Dictionary:
	var deep: float = float(cave_mean_c.call(pos)) if cave_mean_c.is_valid() else NAN
	var at: Dictionary = cave_air.call(pos) if cave_air.is_valid() else {}
	var cfg: Dictionary = _warmth_cfg.get("cave_climate", {})

	if is_nan(deep) or at.is_empty() or cfg.is_empty():
		return {"air_c": deep, "wind": 0.0, "dry_share": 0.0}

	var depth: float = float(at.get("depth_m", INF))
	return {"air_c": CaveClimate.air_c(cfg, outside_c, float(at.get("day_part_c", 0.0)), deep, depth, int(at.get("kind", CaveClimate.LEVEL))),
		"wind": CaveClimate.wind_of_ms(CaveClimate.draught_ms(cfg, outside_c, deep, depth)), "dry_share": CaveClimate.dry_share(cfg, outside_c, deep, depth)}


# The body in weather (docs/design/body_in_weather_design.md; Jamie #703, coordinator 8 Nov 2026): warmth.json body_703 when its flag is on, else empty,
# and every reader falls back to today's numbers.
func _body_cfg() -> Dictionary:
	var body: Variant = _warmth_cfg.get("body_703", {})
	return body if typeof(body) == TYPE_DICTIONARY and bool(body.get("enabled", false)) else {}


# The cold stage on the warmth bar: 0 fine, 1 mild (under cold_at), 2 moderate (under hurt_at), 3 severe (under body_703 severe_at, flag on only).
func cold_stage(peer: int) -> int:
	if _warmth_cfg.is_empty():
		return 0

	var w: float = float(vitals_of(peer).get("warmth", 100.0))
	var body: Dictionary = _body_cfg()

	if not body.is_empty() and w < float(body.get("severe_at", 8.0)):
		return 3

	if w < float(_warmth_cfg.get("hurt_at", 20.0)):
		return 2

	return 1 if w < float(_warmth_cfg.get("cold_at", 40.0)) else 0


# How many times as long an action takes in the cold (body_703 moderate_pace and severe_pace; 1 with the flag off). Nothing is refused, so a
# freezing player can still light a fire, only slowly.
func cold_pace(peer: int) -> float:
	var body: Dictionary = _body_cfg()

	if body.is_empty():
		return 1.0

	match cold_stage(peer):
		3:
			return maxf(float(body.get("severe_pace", 2.5)), 1.0)
		2:
			return maxf(float(body.get("moderate_pace", 1.5)), 1.0)

	return 1.0


# Rain or snow on an uncovered player soaks them toward the rain's strength (soak_per_h), swimming soaks them through; out of it they dry only in shelter:
# slowly under a tree or roof (dry_cover_per_h), fast within reach of a lit fire (dry_fire_per_h); in the open they stay wet, and in a cave
# (cover from the rain, but air near saturated) only a fire dries them.
func _update_soak(peer: int, game_s: float) -> void:
	var cfg: Dictionary = _warmth_cfg
	var pos: Vector3 = _peer_pos.get(peer, Vector3.ZERO)
	var weather: Dictionary = _weather_here(pos)
	var covered: bool = _vitals_cover(pos) > 0.5
	var precip: float = maxf(float(weather.get("rain", 0.0)), float(weather.get("snow", 0.0)))
	var v: Dictionary = vitals_of(peer)
	var soak: float = float(_soak[peer]) if _soak.has(peer) else clampf(float(v.get("soak", 0.0)), 0.0, 1.0)   # wet clothes stay wet over a restart or a rejoin (survival walk 23 Nov 2026)
	var in_cave: bool = cave_mean_c.is_valid() and not is_nan(float(cave_mean_c.call(pos)))
	var hours: float = game_s / 3600.0

	var by_fire: bool = false

	for row in _heat_rows():   # within a lit fire's heat reach (a Fireplace or brazier too), as warmth_target counts it
		var tier_row: Dictionary = row[1]

		if (row[0] as Vector3).distance_to(pos) <= float(tier_row.get("heat_radius_m", cfg.get("fire_radius_m", 4.0))):
			by_fire = true
			break

	_by_fire[peer] = by_fire   # the comfort meter's "warmed by a fire" point

	if bool(_swimming.get(peer, false)):
		soak = 1.0   # in the water: soaked through
	elif precip > 0.05 and not covered:
		var reaches: float = 1.0 - rain_shed(peer)   # an oilcloth cloak keeps most of the rain off: slower to soak, and less wet in the end
		soak = minf(soak + float(cfg.get("soak_per_h", 4.0)) * reaches * hours, maxf(soak, minf(precip * 2.0, 1.0) * reaches))
	elif by_fire:   # body_703 on: wool by a fire dries in hours, not minutes (docs/design/body_in_weather_design.md 2)
		soak = maxf(soak - float(_body_cfg().get("dry_fire_per_h", cfg.get("dry_fire_per_h", 6.0))) * hours, 0.0)
	elif covered and not in_cave:
		soak = maxf(soak - float(_body_cfg().get("dry_cover_per_h", cfg.get("dry_cover_per_h", 1.0))) * hours, 0.0)
	elif in_cave:
		# Cave air past the mouth is 98 to 100% wet: only a fire dries you there (#664); a winter mouth's dry incoming air dries at half (#709).
		var outside: float = _air_here(pos, weather, float(cfg.get("comfort_c", 15.0)))   # the height in once (weather_at's temp_c carries it)
		var share: float = float(_cave_mouth_air(pos, outside).get("dry_share", 0.0))
		soak = maxf(soak - float(_body_cfg().get("dry_cover_per_h", cfg.get("dry_cover_per_h", 1.0))) * share * hours, 0.0)

	_soak[peer] = soak

	if not v.is_empty() and (soak > 0.0 or v.has("soak")):
		v["soak"] = soak   # saved with the vitals (vitals.json)


# How soaked the clothes are, for the status strip (Dave 23 Nov 2026: the player is told why the cold bites): the soak in steps of 10 percent
# and whether the wind cuts through it (_wet_wind), sent only when one of them changes, from the slow vitals tick.
func _sync_soak(peer: int, force: bool) -> void:
	if not send_soak.is_valid():
		return

	var percent: int = int(round(clampf(float(_soak.get(peer, vitals_of(peer).get("soak", 0.0))), 0.0, 1.0) * 10.0)) * 10
	var windy: bool = percent > 0 and bool(_wet_wind.get(peer, false))
	var code: int = percent + (1000 if windy else 0)

	if force or int(_soak_sent.get(peer, -1)) != code:
		_soak_sent[peer] = code
		send_soak.call(peer, percent, windy)


func _sync_warmth(peer: int, force: bool) -> void:
	if not send_warmth.is_valid():
		return

	var pct: int = int(ceil(clampf(float(vitals_of(peer).get("warmth", 100.0)), 0.0, 100.0)))

	if force or int(_warmth_sent.get(peer, -1)) != pct:
		_warmth_sent[peer] = pct
		send_warmth.call(peer, pct)


# --- Food spoilage (Dave: gentle; data/items/spoilage.json) ---
# Age lives in the slot's wear field (tenths of a game hour), so nothing about saves or the wire changes: old stacks read as
# fresh. One slow step every tick_s ages every pack, chest, remains and loose item; a stack at its shelf life becomes rotten food.

# `key` keeps its own running fraction (a place in another season than the calendar's: "chest|winter"); `place` names the place_mult row (default: key).
func _spoil_units(key: String, base_units: float, season_mult: float, place: String = "") -> int:
	var cfg: Dictionary = table.spoilage()
	var mult: float = float(cfg.get("place_mult", {}).get(key if place == "" else place, 1.0)) * season_mult
	_spoil_acc[key] = float(_spoil_acc.get(key, 0.0)) + base_units * mult
	var whole: int = int(_spoil_acc[key])
	_spoil_acc[key] -= float(whole)
	return whole


# The air inside a cold store (root cellar; item_system.md D1, Sonny): the ground from about 2 m down holds the site's year-mean air all year, so
# the cellar sits at Climate.year_mean_c for its height; in a cave cell it is the cave air's year mean (cave_mean_c, 5.5 C at cave 8002, #717).
# NAN when neither is known (a test without the callables): the store then spoils like a plain chest.
func cold_store_c(pos: Vector3) -> float:
	var cave_c: float = float(cave_mean_c.call(pos)) if cave_mean_c.is_valid() else NAN

	if not is_nan(cave_c):
		return cave_c

	return float(year_mean_at.call(pos)) if year_mean_at.is_valid() else NAN


# On opening a cold store: how cool it is inside and how much longer food keeps there than in the pack.
func _say_cold_store(peer: int, id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("struct") or not bool(_structures.get(str(it["struct"]["kind"]), {}).get("cold_store", false)):
		return

	var cold_c: float = cold_store_c(it["pos"])

	if is_nan(cold_c):
		return

	var cold_mult: float = cold_store_mult(table.spoilage().get("cold_store", {}), cold_c)
	_say(peer, "It is %d C in here all year. Food keeps about %d times as long as in a pack." % [roundi(cold_c), roundi(1.0 / cold_mult)])


# How fast food spoils at `temp_c` against the pack's rate (spoilage.json cold_store): q10 for every 10 C below ref_c, never under min_mult and
# never above 1 (a warm cellar is no worse than a pack).
static func cold_store_mult(cold_cfg: Dictionary, temp_c: float) -> float:
	var q10: float = float(cold_cfg.get("q10", 3.0))
	var ref_c: float = float(cold_cfg.get("ref_c", 20.0))
	return clampf(pow(q10, (temp_c - ref_c) / 10.0), float(cold_cfg.get("min_mult", 0.1)), 1.0)


# Ages one inventory by `units`; true when anything changed.
func _spoil_inventory(inv, units: int) -> bool:
	var rotten: int = table.number_of(str(table.spoilage().get("rotten_item", "rotten_food")))
	var changed: bool = false

	for i in inv.slot_count:
		var aged: Array = []

		if inv.numbers[i] != 0 and _spoil_bag(inv.numbers[i], inv.inst[i], units, aged):
			inv.inst[i] = aged[0]
			changed = true

		var life: int = table.shelf_units(inv.numbers[i])

		if life <= 0:
			continue

		changed = true
		inv.wear[i] = mini(inv.wear[i] + units, 65535)

		if inv.wear[i] >= life:
			inv.numbers[i] = rotten
			inv.wear[i] = 0
			inv.inst[i] = {}   # rotten food is plain, so it joins the next rotten stack (a torch's in-place change keeps its instance)
			inv.counts[i] = mini(inv.counts[i], table.stack_of(rotten))

	return changed


func _spoil_tick(spent: float) -> void:
	var cfg: Dictionary = table.spoilage()

	if cfg.is_empty():
		return

	_spoil_in += spent
	var every: float = float(cfg.get("tick_s", 15))

	if _spoil_in < every:
		return

	var steps: int = int(_spoil_in / every)
	_spoil_in -= float(steps) * every
	var base: float = float(steps) * every * GAME_RATE / 3600.0 / float(cfg.get("unit_h", 0.1))
	# Each place spoils by its own season (half a year on across the equator): a pack where its player is (or last was), a chest where it
	# stands, a thing on the ground where it lies. Places in the calendar's season keep the old running fractions ("pack", "chest", ...).
	var season_bands: Dictionary = {}  # 1 km band of z -> season, for this tick (a season changes only at the equator's row edge, far wider)
	var units_of: Dictionary = {}       # "place|season" -> units this tick
	var calendar: String = _season()   # starter-calendar: the calendar's season keeps the old running keys
	var season_for: Callable = func(pos: Vector3) -> String:
		if not season_at.is_valid() or not pos.is_finite():
			return calendar

		var band: int = floori(pos.z / 1000.0)   # shortcut: the band holding the equator row's edge reads one season for up to 1 km of it

		if not season_bands.has(band):
			season_bands[band] = _season_of(pos)

		return str(season_bands[band])
	var units_at: Callable = func(place: String, pos: Vector3) -> int:
		var here: String = season_for.call(pos) if season_now.is_valid() or season_at.is_valid() else ""
		var key: String = place if here == calendar or here == "" else place + "|" + here

		if not units_of.has(key):
			var mult: float = float(cfg.get("season_mult", {}).get(here, 1.0)) if here != "" else 1.0
			units_of[key] = _spoil_units(key, base, mult, place)

		return int(units_of[key])
	var peer_of_key: Dictionary = {}

	for peer in _peer_key:
		peer_of_key[_peer_key[peer]] = peer

	for key in _inventories:
		var peer: int = int(peer_of_key.get(key, 0))
		var last: Array = (_characters.get(key, {}).get("last", {}) as Dictionary).get("pos", [])
		var at: Vector3 = _peer_pos.get(peer, Vector3(float(last[0]), float(last[1]), float(last[2])) if last.size() == 3 else Vector3.INF)
		var pack_units: int = units_at.call("pack", at)

		if pack_units <= 0:
			continue

		var before: Array = _snapshot(_inventories[key]) if peer != 0 else []

		if _spoil_inventory(_inventories[key], pack_units):
			_dirty = true

			if peer != 0:
				_send_changes(peer, _inventories[key], before)

		var worn: Array = _characters.get(key, {}).get("worn", [])

		for i in worn.size():   # a worn bag's food spoils as in the pack
			var aged: Array = []

			if typeof(worn[i]) == TYPE_ARRAY and (worn[i] as Array).size() > 3 and _spoil_bag(int(worn[i][0]), worn[i][3], pack_units, aged):
				worn[i] = [int(worn[i][0]), 1, int(worn[i][2]), aged[0]]
				_dirty = true

				if peer != 0:
					_sync_worn(peer, false)

	var kind_of_uid: Dictionary = {}
	var pos_of_uid: Dictionary = {}
	var riding: Array = []   # crates on a cart, found in the same pass (no second pass when none ride)

	for id in _items:
		if _items[id].has("struct") and _items[id]["struct"].has("uid"):
			kind_of_uid[int(_items[id]["struct"]["uid"])] = str(_items[id]["struct"]["kind"])
			pos_of_uid[int(_items[id]["struct"]["uid"])] = _items[id]["pos"]

			if _items[id]["struct"].has("on"):
				riding.append(id)

	for id in riding:
		kind_of_uid[int(_items[id]["struct"]["uid"])] = _carts.place_kind(_items[id], kind_of_uid)   # a crate on a cart ages at the cart's place_mult (s3.13: in transit)

	var place_units: Dictionary = {}

	for uid in _chests:
		var kind: String = str(kind_of_uid.get(uid, "chest"))

		# A cold store (root cellar, item_system.md D1) keeps the ground's year-round temperature, so the season does not reach it: its rate
		# follows that temperature alone. Cellars at the same temperature share one running fraction.
		if bool(_structures.get(kind, {}).get("cold_store", false)) and pos_of_uid.has(uid):
			var cold_c: float = cold_store_c(pos_of_uid[uid])

			if not is_nan(cold_c):
				var cold_mult: float = cold_store_mult(cfg.get("cold_store", {}), cold_c)
				kind = "cold@%.2f" % cold_mult

				if not place_units.has(kind):
					place_units[kind] = _spoil_units(kind, base * cold_mult, 1.0)

		var units: int = int(place_units[kind]) if place_units.has(kind) else units_at.call(kind, pos_of_uid.get(uid, Vector3.INF))

		if units > 0 and _spoil_inventory(_chests[uid], units):
			_dirty = true

	var rotten_n: int = table.number_of(str(cfg.get("rotten_item", "rotten_food")))

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") or it.has("fire") or it.has("tree") or it.has("boulder"):
			continue

		var ground_units: int = units_at.call("ground", it["pos"])

		if ground_units <= 0:
			continue

		var aged: Array = []

		if _spoil_bag(int(it["number"]), it.get("inst", {}), ground_units, aged):   # a bag on the ground keeps its contents, and they age
			it["inst"] = aged[0]
			_dirty = true

		var life: int = table.shelf_units(int(it["number"]))

		if life <= 0:
			continue

		it["wear"] = int(it.get("wear", 0)) + ground_units
		_dirty = true

		if int(it["wear"]) >= life:
			it["number"] = rotten_n
			it["wear"] = 0
			it.erase("inst")


# --- Death and remains (Dave: DESIGN_IDEAS.md 6.1; data/items/death.json) ---
# A character whose health reaches zero dies: the whole pack goes onto a remains record where they fell (server-owned,
# a chest with no lid that only the owner may open for the first day), their vitals start over, and they are put back at
# the spawn point. Luck, fitness and skills are kept; placed things stay where they are.

func _unix() -> float:
	return float(unix_now.call()) if unix_now.is_valid() else Time.get_unix_time_from_system()


func _remains_age(it: Dictionary) -> float:
	if str(it["struct"]["kind"]) != "remains":
		return 0.0

	return clampf((_unix() - float(it["struct"].get("born", 0.0))) / maxf(float(_death_cfg.get("gone_s", 604800)), 1.0), 0.0, 1.0)


# Row state clients draw by: 11 fresh remains (day 1, owner only), 12 once anyone may take the gear.
func _struct_state(it: Dictionary) -> int:
	var state: int = int(_structures.get(str(it["struct"]["kind"]), {}).get("state", 5))

	if state == 11 and _unix() - float(it["struct"].get("born", 0.0)) >= float(_death_cfg.get("owner_only_s", 86400)):
		return 12

	return state


func _may_open_remains(peer: int, it: Dictionary) -> bool:
	return str(it["struct"].get("owner", "")) == str(_peer_key.get(peer, "?")) or _unix() - float(it["struct"].get("born", 0.0)) >= float(_death_cfg.get("owner_only_s", 86400))


func remains_ids() -> Array:
	var out: Array = []

	for id in _items:
		if _items[id].has("struct") and str(_items[id]["struct"]["kind"]) == "remains":
			out.append(id)

	return out


# The character level the novice grace reads (death.json novice_grace.metric): 'best_skill' is the highest effective skill value (what the skills page shows; 1 at the start, 100 at
# the top), 'skill_total' the sum over all skills of (value - 1).
func character_level(peer: int) -> int:
	var records: Dictionary = _skill_records(peer)
	var metric: String = str(_death_cfg.get("novice_grace", {}).get("metric", "best_skill"))
	var best: float = 1.0
	var total: float = 0.0

	for id in _skills_cfg.get("skills", {}):
		var value: float = SkillWeb.effective(_skills_cfg, str(id), records)
		best = maxf(best, value)
		total += value - 1.0

	return int(floor(total)) if metric == "skill_total" else int(floor(best))


# True while this character still respawns at the bed after dying (the novice grace); false = real death. Mode 'always' (the default) is the old behaviour for everyone.
func novice_grace(peer: int) -> bool:
	var rule: Dictionary = _death_cfg.get("novice_grace", {})
	var mode: String = str(rule.get("mode", "always"))

	if mode == "never":
		return false

	if mode == "level":
		return character_level(peer) < int(rule.get("level", 5))

	return true   # 'always', and 'heir' until children exist


# The character dies. Returns false when there is nobody to kill (no such player, no position yet, death switched off).
func kill(peer: int, cause: String) -> bool:
	var key: String = str(_peer_key.get(peer, ""))
	var inv = inventory_of(peer)

	if key == "" or inv == null or not _peer_pos.has(peer) or _death_cfg.is_empty() or not _structures.has("remains"):
		return false

	_characters[key].erase("rested")   # an old save's Rested buff (retired)
	_characters[key]["comfort"] = 0.0  # death empties the comfort meter
	_characters[key].erase("food")     # and every food effect (s3.16)
	_sync_food(peer, true)
	_carts.release(peer, "")   # a cart in hand stays where they fell
	var pos: Vector3 = _peer_pos[peer]
	var ground: float = float(ground_height.call(pos.x, pos.z)) if ground_height.is_valid() else NAN
	var cave: bool = not is_nan(ground) and pos.y < ground - 1.5   # underground: keep the spot, the surface above is not theirs
	var spot: Vector3 = pos if (is_nan(ground) or cave) else Vector3(pos.x, _remains_surface(pos, _foundation_rows()), pos.z)   # on the floor they stood on, or the ground as dug

	if cave and not is_nan(ground):
		var under: float = _remains_surface(pos, _foundation_rows())   # deep in a cave: its floor (a death in mid-jump does not hang in the air; the settle pass skips cave remains)

		if under < ground - 0.5 and under <= pos.y + 0.05:
			spot.y = under
	_trim_owner_remains(key)
	var uid: int = _next_uid
	_next_uid += 1
	var chest = InventoryScript.new(table)
	chest.from_json_array(inv.to_json_array())
	_chests[uid] = chest
	var remains_id: int = _next_id
	_items[_next_id] = {"number": table.number_of("remains"), "count": 1, "pos": spot, "left": 1.0e9, "struct": {"kind": "remains", "yaw": float(randi() % 360), "uid": uid, "owner": key, "born": _unix(), "cave": cave, "coins": coins_of(peer)}}   # luck-exempt: a body's facing
	_next_id += 1
	inv.from_json_array(InventoryScript.new(table).to_json_array())
	send_full.call(peer, inv.to_bytes())
	_send_favs(peer, inv)

	sync_shoulder(peer)   # the log in the pack went with the remains

	# Dave 2026-10-21: the purse stays on the body, so the whole purse lies with the remains and is found like the other things.
	if _characters.has(key):
		_characters[key]["purse"] = {}
		sync_purse(peer)

	_sync_remains(peer, true)

	# Start over: vitals, strain, sleep, breath. Luck, fitness and skills live in characters.json and stay.
	_vitals[key] = _new_vitals()
	_strain.erase(peer)
	_soak.erase(peer)   # dry clothes, as the saved vitals say
	_cold_out.erase(peer)   # a death while passed out from cold ends the pass-out: no rescue move after the respawn
	_out_water.erase(peer)
	_strain_sent.erase(peer)
	_asleep.erase(peer)
	_waking.erase(peer)
	_body_sent.erase(peer)
	_breath.erase(peer)
	_suffocate.erase(peer)
	_head_under.erase(peer)
	_exertion[peer] = 0.0
	_stance[peer] = 0
	_work_until.erase(peer)
	_death_cause.erase(peer)
	_energy_sent.erase(peer)
	_warmth_sent.erase(peer)
	_soak_sent.erase(peer)
	_sick_sent.erase(peer)
	_limp_sent.erase(peer)
	_symptom_in.erase(peer)
	_cold_level.erase(peer)
	_wet_wind_told.erase(peer)
	_fishing.erase(peer)
	_hole_blows.erase(peer)
	if not novice_grace(peer):
		_characters[key]["final_death_pending"] = true   # real death: the remains stay; the new-character / heir flow is not built, so the character still comes back below

		# Only with real death on: the screen's one button deletes the character, so a respawning character must never see it.
		if bool(_death_cfg.get("real_death", false)) and send_final_death.is_valid():   # the character does not come back (Dave's cards pending: off by default)
			send_final_death.call(peer, cause)
			_characters[key]["dead"] = true
			_dirty = true
			return true

	var back: Vector3 = respawn_for(peer, true)
	_peer_pos[peer] = back
	_resume_to.erase(peer)   # a death before the client reached its resume spot: from here the spot saved is where they come back
	_motion.erase(peer)
	_sync_breath(peer, -1)
	_sync_vitals(peer, true)
	_dirty = true

	if send_died.is_valid():
		send_died.call(peer, cause, back)

	if back != respawn_point:
		_say(peer, "You come back at your shelter")

	if _items.has(remains_id) and _remains_hold(_items[remains_id]):   # the set made above: a new player has no shelter and must be told where their things went
		_say(peer, "Your things are on your remains where you fell. Press Tab to see which way.")

	return true


# A tunnel collapse on a player when nothing kills (death.json stop_at_1, Dave 23 Nov 2026): dug out onto the ground above (`to`), health 1,
# the pack kept. The client plays the cave-in sequence without the death lines. Returns false when stop_at_1 is off (the caller kills).
# Where a dug-out player stands: 2 m over the highest of the ground, the edited ground (a fill on it) and any water over it (NAN: none, as
# terrain_server _water_at gives on dry land), never under the sea's 0 m.
static func dug_out_height(surface: float, edited: float, water: float) -> float:
	var top: float = 0.0

	for h in [surface, edited, water]:
		if not is_nan(float(h)):
			top = maxf(top, float(h))

	return top + 2.0


func survive_cave_in(peer: int, to: Vector3, to_fire: bool = false) -> bool:
	var v: Dictionary = vitals_of(peer)

	if not bool(_death_cfg.get("stop_at_1", false)) or v.is_empty():
		return false

	_out_water.erase(peer)
	_cold_out.erase(peer)   # a cave-in on a player passed out from cold ends that faint; still frozen at 1 health, the cold passes them out again and they are carried to shelter
	v["health"] = minf(float(v["health"]), 1.0)
	_peer_pos[peer] = to
	_resume_to.erase(peer)
	_motion.erase(peer)
	_sync_vitals(peer, true)
	_dirty = true

	if send_died.is_valid():
		send_died.call(peer, "cave-in survived", to)

	_say(peer, "The tunnel came down on you. Someone heard you under the rock, dug you out and carried you to the nearest campfire, barely alive." if to_fire else "The tunnel came down on you. Someone heard you under the rock and dug you out, barely alive.")
	return true


# A player stuck fast in the rock of a cave or tunnel (ACT_STUCK, sent by the client's rescue when it stood the body on the floor of air near
# by): carried to the nearest campfire out of the rock (Dave 23 Nov 2026: "if you are in a cave and end up getting rescued they should deposit
# you at the nearest civilization and for these purposes that means campfire for now"), pack kept. Only when the server's own ground has the
# point inside rock (feet, middle and eyes, as the client's inside_solid), near where the player is, once in STUCK_COOLDOWN_MS: no fast way
# out of a cave by asking.
const STUCK_REACH_M := 16.0        # the client's pocket floor is at most 12 m over the stuck point (rescue.gd POCKET_UP_M), and a step round
const STUCK_COOLDOWN_MS := 20000
var _stuck_msec: Dictionary = {}   # peer -> msec of the last ACT_STUCK looked at


func _stuck_rescue(peer: int, at: Vector3) -> void:
	var now: int = Time.get_ticks_msec()

	if not _peer_pos.has(peer) or not at.is_finite() or (_peer_pos[peer] as Vector3).distance_to(at) > STUCK_REACH_M or not cave_rescue.is_valid() or not send_died.is_valid():
		return

	if _stuck_msec.has(peer) and now - int(_stuck_msec[peer]) < STUCK_COOLDOWN_MS:
		return

	if not player_under_rock.is_valid() or not bool(player_under_rock.call(_peer_pos[peer])):
		return   # the player's own spot is not in a cave or tunnel: a stuck point claimed under open ground is no free trip to a fire (main gate review 8)

	if not ground_open.is_valid() or bool(ground_open.call([at + Vector3(0.0, -0.7, 0.0), at, at + Vector3(0.0, 0.7, 0.0)])):
		return   # the server's ground is open there: not stuck

	_stuck_msec[peer] = now
	var spots: Array = cave_rescue.call(at)   # [] unless `at` is under rock (a cave or a dug tunnel): stuck in a hillside is the client's surface rescue

	if spots.is_empty():
		return   # no campfire out of the rock anywhere: the client's own rescue onto the floor near by stands

	var to: Vector3 = spots[0][0]
	_peer_pos[peer] = to
	_resume_to.erase(peer)
	_motion.erase(peer)
	_dirty = true
	send_died.call(peer, "rescued", to)   # the client moves the body there and waits for the ground, as after a pass-out (no death screen)
	_say(peer, "You were stuck fast in the rock. Someone dug you out and brought you to the nearest campfire.")
	print("Stuck: peer %d stuck in rock at %s, carried to the %s at %s" % [peer, str(at), str(spots[0][1]), str(to)])


# The nearest of `fires` ([position, kind]; a NAN height is read from `ground_y` (x, z)) whose flames are not under rock (`under_rock` (point)):
# [position, kind], or [] when every one is in a cave or tunnel or there is none (terrain_server _cave_rescue).
static func nearest_fire_out_of_rock(fires: Array, near: Vector3, under_rock: Callable, ground_y: Callable) -> Array:
	var best: Array = []
	var best_d: float = INF

	for fire in fires:
		var at: Vector3 = fire[0]
		var d: float = Vector2(at.x, at.z).distance_to(Vector2(near.x, near.z))

		if d >= best_d:
			continue

		if is_nan(at.y):
			at.y = float(ground_y.call(at.x, at.z))

		if bool(under_rock.call(at + Vector3(0.0, 0.5, 0.0))):
			continue   # a fire inside a cave or tunnel: the rescue is out of the rock

		best = [at, fire[1]]
		best_d = d

	return best


# Every fire in the world (any owner's, lit or not; the camps' too) as [position, "campfire" | "town" | "goblin" | "bandit"]: where a player
# rescued in a cave is carried (terrain_server _cave_rescue). A camp fire's "camp" names it: a string a bandit camp's, NpcCamp.fires() index 0
# Edda and Hob's (the town's), a higher index a goblin tribe's. A bandit camp's boot-print mark at the road is not a fire. Only on a rescue.
func campfires() -> Array:
	var out: Array = []
	var town_first: bool = NpcCamp.fire_spot().x != INF   # index 0 is Edda and Hob's only when the town has its fire

	for id in _items:
		var fire: Variant = (_items[id] as Dictionary).get("fire")

		if fire == null or bool((fire as Dictionary).get("marks", false)):
			continue

		var camp: Variant = (fire as Dictionary).get("camp")
		var kind: String = "campfire"

		if typeof(camp) == TYPE_STRING:
			kind = "bandit"
		elif typeof(camp) == TYPE_INT:
			kind = "town" if int(camp) == 0 and town_first else "goblin"

		out.append([_items[id]["pos"], kind])

	return out


# One character cannot litter the world: with per_owner_cap sets already out, the oldest empty set goes first to make room for the new one.
# Remains that still hold anything (an item or coins) are never removed to make room (Dave: no ground-item cap; coordinator 22 Nov 2026), so a player may have more.
func _trim_owner_remains(key: String) -> void:
	var cap: int = int(_death_cfg.get("per_owner_cap", 5))
	var mine: Array = []
	var empty: Array = []

	for id in remains_ids():
		if str(_items[id]["struct"].get("owner", "")) == key:
			mine.append(id)

			if not _remains_hold(_items[id]):
				empty.append(id)

	while mine.size() >= cap and cap > 0 and not empty.is_empty():
		var drop: int = empty[0]

		for id in empty:
			if float(_items[id]["struct"].get("born", 0.0)) < float(_items[drop]["struct"].get("born", 0.0)):
				drop = id

		_chests.erase(int(_items[drop]["struct"].get("uid", 0)))
		_items.erase(drop)
		mine.erase(drop)
		empty.erase(drop)
		_dirty = true


# Whether a set of remains still holds something: an item on them or the purse's coins (kept apart in struct.coins).
func _remains_hold(it: Dictionary) -> bool:
	var chest = _chests.get(int(it["struct"].get("uid", 0)))
	return (chest != null and not chest.is_empty()) or int(it["struct"].get("coins", 0)) > 0


# The owner's death markers (protocol 39): every set of their remains that still holds something, with the seconds until it is cleaned up.
func _remains_rows(key: String) -> Array:
	var rows: Array = []
	var gone_s: float = float(_death_cfg.get("gone_s", 604800))

	for id in remains_ids():
		var it: Dictionary = _items[id]

		if str(it["struct"].get("owner", "")) != key:
			continue

		if not _remains_hold(it):
			continue

		rows.append([it["pos"], maxi(int(gone_s - (_unix() - float(it["struct"].get("born", 0.0)))), 0)])

	return rows


func _sync_remains(peer: int, force: bool) -> void:
	if not send_remains.is_valid() or not _peer_key.has(peer):
		return

	var rows: Array = _remains_rows(str(_peer_key[peer]))
	var shape: Array = []

	for row in rows:
		shape.append(row[0])

	if not force and _remains_sent.get(peer, []) == shape:
		return

	_remains_sent[peer] = shape
	send_remains.call(peer, rows)


# Once in a while: clean up remains that have run their seven days and put the others back on the surface when the ground
# under them has changed (digging, a fill). The record never moves anywhere else; the sinking is only a drawing offset.
func _remains_tick(spent: float) -> void:
	_remains_check_in -= spent

	if _remains_check_in > 0.0 or _death_cfg.is_empty():
		return

	_remains_check_in = float(_death_cfg.get("recheck_s", 30))
	var gone_s: float = float(_death_cfg.get("gone_s", 604800))

	for peer in _peer_key:
		_sync_remains(peer, false)

	var rows: Array = []   # [_foundation_rows()] once some remains need it
	var full: bool = _unix() >= _remains_full_at   # every REMAINS_SETTLE_S all remains are looked at, those on the generated ground too: one saved
	# before #1552 under a slab, or one a foundation was later laid over, comes up onto it (the first tick after a start does this at once)

	if full:
		_remains_full_at = _unix() + REMAINS_SETTLE_S

	for id in remains_ids():
		var it: Dictionary = _items[id]

		if _unix() - float(it["struct"].get("born", 0.0)) >= gone_s:
			_chests.erase(int(it["struct"].get("uid", 0)))
			_items.erase(id)
			_remains_settled.erase(id)
			_dirty = true
			continue

		if bool(it["struct"].get("cave", false)) or not ground_height.is_valid():
			continue

		var ground: float = float(ground_height.call(it["pos"].x, it["pos"].z))

		var settled: Array = _remains_settled.get(id, [])

		if is_nan(ground) or (not full and absf(ground - it["pos"].y) <= 0.25) or (not full and settled.size() == 2 and is_equal_approx(float(settled[0]), float(it["pos"].y)) and _unix() - float(settled[1]) < REMAINS_SETTLE_S):
			continue   # on the generated ground, or found resting here lately (the floor and edits scan runs every REMAINS_SETTLE_S per set, not every tick)

		if rows.is_empty():
			rows = [_foundation_rows()]   # read once a tick, and only when some remains are off the generated ground (on a floor, in a dug spot)

		var floor_rows: Array = rows[0]
		var surface: float = _remains_surface(it["pos"], floor_rows)

		if not is_nan(surface) and absf(surface - it["pos"].y) > 0.25:
			it["pos"].y = surface
			_dirty = true

		_remains_settled[id] = [float(it["pos"].y), _unix()]


const REMAINS_SETTLE_S := 600.0   # remains off the generated ground are looked at again this often: a floor taken down or a fill dug away lets them settle
var _remains_full_at: float = 0.0   # unix time of the next pass over every remains (memory only: a start does one at once)
var _remains_settled: Dictionary = {}   # remains world id -> [the y the recheck found them resting at, unix time] (memory only)


# Where remains rest at `pos` (a point a little above or below the surface): the top of a foundation or floor within reach of it (a death in a house is
# not buried under the slab), else the ground as dug and filled, or the floor of a cave they are in (round 6, 23 Nov 2026: the settle pass lifted
# remains in a cave onto the hill above). `rows` is _foundation_rows().
func _remains_surface(pos: Vector3, rows: Array) -> float:
	var top: float = PlacementRules.support_top(_structures_cfg, pos, rows, true)

	if not is_nan(top):
		return top

	var dug: float = _edited_height(pos.x, pos.z, (edits_near.call(pos, 4.0) if edits_near.is_valid() else []) as Array)
	var floor_y: float = _cave_ground(pos, dug)   # in a cave: its floor, where the owner can reach them

	if floor_y != dug and floor_y < pos.y - REMAINS_CAVE_DROP_M:
		return pos.y   # over a cave spring pool's 20 m basin: they stay where they fell, at the water, not on its far bottom

	return floor_y


const REMAINS_CAVE_DROP_M := 3.0   # remains in a cave fall at most this far to its floor


# --- Fall damage (job 62) ---
# The client reports a landing from at least the sound threshold; the server turns the drop into damage (data/items/vitals.json
# "fall"): nothing under safe_m, per_m health per metre beyond it, a faint from faint_m. Health never goes below 1 (nothing kills yet).
# A client that stays silent only spares itself; reports are limited to one per 2 s and a drop is capped at 60 m.
func _fall(peer: int, centimetres: int) -> void:
	var cfg: Dictionary = _vitals_cfg.get("fall", {})
	var v: Dictionary = vitals_of(peer)
	var now: int = Time.get_ticks_msec()

	if cfg.is_empty() or v.is_empty() or now - int(_last_fall.get(peer, -100000)) < 2000:
		return

	var drop: float = clampf(float(centimetres) / 100.0, 0.0, 60.0)
	# The jumping skill (Dave 2026-10-21): a better jumper can drop further unhurt and takes less damage per metre beyond.
	# skill_factor is 1.0 until the skill system exists; it never makes a fall worse than the base numbers.
	var jump: float = maxf(skill_factor(peer, "fall"), 1.0)
	var safe_m: float = float(cfg.get("safe_m", 6.0)) * jump
	var damage: float = maxf(drop - safe_m, 0.0) * float(cfg.get("per_m", 8.0)) / jump

	if damage <= 0.0:
		return

	_last_fall[peer] = now
	practice(peer, "fall", clampf(drop / maxf(safe_m, 1.0), 0.2, 2.0))
	v["health"] = maxf(float(v["health"]) - damage * comfort_bonus(peer, "damage_taken_mult"), 1.0)
	_say(peer, "The fall hurt")

	if not _forced_sleep(peer):
		_asleep.erase(peer)

	if drop >= float(cfg.get("faint_m", 12.0)) * jump and not _exertion_cfg.is_empty():
		_strain[peer] = {"s": float(_exertion_cfg.get("faint_at", 1.4)) + 0.05, "state": 1, "t": 0.0, "black": 1.0, "going": true}   # going: out on the next tick, whatever the body's faint threshold

	_sync_vitals(peer, true)


# --- Crafting queue (Dave 2026-10-20, like Ark) ---
# Crafts line up per player and run one after another while the player is connected, screen open or not.
# Ingredients are taken when queued and refunded in full when an entry is cancelled (the running one too).
func _queue_of(peer: int) -> Dictionary:
	var key: String = str(_peer_key.get(peer, ""))

	if key == "":
		return {}

	if not _craft_queues.has(key):
		_craft_queues[key] = {"entries": [], "elapsed": 0.0}

	return _craft_queues[key]


# Crafting stations (structures.json "station", "station_level", "reach_m"): a placed structure of that station within reach of the
# player. The server measures the distance with 1 m of grace so lag never fails a craft; the client only displays (Tyler).
func station_near(peer: int, station: String, level: int = 1) -> bool:
	return serving_station(peer, station, level) >= 0


# The world id of the nearest placed station that serves `station` at `level` and is working (a lit fire; a pot over a lit fire), within its
# own reach (station_near) or, with `far_m` above it, within far_m (the crafting reach: _step_to_station); -1 when none.
func serving_station(peer: int, station: String, level: int = 1, far_m: float = 0.0) -> int:
	if not _peer_pos.has(peer):
		return -1

	var here: Vector3 = _peer_pos[peer]
	var best: int = -1
	var best_d: float = INF

	if station == "campfire":   # dishes are cooked at a lit campfire (data/items/dishes.json); a clay hearth or an oven beside you cooks them too ("also" in structures.json)
		for id in _items:
			var fire_item: Dictionary = _items[id]
			var d: float = here.distance_to(fire_item["pos"])

			if fire_item.has("fire") and fire_is_lit(int(fire_item["fire"]["state"])) and not fire_item["fire"].has("camp") and d <= maxf(FIRE_USE_M + 1.0, far_m) and d < best_d:
				best = int(id)
				best_d = d

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or it["struct"].has("site") or it["struct"].has("tribe"):   # a blueprint site is not built yet: it serves as nothing (docs/BLUEPRINT_SITES.md); a goblin camp's rack is theirs
			continue

		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
		var d: float = here.distance_to(it["pos"])

		if d > maxf(float(def.get("reach_m", 3.0)) + 1.0, far_m) or d >= best_d:
			continue

		if station_level_of(it, def, station) >= level:
			if _smithies.broken(int(id)):
				continue   # a worn-out smithy serves nothing until it is repaired (master s2.2 item 9): the craft says Needs repair (_broken_station_near)

			if str(def.get("attach_to", "")) == "fire" and not _lit_fire_within(it["pos"], POT_ON_FIRE_M):
				continue   # the pot hangs over its fire: with that fire out nothing cooks, the craft waits where it is and nothing is lost

			if str(def.get("attach_to", "")) == "fireplace" and not _lit_structure_within(it["pos"], "fireplace", float(def.get("attach_m", 2.5))):
				continue   # the Fireplace cooking crane (master s3.12) hangs its pot over a fireplace: only while that fireplace burns

			# A smithy works only with fuel in its fuel slot (Dave 21 Nov 2026: "smithys should just take coal in a fuel slot ... dont need to be
			# lit"): without it the craft waits and nothing is lost.
			if _fuel_slot_kind(def) and not _smithy_fuelled(it, def):
				continue

			best = int(id)
			best_d = d

	return best


var _step_cfg: Dictionary = {}   # data/items/station_step.json, read on the first step


# Dave 10 Nov 2026: a station recipe crafted from the pack with its station in the crafting reach but not beside you moves you to the station.
# Directly in front of it (its +Z turned by its yaw; a fire: the side you came from), facing it; another player there: to one side, then
# behind. Returns the spot. The client is told (send_step_to) and the server's position is the spot at once, so the station check passes.
func _step_to_station(peer: int, station_id: int) -> Vector3:
	if _step_cfg.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/station_step.json")) if FileAccess.file_exists("res://data/items/station_step.json") else null
		_step_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {"_read": true}

	var it: Dictionary = _items[station_id]
	var centre: Vector3 = it["pos"]
	var front: Vector3

	if it.has("struct") and not it.has("fire"):
		var yaw: float = deg_to_rad(float(it["struct"].get("yaw", 0.0)))
		front = Vector3(sin(yaw), 0.0, cos(yaw)) * float(_step_cfg.get("front_m", 1.3))   # the model's front: Godot's +Z (Vector3.MODEL_FRONT) turned by the yaw
	else:
		var from: Vector3 = Vector3(_peer_pos[peer].x - centre.x, 0.0, _peer_pos[peer].z - centre.z)
		front = (from.normalized() if from.length() > 0.01 else Vector3.BACK) * float(_step_cfg.get("fire_m", 1.5))

	var side: Vector3 = front.normalized().cross(Vector3.UP) * float(_step_cfg.get("side_m", 1.4))
	var spot: Vector3 = centre + front

	for candidate in [centre + front, centre + front.normalized() * front.length() + side, centre + front.normalized() * front.length() - side, centre - front]:
		if not _player_within(candidate, float(_step_cfg.get("clear_m", 0.9)), peer):
			spot = candidate
			break

	if ground_height.is_valid() or ground_now.is_valid():
		var stand: float = _ground_under(spot + Vector3(0.0, 0.5, 0.0))   # a station on a fill or in a dug floor: stood on that ground, not inside it
		spot.y = stand if not is_nan(stand) else spot.y

	_peer_pos[peer] = spot
	var look: Vector3 = centre - spot
	var yaw_to: float = atan2(-look.x, -look.z)   # the client's body.rotation.y facing the station (Godot looks down -Z)

	if send_step_to.is_valid():
		send_step_to.call(peer, spot, yaw_to)

	return spot


const TRAPPED_NEAR_M := 6.0   # players this close to a piece that just went up are checked for standing inside it
const TRAPPED_HIGH_M := 2.5   # ... and this close in height (one storey)


# A wall or a heavy station that just went up (or a door shut) round a player (their own or a friend's): the server steps them to the nearest clear spot, as a
# resume spot is made safe (_safe_resume), so nobody is left stuck inside a finished piece.
func _free_trapped(at: Vector3) -> void:
	for peer in _peer_pos.keys():
		var pos: Vector3 = _peer_pos[peer]

		if Vector2(pos.x - at.x, pos.z - at.z).length() > TRAPPED_NEAR_M or absf(pos.y - at.y) > TRAPPED_HIGH_M or not structure_blocks(pos.x, pos.z, 0.0):
			continue   # far off, or a floor above or a cellar below it: not inside

		var out: Vector3 = _safe_resume(int(peer), pos)

		if out.distance_to(pos) > 0.01 and out.distance_to(pos) <= RESUME_SEARCH_M + 0.5:   # nothing clear near: no long jump to a bed or the spawn
			_peer_pos[peer] = out

			if send_step_to.is_valid():
				send_step_to.call(int(peer), out - Vector3(0.0, 1.0, 0.0), atan2(-(at.x - out.x), -(at.z - out.z)))   # the client lifts a step 1 m (_on_step_to); facing the piece


# Another player stands within `radius` (on the ground plane) of a point.
func _player_within(point: Vector3, radius: float, but: int) -> bool:
	for other in _peer_pos:
		if int(other) != but and Vector2(_peer_pos[other].x - point.x, _peer_pos[other].z - point.z).length() <= radius:
			return true

	return false


# Is a lit fire (any tier) within r metres of a point?
# A seat piece (comfort class seat) within 1.2 m horizontally and 1 m vertically.
func _seat_near(pos: Vector3) -> bool:
	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and Vector2(it["pos"].x - pos.x, it["pos"].z - pos.z).length() <= 1.2 and absf(it["pos"].y - pos.y) <= 1.0:
			var skind: String = str(it["struct"].get("kind", ""))

			if str(_comfort_kind(str(_structures.get(skind, {}).get("comfort", skind))).get("class", "")) == "seat":
				return true

	return false


func _lit_structure_within(pos: Vector3, kind: String, r: float) -> bool:
	for id in _items:
		var other: Dictionary = _items[id]

		if other.has("struct") and str(other["struct"]["kind"]) == kind and bool(other["struct"].get("lit", false)) and pos.distance_to(other["pos"]) <= r:
			return true

	return false


func _lit_fire_within(pos: Vector3, r: float) -> bool:
	for row in _lit_rows():
		if (row[0] as Vector3).distance_to(pos) <= r:
			return true

	return false


# What level this placed structure gives for a station (0 = none): its own station at station_level plus one per add-on kind
# beside it, or an "also" station it carries whole (the large and epic stations are a forge and a bench in one; Dave 2026-10-21).
func station_level_of(it: Dictionary, def: Dictionary, station: String) -> int:
	if str(def.get("station", "")) == station:
		return int(def.get("station_level", 1)) + _addon_kinds(it, def, station)

	return int(def.get("also", {}).get(station, 0))


# A cold fire (laid, coals gone cold, ash) is what keeps this station from serving: a campfire within reach that is out, or for the pot a pot within
# reach whose fire under it is out. A dish waiting on it says to light it, not to "go back" to what the player stands at.
func _unlit_fire_near(peer: int, station: String) -> bool:
	if not _peer_pos.has(peer):
		return false

	var reach: float = FIRE_USE_M + 1.0
	var spots: Array = [_peer_pos[peer]]

	if station == "campfire_pot":
		spots = []

		for id in _items:
			var pot: Dictionary = _items[id]

			if pot.has("struct") and str(pot["struct"]["kind"]) == "campfire_pot" and _peer_pos[peer].distance_to(pot["pos"]) <= reach:
				spots.append(pot["pos"])

		reach = POT_ON_FIRE_M

	for at in spots:
		for id in _items:
			var it: Dictionary = _items[id]

			if it.has("fire") and not it["fire"].has("camp") and not fire_is_lit(int(it["fire"]["state"])) and (at as Vector3).distance_to(it["pos"]) <= reach:
				return true

	return false


# A smithy that would serve this station stands within its reach with no fuel in its fuel slot.
func _unfuelled_smithy_near(peer: int, station: String) -> bool:
	if not _peer_pos.has(peer):
		return false

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and not it["struct"].has("site"):
			var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

			if _fuel_slot_kind(def) and not _smithy_fuelled(it, def) and station_level_of(it, def, station) > 0 and _peer_pos[peer].distance_to(it["pos"]) <= float(def.get("reach_m", 3.0)) + 1.0:
				return true

	return false


# A worn-out smithy (server_smithy.gd broken) that would serve this station stands within its reach: the craft says "Needs repair".
func _broken_station_near(peer: int, station: String, level: int = 1) -> bool:
	if not _peer_pos.has(peer):
		return false

	for id in _items:
		var it: Dictionary = _items[id]

		if _smithies.broken(int(id)):
			var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

			if station_level_of(it, def, station) >= level and _peer_pos[peer].distance_to(it["pos"]) <= maxf(float(def.get("reach_m", 3.0)) + 1.0, CraftStock.CRAFT_REACH_M):   # as far as a craft would step to it
				return true

	return false


# --- The smithies' fuel slot (Dave 21 Nov 2026: "smithys should just take coal in a fuel slot. same for all smithys. dont need to be lit. they
# should have red coals when idle and flare really bright while making stuff") ---
# A structures.json row with "fuel_slot" (an item or ingredient group: "fuel", Coal or Charcoal) keeps that fuel in the first slot of its one
# store, which holds nothing else. It burns only while a craft is being worked there: fuel_craft_s seconds of making a unit (PROVISIONAL SF-2),
# the next unit taken from the slot when the last is spent (struct fuel_left). The world row says "coals" while it has fuel (red coals) and
# "busy" while a craft is worked (the flare, _busy_ms).
# fuel_left (under one unit's making time) is saved in smithies.json "fuel" (server_smithy.gd fuel_rows), so a restart keeps the part-burnt unit.

const FUEL_SLOT := 0          # the store slot that is the fuel slot
const BUSY_HOLD_MS := 1500    # a smithy stays "busy" this long after the last craft tick worked there


func _fuel_slot_kind(def: Dictionary) -> bool:
	return str(def.get("fuel_slot", "")) != ""


# Whether `number` is the fuel this smithy burns (the item, or a member of the group, never an instance).
func _is_smithy_fuel(def: Dictionary, number: int) -> bool:
	var fuel_n: int = table.number_of(str(def.get("fuel_slot", "")))
	return number != 0 and fuel_n > 0 and (number == fuel_n or table.group_members(fuel_n).has(number))


func _smithy_box(it: Dictionary):
	return _chests.get(int(it["struct"].get("uid", 0)))


func _smithy_fuelled(it: Dictionary, def: Dictionary) -> bool:
	if float(it["struct"].get("fuel_left", 0.0)) > 0.0:
		return true

	var box = _smithy_box(it)
	return box != null and box.slot_count > FUEL_SLOT and _is_smithy_fuel(def, box.numbers[FUEL_SLOT]) and box.counts[FUEL_SLOT] > 0 and box.inst[FUEL_SLOT].is_empty()


# Puts `amount` of `number` into a smithy's store: its fuel into the fuel slot first (one stack) and the rest after it, anything else never
# into the fuel slot. Returns what did not fit (the caller readied box.usable).
func _smithy_add(def: Dictionary, box, number: int, amount: int, item_wear: int = 0, item_inst: Dictionary = {}) -> int:
	if item_inst.is_empty() and _is_smithy_fuel(def, number) and box.slot_count > FUEL_SLOT:
		var stack: int = table.stack_of(number)

		if box.numbers[FUEL_SLOT] == 0:
			var first: int = mini(amount, stack)
			box.numbers[FUEL_SLOT] = number
			box.counts[FUEL_SLOT] = first
			box.wear[FUEL_SLOT] = item_wear
			box.fav[FUEL_SLOT] = 0
			box.inst[FUEL_SLOT] = {}
			amount -= first
		elif box.numbers[FUEL_SLOT] == number and box.inst[FUEL_SLOT].is_empty() and box._mergeable(number, box.wear[FUEL_SLOT], item_wear):
			var more: int = mini(amount, maxi(stack - box.counts[FUEL_SLOT], 0))
			box.wear[FUEL_SLOT] = box._joined_age(number, box.wear[FUEL_SLOT], box.counts[FUEL_SLOT], item_wear, more)
			box.counts[FUEL_SLOT] += more
			amount -= more

	return box.add(number, amount, item_wear, item_inst, FUEL_SLOT + 1) if amount > 0 else 0


# The reason a put onto the fuel slot is refused ("" when it is not).
func _smithy_slot_refusal(def: Dictionary, number: int, target: int) -> String:
	if target == FUEL_SLOT and not _is_smithy_fuel(def, number):
		return "Its first slot is its fuel slot: Coal or Charcoal only."

	return ""


# A craft tick worked at smithy `id` for `spent` seconds: it burns its fuel, taking the next unit from the fuel slot when the last is spent, and
# shows busy (the flare). False when it has no fuel left for the tick (the caller checked it had some).
func _smithy_burn(id: int, spent: float) -> bool:
	var it: Dictionary = _items.get(id, {})
	var def: Dictionary = _structures.get(str(it.get("struct", {}).get("kind", "")), {})

	if not _fuel_slot_kind(def):
		return true

	var left: float = float(it["struct"].get("fuel_left", 0.0)) - spent

	while left <= 0.0:
		var box = _smithy_box(it)

		if box == null or not _is_smithy_fuel(def, box.numbers[FUEL_SLOT]) or box.counts[FUEL_SLOT] <= 0:
			it["struct"].erase("fuel_left")
			_smithies.burning.erase(id)

			if _busy_ms.erase(id):
				_dirty = true   # back to cold: its row goes out again

			return false

		box.take_from_slot(FUEL_SLOT, 1)
		_push_box(id, box)
		left += float(def.get("fuel_craft_s", 1800.0))

	it["struct"]["fuel_left"] = left
	_smithies.burning[id] = true

	if not _busy_ms.has(id):
		_dirty = true   # the flare: its row goes out again

	_busy_ms[id] = Time.get_ticks_msec()
	return true


var _busy_ms: Dictionary = {}   # smithy world id -> ticks msec of the last craft tick worked there (its flare; never saved)


# The smithies no craft worked for BUSY_HOLD_MS go back to their idle coals.
func _settle_busy() -> void:
	var now: int = Time.get_ticks_msec()

	for id in _busy_ms.keys():
		if not _items.has(id) or now - int(_busy_ms[id]) > BUSY_HOLD_MS:
			_busy_ms.erase(id)
			_dirty = true   # back to its idle coals: its row goes out again


# --- Fuel sources (GOALS-REPAIR R6; A-28, A-30, A-31; master s2.5) ---
# Stores a station may draw Coal and Charcoal from by itself, within FUEL_SOURCE_M: a resource bin that holds Coal or Charcoal, a Kiln's
# output rack (its finished charcoal, even while it burns: A-31) and the store of a fire that is not burning (A-30). No owner or lock
# check (lead ruling): like the Kiln and the Smelters, it is the station's own working. Used by the Smelters' hopper pull
# (server_smelter.pull_fuel, every 300 s).

const FUEL_SOURCE_M := 30.0   # PROVISIONAL (GOALS-REPAIR A-28): how far a station reaches for fuel


# [[world id, store, first slot, end slot, distance], ...] of the fuel sources within `radius` of `at`, nearest first (ties by id), never `skip`.
func fuel_sources(at: Vector3, radius: float = FUEL_SOURCE_M, skip: int = -1) -> Array:
	var out: Array = []

	for id in _items:
		var it: Dictionary = _items[id]
		var d: float = at.distance_to(it["pos"])

		if int(id) == skip or d > radius:
			continue

		if it.has("fire"):
			var fire: Dictionary = it["fire"]

			if not fire_is_lit(int(fire["state"])) and bool(fire.get("synced", false)) and _chests.has(int(fire.get("uid", 0))):   # never a burning fire's wood (A-30)
				var fbox = _chests[int(fire["uid"])]
				out.append([int(id), fbox, 0, clampi(int(_cooking.get("fire_slots", 4)), 1, fbox.slot_count), d])

			continue

		if not it.has("struct") or it["struct"].has("site") or not _chests.has(int(it["struct"].get("uid", -1))):
			continue

		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
		var box = _chests[int(it["struct"]["uid"])]

		if BinRules.is_bin(def):
			var held: int = BinRules.assigned(box)

			if held > 0 and _smelters.is_fuel(held):
				out.append([int(id), box, 0, box.slot_count, d])
		elif int(def.get("batch_logs", 0)) > 0 and _out_slots(str(it["struct"]["kind"])) > 0:   # a Kiln: its output rack only, never its logs
			var first: int = int(def.get("slots", 0))
			out.append([int(id), box, first, mini(first + _out_slots(str(it["struct"]["kind"])), box.slot_count), d])

	out.sort_custom(func(a, b): return a[4] < b[4] or (a[4] == b[4] and a[0] < b[0]))
	return out


# A fuel source lost some of its store: a fire's burn follows its store, and whoever has it open sees it. PROVISIONAL (GOALS-REPAIR A-34):
# a draw never shortens or removes anyone's fire: a laid fire it empties stays a laid fire (state 8, empty) with the time it had left,
# not the FIRE_OUT_S of a burnt-out one.
func fuel_taken(id: int, box) -> void:
	if _items.get(id, {}).has("fire"):
		var left_was: float = float(_items[id].get("left", FIRE_LAID_S))
		_sync_fire_from_box(0, id)   # peer 0: no notice

		if not fire_is_lit(int(_items[id]["fire"]["state"])):
			_items[id]["left"] = maxf(float(_items[id].get("left", 0.0)), left_was)

	_push_box(id, box)
	_dirty = true


# How many different add-on kinds (structures.json addon_of) stand within addon_reach_m of a station: each raises its level by one,
# except an add-on marked "adds_level": false (the Smithy's Bellows and Quenching trough, which change how it works, not what it can make).
func _addon_kinds(station_row: Dictionary, def: Dictionary, station: String) -> int:
	var kinds: Dictionary = {}
	var reach: float = float(def.get("addon_reach_m", 5.0))

	for id in _items:
		var other: Dictionary = _items[id]

		if not other.has("struct") or other["struct"].has("site"):
			continue

		var kind: String = str(other["struct"]["kind"])

		if str(_structures.get(kind, {}).get("addon_of", "")) == station and bool(_structures.get(kind, {}).get("adds_level", true)) and station_row["pos"].distance_to(other["pos"]) <= reach:
			kinds[kind] = true

	return kinds.size()


# --- Fishing (data/items/fishing.json, Tyler's model: no fish entities, a roll per cast) ---

func _fishing_data() -> Dictionary:
	if _fishing_cfg.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/fishing.json"))
		_fishing_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {"none": true}

	return _fishing_cfg


func _fish_cell(pos: Vector3) -> Vector2i:
	var size: float = float(_fishing_data().get("cell_m", 128.0))
	return Vector2i(int(floor(pos.x / size)), int(floor(pos.z / size)))


func _cell_hash(cell: Vector2i) -> int:
	return absi((cell.x * 73856093) ^ (cell.y * 19349663))


# Fish left in a cell of water: the hidden stock, which comes back one fish per regrow_s up to the cell's own best.
func fish_stock(cell: Vector2i) -> int:
	var cfg: Dictionary = _fishing_data()
	var best: int = mini(int(cfg.get("stock_base", 4)) + _cell_hash(cell) % maxi(int(cfg.get("stock_extra", 8)), 1), int(cfg.get("stock_max", 12)))
	var key: String = "%d,%d" % [cell.x, cell.y]
	var row: Array = _fish_stock.get(key, [best, _unix()])
	var regrow_s: float = float(cfg.get("regrow_s", 3600.0))

	if water_kind_at.is_valid() and cfg.has("regrow_s_sea"):
		var size: float = float(cfg.get("cell_m", 128.0))

		if str(water_kind_at.call((float(cell.x) + 0.5) * size, (float(cell.y) + 0.5) * size).get("kind", "")).begins_with("sea"):
			regrow_s = float(cfg["regrow_s_sea"])   # sea water refills faster (balance plan 5b)

	var back: int = int(floor((_unix() - float(row[1])) / maxf(regrow_s, 1.0)))
	var now_n: int = mini(int(row[0]) + back, best)
	_fish_stock[key] = [now_n, _unix() if back > 0 else float(row[1])]
	return now_n


var _schools = null     # server_fish.gd, made when the first cast needs it and the water kind hook is set


func _fish_schools():
	if _schools == null:
		var has_item: Callable = func(species: String) -> bool: return table.number_of(species) != 0
		_schools = FishSchoolsScript.new(water_kind_at, has_item, {}, float(_fishing_data().get("cell_m", 128.0)))

	return _schools


# The water kind at the first of the point and eight directions at half and full reach that is water ("" when none is).
func _water_kind_near(pos: Vector3, reach: float) -> String:
	for k in 17:
		var at: Vector3 = pos

		if k > 0:
			if reach <= 0.0:
				break

			var a: float = float((k - 1) % 8) * TAU / 8.0
			at = pos + Vector3(cos(a), 0.0, sin(a)) * (reach if k > 8 else reach * 0.5)

		var kind: String = str((water_kind_at.call(at.x, at.z) as Dictionary).get("kind", ""))

		if kind != "":
			return kind

	return ""


# The best school factor for a line or net thrown from `pos` with `reach` m of reach: the stand point and eight directions at half and full reach
# (the water is somewhere out there, the shore is under the feet). {"factor", "species", "active"}; factor 1.0 and not active when plan C has nothing to say.
func school_hit(pos: Vector3, reach: float) -> Dictionary:
	var none: Dictionary = {"factor": 1.0, "species": "", "active": false}

	if not water_kind_at.is_valid():
		return none

	_fish_schools()
	var day: int = int(floor(_now_game_s() / 86400.0))
	var season: String = _season_of(pos) if season_now.is_valid() or season_at.is_valid() else "summer"   # the water's own season
	var stock: Callable = func(cell: Vector2i) -> int: return fish_stock(cell)
	var best: Dictionary = none
	var memo: Dictionary = {}

	for k in 17:
		var at: Vector3 = pos

		if k > 0:
			var a: float = float((k - 1) % 8) * TAU / 8.0
			at = pos + Vector3(cos(a), 0.0, sin(a)) * (reach if k > 8 else reach * 0.5)

		var got: Dictionary = _schools.factor_at(at.x, at.z, day, season, _now_game_s(), stock, memo)

		if bool(got["active"]) and (not bool(best["active"]) or float(got["factor"]) > float(best["factor"])):
			best = got

	return best


func _fish_chance(peer: int, _cell: Vector2i, bait: bool, hit: Dictionary = {}) -> float:
	var cfg: Dictionary = _fishing_data()
	var chance: float = float(cfg.get("base_chance", 0.55)) * skill_factor(peer, "fish")
	var hour: float = fposmod(float(game_seconds.call()), 86400.0) / 3600.0 if game_seconds.is_valid() else 12.0
	var tod: float = float(cfg.get("night_mult", 0.9)) if (hour < 5.0 or hour >= 21.0) else 1.0

	for band in cfg.get("hour_mult", []):
		if hour >= float(band[0]) and hour < float(band[1]):
			tod = float(band[2])

	chance *= tod
	var weather: Dictionary = _weather_here(_peer_pos.get(peer, Vector3.ZERO))   # the fisher's own sky (a mountain lake in snow is not the coast's rain)

	if float(weather.get("storm", 0.0)) > 0.3:
		chance *= float(cfg.get("storm_mult", 0.4))
	elif float(weather.get("rain", 0.0)) > 0.0:
		chance *= float(cfg.get("rain_mult", 1.2))

	if float(weather.get("cloud", 0.0)) > 0.6:
		chance *= float(cfg.get("cloud_mult", 1.1))

	if float(weather.get("temp_c", 15.0)) < float(cfg.get("cold_c", 5.0)):
		chance *= float(cfg.get("cold_mult", 0.6))

	if bait:
		chance *= float(cfg.get("bait_mult", 1.5))

	chance *= float(hit.get("factor", 1.0))   # plan C: inside a school 1.0, near it 0.5, away from every school 0.15
	return clampf(chance, float(cfg.get("min_chance", 0.02)), float(cfg.get("max_chance", 0.93)))


# The species a catch is. A school the line or net is in or near gives its own; otherwise, when the water kind hook is set, a species that lives in
# the water at `near` (the first water among the point and eight directions at half and full `reach`, as school_hit looks): fishing outside
# every school in the sea, a river or a brook gave pond and lake fish (23 Nov 2026, the hunting and fishing loop test). With no hook or no
# water found, the old stream/pond/lake roll by the cell's position.
func _fish_species(cell: Vector2i, hit: Dictionary = {}, near: Vector3 = Vector3.INF, reach: float = 0.0) -> String:
	var cfg: Dictionary = _fishing_data()

	if str(hit.get("species", "")) != "":
		return str(hit["species"])   # the school the line or net is in or near

	if near.is_finite() and water_kind_at.is_valid():
		var kind: String = _water_kind_near(near, reach)

		if kind != "" and _fish_schools().has_method("species_for"):   # a test's stand-in school module may not have it
			var by_water: String = _fish_schools().species_for(kind, _season_of(near) if season_now.is_valid() or season_at.is_valid() else "summer", _fate_rng.randf())   # luck-exempt: the fate stream picks the fish species by the water (luck applies to the catch roll)

			if by_water != "":
				return by_water

	var types: Array = cfg.get("types", ["pond"])
	@warning_ignore("integer_division")
	var water: String = str(types[(_cell_hash(cell) / 7) % types.size()])
	var roll: float = _fate_rng.randf()   # luck-exempt: the fate stream picks the fish species (luck applies to the catch roll)
	var table_rows: Array = cfg.get("species", {}).get(water, [])
	var acc: float = 0.0

	for row in table_rows:
		acc += float(row[1])

		if roll <= acc:
			return str(row[0])

	return str(table_rows[table_rows.size() - 1][0]) if not table_rows.is_empty() else "perch"


func _fish(peer: int, inv, slot: int, at: Vector3 = Vector3.ZERO) -> void:
	var cfg: Dictionary = _fishing_data()

	if cfg.has("none") or slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer) or _is_broken(inv, slot):
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))

	if str(entry.get("weapon_class", "")) in ["spear", "fish_spear"]:
		_spear_fish(peer, inv, slot, at, cfg, str(entry["weapon_class"]) == "fish_spear")
		return

	if str(entry.get("tool_class", "")) != "rod":
		return

	var now: int = Time.get_ticks_msec()
	var state: Dictionary = _fishing.get(peer, {})

	if not state.is_empty():
		if str(state["phase"]) == "bite" and now <= int(state["at"]):
			_fish_land(peer, inv, slot, state)
		else:
			_fishing.erase(peer)
			_say(peer, str(cfg.get("say_early", "")) if str(state["phase"]) == "wait" else str(cfg.get("say_away", "")))

		return

	if now - int(_last_fish.get(peer, -100000)) < int(float(cfg.get("cooldown_s", 2.0)) * 1000.0):
		return

	_last_fish[peer] = now

	if not water_near.is_valid() or not bool(water_near.call(_peer_pos[peer], float(cfg.get("reach_m", 8.0)))):
		_say(peer, str(cfg.get("say_no_water", "")))
		return

	var icy: bool = _on_ice(_peer_pos[peer])

	if icy and not _hole_near(_peer_pos[peer]):
		_say(peer, str(cfg.get("ice", {}).get("say_need_hole", "")))
		return

	var cell: Vector2i = _fish_cell(_peer_pos[peer])
	var bait_slot: int = _fish_bait_slot(inv, cfg)
	var hit: Dictionary = school_hit(_peer_pos[peer], float(cfg.get("reach_m", 8.0)))
	var chance: float = _fish_chance(peer, cell, bait_slot >= 0, hit) * (float(cfg.get("ice", {}).get("ice_mult", 0.8)) if icy else 1.0)

	if bait_slot >= 0:
		inv.take_from_slot(bait_slot, 1)

	_wear_slot(peer, inv, slot, "fish")
	var bites: bool = fish_stock(cell) > 0 and fate(peer, "fish", chance)
	var wait_s: Array = cfg.get("wait_s", [6.0, 22.0])
	var wait_ms: int = int(lerpf(float(wait_s[0]), float(wait_s[1]), _fate_rng.randf()) * 1000.0)   # luck-exempt: the length of a wait
	_fishing[peer] = {"phase": "wait", "at": now + wait_ms, "spot": _peer_pos[peer], "cell": cell, "bites": bites, "species": str(hit.get("species", "")), "float": _float_spot(_peer_pos[peer], at, float(cfg.get("reach_m", 8.0)))}
	_say(peer, str(cfg.get("say_cast", "")))


# The shore net (ACT_NET, fishing.json "net"; Dave 2 Nov 2026): the player throws it onto the water (up to reach_m away), it sinks for hold_s,
# then is pulled back in by its twine and the server rolls the haul from the school it landed on.
func _net_cast(peer: int, inv, slot: int, cancel: bool, at: Vector3) -> void:
	var cfg: Dictionary = _fishing_data().get("net", {})
	var state: Dictionary = _fishing.get(peer, {})

	if cancel:
		if str(state.get("phase", "")) == "net":
			_fishing.erase(peer)
			_say(peer, str(cfg.get("say_cancel", "")))

		return

	if cfg.is_empty() or slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer) or _is_broken(inv, slot):
		return

	if str(table.entry(table.id_of(inv.numbers[slot])).get("tool_class", "")) != "net" or not state.is_empty():
		return

	var pos: Vector3 = _peer_pos[peer]
	var now: int = Time.get_ticks_msec()

	if now - int(_last_fish.get(peer, -100000)) < int(float(_fishing_data().get("cooldown_s", 2.0)) * 1000.0):
		return

	_last_fish[peer] = now

	if not water_near.is_valid() or not bool(water_near.call(at, 1.0)) or Vector2(at.x - pos.x, at.z - pos.z).length() > float(cfg.get("reach_m", 5.0)):
		_say(peer, str(cfg.get("say_no_water", "")))
		return

	if _on_ice(pos):
		_say(peer, str(cfg.get("say_frozen", "")))
		return

	if water_depth_at.is_valid():
		var depth: float = float(water_depth_at.call(at))
		var band: Array = cfg.get("depth_m", [0.3, 1.2])

		if depth < float(band[0]):
			_say(peer, str(cfg.get("say_shallow", "")))
			return

		if depth > float(band[1]):
			_say(peer, str(cfg.get("say_deep", "")))
			return

	_fishing[peer] = {"phase": "net", "at": now + int(float(cfg.get("hold_s", 6.0)) * 1000.0), "spot": pos, "landed": at, "cell": _fish_cell(at), "slot": slot}
	_say(peer, str(cfg.get("say_start", "")))


# The haul: a random number of fish wanted, set by the school the net landed on (catch_by_school: a bigger school, more fish; none: 0 or 1),
# each limited by the cell's stock and the fishing chance (dawn and dusk best).
func _net_haul(peer: int, state: Dictionary) -> void:
	var cfg: Dictionary = _fishing_data().get("net", {})
	_fishing.erase(peer)
	var key: String = _peer_key.get(peer, "")
	var inv = _inventories.get(key)
	var slot: int = int(state.get("slot", -1))

	if inv == null or slot < 0 or inv.numbers[slot] == 0 or str(table.entry(table.id_of(inv.numbers[slot])).get("tool_class", "")) != "net":
		return

	var cell: Vector2i = state["cell"]
	var cell_key: String = "%d,%d" % [cell.x, cell.y]
	var hit: Dictionary = school_hit(state.get("landed", state["spot"]), float(cfg.get("net_radius_m", 1.5)))
	var want: int = _fate_rng.randi_range(0, 1)   # luck-exempt: how many the net holds (no school under it: one stray fish at most)
	var by: Dictionary = cfg.get("catch_by_school", {})

	if float(hit.get("factor", 0.0)) >= float(by.get("school_factor_min", 0.5)):   # in a school (factor 1) or near one (0.5, fish_schools.json factor)
		var most: float = float(hit.get("radius", by.get("default_radius_m", 5.0))) * float(by.get("fish_per_radius_m", 0.75))

		if float(hit.get("factor", 1.0)) < 1.0:   # the net landed near the school, not in it
			most *= float(by.get("near_mult", 0.5))

		want = _fate_rng.randi_range(1, maxi(1, int(round(most))))   # luck-exempt: how many the net holds

	var chance: float = clampf(_fish_chance(peer, cell, false, hit) * float(cfg.get("chance_mult", 1.0)), float(_fishing_data().get("min_chance", 0.02)), float(cfg.get("max_chance", 0.95)))
	var caught: Array = []
	var before: Array = _snapshot(inv)   # a timed haul, outside any action: it sends its own changes (a catch can grow the pack, protocol 116)

	for n in want:
		if fish_stock(cell) <= 0:
			break

		if fate(peer, "fish", chance):
			_fish_stock[cell_key][0] = int(_fish_stock[cell_key][0]) - 1
			var species: String = _fish_species(cell, hit, state.get("landed", state.get("spot", Vector3.INF)))
			_take_in(peer, inv, table.number_of(species), 1)
			caught.append(table.sentence_name(table.number_of(species)))
			_goal_event(peer, "fish_kind_caught", species, true)   # ADD-25: first catch of this kind

	var was_quiet: bool = _gain_quiet
	_gain_quiet = true   # the haul line below names the catch
	_send_changes(peer, inv, before)
	_gain_quiet = was_quiet
	_wear_slot(peer, inv, slot, "net")
	_dirty = true

	if caught.is_empty():
		_say(peer, str(cfg.get("say_nothing", "")))
		return

	practice(peer, "fish")
	_goal_event(peer, "fish_caught")
	_map_catch(peer, state.get("spot", null))
	var line: String = "You haul in %s." % ", ".join(caught)

	if fish_stock(cell) < int(_fishing_data().get("hint_below", 3)):
		line += " " + str(_fishing_data().get("say_still", "The water is still."))

	_say(peer, line)


# A spear jab at water (the client sends ACT_FISH with the spear in hand and the point it stabs at): see fishing.json "spear". The Fishing
# spear (weapon_class "fish_spear", Part C) jabs the same way with fishing.json "fish_spear" laid over those numbers.
func _spear_fish(peer: int, inv, slot: int, at: Vector3, fishing: Dictionary, fish_spear: bool = false) -> void:
	var cfg: Dictionary = (fishing.get("spear", {}) as Dictionary).duplicate()

	if fish_spear:
		cfg.merge(fishing.get("fish_spear", {}), true)

	var pos: Vector3 = _peer_pos[peer]

	if cfg.is_empty() or not water_near.is_valid() or Vector2(at.x - pos.x, at.z - pos.z).length() > float(cfg.get("reach_m", 3.0)) or not bool(water_near.call(at, 0.0)) or bool(_swimming.get(peer, false)):
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_fish.get(peer, -100000)) < int(float(cfg.get("cooldown_s", 1.2)) * 1000.0):
		return

	_last_fish[peer] = now

	if _on_ice(at):
		_say(peer, str(cfg.get("say_ice", "")))
		return

	if water_depth_at.is_valid():
		var depth: float = float(water_depth_at.call(at))

		if depth < float(cfg.get("min_depth_m", 0.05)) or depth > float(cfg.get("max_depth_m", 1.5)):
			if cfg.has("say_depth"):
				_say(peer, str(cfg["say_depth"]))

			return

	# The school under the jab (24 Nov 2026, Dave: "I dont actually see any fish or signs of fish"): with none near, the miss says so plainly and
	# points at the signs (fish_signs: jumps, ripples, dark fish) instead of "stand still" or "you miss". The odds are not changed.
	var hit: Dictionary = school_hit(at, float(cfg.get("school_reach_m", 1.0)))
	var no_school: bool = bool(hit.get("active", false)) and float(hit.get("factor", 1.0)) < float(cfg.get("school_factor_min", 0.5))
	if float(_moving.get(peer, 0.0)) > float(cfg.get("still_below", 0.25)):
		_say(peer, str(cfg.get("say_no_fish", "")) if no_school and cfg.has("say_no_fish") else str(cfg.get("say_move", "")))
		return

	_wear_slot(peer, inv, slot, "fish")
	var cell: Vector2i = _fish_cell(pos)
	var chance: float = float(cfg.get("base_chance", 0.2)) * skill_factor(peer, "fish")
	var weather: Dictionary = _weather_here(pos)

	if float(weather.get("storm", 0.0)) > 0.3 or float(weather.get("rain", 0.0)) > float(cfg.get("rain_over", 0.4)):
		chance *= float(cfg.get("murky_mult", 0.5))

	var hour: float = fposmod(_now_game_s(), 86400.0) / 3600.0
	var glare: Array = cfg.get("glare_hours", [11.0, 14.0])

	if hour >= float(glare[0]) and hour < float(glare[1]):
		chance *= float(cfg.get("glare_mult", 0.85))

	chance = clampf(chance, 0.02, float(cfg.get("max_chance", 0.6)))

	if fish_stock(cell) > 0 and fate(peer, "fish", chance):
		var key: String = "%d,%d" % [cell.x, cell.y]
		_fish_stock[key][0] = int(_fish_stock[key][0]) - 1
		var species: String = _fish_species(cell, hit, at)   # a jab into a school takes that school's fish
		_take_in(peer, inv, table.number_of(species), 1, 0, pos)

		practice(peer, "fish")
		_goal_event(peer, "fish_caught")
		_goal_event(peer, "fish_kind_caught", species, true)   # ADD-25
		_map_catch(peer, _peer_pos.get(peer, null))
		_say(peer, str(cfg.get("say_hit", "")) % table.sentence_name(table.number_of(species)))
		_dirty = true
	else:
		_say(peer, str(cfg.get("say_no_fish", "")) if no_school and cfg.has("say_no_fish") else str(cfg.get("say_miss", "")))


func _on_ice(pos: Vector3) -> bool:
	if ice_moat_at.is_valid() and bool(ice_moat_at.call(pos)):
		return false   # the thaw's shore moat is open water: no ice to stand on, a drink without a hole (#729 decision, 8 Nov 2026)

	var by_spring: float = clampf(float(spring_ice_x.call(pos)), 0.0, 1.0) if spring_ice_x.is_valid() else 1.0   # half ice near a spring (#739)
	return ice_cover_at.is_valid() and float(ice_cover_at.call(pos)) * by_spring >= 0.5 and water_near.is_valid() and bool(water_near.call(pos, 0.0))


# The live ice holes within reach of a point, nearest first, at most `count` (protocol 97, Kathleen's frozen_water_look.md 5): [positions,
# game seconds each stays open until]. The client turns `until` into an age with fishing.json ice.hole_game_h.
func ice_holes_near(at: Vector3, reach: float = 120.0, count: int = 8) -> Array:
	var now: float = _now_game_s()
	var live: Array = _holes.filter(func(h): return float(h["until"]) > now and Vector2(h["pos"].x - at.x, h["pos"].z - at.z).length() <= reach)
	live.sort_custom(func(p, q): return at.distance_squared_to(p["pos"]) < at.distance_squared_to(q["pos"]))
	var points: PackedVector3Array = PackedVector3Array()
	var untils: PackedFloat32Array = PackedFloat32Array()

	for h in live.slice(0, count):
		points.append(h["pos"])
		untils.append(float(h["until"]))

	return [points, untils]


func _now_game_s() -> float:
	return float(game_seconds.call()) if game_seconds.is_valid() else 0.0


func _hole_near(pos: Vector3) -> bool:
	_holes = _holes.filter(func(h): return float(h["until"]) > _now_game_s())

	for hole in _holes:
		if pos.distance_to(hole["pos"]) <= float(_fishing_data().get("ice", {}).get("hole_reach_m", 2.0)):
			return true

	return false


# Right click with an axe or pick on a bearing sheet: blows_needed blows (blow_gap_s apart) open a hole that stays open hole_game_h
# game hours. The oldest of a player's holes closes when they cut a new one over their limit.
func _cut_hole(peer: int, inv, slot: int) -> void:
	var cfg: Dictionary = _fishing_data().get("ice", {})

	if cfg.is_empty() or slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer) or not _peer_key.has(peer):
		return

	if not str(table.entry(table.id_of(inv.numbers[slot])).get("tool_class", "")) in ["axe", "pick"] or _is_broken(inv, slot):
		_reject_tool(peer, "an axe or a pick that is not broken")
		return

	if not _on_ice(_peer_pos[peer]):
		# Only by the water: an axe right-clicked anywhere else (a swing at the air, in a wood) is not asking for a hole (BUG-003).
		if water_near.is_valid() and bool(water_near.call(_peer_pos[peer], float(cfg.get("no_ice_water_m", 6.0)))):
			_say(peer, str(cfg.get("say_no_ice", "")))

		return

	var now: int = Time.get_ticks_msec()
	var row: Array = _hole_blows.get(peer, [0, -100000])

	if now - int(row[1]) < int(float(cfg.get("blow_gap_s", 0.8)) * 1000.0):
		return

	_wear_slot(peer, inv, slot, "ice")
	var blows: int = int(row[0]) + 1

	if blows < int(cfg.get("blows_needed", 6)):
		_hole_blows[peer] = [blows, now]
		return

	_hole_blows.erase(peer)
	var key: String = str(_peer_key[peer])
	var mine: Array = _holes.filter(func(h): return str(h["owner"]) == key)

	while mine.size() >= int(cfg.get("holes_per_player", 2)):
		_holes.erase(mine[0])
		mine.remove_at(0)

	_holes.append({"pos": _peer_pos[peer], "owner": key, "until": _now_game_s() + float(cfg.get("hole_game_h", 12.0)) * 3600.0})
	_say(peer, str(cfg.get("say_hole", "")))


func _fish_bait_slot(inv, cfg: Dictionary) -> int:
	for slot in range(inv.slot_count):
		if inv.numbers[slot] == 0:
			continue

		var id: String = table.id_of(inv.numbers[slot])

		for word in cfg.get("bait", []):
			if id == str(word) or (id.ends_with(str(word)) and not _cooking.get("warms", {}).has(id)):   # raw "blueberries", never the cooked "stewed_berries" a player made to eat
				return slot

	return -1


# Fish traps (structures.json "fish_trap": true, fishing.json "trap"; Part C plan 2): each game hour a trap rolls the fishing cell's stock at
# hour_chance, or bait_chance with a bait from trap.bait in its slots, which a catch uses up. The fish goes into its slots, so E takes it out
# like a chest; a full trap or a frozen one catches nothing. Every fish counts against the cell's stock, so traps cannot empty a pond faster
# than it refills. No regular server work (the coordinator, 23 Nov 2026: traps follow the snare ruling, no limit per chunk and no cost while
# nobody is there): the hours a trap has stood since struct.rolled_s (game seconds, set when it is placed, saved in row 24) are rolled when
# someone opens it, at most catch_up_h of them, ice as it is at that moment.
func _fish_trap_catch_up(id: int, it: Dictionary, box) -> void:
	var cfg: Dictionary = _fishing_data().get("trap", {})

	if cfg.is_empty():
		return

	var st: Dictionary = it["struct"]
	var now_s: float = _now_game_s()

	if not st.has("rolled_s"):
		st["rolled_s"] = now_s   # a trap saved before its hours were kept: they start now
		_dirty = true
		return

	var whole_h: int = floori((now_s - float(st["rolled_s"])) / 3600.0)

	if whole_h <= 0:
		return

	st["rolled_s"] = float(st["rolled_s"]) + float(whole_h) * 3600.0
	_dirty = true

	if _on_ice(it["pos"]):
		return

	var caught: int = 0

	for h in mini(whole_h, int(cfg.get("catch_up_h", 24))):
		if _fish_trap_roll(it["pos"], box, cfg):
			caught += 1

	if caught > 0:
		_push_box(id, box)


# One game hour of one trap: true when a fish went into it.
func _fish_trap_roll(pos: Vector3, box, cfg: Dictionary) -> bool:
	var cell: Vector2i = _fish_cell(pos)

	if fish_stock(cell) <= 0:
		return false

	var bait_slot: int = _fish_bait_slot(box, cfg)
	var chance: float = float(cfg.get("bait_chance", 0.2)) if bait_slot >= 0 else float(cfg.get("hour_chance", 0.12))

	if _fate_rng.randf() >= chance:   # luck-exempt: nobody stands at a trap while it fishes
		return false

	var number: int = table.number_of(_fish_species(cell, {}, pos))

	if number == 0:
		return false

	var eaten: Dictionary = box.take_from_slot(bait_slot, 1) if bait_slot >= 0 else {}   # the bait is eaten; its slot may be where the fish goes

	if box.add(number, 1) > 0:
		if int(eaten.get("number", 0)) != 0:
			box.add(int(eaten["number"]), 1, int(eaten.get("wear", 0)))   # full: nothing caught, the bait stays

		return false

	var key: String = "%d,%d" % [cell.x, cell.y]
	_fish_stock[key][0] = int(_fish_stock[key][0]) - 1
	return true


func _fish_land(peer: int, inv, _slot: int, state: Dictionary) -> void:
	_fishing.erase(peer)
	var cell: Vector2i = state["cell"]
	var key: String = "%d,%d" % [cell.x, cell.y]

	if fish_stock(cell) <= 0:
		_say(peer, str(_fishing_data().get("say_empty", "")))
		return

	_fish_stock[key][0] = int(_fish_stock[key][0]) - 1
	var species: String = _fish_species(cell, {"species": str(state.get("species", ""))}, state.get("spot", Vector3.INF), float(_fishing_data().get("reach_m", 8.0)))
	_take_in(peer, inv, table.number_of(species), 1)
	practice(peer, "fish")
	_goal_event(peer, "fish_caught")   # the fish goal counts a catch even after the fish is eaten
	_goal_event(peer, "fish_kind_caught", species, true)   # ADD-25: first catch of this kind
	_map_catch(peer, state.get("spot", null))
	var landed: String = "You land a %s." % table.sentence_name(table.number_of(species))

	if int(_fish_stock[key][0]) < int(_fishing_data().get("hint_below", 3)):
		landed += " " + str(_fishing_data().get("say_still", "The water is still."))

	_say(peer, landed)
	_dirty = true


func _fish_tick() -> void:
	if _fishing.is_empty():
		return

	var now: int = Time.get_ticks_msec()
	var cfg: Dictionary = _fishing_data()

	for peer in _fishing.keys():
		var state: Dictionary = _fishing[peer]

		var net_phase: bool = str(state["phase"]) == "net"
		var cancel_m: float = float(cfg.get("net", {}).get("move_cancel_m", 2.0)) if net_phase else float(cfg.get("move_cancel_m", 6.0))

		if not _peer_pos.has(peer) or _peer_pos[peer].distance_to(state["spot"]) > cancel_m:
			_fishing.erase(peer)

			if net_phase:
				_say(peer, str(cfg.get("net", {}).get("say_cancel", "")))

			continue

		if now < int(state["at"]):
			continue

		if net_phase:
			_net_haul(peer, state)
			continue

		if str(state["phase"]) == "wait":
			if bool(state["bites"]):
				state["phase"] = "bite"
				state["at"] = now + int(float(cfg.get("window_s", 3.0)) * 1000.0)
				_say(peer, str(cfg.get("say_bite", "")))
			else:
				_fishing.erase(peer)
				_say(peer, str(cfg.get("say_nothing", "")))
		else:
			_fishing.erase(peer)
			_say(peer, str(cfg.get("say_away", "")))


func _station_name(station: String) -> String:
	for kind in _structures:
		if str(_structures[kind].get("station", "")) == station:
			return table.sentence_name(table.number_of(str(_structures[kind].get("item", ""))))

	for kind in _structures:
		if _structures[kind].get("also", {}).has(station):
			return table.sentence_name(table.number_of(str(_structures[kind].get("item", ""))))

	return station.replace("_", " ")


# Admin mode (Dave 2026-10-23; OFF by default since Dave 11 Nov 2026): an admin who switched it on in Esc > Admin crafts anything in the
# list free and unlimited, locked or not, with no station and no ingredients (the queue entry carries an empty needs list, which the tick
# reads as a free craft). Every session starts with it off, and switching it off stops free crafting at once, queued free crafts included.
var _admin_mode_on: Dictionary = {}     # peer -> true while that admin has Admin mode switched on this session
var admin_mode_on: Callable             # (peer) -> bool, reads _admin_mode_on (tests replace it); unset means off


func free_craft_for(peer: int) -> bool:
	return admin_ok.is_valid() and bool(admin_ok.call(peer)) and admin_mode_on.is_valid() and bool(admin_mode_on.call(peer))


# Switching Admin mode off takes every queued free craft (empty needs, nothing deferred) off the queue at once; nothing was taken, so nothing is refunded.
func _drop_free_crafts(peer: int) -> void:
	var queue: Dictionary = _queue_of(peer)

	if queue.is_empty():
		return

	var entries: Array = queue["entries"]
	var kept: Array = entries.filter(func(e): return not ((e[2] as Array).is_empty() and (e.size() < 4 or (e[3] as Array).is_empty())))

	if kept.size() == entries.size():
		return

	if kept.is_empty() or not is_same(kept[0], entries[0]):
		_restart_head(queue)

	queue["entries"] = kept
	_dirty = true
	_sync_craft_queue(peer)


# --- Gather from the sea edge (WATER_GATHER_SPEC.md; Tyler 31 Oct 2026) ---
# ACT_GATHER_EDGE: with a container shore_nodes.json lists (bucket, clay jug, clay pot, waterskin) in the pack and the sea within reach, one `sea_water`; otherwise the tide-line node of the cell the player stands in
# (data/items/shore_nodes.json), the same node every time that game day, used up until the next. `water_kind` is set by the server scene (position -> "sea_shallow", "river", ...;
# unset: no sea anywhere). Fresh water into a container is the existing drink action (_drink_water).
var _shore_taken: Dictionary = {} # "cx,cz" -> game day the node was used
var _shore_cfg: Dictionary = {}
var _shore_loaded: bool = false


func _shore_data() -> Dictionary:
	if not _shore_loaded:
		_shore_loaded = true
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/shore_nodes.json"))
		_shore_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {}

	return _shore_cfg


const SALT_SAY := "This water is too salty to drink. Try to find some fresh water."


# Whether the water at the player's own spot is the sea (water_kind_at "sea..."); false with no sea anywhere (the scene left it unset).
func _sea_at_feet(pos: Vector3) -> bool:
	return water_kind_at.is_valid() and str((water_kind_at.call(pos.x, pos.z) as Dictionary).get("kind", "")).begins_with("sea")


func _sea_near(pos: Vector3, reach: float) -> bool:
	if not water_kind_at.is_valid():
		return false

	for offset in [Vector2.ZERO, Vector2(reach, 0.0), Vector2(-reach, 0.0), Vector2(0.0, reach), Vector2(0.0, -reach)]:
		if str((water_kind_at.call(pos.x + offset.x, pos.z + offset.y) as Dictionary).get("kind", "")).begins_with("sea"):
			return true

	return false


# The node of a cell on a game day: {} when none, else the row of shore_nodes.json "nodes" (deterministic from the cell and the day).
func shore_node_at(pos: Vector3, day: int, hour: float, season: String) -> Dictionary:
	return ShoreRules.node_at(_shore_data(), pos, day, hour, season)


func gather_edge(peer: int, inv) -> bool:
	if not _peer_pos.has(peer) or inv == null:
		return false

	if not _nearest_nest(_peer_pos[peer]).is_empty():   # an inland bird nest within reach comes first (data/items/nests.json)
		return take_nest(peer, inv)

	var cfg: Dictionary = _shore_data()
	var here: Vector3 = _peer_pos[peer]
	var reach: float = float(cfg.get("reach_m", 4.0))

	if not _sea_near(here, reach):
		_say(peer, "There is no sea water here.")
		return false

	for id in cfg.get("containers", []):
		if table.number_of(str(id)) > 0 and inv.count_of(table.number_of(str(id))) > 0:
			var water: int = table.number_of(str(cfg.get("sea_water_item", "sea_water")))

			if water > 0 and _fit(peer, inv, water, 1) > 0:
				give(peer, water, 1)
				_dirty = true
				return true

			_say(peer, "Too heavy to carry any more")
			return false

	if float(ground_height.call(here.x, here.z)) > float(cfg.get("beach_max_height_m", 4.0)):
		return false

	var day: int = _game_day()
	var hour: float = fmod(float(game_seconds.call()) if game_seconds.is_valid() else 0.0, 86400.0) / 3600.0
	var node: Dictionary = shore_node_at(here, day, hour, _season_of(here))   # the shore's own season
	var key: String = "%d,%d" % [int(floor(here.x / float(cfg.get("cell_m", 8.0)))), int(floor(here.z / float(cfg.get("cell_m", 8.0))))]

	if node.is_empty():
		_say(peer, "Nothing on the tide line here.")
		return false

	if int(_shore_taken.get(key, -1)) == day:
		_say(peer, "Nothing left here today.")
		return false

	var count: Array = node.get("count", [1, 1])
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(key) ^ day ^ 0x3c6ef372
	give(peer, table.number_of(str(node["item"])), roll_amount(peer, rng, int(count[0]), int(count[1])))
	_shore_taken[key] = day
	_dirty = true
	_tell_taken(TAKEN_SHORE, _shore_cell_middle(key), day)   # the others see the node gone too (protocol 160)
	return true


# --- Inland bird nests (Sal 3 Nov 2026; data/items/nests.json) ---
# The fauna side places nests near grouse and songbird homes (nests_near). E at one takes its eggs in its seasons; a robbed nest is empty for refill_days.
# The robbed days are kept in memory only: a restart lets every nest lay again, which is harmless.
var _nest_taken: Dictionary = {}   # nest id -> game day it was robbed
var _nest_cfg: Dictionary = {}
var _nest_loaded: bool = false


func _nest_data() -> Dictionary:
	if not _nest_loaded:
		_nest_loaded = true
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/nests.json"))
		_nest_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {}

	return _nest_cfg


# The nearest nest of a known kind within reach_m of the point, or {}.
func _nearest_nest(pos: Vector3) -> Dictionary:
	if not nests_near.is_valid():
		return {}

	var cfg: Dictionary = _nest_data()
	var best: Dictionary = {}
	var best_d: float = INF

	for nest in nests_near.call(pos, float(cfg.get("reach_m", 2.5))):
		var d: float = (nest["pos"] as Vector3).distance_to(pos)

		if cfg.get("kinds", {}).has(str(nest["kind"])) and d < best_d:
			best = nest
			best_d = d

	return best


func take_nest(peer: int, inv) -> bool:
	if not _peer_pos.has(peer) or inv == null:
		return false

	var nest: Dictionary = _nearest_nest(_peer_pos[peer])

	if nest.is_empty():
		return false

	var cfg: Dictionary = _nest_data()
	var row: Dictionary = cfg["kinds"][str(nest["kind"])]
	var id: String = str(nest["id"])
	var day: int = _game_day()

	if not (_season_of(_peer_pos[peer]) in row.get("seasons", [])):   # the laying season where the nest is
		_say(peer, str(cfg.get("say_season", "")))
		return false

	if _nest_taken.has(id) and day - int(_nest_taken[id]) < int(row.get("refill_days", 3)):
		_say(peer, str(cfg.get("say_empty", "")))
		return false

	var count: Array = row.get("count", [1, 1])
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(id) ^ day ^ 0x1b873593
	give(peer, table.number_of(str(row.get("item", "egg"))), roll_amount(peer, rng, int(count[0]), int(count[1])))

	if row.has("extra") and roll_chance(peer, rng, float(row.get("extra_chance", 1.0))):   # luck nudges the extra find too (job 77)
		give(peer, table.number_of(str(row["extra"][0])), int(row["extra"][1]))

	_nest_taken[id] = day
	_nest_at[id] = nest["pos"]
	_dirty = true
	_tell_taken(TAKEN_NEST, nest["pos"], day)   # the nest shows empty for everyone (protocol 160)
	return true


# --- Farming (FARMING_SPEC.md steps 2 to 5; Tyler 31 Oct 2026) ---
# A hoe tills a metre of ground into a tilled bed (structure kind tilled_bed, state 47; a garden plot, "plot": true, works the same); a seed sown on it starts a
# crop (data/items/crops.json); a game day that ends with the bed's moisture at wet_min_pct or more (plot_water.gd: rain and pours fill it, the weather dries it) counts as watered; a crop is ripe when it is old enough (grow_days) AND has had enough wet days (water_per_day x grow_days); winter
# pauses growth (turnip excepted) and frost kills a seedling; compost speeds one crop cycle by 20 percent; E on a ripe crop gives its yields (half without the sickle
# where the crop needs one) and seeds back, and the bed is empty soil again. The crop records live beside the beds in crops.json (keyed by the bed's position, _bed_key). The client side
# (hoe till and Plant modes, E on a bed to water or harvest, the stage looks) is in inventory_view.gd, farm_rules.gd and crop_look.gd; a bed's world row carries its crop and stage.
const TILLED_STATE := 47
var _crops: Dictionary = {}              # _bed_key (the bed's position) -> {"crop": id, "sown": game day, "age": days grown, "wet": watered days, "day": last game day looked at, "compost": bool}; the bed's moisture is in _plot_water
var _crops_cfg: Dictionary = {}
var _crops_loaded: bool = false
var _old_seed_files: Dictionary = {}   # "packs", "worn", "stores", "queues", "ground" -> true while that file, as loaded, counts seeds the old way (no "seed_pinch")
var _moisture_cfg: Dictionary = {}       # crops.json "moisture" (plot_water.gd)
var _crops_file_extra: Dictionary = {}   # crops.json "worm": {"item", "chance"}: a ripe garden crop taken gives a worm this often
var _plot_water: Dictionary = {}         # _bed_key -> [moisture percent, game second it was worked out at]; saved in crops.json "plots"
var _plots_at_s: float = -1.0e18         # game second of the last _plots_tick pass
const PLOT_STEP_S := 3600.0              # plots are looked at once a game hour (150 real seconds)
const WET_THROUGH_PCT := 99.0            # a bed this wet takes no more poured water
const MOIST_STEP_PCT := 5                # the moisture a bed's world row carries, in these steps: a row is sent again only when it moves a step
const PlotWater := preload("res://src/shared/plot_water.gd")



# Seeds have been counted one by one since 23 Nov 2026 (#1628): a planting spot takes a pinch (crops.json sow_seeds: 50 wheat seeds, 5 nettle
# seeds) and the recipes take linseed by the hundred. A store saved before then (build 9257, the live world) counted one seed per spot and
# linseed by the old recipes, so each of its seeds is worth today's pinch: every stack is multiplied once (old_seed_units). Each save file
# carries its own "seed_pinch" mark (inventories, characters for worn bags, chests for every store, craft queues, the world items header for
# the ground), so a crash between two files never counts one twice; a file read from its .prev is counted from that copy's own mark.
# Nothing vanishes: what a pack, store or bag slot cannot hold (u16) goes to its free slots after every stack is counted, and the rest lies
# on the ground there (a ground pile has no such cap). The bandits' stashes do the same from their own file (server_bandits.gd).
# shortcut: a rest that leaves its own file (a full chest's rest on the ground, a worn bag's rest in the pack) is lost or doubled if the
# server dies between those two files in the first save; it takes a slot of more than 1,310 old seeds (65,535 / 50) and that crash.
# A dev store saved between #1628 and the mark is counted once too (test stores only; the live world never ran that code).
func _count_old_seeds() -> void:
	if not _old_seed_files.values().has(true):
		return

	var per: Dictionary = {}   # item number -> today's units in one old seed

	for id in old_seed_units():
		if table.number_of(str(id)) > 0:
			per[table.number_of(str(id))] = int(old_seed_units()[id])

	var later: Array = []   # [inventory or null, number, count, wear, where on the ground if it does not fit]: placed after every stack is counted
	var moved: int = 0

	if _old_seed_files.get("packs", false):
		for key in _inventories:
			moved += _old_seeds_in(_inventories[key], per, later, _last_spot_of(str(key)))   # and the bags held in it (the pack's own file)

	if _old_seed_files.get("worn", false):
		for key in _characters:
			for w in _characters[key].get("worn", []):
				if w is Array and (w as Array).size() > 3 and w[3] is Dictionary and (w[3] as Dictionary).has("bag"):
					moved += _old_seeds_in_bag(w[3], per, later, _inventories.get(key, null), _last_spot_of(str(key)))

	if _old_seed_files.get("stores", false):
		var where: Dictionary = {}   # uid -> the structure's spot

		for id in _items:
			if _items[id].has("struct") and _items[id]["struct"].has("uid"):
				where[int(_items[id]["struct"]["uid"])] = _items[id]["pos"]

		for uid in _chests:
			moved += _old_seeds_in(_chests[uid], per, later, where.get(int(uid), Vector3.INF))

	if _old_seed_files.get("queues", false):
		for key in _craft_queues:
			for entry in _craft_queues[key]["entries"]:
				for need in entry[2]:
					if per.has(int(need[0])):
						need[1] = int(need[1]) * int(per[int(need[0])])

						for unit in (need[2] if need.size() > 2 else []):
							unit[3] = int(unit[3]) * int(per[int(need[0])])   # what it took, given back at today's count if the craft is cancelled

						moved += 1

				for part in entry[3]:
					if per.has(int(part[0])):
						part[1] = int(part[1]) * int(per[int(part[0])])

	if _old_seed_files.get("ground", false):
		for id in _items.keys():
			var it: Dictionary = _items[id]

			if it.has("struct") or it.has("fire") or it.has("tree"):
				continue

			var counted: bool = false

			if per.has(int(it.get("number", 0))):
				it["count"] = mini(int(it["count"]) * int(per[int(it["number"])]), PILE_CAP)   # a pile holds up to PILE_CAP
				counted = true
				moved += 1

			if it.get("inst", {}) is Dictionary and (it.get("inst", {}) as Dictionary).has("bag"):
				var n: int = _old_seeds_in_bag(it["inst"], per, later, null, it["pos"])
				counted = counted or n > 0
				moved += n

			if counted:
				_area_recovered[area_key_of(it["pos"].x, it["pos"].z)] = true   # its area file is written again at the first save, with the mark

	for row in later:   # nothing above adds or drops, so nothing placed here is counted twice
		var left: int = int(row[2])

		if row[0] != null:
			left = row[0].add(int(row[1]), left, int(row[3]))

		if left > 0 and row[4] != Vector3.INF:
			drop_in_world(int(row[1]), left, row[4], int(row[3]))
		elif left > 0:
			push_error("server items: %d of item %d had nowhere to go (a store with no structure)" % [left, int(row[1])])

	_old_seed_files.clear()
	_dirty = true
	print("server items: a store from before seeds were counted one by one: %d stacks of seeds counted again in today's units" % moved)


# Today's units in one seed of a store saved before 23 Nov 2026, by item id: each crop's seed its crops.json sow_seeds (a spot's pinch), and
# the items in crops.json "old_seed_units" (linseed: its recipes grew by 100). Read by server_bandits.gd for the stolen stashes too.
static func old_seed_units() -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/crops.json"))
	var out: Dictionary = {}

	if typeof(parsed) != TYPE_DICTIONARY:
		return out

	for crop in parsed.get("crops", {}):
		var row: Dictionary = parsed["crops"][crop]

		if str(row.get("seed", "")) != "" and int(row.get("sow_seeds", 1)) > 1:
			out[str(row["seed"])] = int(row["sow_seeds"])

	for id in parsed.get("old_seed_units", {}):
		if not str(id).begins_with("_"):
			out[str(id)] = int(parsed["old_seed_units"][id])

	return out


# Where a character's things go when their pack cannot hold them: where they last stood (characters.json "last").
func _last_spot_of(key: String) -> Vector3:
	var p: Array = _characters.get(key, {}).get("last", {}).get("pos", [])
	return Vector3(float(p[0]), float(p[1]), float(p[2])) if p.size() == 3 else Vector3.INF


# One store's seeds multiplied (see _count_old_seeds), and the bags held in it; what a slot cannot hold goes to `later` for this store.
func _old_seeds_in(inv, per: Dictionary, later: Array, at: Vector3) -> int:
	var n: int = 0

	for s in inv.slot_count:
		var number: int = inv.numbers[s]

		if per.has(number) and inv.counts[s] > 0:
			var total: int = inv.counts[s] * int(per[number])
			inv.counts[s] = mini(total, ItemTableScript.COUNT_MAX)
			n += 1

			if total > ItemTableScript.COUNT_MAX:
				later.append([inv, number, total - ItemTableScript.COUNT_MAX, inv.wear[s], at])

		if number != 0 and inv.inst_of(s).has("bag"):
			n += _old_seeds_in_bag(inv.inst_of(s), per, later, inv, at)

	return n


# A bag's rows ([number, count, wear, ...]) multiplied; a row's rest goes to `later` for the store holding the bag (or the ground at `at`).
func _old_seeds_in_bag(inst: Dictionary, per: Dictionary, later: Array, holder, at: Vector3) -> int:
	var n: int = 0

	for row in inst["bag"]:
		if row is Array and (row as Array).size() >= 2 and per.has(int(row[0])) and int(row[1]) > 0:
			var total: int = int(row[1]) * int(per[int(row[0])])
			row[1] = mini(total, ItemTableScript.COUNT_MAX)
			n += 1

			if total > ItemTableScript.COUNT_MAX:
				later.append([holder, int(row[0]), total - ItemTableScript.COUNT_MAX, int(row[2]) if (row as Array).size() > 2 else 0, at])

	return n

func _crop_table() -> Dictionary:
	if not _crops_loaded:
		_crops_loaded = true
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/crops.json"))
		_crops_cfg = (parsed.get("crops", {}) as Dictionary) if typeof(parsed) == TYPE_DICTIONARY else {}
		_moisture_cfg = (parsed.get("moisture", {}) as Dictionary) if typeof(parsed) == TYPE_DICTIONARY else {}
		_crops_file_extra = {"worm": parsed.get("worm", {})} if typeof(parsed) == TYPE_DICTIONARY else {}

	return _crops_cfg


# A bed's crop and moisture key: its position in BED_SNAP_M steps ("b" and two whole numbers). Beds stand at least BED_GAP_M apart, so no two share one.
# Saves from before turned beds (14 Nov 2026) keyed a bed by its metre cell ("x,z"); _rekey_old_beds moves those over at load.
const BED_SNAP_M := 0.05   # a turned bed's position is kept to this, so its key never sits on a rounding edge
const BED_GAP_M := PlacementRules.BED_GAP_M   # a tilled bed's centre stays this far from another's (the placement rule, shared with the ghost)


func _bed_key(pos: Vector3) -> String:
	return "b%d,%d" % [roundi(pos.x / BED_SNAP_M), roundi(pos.z / BED_SNAP_M)]


# Whether any square metre in `cells` lies within BED_GAP_M of one of bed or plot `other`'s (two would share a crop record).
func _beds_clash(cells: Array, other: Dictionary) -> bool:
	for mine in cells:
		for theirs in _bed_cells(other):
			if Vector2(theirs.x - mine.x, theirs.z - mine.z).length() < BED_GAP_M:
				return true

	return false


# The square metres of a bed or plot, each holding one crop (Dave 14 Nov 2026: a Medium gardening plot holds 4 crops and a Large 9): a 1 m bed, a pot or a
# planter is one, at its own position (its key is the bed's own, as before); an n m plot is n by n, turned with it (FarmRules.bed_side, grid_points).
func _bed_cells(it: Dictionary) -> Array:
	return PlacementRules.plot_cells(_structures.get(str(it["struct"].get("kind", "")), {}), it["pos"], float(it["struct"].get("yaw", 0.0)))


# Which square metre of a bed a request is for: the one nearest `at` when the client names a point (not Vector3.ZERO), else the first that `wants`
# ("ripe": a crop at stage 3; "crop": any crop). -> the crop key, "" when none fits.
func _cell_key(it: Dictionary, at: Vector3, wants: String) -> String:
	var cells: Array = _bed_cells(it)

	if at != Vector3.ZERO:
		var best: Vector3 = cells[0]

		for cell in cells:
			if Vector2(cell.x - at.x, cell.z - at.z).length() < Vector2(best.x - at.x, best.z - at.z).length():
				best = cell

		return _bed_key(best)

	for cell in cells:
		var crop: Dictionary = _crops.get(_bed_key(cell), {})

		if (wants == "ripe" and not crop.is_empty() and crop_stage(crop) >= 3) or (wants == "crop" and not crop.is_empty()):
			return _bed_key(cell)

	return ""


# Old crop and moisture keys ("x,z", the metre cell under the bed) are moved to the bed standing in that cell; one with no bed there is dropped,
# as a bed's tick would drop it.
func _rekey_old_beds() -> void:
	var crop_to: Dictionary = {}    # old key -> the crop key of the bed's first square metre (a plot held one crop then)
	var water_to: Dictionary = {}   # old key -> the bed's own key (moisture is the whole bed's)

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and _is_plot_kind(str(it["struct"].get("kind", ""))):
			var old: String = "%d,%d" % [int(floor(it["pos"].x)), int(floor(it["pos"].z))]
			crop_to[old] = _bed_key(_bed_cells(it)[0])
			water_to[old] = _bed_key(it["pos"])

			if crop_to[old] != water_to[old] and _crops.has(old):
				_crops[old]["plot"] = water_to[old]

	for pair in [[_crops, crop_to], [_plot_water, water_to]]:
		var table_of: Dictionary = pair[0]
		var to: Dictionary = pair[1]

		for key in table_of.keys():
			if str(key).begins_with("b"):
				continue

			var row: Variant = table_of[key]
			table_of.erase(key)

			if to.has(str(key)) and not table_of.has(to[str(key)]):
				table_of[to[str(key)]] = row


func _game_day() -> int:
	return int(floor((float(game_seconds.call()) if game_seconds.is_valid() else 0.0) / 86400.0))


func _season() -> String:
	return str(season_now.call()) if season_now.is_valid() else "spring"   # starter-calendar: the fallback when no season_at is set (tests)


# The season at a place (Weather.season_at: half a year on across the equator from the starter's hemisphere), else the one calendar season. Sowing,
# planting and a crop's winter go by the bed's own season (Dave: nothing is based on where spawn is; the hoe's list reads the player's, terrain_client).
func _season_of(pos: Vector3) -> String:
	return str(season_at.call(pos)) if season_at.is_valid() else _season()   # starter-calendar: the fallback with no season_at (tests)


# The season count (game year x 4 + season) at a place: "taken this season" and "a new season" go by the place's own seasons. On the starter's
# side of the equator it is the calendar's count, so saved stamps there keep their meaning.
func _stamp_at(pos: Vector3) -> int:
	if season_stamp_at.is_valid():
		return int(season_stamp_at.call(pos))

	return int(season_stamp.call()) if season_stamp.is_valid() else 0   # starter-calendar: the fallback when no season_stamp_at is set (tests)


# The middle of a flora chunk ("cx,cz" home key, FLORA_CHUNK_M): where its plants' seasons are read.
func _chunk_middle(chunk_key: String) -> Vector3:
	var parts: PackedStringArray = chunk_key.split(",")

	if parts.size() < 2:
		return Vector3.ZERO

	return Vector3((float(parts[0]) + 0.5) * FLORA_CHUNK_M, 0.0, (float(parts[1]) + 0.5) * FLORA_CHUNK_M)


# The season and season count of a plant by its flora key ("cx,cz,id"): its chunk's.
func _plant_season(flora_key: String) -> String:
	return _season_of(_chunk_middle(flora_key.rsplit(",", true, 1)[0]))


# A bed key's ground position (the _bed_key steps back to metres), for its season.
func _bed_key_pos(key: String) -> Vector3:
	var parts: PackedStringArray = key.trim_prefix("b").split(",")
	return Vector3(float(parts[0]) * BED_SNAP_M, 0.0, float(parts[1]) * BED_SNAP_M) if key.begins_with("b") and parts.size() == 2 else Vector3.ZERO


func _bed_at(id: int) -> Dictionary:
	var it: Dictionary = _items.get(id, {})
	return it if (not it.is_empty() and it.has("struct") and not it["struct"].has("site") and _is_plot_kind(str(it["struct"].get("kind", "")))) else {}   # a blueprint site of a plot is not a bed yet


# A tilled bed, or a garden plot (structures.json "plot": true, buildables plan B5): it takes a seed, holds moisture and is tended the same way.
func _is_plot_kind(kind: String) -> bool:
	return kind == "tilled_bed" or bool(_structures.get(kind, {}).get("plot", false))


# The bed's moisture now, 0 to 100 (plot_water.gd): start_pct for one not seen yet.
func plot_moisture(pos: Vector3) -> float:
	var row: Array = _plot_water.get(_bed_key(pos), [])
	_crop_table()
	return float(row[0]) if row.size() >= 2 else float(_moisture_cfg.get("start_pct", 50.0))


# Every game hour (or at once when the clock jumped): each bed's moisture follows the weather since it was last worked out (rain fills it, the dry
# weather's evaporation takes it, times the structure's moisture_factor); beds that are gone are forgotten.
func _plots_tick() -> void:
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	if now_s - _plots_at_s < PLOT_STEP_S:
		return

	_plots_at_s = now_s
	_crop_table()
	var seen: Dictionary = {}

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or not _is_plot_kind(str(it["struct"].get("kind", ""))):
			continue

		var key: String = _bed_key(it["pos"])
		var row: Array = _plot_water.get(key, [float(_moisture_cfg.get("start_pct", 50.0)), now_s])
		var factor: float = float(_structures.get(str(it["struct"]["kind"]), {}).get("moisture_factor", 1.0))
		var dt_days: float = maxf(now_s - float(row[1]), 0.0) / PlotWater.DAY_S
		var weather: Dictionary = _weather_here(it["pos"])   # the bed's own sky: rain or snow, and the air at its height
		var rain: float = float(weather.get("rain", 0.0)) if weather_at.is_valid() else _rain_here(it["pos"])
		_plot_water[key] = [PlotWater.step(_moisture_cfg, float(row[0]), dt_days, float(weather.get("temp_c", 15.0)), float(weather.get("wind", 0.0)), rain, factor), now_s]
		seen[key] = true

	for key in _plot_water.keys():
		if not seen.has(key):
			_plot_water.erase(key)

	_trench_beds.clear()   # beds tilled or gone since: each trench's list is worked out again (one pass over the beds for all of them)
	var plots: Array = []

	var plots_read: bool = false

	for id in _water_kind:
		if _irrigates(str(_water_kind[id])) and _items.has(id):   # a trench or drip head taken away since the last water tick is pruned there
			if not plots_read:
				plots = _plot_ids()
				plots_read = true

			_trench_beds[id] = _beds_by_trench(_items[id]["pos"], plots, str(_water_kind[id]))

	_water_dirty = _water_dirty or not _water_kind.is_empty()   # the weather moved the plots' moisture: their room changed


# --- Water pieces (buildables plan section 6, part 6b; Sonny's water rules; Steve's design note, 10 Nov 2026) ---
# A structure with a structures.json "water" block is a piece of the water network (water_network.gd): its block names the role and numbers, and its
# inlet and outlet as [x, y, z] metres from the piece's middle, turned with its yaw. The network is accounting only: the live water sim never sees it.
# Pieces join when built (a blueprint site joins when finished) and leave when the structure is gone; the network is solved again then and at its next
# event (a tank full or empty, a plot full, water going still). A garden plot's water block makes it a consumer: what flows in becomes moisture (1
# percent a litre on a 2 x 2 plot: its store_mm over its area), and a full plot takes no more. Tank litres are saved in crops.json "tanks".
# Times are real seconds (the game clock over GameClock.RATIO), as pumping and flow are.
const WaterNetwork := preload("res://src/shared/water_network.gd")
const GameClockScript := preload("res://src/shared/game_clock.gd")
const WATER_SOURCES_PER_CHUNK := 4
var _water = WaterNetwork.new()
var _water_kind: Dictionary = {}        # item id -> structure kind of a piece in the network
var _water_dirty: bool = false
var _water_at_s: float = -1.0           # real second of the last solve
var _water_next_s: float = INF          # the network's next event, real seconds
var _tanks_written: Dictionary = {}      # save(): the tanks' litres as last written (a change alone makes the next save write)
var _water_tanks_saved: Dictionary = {} # crops.json "tanks": position key -> litres, read at load
var _wells_saved: Dictionary = {}       # crops.json "wells": position key -> [litres, game second], read at load
var _well_store: Dictionary = {}        # item id of a well with a daily yield -> [litres it held, game second then]
var _water_relink_at: Array = []       # ends of pieces that came or went: the runs there turn again before the next solve
var _water_loading: bool = false        # _water_rebuild is adding the standing pieces: one relink at the end


func _water_now_s() -> float:
	return _now_game_s() / GameClockScript.RATIO


# The network piece a structure of `def` makes standing at `pos` turned `yaw_deg`, or {} when it carries no water. A pipe run laid from the hand
# (structures.json hand_laid "pipe", PLUMBING_DESIGN s9) takes its two ports from its struct row `st` (pitch, len: PipeRules.ends); a worn wooden pipe
# ("wear_slows") carries `cond` (its condition) of its flow.
func water_piece(def: Dictionary, pos: Vector3, yaw_deg: float, st: Dictionary = {}, cond: float = 1.0) -> Dictionary:
	var block: Variant = def.get("water", {})

	if typeof(block) != TYPE_DICTIONARY or (block as Dictionary).is_empty():
		return {}

	var piece: Dictionary = {}

	for key in block:
		var value: Variant = block[key]

		if (key == "inlet" or key == "outlet") and typeof(value) == TYPE_ARRAY and (value as Array).size() == 3:
			piece[key] = pos + Vector3(float(value[0]), float(value[1]), float(value[2])).rotated(Vector3.UP, deg_to_rad(yaw_deg))
		elif key == "ports" and typeof(value) == TYPE_ARRAY:
			var ends: Array = []

			for port in value:
				ends.append(pos + Vector3(float(port[0]), float(port[1]), float(port[2])).rotated(Vector3.UP, deg_to_rad(yaw_deg)))

			piece[key] = ends
		elif key == "level_port" and typeof(value) == TYPE_ARRAY and (value as Array).size() == 3:
			piece[key] = pos + Vector3(float(value[0]), float(value[1]), float(value[2])).rotated(Vector3.UP, deg_to_rad(yaw_deg))
		elif key != "note" and key != "river_lpm":   # river_lpm is the rate a river barrel may take; the piece's own river_lpm is set by _barrels_tick only where it stands in a river
			piece[key] = value

	if str(def.get("hand_laid", "")) == "pipe":
		piece["ports"] = PipeRules.ends(pos, yaw_deg, float(st.get("pitch", 0.0)), float(st.get("len", LEGACY_PIPE_M)))

		if bool(def.get("wear_slows", false)):
			piece["cap_lpm"] = float(piece.get("cap_lpm", 0.0)) * clampf(cond, 0.0, 1.0)

	return piece if not piece.has("ports") else _with_inlet(piece, 0)


# Channels and pipes (plumbing PR 2, docs/design/PLUMBING_DESIGN.md s2): a block with "ports" (its ends, [x, y, z] from its middle) has no fixed way
# round. The port a piece in the network feeds is its inlet and the others its outlets (a tee's second outlet in "outlets"), an open channel's set
# fall_m lower (its built-in fall: 1 cm in 2 m is the network's 0.5 %, full flow on a level run). With no feeder, the first port is the inlet;
# _water_relink turns the run a piece joins or leaves again from the sources down, so the order things were built in does not matter. Each connected
# run is relinked on its own (finding 5, docs/ai-team/audits/2026-11-18_oversized_reactions_audit.md): a piece costs about its run, not all plumbing.
# shortcut: the solve after still works every run in the world (linear in pieces); per-run solves if many large networks make it show on the tick.
func _with_inlet(piece: Dictionary, inlet_port: int) -> Dictionary:
	var ports: Array = piece["ports"]
	var out: Dictionary = piece.duplicate()

	if ports.size() < 2:
		return out   # a block needs two ends; validated data never has fewer

	var fall: float = 0.0 if bool(piece.get("closed", false)) else float(piece.get("fall_m", 0.0))
	var rest: Array = []

	for n in ports.size():
		if n != inlet_port:
			rest.append((ports[n] as Vector3) - Vector3(0.0, fall, 0.0))

	out["inlet"] = ports[inlet_port]
	out["outlet"] = rest[0]
	out.erase("outlets")

	if rest.size() > 1:
		out["outlets"] = rest.slice(1)

	return out


# `piece` turned so its inlet is the first port a piece in the network feeds; {} when none does.
func _fed_turn(piece: Dictionary) -> Dictionary:
	for n in (piece["ports"] as Array).size():
		var turned: Dictionary = _with_inlet(piece, n)

		if not _water.feeders_of(turned).is_empty():
			return turned

	return {}


# The runs round the pieces that came or went are built again from the pieces standing: sources, tanks and plots as they are, then channels and
# pipes turned from the water down (each round turns those a piece already in feeds), the rest as built. A run with no channel or pipe has nothing to
# turn and is left as it is. Tank litres, the water's quality and the rates of wells and pumps being worked carry over.
func _water_relink() -> void:
	_water_prune()   # a piece taken down since the last tick (placing comes between ticks) must not be resolved or rebuilt
	var runs: Array = _water.runs(_water_relink_at)
	_water_relink_at = []
	_water_relink_runs(runs)


func _water_relink_runs(runs: Array) -> void:
	var turning: Array = []

	for run in runs:
		for id in run:
			if _water.pieces[id].has("ports"):
				turning.append(run)
				break

	if turning.is_empty():
		return

	var now_s: float = _water_now_s()

	if _water_at_s >= 0.0:
		_water_resolve(now_s)   # the water that flowed into plots until now is credited, and the tanks are brought to now, before the rates go

	for run in turning:
		var rates: Dictionary = {}
		var kept: Dictionary = {}
		var order: Array = (run as Array).duplicate()
		order.sort()   # oldest piece first, as they were built

		for id in order:
			if _water.pieces[id].has("rate_lpm"):
				rates[id] = _water.pieces[id]["rate_lpm"]

			kept[id] = _water.keep(id, now_s)
			_water.remove(id)

		var waiting: Array = []

		for id in order:
			var piece: Dictionary = water_piece(_structures.get(str(_water_kind[id]), {}), _items[id]["pos"], float(_items[id]["struct"].get("yaw", 0.0)), _items[id]["struct"], _flow_cond(id))

			if piece.has("ports"):
				waiting.append([id, piece])
			else:
				_water.add(id, piece)

		var turned_any: bool = true

		while turned_any and not waiting.is_empty():
			turned_any = false

			for row in waiting.duplicate():
				var turned: Dictionary = _fed_turn(row[1])

				if not turned.is_empty():
					_water.add(int(row[0]), turned)
					waiting.erase(row)
					turned_any = true

		for row in waiting:
			_water.add(int(row[0]), row[1])

		for id in order:
			_water.restore(id, kept[id])

		for id in rates:
			_water.pieces[id]["rate_lpm"] = rates[id]

	_water_dirty = true
	_level_groups_dirty = true

	if _water_at_s >= 0.0:
		_water_resolve(now_s)   # the new network's rates start now, so the next solve credits plots from this second


# Pieces taken down (or changed) since they joined leave the network.
func _water_prune() -> void:
	for id in _water_kind.keys():
		var it: Dictionary = _items.get(id, {})

		if it.is_empty() or not it.has("struct") or str(it["struct"]["kind"]) != str(_water_kind[id]) or it["struct"].has("site"):
			_water_relink_at.append_array(WaterNetwork.ends(_water.pieces[id]))   # what a channel or pipe there turned to may be gone
			_water.remove(id)
			_water_kind.erase(id)
			_trench_beds.erase(id)
			_water_depth.erase(id)
			_well_store.erase(id)
			_water_dirty = true
			_level_groups_dirty = true


# Why a water piece may not go here ("" when it may): more than WATER_SOURCES_PER_CHUNK sources in the chunk, a loop, or a network past 256 pieces.
func _water_refusal(def: Dictionary, spot: Vector3, yaw_deg: int) -> String:
	var piece: Dictionary = water_piece(def, spot, float(posmod(yaw_deg, 360)))

	if piece.is_empty():
		return ""

	if piece.has("ports"):
		var turned: Dictionary = _fed_turn(piece)

		if not turned.is_empty():
			piece = turned   # judged the way it will be turned when built

	var dry: String = _ground_water_refusal(piece, spot)

	if dry != "":
		return dry

	if str(piece.get("role", "")) == "source":
		var sources: int = 0

		for id in _water_kind:
			if str(_water.pieces.get(id, {}).get("role", "")) == "source" and _chunk_of(_items[id]["pos"]) == _chunk_of(spot):
				sources += 1

		if sources >= WATER_SOURCES_PER_CHUNK:
			return "Too many water sources stand here already."

	match _water.check(piece):
		"loop":
			return "This would make a loop."
		"full":
			return "This water network cannot grow any bigger."

	return ""


# A built structure joins the network when it carries water.
func _water_add(id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("struct") or it["struct"].has("site"):
		return

	var kind: String = str(it["struct"]["kind"])
	var piece: Dictionary = water_piece(_structures.get(kind, {}), it["pos"], float(it["struct"].get("yaw", 0.0)), it["struct"], _flow_cond(id))

	if piece.is_empty():
		return

	_water.add(id, piece)
	_water_kind[id] = kind
	_level_groups_dirty = true

	if _irrigates(kind) and not _trench_beds.has(id):
		_trench_beds[id] = _beds_by_trench(it["pos"], _plot_ids(), kind)   # a drip head (or a trench at load) knows its beds at once

	if not _water_loading:
		_water_relink_at.append_array(WaterNetwork.ends(piece))
		_water_relink()   # channels and pipes in its run turn to the water now (a new one, or one a new pump or tank now feeds), so the next piece sees which way they run

	if str(piece.get("role", "")) == "tank":
		_water.set_litres(id, float(_water_tanks_saved.get(_water_key(it["pos"]), 0.0)))
		_water_tanks_saved.erase(_water_key(it["pos"]))

	if piece.has("yield_l_day"):
		var saved: Variant = _wells_saved.get(_water_key(it["pos"]), null)
		_well_store[id] = [float(saved[0]), float(saved[1])] if typeof(saved) == TYPE_ARRAY and (saved as Array).size() >= 2 else [float(piece["yield_l_day"]), _now_game_s()]   # a new well is full
		_wells_saved.erase(_water_key(it["pos"]))

	_water_dirty = true


func _water_key(pos: Vector3) -> String:
	return "%.2f,%.2f,%.2f" % [pos.x, pos.y, pos.z]


# At load: every standing water structure joins, and tanks take their saved litres.
func _water_rebuild(tanks: Dictionary, wells: Dictionary = {}) -> void:
	_water = WaterNetwork.new()
	_water.still_after_s = 3.0 * GameClockScript.SECONDS_PER_DAY / GameClockScript.RATIO   # 3 game days (Sonny's rules)
	_water_kind.clear()
	_water_depth.clear()
	_pumping.clear()
	_water_relink_at = []
	_water_tanks_saved = tanks.duplicate()
	_wells_saved = wells.duplicate()
	_well_store.clear()
	_water_at_s = -1.0

	_water_loading = true

	for id in _items:
		if _items[id].has("struct") and _structures.get(str(_items[id]["struct"]["kind"]), {}).has("water"):
			_water_add(id)

	_water_loading = false
	_water_relink_runs(_water.runs())

	_water_tanks_saved.clear()
	_wells_saved.clear()


func _water_tanks_save() -> Dictionary:
	var out: Dictionary = {}
	var now_s: float = _water_now_s()

	for id in _water_kind:
		if str(_water.pieces.get(id, {}).get("role", "")) == "tank":
			out[_water_key(_items[id]["pos"])] = snappedf(_water.litres(id, now_s), 0.01)

	return out


# Litres a bed or garden plot takes for 1 percent of moisture: its store over its area (25 mm on a 1 m bed: 0.25 L; on 2 x 2 m: 1 L).
func _plot_litres_per_pct(kind: String) -> float:
	var def: Dictionary = _structures.get(kind, {})
	_crop_table()
	return PlotWater.litres_per_pct(_moisture_cfg, float(def.get("footprint_x", 1.0)) * float(def.get("footprint_z", 1.0)))


# An irrigation trench's water since the last solve goes into the beds it waters, each by the room its soil has (so the driest takes most), up to
# full; returns the litres its beds still have room for (the trench's room_l: 0 when every bed is full or it waters none).
func _trench_resolve(id: int, now_s: float) -> float:
	var beds: Array = (_trench_beds.get(id, []) as Array).filter(func(b): return _items.has(b))

	if bool(_structures.get(str(_water_kind.get(id, "")), {}).get("keeps_wet", false)):   # a drip head (Dave 19 Nov 2026): any water through it keeps its circle's beds fully watered
		if _water_at_s >= 0.0 and _water.inflow_lpm(id) > 0.0 and now_s > _water_at_s:
			for bed in beds:
				var pos: Vector3 = _items[bed]["pos"]
				var row: Array = _plot_water.get(_bed_key(pos), [])

				if plot_moisture(pos) < 99.99:
					_plot_water[_bed_key(pos)] = [100.0, float(row[1]) if row.size() >= 2 else _now_game_s()]   # its weather clock goes on as it was
					_dirty = true

		return 1.0 if not beds.is_empty() else 0.0   # it draws its trickle while water reaches it and there is a bed in its circle to keep wet

	var rooms: Array = []
	var total: float = 0.0

	for bed in beds:
		var room: float = (100.0 - plot_moisture(_items[bed]["pos"])) * _plot_litres_per_pct(str(_items[bed]["struct"]["kind"]))
		rooms.append(maxf(room, 0.0))
		total += maxf(room, 0.0)

	var litres: float = _water.inflow_lpm(id) * maxf(now_s - _water_at_s, 0.0) / 60.0 if _water_at_s >= 0.0 else 0.0

	if litres > 0.0 and total > 0.0:
		var share: float = minf(litres / total, 1.0)   # every bed gets the same share of its room

		for n in beds.size():
			var pos: Vector3 = _items[beds[n]]["pos"]
			var key: String = _bed_key(pos)
			var row: Array = _plot_water.get(key, [])
			var pct: float = PlotWater.pour(plot_moisture(pos), float(rooms[n]) * share, _plot_litres_per_pct(str(_items[beds[n]]["struct"]["kind"])))
			_plot_water[key] = [pct, float(row[1]) if row.size() >= 2 else _now_game_s()]   # its weather clock goes on as it was
			total -= float(rooms[n]) * share

		_dirty = true

	return total if total >= 0.01 else 0.0


# Pieces whose structure is gone leave; then, when anything changed or the next event is due, the water that flowed into plots since the last solve
# becomes moisture, each plot's room is set from its moisture, and the network is solved again.
func _water_tick(spent: float = 0.0) -> void:
	if _water_kind.is_empty():
		_pumping.clear()
		return

	_water_prune()

	if not _water_relink_at.is_empty():
		_water_relink()

	_pump_tick(spent)
	_barrels_tick()
	_pipe_wear_tick()
	var now_s: float = _water_now_s()

	if not _water_dirty and now_s < _water_next_s:
		return

	_water_resolve(now_s)


# The water that flowed into plots since the last solve becomes moisture, each plot's room is set from its moisture, and the network is solved.
func _water_resolve(now_s: float) -> void:
	_water_dirty = false

	for id in _water_kind:
		var piece: Dictionary = _water.pieces[id]

		if str(piece.get("role", "")) != "consumer":
			continue

		if _irrigates(str(_water_kind[id])):
			piece["room_l"] = _trench_resolve(id, now_s)
			continue

		if not _is_plot_kind(str(_water_kind[id])):
			continue

		var key: String = _bed_key(_items[id]["pos"])
		var per_pct: float = _plot_litres_per_pct(str(_water_kind[id]))
		var pct: float = plot_moisture(_items[id]["pos"])

		if _water_at_s >= 0.0 and _water.inflow_lpm(id) > 0.0:
			pct = minf(100.0, pct + _water.inflow_lpm(id) * maxf(now_s - _water_at_s, 0.0) / 60.0 / per_pct)
			var row: Array = _plot_water.get(key, [])
			_plot_water[key] = [pct, float(row[1]) if row.size() >= 2 else _now_game_s()]   # its weather clock goes on as it was

		piece["room_l"] = (100.0 - pct) * per_pct if pct < 99.99 else 0.0

	_water.solve(now_s)
	_water_at_s = now_s
	_water_next_s = _water.next_event_s()


# --- Wells (6b part 2; Sonny's water rules sections 1 to 3; no pumps since Dave 20 Nov 2026) ---
# A source whose water block has "ground_water" (a well) lifts from the nearest fresh water within WELL_REACH_M: its depth is its ground minus that
# water's surface, and it may not go where there is none or deeper than its max_depth_m. E on one starts working it and E again stops: a windlass
# ("windlass": true) gives windlass_lpm with its bucket's draw_l (there are no pumps: Dave 20 Nov 2026, PLUMBING_DESIGN s10),
# while the worker stays within its use reach and is not worn out; the work is exertion (the block's effort, 0.7). A source with nothing linked below
# it pours into the worker's containers instead (the first with room, hotbar first), and stops when they are full.
const WELL_REACH_M := 200.0
var nearest_fresh_water: Callable      # (position, reach m) -> Vector3(x, distance, z) of the nearest fresh water, distance INF when none, NAN when not known yet; set by the server scene (unset: the drink hint names no way)
const WATER_HINT_REACH_M := 1500.0    # PROVISIONAL: how far the drink goal's hint looks for fresh water
const WATER_HINT_MOVE_M := 150.0      # PROVISIONAL: a player this far from where the hint was worked out gets it again
var _water_hint_at: Dictionary = {}   # peer -> where the drink hint was last worked out (Vector3), or true once the drink goal is done
var fresh_water_y: Callable             # (position, reach m) -> surface height of the nearest lake or river within reach, NAN when none; set by the server scene (unset: the block's depth_m)
var _pumping: Dictionary = {}           # peer -> item id of the well or pump they work
var _water_depth: Dictionary = {}       # item id -> metres down to the water it lifts
var _pour_carry: Dictionary = {}        # peer -> millilitres poured but not yet a whole one


func _ground_water_depth(spot: Vector3, piece: Dictionary) -> float:
	if not fresh_water_y.is_valid():
		return float(piece.get("depth_m", 2.0))

	var surface: float = float(fresh_water_y.call(spot, WELL_REACH_M))
	return NAN if is_nan(surface) else maxf(spot.y - surface, 0.0)


# Why a well or pump may not go here ("" when it may): no fresh water within 200 m, or the water deeper than it reaches.
func _ground_water_refusal(piece: Dictionary, spot: Vector3) -> String:
	if not bool(piece.get("ground_water", false)):
		return ""

	var depth: float = _ground_water_depth(spot, piece)

	if is_nan(depth):
		return "There is no fresh water within %d m to reach down to." % int(WELL_REACH_M)

	if depth > _lift_limit_m(piece):
		return "The water lies %d m down here, too deep for this." % int(round(depth))

	return ""


# How deep a well reaches (Sonny's water rules, section 1): its max_depth_m (25 m when it has none).
static func _lift_limit_m(piece: Dictionary) -> float:
	return float(piece.get("max_depth_m", 25.0))


func _is_pumpable(piece: Dictionary) -> bool:
	return str(piece.get("role", "")) == "source" and bool(piece.get("windlass", false))


# Litres a minute the worker gets out of a well or pump at its depth.
func _pump_rate(id: int) -> float:
	var piece: Dictionary = _water.pieces.get(id, {})

	if not _water_depth.has(id):
		_water_depth[id] = _ground_water_depth(_items[id]["pos"], piece)

	var depth: float = float(_water_depth[id])

	if is_nan(depth):
		return 0.0

	return WaterNetwork.windlass_lpm(depth, float(piece.get("draw_l", 8.0)))


# E on a well or pump: start working it, or stop.
func _toggle_pump(peer: int, id: int) -> void:
	if int(_pumping.get(peer, 0)) == id:
		_stop_pump(peer, "You stop.")
		return

	if fainted_of(peer) or strain_going(peer):
		_say(peer, "You are too worn out to work it.")
		return

	_stop_pump(peer, "")

	for other in _pumping:
		if int(_pumping[other]) == id:
			_say(peer, "Someone is working it already.")
			return

	var rate: float = _pump_rate(id)

	if rate <= 0.0:
		_say(peer, "It draws nothing.")
		return

	if _well_store.has(id) and _well_left(id) < 1.0:
		_say(peer, "The well is drawn dry. It fills again through the day.")
		return

	_pumping[peer] = id
	_water.pieces[id]["rate_lpm"] = rate
	_water_dirty = true

	if _well_store.has(id):
		_say(peer, "You start drawing water (%d L a minute, %d L left in the well today). Press E again to stop." % [int(round(rate)), int(_well_left(id))])
	else:
		_say(peer, "You start working it (%d L a minute). Press E again to stop." % int(round(rate)))


# E on a Sluice or Tap (plumbing PR 2): it turns into its other kind (structures.json "toggle", the doors' pattern, so the look follows the row's
# state with no new message) and its piece in the network opens or shuts.
func _toggle_water_gate(peer: int, id: int, def: Dictionary) -> void:
	var now_ms: int = Time.get_ticks_msec()
	var other: String = str(def.get("toggle", ""))

	if now_ms - int(_last_use.get(peer, -100000)) < int(def.get("use_pace_ms", 400)) or not _structures.has(other):
		return

	_last_use[peer] = now_ms
	_items[id]["struct"]["kind"] = other
	var open: bool = bool(_structures[other].get("water", {}).get("open", true))

	if _water_kind.has(id):
		_water_kind[id] = other
		_water.pieces[id]["open"] = open
		_water_dirty = true

	_dirty = true
	_say(peer, "You open the %s." % table.sentence_name(_items[id]["number"]) if open else "You shut the %s." % table.sentence_name(_items[id]["number"]))


func _stop_pump(peer: int, say: String) -> void:
	if not _pumping.has(peer):
		return

	var id: int = int(_pumping[peer])
	_pumping.erase(peer)
	_pour_carry.erase(peer)

	if _water.pieces.has(id):
		_water.pieces[id]["rate_lpm"] = 0.0
		_water_dirty = true

	if say != "":
		_say(peer, say)


# Each slow tick: a worker who walked off, wore out or lost the piece stops; the others work on (exertion), and a source with nothing below it fills
# the worker's containers.
func _pump_tick(spent: float) -> void:
	for peer in _pumping.keys():
		var id: int = int(_pumping[peer])

		if not _peer_pos.has(peer) or not _water_kind.has(id):
			_stop_pump(peer, "")
			continue

		var def: Dictionary = _structures.get(str(_water_kind[id]), {})

		if _peer_pos[peer].distance_to(_items[id]["pos"]) > float(def.get("use_reach_m", 3.0)) + 0.5:
			_stop_pump(peer, "You stop working it.")
			continue

		if fainted_of(peer) or strain_going(peer):   # passing out stops the work at once (R-CORE-PASS-OUT)
			_stop_pump(peer, "You are too worn out to go on.")
			continue

		var piece: Dictionary = _water.pieces[id]
		_work_until[peer] = Time.get_ticks_msec() + int(maxf(spent, SLOW_TICK_S) * 1000.0) + 500
		_work_level[peer] = float(piece.get("effort", 0.7))

		var drawn_l: float = 0.0

		if _water.downstream(id).is_empty() and spent > 0.0:
			drawn_l = float(_pour_into_containers(peer, minf(float(piece.get("rate_lpm", 0.0)) * spent / 60.0, _well_left(id) if _well_store.has(id) else BIG_L) * 1000.0)) / 1000.0
		else:
			drawn_l = _water.outflow_lpm(id) * spent / 60.0

		if _well_store.has(id) and spent > 0.0:
			_well_take(id, drawn_l)

			if _well_left(id) < 0.01:
				_stop_pump(peer, "The well is drawn dry. It fills again through the day.")


# --- Well daily yield (docs/design/PLUMBING_DESIGN.md s4, PROVISIONAL) ---
# A well whose water block has "yield_l_day" holds at most one day's water and fills again at that rate over a game day (GameClock.SECONDS_PER_DAY);
# what is drawn, poured into containers or sent down the network, comes out of it. Saved in crops.json "wells" by position.
const BIG_L := 1.0e9


func _well_left(id: int) -> float:
	var row: Array = _well_store.get(id, [])

	if row.is_empty() or not _water.pieces.has(id):
		return 0.0

	var per_day: float = float(_water.pieces[id].get("yield_l_day", 0.0))
	return minf(per_day, float(row[0]) + maxf(_now_game_s() - float(row[1]), 0.0) / GameClockScript.SECONDS_PER_DAY * per_day)


func _well_take(id: int, litres: float) -> void:
	if _well_store.has(id):
		_well_store[id] = [maxf(_well_left(id) - maxf(litres, 0.0), 0.0), _now_game_s()]


func _wells_save() -> Dictionary:
	var out: Dictionary = {}

	for id in _well_store:
		if _items.has(id):
			out[_water_key(_items[id]["pos"])] = [snappedf(_well_left(id), 0.01), _now_game_s()]

	return out


# Pours up to `ml` into the worker's containers (the first with room, hotbar first); returns the millilitres poured.
func _pour_into_containers(peer: int, ml: float) -> int:
	var inv = inventory_of(peer)

	if inv == null:
		_stop_pump(peer, "")
		return 0

	var carry: float = float(_pour_carry.get(peer, 0.0)) + ml
	var whole: int = int(floor(carry))
	_pour_carry[peer] = carry - float(whole)
	var before: Array = _snapshot(inv)
	var order: Array = []

	for slot in range(inv.slot_count):
		if inv.numbers[slot] != 0 and _container_cap(inv.numbers[slot]) > inv.wear[slot]:
			if inv.on_hotbar(slot):
				order.push_front(slot)
			else:
				order.append(slot)

	if order.is_empty():
		_stop_pump(peer, "You have nothing with room for water.")
		return 0

	var total: int = 0

	for slot in order:
		var poured: int = mini(whole, _container_cap(inv.numbers[slot]) - inv.wear[slot])
		inv.wear[slot] += poured
		whole -= poured
		total += poured

		if whole <= 0:
			break

	_send_changes(peer, inv, before)
	_dirty = true
	return total


# The nearest tank (trough, barrel, cistern) holding water within `reach` of `pos`, or -1.
func _tank_near(pos: Vector3, reach: float) -> int:
	var best: int = -1
	var best_m: float = reach
	var now_s: float = _water_now_s()

	for id in _water_kind:
		if str(_water.pieces[id].get("role", "")) != "tank" or _water.litres(id, now_s) < 0.01:
			continue

		var gap: float = (_items[id]["pos"] as Vector3).distance_to(pos)

		if gap <= best_m:
			best_m = gap
			best = id

	return best


# E to drink at a tank, or to fill the container in hand from it (ACT_DRINK): the water comes out of the tank.
func _drink_from_tank(peer: int, slot: int, inv, tank: int, v: Dictionary, thirst: Dictionary, now: int) -> void:
	var now_s: float = _water_now_s()
	_water_resolve(now_s)   # the tank's litres are brought to now before any is taken
	var held_ml: int = int(floor(_water.litres(tank, now_s) * 1000.0))

	if _water.quality(tank) == "still":
		_say(peer, "The water has stood a long time. It smells stale.")

	if inv != null and slot >= 0 and slot < inv.slot_count and inv.numbers[slot] != 0 and _container_cap(inv.numbers[slot]) > inv.wear[slot]:
		var ml: int = mini(mini(int(thirst.get("fill_ml", 500)), _container_cap(inv.numbers[slot]) - inv.wear[slot]), held_ml)
		var before: Array = _snapshot(inv)
		inv.wear[slot] += ml
		_send_changes(peer, inv, before)
		_water.set_litres(tank, float(held_ml - ml) / 1000.0)
	else:
		var cap: float = float(thirst.get("cap_ml", 2400))

		if float(v["wet"]) >= cap - 1.0:
			_say(peer, "You have had enough water.")
			return

		var sip: int = mini(int(thirst.get("drink_ml", 300)), held_ml)
		v["wet"] = minf(float(v["wet"]) + float(sip), cap)
		_sync_vitals(peer, true)
		_water.set_litres(tank, float(held_ml - sip) / 1000.0)

	_last_drink[peer] = now
	_water_dirty = true
	_dirty = true


# --- Pipes laid from the hand, taps, drip heads and barrels (docs/design/PLUMBING_DESIGN.md s9, Dave 19 Nov 2026; values PROVISIONAL PV-1..PV-8) ---
# A pipe in hand lays one straight run per click pair (pipe_lay): from a connection point (a barrel's bottom centre, a trough's or cistern's outlet,
# a well's or pump's spout, or anywhere along a laid pipe) to another one or to the open air, at any angle and through anything. Its struct row keeps
# pitch, len and paid (the pack pieces it took, given back when it comes down). A run started or ended in the middle of a pipe splits that pipe there
# (a junction: the network shares the water at the meeting ends). A tap or drip head in hand is fitted on a pipe's open end. Barrels are tanks too:
# rain in the open (_barrels_tick) and levelling of barrels linked at their bottoms (WaterNetwork.level_groups, level_litres).
const PipeRules := preload("res://src/shared/pipe_rules.gd")
const LEGACY_PIPE_M := 2.0           # a Wooden - Pipe saved before laid runs (a hammer piece, 2 m, its axis 0.13 m up)
const LEGACY_PIPE_UP_M := 0.13
const BARREL_DRY_L := 0.5            # a barrel holding less counts as dry (it takes goods again)
const BARREL_RAIN_LPM_M2 := 4.0      # PV-6: full rain into an open top, L/min a square metre (1 L a minute on a barrel's 0.25 m2: about 10 mm a game hour)
const BARREL_TICK_S := 3.0           # PV-7: rain and levelling are looked at this often (real seconds)
const RIVER_BARREL_KINDS := ["brook", "river"]   # running water a barrel stood in fills from (PV-13; lakes, ponds and the sea do not)
const RIVER_BARREL_MIN_M := 0.15     # PV-13: the water must be at least this deep at its spot (as deep as blocks other building)
const LEVEL_SLACK_L := 0.5           # linked barrels this close to level are left alone
const PIPE_WEAR_REFRESH_S := 600.0   # a worn wooden pipe's flow is worked out again this often (real seconds)
var _barrel_next_s: float = 0.0
var _pipe_wear_next_s: float = 0.0
var _level_groups: Array = []        # the linked barrel sets (ids), worked out again when a piece comes or goes
var _level_groups_dirty: bool = true


func is_pipe_kind(kind: String) -> bool:
	return str(_structures.get(kind, {}).get("hand_laid", "")) == "pipe"


# A laid run's two ends.
func pipe_ends(it: Dictionary) -> Array:
	return PipeRules.ends(it["pos"], float(it["struct"].get("yaw", 0.0)), float(it["struct"].get("pitch", 0.0)), float(it["struct"].get("len", LEGACY_PIPE_M)))


# Where a player in reach of `it` acts on it: the nearest point of a laid run, else the piece's spot.
func _reach_point(it: Dictionary, from: Vector3) -> Vector3:
	if it.has("struct") and is_pipe_kind(str(it["struct"]["kind"])):
		var e: Array = pipe_ends(it)
		return PipeRules.closest_on(e[0], e[1], from)

	return it["pos"]


# A wooden pipe's condition (a worn one leaks: it carries that share of its flow); 1.0 for anything else.
func _flow_cond(id: int) -> float:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("struct") or not bool(_structures.get(str(it["struct"]["kind"]), {}).get("wear_slows", false)):
		return 1.0

	return piece_condition(id)


# A pipe saved before laid runs (hand_laid rows without len) becomes a 2 m run on the old piece's axis; called at load.
func _pipe_from_legacy(entry: Dictionary) -> void:
	if not is_pipe_kind(str(entry["struct"]["kind"])) or entry["struct"].has("len"):
		return

	entry["pos"] = (entry["pos"] as Vector3) + Vector3(0.0, LEGACY_PIPE_UP_M, 0.0)
	entry["struct"]["len"] = LEGACY_PIPE_M
	entry["struct"]["pitch"] = 0.0
	entry["struct"]["paid"] = 1


# The connection points a water piece offers a pipe start (not a pipe: those take a start anywhere along them): a tank's base outlet and bottom
# point, a source's spout.
static func _offered_points(piece: Dictionary) -> Array:
	var out: Array = []

	match str(piece.get("role", "")):
		"tank":
			for key in ["outlet", "level_port"]:
				if piece.has(key):
					out.append(piece[key])
		"source":
			if piece.has("outlet"):
				out.append(piece["outlet"])

	return out


# The connection point at `at` (within PipeRules.SNAP_M): {"id", "at", "pipe": true when it is on a laid run}, or {}. A piece's own point beats a
# pipe's body; on a pipe, a point this near an end is that end.
func _pipe_point(at: Vector3) -> Dictionary:
	var best: Dictionary = {}
	var best_d: float = PipeRules.SNAP_M

	for id in _water_kind:
		var it: Dictionary = _items.get(id, {})

		if it.is_empty() or not it.has("struct") or it["struct"].has("site"):
			continue

		if is_pipe_kind(str(_water_kind[id])):
			var e: Array = pipe_ends(it)
			var on: Vector3 = PipeRules.closest_on(e[0], e[1], at)

			for end in e:
				if on.distance_to(end) <= PipeRules.SNAP_M:
					on = end

			var d: float = on.distance_to(at) + 0.05   # a piece's own point wins a tie
			if d < best_d:
				best_d = d
				best = {"id": id, "at": on, "pipe": true}

			continue

		for point in _offered_points(_water.pieces.get(id, {})):
			var d: float = (point as Vector3).distance_to(at)

			if d < best_d:
				best_d = d
				best = {"id": id, "at": point, "pipe": false}

	return best


# Where a tap, drip head or barrel goes on the laid pipes near `at` (within `reach` across, `rise` up or down; Dave 19 Nov 2026 20:31Z): a run's end or
# one of its joints (PipeRules.joints) that no fitting or tank point already takes, the nearest: {"id", "at", "yaw", "joint": true when along the run}, or {}.
func _pipe_fit_point(at: Vector3, reach: float = PipeRules.SNAP_M, rise: float = PipeRules.SNAP_M) -> Dictionary:
	var best: Dictionary = {}
	var best_d: float = INF

	for id in _water_kind:
		if not is_pipe_kind(str(_water_kind[id])) or not _items.has(id) or _items[id]["struct"].has("site"):
			continue

		var e: Array = pipe_ends(_items[id])
		var joints: Array = PipeRules.joints(e[0], e[1], _pipe_piece_len(str(_water_kind[id])))

		for k in e.size() + joints.size():
			var point: Vector3 = e[k] if k < e.size() else joints[k - e.size()]
			var d: float = Vector2(point.x - at.x, point.z - at.z).length()

			if d > reach or absf(point.y - at.y) > rise or d >= best_d or _point_taken(point):
				continue

			best_d = d
			best = {"id": id, "at": point, "yaw": float(_items[id]["struct"].get("yaw", 0.0)), "joint": k >= e.size()}

	return best


# A barrel (a tank with a level_port, its bottom point) set down with that point within TANK_SNAP_M across and TANK_SNAP_RISE_M up or down of a free
# pipe end or joint is moved the little way onto it, so pipes laid first can take a barrel anywhere they join (PLUMBING_DESIGN s9, PV-9).
const TANK_SNAP_M := 0.6
const TANK_SNAP_RISE_M := 0.25   # at most this up or down: the ground checks passed this near


func _tank_port(kind: String) -> Variant:
	var water: Variant = _structures.get(kind, {}).get("water", {})

	if typeof(water) != TYPE_DICTIONARY or str((water as Dictionary).get("role", "")) != "tank" or typeof(water.get("level_port")) != TYPE_ARRAY:
		return null

	var v: Array = water["level_port"]
	return Vector3(float(v[0]), float(v[1]), float(v[2]))


func _tank_spot_on_pipe(kind: String, spot: Vector3, yaw_deg: int) -> Vector3:
	var port: Variant = _tank_port(kind)

	if port == null:
		return spot

	var offset: Vector3 = (port as Vector3).rotated(Vector3.UP, deg_to_rad(float(yaw_deg)))
	var on: Dictionary = _pipe_fit_point(spot + offset, TANK_SNAP_M, TANK_SNAP_RISE_M)
	if on.is_empty():
		return spot

	return (on["at"] as Vector3) - offset   # Dave 19 Nov 2026 21:56Z: the middle of its bottom lands exactly on the pipe's end or joint


# A barrel just standing whose bottom point lies on a run's joint: the run is split there, so the barrel joins both halves.
func _tank_split_pipe(id: int) -> void:
	var port: Variant = _tank_port(str(_items[id]["struct"]["kind"]))

	if port == null:
		return

	var at: Vector3 = (_items[id]["pos"] as Vector3) + (port as Vector3).rotated(Vector3.UP, deg_to_rad(float(_items[id]["struct"].get("yaw", 0.0))))
	var on: Dictionary = _pipe_fit_point(at, WaterNetwork.PORT_JOIN_M, WaterNetwork.PORT_JOIN_M)

	if not on.is_empty() and bool(on["joint"]):
		_pipe_split(int(on["id"]), on["at"])


# The length of pipe one pack piece of a run's kind covers (items.json pipe_m: Wooden - Pipe 2 m, Copper - Pipe 3 m).
func _pipe_piece_len(kind: String) -> float:
	return float(table.entry(str(_structures.get(kind, {}).get("item", kind))).get("pipe_m", 0.0))


# Whether a fitting or a tank's or source's own connection point sits at `point` (a run's end there is not free for another).
func _point_taken(point: Vector3) -> bool:
	for other in _water_kind:
		if not _water.pieces.has(other) or is_pipe_kind(str(_water_kind[other])):
			continue

		var piece: Dictionary = _water.pieces[other]
		var spots: Array = _offered_points(piece)

		if str(_structures.get(str(_water_kind[other]), {}).get("hand_laid", "")) == "fitting" and piece.has("inlet"):
			spots.append(piece["inlet"])

		for spot in spots:
			if (spot as Vector3).distance_to(point) <= WaterNetwork.PORT_JOIN_M:
				return true

	return false


# Splits the laid run `id` at `at` (a point along it, not at an end) into two runs meeting there; the pack pieces it took are shared by length
# (none made or lost). Returns the new run's id, or -1 when `at` is at an end.
func _pipe_split(id: int, at: Vector3) -> int:
	var it: Dictionary = _items[id]
	var e: Array = pipe_ends(it)

	if at.distance_to(e[0]) < PipeRules.MIN_RUN_M or at.distance_to(e[1]) < PipeRules.MIN_RUN_M:
		return -1

	var paid: int = maxi(int(it["struct"].get("paid", 1)), 0)
	var first_paid: int = clampi(int(round(float(paid) * at.distance_to(e[0]) / maxf(float(it["struct"].get("len", LEGACY_PIPE_M)), 0.01))), 0, paid)
	var first: Dictionary = PipeRules.pose(e[0], at)
	var second: Dictionary = PipeRules.pose(at, e[1])
	it["pos"] = first["pos"]
	it["struct"]["yaw"] = first["yaw"]
	it["struct"]["pitch"] = first["pitch"]
	it["struct"]["len"] = first["len"]
	it["struct"]["paid"] = first_paid
	# shortcut: pipe_lay's network-size check counts the new run, not this twin; a network at its MAX_PIECES could leave the twin standing alone (dry).
	var twin: int = _new_pipe(str(it["struct"]["kind"]), second, paid - first_paid, it["struct"].get("born", _now_game_s()))

	if it["struct"].has("owner"):
		_items[twin]["struct"]["owner"] = it["struct"]["owner"]   # a pipe cut in two: both halves stay the layer's
	_water_relink_at.append_array(e)
	_water_relink_at.append(at)
	_water.remove(id)   # its piece is made again from its new ends
	_water_kind.erase(id)
	_water_add(id)
	return twin


# A refused run takes back the splits made for it: each twin goes and its pipe is whole again (last split first).
func _pipe_unsplit(undo: Array) -> void:
	for n in range(undo.size() - 1, -1, -1):
		var row: Array = undo[n]
		var id: int = int(row[0])
		var twin: int = int(row[2])

		if _items.has(twin):
			_water_relink_at.append_array(pipe_ends(_items[twin]))
			_water.remove(twin)
			_water_kind.erase(twin)
			_items.erase(twin)

		if _items.has(id):
			_items[id]["struct"] = (row[1][0] as Dictionary).duplicate()
			_items[id]["pos"] = row[1][1]
			_refile(id)
			_water.remove(id)
			_water_kind.erase(id)
			_water_add(id)

	_dirty = true


func _new_pipe(kind: String, pose: Dictionary, paid: int, born: float) -> int:
	var id: int = _next_id
	_next_id += 1
	_items[id] = {"number": table.number_of(str(_structures[kind].get("item", kind))), "count": 1, "pos": pose["pos"], "left": 1.0e9, "struct": {"kind": kind, "yaw": float(pose["yaw"]), "pitch": float(pose["pitch"]), "len": float(pose["len"]), "paid": paid, "born": born}}
	_grid_add(id, _items[id])
	_water_add(id)
	_dirty = true
	return id


# pipe_lay (protocol 138): the held pack slot holds a pipe (lay a run from `from` to `to`) or a tap or drip head (fit it on the open pipe end at `to`).
# Every refusal says why.
const PIPE_LAY_PACE_MS := 150   # one pipe_lay a player at most this often (each one looks over the water pieces)
var _pipe_lay_msec: Dictionary = {}   # peer -> msec of the last pipe_lay


func pipe_lay(peer: int, slot: int, from: Vector3, to: Vector3) -> void:
	var inv = inventory_of(peer)

	if inv == null or not _peer_pos.has(peer) or slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not from.is_finite() or not to.is_finite():
		return

	var now_ms: int = Time.get_ticks_msec()

	if now_ms - int(_pipe_lay_msec.get(peer, -100000)) < PIPE_LAY_PACE_MS:
		return

	_pipe_lay_msec[peer] = now_ms
	var held: String = table.id_of(int(inv.numbers[slot]))
	var entry: Dictionary = table.entry(held)

	if _peer_pos[peer].distance_to(to) > PLACE_REACH_M or _peer_pos[peer].distance_to(from) > PLACE_REACH_M + PipeRules.MAX_RUN_M:   # the first click was in reach when made; the player walks the run
		_say(peer, "Too far to reach there.")
		return

	if entry.has("fitting"):
		_pipe_fit(peer, inv, slot, str(entry["fitting"]), to)
		return

	var piece_m: float = float(entry.get("pipe_m", 0.0))

	if piece_m <= 0.0 or not is_pipe_kind(held):
		_say(peer, "Hold a pipe to lay one.")
		return

	var start: Dictionary = _pipe_point(from)

	if start.is_empty():
		_say(peer, "Start a pipe at a barrel, a trough or cistern outlet, a pump or well spout, or a laid pipe.")
		return

	var finish: Dictionary = _pipe_point(to)
	var a: Vector3 = start["at"]
	var b: Vector3 = finish.get("at", to)

	if not finish.is_empty() and int(finish["id"]) == int(start["id"]):
		_say(peer, "Both ends are on the same pipe." if bool(start["pipe"]) else "Both ends are on the same piece.")
		return

	var length: float = a.distance_to(b)

	if length < PipeRules.MIN_RUN_M:
		_say(peer, "That pipe would be too short.")
		return

	if length > PipeRules.MAX_RUN_M + 0.01:
		_say(peer, "A run is at most %d m. Lay another from its end." % int(PipeRules.MAX_RUN_M))
		return

	var need: int = PipeRules.pieces_for(length, piece_m)
	var have: int = inv.count_of(int(inv.numbers[slot]))

	if have < need:
		_say(peer, "That run needs %d %s; you carry %d." % [need, table.sentence_name(int(inv.numbers[slot])), have])
		return

	var of_kind: int = 0

	for id in _water_kind:
		if str(_water_kind[id]) == held and _items.has(id) and _chunk_of(_items[id]["pos"]) == _chunk_of((a + b) * 0.5):
			of_kind += 1

	if of_kind >= int(_structures[held].get("cap_per_chunk", 400)):
		_say(peer, "Too many of these lie here already.")
		return

	# Into the middle of a laid run: it splits there first, so three ends meet. A run refused below puts the split pipe back as it was.
	var undo: Array = []   # [split id, its struct and pos before, the twin]

	for point in [start, finish]:
		if not point.is_empty() and bool(point["pipe"]) and _items.has(int(point["id"])):
			var was: Array = [(_items[int(point["id"])]["struct"] as Dictionary).duplicate(), _items[int(point["id"])]["pos"]]
			var twin: int = _pipe_split(int(point["id"]), point["at"])

			if twin >= 0:
				undo.append([int(point["id"]), was, twin])

	var pose: Dictionary = PipeRules.pose(a, b)
	var trial: Dictionary = water_piece(_structures[held], pose["pos"], float(pose["yaw"]), pose)
	var turned: Dictionary = _fed_turn(trial)
	var why: String = _water.check(turned if not turned.is_empty() else trial)

	if why != "":
		_pipe_unsplit(undo)
		_say(peer, "This would make a loop." if why == "loop" else "This water network cannot grow any bigger.")
		return

	var number: int = int(inv.numbers[slot])
	var before: Array = _snapshot(inv)
	inv.remove(number, need)
	_send_changes(peer, inv, before)
	var laid: int = _new_pipe(held, pose, need, _now_game_s())
	_items[laid]["struct"]["owner"] = str(_peer_key.get(peer, ""))   # the one who laid it: only they take it down (_may_take_down)
	_say(peer, "You lay %.1f m of %s (%d used)." % [length, table.sentence_name(number), need])


func _pipe_fit(peer: int, inv, slot: int, kind: String, at: Vector3) -> void:
	if not _structures.has(kind):
		return

	var end: Dictionary = _pipe_fit_point(at)

	if end.is_empty():
		_say(peer, "Fit it on a pipe's end or a joint (a glowing ring).")
		return

	if bool(end["joint"]):
		_pipe_split(int(end["id"]), end["at"])   # the run becomes two meeting at the joint, the fitting on both

	var number: int = int(inv.numbers[slot])
	var before: Array = _snapshot(inv)
	inv.take_from_slot(slot, 1)
	_send_changes(peer, inv, before)
	var id: int = _next_id
	_next_id += 1
	_items[id] = {"number": number, "count": 1, "pos": end["at"], "left": 1.0e9, "struct": {"kind": kind, "yaw": float(end["yaw"]), "owner": str(_peer_key.get(peer, ""))}}   # owner: who fitted the tap or drip head (_may_take_down)

	if int(_structures[kind].get("slots", 0)) > 0:   # a tap's few slots, where water containers fill
		_items[id]["struct"]["uid"] = _next_uid
		_chests[_next_uid] = _new_store(kind)
		_next_uid += 1

	_grid_add(id, _items[id])
	_water_add(id)
	_dirty = true


# Hold E on a laid run, a tap or a drip head: it comes back to the pack (a run as the pieces it took). A run with a tap or drip head on its end
# keeps it until that comes off.
func _take_down_laid(peer: int, _inv, id: int, it: Dictionary, def: Dictionary) -> void:
	if str(def.get("hand_laid", "")) == "pipe":
		for end in pipe_ends(it):
			for other in _water_kind:
				if other != id and _items.has(other) and str(_structures.get(str(_water_kind[other]), {}).get("hand_laid", "")) == "fitting" and (_items[other]["pos"] as Vector3).distance_to(end) <= WaterNetwork.PORT_JOIN_M:
					_say(peer, "Take the %s off first." % table.sentence_name(int(_items[other]["number"])))
					return

	if not _struct_empty(id):
		_say(peer, "Empty it first.")   # a tap with containers in its slots
		return

	var count: int = maxi(int(it["struct"].get("paid", 1)), 0) if str(def.get("hand_laid", "")) == "pipe" else 1   # exactly what it took: a junction's half may hold none
	_chests.erase(int(it["struct"].get("uid", 0)))
	_items.erase(id)
	_dirty = true

	if count <= 0:
		return

	var was_src: String = _gain_source
	_gain_source = SRC_RETURN
	give(peer, int(it["number"]), count)
	_gain_source = was_src


# Whether a tank that is also a store holds enough water to refuse goods (PV-6). A Water barrel (structures.json fills_containers, Dave 22 Nov 2026)
# takes its water containers whatever water it holds, and fills them from it.
func _water_blocks_goods(id: int) -> bool:
	return _barrel_water_l(id) >= BARREL_DRY_L and not _fills_containers(id)


func _fills_containers(id: int) -> bool:
	return bool(_structures.get(str(_items.get(id, {}).get("struct", {}).get("kind", "")), {}).get("fills_containers", false))


# Litres of water in a barrel (a tank that is also a store), 0 for anything else.
func _barrel_water_l(id: int) -> float:
	if not _water_kind.has(id) or not _water.pieces.get(id, {}).has("level_port"):
		return 0.0

	return _water.litres(id, _water_now_s())


func _barrel_has_goods(id: int) -> bool:
	var uid: int = int(_items.get(id, {}).get("struct", {}).get("uid", 0))
	return _chests.has(uid) and not _chests[uid].is_empty()


# Every BARREL_TICK_S: a barrel holding goods takes no water (its size 0); one in the open catches the rain (none under a roof or a tree), as does a
# raised cistern (every tank with a level_port); then linked tanks are levelled.
func _barrels_tick() -> void:
	var now_s: float = _water_now_s()

	if now_s < _barrel_next_s:
		return

	_barrel_next_s = now_s + BARREL_TICK_S

	for id in _water_kind:
		var piece: Dictionary = _water.pieces.get(id, {})

		if not piece.has("level_port") or not _items.has(id):
			continue

		var block: Dictionary = _structures.get(str(_water_kind[id]), {}).get("water", {})
		var goods: bool = _barrel_has_goods(id) and not bool(_structures.get(str(_water_kind[id]), {}).get("fills_containers", false))   # a Water barrel's containers are not goods
		var top: float = 0.0 if goods else float(block.get("litres_max", 0.0))

		if absf(float(piece.get("litres_max", 0.0)) - top) > 0.001:
			piece["litres_max"] = top
			_water_dirty = true

		var lpm: float = 0.0

		var rim: Vector3 = (_items[id]["pos"] as Vector3) + Vector3(0.0, 1.0 + float(block.get("level_base_m", 0.0)), 0.0)   # over its rim (the raised cistern's 2 m up)

		var rain: float = _rain_here(rim)   # the rain over the barrel itself (snow fills nothing)

		if rain > 0.05 and not goods and not (cover_at.is_valid() and float(cover_at.call(rim)) >= 0.5):
			lpm = snappedf(rain * BARREL_RAIN_LPM_M2 * float(block.get("rain_m2", 0.0)), 0.01)

		if absf(float(piece.get("rain_lpm", 0.0)) - lpm) > 0.001:
			piece["rain_lpm"] = lpm
			_water_dirty = true

		var river: float = 0.0 if goods else _river_lpm(id, block)

		if absf(float(piece.get("river_lpm", 0.0)) - river) > 0.001:
			piece["river_lpm"] = river
			_water_dirty = true

	_taps_fill(now_s)
	_level_barrels(now_s)


# A river barrel (Dave 20 Nov 2026 22:42Z: "the river barrel is just a barrel that sits in a river and fills up with river water gradually. it will
# have a fill speed that is pretty fast and it can have copper pipes attached"): a tank whose water block has river_lpm, stood in a brook or river
# at least RIVER_BARREL_MIN_M deep, takes that many litres a minute of river water. 0 anywhere else, or when the water is not known there.
func _river_lpm(id: int, block: Dictionary) -> float:
	var rate: float = float(block.get("river_lpm", 0.0))

	if rate <= 0.0 or not water_kind_at.is_valid() or not water_depth_at.is_valid():
		return 0.0

	var pos: Vector3 = _items[id]["pos"]

	if not str(water_kind_at.call(pos.x, pos.z).get("kind", "")) in RIVER_BARREL_KINDS:
		return 0.0

	var depth: float = float(water_depth_at.call(pos))
	return rate if not is_nan(depth) and depth >= RIVER_BARREL_MIN_M else 0.0


# The tank a tap's pipes reach that holds water (walking up the network from the tap), -1 for none. A tap only lets water out to a drink or a container.
func _tap_supply(id: int) -> int:
	var now_s: float = _water_now_s()
	var seen: Dictionary = {id: true}
	var stack: Array = [id]

	while not stack.is_empty():
		var at: int = stack.pop_back()

		for u in _water._up.get(at, []):
			if seen.has(u) or not _water.pieces.has(u):
				continue

			seen[u] = true

			if not bool(_water.pieces[u].get("open", true)):
				continue   # a shut sluice lets nothing through to the tap

			if str(_water.pieces[u].get("role", "")) == "tank" and _water.litres(u, now_s) >= 0.01:
				return int(u)

			stack.append(u)

	return -1


# E at a Copper - Tap: a mouthful from the tank its pipes reach, as at the tank itself (_drink_from_tank, paced the same way).
func _drink_at_tap(peer: int, inv, id: int) -> void:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty() or not _water_kind.has(id):
		return

	var thirst: Dictionary = _vitals_cfg.get("thirst", {})
	var now: int = Time.get_ticks_msec()

	if now - int(_last_drink.get(peer, -100000)) < int(thirst.get("drink_pace_ms", 900)):
		return

	var tank: int = _tap_supply(id)

	if tank < 0:
		_say(peer, "No water comes from the tap.")
		return

	_drink_from_tank(peer, -1, inv, tank, v, thirst, now)


# Every BARREL_TICK_S: the water containers in each tap's slots fill from the tank its pipes reach, up to the tap's fill_lpm between them (Dave 19 Nov 2026).
func _taps_fill(now_s: float) -> void:
	var resolved: bool = false

	for id in _water_kind:
		var def: Dictionary = _structures.get(str(_water_kind[id]), {})

		var own: bool = bool(def.get("fills_containers", false))   # a Water barrel fills the containers in its slots from its own water (Dave 22 Nov 2026)

		if (str(def.get("use", "")) != "tap" and not own) or not _items.has(id):
			continue

		var box = _chests.get(int(_items[id]["struct"].get("uid", 0)))

		if box == null or box.is_empty():
			continue

		var want: Array = []

		for s in box.slot_count:
			if box.numbers[s] != 0 and _container_cap(box.numbers[s]) > box.wear[s]:
				want.append(s)

		if want.is_empty():
			continue

		var tank: int = (id if _water.pieces.has(id) and _water.litres(id, now_s) >= 0.01 else -1) if own else _tap_supply(id)

		if tank < 0:
			continue

		if not resolved:
			_water_resolve(now_s)   # the tanks are brought to now before water is taken from them
			resolved = true

		var held_ml: int = int(floor(_water.litres(tank, now_s) * 1000.0))
		var budget: int = mini(int(float(def.get("fill_lpm", 30.0)) * BARREL_TICK_S / 60.0 * 1000.0), held_ml)
		var used: int = 0

		for s in want:
			var add_ml: int = mini(_container_cap(box.numbers[s]) - box.wear[s], budget - used)

			if add_ml <= 0:
				break

			box.wear[s] += add_ml
			used += add_ml

		if used > 0:
			_water.set_litres(tank, float(held_ml - used) / 1000.0)
			_water_dirty = true
			_dirty = true
			_push_box(id, box)


# Linked barrels (and a raised cistern, its floor level_base_m up) share their water to one surface (PV-7). Only a set that is off level by more than LEVEL_SLACK_L is touched: the tanks are brought
# to now, their litres set, and the network solved again on this tick.
func _level_barrels(now_s: float) -> void:
	if _level_groups_dirty:
		_level_groups = _water.level_groups()
		_level_groups_dirty = false

	var plans: Array = []

	for group in _level_groups:
		var rows: Array = []
		var held: Array = []
		var total: float = 0.0

		for id in group:
			if not _water.pieces.has(id) or not _items.has(id):
				_level_groups_dirty = true
				return

			var piece: Dictionary = _water.pieces[id]
			rows.append([(_items[id]["pos"] as Vector3).y + float(piece.get("level_base_m", 0.0)), float(piece.get("level_h_m", 0.85)), float(piece.get("litres_max", 0.0))])
			held.append(_water.litres(id, now_s))
			total += float(held[held.size() - 1])

		var want: Array = WaterNetwork.level_litres(rows, total)

		for n in want.size():
			if absf(float(want[n]) - float(held[n])) > LEVEL_SLACK_L:
				plans.append([group, want])
				break

	if plans.is_empty():
		return

	_water_resolve(now_s)

	for plan in plans:
		for n in (plan[0] as Array).size():
			_water.set_litres(int(plan[0][n]), float(plan[1][n]))

	_water_dirty = true


# A worn wooden pipe leaks more as it wears: every PIPE_WEAR_REFRESH_S the runs holding one are made again from their condition now.
func _pipe_wear_tick() -> void:
	var now_s: float = _water_now_s()

	if now_s < _pipe_wear_next_s:
		return

	_pipe_wear_next_s = now_s + PIPE_WEAR_REFRESH_S

	for id in _water_kind:
		if bool(_structures.get(str(_water_kind[id]), {}).get("wear_slows", false)) and _water.pieces.has(id) and absf(float(_water.pieces[id].get("cap_lpm", 0.0)) - float(_structures[str(_water_kind[id])]["water"].get("cap_lpm", 0.0)) * _flow_cond(id)) > 0.5:
			_water_relink_at.append_array(WaterNetwork.ends(_water.pieces[id]))


# One hoe stroke tills a metre: a tilled bed where the player points (reach and hoe like the hoe path).
# `yaw_deg` (Dave 14 Nov 2026, the hoe grid turns "so you can line up your gardens"): 0 snaps the bed to the world's metre cell as before; any other turn
# lays the metre bed where the grid point is (to BED_SNAP_M), turned that far.
func till(peer: int, inv, at: Vector3, held_slot: int, yaw_deg: int = 0) -> int:
	if not ground_height.is_valid() or not _structures.has("tilled_bed"):
		return 0

	var hoe: int = _hoe_ready(peer, inv, at, held_slot)

	if hoe < 0:
		return 0

	return _till_cell(peer, inv, hoe, at, yaw_deg, false, edits_near.call(at, 4.0) if edits_near.is_valid() else [])


# One metre bed tilled at `at` with the hoe in pack slot `hoe` (checked by the caller); `quiet` keeps a garden's refusals to itself (till_garden says once).
# `edits`: the ground edits near it, so the bed lies on the ground as dug and filled (a levelled garden), not the generated surface.
func _till_cell(peer: int, inv, hoe: int, at: Vector3, yaw_deg: int, quiet: bool, edits: Array) -> int:
	yaw_deg = posmod(yaw_deg, 360)
	var cell: Vector3 = Vector3(floor(at.x) + 0.5, 0.0, floor(at.z) + 0.5) if yaw_deg == 0 else Vector3(snappedf(at.x, BED_SNAP_M), 0.0, snappedf(at.z, BED_SNAP_M))
	var ground: float = _edited_height(cell.x, cell.z, edits)

	if is_nan(ground):
		return 0

	cell.y = ground + 0.02

	if water_depth_at.is_valid() and float(water_depth_at.call(Vector3(cell.x, ground, cell.z))) > 0.05:
		if not quiet:
			_say(peer, "You cannot till ground under water.")

		return 0

	var here_chunk: Vector2i = _chunk_of(cell)
	var of_kind: int = 0

	for id in _items:
		var other: Dictionary = _items[id]

		if not other.has("struct"):
			continue

		var kind: String = str(other["struct"]["kind"])

		if _is_plot_kind(kind) and _beds_clash([cell], other):
			if not quiet:
				_say(peer, "That ground is already a bed." if kind == "tilled_bed" else "A garden plot or planter is in the way.")

			return 0   # already tilled, or a bed or a plot's square metre overlaps it (turned beds stand where their grid puts them)

		if kind == "tilled_bed":
			if _chunk_of(other["pos"]) == here_chunk:
				of_kind += 1
		elif other["pos"].distance_to(cell) < 1.0 and (kind == TRENCH_KIND or not bool(_structures.get(kind, {}).get("walkover", false))):   # a trench is walked over but not tilled
			if not quiet:
				_say(peer, "Something stands there.")

			return 0

	if of_kind >= int(_structures["tilled_bed"].get("cap_per_chunk", 200)):
		if not quiet:
			_say(peer, "This ground is tilled enough.")

		return 0

	if hoe >= 0:   # a garden job goes on with the hoe put away (it wears only while held)
		_wear_slot(peer, inv, hoe, "dig")

	_items[_next_id] = {"number": table.number_of("tilled_bed"), "count": 1, "pos": cell, "left": 1.0e9, "struct": {"kind": "tilled_bed", "yaw": float(yaw_deg), "owner": str(_peer_key.get(peer, ""))}}   # owner: the one who tilled it (_may_take_down)
	_zone_add(_next_id)
	_next_id += 1
	_dirty = true
	_goal_event(peer, "bed_tilled")   # ADD-04: a new bed tilled by this hoe stroke (the early returns above are not a tilling)
	return _next_id - 1


# Irrigation trench (garden moisture stage 2, Dave 19 Nov 2026: pipes from a water source uphill run "into an irrigation trench that should improve the
# moisture level of the soil around it for upto 30 meters in either direction"; docs/design/GARDEN_MOISTURE.md s3). The hoe's Irrigation Trench mode digs
# one 2 m trench piece where the player aims, along the way they face (`yaw_deg`). It is a water-network consumer: a channel's or pipe's open end, or a
# spout, over it pours in (structures.json water block), and what flows in is shared among every bed and garden plot within irrigates_m of it whose
# ground is no more than irrigate_rise_m above it (water does not climb), each by the room its soil has (_water_resolve). No items are used.
const TRENCH_KIND := "irrigation_trench"
const TRENCH_CLEAR_M := 1.0   # a trench piece stays this far from another piece, a bed or anything standing
var _trench_beds: Dictionary = {}   # trench id -> the ids of the beds and plots it waters (worked out when dug and each hourly plots pass)


func dig_trench(peer: int, inv, at: Vector3, held_slot: int, yaw_deg: int) -> int:
	if not ground_height.is_valid() or not _structures.has(TRENCH_KIND) or not at.is_finite():
		return 0

	var hoe: int = _hoe_ready(peer, inv, at, held_slot)

	if hoe < 0:
		return 0

	var spot: Vector3 = Vector3(snappedf(at.x, BED_SNAP_M), 0.0, snappedf(at.z, BED_SNAP_M))
	var ground: float = _edited_height(spot.x, spot.z, edits_near.call(spot, 4.0) if edits_near.is_valid() else [])

	if is_nan(ground):
		return 0

	spot.y = ground + 0.02

	if water_depth_at.is_valid() and float(water_depth_at.call(Vector3(spot.x, ground, spot.z))) > 0.05:
		_say(peer, "You cannot dig a trench under water.")
		return 0

	var here_chunk: Vector2i = _chunk_of(spot)
	var of_kind: int = 0

	for id in _items:
		var other: Dictionary = _items[id]

		if not other.has("struct"):
			continue

		var kind: String = str(other["struct"]["kind"])

		if _is_plot_kind(kind) and _beds_clash([spot], other):
			_say(peer, "That is a garden bed: dig the trench beside it.")
			return 0

		if kind == TRENCH_KIND:
			if _chunk_of(other["pos"]) == here_chunk:
				of_kind += 1

			if other["pos"].distance_to(spot) < TRENCH_CLEAR_M:
				_say(peer, "A trench is dug there already.")
				return 0
		elif other["pos"].distance_to(spot) < TRENCH_CLEAR_M and not bool(_structures.get(kind, {}).get("walkover", false)):
			_say(peer, "Something stands there.")
			return 0

	if of_kind >= int(_structures[TRENCH_KIND].get("cap_per_chunk", 60)):
		_say(peer, "This ground has trenches enough.")
		return 0

	_wear_slot(peer, inv, hoe, "dig")
	var id: int = _next_id
	_items[id] = {"number": table.number_of(TRENCH_KIND), "count": 1, "pos": spot, "left": 1.0e9, "struct": {"kind": TRENCH_KIND, "yaw": float(posmod(yaw_deg, 360)), "owner": str(_peer_key.get(peer, ""))}}   # owner: the digger (_may_take_down)
	_zone_add(id)
	_next_id += 1
	_trench_beds[id] = _beds_by_trench(spot, _plot_ids())
	_water_add(id)
	_dirty = true
	return id


# Whether a structure kind waters the beds round it (the irrigation trench, a Copper - Drip head: structures.json irrigates_m).
func _irrigates(kind: String) -> bool:
	return _structures.get(kind, {}).has("irrigates_m")


# The ids of every standing bed and garden plot (not a blueprint site).
func _plot_ids() -> Array:
	var out: Array = []

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and not it["struct"].has("site") and _is_plot_kind(str(it["struct"].get("kind", ""))):
			out.append(id)

	return out


# Of `plots`, the beds a trench (or a drip head, `kind`) at `spot` waters: within irrigates_m across the ground and no more than irrigate_rise_m above it.
func _beds_by_trench(spot: Vector3, plots: Array, kind: String = TRENCH_KIND) -> Array:
	var def: Dictionary = _structures.get(kind, {})
	var reach: float = float(def.get("irrigates_m", 30.0))
	var rise: float = float(def.get("irrigate_rise_m", 0.5))
	var out: Array = []

	for id in plots:
		var pos: Vector3 = _items[id]["pos"]

		if Vector2(pos.x - spot.x, pos.z - spot.z).length() <= reach and pos.y - spot.y <= rise:
			out.append(id)

	return out


# Till Garden Grid - 20m Edge Blend and Till Soil 2m (BugsList_Current.md entries 5 and 6, Dave 18 Nov 2026). One click sends the grid (centre `at`,
# `size` = check * 10000000 + mode * 10000 + width * 100 + length in beds, turned `yaw_deg`); `mode` 0 is the garden, 1 the 2 m soil patch, and `check` asks only
# whether it would go (the preview: the answer is a hoe_verdict, nothing changes). The whole area is surveyed and checked before any ground moves: the
# original heights of the beds are averaged together; the garden is levelled to that average and every bed tilled (dark garden soil, no grass); a garden's
# edge blends back to the land no steeper than GARDEN_BLEND_GRADE and within GARDEN_BLEND_M; trees, large rocks, buildings (and ground within
# GARDEN_BUILD_CLEAR_M of one) refuse the whole thing, red, before anything changes. Small loose rocks in it are picked up. No soil is used. The work then runs
# as one job on the slow tick (GARDEN_EDITS_A_STEP ground edits, then GARDEN_TILLS_A_STEP beds, every HOE_COOLDOWN_MS, times the hoe's till_speed) and finishes whatever the player
# holds. A garden opens the next Garden Grid GARDEN_COOLDOWN_MS later (the client's red countdown); the soil patch has no wait. PROVISIONAL values TG-1..TG-6.
const GARDEN_BLEND_M := 20.0           # Dave: the blend reaches the existing ground within 20 m of the garden's edge
const GARDEN_BLEND_GRADE := 0.5        # TG-1: at most this rise a metre (27 degrees; Dave allows up to 45): with 1.2 m spheres a steeper blend has each cut or fill undo its neighbour's
const GARDEN_BUILD_CLEAR_M := 2.0      # Dave: no ground changed under a building or within 2 m of any building piece
const GARDEN_FEATHER_SPHERE_M := 1.2   # the blend's cut and fill spheres (a 2.5 m sphere is flatter than the slope it should leave)
const GARDEN_FEATHER_SLACK_M := 0.1    # a blend spot within this of its target is left: neighbouring 1.2 m spheres undo each other by up to about 0.09 m
const GARDEN_MAX_EDITS := 1500         # TG-2: a garden that needs more ground edits than this is refused before anything changes
const GARDEN_EDITS_A_STEP := 8         # TG-3: ground edits each HOE_COOLDOWN_MS (times the hoe's till_speed)
const GARDEN_TILLS_A_STEP := 4         # beds tilled each HOE_COOLDOWN_MS once the ground is level (times the hoe's till_speed)
const GARDEN_COOLDOWN_MS := 20000      # Dave: 20 s before the next Garden Grid
const SOIL_PATCH_BEDS := 2             # Till Soil 2m: a 2 m patch, 2 by 2 metre beds
const GARDEN_GIVE_UP_MS := 120000    # a garden whose ground will not load or take the edits for this long is tilled as it lies
const SOIL_SPHERE_M := 0.9             # TG-4: its cut and fill spheres (no blend: the change stays inside about a metre of the patch)
const HOE_CHECK_MS := 250              # TG-5: a preview's question is answered at most this often per player
const TILL_GARDEN := 0
const TILL_SOIL := 1
var _garden_jobs: Dictionary = {}      # peer -> {"centre": Vector3, "yaw", "spots": [Vector2 offsets], "targets", "radii", "edits", "cells": [Vector2], "made", "worked", "next_ms", "reach", "slot"}
var _garden_ready_ms: Dictionary = {}  # peer -> msec when Garden Grid tilling opens again
var _hoe_check_ms: Dictionary = {}     # peer -> msec of the last preview answer
const FarmRules := preload("res://src/shared/farm_rules.gd")


func till_garden(peer: int, inv, at: Vector3, held_slot: int, yaw_deg: int, size: int) -> bool:
	if not ground_height.is_valid() or not dig_ground.is_valid() or not fill_ground.is_valid() or not _structures.has("tilled_bed") or not _peer_pos.has(peer) or not at.is_finite():
		return false

	var check: bool = size >= 10000000
	var now: int = Time.get_ticks_msec()

	if check:
		if now - int(_hoe_check_ms.get(peer, -100000)) < HOE_CHECK_MS:
			return false

		_hoe_check_ms[peer] = now

	var plan: Dictionary = _till_plan(peer, inv, at, held_slot, yaw_deg, size % 10000000, check)
	var why: String = str(plan.get("why", ""))

	if check or why != "":
		if not check and why != "-":
			_say(peer, why)

		_hoe_verdict(peer, Net.ACT_TILL_GARDEN, size % 10000000, at, 1 if why == "" else 0, "" if why == "-" else why)
		return false

	for stone in plan["stones"]:   # small loose rocks in the way are picked up (Dave: on the confirming click, never by the preview)
		var it: Dictionary = _items.get(int(stone), {})

		if not it.is_empty():
			var count: int = int(it["count"])
			_take_in(peer, inv, int(it["number"]), count)
			_take_from(int(stone), count)

	if int(plan["mode"]) == TILL_GARDEN:
		_garden_ready_ms[peer] = now + GARDEN_COOLDOWN_MS

	plan["give_up_ms"] = Time.get_ticks_msec() + GARDEN_GIVE_UP_MS
	plan["speed"] = _hoe_speed(inv, _held_tool(inv, int(plan["slot"]), "hoe"))   # the pace of the hoe that took the job on, kept if it is put away
	_garden_jobs[peer] = plan
	_hoe_verdict(peer, Net.ACT_TILL_GARDEN, size % 10000000, at, 2, "")
	_say(peer, "Levelling and tilling a %d by %d garden." % [int(plan["w"]), int(plan["d"])] if int(plan["mode"]) == TILL_GARDEN else "Tilling a 2 m patch of soil.")
	return true


# The survey of a garden or soil patch: {"why": the refusal ("" when it goes; "-" a quiet no), and when it goes the job: "mode", "w", "d", "yaw", "centre"
# (its y the average), "spots", "targets", "radii", "edits", "cells", "stones", "reach", "slot"}. Reads the ground and the world; changes nothing.
func _till_plan(peer: int, inv, at: Vector3, held_slot: int, yaw_deg: int, code: int, check: bool) -> Dictionary:
	var mode: int = TILL_SOIL if floori(float(code) / 10000.0) == TILL_SOIL else TILL_GARDEN

	if _garden_jobs.has(peer):
		return {"why": "Still working the last garden."}

	if mode == TILL_GARDEN and Time.get_ticks_msec() < int(_garden_ready_ms.get(peer, 0)):
		return {"why": "The next garden grid is ready in %d s." % ceili(float(int(_garden_ready_ms[peer]) - Time.get_ticks_msec()) / 1000.0)}

	var w: int = SOIL_PATCH_BEDS if mode == TILL_SOIL else clampi(floori(float(code % 10000) / 100.0), 1, FarmRules.GRID_MAX_SIDE)
	var d: int = SOIL_PATCH_BEDS if mode == TILL_SOIL else clampi(code % 100, 1, FarmRules.GRID_MAX_SIDE)
	yaw_deg = posmod(yaw_deg, 360)
	var centre: Vector2 = Vector2(at.x, at.z)
	var cells: Array = FarmRules.grid_points(w, d, 1.0, centre, yaw_deg)
	var near_cell: Vector3 = _grid_reach_point(peer, at, cells)   # the grid runs on from the crosshair (Dave 24 Nov 2026): in reach when its nearest bed is

	if check:
		if _held_tool(inv, held_slot, "hoe") < 0 or _peer_pos[peer].distance_to(near_cell) > DIG_REACH_M:
			return {"why": "-"}
	elif _hoe_ready(peer, inv, near_cell, held_slot) < 0:   # in reach, a hoe in hand, and the hoe's pace
		return {"why": "-"}

	if yaw_deg == 0:   # unturned beds sit on the metre cells (_till_cell snaps them): survey and level where they will be
		centre += Vector2(floor(cells[0].x) + 0.5 - cells[0].x, floor(cells[0].y) + 0.5 - cells[0].y)
		cells = FarmRules.grid_points(w, d, 1.0, centre, yaw_deg)

	var blend: float = GARDEN_BLEND_M if mode == TILL_GARDEN else 0.0
	var reach: float = Vector2(float(w), float(d)).length() * 0.5 + blend + LEVEL_SPHERE_M + 1.0
	var edits: Array = (edits_near.call(Vector3(centre.x, at.y, centre.y), reach) if edits_near.is_valid() else []) as Array
	var grid: Dictionary = _edit_buckets(edits)
	var mean: float = 0.0

	for c in cells:
		var h: float = _bucket_height(c.x, c.y, grid)

		if is_nan(h):
			return {"why": "The ground there is not ready yet."}

		if water_depth_at.is_valid() and float(water_depth_at.call(Vector3(c.x, h, c.y))) > 0.05:
			return {"why": "You cannot till ground under water."}

		mean += h

	mean /= float(cells.size())
	var turn: float = -deg_to_rad(float(yaw_deg))
	var spots: Array = []
	var targets: Array = []
	var radii: Array = []
	var cost: int = 0
	var touched: Array = []   # [flat point, how far its edit reaches] of every spot whose ground will change

	if mode == TILL_SOIL:
		for a in 4:
			for c in 4:
				var flat: Vector2 = centre + Vector2((float(c) - 1.5) * 0.5, (float(a) - 1.5) * 0.5).rotated(turn)
				var h: float = _bucket_height(flat.x, flat.y, grid)

				if is_nan(h):
					return {"why": "The ground there is not ready yet."}

				spots.append(flat - centre)
				targets.append(mean)
				radii.append(SOIL_SPHERE_M)
				touched.append([flat, _edit_reach(SOIL_SPHERE_M)])
				cost += ceili(absf(h - mean) / LEVEL_MAX_M)
	else:
		var met: bool = false

		for ring in range(0, int(blend) + 1):   # ring 0 the garden; ring k the square band k metres out; the blend ends at the first band that already meets the land
			var meets: bool = true

			for a in range(-ring, d + ring):
				for c in range(-ring, w + ring):
					if ring > 0 and a > -ring and a < d + ring - 1 and c > -ring and c < w + ring - 1:
						continue   # inside the band: done in an earlier ring

					var local: Vector2 = Vector2(float(c) - float(w - 1) * 0.5, float(a) - float(d - 1) * 0.5)
					var out: float = Vector2(maxf(absf(local.x) - float(w) * 0.5, 0.0), maxf(absf(local.y) - float(d) * 0.5, 0.0)).length()   # how far outside the garden's edge
					var flat: Vector2 = centre + local.rotated(turn)
					var h: float = _bucket_height(flat.x, flat.y, grid)

					if is_nan(h):
						return {"why": "The ground there is not ready yet."}

					var want: float = mean if out <= 0.0 else clampf(h, mean - out * GARDEN_BLEND_GRADE, mean + out * GARDEN_BLEND_GRADE)   # outside: the land as it is wherever it lies within the slope, else the slope

					if out > 0.0 and absf(want - h) <= GARDEN_FEATHER_SLACK_M and ring > 2:
						continue   # the land already meets the blend here: left as it is

					if out > 0.0 and absf(want - h) > GARDEN_FEATHER_SLACK_M:
						meets = false

					spots.append(flat - centre)
					targets.append(want)
					radii.append(LEVEL_SPHERE_M if out <= 0.0 else GARDEN_FEATHER_SPHERE_M)
					touched.append([flat, _edit_reach(LEVEL_SPHERE_M if out <= 0.0 else GARDEN_FEATHER_SPHERE_M)])
					cost += ceili(absf(h - want) / LEVEL_MAX_M)

			if ring > 2 and meets:
				met = true
				break

		if not met:
			return {"why": "The land falls away too steeply here: the garden's edge cannot meet it within %d m. Pick flatter ground." % int(GARDEN_BLEND_M)}

	if cost > GARDEN_MAX_EDITS:
		return {"why": "Too much ground to move for one garden here: pick flatter ground or a smaller garden."}

	var seen: Dictionary = _till_obstacles(Vector3(centre.x, mean, centre.y), reach + 2.0)

	for spot in touched:
		var why: String = _obstacle_at(seen, spot[0], float(spot[1]), GARDEN_BUILD_CLEAR_M)

		if why != "":
			return {"why": why}

	var stones: Array = []

	for row in seen["stones"]:   # only the loose rocks on the beds themselves; ones the blend runs under stay where they lie
		if cells.any(func(c): return FarmRules.on_square(row[1], c, 0.6, float(yaw_deg))):
			stones.append(row[0])

	return {"why": "", "mode": mode, "w": w, "d": d, "yaw": yaw_deg, "centre": Vector3(centre.x, mean, centre.y), "spots": spots, "targets": targets, "radii": radii, "edits": edits, "cells": cells, "stones": stones, "made": 0, "worked": 0, "next_ms": 0, "reach": reach, "slot": held_slot}


# What stands round a hoe grid: {"pieces": [[flat position, half its footprint]], "boulders": [[flat position, radius now]], "trees": [[flat position, trunk radius]],
# "stones": [[world id, flat position]] the small loose rocks (scatter stone, flint and ore) a confirming click picks up}.
func _till_obstacles(centre: Vector3, reach: float) -> Dictionary:
	var seen: Dictionary = {"pieces": [], "boulders": [], "trees": [], "stones": []}

	for id in _items:
		var it: Dictionary = _items[id]
		var flat: Vector2 = Vector2(it["pos"].x, it["pos"].z)

		if flat.distance_to(Vector2(centre.x, centre.z)) > reach + 6.0:
			continue

		if it.has("boulder"):
			var info: Dictionary = it["boulder"]
			seen["boulders"].append([flat, BoulderWear.radius_now(float(info["radius"]), int(it["count"]), int(info["total"]))])
		elif it.has("struct"):
			var kind: String = str(it["struct"]["kind"])
			var def: Dictionary = _structures.get(kind, {})

			if not _is_plot_kind(kind) and not bool(def.get("walkover", false)):
				seen["pieces"].append([flat, Vector2(float(def.get("footprint_x", 1.0)), float(def.get("footprint_z", 1.0))) * 0.5, float(it["struct"].get("yaw", 0.0))])
		elif it.has("scatter") and int(it.get("number", 0)) > 0:
			var item_id: String = table.id_of(int(it["number"]))

			if item_id == "stone" or item_id == "flint" or item_id.ends_with("_ore"):
				seen["stones"].append([int(id), flat])

	if trunks_near.is_valid():
		for trunk in trunks_near.call(centre, reach):
			seen["trees"].append([Vector2(trunk[0].x, trunk[0].z), float(trunk[1])])

	return seen


# Why the ground at a flat point may not change, "" when it may: `spread` how far round the point the change reaches, `clear` the room kept to a building.
func _obstacle_at(seen: Dictionary, flat: Vector2, spread: float, clear: float) -> String:
	for piece in seen["pieces"]:
		var local: Vector2 = (flat - piece[0]).rotated(deg_to_rad(float(piece[2])))   # into the piece's own frame (as SurveyLine.crosses)
		var half: Vector2 = piece[1]

		if Vector2(maxf(absf(local.x) - half.x, 0.0), maxf(absf(local.y) - half.y, 0.0)).length() < clear + spread:   # to the nearest point of its turned footprint
			return "Too close to a building: keep it %d m clear of buildings." % int(clear) if clear > 0.0 else "A building is in the way."

	for tree in seen["trees"]:
		if flat.distance_to(tree[0]) < float(tree[1]) + spread + 0.3:
			return "A tree is in the way: fell it and clear the stump first."

	for rock in seen["boulders"]:
		if flat.distance_to(rock[0]) < float(rock[1]) + spread:
			return "A large rock is in the way: break it up first."

	return ""


# How far across the ground one cut or fill sphere of this radius changes it: the circle where a sphere sunk LEVEL_MAX_M deep (or less) meets the surface.
func _edit_reach(sphere: float) -> float:
	var depth: float = minf(LEVEL_MAX_M, sphere)
	return sqrt(depth * (2.0 * sphere - depth))


# The saved edits filed by 4 m cell (each edit in every cell it reaches, oldest first), so a survey of hundreds of spots reads only the edits near each.
const EDIT_BUCKET_M := 4.0


func _edit_buckets(edits: Array) -> Dictionary:
	var grid: Dictionary = {}

	for op in edits:
		_bucket_add(grid, op)

	return grid


func _bucket_add(grid: Dictionary, op: Array) -> void:
	var r: float = float(op[2])

	for gx in range(floori((op[1].x - r) / EDIT_BUCKET_M), floori((op[1].x + r) / EDIT_BUCKET_M) + 1):
		for gz in range(floori((op[1].z - r) / EDIT_BUCKET_M), floori((op[1].z + r) / EDIT_BUCKET_M) + 1):
			var key: Vector2i = Vector2i(gx, gz)

			if not grid.has(key):
				grid[key] = []

			grid[key].append(op)


func _bucket_height(x: float, z: float, grid: Dictionary) -> float:
	return _edited_height(x, z, grid.get(Vector2i(floori(x / EDIT_BUCKET_M), floori(z / EDIT_BUCKET_M)), []))


func _hoe_verdict(peer: int, kind: int, code: int, at: Vector3, state: int, why: String, cells: PackedByteArray = PackedByteArray()) -> void:
	if send_hoe_verdict.is_valid():
		send_hoe_verdict.call(peer, kind, code, at, state, why, cells)


# Every slow tick: each garden job takes one step when it is due: the ground first, then the beds. It finishes whatever the player holds (the area was
# checked when it was taken on); it is dropped only when the player leaves the game.
func _garden_jobs_tick() -> void:
	var now: int = Time.get_ticks_msec()

	for peer in _garden_jobs.keys():
		var job: Dictionary = _garden_jobs[peer]

		if now < int(job["next_ms"]):
			continue

		job["next_ms"] = now + HOE_COOLDOWN_MS
		var inv = inventory_of(peer) if _peer_pos.has(peer) else null

		if inv == null:
			_garden_jobs.erase(peer)
			continue

		var hoe: int = _held_tool(inv, int(job["slot"]), "hoe")   # still in hand: it wears with the work; put away, the work goes on unworn
		var centre: Vector3 = job["centre"]

		if int(job["worked"]) < GARDEN_MAX_EDITS and not (job["spots"] as Array).is_empty():
			var worked: int = _level_ground(centre, job["spots"], centre.y, job["edits"], job["targets"], job["radii"], Callable(), ceili(GARDEN_EDITS_A_STEP * float(job.get("speed", 1.0))))

			if worked > 0:
				job["worked"] = int(job["worked"]) + worked

				if hoe >= 0:
					_wear_slot(peer, inv, hoe, "dig")

				_remove_paths_near(centre, float(job["reach"]))
				_dirty = true
				continue

			if (worked < 0 or _level_refused) and now < int(job.get("give_up_ms", 0)):
				continue   # ground not loaded yet, or it took no more this step: try again next step rather than till unlevelled ground

			job["worked"] = GARDEN_MAX_EDITS   # level (or the ground takes no more): on to the beds

		var cells: Array = job["cells"]

		for n in ceili(GARDEN_TILLS_A_STEP * float(job.get("speed", 1.0))):
			if cells.is_empty():
				break

			var flat: Vector2 = cells.pop_front()

			if _till_cell(peer, inv, _held_tool(inv, int(job["slot"]), "hoe"), Vector3(flat.x, centre.y, flat.y), int(job["yaw"]), true, job["edits"]) > 0:
				job["made"] = int(job["made"]) + 1

		if cells.is_empty():
			_garden_jobs.erase(peer)
			_say(peer, "The garden is ready: %d beds tilled." % int(job["made"]) if int(job["mode"]) == TILL_GARDEN else "The soil is tilled: %d beds." % int(job["made"]))


# Plant (BugsList entry 6, Dave 18 Nov 2026): the picked plant goes into every usable point of the hoe's grid in one click, spaced for the plant (FarmRules.spacing_of),
# as far as the supplies go: the pack, then loose ones nearby, then nearby containers (the crafting stock). A crop seed needs a tilled bed or plot under the point;
# a bush or a tree seed open ground. Trees, large rocks and buildings make a point unusable; small loose rocks on a planted point are picked up. `a` the held
# pack slot (the hoe), `number` the item, `code` = check * 10000000 + yaw * 10000 + width * 100 + length; `check` only answers which points would take a plant
# (a hoe_verdict whose cells are 1 usable, 2 usable but beyond the supplies, 0 not). PROVISIONAL PG-1.
const PLANT_GRID_REACH_M := 12.0   # PG-1: the grid's points this far (flat) from the player take a plant in the one click


# The point of a hoe grid nearest the player, at the grid's height: a grid runs on from the crosshair, so its reach is measured to its nearest point, not its middle.
func _grid_reach_point(peer: int, at: Vector3, points: Array) -> Vector3:
	var best: Vector3 = at
	var best_d: float = INF
	var me: Vector3 = _peer_pos.get(peer, at)

	for p in points:
		var spot: Vector3 = Vector3(p.x, at.y, p.y)

		if spot.distance_to(me) < best_d:
			best_d = spot.distance_to(me)
			best = spot

	return best


func plant_grid(peer: int, inv, held_slot: int, number: int, code: int, at: Vector3) -> int:
	if inv == null or not _peer_pos.has(peer) or not at.is_finite() or not ground_height.is_valid():
		return 0

	var check: bool = code >= 10000000
	var now: int = Time.get_ticks_msec()

	if check:
		if now - int(_hoe_check_ms.get(peer, -100000)) < HOE_CHECK_MS:
			return 0

		_hoe_check_ms[peer] = now

	code = code % 10000000
	var reply := func(state: int, why: String, marks: PackedByteArray) -> void:
		_hoe_verdict(peer, Net.ACT_PLANT_GRID, code, at, state, why, marks)

		if not check and why != "":
			_say(peer, why)

	if check and _held_tool(inv, held_slot, "hoe") < 0:   # a hoe in hand; a planting click also its reach and pace (below, at the grid's nearest point)
		return 0

	var item_id: String = table.id_of(number) if number > 0 else ""
	var picked: Array = FarmRules.plantables(_crop_table(), [item_id], str(_drops.get("shrub_work", {}).get("dig_suffix", "_bush")), _tree_seed_items())

	if picked.is_empty():
		reply.call(0, "That cannot be planted.", PackedByteArray())
		return 0

	var kind: String = str(picked[0]["kind"])
	var crop_id: String = FarmRules.crop_of_seed(_crop_table(), item_id)
	var step: float = FarmRules.spacing_of(kind, _crop_table().get(crop_id, {}) if kind == "seed" else {})
	var w: int = clampi(floori(float(code % 10000) / 100.0), 1, FarmRules.GRID_MAX_SIDE)
	var d: int = clampi(code % 100, 1, FarmRules.GRID_MAX_SIDE)
	var yaw_deg: int = posmod(floori(float(code) / 10000.0), 360)
	var points: Array = FarmRules.grid_points(w, d, step, Vector2(at.x, at.z), yaw_deg)

	if not check and _hoe_ready(peer, inv, _grid_reach_point(peer, at, points), held_slot) < 0:
		return 0

	var reach: float = Vector2(float(w), float(d)).length() * step * 0.5 + 2.0
	var edits: Array = (edits_near.call(at, reach + 1.0) if edits_near.is_valid() else []) as Array
	var grid: Dictionary = _edit_buckets(edits)
	var seen: Dictionary = _till_obstacles(at, reach)
	var beds: Array = []

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and not it["struct"].has("site") and _is_plot_kind(str(it["struct"].get("kind", ""))) and Vector2(it["pos"].x - at.x, it["pos"].z - at.z).length() < reach + 2.0:
			beds.append(it)

	var stock: Dictionary = _stock_of(peer)
	var per_spot: int = maxi(int(_crop_table().get(crop_id, {}).get("sow_seeds", 1)), 1) if kind == "seed" else 1   # seeds sown in one spot (crops.json sow_seeds: a pinch, not one grain)
	var held_n: int = _stock_have(inv, number, stock)
	var have: int = ceili(float(held_n) / float(per_spot))   # the spots it sows: the last one takes what is left (a seed saved before pinches, 23 Nov 2026, still sows; no gatekeeping)
	var cells: PackedByteArray = PackedByteArray()
	var ok_spots: Array = []   # [point index, spot, bed, crop key]
	var used: Dictionary = {}
	var first_why: String = ""

	cells.resize(points.size())

	for n in points.size():
		var row: Array = _plant_point(peer, kind, item_id, points[n], grid, seen, beds, used)

		if str(row[0]) == "":
			ok_spots.append([n, row[1], row[2], row[3]])
			cells[n] = 1
		elif first_why == "":
			first_why = str(row[0])

	var feet: Vector3 = _peer_pos[peer]
	ok_spots.sort_custom(func(p, q): return Vector2(p[1].x - feet.x, p[1].z - feet.z).length() < Vector2(q[1].x - feet.x, q[1].z - feet.z).length())   # the nearest are planted first when the supplies run short

	for k in range(have, ok_spots.size()):
		cells[int(ok_spots[k][0])] = 2

	if check:
		reply.call(1 if not ok_spots.is_empty() and have > 0 else 0, first_why if ok_spots.is_empty() else ("You have none to plant." if have <= 0 else ""), cells)
		return 0

	if ok_spots.is_empty() or have <= 0:
		reply.call(0, first_why if ok_spots.is_empty() else "You have none to plant.", cells)
		return 0

	var before: Array = _snapshot(inv)
	var planted: int = 0
	var seeds_used: int = 0

	for spot in ok_spots:
		if planted >= have:
			break   # every spot's sowing is used

		var want: int = mini(per_spot, held_n - seeds_used)   # a pinch, or what is left for the last spot

		if want <= 0 or (kind != "seed" and _sapling_refusal(item_id, spot[1]) != ""):
			continue   # a point the last plant made too close, or the supplies ran out

		var took: int = _stock_take(inv, number, want, stock)
		seeds_used += took

		if took < want:
			continue

		if kind == "seed":
			_sow_cell(peer, spot[2], str(spot[3]), crop_id)
		else:
			_plant_sapling(peer, item_id, spot[1])

		planted += 1

		for stone in seen["stones"]:
			if (stone[1] as Vector2).distance_to(Vector2(spot[1].x, spot[1].z)) < 0.6 and _items.has(int(stone[0])):
				var count: int = int(_items[int(stone[0])]["count"])
				_take_in(peer, inv, int(_items[int(stone[0])]["number"]), count)
				_take_from(int(stone[0]), count)

	if planted > 0:
		_wear_slot(peer, inv, held_slot, "dig")

	_send_changes(peer, inv, before)
	_dirty = true
	reply.call(2, "", cells)
	var what: String = table.name_of(number).to_lower()

	if per_spot > 1:   # a spot takes a pinch of seed (crops.json sow_seeds)
		var spots: String = "1 spot" if planted == 1 else "%d spots" % planted
		var seeds: String = "%d %s" % [seeds_used, what.trim_suffix("s") if seeds_used == 1 else what]   # "1 wheat seed"
		_say(peer, "Sowed %s with %s." % [spots, seeds] if planted >= ok_spots.size() else "Sowed %s with %s: no more to sow." % [spots, seeds])
	else:
		_say(peer, "Planted %d %s." % [planted, what] if planted >= ok_spots.size() else "Planted %d: no more %s to plant." % [planted, what])

	return planted


# One point of a planting grid: [why it takes no plant ("" when it does), the ground spot, the bed (or {}), the bed's square metre key ("")].
func _plant_point(peer: int, kind: String, item_id: String, flat: Vector2, grid: Dictionary, seen: Dictionary, beds: Array, used: Dictionary) -> Array:
	if Vector2(_peer_pos[peer].x - flat.x, _peer_pos[peer].z - flat.y).length() > PLANT_GRID_REACH_M:
		return ["Too far away: walk closer to plant there.", Vector3.ZERO, {}, ""]

	var h: float = _bucket_height(flat.x, flat.y, grid)

	if is_nan(h):
		return ["The ground there is not ready yet.", Vector3.ZERO, {}, ""]

	var spot: Vector3 = Vector3(flat.x, h, flat.y)
	var blocked: String = _obstacle_at(seen, flat, 0.2, 0.0)

	if blocked != "":
		return [blocked, spot, {}, ""]

	var bed: Dictionary = {}
	var key: String = ""

	for it in beds:
		for cell in _bed_cells(it):
			if FarmRules.on_square(flat, Vector2(cell.x, cell.z), 0.5, float(it["struct"].get("yaw", 0.0))):
				bed = it
				key = _bed_key(cell)

	if kind != "seed":
		return ["A bush or tree goes in open ground, not in a bed.", spot, {}, ""] if not bed.is_empty() else [_sapling_refusal(item_id, spot), spot, {}, ""]

	if bed.is_empty():
		return ["Crops need tilled soil: till the ground first.", spot, {}, ""]

	if used.has(key):
		return ["That bed already takes a plant from this grid.", spot, bed, key]

	var why: String = _sow_refusal(key, item_id)

	if why == "season":
		why = _season_refusal(item_id, _bed_key_pos(key))

	if why == "":
		used[key] = true

	return [why, spot, bed, key]


# The tree seed items (drops.json trunk.felled_seeds by_species): item id -> species, for FarmRules.plantables.
func _tree_seed_items() -> Dictionary:
	var out: Dictionary = {}
	var by: Dictionary = ((_drops.get("trunk", {}) as Dictionary).get("felled_seeds", {}) as Dictionary).get("by_species", {})

	for species in by:
		if not out.has(str(by[species])):
			out[str(by[species])] = str(species)

	return out


# Why a seed cannot go into a bed's square metre `key` now ("" when it can; "season" when it is out of season, _season_refusal words it).
func _sow_refusal(key: String, seed_id: String) -> String:
	if key == "" or _crops.has(key):
		return "Something is growing there already."

	var crop_id: String = FarmRules.crop_of_seed(_crop_table(), seed_id)

	if crop_id == "":
		return "That cannot be sown."

	return "" if FarmRules.plantable_now(_crop_table(), seed_id, "seed", _season_of(_bed_key_pos(key))) else "season"   # the hoe's list greys out the same rows (farm_rules.gd)


func _season_refusal(seed_id: String, at: Vector3) -> String:
	var season: String = _season_of(at)
	var crop_id: String = FarmRules.crop_of_seed(_crop_table(), seed_id)
	var def: Dictionary = _crop_table().get(crop_id, {})
	var seasons: Array = FarmRules.sow_seasons(def).filter(func(x): return str(x) != "winter")
	var names: PackedStringArray = PackedStringArray(seasons.map(func(x): return str(x)))

	if names.is_empty():
		return "The ground is frozen hard: %s cannot be sown." % table.in_sentence(str(def.get("name", crop_id)))   # a crop the data sows only in winter
	var when: String = names[0] if names.size() == 1 else ", ".join(names.slice(0, names.size() - 1)) + " or " + names[names.size() - 1]
	if season == "winter":
		return "The ground is frozen hard: nothing can be sown in winter. Sow %s in %s." % [table.in_sentence(str(def.get("name", crop_id))), when]

	return "Not the season for %s: sow it in %s (it is %s now)." % [table.in_sentence(str(def.get("name", crop_id))), when, season]   # names when it can go in, so a summer start knows to wait or sow another


# The crop record of a seed just sown (the seed already taken).
func _sow_cell(peer: int, bed: Dictionary, key: String, crop_id: String) -> void:
	_crops[key] = {"crop": crop_id, "sown": _game_day(), "age": 0.0, "wet": 0, "day": _game_day(), "compost": false}

	if key != _bed_key(bed["pos"]):
		_crops[key]["plot"] = _bed_key(bed["pos"])   # one square metre of a plot: its moisture is the plot's
	_dirty = true
	_goal_event(peer, "seed_sown")   # ADD-05


# Water from the pack's containers on the bed (GOALS-REPAIR GA-04, A-3; garden moisture, Dave 19 Nov 2026): each pour is up to a bucket (crops.json
# moisture pour_ml, 8 L) and never more than the soil has room for; its litres become moisture over the bed's store (PlotWater.pour, the same litres as
# piped water: a 1 m bed's 8 L bucket is 32 percent, a 2 x 2 plot's 8). There is no daily limit: a soil wet through takes no more. The water comes
# first from the container in hand (`held`, the pack slot the client names, -1 for none: when named it must hold a filled container, else the pour is
# refused), then from the pack's other containers. Every refusal says why (a notice) and takes nothing.
func water_bed(peer: int, inv, bed_id: int, held: int = -1) -> bool:
	var bed: Dictionary = _bed_at(bed_id)

	if bed.is_empty() or not _peer_pos.has(peer):
		return false

	if _peer_pos[peer].distance_to(bed["pos"]) > DIG_REACH_M:
		_say(peer, "Too far from the bed to water it.")
		return false

	if _cell_key(bed, Vector3.ZERO, "crop") == "":
		_say(peer, "Nothing is growing there to water.")
		return false

	if held >= 0 and not (held < inv.slot_count and inv.numbers[held] != 0 and _container_cap(inv.numbers[held]) > 0 and inv.wear[held] > 0):   # never trust the slot the client names
		_say(peer, "That holds no water.")
		return false

	var pct: float = plot_moisture(bed["pos"])
	var per_pct: float = _plot_litres_per_pct(str(bed["struct"]["kind"]))

	if pct >= WET_THROUGH_PCT:
		_say(peer, "The soil is wet through already.")
		return false

	var room_ml: int = int(ceil((100.0 - pct) * per_pct * 1000.0))
	var ml: int = mini(mini(maxi(int(_moisture_cfg.get("pour_ml", 8000)), 1), room_ml), inv.liquid_ml())

	if ml <= 0:
		if inv.count_of(table.number_of("sea_water")) > 0:
			_say(peer, "Salt water would kill the crop. You need fresh water in a container.")
		else:
			_say(peer, "You have no water to pour.")

		return false

	inv.drain_liquid(ml, held)
	_plot_water[_bed_key(bed["pos"])] = [PlotWater.pour(pct, float(ml) / 1000.0, per_pct), float(game_seconds.call()) if game_seconds.is_valid() else 0.0]
	_water_dirty = _water_dirty or not _water_kind.is_empty()   # a piped plot's room changed
	_dirty = true
	return true


# Compost on the bed: +20 percent growth for this crop. When the "fertiliser" ingredient group exists (Jamie, Part C: compost or bonemeal),
# any of its members does; the pack's has/remove follow the group.
func compost_bed(_peer: int, inv, bed_id: int) -> bool:
	var bed: Dictionary = _bed_at(bed_id)
	var crop: Dictionary = {}

	for cell in (_bed_cells(bed) if not bed.is_empty() else []):
		var here: Dictionary = _crops.get(_bed_key(cell), {})

		if not here.is_empty() and not bool(here["compost"]):
			crop = here   # the first crop of the bed not composted yet
			break

	var compost: int = table.number_of("fertiliser") if table.number_of("fertiliser") > 0 else table.number_of("compost")

	if crop.is_empty() or bool(crop["compost"]) or compost <= 0 or not inv.has(compost, 1):
		return false

	inv.remove(compost, 1)
	crop["compost"] = true
	_dirty = true
	return true


# A bed's world-row extra: {"moist": its soil moisture percent in MOIST_STEP_PCT steps} for every bed (garden moisture, Dave 19 Nov 2026), with
# "crop": crop id and "stage": 0 to 3 when a crop grows on it; {} for any other piece (no protocol bump: PROTOCOL.md, row extras).
# A plot of several square metres adds "cells": [[crop id or "", stage or -1]] in _bed_cells order, and its "crop" and "stage" name what E does next: the first ripe
# crop, else its first crop (a square metre still empty does not hide the others from E's watering: only the hoe's Plant grid sows, 19 Nov 2026).
func crop_row_extra(it: Dictionary) -> Dictionary:
	if not _is_plot_kind(str(it["struct"].get("kind", ""))) or it["struct"].has("site"):
		return {}

	var pct: float = plot_moisture(it["pos"])
	var moist: int = 100 if pct >= WET_THROUGH_PCT else floori(pct / float(MOIST_STEP_PCT)) * MOIST_STEP_PCT   # rounded down: "25" is a wet day, "100" takes no more water
	var cells: Array = _bed_cells(it)

	if cells.size() == 1:
		var crop: Dictionary = _crops.get(_bed_key(it["pos"]), {})
		return {"moist": moist} if crop.is_empty() else {"crop": str(crop["crop"]), "stage": crop_stage(crop), "moist": moist}

	var rows: Array = []
	var ripe: Array = []
	var first: Array = []

	for cell in cells:
		var crop: Dictionary = _crops.get(_bed_key(cell), {})
		rows.append(["", -1] if crop.is_empty() else [str(crop["crop"]), crop_stage(crop)])

		if not crop.is_empty() and ripe.is_empty() and crop_stage(crop) >= 3:
			ripe = rows[rows.size() - 1]

		if not crop.is_empty() and first.is_empty():
			first = rows[rows.size() - 1]

	if first.is_empty():
		return {"moist": moist}

	var shown: Array = ripe if not ripe.is_empty() else first
	return {"crop": shown[0], "stage": shown[1], "cells": rows, "moist": moist}


# The stage of a crop 0 seedling .. 3 ripe; a crop short of water stays at 2.
func crop_stage(crop: Dictionary) -> int:
	var def: Dictionary = _crop_table().get(str(crop["crop"]), {})
	var days: float = maxf(float(def.get("grow_days", 100)), 1.0)
	var stage: int = mini(int(floor(float(crop["age"]) / days * 4.0)), 3)

	if stage >= 3 and int(crop["wet"]) < int(ceil(float(def.get("water_per_day", 0.0)) * days)):
		return 2

	return stage


# Looks at the clock once per game day: a bed holding wet_min_pct of moisture (plot_water.gd: rain fills it, a pour adds to it, the weather dries it)
# makes it a wet day, and a dry day grows the crop only dry_growth of a day; winter pauses growth (turnip excepted) and kills a seedling.
func _crops_tick() -> void:
	_plots_tick()

	if _crops.is_empty():
		return

	var today: int = _game_day()

	for key in _crops.keys():
		var crop: Dictionary = _crops[key]
		var def: Dictionary = _crop_table().get(str(crop["crop"]), {})

		while int(crop["day"]) < today:
			crop["day"] = int(crop["day"]) + 1
			var winter: bool = _season_of(_bed_key_pos(key)) == "winter" and not bool(def.get("grows_in_winter", str(crop["crop"]) == "turnip"))   # data flag grows_in_winter; turnip by default

			if winter:
				if crop_stage(crop) == 0 and not bool(def.get("overwinters", false)):   # overwinters (data): winter wheat, rye and autumn onions sit out the frost as seedlings and grow on in spring
					_crops.erase(key)   # frost kills a seedling
					_dirty = true
					break

				continue

			var wet: bool = PlotWater.is_wet(_moisture_cfg, float((_plot_water.get(str(crop.get("plot", key)), [float(_moisture_cfg.get("start_pct", 50.0))]) as Array)[0]))   # a plot's square metre: the plot's moisture
			crop["age"] = float(crop["age"]) + (1.2 if bool(crop["compost"]) else 1.0) * PlotWater.day_growth(_moisture_cfg, wet)   # a dry day grows it dry_growth of a day

			if wet:
				crop["wet"] = int(crop["wet"]) + 1

			_dirty = true


# E on a ripe crop: its yields (half without the right tool), seeds back, and the bed is empty again. Returns true when something was harvested.
func harvest(peer: int, inv, bed_id: int, at: Vector3 = Vector3.ZERO) -> bool:
	var bed: Dictionary = _bed_at(bed_id)

	if bed.is_empty() or not _peer_pos.has(peer):
		return false

	if _peer_pos[peer].distance_to(bed["pos"]) > DIG_REACH_M:
		_say(peer, "Too far from the bed to harvest it.")
		return false

	var key: String = _cell_key(bed, at, "ripe")

	if key == "":
		key = _cell_key(bed, at, "crop")   # nothing ripe: say why for the first crop

	var crop: Dictionary = _crops.get(key, {})

	if crop.is_empty():
		_say(peer, "Nothing is growing there to harvest.")
		return false

	if crop_stage(crop) < 3:
		var grow_def: Dictionary = _crop_table().get(str(crop["crop"]), {})
		var stalled: bool = int(floor(float(crop["age"]) / maxf(float(grow_def.get("grow_days", 100)), 1.0) * 4.0)) >= 3   # old enough to ripen (crop_stage's own sum): it holds at 2 for want of wet days
		var dry: bool = not PlotWater.is_wet(_moisture_cfg, float((_plot_water.get(str(crop.get("plot", key)), [float(_moisture_cfg.get("start_pct", 50.0))]) as Array)[0]))

		if stalled:
			_say(peer, "It has stopped growing: it needs more wet days. Keep the bed watered and it will ripen.")   # it waits for wet days and nothing else said so
		else:
			_say(peer, "It is not ripe yet. The soil is dry: water it and it grows faster." if dry else "It is not ripe yet.")   # a dry bed grows at half pace
		return false

	var def: Dictionary = _crop_table().get(str(crop["crop"]), {})
	var tool_class: String = str(def.get("tool_to_harvest", "hand"))
	var full: bool = tool_class == "hand" or _has_tool(inv, tool_class)

	if not full and tool_class == "sickle" and _has_tool(inv, "scythe"):
		tool_class = "scythe"   # the scythe reaps grain as the sickle does (master s2.1: "large-area harvesting")
		full = true
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(key) ^ int(crop["sown"])

	for row in def.get("yields", []):
		var n: int = int(row[1]) if full else maxi(int(ceil(float(row[1]) / 2.0)), 1)
		give(peer, table.number_of(str(row[0])), n)

	var back: Array = def.get("seeds_back", [])

	if back.size() == 2:
		give(peer, table.number_of(str(back[0])), roll_amount(peer, rng, int((back[1] as Array)[0]), int((back[1] as Array)[1])))

	if fate(peer, "garden_worm", float((_crops_file_extra.get("worm", {}) as Dictionary).get("chance", 0.0))):
		give(peer, table.number_of(str(_crops_file_extra["worm"].get("item", "worm"))), 1)   # gardens breed worms (Dave 14 Nov 2026: about 20 from 100 crops)

	if full and tool_class != "hand" and swath_mult <= 0.0:
		_wear_tool(peer, inv, tool_class, "gather")   # a sickle or scythe swing wore the tool in hand once for the whole circle (swath_swing)

	_crops.erase(key)
	_dirty = true
	_goal_event(peer, "crop_harvested")   # ADD-06: a ripe crop taken by hand from the bed (Dave 14 Nov: gathering counts by your own hand)
	return true


# Sickle and scythe (Dave 18 Nov 2026, BugsList_Current.md entry 7; drops.json "swath"): one left-click swing with the tool in hand (held_slot, the pack
# slot the client names) checks the tool and the swing pace, wears it once and harvests every ripe grain crop (swath crops) on a bed within the tool's
# radius of the player, at the full yield. Answers {"tool", "radius", "mult", "grasses", "crops"} for the plants the caller then cuts (terrain_server
# _on_cut_swath_requested: grasses gathered with gather() times mult, bushes cut down), or {} when the swing is refused (the player is told why).
func swath_swing(peer: int, held_slot: int) -> Dictionary:
	var inv = inventory_of(peer)

	if inv == null or not _peer_pos.has(peer):
		return {}

	var tool_class: String = ""

	for reaper in ["sickle", "scythe"]:
		if _held_tool(inv, held_slot, reaper) >= 0:
			tool_class = reaper

	if tool_class == "":
		var in_hand: String = str(table.entry(table.id_of(inv.numbers[held_slot])).get("tool_class", "")) if held_slot >= 0 and held_slot < inv.slot_count else ""
		_swing_tool(peer, inv, held_slot, in_hand if in_hand == "scythe" else "sickle")   # says why: broken, hands full, or no sickle in hand
		return {}

	var cfg: Dictionary = _drops.get("swath", {})
	var tool_cfg: Dictionary = cfg.get("tool_" + tool_class, {})
	var now: int = Time.get_ticks_msec()

	if now - int(_swath_ms.get(peer, -100000)) < int(tool_cfg.get("swing_ms", 600)):
		return {}

	_swath_ms[peer] = now
	_wear_slot(peer, inv, held_slot, "swath")   # one wear a swing, whatever it cuts; holds the tool's effort (exertion.json tool_effort)
	var radius: float = float(tool_cfg.get("radius_m", 1.5))
	var material: String = str(table.entry(table.id_of(inv.numbers[held_slot])).get("material", ""))
	var grains: Array = cfg.get("crops", [])
	var here: Vector3 = _peer_pos[peer]
	var crops: int = 0

	for id in _ids_near(here, radius + DIG_REACH_M):
		var bed: Dictionary = _bed_at(int(id))

		if bed.is_empty():
			continue

		for cell in _bed_cells(bed):
			var crop: Dictionary = _crops.get(_bed_key(cell), {})

			if crop.is_empty() or not grains.has(str(crop["crop"])) or crop_stage(crop) < 3 or Vector2(cell.x - here.x, cell.z - here.z).length() > radius:
				continue   # unripe grain stays standing; other crops are left for E

			swath_mult = 1.0   # quiet, and no hand pace; a crop's yield is the full one, not raised by the tier

			if harvest(peer, inv, int(id), cell):
				crops += 1

			swath_mult = 0.0

	return {"tool": tool_class, "radius": radius, "mult": float((cfg.get("yield", {}) as Dictionary).get(material, 1.0)), "grasses": cfg.get("grasses", []), "crops": crops}


# Lights (wall torch: a stick, chandelier: a candle, fireplace: firewood; structures.json fuel and fuel_s = burning seconds per fuel item, topped up to twice that). Lit lights count
# for comfort; the flag and the fuel left live on the placed row and burn down on the slow tick (not saved: a restart puts them out).
func _light_fixture(peer: int, inv, it: Dictionary, def: Dictionary) -> void:
	var fuel: int = table.number_of(str(def.get("fuel", "")))
	var burn: float = light_burn_s(def)
	var left: float = float(it["struct"].get("fuel_left", 0.0)) if bool(it["struct"].get("lit", false)) else 0.0

	if fuel <= 0 or not inv.has(fuel, 1):
		_say(peer, "You need %s to light that." % table.sentence_name(fuel) if fuel > 0 else "It cannot be lit.")
		return

	if left + burn > burn * 2.0:
		_say(peer, "It is burning well already.")
		return

	inv.remove(fuel, 1)
	it["struct"]["lit"] = true
	it["struct"]["fuel_left"] = left + burn
	_dirty = true
	_say(peer, "It burns.")


# How long one of a light's fuel items burns (buildables plan, batch B4: burn times in game days): structures.json fuel_days game days
# (BuildingWear.GAME_DAY_S, 1 game day = 1 real hour), else fuel_s seconds. A candle, lamp oil or tallow is just the row's "fuel" item.
func light_burn_s(def: Dictionary, fallback_s: float = 1800.0) -> float:
	if def.has("fuel_days"):
		return float(def["fuel_days"]) * BuildingWear.GAME_DAY_S

	return float(def.get("fuel_s", fallback_s))


# The lit lights (and the fuel each has left) are saved beside the world items in lights.json as [x, y, z, fuel_left, char] and put back on the structures at those spots after a load.
func _light_rows_save() -> Array:
	return _light_rows_of(_items, _kind_info_now())

func _apply_lit_rows(rows: Array) -> void:
	for row in rows:
		if typeof(row) != TYPE_ARRAY or (row as Array).size() < 4:
			continue

		var spot := Vector3(float(row[0]), float(row[1]), float(row[2]))

		for id in _items:
			var it: Dictionary = _items[id]

			var lit_def: Dictionary = _structures.get(str(it["struct"].get("kind", "")), {}) if it.has("struct") else {}

			if it.has("struct") and it["pos"].distance_to(spot) <= 0.3 and str(lit_def.get("use", "")) == "light":
				it["struct"]["lit"] = true
				it["struct"]["fuel_left"] = float(row[3])

				if (row as Array).size() > 4 and (typeof(row[4]) == TYPE_FLOAT or typeof(row[4]) == TYPE_INT) and float(row[4]) > 0.0:
					it["struct"]["char"] = clampf(float(row[4]), 0.0, 1.0)   # under one lump: whole lumps were dropped as made

				break


func _lights_tick(spent: float) -> void:
	for id in _tick_list("lit"):   # a light that burns wood may drop charcoal (a new world item) on this pass
		if not _items.has(id):
			continue   # gone since the list was made

		var it: Dictionary = _items[id]

		if it.has("struct") and bool(it["struct"].get("lit", false)):
			var lit_def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

			if str(lit_def.get("use", "")) == "kiln":   # a Kiln burns its logs to charcoal, not a fuel_left
				_kiln_burn(int(id), it, lit_def, spent)
				continue

			if _smelters.is_smelter(lit_def):   # a Smelter burns its hopper fuel as it smelts (server_smelter.tick), not a fuel_left
				continue

			# A torch out in the open rain goes out like an open fire (Dave, 4 Nov 2026); one under a crown, a roof or an overhang burns on.
			if _rain_here(it["pos"]) >= FlameRules.RAIN_DOUSE and bool(_structures.get(str(it["struct"]["kind"]), {}).get("rain_douses", false)) and not (cover_at.is_valid() and float(cover_at.call(it["pos"] + Vector3(0.0, 0.5, 0.0))) > 0.5):
				it["struct"]["lit"] = false
				it["struct"].erase("fuel_left")
				_dirty = true
				continue

			var burnt: float = spent

			# An open log fire (a brazier) burns on in heavy rain, faster (structures.json note_fire_lights; as the large campfire on its coals).
			if lit_def.has("rain_burn_x") and _rain_here(it["pos"]) >= float(lit_def.get("rain_burn_from", 0.6)) and not (cover_at.is_valid() and float(cover_at.call(it["pos"] + Vector3(0.0, 0.5, 0.0))) > 0.5):
				burnt *= float(lit_def["rain_burn_x"])

			if bool(lit_def.get("leaves_charcoal", false)):
				_light_leave_charcoal(it, lit_def, minf(burnt, float(it["struct"].get("fuel_left", 0.0))))

			it["struct"]["fuel_left"] = float(it["struct"].get("fuel_left", 0.0)) - burnt

			if float(it["struct"]["fuel_left"]) <= 0.0:
				it["struct"]["lit"] = false
				it["struct"].erase("fuel_left")


# --- Comfort and the Rested buff (docs/COMFORT_DESIGN.md, data/items/comfort.json; Sal's design, Tyler 31 Oct 2026) ---
# comfort_at(peer): 0 when not sheltered; else 1 for the shelter plus the points of every DIFFERENT comfort kind within radius_m (9 m) and height_m (3 m) of the player, each kind
# once, only the best bed and the best grade of each graded family (a kind with a "grade" and "family": chair, table, bench; master s3.5), fires/torches/chandeliers only while lit, clamped to max_level (20). A placed structure counts by its structures.json `comfort` id (or its own kind
# when comfort.json has a kind of that name: rough_bed, workbench, chest ...); lit fires count as `campfire`, a clay hearth as lit when a lit fire burns within 3 m.
# The level found here is the furniture the comfort meter counts (comfort_points, below). The old Rested buff (retired 23 Nov 2026 by the meter) was: earned by resting at comfort 2 or more; lasted 45 REAL minutes; the tier
# (health regeneration, exhaustion, hunger and thirst, action speed, skill gain, cold) is the highest whose min_level is reached when earned; a rest at an equal or higher level
# refreshes it, a lower one leaves it alone; saved in characters.json "rested" {level, until (unix seconds)}; cleared by death. Hooks built: health regeneration (the larger of the
# bed's and the buff's, never the product), hunger and thirst drain, skill gain, energy drain. Action speed (cooldowns and craft time, _pace_factor) and cold stress (warmth_target) are built too; the HUD line and its tooltip come with protocol 80 and 81. Not built: HUD icons.
var _comfort_cfg: Dictionary = {}
var _comfort_loaded: bool = false
var _comfort_cache: Dictionary = {}     # peer -> {"at": msec, "data": comfort_at result}


func _comfort_data() -> Dictionary:
	if not _comfort_loaded:
		_comfort_loaded = true
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/comfort.json"))
		_comfort_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {}

	return _comfort_cfg


func _comfort_kind(id: String) -> Dictionary:
	for row in _comfort_data().get("kinds", []):
		if str(row["id"]) == id:
			return row

	return {}


func comfort_at(peer: int, force: bool = false) -> Dictionary:
	var cfg: Dictionary = _comfort_data()
	var out: Dictionary = {"level": 0, "sheltered": false, "items": [], "missing": []}

	if cfg.is_empty() or not _peer_pos.has(peer):
		return out

	var now: int = Time.get_ticks_msec()
	var cached: Dictionary = _comfort_cache.get(peer, {})

	if not force and not cached.is_empty() and now - int(cached["at"]) < int(float(cfg.get("recheck_s", 1.5)) * 1000.0):
		return cached["data"]

	var here: Vector3 = _peer_pos[peer]
	var sheltered: bool = cover_at.is_valid() and float(cover_at.call(here)) > 0.0
	out["sheltered"] = sheltered

	if not sheltered:
		_comfort_cache[peer] = {"at": now, "data": out}
		return out

	var radius: float = float(cfg.get("radius_m", 9.0))
	var height: float = float(cfg.get("height_m", 3.0))
	var found: Dictionary = {}     # comfort kind id -> true (each kind once)

	for id in _ids_near(here, radius):   # the sync grid's cells near the player, not every record (the meter reads this for every sheltered player)
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]
		var pos: Vector3 = it["pos"]

		if Vector2(pos.x - here.x, pos.z - here.z).length() > radius or absf(pos.y - here.y) > height:
			continue

		var kind_id: String = ""

		if it.has("fire"):
			if fire_is_lit(int(it["fire"]["state"])):
				kind_id = "campfire"
		elif it.has("struct"):
			var skind: String = str(it["struct"].get("kind", ""))
			var row: Dictionary = _structures.get(skind, {})
			kind_id = str(row.get("comfort", skind))

			if not _comfort_kind(kind_id).is_empty() and bool(_comfort_kind(kind_id).get("needs_lit", false)):
				if kind_id == "clay_hearth":
					kind_id = "clay_hearth" if _comfort_lit_fire_near(pos, 3.0) else ""
				elif not bool(it["struct"].get("lit", false)):
					kind_id = ""   # torches, chandeliers and fireplaces count only while lit

		if kind_id != "" and not _comfort_kind(kind_id).is_empty():
			found[kind_id] = true

	var level: int = int(cfg.get("shelter", {}).get("points", 1))
	var best_bed: int = 0
	var best_graded: Dictionary = {}   # family -> [kind id, points]: four chair grades never stack (comfort.json rules.best_grade_counts)
	var items: Array = []

	for kind_id in found:
		var kind: Dictionary = _comfort_kind(kind_id)
		var points: int = int(kind["points"])

		if str(kind.get("class", "")) == "bed":
			best_bed = maxi(best_bed, points)
			continue

		if kind.has("grade"):
			if points > int(best_graded.get(str(kind["family"]), ["", 0])[1]):
				best_graded[str(kind["family"])] = [kind_id, points]
			continue

		level += points
		items.append([kind_id, points, bool(kind.get("needs_lit", false))])

	for family in best_graded:
		level += int(best_graded[family][1])
		items.append([best_graded[family][0], best_graded[family][1], false])

	level += best_bed

	if best_bed > 0:
		items.append(["bed", best_bed, false])

	out["level"] = clampi(level, 0, int(cfg.get("max_level", 20)))
	out["items"] = items
	_comfort_cache[peer] = {"at": now, "data": out}
	return out


# The quarter-second work of the world: fires, rot, crafting, crops, water, lights, smelters, comfort, goals, traps and item lifetimes. The night
# skip runs it again in one-minute steps so the skipped hours really pass for them (night_skip_step).
func _slow_tick(spent: float, t0: int, traps: bool = true) -> void:
	_tick_ids = _tick_index()
	_rot(spent)
	_slow_mark("rot", t0)
	_fires(spent)
	_slow_mark("fires", t0)
	_craft_tick(spent)
	_sharpen_tick(spent)
	_slow_mark("craft", t0)
	_fall_tick(spent)
	_slow_mark("falls", t0)
	_crops_tick()
	_garden_jobs_tick()
	_water_tick(spent)
	_bog_holes_tick()
	_slow_mark("crops-water", t0)
	_lights_tick(spent)
	_smelters.tick_all(spent)
	_dev_pending_tick(spent)
	_camp_fire_tick()
	_tribe_props_tick()
	_slow_mark("lights-dev", t0)
	_comfort_tick(spent)
	_slow_mark("comfort", t0)
	_goals_tick(false)   # the goals themselves: _goals_spread, every frame
	_slow_mark("goals " + _goals_detail, t0)
	_learn_clock += spent

	if _learn_clock >= LEARN_TICK_S:
		_learn_clock = 0.0
		_learn_tick()

	_slow_mark("learn", t0)
	_fish_tick()
	_slow_mark("fish", t0)
	_remains_tick(spent)
	_slow_mark("remains", t0)
	_spoil_tick(spent)
	_wood_tick(spent)
	_slow_mark("spoil", t0)
	if traps:
		_traps.tick(spent)   # a night skip ticks them once at dawn instead (night_skip_finish): a near trap needs an hour away to roll

	_autoload_tick(spent)
	_slow_mark("learn-fish-remains-spoil-traps", t0)

	_expire_items(spent)
	_tick_ids = {}


# --- Skipping the night (Dave 24 Nov 2026: "if its night time and everyone on the server lays down and goes to sleep the server should pass the
# night straight to dawn and everyone wakes up immediately refreshed"; the coordinator's picks the same day). When every connected player (absent ones
# left out) has been asleep for NIGHT_SKIP_AFTER_S, bed or ground, collapsed from exhaustion or passed out from cold, night_skip asks the server's
# clock whether it is night at every sleeper's spot (terrain_server.gd); if so the hours to the latest sleeper's sunrise really pass, a minute of
# real time per frame (night_skip_step: the slow tick and every player's vitals, so fires burn down, food cooks, crops grow, hunger and thirst drain
# at the sleep rate), and then everyone wakes at once, refreshed: energy full, no strain (night_skip_finish).
const NIGHT_SKIP_AFTER_S := 3.0
const NIGHT_SKIP_STEP_S := 60.0          # real seconds of world time per catch-up frame (24 game minutes)
var night_skip: Callable                # (peers: Array) -> float: the real seconds to pass to reach dawn, 0 when it is not night for all of them
var _all_asleep: bool = false           # every counted player asleep since _all_asleep_since
var _all_asleep_since: int = 0          # msec when the last of them fell asleep
var _night_skip_tried: int = -100000    # msec of the last ask (once a second while everyone sleeps)
var _night_left: float = 0.0            # real seconds of the night still to pass; > 0 while skipping
var _night_sleepers: Array = []
var _night_aborted: bool = false       # the skip stopped short (no sleeper left asleep): nobody is told it is dawn


# Game hours from `hour` to the latest of the sleepers' sunrises, when it is night for every one of them (before their sunrise or after their
# sunset, which is as far after noon as sunrise is before it); 0 when it is daylight for any of them, or a polar day or night (no dawn).
static func night_to_dawn_h(hour: float, sunrises: Array) -> float:
	var most: float = 0.0

	for sunrise in sunrises:
		var sr: float = float(sunrise)

		if sr <= 0.05 or sr >= 11.95 or (hour >= sr and hour <= 24.0 - sr):
			return 0.0

		most = maxf(most, fposmod(sr - hour, 24.0))

	return most


func _skip_counted() -> Array:
	var out: Array = []

	for peer in _peer_key:
		if _parked.has(peer) or vitals_of(peer).is_empty():
			continue

		out.append(peer)

	return out


func _night_skip_check() -> void:
	if _night_left > 0.0 or not night_skip.is_valid():
		return

	var peers: Array = _skip_counted()
	var all: bool = not peers.is_empty()

	for peer in peers:
		if not (_asleep.has(peer) or _cold_out.has(peer)):
			all = false
			break

	var now: int = Time.get_ticks_msec()

	if not all:
		_all_asleep = false
		return

	if not _all_asleep:
		_all_asleep = true
		_all_asleep_since = now

	if now - _all_asleep_since < int(NIGHT_SKIP_AFTER_S * 1000.0) or now - _night_skip_tried < 1000:
		return

	_night_skip_tried = now
	var real_s: float = float(night_skip.call(peers))

	if real_s > 0.0:
		_night_left = real_s
		_night_sleepers = peers.duplicate()
		print("night skip: %d asleep, %.0f real s (%.1f game h) to pass" % [peers.size(), real_s, real_s * GAME_RATE / 3600.0])   # a server log line


func night_skipping() -> bool:
	return _night_left > 0.0


# One catch-up frame: up to NIGHT_SKIP_STEP_S real seconds of the world's slow work and every player's vitals. The caller has already moved the
# clock by the same amount. Returns the real seconds passed (0 when no skip is running).
func night_skip_step() -> float:
	if _night_left <= 0.0:
		return 0.0

	var present: Array = _night_sleepers.filter(func(p): return _peer_key.has(p) and (_asleep.has(p) or _cold_out.has(p)))

	if present.is_empty():
		_night_left = 0.0   # every sleeper left or woke: the skip stops where it is (the caller still tells the clients the clock)
		_night_aborted = true
		return 0.0

	var step: float = minf(_night_left, NIGHT_SKIP_STEP_S)
	_night_left -= step
	_slow_tick(step, Time.get_ticks_usec(), false)
	_vitals_tick(step, present)   # only the sleepers: a player who joined during the skip is not charged the night
	return step


# The night has passed: everyone who slept through it wakes at once, refreshed (energy full, no strain, as waking rested on a good bed).
func night_skip_finish() -> void:
	_night_left = 0.0
	_all_asleep = false
	_traps.tick(float(_traps.cfg.get("check_s", 30.0)))   # the night's catches, rolled once now that the hours have passed

	for peer in _night_sleepers:
		if _night_aborted or not _peer_key.has(peer):
			continue

		var v: Dictionary = vitals_of(peer)

		if not v.is_empty():
			v["energy"] = 100.0
			_strain[peer] = {"s": 0.0, "state": 0, "t": 0.0}

		if _asleep.has(peer):
			var rest: Dictionary = _asleep[peer]

			if not rest.has("night") and not bool(rest.get("nap", false)) and _peer_pos.has(peer) and (_bed_of(peer) != 0 or _shelter_near(_peer_pos[peer]) >= 0):
				_goal_event(peer, "slept_night")   # a night slept, as a full sleep on a bed or by a shelter counts (ADD-12)

			_end_sleep(peer)

		_strain_sent.erase(peer)
		_say(peer, "The night passes. You wake at dawn, refreshed.")
		_sync_vitals(peer, true)
		_sync_energy(peer, true)

	_night_sleepers = []
	_night_aborted = false
	save_soon()


# --- The comfort meter (Dave 23 Nov 2026; comfort.json meter, docs/COMFORT_DESIGN.md s11). It replaces the timed Rested buff. ---
# Always on, 0 to meter.max (10), kept in characters.json "comfort". comfort_points adds up what the player has now (shelter, a fire's warmth,
# food and water, a bed, clothes, furniture nearby); the meter climbs toward that target and drifts down by what they do. The bonus is the whole
# level x 10 percent of meter.full_bonus. rested_tier returns those scaled multipliers so every old Rested hook (regen, energy, hunger and thirst,
# action pace, skill gain, cold) reads the meter; hurt and strain read comfort_bonus. All per player, per slow tick, with no scan of the world
# beyond comfort_at's own cached look (1.5 s).
var _by_fire: Dictionary = {}           # peer -> within a lit fire's heat reach (_update_soak)
var _comfort_goal: Dictionary = {}      # peer -> the target worked out on the last vitals tick


func _meter_cfg() -> Dictionary:
	return _comfort_data().get("meter", {})


func comfort_meter(peer: int) -> float:
	return clampf(float(_characters.get(_peer_key.get(peer, ""), {}).get("comfort", 0.0)), 0.0, float(_meter_cfg().get("max", 10)))


# The whole level shown on screen; the bonus follows it.
func comfort_level(peer: int) -> int:
	return int(floor(comfort_meter(peer) + 0.0001))


# A full_bonus multiplier scaled by the level: 1.0 at 0, the full value at max, in a straight line.
func comfort_bonus(peer: int, what: String) -> float:
	var cfg: Dictionary = _meter_cfg()

	if cfg.is_empty():
		return 1.0

	return lerpf(1.0, float(cfg.get("full_bonus", {}).get(what, 1.0)), float(comfort_level(peer)) / maxf(float(cfg.get("max", 10)), 1.0))


# The points the meter climbs toward: [[name, points, has it], ...] in the order the tooltip lists them.
func comfort_points(peer: int) -> Array:
	var pts: Dictionary = _meter_cfg().get("points", {})
	var v: Dictionary = vitals_of(peer)
	var out: Array = []

	if pts.is_empty() or v.is_empty() or not _peer_pos.has(peer):
		return out

	var sheltered: bool = _vitals_cover(_peer_pos[peer]) > 0.0
	var food: float = float(v.get("fed", 0.0)) / maxf(float(_vitals_cfg.get("stomach_cap_kcal", 2400)), 1.0)
	var water: float = float(v.get("wet", 0.0)) / maxf(float(_vitals_cfg.get("thirst", {}).get("cap_ml", 2400)), 1.0)
	var dressed: bool = false
	var fine: bool = true

	if vitals_memo:
		var dress: Dictionary = _dress_of(peer)
		dressed = bool(dress["dressed"])
		fine = bool(dress["fine"])
	else:
		var covered: Dictionary = {}   # body, legs, feet -> true when worn

		for number in worn_of(peer):
			if number <= 0:
				continue

			var entry: Dictionary = table.entry(table.id_of(number))
			var slot: String = str(entry.get("slot", ""))

			if slot in ["body", "legs", "feet"]:
				covered[slot] = true
				fine = fine and str(entry.get("fabric", "")) != "plant"

		dressed = covered.size() == 3
	var furniture: int = 0
	var names: PackedStringArray = PackedStringArray()

	if sheltered:
		for row in comfort_at(peer)["items"]:
			if str(row[0]) != "bed" and str(_comfort_kind(str(row[0])).get("class", "")) != "fire":
				furniture += int(row[1])
				names.append(_comfort_name(str(row[0])))

	out.append(["Sheltered (a lean-to, a roof or a tree)", int(pts.get("sheltered", 1)), sheltered])
	out.append(["Warmed by a fire", int(pts.get("by_fire", 1)), bool(_by_fire.get(peer, false))])
	out.append(["Food above 25%", int(pts.get("food_over_25", 1)), food > 0.25])
	out.append(["Food above 50%", int(pts.get("food_over_50", 1)), food > 0.5])
	out.append(["Water above 50%", int(pts.get("water_over_50", 1)), water > 0.5])
	out.append(["Lying on a bed", int(pts.get("on_bed", 1)), on_good_bed(peer)])
	out.append(["Dressed (body, legs and feet)", int(pts.get("dressed", 1)), dressed])
	out.append(["Dressed in better than fibre", int(pts.get("dressed_fine", 1)), dressed and fine])
	var most: int = int(pts.get("furniture_max", 2))
	out.append(["Furniture nearby, sheltered" + (": " + ", ".join(names) if not names.is_empty() else " (a seat, a table, a rug, a lit torch)"), mini(furniture, most) if furniture > 0 else most, furniture > 0])
	return out


func comfort_target(peer: int) -> float:
	var total: int = 0

	for row in comfort_points(peer):
		if bool(row[2]):
			total += int(row[1])

	return clampf(float(total), 0.0, float(_meter_cfg().get("max", 10)))


func _comfort_resting(peer: int) -> bool:
	return _asleep.has(peer) or (int(_stance.get(peer, 0)) >= 2 and not crawling_of(peer))


# Lying and moving: the stealthy crawl (Dave, QA #10, 25 Nov 2026), set from the position reports. A crawler is working, not resting: no lying
# recovery of energy, strain or comfort while it lasts.
func crawling_of(peer: int) -> bool:
	return _crawling.has(peer)


# The meter moves a little each slow tick: toward the target, slowly; falling faster for running, wet clothes and cold.
func _comfort_meter_tick(peer: int, v: Dictionary, spent: float) -> void:
	var cfg: Dictionary = _meter_cfg()
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})

	if cfg.is_empty() or row.is_empty():
		return

	var m: float = comfort_meter(peer)
	var target: float = comfort_target(peer)
	_comfort_goal[peer] = target   # the HUD tick reads it (no second cover look)
	var minutes: float = spent / 60.0
	var resting: bool = _comfort_resting(peer)

	if m < target:
		m = minf(m + float(cfg.get("rise_per_min", 1.0)) * (float(cfg.get("rise_rest_mult", 2.0)) if resting else 1.0) * minutes, target)
	elif m > target:
		var rate: float = float(cfg.get("fall_per_min", 0.15))

		if resting:
			rate *= float(cfg.get("fall_rest_mult", 0.4))
		else:
			rate *= lerpf(1.0, float(cfg.get("fall_run_mult", 2.5)), clampf((exertion_of(peer) - 0.4) / 0.6, 0.0, 1.0))   # walking (0.4) is the base, running (1.0) the most

		rate *= lerpf(1.0, float(cfg.get("fall_wet_mult", 1.5)), clampf(float(v.get("soak", _soak.get(peer, 0.0))), 0.0, 1.0))

		if cold_stage(peer) >= 1:
			rate *= float(cfg.get("fall_cold_mult", 1.5))

		m = maxf(m - rate * minutes, target)

	var before: int = comfort_level(peer)
	row["comfort"] = m
	_rested_cache.erase(peer)   # the Rested row follows the meter

	if comfort_level(peer) != before:
		_dirty = true   # saved when the whole level changes; the fraction rides along with the next write


# The old Rested hooks read the meter: {} at level 0, else the full_bonus multipliers scaled by the level.
func rested_tier(peer: int) -> Dictionary:
	if _in_vitals and vitals_memo and _rested_cache.has(peer):
		return _rested_cache[peer]   # callers only read it

	var level: int = comfort_level(peer)
	var full: Dictionary = _meter_cfg().get("full_bonus", {})
	var out: Dictionary = {}

	if level > 0 and not full.is_empty():
		out = {"name": "Comfort %d" % level, "level": level}

		for what in full:
			out[what] = comfort_bonus(peer, str(what))

	if _in_vitals:
		_rested_cache[peer] = out

	return out


# The tooltip of the comfort meter: the bonus now, what counts and what is missing.
func comfort_tip(peer: int) -> String:
	var lines: PackedStringArray = PackedStringArray()
	var level: int = comfort_level(peer)
	var mx: int = int(_meter_cfg().get("max", 10))
	var target: int = int(_comfort_goal.get(peer, comfort_target(peer)))
	lines.append("Comfort %d of %d (heading for %d)" % [level, mx, target])

	if level > 0:
		lines.append("Bonus %d%%:" % int(round(float(level) * 100.0 / float(maxi(mx, 1)))))
		lines.append("  health counts x%.1f" % (1.0 / maxf(comfort_bonus(peer, "damage_taken_mult"), 0.01)))
		lines.append("  exertion and tiredness build %d%% slower" % int(round((1.0 - comfort_bonus(peer, "exhaustion_mult")) * 100.0)))
		lines.append("  food and water last x%.1f" % (1.0 / maxf(comfort_bonus(peer, "hunger_thirst_mult"), 0.01)))
	else:
		lines.append("No bonus yet.")

	var have: PackedStringArray = PackedStringArray()
	var missing: PackedStringArray = PackedStringArray()

	for row in comfort_points(peer):
		(have if bool(row[2]) else missing).append("  +%d  %s" % [int(row[1]), str(row[0])])

	if not have.is_empty():
		lines.append("You have:")
		lines.append_array(have)

	if not missing.is_empty():
		lines.append("Missing:")
		lines.append_array(missing)

	lines.append("It climbs slowly to what you have, faster sitting or lying; running, rain and cold make it fall faster.")
	return "\n".join(lines)


func _comfort_name(id: String) -> String:
	var words: String = id.replace("_", " ")
	return words.substr(0, 1).to_upper() + words.substr(1)


func _comfort_lit_fire_near(pos: Vector3, radius: float) -> bool:
	for id in _items:
		if _items[id].has("fire") and fire_is_lit(int(_items[id]["fire"]["state"])) and _items[id]["pos"].distance_to(pos) <= radius:
			return true

	return false


# The HUD meter (protocol 164): (peer, meter in tenths 0..100, target level, trend -1 falling / 0 / 1 rising, tooltip or "" when unchanged).
var send_comfort: Callable
var _comfort_sent: Dictionary = {}      # peer -> [tenths, target, trend]
var _comfort_tip_sent: Dictionary = {}  # peer -> the last tooltip sent
var _comfort_tip_at: Dictionary = {}    # peer -> msec the tooltip was last built
const COMFORT_TIP_S := 1.5


func _comfort_tick(_spent: float = 0.0) -> void:
	var now: int = Time.get_ticks_msec()

	for peer in _peer_key.keys():
		_sync_food(peer, false)

		if not send_comfort.is_valid() or not _peer_pos.has(peer) or vitals_of(peer).is_empty():
			continue

		var m: float = comfort_meter(peer)
		var target: float = float(_comfort_goal.get(peer, m))
		var told: Array = [int(floor(m * 10.0 + 0.001)), int(target), 1 if target > m + 0.001 else (-1 if target < m - 0.001 else 0)]
		var tip: String = ""

		if now - int(_comfort_tip_at.get(peer, -100000)) >= int(COMFORT_TIP_S * 1000.0) or _comfort_sent.get(peer, []) != told:
			if now - int(_comfort_tip_at.get(peer, -100000)) >= int(COMFORT_TIP_S * 1000.0):
				_comfort_tip_at[peer] = now
				var built: String = comfort_tip(peer)

				if built != str(_comfort_tip_sent.get(peer, "")):
					_comfort_tip_sent[peer] = built
					tip = built

		if _comfort_sent.get(peer, []) != told or tip != "":
			_comfort_sent[peer] = told
			send_comfort.call(peer, told[0], told[1], told[2], tip)


# --- Camp goals' own checks (data/items/camp_goals.json, HINTS_AND_CAMP_EVENTS_SPEC.md section 2; Tyler 31 Oct 2026) ---
# worn_warmth {min}: the warmth of the worn pieces (items.json `warmth`, layered per slot as insulation_worn does when dry, capped at 0.85) is at least min. talked {npc, hour_between}: note_talked(peer, npc) is called when a
# dialogue with that NPC opens, and counts when the game hour is inside the band. moved_lit_night {metres}: walking while holding a torch (in the pack) or within 4 m of a lit fire, between
# dusk (hour 19) and dawn (hour 6); the metres are added up once a slow tick and kept in the goal counts.
var _night_last_pos: Dictionary = {}


func _worn_warmth(peer: int) -> float:
	return minf(_layered_worn(peer, func(entry: Dictionary) -> float: return float(entry.get("warmth", 0.0))), 0.85)


func _game_hour() -> float:
	return fmod(float(game_seconds.call()) if game_seconds.is_valid() else 0.0, 86400.0) / 3600.0


func note_talked(peer: int, npc_id: String) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or _goals_paused(peer):
		return

	var hour: float = _game_hour()

	for goal in _goals_data():
		var check: Dictionary = goal.get("check", {})

		if str(check.get("event", "")) != "talked" or str(check.get("npc", npc_id)) != npc_id:
			continue

		var band: Array = check.get("hour_between", [])

		if band.size() == 2 and not (hour >= float(band[0]) and hour < float(band[1])):
			continue

		var key: String = "hit:" + str(goal["id"])
		st["goal_counts"][key] = int(st["goal_counts"].get(key, 0)) + 1
		_dirty = true

	_goals_check(peer)


func _night_walk_tick() -> void:
	var hour: float = _game_hour()
	var night: bool = hour >= 19.0 or hour < 6.0

	for peer in _peer_key.keys():
		if not _peer_pos.has(peer):
			continue

		var last: Vector3 = _night_last_pos.get(peer, _peer_pos[peer])
		_night_last_pos[peer] = _peer_pos[peer]
		var st: Dictionary = _goal_state_of(peer)

		if st.is_empty() or not night or _goals_paused(peer):
			continue

		var step: float = Vector2(_peer_pos[peer].x - last.x, _peer_pos[peer].z - last.z).length()

		if step <= 0.0 or step > 30.0:
			continue   # standing still, or a jump (respawn, teleport)

		var inv = inventory_of(peer)
		var lit: bool = _lit_fire_within(_peer_pos[peer], 4.0) or (inv != null and _goal_have(st, inv, "torch") + _goal_have(st, inv, "improved_torch") > 0)   # an admin-given torch lights no goal (GA-54)

		if lit:
			st["goal_counts"]["moved_lit_night"] = float(st["goal_counts"].get("moved_lit_night", 0.0)) + step
			_dirty = true


var _dev_pending: Array = []          # [spec, seconds waited]: --dev-place specs still waiting for their ground


func dev_place_later(spec: String) -> void:
	_dev_pending.append([spec, 0.0])


# Once a second-ish (slow tick): tries each waiting spec; a spec that placed is dropped, one still without ground after 180 s is given up with a line in the log.
func _dev_pending_tick(spent: float) -> void:
	for entry in _dev_pending.duplicate():
		var made: int = dev_place(str(entry[0]))

		if made != 0:
			print("server: dev-place %s -> world id %d" % [str(entry[0]), made])
			_dev_pending.erase(entry)
		else:
			entry[1] = float(entry[1]) + spent

			if float(entry[1]) > 180.0:
				print("server: dev-place %s NOT placed (unknown name, or no ground there)" % str(entry[0]))
				_dev_pending.erase(entry)


# --- Testing only: place structures without a kit (for screenshots and rigs) -------------------------------------------------------------------------------------------
# The server scene calls this for each `--dev-place=name@x,z,yaw[,lit]` argument (repeatable); nothing else calls it, so normal play never runs it. `name` is a structure
# kind of structures.json (lean_to, rough_bed, fireplace, wall_torch, chandelier, chest, workbench ...), x and z world metres (the ground height is taken from the ground),
# yaw degrees; the word `lit` lights a light or a fire, `coals` or `ash` lays a campfire burnt down to glowing coals or warm ash, and `firewood` or `log` makes a lit campfire
# medium or large (its wood; weak wood, a small fire, without). A fire name (`campfire`) lays a campfire. Returns the world id, 0 when the name or the ground is unknown.
func dev_place(spec: String) -> int:
	var parts: PackedStringArray = spec.split("@")

	if parts.size() != 2 or not ground_height.is_valid():
		return 0

	var name: String = parts[0].strip_edges()
	var nums: PackedStringArray = parts[1].split(",")

	if nums.size() < 2:
		return 0

	var x: float = float(nums[0])
	var z: float = float(nums[1])
	var yaw: float = float(nums[2]) if nums.size() > 2 and nums[2].is_valid_float() else 0.0
	var lit: bool = nums.has("lit")
	var y: float = float(ground_height.call(x, z))

	if is_nan(y):
		return 0

	var at: Vector3 = Vector3(x, y, z)

	if name == "campfire" and (nums.has("coals") or nums.has("ash")):   # a burnt-out bed: glowing coals (76) or warm ash (77), at the start of its time
		var coals: bool = nums.has("coals")
		_items[_next_id] = {"number": table.number_of("campfire_kit"), "count": 1, "pos": at, "left": float(_coals_cfg().get("coals_s" if coals else "ash_s", 7200.0 if coals else 43200.0)),
			"fire": {"state": FIRE_STATE_COALS if coals else FIRE_STATE_ASH, "burn_left": 0.0, "wood": {"log": 0.0, "firewood": 0.0, "weak": 0.0}, "covered": false, "recheck": COVER_RECHECK_S}}
		_lit_valid = false
		_zone_add(_next_id)
		_next_id += 1
		_dirty = true
		return _next_id - 1

	if name == "campfire":
		var wood_class: String = "log" if nums.has("log") else ("firewood" if nums.has("firewood") else "weak")   # the fire's size follows its wood (cooking.json fire_tiers)
		var wood: Dictionary = {"log": 0.0, "firewood": 0.0, "weak": 0.0}
		wood[wood_class] = 36000.0
		var lit_state: int = int(((_cooking.get("fire_tiers", {}) as Dictionary).get(wood_class, {}) as Dictionary).get("state", 1))
		_items[_next_id] = {"number": table.number_of("campfire_kit"), "count": 1, "pos": at, "left": 1.0e9, "fire": {"state": lit_state if lit else 9, "burn_left": 36000.0, "wood": wood, "covered": false, "recheck": COVER_RECHECK_S}}
		_lit_valid = false
		_zone_add(_next_id)
		_next_id += 1
		_dirty = true
		return _next_id - 1

	var def: Dictionary = _structures.get(name, {})

	if def.is_empty():
		return 0

	var row: Dictionary = {"kind": name, "yaw": float(posmod(int(yaw), 360))}

	if lit and _fuel_slot_kind(def):
		row["fuel_left"] = 1.0e7   # a smithy is never lit: "lit" gives it fuel for a test's whole run
	elif lit:
		row["lit"] = true
		row["fuel_left"] = light_burn_s(def, 3600.0) * 2.0

	var entry: Dictionary = {"number": table.number_of(str(def.get("item", name))), "count": 1, "pos": at, "left": 1.0e9, "struct": row}

	if int(def.get("slots", 0)) > 0:
		row["uid"] = _next_uid
		_chests[_next_uid] = _new_store(name)
		_next_uid += 1

	_items[_next_id] = entry
	_grid_add(_next_id, entry)

	if _smelters.is_smelter(def):
		_smelters.note(_next_id)

	_next_id += 1
	_add_roof(entry)
	_dirty = true
	return _next_id - 1


# --- Hints (data/items/hints.json by Sal, HINTS_AND_CAMP_EVENTS_SPEC.md; Tyler 31 Oct 2026) ---
# A hint is a one-line notice (the same line as the goal notices) said once per character and hint id when its trigger becomes true; the ids said are saved in
# characters.json "hints_seen". Triggers by name (below); a trigger the server cannot judge (beach_with_container) never fires.
# Said once, never again: the client puts a guide hint in a box the player clicks OK on (R-HUD-HINT-BOX), so it is not missed.
var _hints: Array = []
var _hints_loaded: bool = false
var _hint_origin: Dictionary = {}     # peer -> first position seen (the "moved" trigger)


func _hints_data() -> Array:
	if not _hints_loaded:
		_hints_loaded = true
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/hints.json"))
		_hints = parsed.get("hints", []) if typeof(parsed) == TYPE_DICTIONARY else []

	return _hints


# Fresh fruit that spoils fast (the "fruit_in_pack" hint): picked from trees, not cooked or dried.
const HINT_FRUIT := ["wild_apples", "apple_early", "apple_summer", "apple_autumn", "apple_keeping", "apple_cooking", "pear_summer", "pear_autumn", "pear_winter", "sour_cherries", "plums", "damsons", "quince", "medlar", "figs", "pomegranates"]


func _hint_count(st: Dictionary, key: String) -> int:
	return int(st["goal_counts"].get(key, 0))


# _hint_trigger_true, noting the slowest trigger of this goals tick (the slow-tick line).
func _timed_trigger(peer: int, st: Dictionary, trigger: String) -> bool:
	var t0: int = Time.get_ticks_usec()
	var out: bool = _hint_trigger_true(peer, st, trigger)
	var spent: int = Time.get_ticks_usec() - t0

	if spent > _slowest_hint_usec:
		_slowest_hint_usec = spent
		_slowest_hint = trigger

	return out


func _hint_trigger_true(peer: int, st: Dictionary, trigger: String) -> bool:
	var inv = inventory_of(peer)

	if inv == null or not _peer_pos.has(peer):
		return false

	var v: Dictionary = vitals_of(peer)
	var hour: float = fmod(float(game_seconds.call()) if game_seconds.is_valid() else 0.0, 86400.0) / 3600.0

	match trigger:
		"first_frame":
			return true
		"moved":
			return _hint_origin.has(peer) and (_hint_origin[peer] as Vector3).distance_to(_peer_pos[peer]) >= 5.0
		"walked_far":   # far enough from where the hints began to have something on the map (the map hint, coordinator 23 Nov 2026)
			return _hint_origin.has(peer) and (_hint_origin[peer] as Vector3).distance_to(_peer_pos[peer]) >= 150.0
		"water_in_view":
			return water_near.is_valid() and _tile_ready_at(_peer_pos[peer]) and bool(water_near.call(_peer_pos[peer], 20.0)) and not v.is_empty() and float(v.get("wet", 0.0)) < float(_vitals_cfg.get("thirst", {}).get("cap_ml", 2400)) - 1.0
		"after_drink":
			return _hint_count(st, "event:drink") >= 1
		"8_sticks":
			return inv.count_of(table.number_of("stick")) >= 8
		"12_fibre":
			return inv.count_of(table.number_of("plant_fibre")) >= 12
		"2_twine_1_stone_1_stick":
			return inv.count_of(table.number_of("twine")) >= 2 and inv.count_of(table.number_of("stone")) >= 1 and inv.count_of(table.number_of("stick")) >= 1
		"axe_made":
			return _hint_count(st, "made:stone_axe") >= 1
		"tree_down":
			return _hint_count(st, "event:tree_felled") >= 1
		"6_sticks_16_stones":
			return inv.count_of(table.number_of("stick")) >= 6 and inv.count_of(table.number_of("stone")) >= 16
		"kit_made":
			return _hint_count(st, "made:campfire_kit") >= 1
		"fire_placed":
			return _hint_count(st, "event:placed:campfire") >= 1
		"fire_lit":
			return _hint_count(st, "event:fire_lit") >= 1
		"hungry":
			return not v.is_empty() and int(_vitals_points(v)[0]) < 80
		"fire_burning_cold":
			return _hint_count(st, "event:fire_lit") >= 1 and not v.is_empty() and float(v.get("warmth", 100.0)) < 70.0
		"leanto_made":
			return inv.count_of(table.number_of("stone_hammer")) >= 1   # the shelter is a hammer blueprint now: with the hammer in the pack, the next step is to click it down
		"leanto_placed":
			return _hint_count(st, "event:placed:lean_to") >= 1
		"bed_placed":   # any bed: the Thatch - Bed kit or a built Straw, Feather or Canopy bed (the starter bed goal counts the same four)
			return _hint_count(st, "event:placed:rough_bed") + _hint_count(st, "event:placed:straw_bed") + _hint_count(st, "event:placed:feather_bed") + _hint_count(st, "event:placed:canopy_bed") >= 1
		"wall_placed":   # any wall, doorway or window stands: the roof panels come next (GA-18)
			for k in st.get("goal_counts", {}):
				if str(k).begins_with("event:placed:") and str(_structures.get(str(k).trim_prefix("event:placed:"), {}).get("piece_kind", "")) == "wall":
					return true

			return false
		"workbench_placed":   # the camp bench or the log workbench (Dino round 6)
			return _hint_count(st, "event:placed:workbench") + _hint_count(st, "event:placed:log_workbench") >= 1
		"axe_held_near_tree":   # an axe on the hotbar and a standing tree within 6 m (any axe on the hotbar where the tree index is not wired)
			if _tool_slot(inv, "axe") < 0:
				return false

			if trees_near_cached.is_valid():
				return not (trees_near_cached.call(_peer_pos[peer], 6.0) as Array).is_empty()

			return not trees_near.is_valid() or not (trees_near.call(_peer_pos[peer], 6.0) as Array).is_empty()
		"has_campfire_kit":
			return inv.count_of(table.number_of("campfire_kit")) >= 1
		"near_fire_with_food":   # raw meat or fish in the pack, a lit fire within 4 m
			return _lit_fire_within(_peer_pos[peer], 4.0) and _has_raw_meat(inv)
		"has_sea_water":
			return inv.count_of(table.number_of("sea_water")) >= 1
		"beach_with_container", "beach_with_bucket":   # a water container in the pack at the sea edge (ACT_GATHER_EDGE reach)
			var carries: bool = false

			for container in (["bucket"] if trigger == "beach_with_bucket" else _shore_data().get("containers", [])):   # the containers gather_edge fills
				carries = carries or inv.count_of(table.number_of(str(container))) >= 1

			return carries and _sea_near(_peer_pos[peer], float(_shore_data().get("reach_m", 4.0)))
		"near_nettle":   # no flora query for small plants on the server: the first nettles in the pack stand in for "near a nettle"
			return inv.count_of(table.number_of("nettles")) >= 1
		"spear_made":
			return _hint_count(st, "made:spear") >= 1
		"warmth_under_70":
			return not v.is_empty() and float(v.get("warmth", 100.0)) < 70.0
		"dusk":
			return hour >= 18.0 and hour < 20.0
		"has_plant_food_at_fire":
			return _plant_food_at_fire(peer, inv)
		"campfire_pot_placed":
			return _hint_count(st, "event:placed:campfire_pot") >= 1
		"digging_under_ceiling":   # the first dig more than 2.5 m under the surface (_dig)
			return _hint_count(st, "event:dug_under") >= 1
		"fruit_in_pack":
			for fruit in HINT_FRUIT:
				if table.number_of(str(fruit)) > 0 and inv.count_of(table.number_of(str(fruit))) >= 1:
					return true

			return false
		"near_fruit_tree_in_season":   # a fruit tree in fruit within 8 m
			return _fruit_trees_near(_peer_pos[peer], 8.0, true) >= 1
		"near_orchard":   # four or more fruit trees within 25 m
			return _fruit_trees_near(_peer_pos[peer], 25.0, false) >= 4
		"season_changes":   # the season stamp is not the one this player last saw (the first look only records it): their own place's seasons
			var stamp: int = _stamp_at(_peer_pos.get(peer, Vector3.ZERO))
			var seen: int = int(st.get("season_seen", -1))
			st["season_seen"] = stamp
			return seen >= 0 and seen != stamp
		"autumn_end":   # the last quarter of autumn
			if not (season_now.is_valid() or season_at.is_valid()) or _season_of(_peer_pos.get(peer, Vector3.ZERO)) != "autumn" or not game_seconds.is_valid():
				return false

			# The part of the season gone is the same on both sides of the equator (a row's year is half a year, two whole seasons, on).
			var day: int = int(floorf(float(game_seconds.call()) / 86400.0)) % 365   # starter-calendar: only the part of the season gone, the same on both sides
			return fmod(float(day) * 4.0 / 365.0, 1.0) >= 0.75

	return false


# Fruit trees (drops.json "fruit_tree") standing within r metres of the point; in_fruit_only counts only those whose flora row is in season.
func _fruit_trees_near(pos: Vector3, r: float, in_fruit_only: bool) -> int:
	var fruit: Dictionary = _drops.get("fruit_tree", {})
	var season: String = _season_of(pos) if season_now.is_valid() or season_at.is_valid() else "all"
	var count: int = 0

	for tree in _standing_trees(pos, r):
		var species: String = str(tree[1])

		if not fruit.has(species):
			continue

		if in_fruit_only and not GatherRules.in_season(_flora_by_name.get(species, {}), season):
			continue

		count += 1

	return count


# [position, species name] of the standing trees within r metres, for the hint triggers: the server's cached look when it has one (trees_near_cached), else
# trees_near and tree_info (tests).
func _standing_trees(pos: Vector3, r: float) -> Array:
	if trees_near_cached.is_valid():
		return trees_near_cached.call(pos, r)

	if not trees_near.is_valid() or not tree_info.is_valid():
		return []

	var out: Array = []

	for found in trees_near.call(pos, r):
		var info: Dictionary = tree_info.call(found[0], int(found[1]))

		if not info.is_empty():
			out.append([info.get("position", pos), str(info.get("name", ""))])

	return out


# Hint trigger has_plant_food_at_fire (Sal's tutorial steps 23 and 24): the player stands within 4 m of a lit fire with an ingredient of a campfire_pot or clay hearth recipe in the pack
# (berries, nectar, pears ...; the plain campfire does not cook plants) and no campfire pot stands at that fire yet. The ingredient set is read from recipes.json by station.
func _plant_food_at_fire(peer: int, inv) -> bool:
	var pos: Vector3 = _peer_pos[peer]

	if not _lit_fire_within(pos, 4.0) or _struct_kind_within(pos, "campfire_pot", 4.0):
		return false

	for number in recipes.numbers():
		var r: Dictionary = recipes.recipe(int(number))

		if not (str(r.get("station", "")) in ["campfire_pot", "clay_hearth"]) or not (str(r.get("category", "")) in ["Food and drink"]):
			continue

		for need in r["needs"]:
			if int(need[0]) > 0 and inv.count_of(int(need[0])) >= int(need[1]) and not _cooking.get("cooks_into", {}).has(table.id_of(int(need[0]))):   # meat and fish are what the plain campfire cooks
				return true

	return false


# True when the pack holds something the plain campfire cooks (cooking.json cooks_into: raw meat and fish).
func _has_raw_meat(inv) -> bool:
	for id in _cooking.get("cooks_into", {}):
		var number: int = table.number_of(str(id))

		if number > 0 and inv.count_of(number) >= 1:
			return true

	return false


# True when a placed structure of this kind stands within r metres of the point.
func _struct_kind_within(pos: Vector3, kind: String, r: float) -> bool:
	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and str(it["struct"].get("kind", "")) == kind and (it["pos"] as Vector3).distance_to(pos) <= r:
			return true

	return false


# Looks at every hint for one player: says the first one whose trigger holds and that was not said yet.
func _hints_check(peer: int) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or _hints_data().is_empty() or not _peer_pos.has(peer):
		return

	if not _hint_origin.has(peer):
		_hint_origin[peer] = _peer_pos[peer]

	if typeof(st.get("hints_seen", null)) != TYPE_DICTIONARY:
		st["hints_seen"] = {}

	var now_s: float = Time.get_unix_time_from_system()

	for hint in _hints_data():
		var id: String = str(hint["id"])
		var goal: String = str(hint.get("goal", ""))

		if st["hints_seen"].has(id) or not _timed_trigger(peer, st, str(hint.get("trigger", ""))):
			continue

		st["hints_seen"][id] = now_s

		if goal != "" and st["goals_done"].has(goal):
			continue   # the goal is already done: the hint would only nag

		_say(peer, str(hint.get("text", "")))
		_dirty = true
		return   # one hint at a time


# Goals (data/items/starter_goals.json by Sal, camp_goals.json; Tyler 31 Oct 2026; GOALS-REPAIR WP-GUIDE-UI 14 Nov 2026): the guide's goals in their authored order.
# Every goal tracks on its own from the start of the character and completes the moment its check is met, in any order (GA-40): `after` names the goals
# taught before it (the Journal's prerequisite links and the authored order), never a lock. Checks: {event, count, what?} (the server calls _goal_event: drink,
# tree_felled, fire_lit, ate_food, placed what, carcass_worked), {made_item, count} (crafts that finished; a hand chop or split counts as one), {made_item_any: [ids], count} (those crafts summed over the ids), {made_item_all: [ids], or_have?} (one of each id: a tier's tool set), {got_item, count} (gathered first-hand, _goal_got), {stored_item_any: [ids], count} (units put into storage containers by hand, _goal_stored), {have_item, count} and {have_item_any: [ids], count}
# (true while the pack holds that many, looked at every slow tick). A goal is done once per character and saved with it (characters.json goals_done and
# goal_counts, the same atomic file as the coins); the reward (its stage's copper, goal_rewards.json; coins only, Dave 14 Nov) is paid in the same step and a
# save follows on the next tick (GA-55). Debug play earns nothing (GA-54): while Admin mode is on no goal counts or completes, a free craft is never counted, and
# pack units an admin gave are taken off the have checks. The client gets the whole list at the join (goals, silent) and goal_done for each new completion
# (the placard; protocol 119).
var _goals: Array = []
var _goals_loaded: bool = false
var _goal_stage_copper: Dictionary = {}   # stage -> copper a goal of that stage pays (data/items/goal_rewards.json; GOALS-REPAIR A-42)
var send_goals: Callable       # (peer, rows Array): the whole goal list at the join, rows as goals_rows (protocol 119)
var send_goal_done: Callable   # (peer, id String, copper int): a goal this character has just completed and the copper it paid (protocol 119)
var send_goal_progress: Callable   # (peer, changes Dictionary id -> count): how far the unfinished goals with an amount have got, as they move (protocol 122)
var _goal_sent: Dictionary = {}    # peer -> {goal id -> the count last sent}: goal_progress sends only what moved
var _goal_what: Dictionary = {}    # peer -> the animal last worked, for a goal's "done" line ({what}; QA #9)


func _goals_data() -> Array:
	if not _goals_loaded:
		_goals_loaded = true
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/starter_goals.json"))
		_goals = parsed.get("goals", []) if typeof(parsed) == TYPE_DICTIONARY else []
		var camp: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/camp_goals.json")) if FileAccess.file_exists("res://data/items/camp_goals.json") else {}

		if typeof(camp) == TYPE_DICTIONARY:
			_goals = _goals + (camp.get("goals", []) as Array)   # the camp and winter goals follow the starter ones in the authored order

		var rewards: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/goal_rewards.json"))
		_goal_stage_copper = rewards.get("stages", {}) if typeof(rewards) == TYPE_DICTIONARY else {}

		for goal in _goals:
			if not _goal_stage_copper.has(str(goal.get("stage", ""))):
				push_error("goal %s: stage '%s' is not in goal_rewards.json, it pays nothing" % [str(goal.get("id", "")), str(goal.get("stage", ""))])

	return _goals


# The copper a goal pays: its stage's amount (Dave 14 Nov 2026: "all goals only payout coins"; coins only, no items or reputation).
func _goal_copper(goal: Dictionary) -> int:
	return int(_goal_stage_copper.get(str(goal.get("stage", "")), 0))


func _goal_state_of(peer: int) -> Dictionary:
	var key: String = str(_peer_key.get(peer, ""))

	if key == "" or not _characters.has(key):
		return {}

	for name in ["goals_done", "goal_counts"]:
		if typeof(_characters[key].get(name, null)) != TYPE_DICTIONARY:
			_characters[key][name] = {}

	return _characters[key]


func _goal_count_key(name: String, what: String) -> String:
	return "event:" + name + (":" + what if what != "" else "")


# Admin mode on: crafting and building are free, so nothing done then is progress (GA-54).
func _goals_paused(peer: int) -> bool:
	return free_craft_for(peer)


# first_only: counts only the first time per `what` (a plant, a fish kind); its own "event:<name>:<what>" count is the seen mark, so nothing else is saved.
func _goal_event(peer: int, name: String, what: String = "", first_only: bool = false) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or _goals_data().is_empty() or _goals_paused(peer):
		return

	if first_only and int(st["goal_counts"].get(_goal_count_key(name, what), 0)) > 0:
		return

	var plain: String = _goal_count_key(name, "")
	st["goal_counts"][plain] = int(st["goal_counts"].get(plain, 0)) + 1

	if what != "":
		var specific: String = _goal_count_key(name, what)
		st["goal_counts"][specific] = int(st["goal_counts"].get(specific, 0)) + 1

	_dirty = true
	_goals_check(peer)


# An event that counts once per player act, however many stacks or pieces the act moved (Store all, a boulder blow that breaks several pieces):
# _act_events is cleared when each action starts.
var _act_events: Dictionary = {}   # "<peer>:<event>" fired during the current action


func _goal_event_act(peer: int, name: String) -> void:
	var k: String = "%d:%s" % [peer, name]

	if not _act_events.has(k):
		_act_events[k] = true
		_goal_event(peer, name)


# crafts: how many crafts of the item finished at once (a sealed batch makes them all in one step).
func _goal_made(peer: int, item: int, crafts: int = 1) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or _goals_data().is_empty() or _goals_paused(peer):
		return

	var k: String = "made:" + table.id_of(item)
	st["goal_counts"][k] = int(st["goal_counts"].get(k, 0)) + maxi(crafts, 1)
	_dirty = true
	_goals_check(peer)


# Gathered first-hand (give() or _take_in() with no caller's source: a harvest, dig, mine, carcass, catch or litter): the got_item checks count it as
# history, not possession. Trades, crafts, cooking, rewards, refunds and returns are tagged by their callers and do not count, nor do admin gives
# (they go straight to Inventory.add). Ground items count only when found: natural scatter at its pickup (_pickup, _pickup_batch), and everything a
# tree this player fells breaks into (_fell_record: logs, firewood, litter, bark, seeds).
# shortcut: other ground pickups never count, since a dropped item cannot be told from a found one; a tree felled by digging under it credits no one;
# revisit with GA-41 origin events.
func _goal_got(peer: int, item: int, n: int) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or n <= 0 or _goals_data().is_empty() or _goals_paused(peer):
		return

	var k: String = "got:" + table.id_of(item)
	st["goal_counts"][k] = int(st["goal_counts"].get(k, 0)) + n
	_dirty = true
	_goals_check(peer)


# Units of an item this player put into a storage container by hand (_box_put): the stored_item_any checks (the winter fruit store, Dave 22 Nov 2026).
# History, as got_item: fruit taken out again still counts. Admin mode counts nothing (_goals_paused).
var _stored_ids: Dictionary = {}   # item id -> true: the items a stored_item_any check names ("" once built)


func _goal_stored(peer: int, item: int, n: int) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or n <= 0 or _goals_data().is_empty() or _goals_paused(peer):
		return

	if _stored_ids.is_empty():   # the ids some stored_item_any check names, once: other puts (sticks, stone) count and save nothing
		_stored_ids[""] = true

		for goal in _goals_data():
			for id in goal.get("check", {}).get("stored_item_any", []):
				_stored_ids[str(id)] = true

	if not _stored_ids.has(table.id_of(item)):
		return

	var k: String = "stored:" + table.id_of(item)
	st["goal_counts"][k] = int(st["goal_counts"].get(k, 0)) + n
	_dirty = true
	_goals_check(peer)


# An admin give (ACT_ADMIN_GIVE): those units do not count towards a have check.
func _goal_admin_gave(peer: int, item: int, n: int) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or n <= 0:
		return

	var k: String = "admin:" + table.id_of(item)
	st["goal_counts"][k] = int(st["goal_counts"].get(k, 0)) + n
	_dirty = true


# How many of the item the pack holds that count for a goal: the admin-given units are taken off. They are taken to be the first to leave the pack, so the
# record never exceeds what is held and later gathered units count.
# shortcut: units are not tagged; an admin give followed by gathering and then using the gathered ones undercounts, admin testers only; revisit with GA-41 origin events.
var _goal_pack: Dictionary = {}       # item number -> count in the pack, read once a pass while _goals_check runs (_goal_pack_on)
var _goal_pack_on: bool = false
var _goal_number: Dictionary = {}     # item id -> number, for the goal checks' ids


func _goal_have(st: Dictionary, inv, id: String) -> int:
	if not _goal_number.has(id):
		_goal_number[id] = table.number_of(id)

	var held: int = int(_goal_pack.get(_goal_number[id], 0)) if _goal_pack_on else inv.count_of(int(_goal_number[id]))
	var k: String = "admin:" + id

	if not st["goal_counts"].has(k):
		return held

	var gave: int = mini(int(st["goal_counts"][k]), held)

	if gave <= 0:
		st["goal_counts"].erase(k)
	else:
		st["goal_counts"][k] = gave

	return held - gave


func _goal_met(peer: int, st: Dictionary, check: Dictionary, goal_id: String = "") -> bool:
	var progress: Vector2i = _goal_progress(peer, st, check, goal_id)
	return progress.x >= progress.y


# How far a goal's check has got: Vector2i(count so far, count needed). Its count is the one _goal_met compares (Dave 14 Nov 2026: "Gather plant fiber 0/50",
# shown for every goal with an amount). A check with no amount (worn warmth) is 0 or 1 of 1; the night walk counts whole metres.
func _goal_progress(peer: int, st: Dictionary, check: Dictionary, goal_id: String = "") -> Vector2i:
	var need: int = int(check.get("count", 1))
	var inv = inventory_of(peer)

	if str(check.get("event", "")) == "worn_warmth":
		return Vector2i(1 if _worn_warmth(peer) >= float(check.get("min", 0.7)) else 0, 1)

	if str(check.get("event", "")) == "talked":
		return Vector2i(int(st["goal_counts"].get("hit:" + goal_id, 0)), need)

	if str(check.get("event", "")) == "moved_lit_night":
		return Vector2i(floori(float(st["goal_counts"].get("moved_lit_night", 0.0))), ceili(float(check.get("metres", 100.0))))   # whole metres: met at the same distance for a whole-metre target

	if check.has("event") and check.has("what_any"):   # any of these kinds counts: the camp bench or the log workbench (Dino round 6)
		var total: int = 0

		for what in check["what_any"]:
			total += int(st["goal_counts"].get(_goal_count_key(str(check["event"]), str(what)), 0))

		return Vector2i(total, need)

	if check.has("event"):
		return Vector2i(int(st["goal_counts"].get(_goal_count_key(str(check["event"]), str(check.get("what", ""))), 0)), need)

	if check.has("got_item"):
		return Vector2i(int(st["goal_counts"].get("got:" + str(check["got_item"]), 0)), need)

	if check.has("made_item"):
		var made: int = int(st["goal_counts"].get("made:" + str(check["made_item"]), 0))

		if bool(check.get("or_have", false)) and inv != null:   # a bought one counts too (Hob sells the stone axe; Dino round 6)
			made = maxi(made, _goal_have(st, inv, str(check["made_item"])))

		return Vector2i(made, need)

	if check.has("made_item_any"):   # crafts of any of these ids add up: the four kinds of wooden block (chop_log_blocks, GAP-GUIDE-ANY)
		var made_any: int = 0

		var have_any: int = 0

		for id in check["made_item_any"]:
			made_any += int(st["goal_counts"].get("made:" + str(id), 0))

			if bool(check.get("or_have", false)) and inv != null:   # one held counts too, as for made_item (the hammer goal: a Stone - Hammer)
				have_any += _goal_have(st, inv, str(id))

		return Vector2i(maxi(made_any, have_any), need)

	# A set: one of each id, made (or held, with or_have), and its amount is the number of ids (Dave 25 Nov 2026: "make all the wooden
	# tools you can make early... when its stones time make all the stone stuff", one goal per tier with its tools as the list).
	if check.has("made_item_all"):
		var ids: Array = check["made_item_all"]
		var have_set: int = 0

		for id in ids:
			var one: int = int(st["goal_counts"].get("made:" + str(id), 0))

			if one < 1 and bool(check.get("or_have", false)) and inv != null:
				one = _goal_have(st, inv, str(id))

			if one >= 1:
				have_set += 1

		return Vector2i(have_set, ids.size())

	if inv == null:
		return Vector2i(0, need)

	if check.has("have_item"):
		return Vector2i(_goal_have(st, inv, str(check["have_item"])), need)

	if check.has("stored_item_any"):
		var stored: int = 0

		for id in check["stored_item_any"]:
			stored += int(st["goal_counts"].get("stored:" + str(id), 0))

		return Vector2i(stored, need)

	if check.has("have_item_any"):
		var total: int = int(st["goal_counts"].get(_goal_count_key(str(check["or_event"]), ""), 0)) if check.has("or_event") else 0   # a catch counts though the fish was eaten

		for id in check["have_item_any"]:
			total += _goal_have(st, inv, str(id))

		return Vector2i(total, need)

	return Vector2i(0, need)


# The first goal in the authored order this character has not done, or {}.
func _goal_next(st: Dictionary) -> Dictionary:
	for goal in _goals_data():
		if not st["goals_done"].has(str(goal["id"])):
			return goal

	return {}


# The goals whose check no event announces: what the pack holds (have_item, have_item_any, or_have, a set held), the worn gear and the night walk.
var _goal_polled: Array = []
var _goal_polled_built: bool = false


func _goals_polled() -> Array:
	if not _goal_polled_built:
		_goal_polled_built = true

		for goal in _goals_data():
			var check: Dictionary = goal.get("check", {})

			if str(check.get("event", "")) in ["worn_warmth", "moved_lit_night"] or check.has("have_item") or check.has("have_item_any") or bool(check.get("or_have", false)):
				_goal_polled.append(goal)

	return _goal_polled


# The spread's look (GOAL_POLL_S): _goals_check over the polled goals only.
# Nothing a polled goal reads has moved since the last look (the pack's slots, the worn gear, the night walk's metres, the goal record's size):
# the look is skipped, so a player standing about costs a hash a second.
var _goal_poll_sig: Dictionary = {}   # peer -> the signature at its last look


func _goals_poll(peer: int) -> void:
	if _goals_polled().is_empty():
		return

	var inv = inventory_of(peer)
	var st: Dictionary = _goal_state_of(peer)

	if inv == null or st.is_empty():
		return

	var sig: int = hash([inv.numbers, inv.counts, worn_of(peer), st["goal_counts"].get("moved_lit_night", 0.0), st["goal_counts"].size(), st["goals_done"].size(), _goals_paused(peer)])

	if int(_goal_poll_sig.get(peer, 0)) == sig:
		return

	_goal_poll_sig[peer] = sig
	_goals_check(peer, _goals_polled())


# Completes every goal that is met, pays its reward and tells the client (one completion can meet another's check, so it loops until nothing changes).
# only: the goals to look at (the spread's polled ones); empty, every goal.
func _goals_check(peer: int, only: Array = []) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or _goals_paused(peer):
		return

	var changed: bool = true
	var counts: Dictionary = {}   # unfinished goal with an amount -> its count, from the last pass (nothing completes in it)

	while changed:
		changed = false
		counts = {}
		_goal_pack_read(peer)

		for goal in (_goals_data() if only.is_empty() else only):
			var id: String = str(goal["id"])

			if st["goals_done"].has(id):
				continue

			var progress: Vector2i = _goal_progress(peer, st, goal.get("check", {}), id)

			if progress.x < progress.y:
				if progress.y > 1:
					counts[id] = progress.x

				continue

			# Done before paying, in the same step and the same record as the coins: no retry, reconnect or reload pays twice.
			st["goals_done"][id] = true
			changed = true
			_dirty = true
			_save_in = 0.0   # the next tick saves (GA-55)
			var paid: int = coins_of(peer)
			add_coins(peer, _goal_copper(goal), "goal")
			paid = coins_of(peer) - paid

			if send_goal_done.is_valid():
				send_goal_done.call(peer, id, paid)

			# One notice for the goal, its reward and the next goal: two lines in a row left only the second on screen, so a goal's coins
			# looked like they came from the tree or plant being worked (playtest 12 Nov 2026 TEST-009).
			var line: String = "Goal done: %s." % str(goal.get("title", id))

			if goal.has("done") and _goal_what.has(peer):   # what was really done, in the goal's own words: "You worked a black bear." (QA #9)
				var what: String = str(_goal_what[peer])
				line = "Goal done: %s." % str(goal["done"]).replace("{what}", ("an " if what.left(1) in ["a", "e", "i", "o", "u"] else "a ") + what)

			if paid > 0:
				line += " You earn %s." % _coin_words(paid)

			var next: Dictionary = _goal_next(st)

			if not next.is_empty():
				line += " Next: %s. %s" % [str(next.get("title", "")), str(next.get("hint", ""))]

			_say(peer, line)

	_goal_pack_on = false
	_goal_pack.clear()
	_send_goal_progress(peer, counts)


# The pack's counts by item number, read once for a pass of _goals_check: every have and or_have check then looks them up, not walking the slots
# again for each id (a set goal names ten).
func _goal_pack_read(peer: int) -> void:
	_goal_pack.clear()
	var inv = inventory_of(peer)
	_goal_pack_on = inv != null

	if inv == null:
		return

	for i in inv.slot_count:
		var number: int = int(inv.numbers[i])

		if number != 0:
			_goal_pack[number] = int(_goal_pack.get(number, 0)) + int(inv.counts[i])


# Sends the counts that moved since the last send (the have checks move both ways). The join's list carries them all (goals_rows).
func _send_goal_progress(peer: int, counts: Dictionary) -> void:
	var sent: Dictionary = _goal_sent.get(peer, {})
	var moved: Dictionary = {}

	for id in counts:
		if int(sent.get(id, -1)) != int(counts[id]):
			moved[id] = int(counts[id])
			sent[id] = int(counts[id])

	_goal_sent[peer] = sent

	if not moved.is_empty() and send_goal_progress.is_valid():
		send_goal_progress.call(peer, moved)


# Goals spread over frames like the vitals (_vitals_spread): every player's goals once every GOAL_POLL_S, a share of the players each frame.
# The events that complete goals (_goal_event, _goal_made, _goal_got, _goal_stored, a talk) check every goal at once themselves, so the spread
# looks only at the goals nothing tells it about: what the pack or worn gear holds and the night walk (_goals_poll; coordinator 25 Nov 2026: the
# full look 4 times a second cost 0.53 ms a player each time after #1905, about 2.1 ms a player a second; Dave: small actions with huge server costs
# are critical).
const GOAL_POLL_S := 1.0
var _goal_owed: float = 0.0
var _goal_turn: int = 0
var _goals_spread_usec: int = 0   # the time spent since the last slow tick, for its detail line
var goal_check_seen: Callable      # tests (test_vitals_spread): told of each player whose goals the spread looks at


func _goals_spread(delta: float) -> void:
	if _goals_data().is_empty():
		return

	var peers: Array = _peer_key.keys()

	if peers.is_empty():
		_goal_owed = 0.0
		return

	_goal_owed = minf(_goal_owed + float(peers.size()) * delta / GOAL_POLL_S, float(peers.size()))
	var n: int = int(_goal_owed)
	_goal_owed -= float(n)
	var tg: int = Time.get_ticks_usec()

	for i in n:
		if _goal_turn >= peers.size():
			_goal_turn = 0

		var peer: int = int(peers[_goal_turn])
		_goal_turn += 1

		if _peer_key.has(peer):
			_goals_poll(peer)

			if goal_check_seen.is_valid():
				goal_check_seen.call(peer)

	_goals_spread_usec += Time.get_ticks_usec() - tg


# with_goals: also every player's goals here, all at once (tests call it so); the tick passes false and _goals_spread does them.
func _goals_tick(with_goals: bool = true) -> void:
	if _goals_data().is_empty():
		return

	var t0: int = Time.get_ticks_usec()
	_lit_valid = false   # this tick's own fire list, worked out at its first look
	_lit_scope = true
	_night_walk_tick()
	var t1: int = Time.get_ticks_usec()
	_slowest_hint_usec = 0
	_slowest_hint = ""

	# Hints are looked at every HINT_EVERY_TICKS slow ticks (about once a second), not 4 times a second: the tree triggers
	# (near_orchard, near_fruit_tree_in_season) scan the trees of nine flora chunks each look (lag run 5 Nov: hints 18 to 76 ms a tick).
	# Each slow tick looks at the hints of one share of the players (every hint_every-th from _hint_phase), so each player still once a second but
	# not all on the same tick (load bots 22 Nov 2026: 8 players, hints 39 to 69 ms on one tick, rising with every player).
	var nth: int = 0
	var phase: int = _hint_phase
	_hint_phase = (_hint_phase + 1) % maxi(1, hint_every)

	# The goals themselves are looked at in _goals_spread, a share of the players each frame; the hints stay here.
	if with_goals:
		var tg: int = Time.get_ticks_usec()

		for peer in _peer_key.keys():
			_goals_check(peer)

		_goals_spread_usec += Time.get_ticks_usec() - tg

	var goals_usec: int = _goals_spread_usec
	_goals_spread_usec = 0
	var th: int = Time.get_ticks_usec()

	for peer in _peer_key.keys():
		if nth % maxi(1, hint_every) == phase:
			_hints_check(peer)

		nth += 1

	# For the slow-tick line (lag run 5 Nov: goals 43 and 102 ms, no split). Goals: the spread looks since the last slow tick.
	_goals_detail = "(night walk %.0f, goals %.0f spread, hints %.0f, slowest hint trigger %s %.0f)" % [float(t1 - t0) / 1000.0, float(goals_usec) / 1000.0,
		float(Time.get_ticks_usec() - th) / 1000.0, _slowest_hint, float(_slowest_hint_usec) / 1000.0]
	_lit_scope = false


# The goal list as the client gets it, in the authored order: [id, title, how-to, reward copper, reward item id ("" none), reward item count, after ids
# (PackedStringArray: the goals taught first, for the Journal's links), done (bool), amount needed, count so far (protocol 122; the count stops at the amount)].
func goals_rows(peer: int) -> Array:
	var st: Dictionary = _goal_state_of(peer)
	var rows: Array = []
	var sent: Dictionary = {}

	if st.is_empty():
		return rows

	for goal in _goals_data():
		var id: String = str(goal["id"])
		var progress: Vector2i = _goal_progress(peer, st, goal.get("check", {}), id)
		var so_far: int = mini(progress.x, progress.y)
		var how: String = str(goal.get("hint", "")) + (_water_way(peer) if id == "drink" and not st["goals_done"].has(id) else "")
		rows.append([id, str(goal.get("title", "")), how, _goal_copper(goal), "", 0,   # reward item fields stay in the protocol 119 row, always empty: goals pay coins only
			PackedStringArray(goal.get("after", [])), st["goals_done"].has(id), progress.y, so_far])
		sent[id] = progress.x

	_goal_sent[peer] = sent   # the list carries every count: goal_progress sends only what moves after it
	return rows


# The drink goal's hint (coordinator for Dave, 22 Nov 2026): which way and about how far the nearest fresh water is from where the player
# stands, from the world's water map (never from the spawn). "" with no position yet or no search hooked up.
func _water_way(peer: int) -> String:
	var at: Variant = _water_hint_at.get(peer, _peer_pos.get(peer, null))

	if not (at is Vector3) or not nearest_fresh_water.is_valid():
		return ""

	var spot: Vector3 = nearest_fresh_water.call(at, WATER_HINT_REACH_M)

	if is_nan(spot.y):
		return ""   # the ground there is not loaded yet: the plain hint (worked out again after the next walk)

	if spot.y == INF:
		return " No fresh water within %d m of here: try another way." % int(WATER_HINT_REACH_M)

	if spot.y < 30.0:
		return " Fresh water is right here."

	var to: Vector2 = Vector2(spot.x - (at as Vector3).x, spot.z - (at as Vector3).z)
	var way: String = ["east", "south-east", "south", "south-west", "west", "north-west", "north", "north-east"][posmod(int(round(atan2(to.y, to.x) / (PI / 4.0))), 8)]   # +z is south (character_screen.gd)
	return " The nearest fresh water is about %d m %s." % [int(round(spot.y / 10.0)) * 10, way]


# True when this player should get the drink hint worked out again: the drink goal not done and no hint yet, or they moved WATER_HINT_MOVE_M.
func _drink_hint_due(peer: int, position: Vector3) -> bool:
	var at: Variant = _water_hint_at.get(peer, null)

	if at is bool or (at is Vector3 and (at as Vector3).distance_to(position) < WATER_HINT_MOVE_M):
		return false

	if not _tile_ready_at(position):
		return false   # its tile is still loading (ground_ready prefetches it): the next report tries again

	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty():
		return false

	if st["goals_done"].has("drink"):
		_water_hint_at[peer] = true
		return false

	_water_hint_at[peer] = position
	return true


# At the join, before the list goes out: every goal the character already meets is marked done, with no coins, notice or placard.
# Nothing can complete a goal while the character is away, so a goal met here was met by a newer goal list (a new goal, or a check
# changed so what the pack already holds counts) and loading a save must never change a character's coins (coordinator 24 Nov 2026,
# test_save_9257: the Stone - Knife goal, now made_item or_have, paid an old character who held a knife 10 copper at the join).
func _goals_settle(peer: int) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or _goals_paused(peer):
		return

	var changed: bool = true

	while changed:   # one goal marked done can meet another's check, as in _goals_check
		changed = false

		for goal in _goals_data():
			var id: String = str(goal["id"])

			if st["goals_done"].has(id):
				continue

			var progress: Vector2i = _goal_progress(peer, st, goal.get("check", {}), id)

			if progress.x >= progress.y:
				st["goals_done"][id] = true
				changed = true
				_dirty = true


# The whole list to the client, silently (the join and a reconnect: no placards for goals already done).
func _sync_goals(peer: int, settle: bool = false) -> void:
	if settle:
		_goals_settle(peer)

	if send_goals.is_valid() and not _goal_state_of(peer).is_empty():
		send_goals.call(peer, goals_rows(peer))


# --- Logs from the shoulder and the ground (guide finding F-16, moderator decision for Dave, 31 Oct 2026) ---
# A log is carried on the shoulder (two at most) and a cut log lies on the ground. A craft or blueprint that needs the log group (plain `log`)
# takes its logs in this order: the log on the shoulder, then log items lying on the ground within LOG_NEAR_M of the player, then the pack. The ones taken from the
# shoulder or the ground move into the pack at that moment and are used up by the craft like any ingredient (a craft that is refused takes nothing). The player is told
# "Using nearby logs". Ground logs go with the same authority as a pickup (removed on the server, the clients see them vanish).
const LOG_NEAR_M := 3.0
# The log groups a craft can draw nearby logs for: any log, and since Mission 001 phase 2a the Softwood and Hardwood logs of the saw recipes.
const LOG_GROUP_IDS := ["log", "log_spruce", "log_oak"]


func _log_need(rows: Array, times: int, group_id: String = "log") -> int:
	var log_n: int = table.number_of(group_id)
	var total: int = 0

	for need in rows:
		if int(need[0]) == log_n and log_n > 0:
			total += int(need[1]) * times

	return total


# Log items lying on the ground within reach of the player: [[world id, count], ...], nearest first.
func _ground_logs_near(peer: int, group_id: String = "log") -> Array:
	var out: Array = []

	if not _peer_pos.has(peer):
		return out

	var members: PackedInt32Array = table.group_members(table.number_of(group_id))

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("scatter") or it.has("tree") or it.has("fire") or it.has("struct") or it.has("boulder") or not members.has(int(it.get("number", 0))):
			continue

		var d: float = _peer_pos[peer].distance_to(it["pos"])

		if d <= LOG_NEAR_M:
			out.append([id, int(it["count"]), d])

	out.sort_custom(func(a, b): return float(a[2]) < float(b[2]))
	return out


# How many logs the shoulder and the ground near the player offer.
func logs_near_count(peer: int, group_id: String = "log") -> int:
	var total: int = 0   # the carried log is a pack item and counted with the pack

	for row in _ground_logs_near(peer, group_id):
		total += int(row[1])

	return total


# Moves up to `want` logs (shoulder first, then the ground) into the pack when the pack plus those logs can cover `want`; returns how many moved. Takes nothing when they cannot.
func _pull_nearby_logs(peer: int, inv, want: int, group_id: String = "log") -> int:
	if want <= 0 or inv == null or not _peer_pos.has(peer):
		return 0

	var log_n: int = table.number_of(group_id)

	if inv.count_fill(log_n) + logs_near_count(peer, group_id) < want:
		return 0

	var moved: int = 0

	for row in _ground_logs_near(peer, group_id):
		if moved >= want:
			break

		var it: Dictionary = _items.get(int(row[0]), {})
		var took: int = mini(int(row[1]), want - moved)

		if it.is_empty() or inv.add(int(it["number"]), took, 0, it.get("inst", {})) > 0:
			continue

		if int(it["count"]) > took:
			it["count"] = int(it["count"]) - took
		else:
			_items.erase(int(row[0]))

		moved += took

	if moved > 0:
		_dirty = true
		_say(peer, "Using nearby logs")

	return moved


# Recipe learning (guide finding F-01, LEARN_SYSTEM_SPEC.md; Tyler 31 Oct 2026). A recipe is known when its table row says known (the data decides what a first-day
# player gets), or the character has learned it. Learned recipes are saved with the character (characters.json "learned": recipe numbers).
# A character learns an unknown recipe (1) by discovery: it holds every ingredient and stands at the station the recipe needs; (2) by seeing: the item the recipe
# makes is in the pack. Checked when the recipe is asked for and every LEARN_TICK_S for every player. One line is said: "You work out how to make X".
const LEARN_TICK_S := 10.0
var _learn_clock: float = 0.0


func _learned_of(peer: int) -> Dictionary:
	var key: String = str(_peer_key.get(peer, ""))

	if key == "" or not _characters.has(key):
		return {}

	if typeof(_characters[key].get("learned", null)) != TYPE_DICTIONARY:
		_characters[key]["learned"] = {}

	return _characters[key]["learned"]


func recipe_known_for(peer: int, recipe: Dictionary) -> bool:
	return bool(recipe.get("known", false)) or _learned_of(peer).has(str(int(recipe.get("number", -1))))


# Learns the recipe if the character qualifies; true when it is known afterwards.
func _try_learn(peer: int, inv, recipe: Dictionary) -> bool:
	if recipe_known_for(peer, recipe):
		return true

	if bool(recipe.get("locked", false)):
		return false   # a chain it depends on does not exist yet (recipes.json "locked"): discovery and seeing do not teach it

	var learned: Dictionary = _learned_of(peer)

	if inv == null or recipe.is_empty() or not _characters.has(str(_peer_key.get(peer, ""))):
		return false

	var seen: bool = inv.count_of(int(recipe["gives"][0])) > 0
	var station_ok: bool = str(recipe.get("station", "")) == "" or station_near(peer, str(recipe["station"]), int(recipe.get("station_level", 1)))
	var discovered: bool = station_ok and _pack_covers(inv, recipe, 1)

	if not seen and not discovered:
		return false

	learned[str(int(recipe["number"]))] = true
	_dirty = true
	_say(peer, "You work out how to make %s" % table.in_sentence(str(recipe.get("name", "that"))))
	return true


func _learn_tick() -> void:
	for peer in _peer_key.keys():
		var inv = inventory_of(peer)

		if inv == null or not _peer_pos.has(peer):
			continue

		for number in recipes.numbers():
			var r: Dictionary = recipes.recipe(int(number))

			if not bool(r.get("known", false)):
				_try_learn(peer, inv, r)


# --- Crafting stock (docs/design/INVENTORY_CRAFTING_REPORT.md step 2; src/shared/craft_stock.gd) ---
# A craft draws on the pack, then loose stacks lying within CraftStock.LOOSE_STOCK_M, then the player's own storage containers within
# CraftStock.CRAFT_REACH_M, nearest first, skipping any ticked "keep out". Never a stranger's chest, and never a fire's store (fires are fuel).
# A container gets its owner when it is placed; one saved before that belongs to the first player who opens it.

# A storage container: a placed chest with slots, not a fire's store and not a take-only container (remains).
func _is_storage(it: Dictionary) -> bool:
	if it.has("fire") or not it.has("struct") or not it["struct"].has("uid") or not _chests.has(int(it["struct"]["uid"])) or it["struct"].has("site"):
		return false

	if _smithies.broken_row(it):
		return false   # a worn-out smithy's store is shut to crafting stock, storage views, sites and stacking until it is repaired (master s2.2 item 9)

	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
	return int(def.get("slots", 0)) > 0 and not bool(def.get("take_only", false)) and str(def.get("use", "")) != "serve"   # a Serving Platter is a table display: no crafting stock, no storage views


# The containers a craft or a blueprint site may use: [[world id, inventory, distance, a station's store], ...], containers nearest first, then
# station stores nearest first. `reach_x`: building with a better hammer reaches farther (_hammer_x).
func _craft_boxes(peer: int, reach_x: float = 1.0) -> Array:
	return _stock_of(peer, false, reach_x)["boxes"]


# A loose item that counts as ground stock: not scatter, trees, fires, structures or boulders (the same as building's ground stock).
func _is_loose(it: Dictionary) -> bool:
	return not (it.has("scatter") or it.has("tree") or it.has("fire") or it.has("struct") or it.has("boulder")) and int(it.get("number", 0)) > 0


# One pass over the world items for one craft request: {"boxes": [[world id, inventory, distance], ...] nearest first (_craft_boxes),
# "near": [[world id, distance], ...] the loose items within CraftStock.LOOSE_STOCK_M, nearest first}. The stock functions below take it.
# `from_grid`: look only at the records the last world sync filed in the grid cells within reach (the hammer list's poll, display only: up to
# SYNC_EVERY_S old, so a stack dropped since then shows on the next poll). Taking (crafts, blueprints) always scans every record.
# `reach_x` scales both distances (building with a better hammer, master s2.1). Station stores come after the containers (master s4 item 10:
# pack, ground stock, containers, then station inventories).
func _stock_of(peer: int, from_grid: bool = false, reach_x: float = 1.0) -> Dictionary:
	var stock: Dictionary = {"boxes": [], "near": [], "kitchens": []}

	if not _peer_pos.has(peer):
		return stock

	var key: String = str(_peer_key.get(peer, ""))
	var here: Vector3 = _peer_pos[peer]

	if from_grid and not _sync_grid.is_empty():
		for sid in _stock_cells(here, reach_x):
			if _items.has(sid):   # not taken since the grid was filed
				_stock_note(stock, sid, here, key, reach_x)
	else:
		for sid in _items:
			_stock_note(stock, sid, here, key, reach_x)

	(stock["boxes"] as Array).sort_custom(func(a, b): return [a[3], float(a[2])] < [b[3], float(b[2])])
	(stock["near"] as Array).sort_custom(func(a, b): return float(a[1]) < float(b[1]))
	stock["tanks"] = _piped_tanks(stock["kitchens"])
	return stock


# Files one record into a craft stock when it lies in reach: a loose stack within LOOSE_STOCK_M, or the player's own storage container within
# CRAFT_REACH_M (not kept out). The distance is checked first, so the far records (most of them) cost one subtraction.
func _stock_note(stock: Dictionary, sid: int, here: Vector3, key: String, reach_x: float = 1.0) -> void:
	var s: Dictionary = _items[sid]
	var d: float = (s["pos"] as Vector3).distance_to(here)

	if d > maxf(CraftStock.LOOSE_STOCK_M, CraftStock.CRAFT_REACH_M) * reach_x:
		return

	if not _is_loose(s) and s.has("struct") and not s["struct"].has("site") and bool(_structures.get(str(s["struct"]["kind"]), {}).get("piped_water", false)) and d <= float(_structures[str(s["struct"]["kind"])].get("reach_m", 3.0)) + 1.0:
		(stock["kitchens"] as Array).append(sid)   # a plumbed cooking station the player stands at (its own reach, as station_near); its store still counts below

	if _is_loose(s):
		if d <= CraftStock.LOOSE_STOCK_M * reach_x:
			(stock["near"] as Array).append([sid, d])
	elif _is_storage(s) and not _smelters.is_smelter(_structures.get(str(s["struct"]["kind"]), {})) and CraftStock.box_counts(str(s["struct"].get("owner", "")), bool(s["struct"].get("keep_out", false)), key, d, CraftStock.CRAFT_REACH_M * reach_x):
		(stock["boxes"] as Array).append([sid, _chests[int(s["struct"]["uid"])], d, 1 if _keeps_products(str(s["struct"]["kind"])) else 0, _fuel_slot_kind(_structures.get(str(s["struct"]["kind"]), {}))])


# Loose stacks of an ingredient (or any member of its group: a `log` need takes any log) near the player: [[world id, count], ...], nearest first.
func _craft_ground(stock: Dictionary, number: int, inv, plain_only: bool = false) -> Array:
	var out: Array = []

	if number <= 0 or inv == null:
		return out

	var fills: PackedInt32Array = inv.fills_of(number)

	for row in stock.get("near", []):
		var it: Dictionary = _items.get(int(row[0]), {})

		if not it.is_empty() and fills.has(int(it.get("number", 0))) and not (plain_only and it.has("inst")) and not table.maturing(int(it["number"]), int(it.get("wear", 0))):
			out.append([int(row[0]), int(it["count"])])

	return out


# How much of an ingredient the craft stock holds: the pack, the ground near the player and their containers (`stock` from _stock_of).
# `plain_only` (building costs): units with instance data do not count, so a blueprint never takes one (its site and refund keep counts only).
func _stock_have(inv, number: int, stock: Dictionary, plain_only: bool = false) -> int:
	if inv == null:
		return 0

	var total: int = inv.count_fill(number, plain_only)

	for row in _craft_ground(stock, number, inv, plain_only):
		total += int(row[1])

	for box in stock.get("boxes", []):
		total += _box_fill(box, number, plain_only)

	if not plain_only and number == table.number_of("water"):
		total += _tanks_units(stock.get("tanks", []), number)

	return total


# One craft-stock box's count of an ingredient. A smithy's fuel slot is its fire, not stock: the coal in it is never counted or taken for a craft
# (a recipe that needs Coal used to empty the fire, which then stopped the smithy).
func _box_fill(box: Array, number: int, plain_only: bool) -> int:
	var total: int = box[1].count_fill(number, plain_only)

	if bool(box[4]) and int(box[1].numbers[FUEL_SLOT]) != 0 and box[1].fills_of(number).has(int(box[1].numbers[FUEL_SLOT])) and not (plain_only and not box[1].inst[FUEL_SLOT].is_empty()) and not box[1].maturing_at(FUEL_SLOT):
		total -= int(box[1].counts[FUEL_SLOT])

	return total


# Takes from one craft-stock box, the fuel slot of a smithy left alone (hidden for the take, then put back).
func _stock_box_take(box: Array, number: int, share: int, taken_inst: Array, plain_only: bool) -> bool:
	if not bool(box[4]):
		return box[1].remove_fill(number, share, taken_inst, plain_only)

	var fuel_n: int = int(box[1].numbers[FUEL_SLOT])
	box[1].numbers[FUEL_SLOT] = 0
	var ok: bool = box[1].remove_fill(number, share, taken_inst, plain_only)
	box[1].numbers[FUEL_SLOT] = fuel_n
	return ok


# Takes up to `want` of an ingredient: the pack first, then the ground near the player, then the containers nearest first. Returns how many it took.
func _stock_take(inv, number: int, want: int, stock: Dictionary, taken_inst: Array = [], plain_only: bool = false) -> int:
	if inv == null or want <= 0:
		return 0

	var boxes: Array = stock.get("boxes", [])
	var ground: Array = _spend_sorted(_craft_ground(stock, number, inv, plain_only), number, func(stack): return int(_items[int(stack[0])]["number"]))
	var have: Array = [inv.count_fill(number, plain_only)]

	for row in ground:
		have.append(int(row[1]))

	for box in boxes:
		have.append(_box_fill(box, number, plain_only))

	var plan: Array = CraftStock.take_plan(want, have)
	var took: int = 0

	if int(plan[0]) > 0 and inv.remove_fill(number, int(plan[0]), taken_inst, plain_only):
		took += int(plan[0])

	for i in ground.size():
		var share: int = int(plan[1 + i])
		var it: Dictionary = _items.get(int(ground[i][0]), {})

		if share <= 0 or it.is_empty():
			continue

		taken_inst.append([int(it["number"]), it.get("inst", {}).duplicate(true), int(it.get("wear", 0)), share])

		if int(it["count"]) > share:
			it["count"] = int(it["count"]) - share
		else:
			_items.erase(int(ground[i][0]))

		took += share
		_dirty = true

	for i in boxes.size():
		var share: int = int(plan[1 + ground.size() + i])

		var rows_before: int = taken_inst.size()

		if share > 0 and _stock_box_take(boxes[i], number, share, taken_inst, plain_only):
			took += share

			for k in range(rows_before, taken_inst.size()):   # water taken from this chest's containers goes back there on a refund (_pour_back)
				if (taken_inst[k][1] as Dictionary).has("liquid_ml"):
					taken_inst[k][1]["box"] = int(boxes[i][0])
					taken_inst[k][1]["uid"] = int(_items[int(boxes[i][0])]["struct"]["uid"])

			_push_box(int(boxes[i][0]), boxes[i][1])   # whoever has that chest open sees it go
			_dirty = true

	if took < want and not plain_only and number == table.number_of("water"):
		took += _take_piped_water(number, want - took, stock.get("tanks", []), taken_inst)

	return took


# Piped water at the cooking stations (Dave 20 Nov 2026: "we could also plumb into advanced cooking stations so they could draw water from the rain water
# and pipe system"; coordinator 21-22 Nov, PLUMBING_DESIGN s10, PV-14 PROVISIONAL): a station with structures.json "piped_water" that has a Copper - Tap
# or an open pipe end within PIPED_WATER_M of it draws from the tank that tap or pipe reaches. The tanks those stations reach, no repeats.
const PIPED_WATER_M := 2.0

func _piped_tanks(kitchens: Array) -> Array:
	var tanks: Array = []

	if kitchens.is_empty():
		return tanks

	for wid in _water_kind:
		if not _items.has(wid):
			continue

		var def: Dictionary = _structures.get(str(_water_kind[wid]), {})
		var points: Array = []

		if str(def.get("use", "")) == "tap":
			points = [_items[wid]["pos"]]
		elif str(def.get("hand_laid", "")) == "pipe" and (_water._down.get(int(wid), []) as Array).is_empty():
			points = pipe_ends(_items[wid])   # an open pipe: its water goes nowhere else (no tap, barrel or pipe on its far end)
		else:
			continue

		var close: bool = false

		for k in kitchens:
			for point in points:
				close = close or (point as Vector3).distance_to(_items[int(k)]["pos"]) <= PIPED_WATER_M

		if close:
			var tank: int = _tap_supply(int(wid))

			if tank >= 0 and not tanks.has(tank):
				tanks.append(tank)

	return tanks


# Whole units of a liquid the tanks hold, each tank on its own (as _take_piped_water takes them): two tanks of 300 mL make no 500 mL unit.
func _tanks_units(tanks: Array, number: int) -> int:
	var unit: float = float(maxi(table.liquid_unit_ml(number), 1))
	var now_s: float = _water_now_s()
	var units: int = 0

	for tank in tanks:
		units += floori(floorf(_water.litres(int(tank), now_s) * 1000.0) / unit)

	return units


# Takes up to `want` units of water out of the tanks (nearest list order), as liquid rows a refund pours back into containers (never the stackable item).
func _take_piped_water(number: int, want: int, tanks: Array, taken_inst: Array) -> int:
	var unit: int = maxi(table.liquid_unit_ml(number), 1)
	var now_s: float = _water_now_s()
	var took: int = 0

	if tanks.is_empty():
		return 0

	_water_resolve(now_s)   # the tanks' litres are brought to now before any is taken

	for tank in tanks:
		var held_ml: int = int(floor(_water.litres(int(tank), now_s) * 1000.0))
		var units: int = mini(want - took, floori(float(held_ml) / float(unit)))

		if units <= 0:
			continue

		_water.set_litres(int(tank), float(held_ml - units * unit) / 1000.0)
		taken_inst.append([number, {"liquid_ml": units * unit, "tank": int(tank)}, 0, units])   # a refund fills this tank back first (_pour_back)
		took += units
		_water_dirty = true

		if took >= want:
			break

	return took


# Does the craft stock hold everything `times` crafts of a recipe need (kept tools once)?
func _stock_covers(inv, recipe: Dictionary, times: int, stock: Dictionary) -> bool:
	for need in recipe["needs"]:
		if _stock_have(inv, int(need[0]), stock) < int(need[1]) * clampi(times, 1, CRAFT_QUEUE_MAX_COUNT):
			return false

	for keep in recipe["keeps"]:
		if _stock_have(inv, int(keep[0]), stock) < int(keep[1]):
			return false

	return true


# The world ids the last sync filed in the grid cells that a craft's reach around `here` touches (one to four NEAR_M cells).
func _stock_cells(here: Vector3, reach_x: float = 1.0) -> Array:
	return _cells_near(here, maxf(CraftStock.LOOSE_STOCK_M, CraftStock.CRAFT_REACH_M) * reach_x)


# The world ids the last sync filed in the NEAR_M grid cells that a reach around `here` touches.
func _cells_near(here: Vector3, reach: float) -> Array:
	var lo: Vector2i = Vector2i(int(floor((here.x - reach) / NEAR_M)), int(floor((here.z - reach) / NEAR_M)))
	var hi: Vector2i = Vector2i(int(floor((here.x + reach) / NEAR_M)), int(floor((here.z + reach) / NEAR_M)))
	var out: Array = []

	for cx in range(lo.x, hi.x + 1):
		for cz in range(lo.y, hi.y + 1):
			out.append_array(_sync_grid.get(Vector2i(cx, cz), []))

	return out


const STOCK_POLL_MS := 500   # a hammer poll is answered at most this often per player


# What a craft may use besides the pack, sent to the player (protocol 98) when their crafting window opens (ACT_CRAFT_STOCK), after each craft
# request and after a "keep out" change: item number -> count, the ground near them and their containers in reach. The client adds the pack.
# `poll` (the hammer list while the player walks, ACT_CRAFT_STOCK a = 1): at most once per STOCK_POLL_MS, from the sync grid, and nothing is sent
# when the stock is what this player was last sent (the client keeps the old counts).
func _send_stock(peer: int, poll: bool = false, building: bool = false) -> void:
	if not send_craft_stock.is_valid() or not _peer_pos.has(peer):
		return

	var now_ms: int = Time.get_ticks_msec()

	if poll and now_ms - int(_stock_poll_ms.get(peer, -STOCK_POLL_MS)) < STOCK_POLL_MS:
		return

	if poll:
		_stock_poll_ms[peer] = now_ms

	var counts: Dictionary = {}
	var stock: Dictionary = _stock_of(peer, poll, _hammer_x(peer) if poll or building else 1.0)   # the hammer list counts what that hammer reaches (master s2.1)

	for row in stock["near"]:
		var it: Dictionary = _items[int(row[0])]
		counts[int(it["number"])] = int(counts.get(int(it["number"]), 0)) + int(it["count"])

	for box in stock["boxes"]:
		for slot in box[1].slot_count:
			if int(box[1].numbers[slot]) != 0 and not (bool(box[4]) and slot == FUEL_SLOT):   # a smithy's fuel slot is its fire, not crafting stock
				counts[int(box[1].numbers[slot])] = int(counts.get(int(box[1].numbers[slot]), 0)) + int(box[1].counts[slot])

		var water_n: int = table.number_of("water")
		var water_units: int = box[1].liquid_units(water_n)   # filled containers in the chest fill the water ingredient too (GA-04)

		if water_units > 0:
			counts[water_n] = int(counts.get(water_n, 0)) + water_units

	var piped_units: int = _tanks_units(stock.get("tanks", []), table.number_of("water"))   # the water a plumbed cooking station draws (PV-14)

	if piped_units > 0:
		counts[table.number_of("water")] = int(counts.get(table.number_of("water"), 0)) + piped_units

	var numbers: PackedInt32Array = PackedInt32Array()
	var amounts: PackedInt32Array = PackedInt32Array()

	var listed: Array = counts.keys()
	listed.sort()   # one order whatever the scan order, so an unchanged stock hashes the same

	for number in listed:
		numbers.append(int(number))
		amounts.append(int(counts[number]))

	var sig: int = hash([numbers, amounts])

	if poll and int(_stock_sig.get(peer, 0)) == sig:
		return

	_stock_sig[peer] = sig
	send_craft_stock.call(peer, numbers, amounts)


# The open container's "keep out" tick to the player, and whether they may change it (their own storage container).
func _send_chest_info(peer: int, id: int) -> void:
	if not send_chest_info.is_valid():
		return

	var it: Dictionary = _items.get(id, {})
	var storage: bool = not it.is_empty() and _is_storage(it)
	var mine: bool = storage and CraftStock.owner_ok(str(it["struct"].get("owner", "")), str(_peer_key.get(peer, "")))
	send_chest_info.call(peer, id, storage and bool(it["struct"].get("keep_out", false)), mine)


# ACT_CHEST_KEEP_OUT: the owner ticks (b = 1) or clears (b = 0) "keep out" on one of their containers within reach; crafting and blueprint
# sites then leave it alone. Saved with the container (world_items.json row index 16).
func _set_keep_out(peer: int, id: int, on: bool) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not _is_storage(it) or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(it["pos"]) > CHEST_REACH_M:
		return

	if not CraftStock.owner_ok(str(it["struct"].get("owner", "")), str(_peer_key.get(peer, ""))):
		_say(peer, "Only the owner can change that.")
		return

	if on:
		it["struct"]["keep_out"] = true
	else:
		it["struct"].erase("keep_out")

	_dirty = true
	_send_chest_info(peer, id)
	_send_stock(peer)


# --- Code locks and storage views (master s3.13 [D13]; docs/design/STORAGE_WAREHOUSING_DESIGN.md s4 to s6; Mission 001 phase 9) ---
# A lockable container (structures.json "lockable": the chests and crates) is open to anyone until its owner sets a four-digit code (0000 to 9999,
# kept as four characters). The owner always opens it without the code. Anyone else gets in once they enter the current code (their own access, not
# the container's: it stays locked for everyone else) or when the owner lets them in. A wrong code makes that player wait 10 s times their
# consecutive failures on that container before the next try, as a wall-clock deadline saved with the container, so a reconnect, a restart or
# another interface never resets it; the right code resets the count. Changing the code drops the code-based access; owner grants stay.
# struct["lock"] = {"salt", "hash" (sha256 of salt and code: the code itself is never saved or sent), "ok": [keys that entered this code],
# "allow": [keys the owner let in], "tries": {key: [consecutive failures, unix deadline]}}; saved as world_items.json row index 17.
# _may_access is the one check: _chest_of (open, put, take, Take all, Store all, Sort), _push_box, take-down, repair sourcing and the storage views.
# Craft and blueprint-site sourcing and Stack to nearby already use only the player's own containers (CraftStock.owner_ok), so they never pass a lock.
# Phase 10 (loaded crates lifted onto a cart) calls _may_access before it lifts or loads one; the lock rides in the struct with the crate.
const LOCK_SET := 0       # ACT_CHEST_LOCK b: the owner sets or changes the code (count = 0 to 9999)
const LOCK_CLEAR := 1     # the owner takes the lock off (open to anyone again; every grant and wait goes with it)
const LOCK_TRY := 2       # anyone else enters a code (count = 0 to 9999)
const LOCK_ALLOW := 3     # the owner lets in the nearest other player standing within CHEST_REACH_M of the container
const LOCK_REVOKE := 4    # the owner withdraws every grant and every code-based access
const LOCK_WAIT_STEP_S := 10.0   # the owner's rule: 10 s after the first wrong code, 20 s after the second, and so on, with no cap


# The code as saved and compared: four digit characters, leading zeros kept ("0042"); "" for a value outside 0 to 9999.
static func lock_code(value: int) -> String:
	return "%04d" % value if value >= 0 and value <= 9999 else ""


static func _code_hash(salt: String, code: String) -> String:
	return (salt + ":" + code).sha256_text()


func _lock_of(it: Dictionary) -> Dictionary:
	return it.get("struct", {}).get("lock", {})


# Whether this player may open and use a container: no lock, or they are its owner, entered the current code, or were let in.
func _may_access(peer: int, it: Dictionary) -> bool:
	var lock: Dictionary = _lock_of(it)

	if lock.is_empty():
		return true

	var key: String = str(_peer_key.get(peer, ""))
	return key != "" and (key == str(it["struct"].get("owner", "")) or (lock.get("ok", []) as Array).has(key) or (lock.get("allow", []) as Array).has(key))


# Seconds this character must still wait before trying a code on this container (0: may try).
func _lock_wait_s(it: Dictionary, key: String) -> float:
	var row: Array = _lock_of(it).get("tries", {}).get(key, [])
	return maxf(float(row[1]) - _unix(), 0.0) if row.size() == 2 else 0.0


# A saved lock, checked field by field; {} when it is not a usable lock (the loader then fails closed for an owned container: owner only).
func _clean_lock(raw: Variant) -> Dictionary:
	if typeof(raw) != TYPE_DICTIONARY or typeof(raw.get("salt")) != TYPE_STRING or typeof(raw.get("hash")) != TYPE_STRING or str(raw["hash"]).length() != 64:
		return {}

	var lock: Dictionary = {"salt": str(raw["salt"]), "hash": str(raw["hash"]), "ok": [], "allow": [], "tries": {}}

	for field in ["ok", "allow"]:
		if typeof(raw.get(field)) == TYPE_ARRAY:
			for key in raw[field]:
				if typeof(key) == TYPE_STRING and str(key) != "" and not (lock[field] as Array).has(str(key)):
					(lock[field] as Array).append(str(key))

	if typeof(raw.get("tries")) == TYPE_DICTIONARY:
		for key in raw["tries"]:
			var row: Variant = raw["tries"][key]

			if typeof(row) == TYPE_ARRAY and (row as Array).size() == 2 and int(row[0]) > 0:
				lock["tries"][str(key)] = [int(row[0]), float(row[1])]

	return lock


# The lock as this player sees it (protocol 108 chest_lock): whether it has a code, whether they own it, whether they may open it, how long
# before their next try, and (to the owner only) how many other players have access. Never the code. Lockable containers only.
func _send_lock_info(peer: int, id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if not send_chest_lock.is_valid() or it.is_empty() or not bool(_structures.get(str(it.get("struct", {}).get("kind", "")), {}).get("lockable", false)):
		return

	var lock: Dictionary = _lock_of(it)
	var key: String = str(_peer_key.get(peer, ""))
	var mine: bool = key != "" and key == str(it["struct"].get("owner", ""))
	var others: int = (lock.get("ok", []) as Array).size() + (lock.get("allow", []) as Array).size() if mine else 0
	send_chest_lock.call(peer, id, not lock.is_empty(), mine, _may_access(peer, it), int(ceil(_lock_wait_s(it, key))), others)


# ACT_CHEST_LOCK: a = the container's world id, b = LOCK_* operation, count = the code for LOCK_SET and LOCK_TRY. Within chest reach only.
func _lock_action(peer: int, inv, id: int, op: int, value: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not _is_storage(it) or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(it["pos"]) > CHEST_REACH_M:
		return

	if not bool(_structures.get(str(it["struct"]["kind"]), {}).get("lockable", false)):
		_say(peer, "This cannot be locked.")
		return

	var key: String = str(_peer_key.get(peer, ""))
	var mine: bool = key != "" and key == str(it["struct"].get("owner", ""))
	var lock: Dictionary = _lock_of(it)

	if op == LOCK_TRY:
		_lock_try(peer, inv, id, it, key, value)
		return

	if not mine:
		_say(peer, "Only the owner can change the lock.")
		_send_lock_info(peer, id)
		return

	if op == LOCK_SET:
		var code: String = lock_code(value)

		if code == "":
			_reject(peer, 3)
			return

		var salt: String = "%08x%08x" % [randi(), randi()]   # luck-exempt: a lock's hash salt, no outcome
		it["struct"]["lock"] = {"salt": salt, "hash": _code_hash(salt, code), "ok": [], "allow": lock.get("allow", []), "tries": lock.get("tries", {})}   # a new code drops code-based access
		_say(peer, "Locked with a four-digit code. Only you, those you let in and those who know the code can open it.")
		_goal_event(peer, "container_locked")   # ADD-14: the owner set a valid four-digit code
	elif op == LOCK_CLEAR:
		it["struct"].erase("lock")
		_say(peer, "The lock is off: anyone can open it.")
	elif op == LOCK_ALLOW:
		if lock.is_empty():
			_say(peer, "Set a code first: an unlocked container is open to everyone.")
		else:
			var guest: String = _nearest_other_key(peer, it["pos"])

			if guest == "":
				_say(peer, "Nobody else is standing by it.")
			elif not (lock["allow"] as Array).has(guest):
				(lock["allow"] as Array).append(guest)
				_say(peer, "The player beside it can now open it.")
	elif op == LOCK_REVOKE:
		if not lock.is_empty():
			lock["ok"] = []
			lock["allow"] = []
			_say(peer, "Only you can open it now.")
	else:
		return

	_dirty = true
	_lock_changed(id)


# A code entered by anyone but the owner: refused while their wait runs (not counted), right opens it for them, wrong counts and starts the wait.
func _lock_try(peer: int, inv, id: int, it: Dictionary, key: String, value: int) -> void:
	var lock: Dictionary = _lock_of(it)

	if lock.is_empty() or _may_access(peer, it) or key == "":
		_chest_action(peer, inv, Net.ACT_CHEST_OPEN, id, 0, 0)   # nothing to enter: it opens as usual
		return

	var wait: float = _lock_wait_s(it, key)

	if wait > 0.0:
		_say(peer, "Wait %d seconds before trying again." % int(ceil(wait)))
		_send_lock_info(peer, id)
		return

	var code: String = lock_code(value)
	_dirty = true

	if code != "" and _code_hash(str(lock["salt"]), code) == str(lock["hash"]):
		(lock["ok"] as Array).append(key)
		(lock["tries"] as Dictionary).erase(key)
		_chest_action(peer, inv, Net.ACT_CHEST_OPEN, id, 0, 0)
		return

	var fails: int = int((lock["tries"] as Dictionary).get(key, [0, 0.0])[0]) + 1
	lock["tries"][key] = [fails, _unix() + LOCK_WAIT_STEP_S * fails]
	_say(peer, "Wrong code. Wait %d seconds before trying again." % int(LOCK_WAIT_STEP_S * fails))
	_send_lock_info(peer, id)


# After a lock change: the owner sees the new state, and anyone who has the container open and lost access is shut out of it.
func _lock_changed(id: int) -> void:
	for viewer in _chest_viewer.keys():
		if int(_chest_viewer[viewer]) == id:
			if not _may_access(viewer, _items[id]):
				_chest_viewer.erase(viewer)

			_send_lock_info(viewer, id)

	var owner_key: String = str(_items[id]["struct"].get("owner", ""))

	for viewer in _peer_key:
		if str(_peer_key[viewer]) == owner_key and int(_chest_viewer.get(viewer, 0)) != id:
			_send_lock_info(viewer, id)


# The key of the other player standing nearest `at` within CHEST_REACH_M, or "".
func _nearest_other_key(peer: int, at: Vector3) -> String:
	var best: String = ""
	var best_d: float = CHEST_REACH_M

	for other in _peer_pos:
		var d: float = (_peer_pos[other] as Vector3).distance_to(at)

		if other != peer and d <= best_d and not (str(_peer_key.get(other, "")) in ["", str(_peer_key.get(peer, ""))]):
			best = str(_peer_key[other])
			best_d = d

	return best


# --- Storage views: the Storage sign and the Warehouse desk (s3.13: views over nearby physical containers, never a second store) ---
# A structure with "use": "storage_view" shows the containers within its "view_m" that it holds the context of: each container belongs to at
# most one view, the one with the highest "view_rank" covering it (a desk, 2, before a sign, 1), then the nearest, then the lowest world id.
# It lists, deposits and withdraws only through containers this player may open (_may_access), so a lock is never passed and hidden contents
# never show, not even in the totals. Every transfer is the containers' own put and take (_box_put, _box_take), so their rules stay.

func _view_def(it: Dictionary) -> Dictionary:
	if not it.has("struct") or it["struct"].has("site"):
		return {}

	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
	return def if str(def.get("use", "")) == "storage_view" else {}


# The widest view radius in structures.json (how far another view can stand and still claim a container this view could see).
func _view_reach_max() -> float:
	var most: float = 0.0

	for kind in _structures:
		most = maxf(most, float(_structures[kind].get("view_m", 0.0)))

	return most


# The containers view `vid` holds the context of and this player may open: [[world id, inventory, metres from the view], ...], nearest first.
func _view_boxes(peer: int, vid: int) -> Array:
	var view: Dictionary = _items.get(vid, {})
	var def: Dictionary = _view_def(view)

	if def.is_empty():
		return []

	var here: Vector3 = view["pos"]
	var radius: float = float(def.get("view_m", 0.0))
	var reach: float = radius + _view_reach_max()
	var views: Array = []   # [world id, position, radius, rank] of every view that could claim a container in this one's circle
	var boxes: Array = []

	# shortcut: one pass over every world record per view action (as _stock_of without its grid), unmeasured; revisit with the sync grid if a busy town shows it in the slow-action line.
	for sid in _items:
		var s: Dictionary = _items[sid]
		var d: float = (s["pos"] as Vector3).distance_to(here)

		if d > reach:
			continue

		var other: Dictionary = _view_def(s)

		if not other.is_empty():
			views.append([int(sid), s["pos"], float(other.get("view_m", 0.0)), int(other.get("view_rank", 0))])
		elif d <= radius and _is_storage(s) and not s["struct"].has("on") and _carts.vehicle_of(s).is_empty():   # a cart and the crates riding on it are in transit: no view holds them
			boxes.append([int(sid), d])

	var out: Array = []

	for row in boxes:
		var s: Dictionary = _items[int(row[0])]

		if _view_holder(s["pos"], views) == vid and _may_access(peer, s):
			var box = _chests[int(s["struct"]["uid"])]
			box.usable = _store_usable(str(s["struct"]["kind"]), box)
			out.append([int(row[0]), box, float(row[1])])

	out.sort_custom(func(a, b): return float(a[2]) < float(b[2]) or (float(a[2]) == float(b[2]) and int(a[0]) < int(b[0])))
	return out


# The view a container at `at` belongs to (0 none): the highest rank covering it, then the nearest, then the lowest id.
static func _view_holder(at: Vector3, views: Array) -> int:
	var best: Array = []

	for v in views:
		var d: float = (v[1] as Vector3).distance_to(at)

		if d > float(v[2]):
			continue

		var rank: Array = [-int(v[3]), d, int(v[0])]

		if best.is_empty() or rank < best:
			best = rank

	return 0 if best.is_empty() else int(best[2])


# The view within reach of the player, or {} (and the client hears "too far").
func _view_in_reach(peer: int, vid: int) -> Dictionary:
	var it: Dictionary = _items.get(vid, {})

	if _view_def(it).is_empty() or not _peer_pos.has(peer):
		return {}

	if _peer_pos[peer].distance_to(it["pos"]) > Interact.server_reach_m() + 1.0:
		_reject_far(peer)
		return {}

	return it


# ACT_VIEW_OPEN, and the answer after every view transfer: item number and total over the containers this player may open (storage_view).
func _view_open(peer: int, vid: int) -> void:
	if _view_in_reach(peer, vid).is_empty() or not send_storage_view.is_valid():
		return

	var boxes: Array = _view_boxes(peer, vid)
	var totals: Dictionary = {}

	for row in boxes:
		for slot in _store_span(int(row[0]), row[1]):   # a station's output slots too
			if int(row[1].numbers[slot]) != 0:
				totals[int(row[1].numbers[slot])] = int(totals.get(int(row[1].numbers[slot]), 0)) + int(row[1].counts[slot])

	var listed: Array = totals.keys()
	listed.sort()
	var numbers: PackedInt32Array = PackedInt32Array()
	var counts: PackedInt32Array = PackedInt32Array()

	for number in listed:
		numbers.append(int(number))
		counts.append(int(totals[number]))

	send_storage_view.call(peer, vid, numbers, counts, boxes.size())


# ACT_VIEW_TAKE: up to `count` of item `number` from the view's containers into the pack, nearest container first.
func _view_take(peer: int, inv, vid: int, number: int, count: int) -> void:
	if _view_in_reach(peer, vid).is_empty() or number <= 0:
		return

	var left: int = count

	for row in _view_boxes(peer, vid):
		var took_here: bool = false

		for slot in _store_span(int(row[0]), row[1]):   # a station's output slots too
			if left <= 0:
				break

			if int(row[1].numbers[slot]) == number:
				var asked: int = mini(left, int(row[1].counts[slot]))
				var took: int = _box_take(peer, inv, row[1], slot, left)
				left -= took
				took_here = took_here or took > 0

				if took < asked:
					left = 0   # the pack, the carry limit or the shoulder is full (and said so once): stop rather than try every slot

		if took_here:
			_push_box(int(row[0]), row[1])

		if left <= 0:
			break

	_view_open(peer, vid)


# ACT_VIEW_PUT: pack slot `slot` (up to `count`) into the view's containers that take it, those already holding the item first, nearest first.
# Slot -1 deposits every pack stack (not a favourite, not an instance, not the shoulder log) whose item one of those containers already holds.
func _view_put(peer: int, inv, vid: int, slot: int, count: int) -> void:
	if _view_in_reach(peer, vid).is_empty():
		return

	var boxes: Array = _view_boxes(peer, vid)

	if slot == -1:
		for s in inv.slot_count:
			var number: int = inv.numbers[s]

			if number != 0 and not inv.is_fav(s) and inv.inst_of(s).is_empty() and not is_shoulder_item(number) and boxes.any(func(row): return row[1].count_of(number) > 0):
				_view_put_slot(peer, inv, boxes, s, inv.counts[s], true)
	elif slot >= 0 and slot < inv.slot_count and inv.numbers[slot] != 0:
		_view_put_slot(peer, inv, boxes, slot, count, false)

	_view_open(peer, vid)


func _view_put_slot(peer: int, inv, boxes: Array, slot: int, count: int, holding_only: bool) -> void:
	var number: int = inv.numbers[slot]
	var order: Array = boxes.filter(func(row): return row[1].count_of(number) > 0)

	if not holding_only:
		order.append_array(boxes.filter(func(row): return row[1].count_of(number) <= 0))

	var want: int = mini(count, inv.counts[slot])
	var left: int = want

	for row in order:
		if left <= 0 or inv.numbers[slot] != number:
			break

		var kind: String = str(_items[int(row[0])]["struct"]["kind"])

		if not _box_takes(kind, number) or _box_room(int(row[0]), number, left) == 0:
			continue   # the next container may take it: no refusal is said for this one

		var put: int = _box_put(peer, inv, int(row[0]), row[1], slot, left)
		left -= put

		if put > 0:
			_push_box(int(row[0]), row[1])

	if left == want and not holding_only:
		_say(peer, "No container here takes that, or they are all full.")
		_reject(peer, 2)


# --- Hotbar (Dave, playtest 12 Nov 2026 TEST-008/006; replaces the 8 Nov pointer hotbar, OVERNIGHT_DECISIONS_8NOV.md row 24) ---
# Keys 1 to 9 and 0 are the pack's slots 0 to 9 (Inventory.pack): real slots, so an item is on the hotbar or in the backpack, never both, and a
# slot whose item is dropped, sold or used up is simply empty. ACT_MOVE moves stacks between them. A tool or weapon that newly enters the pack
# goes into the first empty hotbar slot by itself.

# Whether an item goes into a free hotbar slot by itself when it comes into the pack: tools and weapons (torch included), not food, clothing or materials.
func _autofills(number: int) -> bool:
	return number > 0 and str(table.entry(table.id_of(number)).get("kind", "")) in ["tool", "weapon"]


# A character saved under the pointer hotbar (8 Nov to 12 Nov 2026) kept its keys as item numbers in characters.json "hotbar": each key's item
# moves from the backpack into its hotbar slot once (swapping with what is there), so a playtest world keeps its hotbar; then the key list is dropped.
func _adopt_pointer_hotbar(key: String) -> void:
	var saved: Variant = _characters[key].get("hotbar", null)
	_characters[key].erase("hotbar")

	if not saved is Array:
		return

	var inv = _inventories[key]
	_dirty = true

	for k in mini((saved as Array).size(), inv.hotbar_slots):
		var number: int = table.current_number(int(saved[k]))

		if number > 0 and inv.numbers[k] != number:
			var at: int = inv.numbers.find(number, k + 1)   # anywhere after this key (the old pack filled from slot 0), so a key already placed is never disturbed

			if at >= 0:
				inv.move(at, k)


# A tool or weapon newly in the pack (picked up, crafted, taken from a chest; its kind was not in the pack before) that landed in the
# backpack moves into the first empty hotbar slot. `before` is the pack's item numbers before the change.
func _hotbar_autofill(inv, before: PackedInt32Array) -> void:
	var moved: Array = []

	for slot in range(inv.hotbar_slots, inv.slot_count):
		var number: int = inv.numbers[slot]

		if number == 0 or before.has(number) or moved.has(number) or not _autofills(number):
			continue   # one of a new kind goes up; a second one that came in the same change stays in the backpack

		var empty_key: int = inv.numbers.slice(0, inv.hotbar_slots).find(0)

		if empty_key < 0:
			return

		inv.move(slot, empty_key)
		moved.append(number)


# --- Bulk buttons (docs/design/INVENTORY_CRAFTING_REPORT.md step 3; decisions in docs/design/OVERNIGHT_DECISIONS_8NOV.md row 23) ---
# ACT_BULK a = kind: Take all and Store all work on the open container; Stack to nearby needs none (the player's own storage chests within
# CraftStock.CRAFT_REACH_M that already hold the item; keep out does not block stacking in); Sort reorders the pack (and an open storage chest)
# by the client's sort key b. Favourites and the hotbar slots are never moved or stored. The player is told what happened (bulk_done).
const BULK_TAKE_ALL := 0
const BULK_STORE_ALL := 1
const BULK_STACK_NEARBY := 2
const BULK_SORT := 3


func _bulk(peer: int, inv, kind: int, sort_key: int) -> void:
	var stacks: int = 0
	var touched: Array = []
	var open_id: int = int(_chest_viewer.get(peer, 0))
	var open_box = _chest_of(peer, open_id) if open_id != 0 else null

	if kind == BULK_TAKE_ALL or kind == BULK_STORE_ALL:
		if open_box == null:
			return

		stacks = _bulk_take_all(peer, inv, open_id, open_box) if kind == BULK_TAKE_ALL else _bulk_store_all(peer, inv, open_id, open_box)

		if stacks > 0:
			touched.append(open_id)
	elif kind == BULK_STACK_NEARBY:
		var result: Array = _bulk_stack_nearby(peer, inv)
		stacks = int(result[0])
		touched = result[1]
	elif kind == BULK_SORT:
		stacks = _sort_slots(inv, inv.hotbar_slots, inv.slot_count, sort_key, true)

		if open_box != null and _is_storage(_items.get(open_id, {})):
			var sort_from: int = FUEL_SLOT + 1 if _fuel_slot_kind(_structures.get(str(_items[open_id]["struct"]["kind"]), {})) else 0   # a smithy's fuel slot stays where it is
			stacks += _sort_slots(open_box, sort_from, open_box.usable, sort_key, false)   # favourites are the pack's only
			_push_box(open_id, open_box)
			touched.append(open_id)
	else:
		return

	_dirty = true

	if send_bulk_done.is_valid():
		send_bulk_done.call(peer, kind, stacks, touched.size(), PackedInt32Array(touched))


# Take all: every stack of the open container that fits in the pack and under the carry limit (the rules of one take). A large log goes on the
# shoulder, not in the pack, so Take all leaves logs where they are. Returns the stacks moved.
func _bulk_take_all(peer: int, inv, id: int, box) -> int:
	var moved: int = 0

	for slot in _store_span(id, box):   # a station's output slots too
		if box.numbers[slot] == 0 or is_shoulder_item(box.numbers[slot]):
			continue

		var had: int = box.counts[slot]
		_chest_action(peer, inv, Net.ACT_CHEST_TAKE, slot, id, had)

		if box.numbers[slot] == 0 or box.counts[slot] < had:
			moved += 1

	return moved


# Store all: every pack stack that is not a favourite and not the log on the shoulder, into the open container (the rules of one put:
# a fire takes only wood and food, a take-only container nothing, a vehicle up to its payload). Returns the stacks moved.
func _bulk_store_all(peer: int, inv, id: int, _box) -> int:
	var it: Dictionary = _items.get(id, {})
	var def: Dictionary = _structures.get(str(it.get("struct", {}).get("kind", "")), {})

	if bool(def.get("take_only", false)):
		return 0

	var moved: int = 0

	for slot in range(inv.hotbar_slots, inv.slot_count):
		var number: int = inv.numbers[slot]

		if number == 0 or inv.is_fav(slot) or is_shoulder_item(number) or (it.has("fire") and not _fire_takes(table.id_of(number))) or not _box_takes(str(it.get("struct", {}).get("kind", "")), number) or (id < 0 and _bag_refusal(peer, id, number) != ""):
			continue

		if _box_room(id, number, inv.counts[slot]) == 0:
			continue   # no room for this item (a vehicle's payload, a bin, kiln or smelter): another may still go in, and the refusal is not said once per stack

		var had: int = inv.counts[slot]
		_chest_action(peer, inv, Net.ACT_CHEST_PUT, slot, id, had)

		if inv.numbers[slot] != number or inv.counts[slot] < had:
			moved += 1

	return moved


# How many of `amount` a storage container still takes: what it takes, a kiln's, smelter's or bin's room, and a vehicle's payload (a vehicle's
# store or a crate riding on one); storage itself has no weight limit (Dave 19 Nov 2026).
func _box_room(sid: int, number: int, amount: int) -> int:
	if not _box_takes(str(_items.get(sid, {}).get("struct", {}).get("kind", "")), number):
		return 0   # what the container does not take (structures.json takes): a sealed batch never goes into a Stone bin

	var box = _chests.get(int(_items.get(sid, {}).get("struct", {}).get("uid", -1)))
	amount = _kiln_room(sid, box, number, amount)
	var sdef: Dictionary = _structures.get(str(_items.get(sid, {}).get("struct", {}).get("kind", "")), {})

	if _smelters.is_smelter(sdef):
		amount = _smelters.room(sdef, box, number, amount)

	if BinRules.is_bin(sdef) and box != null:
		amount = BinRules.room(sdef, box, number, amount)

	var cart_room: float = _carts.room_kg(sid)

	if cart_room == INF or _carry_cfg.is_empty() or box == null:
		return amount

	var each: float = maxf(CarryRules.weight_of(table.id_of(number), _carry_cfg), 0.001)
	return clampi(int(floor(cart_room / each + 0.0001)), 0, amount)


# --- Autoload (Dave 19 Nov 2026: "an autoload button on carts and wagons or barrels and such ... everything on the ground around you within say
# 30 meters in a list where you could choose an item and it would just pick up as much of it as it can until it fills the capacity or the weight
# limit"; "maybe just have autoload with a check box beside it to make it continuously autoload every 10 minutes or something") ---
# ACT_AUTOLOAD a = the container, b = the item (0 stops its standing autoload), count = 1 also keeps it loading that item every AUTOLOAD_EVERY_S.
# One request, all on the server: the ground piles of that item within AUTOLOAD_M of the container go in nearest first, each pile in part when
# only part fits, under the container's own rules (what it takes, its slots, a vehicle's payload: _box_room); which containers: StoreRules.autoloads.
# Provisional choices AL-1 to AL-5: docs/design/AUTOLOAD.md.
const AUTOLOAD_M := 30.0
const AUTOLOAD_EVERY_S := 600.0       # the standing autoload's round, real seconds (Dave: "every 10 minutes or something")
const AUTOLOAD_PRESS_MS := 250        # a player's presses are answered at most this often (each is one scan of the ground near the container)
var _autoload_in: float = AUTOLOAD_EVERY_S
var _autoload_pressed: Dictionary = {}   # peer -> Time.get_ticks_msec() of their last answered press
var send_autoload_info: Callable         # (peer, world id, item number or 0): the open container's standing autoload (protocol 139)


# Whether a world record is a container Autoload fills.
func _autoloads(it: Dictionary) -> bool:
	return _is_storage(it) and StoreRules.autoloads(_structures.get(str(it["struct"]["kind"]), {}))


# A loose ground record Autoload may take: not a placed thing, a tree, a boulder, a fire, the showroom, an arrow in a tree or a piece still falling.
func _autoload_takes_from(it: Dictionary) -> bool:
	return not (it.has("showroom") or it.has("tilt") or it.has("fall")) and (_is_loose(it) or (it.has("scatter") and int(it.get("number", 0)) > 0))


func _autoload(peer: int, id: int, number: int, keep: bool) -> void:
	var now_ms: int = Time.get_ticks_msec()

	if now_ms - int(_autoload_pressed.get(peer, -AUTOLOAD_PRESS_MS)) < AUTOLOAD_PRESS_MS:
		return

	_autoload_pressed[peer] = now_ms
	var it: Dictionary = _items.get(id, {})
	var box = _chest_of(peer, id)   # reach and access, as opening it

	if box == null or not _autoloads(it):
		return

	if number <= 0:
		it["struct"].erase("autoload")
		_dirty = true
		_send_autoload_info(peer, id)
		return

	if table.id_of(number) == "":
		return   # not an item

	if keep and _box_takes(str(it["struct"]["kind"]), number):
		it["struct"]["autoload"] = number   # saved with the container (world_items.json row index 22)
	elif int(it["struct"].get("autoload", 0)) != number:
		it["struct"].erase("autoload")   # a one-off load of another item ends the standing one; the same item keeps it

	var loaded: Array = _autoload_into(id, box, number)
	_dirty = true
	var noun: String = table.sentence_name(int(it["number"]))
	var what: String = table.sentence_name(number)

	if not _box_takes(str(it["struct"]["kind"]), number):
		_say(peer, "The %s does not take %s." % [noun, what])
	elif _water_blocks_goods(id):
		_say(peer, "It holds water. Drink or draw it off first.")
	elif int(loaded[0]) > 0:
		_say(peer, "Loaded %d %s into the %s.%s" % [int(loaded[0]), what, noun, (" %d more lies nearby." % int(loaded[1])) if int(loaded[1]) > 0 else ""])
	elif int(loaded[1]) > 0:
		_say(peer, "The %s is full." % noun)
	else:
		_say(peer, "No %s lies within %d m of the %s." % [what, int(AUTOLOAD_M), noun])

	_push_box(id, box)
	_send_autoload_info(peer, id)


# Fills container `id` (its store `box`) with `number` from the ground piles within AUTOLOAD_M, nearest first, as much as it takes.
# Returns [how many went in, how many of it are still on the ground in range].
func _autoload_into(id: int, box, number: int) -> Array:
	var it: Dictionary = _items[id]
	var here: Vector3 = it["pos"]
	var piles: Array = []

	if not _box_takes(str(it["struct"]["kind"]), number) or _water_blocks_goods(id):   # a tank that is a store holds water or goods, never both
		return [0, 0]

	for gid in _ids_near(here, AUTOLOAD_M):   # the last world sync's cells round it, not every record in the world
		var g: Dictionary = _items.get(gid, {})

		if not g.is_empty() and int(g.get("number", 0)) == number and _autoload_takes_from(g):
			var d: float = (g["pos"] as Vector3).distance_to(here)

			if d <= AUTOLOAD_M:
				piles.append([d, gid])

	piles.sort_custom(func(p, q): return float(p[0]) < float(q[0]))
	box.usable = _store_usable(str(it["struct"]["kind"]), box)
	var loaded: int = 0
	var left_near: int = 0
	var cart_kg: float = _carts.room_kg(id) if not _carry_cfg.is_empty() else INF   # a vehicle's payload left, worked out once (riders_of looks at every record)
	var full: bool = false

	for pile in piles:
		var g: Dictionary = _items[pile[1]]
		var each: float = maxf(CarryRules.weight_of(table.id_of(number), _carry_cfg) + (CarryRules.bag_kg(g["inst"], table, _carry_cfg) if g.has("inst") else 0.0), 0.001) if cart_kg < INF else 0.0
		var want: int = 0

		if not full:   # a vehicle's store or a crate riding on one stops at the payload (a bag weighs with what it holds); a bin at its room
			want = _box_room(id, number, int(g["count"])) if cart_kg == INF else clampi(int(floor(cart_kg / each + 0.0001)), 0, int(g["count"]))

		var put: int = want - box.add(number, want, int(g.get("wear", 0)), g.get("inst", {})) if want > 0 else 0
		cart_kg = maxf(cart_kg - float(put) * each, 0.0) if cart_kg < INF else INF
		full = full or put < int(g["count"])   # this pile did not all fit: the next ones will not either
		left_near += int(g["count"]) - put
		loaded += put
		_take_from(int(pile[1]), put)

	return [loaded, left_near]


func _send_autoload_info(peer: int, id: int) -> void:
	if send_autoload_info.is_valid():
		send_autoload_info.call(peer, id, int(_items.get(id, {}).get("struct", {}).get("autoload", 0)) if _autoloads(_items.get(id, {})) else 0)


# Every AUTOLOAD_EVERY_S: each container with a standing autoload takes its item from the ground round it, as a press would. One look over the
# records for the few that have one; a full container takes nothing and keeps its setting.
func _autoload_tick(spent: float) -> void:
	_autoload_in -= spent

	if _autoload_in > 0.0:
		return

	_autoload_in = AUTOLOAD_EVERY_S

	for id in _items.keys():
		var it: Dictionary = _items.get(id, {})

		if it.has("struct") and int(it["struct"].get("autoload", 0)) > 0 and _autoloads(it):
			var box = _chests[int(it["struct"]["uid"])]

			if int(_autoload_into(id, box, int(it["struct"]["autoload"]))[0]) > 0:
				_dirty = true
				_push_box(id, box)


# Stack to nearby: each pack stack (not a favourite, not the shoulder log) goes into the player's own storage chests within
# CraftStock.CRAFT_REACH_M that already hold that item, nearest first; keep out does not block stacking in. Returns [stacks moved, chest ids].
func _bulk_stack_nearby(peer: int, inv) -> Array:
	var boxes: Array = []
	var touched: Dictionary = {}
	var key: String = str(_peer_key.get(peer, ""))

	if not _peer_pos.has(peer):
		return [0, []]

	for sid in _items:
		var s: Dictionary = _items[sid]

		if not _is_storage(s) or not CraftStock.owner_ok(str(s["struct"].get("owner", "")), key):
			continue

		var d: float = (s["pos"] as Vector3).distance_to(_peer_pos[peer])

		var chest = _chests.get(int(s["struct"]["uid"]))

		if chest != null and d <= CraftStock.CRAFT_REACH_M:
			chest.usable = _store_usable(str(s["struct"]["kind"]), chest)
			boxes.append([sid, chest, d])

	boxes.sort_custom(func(a, b): return float(a[2]) < float(b[2]))
	var moved: int = 0

	for slot in range(inv.hotbar_slots, inv.slot_count):
		var number: int = inv.numbers[slot]

		if number == 0 or inv.is_fav(slot) or is_shoulder_item(number) or not inv.inst_of(slot).is_empty():
			continue   # an instance never stacks, so Stack to nearby leaves it

		var moved_here: bool = false

		for box in boxes:
			if inv.numbers[slot] != number:
				break   # the whole stack has gone

			if box[1].count_of(number) <= 0 or not _box_takes(str(_items[int(box[0])]["struct"]["kind"]), number):
				continue   # only chests that already hold it, and take it (structures.json takes)

			var amount: int = _box_room(int(box[0]), number, inv.counts[slot])
			var box_def: Dictionary = _structures.get(str(_items[int(box[0])]["struct"]["kind"]), {})
			var put: int = 0

			if amount > 0:
				if _smelters.is_smelter(box_def):
					put = amount - _smelters.put(box_def, box[1], number, amount, inv.wear[slot])
				elif _fuel_slot_kind(box_def):
					put = amount - _smithy_add(box_def, box[1], number, amount, inv.wear[slot])
				else:
					put = amount - box[1].add(number, amount, inv.wear[slot])

			if put > 0:
				inv.take_from_slot(slot, put)
				moved_here = true
				touched[int(box[0])] = box[1]

		if moved_here:
			moved += 1

	for sid in touched:
		_push_box(int(sid), touched[sid])   # whoever has that chest open sees it fill

	return [moved, touched.keys()]


# Sort: the stacks in slots [from, to) of an inventory are put in order by the client's sort key (1 name, 2 and 3 weight up and down, 4 and 5 value
# up and down; 0, the picked-up order the server does not know, sorts by name), empty slots last. In the pack (keep_favs) favourites keep their slots
# and the rest flow round them. Stacks are only reordered, never joined. Returns how many stacks changed slot.
func _sort_slots(inv, from: int, to: int, sort_key: int, keep_favs: bool) -> int:
	var open_slots: Array = []
	var stacks: Array = []

	for i in range(from, mini(to, inv.slot_count)):
		if keep_favs and inv.is_fav(i):
			continue

		open_slots.append(i)

		if inv.numbers[i] != 0:
			stacks.append([inv.numbers[i], inv.counts[i], inv.wear[i], i, inv.inst_of(i)])

	var cfg: Dictionary = _carry_cfg
	var order_key: Callable = func(row: Array) -> Variant:
		var number: int = int(row[0])

		match sort_key:
			2:
				return CarryRules.weight_of(table.id_of(number), cfg) * float(row[1])
			3:
				return -CarryRules.weight_of(table.id_of(number), cfg) * float(row[1])
			4:
				return table.value_of(number) * int(row[1])
			5:
				return -table.value_of(number) * int(row[1])

		return table.name_of(number).to_lower()

	stacks.sort_custom(func(a, b):
		var ka: Variant = order_key.call(a)
		var kb: Variant = order_key.call(b)

		if ka != kb:
			return ka < kb

		return int(a[3]) < int(b[3]))
	var moved: int = 0

	for k in open_slots.size():
		var slot: int = int(open_slots[k])

		if k < stacks.size():
			var row: Array = stacks[k]
			inv.numbers[slot] = int(row[0])
			inv.counts[slot] = int(row[1])
			inv.wear[slot] = int(row[2])
			inv.inst[slot] = row[4]

			if int(row[3]) != slot:
				moved += 1
		else:
			inv.clear_slot(slot)

		inv.fav[slot] = 0

	return moved


# `variant` (SmithingRules code, 0 plain): Tempered and/or craftsmanship +1/+2, refused unless the stations beside the player allow it for this
# recipe (craft_variants); its needs are scaled up and it takes longer (smithing.json).
func _queue_craft(peer: int, inv, recipe_number: int, count: int, variant: int = 0, hand: int = -1) -> void:   # hand: the pack slot in the right hand (-1 empty; no longer decides anything)
	var queue: Dictionary = _queue_of(peer)
	var recipe: Dictionary = recipes.recipe(recipe_number)
	var free: bool = free_craft_for(peer)

	if queue.is_empty() or recipe.is_empty():
		return

	if not recipe_known_for(peer, recipe) and not free and not _try_learn(peer, inv, recipe):
		# Never a silent no (23 Nov 2026, the screens robot: Fish trap and Bird trap lit, pressed, nothing happened).
		if bool(recipe.get("locked", false)):
			_say(peer, "Nobody knows how to make %s yet" % table.in_sentence(str(recipe.get("name", "that"))))
		else:
			var at_station: String = (", standing at the %s" % _station_name(str(recipe["station"]))) if str(recipe.get("station", "")) != "" else ""
			_say(peer, "You have not worked out how to make %s yet: carry what it needs in your pack%s, then try again" % [table.in_sentence(str(recipe.get("name", "that"))), at_station])
		return

	if not free and not _hand_tool_ok(peer, inv, recipe, hand):   # a kept tool must be in the pack (Dave 24 Nov 2026), checked before any log is pulled onto the shoulder
		return

	# The station within the crafting reach but not beside you: go to it and craft there (Dave 10 Nov 2026), when the stock here covers one.
	# A Tempered or +1/+2 craft goes to the station that makes it (the Master smithy), not to a nearer smithy that serves only the plain recipe.
	# Only for a variant this item may have at all (the stations aside), so a bad request never moves the player.
	var gives_v: Array = recipe.get("gives", [0, 0])
	var made_v: String = table.id_of(int(gives_v[0])) if not gives_v.is_empty() else ""
	var eligible: bool = variant != 0 and SmithingRules.valid(variant) and made_v != "" and SmithingRules.variants(made_v, table.entry(made_v), int(gives_v[1]) if gives_v.size() > 1 else 1, true, true).has(variant)
	var work: Dictionary = _variant_recipe(recipe, variant) if eligible else recipe
	var station_name: String = str(work.get("station", ""))
	var station_level: int = int(work.get("station_level", 1))

	if station_name != "" and not station_near(peer, station_name, station_level):
		var far_id: int = serving_station(peer, station_name, station_level, CraftStock.CRAFT_REACH_M)

		if far_id >= 0 and (free or _stock_covers(inv, recipe, 1, _stock_of(peer))):
			_step_to_station(peer, far_id)

	# The server decides what may be made here; the client's choice is only a request (master s2.7 items 5-6, s4 item 15).
	if variant != 0:
		if not craft_variants(peer, recipe).has(variant):
			_say(peer, "That cannot be made %s here" % (SmithingRules.label(variant) if SmithingRules.valid(variant) else "that way"))
			return

		recipe = _variant_recipe(recipe, variant)   # a copy, worked at the Master smithy
		recipe["needs"] = SmithingRules.scaled_needs(recipe["needs"], variant)

	# A sealed batch is capped by the room in the pack and the player's storage nearby (master s3.14 bulk): it never spills onto the ground.
	if float(recipe.get("ready_age", 0.0)) > 0.0:
		var room_crafts: int = floori(float(_batch_room(peer, int(recipe["gives"][0]))) / float(maxi(int(recipe["gives"][1]), 1)))

		if room_crafts <= 0:
			_say(peer, "No room for the batch: make space in your pack or a chest nearby")
			return

		if room_crafts < clampi(count, 1, CRAFT_QUEUE_MAX_COUNT):
			_say(peer, "Room for only %d of that batch in your pack and chests nearby" % room_crafts)
			count = room_crafts

	if free:
		var line: Array = queue["entries"]

		if line.size() >= CRAFT_QUEUE_ENTRIES:
			_say(peer, "The crafting queue is full")
			return

		line.append([recipe_number, clampi(count, 1, CRAFT_QUEUE_MAX_COUNT), []] if variant == 0 else [recipe_number, clampi(count, 1, CRAFT_QUEUE_MAX_COUNT), [], [], 0, variant])
		_dirty = true
		_sync_craft_queue(peer)
		return

	if str(recipe.get("station", "")) != "" and not station_near(peer, str(recipe["station"]), int(recipe.get("station_level", 1))):
		if _broken_station_near(peer, str(recipe["station"]), int(recipe.get("station_level", 1))):
			_say(peer, "Needs repair")   # the exact warning for a worn-out smithy (master s2.2 item 9)
		elif str(recipe["station"]).begins_with("campfire") and _unlit_fire_near(peer, str(recipe["station"])):
			_say(peer, "The fire is out: light it first")   # standing at a cold fire, "That needs a Campfire nearby" tells the player nothing
		else:
			_say(peer, ("The %s has no fuel: put Coal or Charcoal in its fuel slot (its first slot)" if _unfuelled_smithy_near(peer, str(recipe["station"])) else "That needs a %s nearby") % _station_name(str(recipe["station"])))
		return

	for group_id in LOG_GROUP_IDS:   # shoulder and ground logs count (F-16), for any log and for the Softwood and Hardwood logs of the saws
		_pull_nearby_logs(peer, inv, _log_need(recipe["needs"], clampi(count, 1, CRAFT_QUEUE_MAX_COUNT), group_id), group_id)
	var stock: Dictionary = _stock_of(peer)   # the ground near the player and their own containers in reach count too (step 2): pack first, then the ground, then the nearest

	# Short of a part the stock could make (no twine, but the fibre for it): queue the missing parts first, then this (Dave 25 Oct). The planner
	# knows only plain recipes, so a variant must be covered as it is.
	if variant == 0 and not _stock_covers(inv, recipe, count, stock):
		var outcome: int = _queue_with_parts(peer, inv, queue, recipe_number, count, stock, hand)

		if outcome == 1:
			_send_stock(peer)
			return

		if outcome == 2:
			return

	var entries: Array = queue["entries"]
	var merge: bool = not entries.is_empty() and int(entries[entries.size() - 1][0]) == recipe_number and not (entries[entries.size() - 1][2] as Array).is_empty() and (entries[entries.size() - 1].size() < 5 or int(entries[entries.size() - 1][4]) == 0) and _variant_of(entries[entries.size() - 1]) == variant

	var want: int = clampi(count, 1, CRAFT_QUEUE_MAX_COUNT)

	if merge:   # an entry holds at most CRAFT_QUEUE_MAX_COUNT: what does not fit it starts a new entry, or (a full queue) only its room is queued
		var room: int = CRAFT_QUEUE_MAX_COUNT - int(entries[entries.size() - 1][1])

		if room < want and entries.size() < CRAFT_QUEUE_ENTRIES:
			merge = false
		elif room <= 0:
			_say(peer, "The crafting queue is full")
			return
		elif room < want:
			want = room
			_say(peer, "Only room for %d more in the queue" % room)

	if entries.size() >= CRAFT_QUEUE_ENTRIES and not merge:
		_say(peer, "The crafting queue is full")
		return

	var taken: int = 0
	var held: Array = []   # per need, the instance units taken (a cancel gives them back as they were)

	for need in recipe["needs"]:
		held.append([])

	for n in range(want):
		if not _stock_covers(inv, recipe, 1, stock):
			break

		for k in recipe["needs"].size():
			_stock_take(inv, int(recipe["needs"][k][0]), int(recipe["needs"][k][1]), stock, held[k])

		taken += 1

	if taken == 0:
		_say(peer, "You do not have what that needs")
		return

	if taken < want:
		_say(peer, "You only have enough for %d" % taken)

	if merge:
		entries[entries.size() - 1][1] = int(entries[entries.size() - 1][1]) + taken   # want kept it within CRAFT_QUEUE_MAX_COUNT
		_hold_insts(entries[entries.size() - 1][2], held)
	else:
		var needs: Array = recipe["needs"].duplicate(true)
		_hold_insts(needs, held)
		entries.append([recipe_number, taken, needs] if variant == 0 else [recipe_number, taken, needs, [], 0, variant])

	_dirty = true
	_sync_craft_queue(peer)
	_send_stock(peer)


const VARIANT_CHECK_MS := 1000
var _variant_seen: Dictionary = {}   # peer -> [ms, recipe number, variant, allowed]: the station scan for a running variant craft, at most once a second


# Is the variant still allowed beside this player (craft_variants), worked out at most once a second per player for the craft queue.
func _variant_here(peer: int, recipe: Dictionary, variant: int) -> bool:
	var now: int = Time.get_ticks_msec()
	var seen: Array = _variant_seen.get(peer, [])

	if seen.is_empty() or now - int(seen[0]) >= VARIANT_CHECK_MS or int(seen[1]) != int(recipe.get("number", -1)) or int(seen[2]) != variant:
		seen = [now, int(recipe.get("number", -1)), variant, craft_variants(peer, recipe).has(variant)]
		_variant_seen[peer] = seen

	return bool(seen[3])


# A Tempered or +1/+2 craft is worked at the station that allows it (smithing.json craft.station, temper.station: the Master smithy, which
# serves every smithy recipe, s2.7 item 9): a copy of the recipe with that station at level 1, so the station check, the firing, the store
# the product goes to and the wear all fall on it, never on a nearer Advanced smithy (repair plan P3: the Advanced smithy has no quencher).
func _variant_recipe(recipe: Dictionary, variant: int) -> Dictionary:
	var c: Dictionary = SmithingRules.cfg()
	var key: String = "craft" if SmithingRules.craft_in(variant) > 0 else "temper"
	var out: Dictionary = recipe.duplicate()
	out["station"] = str(c.get(key, {}).get("station", "master_smithy"))
	out["station_level"] = 1
	return out


# A queue entry's variant: [recipe, count, needs, parts, chain, variant]; shorter entries are plain.
func _variant_of(entry: Array) -> int:
	return int(entry[5]) if entry.size() > 5 else 0


# The variant codes this recipe's output may be made as beside this player now (SmithingRules.variants): Tempered needs a temper.station that
# serves the recipe (the Master smithy, its quenching trough built in), +1/+2 a craft.station (the Master smithy) that serves it.
func craft_variants(peer: int, recipe: Dictionary) -> Array:
	var gives: Array = recipe.get("gives", [0, 0])
	var made_id: String = table.id_of(int(gives[0])) if not gives.is_empty() else ""
	var station: String = str(recipe.get("station", ""))
	var level: int = int(recipe.get("station_level", 1))
	var c: Dictionary = SmithingRules.cfg()
	var master: bool = false
	var temper: bool = false

	if station != "" and made_id != "":
		var master_id: int = serving_station(peer, str(c.get("craft", {}).get("station", "master_smithy")))
		master = master_id >= 0 and _station_serves(master_id, station, level)
		var temper_station: String = str(c.get("temper", {}).get("station", "master_smithy"))
		# The nearest temper station at the recipe's own level when it is the recipe's station (a lit lower smithy must not hide it).
		var temper_id: int = serving_station(peer, temper_station, level if temper_station == station else 1)
		temper = temper_id >= 0 and _station_serves(temper_id, station, level)

	return SmithingRules.variants(made_id, table.entry(made_id), int(gives[1]) if gives.size() > 1 else 1, master, temper)


func _station_serves(id: int, station: String, level: int) -> bool:
	var it: Dictionary = _items[id]
	return station_level_of(it, _structures.get(str(it["struct"]["kind"]), {}), station) >= level


# Does the pack hold everything `times` crafts of a recipe need (kept tools once)?
func _pack_covers(inv, recipe: Dictionary, times: int) -> bool:
	for need in recipe["needs"]:
		if not inv.has_fill(need[0], int(need[1]) * clampi(times, 1, CRAFT_QUEUE_MAX_COUNT)):
			return false

	for keep in recipe["keeps"]:
		if not inv.has_fill(keep[0], keep[1]):
			return false

	return true


# Plans the missing parts of a craft and queues them, all or nothing, in one step. Returns 1 when queued, 0 when it could not be and the player
# was told why, 2 when a part it would make needs a tool the pack lacks (told why; the craft stops there), -1 when there is nothing to add (the plain craft
# goes on, or fails the old way).
func _queue_with_parts(peer: int, inv, queue: Dictionary, recipe_number: int, count: int, stock: Dictionary = {}, hand: int = -1) -> int:
	if stock.is_empty():
		stock = _stock_of(peer)

	var ctx: Dictionary = {
		"have": func(item: int) -> int: return _stock_have(inv, item, stock),
		"station_ok": func(r: Dictionary) -> bool: return str(r.get("station", "")) == "" or station_near(peer, str(r["station"]), int(r.get("station_level", 1))),
		"known": func(r: Dictionary) -> bool: return recipe_known_for(peer, r),
		"free": false,
	}
	var plan: Dictionary = CraftPlanner.plan(recipes, table, recipe_number, clampi(count, 1, CRAFT_QUEUE_MAX_COUNT), ctx)

	if not bool(plan["ok"]):
		if str(plan["msg"]) != "" and str(plan["msg"]) != "You do not have what that needs":
			_say(peer, str(plan["msg"]))
			return 0

		return -1

	var steps: Array = plan["steps"]

	if steps.size() == 1:
		return -1   # nothing to make first: the plain path

	for step in steps:   # a part made on the way with a tool (Wooden blocks sawn for a carved Wooden bowl) needs that tool in the pack too
		if not _hand_tool_ok(peer, inv, recipes.recipe(int(step["recipe"])), hand):
			return 2   # refused, and said why: nothing else is tried (the plain path would only add "You do not have what that needs")

	var entries: Array = queue["entries"]

	if entries.size() + steps.size() > CRAFT_QUEUE_ENTRIES:
		_say(peer, "The crafting queue is full")
		return 0

	for made in plan["made"]:   # the made parts must fit in the pack and under the carry limit
		if _fit(peer, inv, int(made[0]), int(made[1])) < int(made[1]):
			_say(peer, "You cannot carry that many %s" % table.sentence_name(int(made[0])))
			return 0

	var chain: int = 1

	for entry in entries:
		if entry.size() > 4:
			chain = maxi(chain, int(entry[4]) + 1)

	for step in steps:
		var needs: Array = (step["take"] as Array).duplicate(true)
		var held: Array = []

		for need in needs:
			held.append([])
			_stock_take(inv, int(need[0]), int(need[1]) * int(step["count"]), stock, held[held.size() - 1])

		_hold_insts(needs, held)
		entries.append([int(step["recipe"]), int(step["count"]), needs, (step["deferred"] as Array).duplicate(true), chain])

	_dirty = true
	_sync_craft_queue(peer)
	return 1


# The head entry starts: the parts an earlier step made leave the pack now. False (the entry and what depends on it are cancelled and refunded)
# when they are not there any more.
# It runs from the craft tick, not from a player's action, so it sends the pack's changed slots after a take itself: before 23 Nov 2026 the twine an axe took
# here stayed in the client's pack until a later full update, and the next recipe that needed twine showed as craftable (Dave's Stone hammer).
func _start_deferred(peer: int, head: Array) -> bool:
	var inv = inventory_of(peer)
	var times: int = int(head[1])
	var stock: Dictionary = _stock_of(peer)   # parts made at a station wait in its output (master s2.5): the craft stock reaches them there
	var before: Array = _snapshot(inv) if inv != null else []

	for need in head[3]:
		if inv == null or _stock_have(inv, int(need[0]), stock) < int(need[1]) * times:
			_cancel_craft(peer, 0)
			_say(peer, "%s was cancelled: the parts it needed are gone" % str(recipes.recipe(int(head[0])).get("name", "That")))
			return false   # the refund sends its own changes (give)

	for need in head[3]:
		var held: Array = []
		_stock_take(inv, int(need[0]), int(need[1]) * times, stock, held)
		var merged: bool = false

		for have in head[2]:
			if int(have[0]) == int(need[0]):
				have[1] = int(have[1]) + int(need[1])

				if not merged:
					_hold_insts([have], [held])

				merged = true

		if not merged:
			head[2].append([int(need[0]), int(need[1])])
			_hold_insts([head[2][head[2].size() - 1]], [held])

	head[3] = []
	_dirty = true
	_send_changes(peer, inv, before)
	_send_stock(peer)   # a part taken from the ground or a chest nearby leaves the crafting stock too
	return true


# Water given back (a cancelled or failed craft, GA-04) goes into containers with room: first where it came from (the row's source: a storage container of the
# player's, wherever they are now), then the pack's, then their own storage in craft reach. Whatever no container has room for is spilled; the stackable
# `water` item is never minted. `src`: the refund row's instance data ("box": the world id and "uid" the store's uid of the chest it was taken from, none: the pack).
func _pour_back(peer: int, ml: int, src: Dictionary = {}) -> void:
	var inv = inventory_of(peer)

	if inv == null or ml <= 0:
		return

	var left: int = ml

	if src.has("tank") and _water.pieces.has(int(src["tank"])):   # water a plumbed cooking station drew from a tank goes back into it, up to its brim (PV-14)
		var tank: int = int(src["tank"])
		var now_s: float = _water_now_s()
		_water_resolve(now_s)
		var held_l: float = _water.litres(tank, now_s)
		var room_ml: int = maxi(floori((float(_water.pieces[tank].get("litres_max", 0.0)) - held_l) * 1000.0), 0)
		var back: int = mini(left, room_ml)

		if back > 0:
			_water.set_litres(tank, held_l + float(back) / 1000.0)
			_water_dirty = true
			left -= back

		if left <= 0:
			return

	var from_id: int = int(src.get("box", -1))

	if from_id >= 0 and _items.has(from_id) and _items[from_id].has("struct") and int(_items[from_id]["struct"].get("uid", -2)) == int(src.get("uid", -1)) and _chests.has(int(src["uid"])) and CraftStock.owner_ok(str(_items[from_id]["struct"].get("owner", "")), str(_peer_key.get(peer, ""))):   # the water was the player's own, so the chest must still be theirs; a stale or changed source falls through to the pack, and the row is spent once
		left = _chests[int(src["uid"])].pour_liquid(left)

		if left < ml:
			_push_box(from_id, _chests[int(src["uid"])])

	var before: Array = _snapshot(inv)
	left = inv.pour_liquid(left)
	_send_changes(peer, inv, before)

	if left > 0:
		for box in _craft_boxes(peer):
			var was: int = left
			left = box[1].pour_liquid(left)

			if left < was:
				_push_box(int(box[0]), box[1])

	if left > 0:
		_say(peer, "The water spills: nothing here has room for it.")

	_dirty = true


func _refund_entry(peer: int, entry: Array) -> void:
	# The entry keeps its own ingredient list, so a refund works even if the recipe is later removed or renumbered.
	var was_src: String = _gain_source
	_gain_source = SRC_RETURN   # given back, not gathered (goal got: counter)

	for need in entry[2]:
		var left: int = int(need[1]) * int(entry[1])

		# The recorded units go back as they were, wear (age, water) and instance data included. Rows are in the order they were taken and crafts
		# finish in queue order, so the units still owed are the last ones: give from the end. Rows: [number, inst, wear, count] (older: count 1);
		# what no row covers (an older save) comes back plain.
		var rows: Array = need[2] if need.size() > 2 else []

		for k in range(rows.size() - 1, -1, -1):
			var unit: Array = rows[k]
			var n: int = mini(left, int(unit[3]) if unit.size() > 3 else 1)

			if n > 0 and (unit[1] as Dictionary).has("liquid_ml"):   # water that came out of containers goes back into containers, never as the stackable item (GA-04)
				_pour_back(peer, floori(float(unit[1]["liquid_ml"]) * float(n) / float(maxi(int(unit[3]), 1))), unit[1])
				left -= n
			elif n > 0:
				give(peer, int(unit[0]), n, unit[1], int(unit[2]) if unit.size() > 2 else 0)
				left -= n

		give(peer, _refund_number(int(need[0])), left)   # a group ingredient gives back its lowest member, as a taken-down piece does

	_gain_source = was_src


# Keeps what a craft took, in order, so a refund gives back as it was what is still owed: row k gains a third value, the list of
# [item number, inst, wear, count] taken for it (Inventory.remove, _stock_take).
func _hold_insts(rows: Array, held: Array) -> void:
	for k in mini(rows.size(), held.size()):
		if not (held[k] as Array).is_empty():
			if rows[k].size() < 3:
				rows[k].append([])

			rows[k][2].append_array(held[k])


func _cancel_craft(peer: int, index: int) -> void:
	var queue: Dictionary = _queue_of(peer)

	if queue.is_empty() or index < 0 or index >= queue["entries"].size():
		return

	var entry: Array = queue["entries"][index]
	queue["entries"].remove_at(index)

	if index == 0:
		_restart_head(queue)

	_refund_entry(peer, entry)

	# Cancelling a part cancels what was waiting for it (the same chain, queued after it); each is refunded what it took.
	if entry.size() > 4 and int(entry[4]) > 0:
		var at: int = index

		while at < queue["entries"].size():
			var later: Array = queue["entries"][at]

			if later.size() > 4 and int(later[4]) == int(entry[4]):
				queue["entries"].remove_at(at)
				_refund_entry(peer, later)
			else:
				at += 1

	_dirty = true
	_sync_craft_queue(peer)


# The head craft's time is fixed when it starts (Dave 17 Nov 2026: "it stops at zero and keeps me waiting longer"): the countdown the client is sent
# and the server's finish read the same number, so a change of pace during the craft (cold setting in at the river, the Rested buff ending, a
# skill step) no longer stretches it past zero. Provisional CF-2 (docs/design/CRAFT_FINISH.md): the pace that counts is the one when the craft starts.
func _head_need_s(peer: int, queue: Dictionary, recipe: Dictionary, variant: int) -> float:
	if not queue.has("need_s"):
		queue["need_s"] = _need_now(peer, recipe, variant)

	return float(queue["need_s"])


func _need_now(peer: int, recipe: Dictionary, variant: int) -> float:
	return float(recipe.get("craft_s", 3.0)) * _wheel_slow(peer, recipe) * _saw_slow(peer, recipe) * SmithingRules.time_mult(variant) / _pace_factor(peer, "craft")   # skill, rest, cold


# The head craft starts over (a new head, or the next craft of the same entry): no time spent, its time worked out again when it next runs.
func _restart_head(queue: Dictionary) -> void:
	queue["elapsed"] = 0.0
	queue.erase("need_s")


func _craft_tick(spent: float) -> void:
	_settle_busy()   # a smithy nobody works now goes back to its idle coals

	for peer in _peer_key:
		var queue: Dictionary = _craft_queues.get(_peer_key[peer], {})

		if queue.is_empty() or queue["entries"].is_empty():
			continue

		var head: Array = queue["entries"][0]
		var recipe: Dictionary = recipes.recipe(int(head[0]))

		if _variant_of(head) != 0 and not recipe.is_empty():
			recipe = _variant_recipe(recipe, _variant_of(head))   # worked, fired, stored and worn at the Master smithy, as queued

		if recipe.is_empty():
			queue["entries"].remove_at(0)
			_restart_head(queue)
			_refund_entry(peer, head)
			_say(peer, "A craft was cancelled: that recipe is gone")
			_dirty = true
			_sync_craft_queue(peer)
			continue

		# A station recipe only runs while you are near its station; step away and it waits (nothing is lost, cancel refunds).
		var free_entry: bool = (head[2] as Array).is_empty() and (head.size() < 4 or (head[3] as Array).is_empty())   # an admin-mode craft: no station, no kept tool

		# Admin mode is off now (switched off, a new session, a new player): a free craft still queued is dropped, never made free.
		if free_entry and not free_craft_for(peer):
			queue["entries"].remove_at(0)
			_restart_head(queue)
			_say(peer, "%s was cancelled: Admin mode is off" % str(recipe.get("name", "A free craft")))
			_dirty = true
			_sync_craft_queue(peer)
			continue

		var at_station: int = serving_station(peer, str(recipe["station"]), int(recipe.get("station_level", 1))) if not free_entry and str(recipe.get("station", "")) != "" else -1

		if not free_entry and str(recipe.get("station", "")) != "" and at_station < 0:
			if Time.get_ticks_msec() - int(_station_said.get(peer, -100000)) > 8000:
				_station_said[peer] = Time.get_ticks_msec()
				if _broken_station_near(peer, str(recipe["station"]), int(recipe.get("station_level", 1))):
					_say(peer, "Needs repair")   # the smithy wore out under the queue: the craft waits, nothing is lost
				else:
					var station_name: String = _station_name(str(recipe["station"]))
					var waiting: int = _variant_of(head)
					if _unfuelled_smithy_near(peer, str(recipe["station"])):
						_say(peer, "The %s has no fuel: put Coal or Charcoal in its fuel slot (its first slot)" % station_name)
					elif str(recipe["station"]).begins_with("campfire") and _unlit_fire_near(peer, str(recipe["station"])):
						_say(peer, "The fire is out: light it again and the craft goes on")   # beside a cold fire, "go back to the fire" tells the player nothing
					elif waiting != 0:
						_say(peer, "Your %s %s waits: go back to the %s" % [SmithingRules.label(waiting), str(recipe.get("name", "craft")), station_name])   # a Tempered or +1/+2 craft names the item it waits for
					else:
						_say(peer, "Your craft waits: go back to the %s" % station_name)

			continue

		var variant: int = _variant_of(head)

		# A Tempered or +1/+2 craft runs only beside the stations that allow it; walk away and it waits, as for a station.
		if variant != 0 and not free_entry and not _variant_here(peer, recipe, variant):
			if Time.get_ticks_msec() - int(_station_said.get(peer, -100000)) > 8000:
				_station_said[peer] = Time.get_ticks_msec()
				_say(peer, "Your %s %s waits: go back to the smithy that makes it" % [SmithingRules.label(variant), str(recipe.get("name", "craft"))])

			continue

		if head.size() > 3 and not (head[3] as Array).is_empty() and not _start_deferred(peer, head):
			continue

		# A smithy burns its fuel only while the craft is being made, not while a finished one waits for room (need_s is set on its first tick).
		if at_station >= 0 and float(queue["elapsed"]) < float(queue.get("need_s", INF)) and not _smithy_burn(at_station, spent):
			continue   # its last fuel went this tick: the craft waits for more in the fuel slot (said on the next tick)

		var worked_before: float = float(queue["elapsed"])
		queue["elapsed"] = worked_before + spent

		var starting: bool = not queue.has("need_s")

		if craft_working.is_valid() and worked_before < _head_need_s(peer, queue, recipe, variant):   # not a finished batch waiting for room
			craft_working.call(peer, int(head[0]))   # the others nearby hear the work while it goes on, as the crafter does (server_action_cues.gd, protocol 156)

		if float(queue["elapsed"]) < _head_need_s(peer, queue, recipe, variant):
			if starting:
				_sync_craft_queue(peer)   # the time is fixed now, beside its station or sawbuck: the countdown is re-sent from it

			continue

		# A sealed batch done while its room was filled meanwhile waits, finished, until there is space again (never onto the ground).
		if float(recipe.get("ready_age", 0.0)) > 0.0 and _batch_room(peer, int(recipe["gives"][0])) < int(recipe["gives"][1]) * int(head[1]):
			if Time.get_ticks_msec() - int(_station_said.get(peer, -100000)) > 8000:
				_station_said[peer] = Time.get_ticks_msec()
				_say(peer, "Your %s batch waits: make room in your pack or a chest nearby" % str(recipe.get("name", "")).to_lower())

			continue

		# A station with a store keeps what its owner makes there (master s2.5): with no room in its output the finished craft waits.
		var made_n: int = int(recipe["gives"][0])
		var made_inst: Dictionary = SmithingRules.made_inst(table.entry(table.id_of(made_n)), variant)
		var made_age: int = _made_age(made_n, head)
		var made_count: int = int(recipe["gives"][1])
		var store_id: int = -1 if float(recipe.get("ready_age", 0.0)) > 0.0 else _craft_store(peer, recipe, free_entry)

		if store_id >= 0 and _out_room(_items[store_id], made_n, made_inst, made_age) < made_count:
			if Time.get_ticks_msec() - int(_station_said.get(peer, -100000)) > 8000:
				_station_said[peer] = Time.get_ticks_msec()
				_say(peer, "Your %s waits: the %s is full. Take something out of it." % [str(recipe.get("name", "craft")), table.sentence_name(int(_items[store_id]["number"]))])

			continue

		_restart_head(queue)
		var inv = inventory_of(peer)

		# A kept tool that is no longer there stops the craft: the entry is refunded and the player is told which one. The rule is the one the
		# craft was queued under (_stock_covers): a tool held in the hand (CraftStock.hand_tools) must be in the pack; any other kept item (the
		# Stone of a wooden shovel) may lie on the ground or in the player's containers within reach. Before 18 Nov 2026 the end asked for every
		# kept item in the pack, so a shovel queued beside a loose stone ran its countdown and then gave back its sticks (Dave's report).
		var tools_ok: bool = inv != null
		var missing: int = 0
		var hand_tools: PackedInt32Array = CraftStock.hand_tools(recipe, table)
		var keep_stock: Dictionary = {}

		for keep in (recipe.get("keeps", []) if tools_ok and not free_entry else []):
			if inv.has_fill(keep[0], keep[1]):
				continue

			if not hand_tools.has(int(keep[0])):
				if keep_stock.is_empty():
					keep_stock = _stock_of(peer)

				if _stock_have(inv, int(keep[0]), keep_stock) >= int(keep[1]):
					continue

			tools_ok = false
			missing = int(keep[0])
			break

		# A recipe that wears its tool (the hand saw) needs an unbroken one of that class in the pack (_craft_tool_slot).
		var wears_tool: String = str(recipe.get("wears_tool", ""))

		if wears_tool != "" and not free_entry:
			tools_ok = tools_ok and inv != null and _craft_tool_slot(inv, wears_tool) >= 0

		# A sealed batch (recipes.json ready_age, master s3.14 [D14]) takes only fresh produce: below half freshness it is refused, so maturing is not skipped.
		var sealed: bool = float(recipe.get("ready_age", 0.0)) > 0.0

		if not tools_ok:
			queue["entries"].remove_at(0)
			_refund_entry(peer, head)
			var what: String = table.cost_sentence(missing) if missing > 0 else "a tool"
			_say(peer, "%s was cancelled: %s it keeps is no longer with you or close by. Nothing was used." % [str(recipe.get("name", "That")), what])
		elif sealed and _stalest_input(head) < SEAL_MIN_FRESH:
			queue["entries"].remove_at(0)
			_refund_entry(peer, head)
			_say(peer, "%s was not sealed: only fresh produce keeps in a jar" % str(recipe.get("name", "That")))
		else:
			# One craft of a sealed recipe makes the whole queued batch at once (one timer, one stack); any other recipe makes one craft's worth.
			var times: int = int(head[1]) if sealed else 1
			_gain_source = SRC_CRAFT

			if sealed:
				_give_batch(peer, int(recipe["gives"][0]), int(recipe["gives"][1]) * times)
			elif store_id >= 0:
				var spill: int = _out_add(store_id, made_n, made_count, made_age, made_inst)

				if spill > 0:   # not reached (the room was checked this tick); kept so a disagreement with Inventory.add never loses the product
					give(peer, made_n, spill, made_inst, made_age)

				if int(head[1]) - times <= 0:
					_say(peer, "%s done: it is in the %s." % [str(recipe.get("name", "Your craft")), table.sentence_name(int(_items[store_id]["number"]))])
			else:
				var gave_n: int = made_count
				give(peer, made_n, gave_n, made_inst, made_age)

				if free_entry:   # an admin-mode craft's product earns no goal by being held (GA-54)
					_goal_admin_gave(peer, made_n, gave_n)

			var sap: int = _craft_sap(head) if not sealed else 0   # Tree sap from the softwood logs this craft used (Dave 16 Nov 2026)

			if sap > 0:
				give(peer, table.number_of(str(table.tree_sap.get("item", ""))), sap)

			_gain_source = SRC_PICKUP
			# The smithy the craft was worked at wears with use, iron on bronze faster (master s2.7 item 5): its own store's station, or the one that
			# served a craft whose product went to the pack (a player at someone else's smithy). An admin-mode craft wears nothing.
			var worked_at: int = store_id if store_id >= 0 else (serving_station(peer, str(recipe.get("station", "")), int(recipe.get("station_level", 1))) if not free_entry and not sealed and str(recipe.get("station", "")) != "" else -1)

			if worked_at >= 0:
				_smithies.crafted(worked_at, recipe, peer)

			if str(recipe.get("station", "")) != "" and not free_entry:
				save_soon([store_id] if store_id >= 0 else [])   # a station craft done: its product (in the pack or the station's store) and its spent inputs

			if not free_entry:   # an admin-mode craft earns no goal (GA-54)
				_goal_made(peer, int(recipe["gives"][0]), times)

				# A variant craft runs only at the Master smithy (_variant_here). "tempered" is one event for activity:temper_steel and ADD-16 (tracker A-43); "masterwork_made" is ADD-17 (+1/+2).
				if SmithingRules.tempered_in(variant):
					_goal_event(peer, "tempered")

				if SmithingRules.craft_in(variant) > 0:
					_goal_event(peer, "masterwork_made")

			if wears_tool != "" and not free_entry:
				_wear_slot(peer, inv, _craft_tool_slot(inv, wears_tool), "craft")

			practice(peer, "craft", clampf(float(recipe.get("craft_s", 3.0)) / 3.0, 0.3, 2.0))   # a long craft teaches more than a quick one
			head[1] = int(head[1]) - times

			if int(head[1]) <= 0:
				queue["entries"].remove_at(0)

		_dirty = true
		_sync_craft_queue(peer)


const SEAL_MIN_FRESH := 0.5   # master s3.14: sealing refuses inputs below half freshness


# The freshness of the stalest perishable unit a queue entry took (the [number, inst, wear, count] rows _hold_insts keeps), 1.0 when none spoils.
func _stalest_input(entry: Array) -> float:
	var stalest: float = 1.0

	for need in entry[2]:
		for unit in (need[2] if need.size() > 2 else []):
			if table.shelf_units(int(unit[0])) > 0:
				stalest = minf(stalest, table.freshness(int(unit[0]), int(unit[2]) if unit.size() > 2 else 0))

	return stalest


# The age a made food starts at (master s3.14, crafted age): the age fraction of its stalest perishable input, so preparing old produce does not
# make it fresh; 0 for an item that does not spoil. shortcut: one entry of several crafts gives every output the stalest input of all of them
# (never fresher than it should be); per-craft inputs would need the rows split by craft, revisit if long mixed-age queues matter.
func _made_age(made: int, entry: Array) -> int:
	var life: int = table.shelf_units(made)
	return 0 if life <= 0 else int(round((1.0 - _stalest_input(entry)) * float(life)))


# Where a sealed batch may go (master s3.14 bulk): the pack, then the player's own storage within the crafting reach, nearest first, each up to its
# free space for `number` at age 0 (carry weight or a vehicle's payload, and a slot to put it in). [[inventory, world id or -1 for the pack, room], ...].
func _batch_spots(peer: int, number: int) -> Array:
	var out: Array = []
	var inv = inventory_of(peer)

	if inv == null:
		return out

	if _batch_slot(inv, number):
		out.append([inv, -1, _fit(peer, inv, number, table.COUNT_MAX)])

	for box in _craft_boxes(peer):
		if bool(box[3]):
			continue   # a station's store keeps its own products; a sealed batch goes to the pack and storage only (master s3.14)

		box[1].usable = _store_usable(str(_items[int(box[0])]["struct"]["kind"]), box[1])

		if _batch_slot(box[1], number):
			out.append([box[1], int(box[0]), _box_room(int(box[0]), number, table.COUNT_MAX)])

	return out


# A slot a fresh batch can go into: an empty one, or a plain stack of it at age 0 (Inventory._mergeable joins a Maturing batch only at its own age).
func _batch_slot(inv, number: int) -> bool:
	if inv.grows:
		return true   # a pack makes room (Inventory.add); its weight still caps the batch (_fit)

	for i in inv.usable:
		if inv.numbers[i] == 0 or (inv.numbers[i] == number and inv.inst[i].is_empty() and inv.wear[i] == 0 and inv.counts[i] < table.stack_of(number)):
			return true

	return false


func _batch_room(peer: int, number: int) -> int:
	var room: int = 0

	for spot in _batch_spots(peer, number):
		room += int(spot[2])

	return room


# A sealed batch goes into the pack and the player's nearby storage, never onto the ground: the queue capped it to the room, and the craft waits
# while that room is gone (_craft_tick). It starts at age 0 and matures from there.
func _give_batch(peer: int, number: int, count: int) -> void:
	var left: int = count

	for spot in _batch_spots(peer, number):
		if left <= 0:
			break

		var before: Array = _snapshot(spot[0]) if int(spot[1]) < 0 else []
		var put: int = mini(left, int(spot[2]))
		put -= spot[0].add(number, put)
		left -= put

		if int(spot[1]) < 0:
			_send_changes(peer, spot[0], before)
		elif put > 0:
			_push_box(int(spot[1]), spot[0])

	if left > 0:   # not reached (the room was checked this tick); kept so a disagreement between the room and Inventory.add can never lose food
		push_error("sealed batch: %d of item %d found no room after the check" % [left, number])
		drop_in_world(number, left, _peer_pos.get(peer, Vector3.ZERO))

	_dirty = true


func _sync_craft_queue(peer: int) -> void:
	if not send_craft_queue.is_valid():
		return

	var queue: Dictionary = _craft_queues.get(_peer_key.get(peer, ""), {})
	var entries: Array = queue.get("entries", [])
	var left_ms: int = 0

	if not entries.is_empty():
		var head_recipe: Dictionary = recipes.recipe(int(entries[0][0]))

		if _variant_of(entries[0]) != 0 and not head_recipe.is_empty():
			head_recipe = _variant_recipe(head_recipe, _variant_of(entries[0]))   # as _craft_tick works it

		# The fixed time _craft_tick finishes on once the craft runs; before that, the time it would take now (the craft fixes it when it starts,
		# so a head that waits for its station takes the station's pace from then, not from when it was queued).
		var craft_s: float = float(queue["need_s"]) if queue.has("need_s") else _need_now(peer, head_recipe, _variant_of(entries[0]))
		left_ms = int(maxf(craft_s - float(queue["elapsed"]), 0.0) * 1000.0)

	send_craft_queue.call(peer, _pairs(entries), left_ms)


func _pairs(entries: Array) -> Array:
	var out: Array = []

	for entry in entries:   # a variant craft (catalog Phase 2c) adds its SmithingRules code: [recipe, count, variant]
		out.append([int(entry[0]), int(entry[1])] if _variant_of(entry) == 0 else [int(entry[0]), int(entry[1]), _variant_of(entry)])

	return out


func craft_queue_of(peer: int) -> Array:
	return _pairs(_craft_queues.get(_peer_key.get(peer, ""), {}).get("entries", []))


func _save_craft_queues() -> void:
	var rows: Dictionary = {}

	for key in _craft_queues:
		if not _craft_queues[key]["entries"].is_empty():
			rows[key] = _craft_queues[key]

	_write_atomic("craft_queues.json", {"version": 1, "players": rows, "seed_pinch": true})


func _load_craft_queues() -> void:
	var parsed: Variant = _read_json_version("craft_queues.json", 1)

	if parsed == null:
		return

	_old_seed_files["queues"] = not bool(parsed.get("seed_pinch", false))

	for key in parsed.get("players", {}):
		var row: Dictionary = parsed["players"][key]
		var entries: Array = []

		for entry in row.get("entries", []):
			var needs: Array = []

			for need in entry[2] if entry.size() > 2 else []:
				var units: Array = []

				for unit in (need[2] if need.size() > 2 and typeof(need[2]) == TYPE_ARRAY else []):
					if typeof(unit) == TYPE_ARRAY and (unit as Array).size() >= 2:
						var kept: Dictionary = InventoryScript.clean_inst(unit[1])

						if typeof(unit[1]) == TYPE_DICTIONARY and (unit[1] as Dictionary).has("liquid_ml"):   # a liquid row (Inventory.remove_fill): clean_inst drops its keys, a refund needs them (GA-04)
							for liquid_key in ["liquid_ml", "box", "uid", "tank"]:
								if (unit[1] as Dictionary).has(liquid_key):
									kept[liquid_key] = int(unit[1][liquid_key])

						var per_unit: int = table.rename_count(int(unit[0]))   # a retired item comes back as its replacement (renames.json), a large block as 4 Wooden blocks
						units.append([table.current_number(int(unit[0])), kept, maxi(int(unit[2]), 0) if unit.size() > 2 else 0, clampi((int(unit[3]) if unit.size() > 3 else 1) * per_unit, 1, 65535)])   # what the craft took (_hold_insts); older rows: one unit, older still: wear 0

				var per_need: int = table.rename_count(int(need[0]))
				needs.append([table.current_number(int(need[0])), int(need[1]) * per_need, units] if not units.is_empty() else [table.current_number(int(need[0])), int(need[1]) * per_need])

			var parts: Array = []

			for need in entry[3] if entry.size() > 3 else []:
				parts.append([table.current_number(int(need[0])), int(need[1]) * table.rename_count(int(need[0]))])   # renamed like the needs (a large block: 4 Wooden blocks)

			var loaded: Array = [int(entry[0]), clampi(int(entry[1]), 1, CRAFT_QUEUE_MAX_COUNT), needs, parts, int(entry[4]) if entry.size() > 4 else 0]

			if entry.size() > 5 and SmithingRules.valid(int(entry[5])) and int(entry[5]) != 0:
				loaded.append(int(entry[5]))   # the variant (SmithingRules code)

			entries.append(loaded)

		_craft_queues[str(key)] = {"entries": entries, "elapsed": float(row.get("elapsed", 0.0))}


# Over-exertion (data/items/exertion.json): strain climbs with effort above rest and falls below it. Over
# over_on the player is over-exerted (the client caps speed); past faint_at they faint, then wake slowly.
func _strain_tick(peer: int, spent: float) -> void:
	if _exertion_cfg.is_empty():
		return

	var st: Dictionary = _strain.get(peer, {})

	if st.is_empty():
		st = {"s": 0.0, "state": 0, "t": 0.0}
		_strain[peer] = st

	var cfg: Dictionary = _exertion_cfg
	var body: float = float(vitals_of(peer).get("weight", 75.0))
	var scale: float = pow(float(cfg.get("reference_body_kg", 75.0)) / maxf(body, 20.0), 0.5) * float(cfg.get("fitness", 1.0))
	var state: int = int(st["state"])
	var strain: float = float(st["s"])
	st["t"] = float(st["t"]) + spent

	if state >= 2:
		st.erase("going")   # out (a strain faint, the cold or water): passing out is over, so waking hands the body back

	# Sleep ends on its own: fainting, standing up, rain on an open sleeper, or rested for rested_s seconds.
	var sleep_quality: float = 0.0

	if _asleep.has(peer):
		sleep_quality = _sleep_quality(peer)
		_asleep[peer]["t"] = float(_asleep[peer].get("t", 0.0)) + spent

		if _forced_sleep(peer):
			sleep_quality = clampf(sleep_quality, 0.0, 1.0)
		elif state >= 2 or int(_stance.get(peer, 0)) != 3:
			_end_sleep(peer)
			_strain_sent.erase(peer)
		elif sleep_quality < 0.0:
			_wake(peer, "Rain woke you")
		else:
			var rest: Dictionary = _asleep[peer]
			rest["rested"] = float(rest["rested"]) + spent if strain <= 0.0 else 0.0

			if bool(rest.get("nap", false)):
				if strain <= float(rest["nap_end"]) + 0.001 and _night_left <= 0.0:   # a night skip wakes everyone together at dawn
					_wake(peer, "You wake refreshed")
			elif float(rest["rested"]) >= float(_sleep_cfg.get("rested_s", 1.5)) and energy_of(peer) >= 99.9:
				# ADD-12: a night slept = a sleep (not a nap or a collapse) that filled the energy while lying on a bed or beside a lean-to; once per sleep.
				if not rest.has("night") and (_bed_of(peer) != 0 or _shelter_near(_peer_pos[peer]) >= 0):
					rest["night"] = true
					_goal_event(peer, "slept_night")

				if not on_good_bed(peer) and _night_left <= 0.0:   # during a night skip the sleeper sleeps on to the dawn
					_wake(peer, "You wake rested")   # on a good bed the sleeper stays (bed.json): only moving, a stance key, a hit or the bed going wakes them

	if state == 2:
		if float(st["t"]) >= float(cfg.get("faint_s", 8.0)):
			state = 3
			st["t"] = 0.0
			st["after_faint"] = true
			st["black"] = 0.0
			strain = float(cfg.get("wake_strain", 0.6))
	elif state == 3:
		strain = maxf(strain - float(cfg.get("rest_effort", 0.52)) * float(cfg.get("fall_per_s", 0.05)) * float(cfg.get("wake_fall_mult", 0.4)) * spent, 0.0)

		if float(st["t"]) >= float(cfg.get("wake_s", 12.0)):
			state = 1 if strain >= float(cfg.get("over_off", 0.75)) * scale else 0
			st.erase("rescued")   # up again: blows land as usual

			if state == 0:
				st["after_faint"] = false
			st["t"] = 0.0
	else:
		var diff: float = effort_of(peer) - float(cfg.get("rest_effort", 0.52))
		var rate: float = float(cfg.get("rise_per_s", 0.02)) * fitness_rise_mult(peer) * comfort_bonus(peer, "exhaustion_mult") if diff > 0.0 else float(cfg.get("fall_per_s", 0.05))   # the comfort meter: exertion builds slower

		# Slower to come down while still racing after a faint.
		if diff < 0.0 and bool(st.get("after_faint", false)):
			rate *= float(cfg.get("wake_fall_mult", 0.4))

		var stance: int = int(_stance.get(peer, 0))

		if diff < 0.0 and stance == 2:
			rate *= float(cfg.get("sit_fall_mult", 2.0))
		elif diff < 0.0 and stance == 3 and not crawling_of(peer):
			rate *= float(cfg.get("lie_fall_mult", 3.0)) + (maxf(float(_sleep_cfg.get("strain_mult", 6.0)) - float(cfg.get("lie_fall_mult", 3.0)), 0.0) * sleep_quality if _asleep.has(peer) else 0.0)

		var before: float = strain
		strain = maxf(strain + diff * rate * spent, 0.0)

		# A nap drops exertion fast, on a straight line to its end value in nap.target_s seconds.
		if _asleep.has(peer) and bool(_asleep[peer].get("nap", false)):
			strain = maxf(before - float(_asleep[peer]["nap_rate"]) * spent, float(_asleep[peer]["nap_end"]))

		# Standing under a heavy load only rests down to a floor (about half at the limit); sitting or lying has none.
		if diff < 0.0 and stance < 2:
			strain = maxf(strain, minf(before, float(cfg.get("stand_load_floor", 0.5)) * minf(_load_ratio(peer), 1.0)))

		if state == 0 and strain >= float(cfg.get("over_on", 1.0)) * scale:
			state = 1
		elif state == 1 and strain < float(cfg.get("over_off", 0.75)) * scale:
			state = 0
			st["after_faint"] = false

		# Blacking out is a smooth build-up, not a step (Dave 2026-10-21): past the faint threshold "black" climbs, faster the
		# further strain overshoots it (a straight line in the overshoot, no steps), and never slower than over blackout.fall_s.
		# Passing out takes the body at once (Dave 25 Nov 2026, QA #19: "they must stop the second the game determines its time to
		# pass out"): from the moment the threshold is crossed ("going") the player has no control, drops to lying and cannot get up,
		# and the black climbs on to 1 whatever strain does. Only a blackout that was not passing out (out of air) drains away.
		# When black reaches 1 the character is unconscious (state 2).
		var threshold: float = float(cfg.get("faint_at", 1.4)) * scale
		var black: float = float(st.get("black", 0.0))
		var blackout: Dictionary = cfg.get("blackout", {})

		if strain >= threshold and state <= 1 and not bool(st.get("going", false)):
			st["going"] = true
			_stance[peer] = 3
			_end_sleep(peer)

		if bool(st.get("going", false)) and state <= 1:
			var black_rate: float = maxf(_blackout_rate(maxf(strain / threshold - 1.0, 0.0), blackout), 1.0 / maxf(float(blackout.get("fall_s", 2.5)), 0.1))
			black = minf(black + black_rate * spent, 1.0)
		else:
			black = maxf(black - spent / maxf(float(blackout.get("recover_s", 6.0)), 0.1), 0.0)

		if _suffocate.has(peer):   # BUG-029: the vision closes in as the air stays out, and at 1 the character lies down unconscious
			black = maxf(black, clampf(float(_suffocate[peer]) / maxf(float(vitals_breath_faint_s()), 0.1), 0.0, 1.0))

		st["black"] = black

		if black >= 1.0 and state <= 1:
			state = 2
			st["t"] = 0.0
			st.erase("going")
			_stance[peer] = 3

	st["s"] = strain
	st["state"] = state
	_train_fitness(peer, effort_of(peer) if state < 2 else 0.0, spent)
	var fade: float = 0.0

	if state <= 1:
		fade = float(st.get("black", 0.0))                      # the blackout coming on, 0 to 1
	elif state == 2:
		var vision: float = float(cfg.get("vision_frac", 0.625))
		fade = vision + (1.0 - vision) * clampf(float(st["t"]) / float(cfg.get("faint_s", 8.0)), 0.0, 1.0)
	elif state == 3:
		fade = 1.0 - clampf(float(st["t"]) / float(cfg.get("wake_s", 12.0)), 0.0, 1.0)

	# Sleep: the blackout comes on smoothly (fade_in_s) and goes off smoothly (fade_out_s) after waking.
	if _asleep.has(peer):
		fade = maxf(fade, clampf(float(_asleep[peer].get("t", 0.0)) / maxf(float(_sleep_cfg.get("fade_in_s", 4.0)), 0.1), 0.0, 1.0))
	elif _waking.has(peer):
		_waking[peer]["t"] = float(_waking[peer]["t"]) + spent
		fade = maxf(fade, 1.0 - clampf(float(_waking[peer]["t"]) / maxf(float(_sleep_cfg.get("fade_out_s", 4.0)), 0.1), 0.0, 1.0))

		if float(_waking[peer]["t"]) >= float(_sleep_cfg.get("fade_out_s", 4.0)):
			_waking.erase(peer)

	_sync_body(peer, state, st)
	var points: Array = [int(strain * 50.0) * 20, state, int(fade * 200.0) * 5, int(_stance.get(peer, 0)) | (4 if _asleep.has(peer) else 0) | (8 if _forced_sleep(peer) else 0) | (16 if strain_going(peer) else 0)]

	if send_strain.is_valid() and _strain_sent.get(peer, []) != points:
		_strain_sent[peer] = points
		send_strain.call(peer, points[0], points[1], points[2], points[3])


# The heart in the ears, the expected wake time and the phase (protocol 59): 0 awake, 1 falling asleep, 2 out (asleep or fainted),
# 3 waking. Fainted: a fast, high heart (exertion.json faint_bpm.out), dropping to a calm faint_bpm.wake (90) for the waking stage (R-CORE-PASS-OUT). Asleep: slows
# from bpm.start to bpm.end over bpm.slow_s. Sent on change, whole bpm, ETA in steps of 5 s.
func _sync_body(peer: int, state: int, st: Dictionary) -> void:
	if not send_body.is_valid():
		return

	var fb: Dictionary = _exertion_cfg.get("faint_bpm", {"out": 172, "wake": 90})
	var bpm: float = 0.0
	var eta: float = 0.0
	var phase: int = 0

	if _suffocate.has(peer) and state <= 1:
		# BUG-029: suffocating, the heart climbs fast from bpm.start to bpm.peak over the seconds to the faint.
		var hb: Dictionary = _vitals_cfg.get("breath", {}).get("bpm", {})
		phase = 1
		bpm = lerpf(float(hb.get("start", 110.0)), float(hb.get("peak", 190.0)), clampf(float(_suffocate[peer]) / maxf(vitals_breath_faint_s(), 0.1), 0.0, 1.0))
	elif state == 2:
		phase = 2
		bpm = float(fb.get("out", 172))
		eta = maxf(float(_exertion_cfg.get("faint_s", 8.0)) - float(st["t"]), 0.0) + float(_exertion_cfg.get("wake_s", 12.0))
	elif state == 3:
		phase = 3
		bpm = float(fb.get("wake", 90))
		eta = maxf(float(_exertion_cfg.get("wake_s", 12.0)) - float(st["t"]), 0.0)
	elif _asleep.has(peer):
		var cfg: Dictionary = _sleep_cfg.get("bpm", {})
		var t: float = float(_asleep[peer].get("t", 0.0))
		phase = 1 if t < float(_sleep_cfg.get("fade_in_s", 4.0)) else 2
		bpm = lerpf(float(cfg.get("start", 66.0)), float(cfg.get("end", 44.0)), clampf(t / maxf(float(cfg.get("slow_s", 45.0)), 1.0), 0.0, 1.0))
		eta = sleep_eta(peer)
	elif _waking.has(peer):
		phase = 3
		bpm = float(_sleep_cfg.get("bpm", {}).get("wake", 72.0))
		eta = maxf(float(_sleep_cfg.get("fade_out_s", 4.0)) - float(_waking[peer]["t"]), 0.0)

	var row: Array = [int(round(bpm)), int(ceil(eta / 5.0)) * 5, phase]

	if _body_sent.get(peer, [0, 0, 0]) != row:
		_body_sent[peer] = row
		send_body.call(peer, row[0], row[1], row[2])


# How fast the blackout builds, per second, for an overshoot of the faint threshold (0 = right at it, as a fraction of it):
# 1 / slow_s at the threshold, rising in a straight line to 1 / fast_s at `margin` over it and beyond.
func _blackout_rate(overshoot: float, blackout: Dictionary) -> float:
	var slow: float = 1.0 / maxf(float(blackout.get("slow_s", 14.0)), 0.1)
	var fast: float = 1.0 / maxf(float(blackout.get("fast_s", 1.5)), 0.1)
	return lerpf(slow, fast, clampf(overshoot / maxf(float(blackout.get("margin", 0.25)), 0.001), 0.0, 1.0))


func strain_of(peer: int) -> Dictionary:
	return _strain.get(peer, {})


func _vitals_points(v: Dictionary) -> Array:
	var cap: float = float(_vitals_cfg.get("stomach_cap_kcal", 2400))
	var wet_cap: float = float(_vitals_cfg.get("thirst", {}).get("cap_ml", 2400))
	return [int(ceil(clampf(float(v["fed"]) / cap, 0.0, 1.0) * 100.0)), int(floor(float(v["health"]))), int(round(float(v["weight"]) * 10.0)), int(ceil(clampf(float(v["wet"]) / wet_cap, 0.0, 1.0) * 100.0))]


func _sync_vitals(peer: int, force: bool) -> void:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty() or not send_vitals.is_valid():
		return

	var now_points: Array = _vitals_points(v)

	if force or _vitals_sent.get(peer, []) != now_points:
		_vitals_sent[peer] = now_points
		send_vitals.call(peer, now_points[0], now_points[1], now_points[2], now_points[3], luck_of(peer), fitness_of(peer))
		_dirty = true

	_sync_training(peer, force)


# Today's training (the XP bucket that turns into fitness at game midnight) in whole percent of a fitness point, for the Tab screen.
func training_pm_of(peer: int) -> int:
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})
	var per_point: float = maxf(float(_fitness_cfg.get("train", {}).get("xp_per_point", 1000.0)), 1.0)
	return int(floor(float(row.get("xp_today", 0.0)) / per_point * 100.0))


func _sync_training(peer: int, force: bool) -> void:
	if not send_training.is_valid():
		return

	var pm: int = training_pm_of(peer)

	if force or int(_training_sent.get(peer, -1)) != pm:
		_training_sent[peer] = pm
		send_training.call(peer, pm)


func _container_cap(number: int) -> int:
	return int(table.entry(table.id_of(number)).get("capacity_ml", 0)) if number > 0 else 0


# Use on a water container: one mouthful (thirst.drink_ml) out of what it holds.
func _drink_from_container(peer: int, inv, slot: int, v: Dictionary) -> void:
	var thirst: Dictionary = _vitals_cfg.get("thirst", {})
	var now: int = Time.get_ticks_msec()

	if now - int(_last_drink.get(peer, -100000)) < int(thirst.get("drink_pace_ms", 900)):
		return

	if inv.wear[slot] <= 0:
		_say(peer, "It is empty.")
		return

	var cap: float = float(thirst.get("cap_ml", 2400))

	if float(v["wet"]) >= cap - 1.0:
		_say(peer, "You have had enough water.")
		return

	_last_drink[peer] = now
	var sip: int = mini(int(thirst.get("drink_ml", 300)), inv.wear[slot])
	var before: Array = _snapshot(inv)
	inv.wear[slot] -= sip
	v["wet"] = minf(float(v["wet"]) + float(sip), cap)
	_send_changes(peer, inv, before)
	_sync_vitals(peer, true)
	_dirty = true


# `choice` (ACT_EAT b): the answer to the food-effect question (food_effects.gd plan): 0 none yet, a group index to replace, DECLINE to eat for calories only.
func _eat(peer: int, inv, slot: int, choice: int = 0, platter: int = 0) -> void:
	var v: Dictionary = vitals_of(peer)
	var ask_slot: int = -platter if platter > 0 else slot   # food_ask: a pack slot, or minus the world id of the platter eaten from

	if v.is_empty() or slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0:
		return

	if _container_cap(inv.numbers[slot]) > 0:
		_drink_from_container(peer, inv, slot, v)
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_eat.get(peer, -100000)) < int(_vitals_cfg.get("eat_pace_ms", 800)):
		return

	var item_id: String = table.id_of(inv.numbers[slot])
	var spoil: Dictionary = table.spoilage()

	if inv.maturing_at(slot):   # a sealed batch is eaten only once Ready (master s3.14 [D14])
		_say(peer, "The %s is still maturing: about %d more game hours." % [table.sentence_name(inv.numbers[slot]), table.ready_hours_left(inv.numbers[slot], inv.wear[slot])])
		return

	if _eat_stopped(peer, item_id, now):
		_last_eat[peer] = now
		return

	if not spoil.is_empty() and item_id == str(spoil.get("rotten_item", "")):
		_last_eat[peer] = now
		inv.take_from_slot(slot, 1)

		if not tried_of(peer).has(item_id) and grace_of(peer) > 0.0:
			_harm_bite(peer, item_id, -1.0, "")
			return

		var sick: Dictionary = spoil.get("sick", {})
		v["health"] = maxf(float(v["health"]) - float(sick.get("health", 0)), 1.0)
		v["wet"] = maxf(float(v["wet"]) - float(sick.get("wet_ml", 0)), 0.0)
		_learn_food(peer, item_id, "harm")
		make_sick(peer)
		_sync_vitals(peer, true)
		return

	if _unfit.has(item_id):
		_last_eat[peer] = now
		_say(peer, "It tastes bitter and wrong. You spit it out.")
		return

	var cure: Dictionary = VitalsRules.medicine(item_id, _vitals_cfg)
	var step: Dictionary = FoodEffects.plan(_food_of(peer), _now_game_s(), item_id, choice, _food_cfg)

	if not cure.is_empty():
		if float(v.get("sick", 0.0)) <= 0.0:
			if FoodEffects.profile(item_id, _food_cfg).is_empty() or choice == FoodEffects.DECLINE:
				if _tea_quenches(v, item_id):   # a cup of tea is a cup of water: drunk for thirst while well
					_last_eat[peer] = now
					_warm_bite(v, item_id)
					inv.take_from_slot(slot, 1)
					_sync_vitals(peer, true)
					_dirty = true
					return

				_say(peer, "Your health is fine")
				return

			if _food_asked(peer, ask_slot, item_id, step):
				return

			_last_eat[peer] = now   # a medicinal tea while well: its Beverage effect only (s3.16 [D17]), never refused
			_warm_bite(v, item_id)
			_tea_quenches(v, item_id)
			inv.take_from_slot(slot, 1)
			_food_apply(peer, item_id, step)
			_sync_vitals(peer, true)
			return

		if _food_asked(peer, ask_slot, item_id, step):
			return

		_last_eat[peer] = now
		# Fresh herbs are stronger (spoilage), and a second dose soon after the first works only redose_share as well:
		# re-dosing shortens the effect instead of stacking it.
		var strength: float = 0.5 + 0.5 * table.freshness(inv.numbers[slot], inv.wear[slot])
		var recent: bool = float(now - int(_last_dose.get(peer, -10000000))) < float(_sick_cfg.get("dose_cooldown_s", 180.0)) * 1000.0

		if recent:
			strength *= float(_sick_cfg.get("redose_share", 0.25))
			_say(peer, str(_sick_cfg.get("say_too_soon", "")))

		_warm_bite(v, item_id)
		var quenched: bool = _tea_quenches(v, item_id)
		_last_dose[peer] = now
		inv.take_from_slot(slot, 1)
		v["sick"] = maxf(float(v["sick"]) - float(cure.get("cure_h", 12.0)) * 3600.0 * strength, 0.0)
		_say(peer, str(_sick_cfg.get("say_medicine", "")))
		_sync_sick(peer, true)

		if quenched:
			_sync_vitals(peer, true)   # the thirst bar shows the tea's water now

		_food_apply(peer, item_id, step)
		_dirty = true
		return

	var aid: Dictionary = VitalsRules.energy_aid(item_id, _vitals_cfg)

	if not aid.is_empty():
		if not _food_asked(peer, ask_slot, item_id, step):
			_use_energy_aid(peer, inv, slot, v, aid, step)

		return

	# A splint (vitals.json limp "cure_items") sets the leg and ends a limp at once.
	var limp_cfg: Dictionary = _vitals_cfg.get("limp", {})

	if (limp_cfg.get("cure_items", []) as Array).has(item_id):
		if float(v.get("limp", 0.0)) <= 0.0:
			_say(peer, "Your legs are fine.")
			return

		_last_eat[peer] = now
		inv.take_from_slot(slot, 1)
		v["limp"] = 0.0
		_say(peer, str(limp_cfg.get("say_cured", "Your leg is set.")))
		_sync_limp(peer, true)
		_dirty = true
		return

	var kcal: int = VitalsRules.food_value(item_id, _vitals_cfg)
	var heal: int = VitalsRules.heal_value(item_id, _vitals_cfg)
	var ml: int = VitalsRules.drink_value(item_id, _vitals_cfg)

	if kcal <= 0 and heal <= 0 and ml <= 0:
		_say(peer, "You cannot eat that.")
		return

	var wet_cap: float = float(_vitals_cfg.get("thirst", {}).get("cap_ml", 2400))

	if ml > 0 and kcal <= 0 and heal <= 0 and float(v["wet"]) >= wet_cap - 1.0:
		_say(peer, "You have had enough water.")
		return

	var cap: float = float(_vitals_cfg.get("stomach_cap_kcal", 2400))
	var limit: float = cap * (1.0 + float(_vitals_cfg.get("overeat_allowance", 0.25)))

	if kcal > 0 and heal <= 0 and float(v["fed"]) >= limit - 1.0:
		_say(peer, "You cannot eat another bite.")
		return

	if heal > 0 and kcal <= 0 and float(v["health"]) >= float(_vitals_cfg.get("health_max", 100)) - 0.5:
		_say(peer, "You are not hurt.")
		return

	if _food_asked(peer, ask_slot, item_id, step):
		return

	_last_eat[peer] = now
	_warm_bite(v, item_id)
	kcal = VitalsRules.eaten_kcal(kcal, table.freshness(inv.numbers[slot], inv.wear[slot]))   # stale food feeds less (the tooltip shows the same)
	inv.take_from_slot(slot, 1)
	var total: float = float(v["fed"]) + float(kcal)

	if total > cap:
		# Beyond a full stomach the surplus goes to the body.
		v["weight"] = clampf(float(v["weight"]) + (total - cap) * float(_vitals_cfg.get("gain_efficiency", 0.8)) / float(_vitals_cfg.get("kcal_per_kg", 7700)), float(_vitals_cfg.get("min_weight_kg", 40)), float(_vitals_cfg.get("max_weight_kg", 150)))
		total = cap

	v["fed"] = total
	_raw_sickness(peer, item_id)
	v["wet"] = minf(float(v["wet"]) + float(ml), wet_cap)
	v["health"] = clampf(float(v["health"]) + float(heal), 0.0, float(_vitals_cfg.get("health_max", 100)))
	_food_apply(peer, item_id, step)
	_sync_vitals(peer, true)

	if table.ready_units(table.number_of(item_id)) > 0 and int(_goal_state_of(peer).get("goal_counts", {}).get("made:" + item_id, 0)) > 0:   # ADD-20: a Ready sealed batch eaten by a character who has sealed that food (maturing is passive and its owner is not recorded; _goal_made counts the seal; the check above refuses a Maturing one)
		_goal_event(peer, "jar_matured")


# --- Temporary food effects (master s3.16 [D16, D17], data/items/food_effects.json, src/shared/food_effects.gd; catalog Phase 7) ---
# Up to three groups at once, each on its own game-clock timer, saved in characters.json "food" and cleared by death. XP bonuses
# are read where XP is earned (the Fitness tick, skill practice), so nothing is ever paid back for food eaten after the effort.

func _food_of(peer: int) -> Dictionary:
	var key: String = str(_peer_key.get(peer, ""))

	if not _characters.has(key):
		return {}

	if typeof(_characters[key].get("food", null)) != TYPE_DICTIONARY:
		_characters[key]["food"] = {}

	return _characters[key]["food"]


# True when the player must answer first: the question goes to the client (food_ask) and nothing is eaten.
func _food_asked(peer: int, slot: int, item_id: String, step: Dictionary) -> bool:
	if not step.has("ask"):
		return false

	if send_food_ask.is_valid():
		send_food_ask.call(peer, slot, table.number_of(item_id), PackedInt32Array(step["ask"]))

	return true


# The eaten food takes its slot; a Dessert newly filling its slot gives its energy at once (energy aids do that themselves: `instant` false).
func _food_apply(peer: int, item_id: String, step: Dictionary, instant: bool = true) -> void:
	if not step.has("group"):
		return

	var group: String = str(step["group"])
	FoodEffects.apply(_food_of(peer), _now_game_s(), item_id, step, _food_cfg)
	_goal_event(peer, "meal_effect")   # ADD-22: a food gave a temporary effect (a declined question or a refusal never gets here)
	var energy: float = float(FoodEffects.tier_row(group, int(FoodEffects.profile(item_id, _food_cfg)["tier"]), _food_cfg).get("energy", 0.0))

	if instant and energy > 0.0 and bool(step["fresh"]):
		var v: Dictionary = vitals_of(peer)
		v["energy"] = minf(float(v.get("energy", 100.0)) + energy, 100.0)
		_sync_energy(peer, true)

	_dirty = true
	_sync_food(peer, true)


func fitness_xp_mult(peer: int) -> float:
	return FoodEffects.fitness_mult(_food_of(peer), _now_game_s(), _food_cfg)


func skill_xp_mult(peer: int) -> float:
	return FoodEffects.skill_mult(_food_of(peer), _now_game_s(), _food_cfg, float(rested_tier(peer).get("skill_gain_mult", 1.0)))


func food_mult(peer: int, field: String) -> float:
	return FoodEffects.strongest(_food_of(peer), _now_game_s(), _food_cfg, field)


var _food_sent: Dictionary = {}   # peer -> the rows last sent


func _sync_food(peer: int, force: bool) -> void:
	if not send_food.is_valid() or not _characters.has(str(_peer_key.get(peer, ""))):
		return

	var now_s: float = _now_game_s()
	var on: Dictionary = FoodEffects.running(_food_of(peer), now_s)
	var rows: Array = []

	for group in _food_cfg.get("order", []):
		if not on.has(group) or float(on[group].get("until", 0.0)) <= now_s:
			continue

		var off: bool = bool(on[group].get("off", false))

		if off and float(FoodEffects.tier_row(str(group), int(on[group]["t"]), _food_cfg).get("xp", 0.0)) >= 0.0:
			continue   # a replaced entry shows only while its penalty runs (a dessert's XP -5 %)

		rows.append([FoodEffects.group_index(str(group), _food_cfg), table.number_of(str(on[group]["id"])), int(on[group]["t"]), int(ceil((float(on[group]["until"]) - now_s) / GAME_RATE / 60.0)), 1 if off else 0])

	if force or _food_sent.get(peer, null) != rows:
		_food_sent[peer] = rows
		send_food.call(peer, rows)


# --- Luck (job 77) ---
# Each character has a luck number, 0 to 100 (50 neutral, Dave 19 Nov 2026), rolled once with the other attributes (_new_attributes) when the server
# first sees the key (the creation screen will send a chosen value instead) and stored in characters.json. Every server roll that a player takes part in goes through
# roll_chance / roll_amount / fate so luck can nudge it (data/items/luck.json strength; 0 switches luck off).
func luck_of(peer: int) -> int:
	return Attributes.clamp_value(_characters.get(_peer_key.get(peer, ""), {}).get("luck", Attributes.NEUTRAL))   # an unknown peer is neutral


func _luck_strength() -> float:
	return float(_luck_cfg.get("strength", 0.04))


# A new player character's attributes, rolled once from attributes.json (the bell-shaped bands; a player's fitness in the middle range), or all
# average when roll_new_characters is off.
func _new_attributes() -> Dictionary:
	var out: Dictionary = {}

	for a in ATTRIBUTE_KEYS:
		out[a] = _fitness_default() if a == "fitness" else Attributes.NEUTRAL

	if roll_new_characters:
		out.merge(Attributes.roll_character(_fate_rng, _attr_cfg, true), true)

	out["fitness"] = clampi(int(out["fitness"]), _fitness_min(), _fitness_max())
	return out


# True with probability p, nudged by the peer's luck. `rng` is the caller's own stream (often seeded so a plant or a
# trunk gives the same on every server run); the draw is taken from it so replay stays the same.
func roll_chance(peer: int, rng: RandomNumberGenerator, p: float) -> bool:
	return LuckScript.chance(rng.randf(), p, luck_of(peer), _luck_strength())   # luck-exempt: the draw that luck then nudges


# A whole number from lo to hi, the top end likelier when lucky.
func roll_amount(peer: int, rng: RandomNumberGenerator, lo: int, hi: int) -> int:
	return LuckScript.amount(rng.randf(), lo, hi, luck_of(peer), _luck_strength())   # luck-exempt: the draw that luck then nudges


# The hook for later fate events (a fall going well or badly, a fight, a rare thing in the world): true when fate favours
# the peer with base probability p. Counted by kind so we can see what luck touches.
func fate(peer: int, kind: String, p: float) -> bool:
	fate_counts[kind] = int(fate_counts.get(kind, 0)) + 1
	return LuckScript.chance(_fate_rng.randf(), p, luck_of(peer), _luck_strength())   # luck-exempt: the fate stream


func _save_characters() -> void:
	_write_atomic("characters.json", {"version": CHARACTERS_VERSION, "players": _characters, "seed_pinch": true})


# Fitness (Dave 2026-10-21), see data/items/fitness.json: scales how fast exertion rises, a whole number min..max.
func _load_fitness_config() -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/fitness.json"))
	return parsed if typeof(parsed) == TYPE_DICTIONARY else {}


func _fitness_min() -> int:
	return clampi(int(_fitness_cfg.get("min", Attributes.MIN)), Attributes.MIN, Attributes.MAX)


func _fitness_max() -> int:
	return clampi(int(_fitness_cfg.get("max", Attributes.MAX)), Attributes.MIN, Attributes.MAX)


func _fitness_default() -> int:
	return clampi(int(_fitness_cfg.get("default", Attributes.NEUTRAL)), _fitness_min(), _fitness_max())


func fitness_of(peer: int) -> int:
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})
	return clampi(int(row.get("fitness", _fitness_default())) + floori(float(row.get("train", 0.0))), _fitness_min(), _fitness_max())   # floor, so training under the start loses its first point after one point of rest, as above


# Fitness trains slowly like a skill (Dave 2 Nov 2026, fitness.json "train"): any physical effort adds to the character's training,
# walking, running and tool work alike (effort_of: speed, tool work, load). Effort under min_effort (standing, strolling)
# earns nothing; from there the share rises in a straight line to 1 at full effort (running; hard tool work a little above), and one
# point takes seconds_per_point of full-effort time. True rest takes training back, a point per decay_s_per_point, and may take
# fitness below the creation value, down to the bottom of the range (Dave 21 Nov 2026: "being Idle can lower it below your start.
# that was not my rule. remove it."). The whole-number change is sent to the client.
var _train_rest: Dictionary = {}     # peer -> seconds continuously at rest (below rest_effort)


# Fitness XP (Dave 4 Nov, BUG-023). Every 10-second tick above min_effort (0.1) gives xp_base + xp_per_effort x effort XP (1 at the line,
# 1.8 at a steady walk (effort 0.4), 3 at a run), counted continuously here per second into the character's day bucket (xp_today); at game midnight the
# bucket is turned into points (xp_per_point = 1000 XP, the same at every level) and the player is told. A midnight that passes while
# the player is offline is paid at the next tick after login (one bucket only, saved with the character).
# Only effort below rest_effort held for rest_grace_s loses fitness, one point per decay_s_per_point. Effort between the two lines is neutral, and so is sleep.
func _train_fitness(peer: int, effort: float, spent: float) -> void:
	var cfg: Dictionary = _fitness_cfg.get("train", {})
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})

	if cfg.is_empty() or row.is_empty():
		return

	var before: int = fitness_of(peer)
	var train: float = float(row.get("train", 0.0))

	var today: int = _game_day()

	if int(row.get("xp_day", today)) != today:
		var banked: float = float(row.get("xp_today", 0.0)) / maxf(float(cfg.get("xp_per_point", 1000.0)), 1.0)
		row["xp_today"] = 0.0
		row["xp_day"] = today
		_dirty = true

		if banked > 0.0:
			train = minf(train + banked, minf(float(cfg.get("max_gain", 10)), float(_fitness_max() - int(row.get("fitness", _fitness_default())))))   # no hidden points above the top of the range
			row["train"] = train
			_say(peer, "Your day's work has made you fitter." if int(floor(train)) > int(floor(train - banked)) else "You feel your day's work in your legs.")
	elif not row.has("xp_day"):
		row["xp_day"] = today

	if effort > float(cfg.get("min_effort", 0.1)):
		var xp_per_tick: float = (float(cfg.get("xp_base", 1.0)) + float(cfg.get("xp_per_effort", 2.0)) * minf(effort, float(cfg.get("max_effort", 1.1)))) * fitness_xp_mult(peer)   # food: at the tick it is earned, never at the payout
		var pending: float = float(row.get("xp_today", 0.0)) + xp_per_tick * spent / maxf(float(cfg.get("tick_s", 10.0)), 1.0)
		row["xp_today"] = minf(pending, float(cfg.get("max_gain", 10)) * float(cfg.get("xp_per_point", 1000.0)))
		_dirty = true
		_train_rest[peer] = 0.0
	elif _asleep.has(peer):
		_train_rest[peer] = 0.0   # sleep is recovery, not idleness: a night in bed (about 20 real minutes) neither earns nor costs, and the grace starts again on waking
	elif effort <= float(cfg.get("rest_effort", 0.02)):
		var rested: float = float(_train_rest.get(peer, 0.0)) + spent
		_train_rest[peer] = rested

		if rested > float(cfg.get("rest_grace_s", 600.0)):
			var step: float = spent / maxf(float(cfg.get("decay_s_per_point", 43200.0)), 1.0)
			var lowest: float = float(_fitness_min() - int(row.get("fitness", _fitness_default())))   # fitness 0 at the most
			var rested_train: float = maxf(train - step, minf(lowest, train))
			row["train"] = rested_train   # saved with the next write; only a whole point lost marks the save dirty (below), not every idle tick
			train = rested_train
	else:
		_train_rest[peer] = 0.0   # a dawdle between the lines neither earns nor costs

	if train != float(row.get("train", 0.0)):
		row["train"] = train
		_dirty = true

	if fitness_of(peer) != before:
		_dirty = true
		_vitals_sent.erase(peer)
		_sync_vitals(peer, true)
	else:
		_sync_training(peer, false)   # a new whole percent of today's training (at most every few ticks), or the midnight reset to 0


# The shared multiplier on the exertion rise: below 1 for the fit, above 1 for the unfit (fitness.json). From 50 up it falls in a straight
# line to top_mult at 100 (Dave 21 Nov 2026: "scale in between 50 fitness being 100% and 100 being 50%"); under 50 it keeps
# exp(-(fitness - 50) / 5 x strength), which meets the line at 50 (with strength 0.05 and top_mult 0.5 at the same slope, no kink).
func fitness_rise_mult(peer: int) -> float:
	var fit: int = fitness_of(peer)

	if fit <= Attributes.NEUTRAL:
		return exp(-Attributes.offset(fit) * float(_fitness_cfg.get("strength", 0.05)))

	return lerpf(1.0, float(_fitness_cfg.get("top_mult", 0.5)), float(fit - Attributes.NEUTRAL) / float(Attributes.MAX - Attributes.NEUTRAL))


# Hook for training (not designed yet): set a character's fitness, clamped, saved with the character, sent to the client.
func set_fitness(peer: int, value: int) -> void:
	var key: String = _peer_key.get(peer, "")

	if not _characters.has(key):
		return

	_characters[key]["fitness"] = clampi(value, _fitness_min(), _fitness_max())
	_characters[key]["train"] = 0.0
	_dirty = true
	_vitals_sent.erase(peer)
	_sync_vitals(peer, true)


# Protocol 37 skill records become web records (data/items/skills.json "migration"): once, with a copy of the old file kept as
# characters.json.v1.bak the first time. `dry_run` only reports what would change.
func migrate_old_skills(key: String, row: Dictionary, dry_run: bool = false) -> Array:
	var report: Array = []
	var old_block: Dictionary = row.get("skills", {}) if typeof(row.get("skills", {})) == TYPE_DICTIONARY else {}

	if old_block.is_empty():
		return report

	if not dry_run and _dir != "" and not FileAccess.file_exists(_dir + "/characters.json.v1.bak") and FileAccess.file_exists(_dir + "/characters.json"):
		DirAccess.copy_absolute(_dir + "/characters.json", _dir + "/characters.json.v1.bak")

	var converted: Dictionary = SkillWeb.migrate_block(_skills_cfg, old_block, report)

	if not dry_run and _characters.has(key):
		_characters[key]["skills"] = converted

	return report


# A saved "last" {pos [x, y, z], t, left}, or {} when it is not a finite spot (an older save has none: the character starts at the world spawn).
func _clean_last(last: Variant) -> Dictionary:
	if typeof(last) != TYPE_DICTIONARY or typeof(last.get("pos", null)) != TYPE_ARRAY or (last["pos"] as Array).size() != 3:
		return {}

	var p: Array = []

	for v in last["pos"]:
		if not (typeof(v) in [TYPE_INT, TYPE_FLOAT]) or not is_finite(float(v)):
			return {}

		p.append(float(v))

	return {"pos": p, "t": int(last.get("t", 0)) if typeof(last.get("t", 0)) in [TYPE_INT, TYPE_FLOAT] else 0, "left": str(last.get("left", "disconnect"))}


# Saved rest points [x, y, z, "shelter" or "fire"]; a malformed one is dropped.
func _clean_rests(rests: Variant) -> Array:
	var out: Array = []

	if typeof(rests) != TYPE_ARRAY:
		return out

	for r in rests:
		if typeof(r) == TYPE_ARRAY and (r as Array).size() == 4 and str(r[3]) in ["shelter", "fire"] and [r[0], r[1], r[2]].all(func(v): return typeof(v) in [TYPE_INT, TYPE_FLOAT] and is_finite(float(v))):
			out.append([float(r[0]), float(r[1]), float(r[2]), str(r[3])])

	return out.slice(maxi(out.size() - REST_POINTS_MAX, 0))


func _load_characters() -> void:
	var parsed: Variant = _read_json_version("characters.json", CHARACTERS_VERSION, 1)

	if typeof(parsed) != TYPE_DICTIONARY or typeof((parsed as Dictionary).get("players", {})) != TYPE_DICTIONARY:
		return

	_old_seed_files["worn"] = not bool(parsed.get("seed_pinch", false))
	var old_scale: bool = int(parsed.get("version", 1)) < 2   # attributes saved on the -10 to +10 scale: converted once here, written back as version 2 on the next save

	if old_scale:
		_dirty = true

	for key in parsed.get("players", {}):
		if typeof(parsed["players"][key]) != TYPE_DICTIONARY:
			push_warning("characters.json: the record of %s is not a record, skipped (the others are kept)" % str(key))
			continue

		_characters[str(key)] = {
			"train": clampf(float(parsed["players"][key].get("train", 0.0)) * (float(Attributes.PER_OLD_POINT) if old_scale else 1.0), -float(Attributes.MAX), float(Attributes.MAX)),
			"worn": _clean_worn(parsed["players"][key].get("worn", [])),
			"shelter": parsed["players"][key].get("shelter", []) if typeof(parsed["players"][key].get("shelter", [])) == TYPE_ARRAY else [],
			"skills": parsed["players"][key].get("skills", {}) if typeof(parsed["players"][key].get("skills", {})) == TYPE_DICTIONARY else {},
			"purse": _clean_purse(parsed["players"][key]),
			"rep": parsed["players"][key].get("rep", {}) if typeof(parsed["players"][key].get("rep", {})) == TYPE_DICTIONARY else {},
			"new_player": bool(parsed["players"][key].get("new_player", false)),
			"tried": parsed["players"][key].get("tried", {}) if typeof(parsed["players"][key].get("tried", {})) == TYPE_DICTIONARY else {},
			"learned": parsed["players"][key].get("learned", {}) if typeof(parsed["players"][key].get("learned", {})) == TYPE_DICTIONARY else {},   # recipe numbers learned (F-01)
			"comfort": clampf(float(parsed["players"][key].get("comfort", 0.0)) if typeof(parsed["players"][key].get("comfort", 0.0)) in [TYPE_FLOAT, TYPE_INT] else 0.0, 0.0, 10.0),   # the comfort meter (23 Nov 2026); a 9257 save has none and starts at 0
			"food": parsed["players"][key].get("food", {}) if typeof(parsed["players"][key].get("food", {})) == TYPE_DICTIONARY else {},   # food effects {group: {id, t, until game s}}
			"last": _clean_last(parsed["players"][key].get("last", {})),   # where the character resumes (start_position_for)
			"rests": _clean_rests(parsed["players"][key].get("rests", [])),
			"spawn_bed": parsed["players"][key].get("spawn_bed", []) if typeof(parsed["players"][key].get("spawn_bed", [])) == TYPE_ARRAY and (parsed["players"][key].get("spawn_bed", []) as Array).size() == 3 else [],
			"goals_done": parsed["players"][key].get("goals_done", {}) if typeof(parsed["players"][key].get("goals_done", {})) == TYPE_DICTIONARY else {},   # starter goals finished
			"goal_counts": parsed["players"][key].get("goal_counts", {}) if typeof(parsed["players"][key].get("goal_counts", {})) == TYPE_DICTIONARY else {},
			"hints_seen": parsed["players"][key].get("hints_seen", {}) if typeof(parsed["players"][key].get("hints_seen", {})) == TYPE_DICTIONARY else {},   # events and crafts counted for the goals
			"grace_s": maxf(float(parsed["players"][key].get("grace_s", 0.0)), 0.0),   # eat-once: an older save has none, so no first-hour protection
		}

		# The day's fitness XP so far and the season the season hint last saw (restart drill 22 Nov 2026: a restart dropped them).
		if parsed["players"][key].has("xp_day"):
			_characters[str(key)]["xp_day"] = int(parsed["players"][key]["xp_day"])

		if parsed["players"][key].has("xp_today"):
			_characters[str(key)]["xp_today"] = maxf(float(parsed["players"][key]["xp_today"]), 0.0)

		if parsed["players"][key].has("season_seen"):
			_characters[str(key)]["season_seen"] = int(parsed["players"][key]["season_seen"])

		for a in ATTRIBUTE_KEYS:   # every attribute 0 to 100 (an old-scale value moves to the new scale; a missing one is average, fitness its default)
			var saved: Variant = parsed["players"][key].get(a, null)

			if saved == null:
				_characters[str(key)][a] = _fitness_default() if a == "fitness" else Attributes.NEUTRAL
			else:
				_characters[str(key)][a] = Attributes.from_old(saved) if old_scale else Attributes.clamp_value(saved)

		_characters[str(key)]["fitness"] = clampi(int(_characters[str(key)]["fitness"]), _fitness_min(), _fitness_max())

		if typeof(parsed["players"][key].get("hotbar", null)) == TYPE_ARRAY:   # a pointer-hotbar save (protocol 100 to 111): its keys move into the hotbar slots once at the join
			_characters[str(key)]["hotbar"] = parsed["players"][key]["hotbar"]

		if bool(parsed["players"][key].get("dead", false)):   # real death (death.json real_death): a dead character stays dead across a restart
			_characters[str(key)]["dead"] = true

		var skills_v: int = int(parsed["players"][key].get("skills_v", 1))

		if skills_v < 2:
			migrate_old_skills(str(key), parsed["players"][key])
			_dirty = true

		# Build 9257 and before (skills_v 2): trainings gave a floor 5 over the band; the character keeps what its skills read then.
		if skills_v < 3 and not _skills_cfg.is_empty():
			if SkillWeb.keep_old_floors(_skills_cfg, _characters[str(key)]["skills"], OLD_FLOOR_OVER_CAP) > 0:
				_dirty = true

		_characters[str(key)]["skills_v"] = 3


# Drink from the water at the player's feet (ACT_DRINK): one mouthful of thirst.drink_ml, paced like eating. The scene's water_near says whether water lies within reach.
func _drink_water(peer: int, slot: int = -1, inv = null) -> void:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty() or not _peer_pos.has(peer):
		return

	var thirst: Dictionary = _vitals_cfg.get("thirst", {})
	var now: int = Time.get_ticks_msec()

	if now - int(_last_drink.get(peer, -100000)) < int(thirst.get("drink_pace_ms", 900)):
		return

	var tank: int = _tank_near(_peer_pos[peer], float(thirst.get("reach_m", 3.0)))

	if tank >= 0:   # a trough, barrel or cistern of the water network within reach (6b part 2)
		_drink_from_tank(peer, slot, inv, tank, v, thirst, now)
		return

	var shown: bool = _drink_water_near(_peer_pos[peer], float(thirst.get("reach_m", 3.0)))

	# The sea is never drinkable (Dave 24 Nov 2026: "it should tell you that is too salty. try to find some fresh water."): standing in it, or with only
	# the sea in reach, the player is told so, whatever the record holds there.
	if _sea_at_feet(_peer_pos[peer]) or (not shown and _sea_near(_peer_pos[peer], float(thirst.get("reach_m", 3.0)))):
		if not _fresh_record_near(peer, thirst):
			_say(peer, str(thirst.get("sources", {}).get("say_salt", SALT_SAY)))
			return

	# The record's water counts too where the settled water does not show it (docs/design/drink_prompt_design.md (a)): a ground spring head, a narrow
	# brook. The rule below then says whether it runs (_drink_source_ok: "The bed is dry", frozen, salt).
	if not shown and not _record_water_near(peer, thirst):
		if _salt_only(peer, thirst):
			_say(peer, str(thirst["sources"].get("say_salt", SALT_SAY)))   # the sea (design section 2)
		else:
			_reject_said(peer, 0, "No water within reach.")

		return

	if not _drink_source_ok(peer, thirst):
		return

	# A water container in hand with room is filled instead (job 89); a full one lets you drink from the water as before.
	if inv != null and slot >= 0 and slot < inv.slot_count and inv.numbers[slot] != 0:
		var room: int = _container_cap(inv.numbers[slot]) - inv.wear[slot]

		if _container_cap(inv.numbers[slot]) > 0 and room > 0:
			_last_drink[peer] = now
			var before_fill: Array = _snapshot(inv)
			inv.wear[slot] += mini(int(thirst.get("fill_ml", 500)), room)
			_send_changes(peer, inv, before_fill)
			_dirty = true
			return

	var cap: float = float(thirst.get("cap_ml", 2400))

	if float(v["wet"]) >= cap - 1.0:
		_say(peer, "You have had enough water.")
		return

	_last_drink[peer] = now
	v["wet"] = minf(float(v["wet"]) + float(thirst.get("drink_ml", 300)), cap)
	_sync_vitals(peer, true)


# With thirst.sources on and the scene's water_source set (docs/design/drinking_water_design.md): salt water is refused, a dry bed is refused,
# and frozen water needs an ice hole within reach (the fishing hole). Off, or with no source rows, the drink goes on as before.
func _drink_source_ok(peer: int, thirst: Dictionary) -> bool:
	var cfg: Dictionary = thirst.get("sources", {})

	if not bool(cfg.get("enabled", false)) or not water_source.is_valid():
		return true

	var pos: Vector3 = _peer_pos[peer]
	var rows: Array = (water_source.call(pos, float(thirst.get("reach_m", 3.0))) as Array).duplicate()

	if rows.is_empty():
		return true   # the record knows nothing here (an older world): today's water test stands

	var icy: int = -1   # a row without its own ice field takes the server's ice rule at the player (_on_ice, the fishing ice), read once

	for i in range(rows.size()):
		if not (rows[i] as Dictionary).has("iced"):
			if icy < 0:
				icy = 1 if _on_ice(pos) else 0

			rows[i] = (rows[i] as Dictionary).merged({"iced": icy == 1})

	var weather: Dictionary = _weather_here(pos)
	var rain_h: float = float(rain_hours_at.call(pos, maxf(float(cfg.get("rain_memory_h", 24.0)), float(cfg.get("flash_memory_h", 6.0))))) if rain_hours_at.is_valid() else (_now_game_s() - _last_rain_s) / 3600.0
	var ctx: Dictionary = {"season": str(season_at.call(pos)) if season_at.is_valid() else _season(), "rain_h_ago": rain_h, "raining": float(weather.get("rain", 0.0)) > 0.05,   # starter-calendar: the fallback with no season_at (tests)
		"air_c": _air_here(pos, weather, 10.0), "wind": float(weather.get("wind", 0.0))}
	var found: Dictionary = DrinkRules.pick(cfg, rows, ctx)

	if str(found.get("refused", "")) == "salt":
		_say(peer, str(cfg.get("say_salt", SALT_SAY)))
		return false

	if str(found.get("refused", "")) == "dry":
		_say(peer, str(cfg.get("say_dry", "The bed is dry.")))
		return false

	if bool(found.get("frozen", false)) and not _hole_near(pos):
		_say(peer, str(cfg.get("say_frozen", "The water is frozen. Break a hole in the ice first.")))
		return false

	return true


# With thirst.sources on, a spring or brook row of the record's within reach (water_source): water to drink at, or to be told is dry, even where the
# settled water does not show it (a spring head under its bushes, a brook narrower than an 8 m cell).
func _record_water_near(peer: int, thirst: Dictionary) -> bool:
	var cfg: Dictionary = thirst.get("sources", {})

	if not bool(cfg.get("enabled", false)) or not water_source.is_valid():
		return false

	var rows: Array = water_source.call(_peer_pos[peer], float(thirst.get("reach_m", 3.0)))
	return rows.any(func(row): return str((row as Dictionary).get("kind", "")) in ["spring", "brook"])


# Any fresh water row of the record within reach (a lake, river, brook, spring...: every kind but salt). The fish map calls water with its bed at or
# under 0 m the sea (server_fish_water _classify), so a lower river or a lagoon there is still a drink when the record holds it as fresh.
func _fresh_record_near(peer: int, thirst: Dictionary) -> bool:
	if not water_source.is_valid():
		return false

	var rows: Array = water_source.call(_peer_pos[peer], float(thirst.get("reach_m", 3.0)))
	return rows.any(func(row): return str((row as Dictionary).get("kind", "salt")) != "salt")


# With thirst.sources on, no drinking water within reach (water_near) but salt water is: the sea, which the live sim does not hold.
func _salt_only(peer: int, thirst: Dictionary) -> bool:
	var cfg: Dictionary = thirst.get("sources", {})

	if not bool(cfg.get("enabled", false)) or not water_source.is_valid():
		return false

	var rows: Array = water_source.call(_peer_pos[peer], float(thirst.get("reach_m", 3.0)))
	return rows.any(func(row): return str((row as Dictionary).get("kind", "")) == "salt")


func _save_vitals() -> void:
	var rain: Variant = null   # seasonal brooks after a restart

	if is_finite(_last_rain_s):
		rain = _last_rain_s

	_write_atomic("vitals.json", {"version": 1, "players": _vitals, "last_rain_s": rain})


func _load_vitals() -> void:
	var parsed: Variant = _read_json_version("vitals.json", 1)

	if parsed == null:
		return

	if parsed.get("last_rain_s", null) != null:
		_last_rain_s = float(parsed["last_rain_s"])   # it rained before the restart: intermittent brooks still run (it read -INF: dry until the next rain)

	for key in parsed.get("players", {}):
		var row: Dictionary = parsed["players"][key]
		var fresh: Dictionary = _new_vitals()
		_vitals[str(key)] = {"fed": float(row.get("fed", fresh["fed"])), "weight": float(row.get("weight", fresh["weight"])), "health": float(row.get("health", fresh["health"])), "wet": float(row.get("wet", fresh["wet"])), "energy": clampf(float(row.get("energy", 100.0)), 0.0, 100.0), "warmth": clampf(float(row.get("warmth", 100.0)), 0.0, 100.0), "sick": maxf(float(row.get("sick", 0.0)), 0.0), "limp": maxf(float(row.get("limp", 0.0)), 0.0)}

		if float(row.get("soak", 0.0)) > 0.0:
			_vitals[str(key)]["soak"] = clampf(float(row["soak"]), 0.0, 1.0)   # wet clothes (_update_soak)

		if typeof(row.get("sick_due", null)) == TYPE_ARRAY and not (row["sick_due"] as Array).is_empty():
			_vitals[str(key)]["sick_due"] = row["sick_due"]   # pending sickness from raw food (docs/design/body_in_weather_design.md 5)
