# The item number the player says is in its hand (protocol 146 held_item), kept per peer for the goblin camps (server_tribes.gd armed).
var _held: Dictionary = {}   # peer -> item number
var _held_left: Dictionary = {}   # peer -> the left hand's item number (159)
var _hand_flags: Dictionary = {}  # peer -> held_item.gd HAND_* flags (159)
var send_flight: Callable          # (thrower peer, item number, from, velocity, burning): others see an arrow or thrown weapon fly (159)


func report_held(peer: int, number: int, left: int = 0, flags: int = 0) -> void:
	_held[peer] = maxi(number, 0)
	_held_left[peer] = maxi(left, 0)
	_hand_flags[peer] = flags & 15


# The item in this player's left hand (a torch, lantern or shield; 159), 0 for none: as held_number, only while the pack holds it.
func left_hand_number(peer: int) -> int:
	return _in_pack(peer, int(_held_left.get(peer, 0)))


# What the client says its hands are doing (held_item.gd HAND_*: bow raised 1, drawn 2, shield up 4, on a ladder 8), shown to the others only.
func hand_flags(peer: int) -> int:
	return int(_hand_flags.get(peer, 0))


# Whether the player bears a burning torch or lantern: its client's torch-burn report came within TORCH_REPORT_MS (as _flame_near).
func torch_burning(peer: int) -> bool:
	return _torch_seen.has(peer) and Time.get_ticks_msec() - int(_torch_seen[peer]) <= TORCH_REPORT_MS


# The item in this player's hand, 0 for none: what the client last said, and only while the pack still holds one (a claim of an item the
# player does not have counts as empty hands).
func held_number(peer: int) -> int:
	return _in_pack(peer, int(_held.get(peer, 0)))


# `number` when the player's pack holds one, else 0 (a claim of an item the player does not have counts as empty hands).
func _in_pack(peer: int, number: int) -> int:
	var inv = inventory_of(peer)

	if number == 0 or inv == null:
		return 0

	for slot in range(inv.slot_count):
		if inv.numbers[slot] == number:
			return number

	return 0


# A dropped line (coordinator, 23 Nov 2026): a game the server has not heard from for ABSENT_MS (it crashed, or its line was cut, and the
# line takes 60 to 120 s to time out, net_settings.gd) leaves the world. For the first ABSENT_MS the body stays and can be hurt, so pulling
# the cable is no instant escape; after that it is out of _peer_pos, so animals, goblins and bandits (all read the players from it) no longer
# find it and the other players no longer see it, and its hunger, thirst, warmth and wet stop (_vitals_tick) until its next report puts it back.
const ABSENT_MS := 15000
var _heard_ms: Dictionary = {}       # peer -> msec of its last position report
var _parked: Dictionary = {}         # peer -> where it was when it went quiet (out of _peer_pos)
var _park_check_ms: int = 0
# Whether tick parks a player not heard from for ABSENT_MS of real time. The game's server turns it on (terrain_server.gd, where the
# players report their spot several times a second). Off for everything else: the tests drive the clock by hand (tick(10.0) in a loop)
# after one position report, and on a loaded machine (Lane A, 4 jobs, 26 Nov 2026) one ran past ABSENT_MS of real time, its player was
# parked, and its drinks, crafts and builds were refused (the checks failed) though nothing was wrong. The absence tests call
# _park_quiet themselves.
var park_quiet_players: bool = false


func is_absent(peer: int) -> bool:
	return _parked.has(peer)


func _park_quiet(now: int) -> void:
	if now - _park_check_ms < 1000:
		return

	if _park_check_ms > 0 and now - _park_check_ms > 3000:
		for peer in _heard_ms.keys():
			_heard_ms[peer] = now   # the server itself stalled (a long save or a hitch): its own silence is no sign the players are gone

	_park_check_ms = now

	for peer in _peer_pos.keys():
		if now - int(_heard_ms.get(peer, now)) > ABSENT_MS:
			_parked[peer] = _peer_pos[peer]
			_peer_pos.erase(peer)
			print("Absent: peer %d not heard from for %.0f s: out of the world until it reports again" % [peer, float(now - int(_heard_ms.get(peer, now))) / 1000.0])


func report_position(peer: int, position: Vector3, velocity: Vector3 = Vector3.ZERO) -> void:
	if _peer_key.has(peer):
		_heard_ms[peer] = Time.get_ticks_msec()

		var was_parked: bool = _parked.erase(peer)
		_peer_pos[peer] = position

		if was_parked:
			print("Absent: peer %d is back" % peer)
			var open_id: int = int(_chest_viewer.get(peer, 0))

			if open_id > 0 and _items.has(open_id):
				var open_box = _chest_of(peer, open_id)

				if open_box != null:
					_push_box(open_id, open_box)   # what the others put in or took out while it was away: its open window shows the truth again

		_peer_move[peer] = [velocity if velocity.is_finite() else Vector3.ZERO, Time.get_ticks_msec()]

		if nearest_fresh_water.is_valid() and _drink_hint_due(peer, position):
			_sync_goals(peer)   # the drink goal's hint names the way to water from here
		_note_motion(peer, position)
		_tell_taken_near(peer, position)   # the branches, tide-line nodes and nests taken round here (protocol 160)
		_carts.follow(peer)   # the cart this player pulls comes after them (nothing for anyone else)
		_note_road_trip(peer, position)
		var now: int = Time.get_ticks_msec()
		_note_zone(peer, position)

		if _resume_to.has(peer):
			var target: Vector3 = _resume_to[peer][0]

			if position.distance_to(target) <= 8.0 or now - int(_resume_to[peer][1]) >= RESUME_WAIT_MSEC:
				_resume_to.erase(peer)   # the client is at its resume spot (it ignores one within 8 m of where it stands)

		if now - int(_spot_saved_msec.get(peer, 0)) >= SAVE_SPOT_EVERY_MSEC:
			_spot_saved_msec[peer] = now
			_note_spot(peer, "online")


const ZONE_EVERY_MSEC := 2000       # the biome under a player is read this often
const VENT_RANGE_M := 1500.0           # the volcano bed is inaudible beyond this (batch2_slots.json max_distance_m)
const VENT_MOVE_M := 1.0               # a vent anchor is sent again only when it moved by more than this (a different vent, or none)
const ZONE_TELEPORT_M := 200.0       # a jump this far between two reads (teleport, respawn) is sent at once
var _zone_sent: Dictionary = {}      # peer -> biome id the client was last told
var _zone_cand: Dictionary = {}      # peer -> a new biome read once; sent when the next read agrees (about 4 s)
var _zone_pos: Dictionary = {}       # peer -> position at the last read
var _zone_checked: Dictionary = {}   # peer -> msec of the last read
var _vent_sent: Dictionary = {}      # peer -> the vent anchor the client was last told (INF = none)


# The server never reads a ground tile on its main thread from a periodic check (a read takes about a second on Dave's PC, BugsList 108): the
# zone, vent, snow and hint checks skip a beat while the tile is read on a worker. Actions a player asks for (digging, drinking) still read it.
func _tile_ready_at(at: Vector3) -> bool:
	return not ground_ready.is_valid() or bool(ground_ready.call(at.x, at.z))


# Tell a client its biome: at once for a new player, after every teleport or respawn, and after a change that reads the same twice running (no flicker on
# a border). Reliable and ordered, so the client's last value is the server's last.
func _note_zone(peer: int, position: Vector3) -> void:
	if not zone_at.is_valid() or not send_zone.is_valid():
		return

	var now: int = int(zone_clock.call()) if zone_clock.is_valid() else Time.get_ticks_msec()

	if _zone_checked.has(peer) and now - int(_zone_checked[peer]) < ZONE_EVERY_MSEC:
		return

	if not _tile_ready_at(position):
		return   # the tile is being read on a worker: the zone and vent are looked at on the next report once it is in (BugsList 108)

	_zone_checked[peer] = now
	_note_vent(peer, position)
	var started: int = Time.get_ticks_usec()
	var biome: int = int(zone_at.call(position))
	zone_usec += Time.get_ticks_usec() - started
	zone_samples += 1
	var jumped: bool = _zone_pos.has(peer) and position.distance_to(_zone_pos[peer]) > ZONE_TELEPORT_M
	_zone_pos[peer] = position

	if biome < 0:
		return

	if not _zone_sent.has(peer) or jumped:
		_send_zone(peer, biome)
	elif biome == int(_zone_sent[peer]):
		_zone_cand.erase(peer)
	elif int(_zone_cand.get(peer, -2)) == biome:
		_send_zone(peer, biome)
	else:
		_zone_cand[peer] = biome


# The nearest volcanic vent within VENT_RANGE_M, on the zone's 2 s cadence: sent at login and whenever it changes (a different vent, or none in range).
func _note_vent(peer: int, position: Vector3) -> void:
	if not vent_near.is_valid() or not send_vent.is_valid():
		return

	var at: Vector3 = vent_near.call(position)
	var known: bool = _vent_sent.has(peer)
	var before: Vector3 = _vent_sent.get(peer, Vector3.INF)

	if known and (at == before or (at.is_finite() and before.is_finite() and at.distance_to(before) <= VENT_MOVE_M)):
		return

	# At login nothing needs saying when there is no vent: the client starts with none.
	_vent_sent[peer] = at

	if known or at.is_finite():
		vent_messages += 1
		send_vent.call(peer, at)


func _send_zone(peer: int, biome: int) -> void:
	_zone_sent[peer] = biome
	_zone_cand.erase(peer)
	zone_messages += 1
	send_zone.call(peer, biome)


func inventory_of(peer: int):
	return _inventories.get(_peer_key.get(peer, ""), null)


# Puts items in a player's inventory. Whatever does not fit lies on the ground at their feet.
# Returns how many went into the inventory. For harvesting and crafting.
func give(peer: int, number: int, count: int, item_inst: Dictionary = {}, item_wear: int = 0) -> int:
	var inv = inventory_of(peer)

	if inv == null or number <= 0 or count <= 0 or table.id_of(number) == "":
		return 0

	if is_shoulder_item(number):
		return _give_shoulder(peer, number, count)

	var before: Array = _snapshot(inv)
	var fits: int = _fit(peer, inv, number, count)
	var left: int = inv.add(number, fits, item_wear, item_inst) + (count - fits)
	var was_src: String = _gain_source
	_gain_source = SRC_GATHER if was_src == SRC_PICKUP else was_src
	_send_changes(peer, inv, before)
	_gain_source = was_src
	_dirty = true

	if was_src == SRC_PICKUP:   # no caller tagged it: a harvest, dig, mine, carcass or catch (goal got: counter)
		_goal_got(peer, number, count)

	if left > 0:
		# What a craft made and the pack could not take (a 60 kg Water wheel on a bare back) never despawns: the work is never lost (coordinator
		# 23 Nov 2026, under Dave's "never a ground-item cap"). Other overflow ages as any dropped item.
		drop_in_world(number, left, _peer_pos.get(peer, Vector3.ZERO), item_wear, CLEARED_LIFETIME_S if was_src == SRC_CRAFT else 0.0, NAN, NAN, "", item_inst)
		_say(peer, "%s: %d %s dropped at your feet" % ["Too heavy to carry" if fits < count else "Your pack is full", left, table.in_sentence(table.name_of(number))])

	return count - left


# --- The large logs on the shoulder (Dave 2026-10-21; 1 Nov 2026: a normal pack item, the shoulder is only how it is shown; 15 Nov 2026: up to two) ---
# A large log (items.json "carry": "shoulder") sits in the pack like any item: one slot, its weight counted once in the load, the same fuel / chest / craft rules as
# any log. Up to weights.json shoulder_logs_max (two) may be picked up (a third lies where it was), and the client draws the carry pose while the pack holds one.
# Tools are stowed while one is carried (_held_tool): both hands steady the logs. Eating and drinking still work.

func is_shoulder_item(number: int) -> bool:
	return number > 0 and str(table.entry(table.id_of(number)).get("carry", "")) == "shoulder"


# The pack slot of the first large log, -1 when there is none.
func _shoulder_slot(peer: int) -> int:
	var inv = inventory_of(peer)

	if inv == null:
		return -1

	for slot in range(inv.slot_count):
		if inv.numbers[slot] != 0 and is_shoulder_item(inv.numbers[slot]):
			return slot

	return -1


# The item id of the first large log in this player's pack (protocol 64: the client counts the rest in its own pack), "" when there is none.
func shoulder_of(peer: int) -> String:
	var slot: int = _shoulder_slot(peer)
	return table.id_of(inventory_of(peer).numbers[slot]) if slot >= 0 else ""


# How many large logs this player carries.
func shoulder_count(peer: int) -> int:
	var inv = inventory_of(peer)
	return CarryRules.shoulder_logs(inv, table).size() if inv != null else 0


# Both hands are on logs (a third is refused), so no more can be picked up.
func _shoulder_full(peer: int) -> bool:
	return shoulder_count(peer) >= CarryRules.shoulder_max(_carry_cfg)


# Its weight is already in the pack's total, so the shoulder adds nothing on top.
func _shoulder_kg(_peer: int) -> float:
	return 0.0


func sync_shoulder(peer: int) -> void:
	if send_carry.is_valid() and _characters.has(_peer_key.get(peer, "")):
		var id: String = shoulder_of(peer)
		_shoulder_sent[peer] = id
		send_carry.call(peer, id)


# The client is told again whenever the pack gains or loses the large log.
func _sync_shoulder_if_changed(peer: int) -> void:
	if _shoulder_sent.get(peer, null) != shoulder_of(peer):
		sync_shoulder(peer)


var _shoulder_sent: Dictionary = {}


# Puts one large log in the pack (it shows on the shoulder); with two already carried the new one lies at the player's feet. Returns how many were taken.
# `drop_rest` false: a caller that keeps its source (a ground pile, a chest) takes only what went in, so nothing is laid down and nothing is doubled.
func _give_shoulder(peer: int, number: int, count: int, item_inst: Dictionary = {}, drop_rest: bool = true) -> int:
	var key: String = str(_peer_key.get(peer, ""))
	var inv = inventory_of(peer)

	if not _characters.has(key) or inv == null:
		return 0

	var here: Vector3 = _peer_pos.get(peer, Vector3.ZERO)

	if _shoulder_full(peer):
		_say(peer, CarryRules.logs_full_say(_carry_cfg))

		if drop_rest:
			drop_in_world(number, count, here, 0, 0.0, NAN, NAN, "", item_inst)

		return 0

	if _carts.puller_of.has(peer):   # both hands are on the handle: as a log on the shoulder keeps a cart's handle out of reach (server_carts _grab)
		_say(peer, "Both hands are on the %s: let go of it first." % _carts.noun_for(int(_carts.puller_of[peer])))

		if drop_rest:
			drop_in_world(number, count, here, 0, 0.0, NAN, NAN, "", item_inst)

		return 0

	var before: Array = _snapshot(inv)
	var took: int = 1 if _fit(peer, inv, number, 1, item_inst) > 0 and inv.add(number, 1, 0, item_inst) == 0 else 0
	_send_changes(peer, inv, before)
	_dirty = true

	if took == 0:
		_say(peer, "Too heavy to carry any more")

	if count > took and drop_rest:
		drop_in_world(number, count - took, here, 0, 0.0, NAN, NAN, "", item_inst)

	return took


# D or the lay-down key with a log carried: one log lies on the ground in front of the player (the first in the pack; the key again lays the next).
func lay_down_shoulder(peer: int, at: Vector3 = Vector3.ZERO) -> bool:
	var slot: int = _shoulder_slot(peer)

	if slot < 0 or not _peer_pos.has(peer):
		return false

	var inv = inventory_of(peer)
	var here: Vector3 = _peer_pos[peer]
	var spot: Vector3 = at if at != Vector3.ZERO and at.distance_to(here) <= DROP_REACH_M else here
	var number: int = inv.numbers[slot]

	drop_in_world(number, 1, spot, 0, 0.0, NAN, NAN, "", inv.inst_of(slot))
	var before: Array = _snapshot(inv)
	inv.take_from_slot(slot, 1)
	_send_changes(peer, inv, before)
	_dirty = true
	return true


# Takes items out of a player's inventory (crafting). False and no change if they lack them.
func take(peer: int, number: int, count: int) -> bool:
	var inv = inventory_of(peer)

	if inv == null:
		return false

	var before: Array = _snapshot(inv)

	if not inv.remove(number, count):
		return false

	_send_changes(peer, inv, before)
	_dirty = true
	return true


# The base radius of a cone pile of `count` of item `number` (items.json pile "shape": "cone", PileRules), 0 for every other item.
func _cone_radius_of(number: int, count: int) -> float:
	var pile: Dictionary = table.entry(table.id_of(number)).get("pile", {})

	if not PileRules.is_cone(pile) or _carry_cfg.is_empty():
		return 0.0

	return PileRules.cone_radius(count, CarryRules.weight_of(table.id_of(number), _carry_cfg), float(pile["density_kg_m3"]))


const PILE_BLOCK_REACH_M := 30.0   # the widest thing that can stop a pile reaches this far past its own centre (a big building's half or a 5 m boulder)


# True when a cone pile of `radius` round `centre` would reach into a building or solid object (Dave 19 Nov 2026, PLAN.md 5b: "if it hits a
# building or solid object it has to stop ... it cant go into a building through the wall"): a placed structure's footprint, a boulder or a
# fire. Trees and bushes are not checked (the pile is shaped round them), nor road and path patches or garden plots ("roads shouldnt effect
# them at all"). `self_id` is the pile itself.
func _pile_blocked(centre: Vector3, radius: float, self_id: int) -> bool:
	for id in _ids_near(centre, radius + PILE_BLOCK_REACH_M):   # the sync grid's cells, not every record (gate review PR #1322: the cost per dropped stone)
		if id == self_id or not _items.has(id):
			continue

		var it: Dictionary = _items[id]
		var flat: Vector2 = Vector2(it["pos"].x - centre.x, it["pos"].z - centre.z)

		if it.has("boulder"):
			var info: Dictionary = it["boulder"]

			if flat.length() >= radius + float(info["radius"]):
				continue   # beyond the rock's whole size: no need to work out what is left of it

			var size_now: float = BoulderWear.radius_now(float(info["radius"]), int(it["count"]), int(info["total"]))

			if flat.length() < radius + size_now:
				return true
		elif it.has("fire"):
			if flat.length() < radius + 0.5:
				return true
		elif it.has("struct"):
			var kind: String = str(it["struct"].get("kind", ""))
			var def: Dictionary = _structures.get(kind, {})

			if def.is_empty() or kind == "path_patch" or bool(it["struct"].get("road", false)) or PlacementRules.is_plot(def) or is_pipe_kind(kind):
				continue   # a pipe run goes through anything (PLUMBING_DESIGN s9), so a pile lies over it

			# Only what stands in the pile's own height range stops it (gate review, PR #1322): a foundation or floor it lies on, or a roof or
			# upper floor over it, does not, so a pile in a house or on a stone yard's floor stays one pile.
			var room: Array = PlacementRules._box(def, it["pos"], float(it["struct"].get("yaw", 0.0)))

			if float(room[4]) <= centre.y + 0.1 or float(room[3]) >= centre.y + PileRules.cone_height(radius):
				continue

			var half: Vector2 = room[1]
			var local: Vector2 = PlacementRules.local_of({"pos": it["pos"], "yaw": float(it["struct"].get("yaw", 0.0))}, centre)
			var nearest: Vector2 = Vector2(clampf(local.x, -half.x, half.x), clampf(local.y, -half.y, half.y))

			if local.distance_to(nearest) < radius:
				return true

	return false


# Puts a stack on the ground. Always lays it (Dave 16 Nov 2026: "there should be no limit" on what lies on the ground); false only for no item or no count. `lifetime_s` above 0 keeps it at least that many real seconds (a felled tree's logs last as its trunk did).
# `rot_y` (radians, NAN for none) turns a new loose item about the vertical: a felled tree's logs lie along its trunk.
# `girth` (NAN for none) scales a split log's thickness to the trunk it came from (Dave 2 Nov 2026: a skinny tree gave big logs); LOG_MESH_RADIUS_M is 1.
const LOG_MESH_RADIUS_M := 0.25   # the drawn species log's mean radius (inventory_view _mesh_for: 0.28 and 0.22 at its ends)


func drop_in_world(number: int, count: int, position: Vector3, item_wear: int = 0, lifetime_s: float = 0.0, rot_y: float = NAN, girth: float = NAN, by: String = "", item_inst: Dictionary = {}) -> bool:
	if count <= 0 or number <= 0:
		return false

	if table.entry(table.id_of(number)).has("carcass_of") and _lay_whole(number, count, position, item_wear):
		return true   # a whole catch on the ground is its carcass again (Dave 25 Nov 2026), worked with the knife

	position = _settled_loose(position)

	# Same kind within MERGE_M joins the item already lying there (stackables without wear or instance data only), so a heap grows as one ground item.
	# A pile stopped by a building or solid object moves the rest beside it, on the side away from the pile's centre where it fell, and looks
	# again there (PLAN.md 5b PL-1, gate review PR #1322), so the next drop joins that pile instead of stacking a second cone on the first.
	var tries: int = 4 if item_wear == 0 and item_inst.is_empty() and table.stack_of(number) > 1 else 0

	if tries > 0 and not _wide_piles_built:
		_wide_piles_built = true

		for id in _items:
			if not _items[id].has("struct") and not _items[id].has("boulder") and not _items[id].has("scatter") and _cone_radius_of(int(_items[id]["number"]), int(_items[id]["count"])) > WIDE_PILE_M:
				_wide_piles[id] = true

	while tries > 0:
		tries -= 1
		var stopped: Dictionary = {}
		# Only the records near the drop and the few wide cone piles can take it (gate review PR #1322: not a walk of every record per stone).
		# shortcut: the sync grid is up to SYNC_EVERY_S old; ids laid since are added whole, but a record moved since is looked for where it was.
		var nearby: Array = _ids_near(position, MERGE_M + WIDE_PILE_M)

		for wide in _wide_piles.keys():
			if _items.has(wide):
				nearby.append(wide)
			else:
				_wide_piles.erase(wide)

		for id in nearby:
			if not _items.has(id):
				continue

			var near: Dictionary = _items[id]

			if near.has("scatter") or near.has("showroom") or near.has("struct") or near.has("fire") or near.has("tree") or near.has("boulder") or near.has("tilt"):   # an arrow in a tree stays one arrow
				continue

			if int(near["number"]) != number or int(near.get("wear", 0)) != 0 or near.has("inst") or int(near["count"]) >= PILE_CAP:
				continue

			if near.has("world") != _laying_world:
				continue   # a server pile and a player's pile never merge: the world reset keeps the one and takes the other

			var reach: float = MERGE_M + _cone_radius_of(number, int(near["count"]))   # a cone pile takes in what lands on or beside it, however big it grew

			if Vector2(near["pos"].x - position.x, near["pos"].z - position.z).length() <= reach and absf(near["pos"].y - position.y) <= 2.0 + PileRules.cone_height(reach - MERGE_M):
				var room: int = PILE_CAP - int(near["count"])
				var added: int = mini(count, room)

				if _cone_radius_of(number, int(near["count"]) + added) > 0.0 and _pile_blocked(near["pos"], _cone_radius_of(number, int(near["count"]) + added), id):
					stopped = near   # Dave 19 Nov 2026 (PLAN.md 5b): a building or solid object stops a pile; the rest starts a new pile beside it (PROVISIONAL PL-1)
					continue

				near["count"] = int(near["count"]) + added

				if _cone_radius_of(number, int(near["count"])) > WIDE_PILE_M:
					_wide_piles[id] = true

				near["left"] = maxf(PILE_LIFETIME_S if int(near["count"]) >= PILE_MIN else WORLD_ITEM_LIFETIME_S, maxf(lifetime_s, float(near["left"]) if float(near["left"]) > 1.0e8 else 0.0))   # a never-expiring heap (crafted overflow, a cleared piece's leavings) stays so
				_tick_ageing(id)   # a kept pile passes here too and stays kept (left over 1e8, so _expire_items skips it); the call only lists it

				if by != "":
					near["by"] = by   # the last player to add to it (goblin gifts, a stray's food; saved, by_rows)

				_dirty = true
				count -= added

				if count <= 0:
					return true

				break   # the rest (over the cap) falls through and starts a second pile

		if stopped.is_empty():
			break

		var away: Vector2 = Vector2(position.x - stopped["pos"].x, position.z - stopped["pos"].z)

		if away.length() < 0.01:
			away = Vector2(1.0, 0.0)

		away = away.normalized() * (_cone_radius_of(number, int(stopped["count"])) + MERGE_M)
		position = _settled_loose(Vector3(stopped["pos"].x + away.x, position.y, stopped["pos"].z + away.y))

	var first: int = mini(count, PILE_CAP)
	_items[_next_id] = {"number": number, "count": first, "pos": position, "left": maxf(PILE_LIFETIME_S if first >= PILE_MIN else WORLD_ITEM_LIFETIME_S, lifetime_s), "wear": item_wear}

	if _wide_piles_built and _cone_radius_of(number, first) > WIDE_PILE_M:
		_wide_piles[_next_id] = true

	if not is_nan(rot_y):
		_items[_next_id]["rot_y"] = rot_y

	if not item_inst.is_empty():
		_items[_next_id]["inst"] = item_inst.duplicate(true)

	if by != "":
		_items[_next_id]["by"] = by   # who dropped it (goblin gifts, a stray's food; saved in the area files' by_rows, 23 Nov 2026)

	if not is_nan(girth):
		_items[_next_id]["girth"] = clampf(girth, 0.25, 2.5)

	_wake_log(_next_id)   # a log dropped comes to rest the way physics says (_roll_tick)
	_next_id += 1
	_dirty = true

	if count > first:
		return drop_in_world(number, count - first, position, item_wear, lifetime_s, rot_y, girth, by, item_inst)   # over the cap: the rest starts a second pile beside it

	return true


# Bug 6 (Dave 2 Nov 2026: about a second's pause when an old trunk is cut up): every player action is timed, and one over SLOW_ACTION_MS prints a line,
# so the server log shows whether the pause is here (and which action) or in the client ("client slow: world items ...").
const SLOW_ACTION_MS := 20.0


func action(peer: int, kind: int, a: int, b: int, count: int, at: Vector3) -> void:
	_act_events.clear()
	var t0: int = Time.get_ticks_usec()
	_action(peer, kind, a, b, count, at)
	var ms: float = float(Time.get_ticks_usec() - t0) / 1000.0

	if ms > SLOW_ACTION_MS:
		print("server slow: action %d (a %d, b %d) took %.0f ms, %d world items" % [kind, a, b, ms, _items.size()])


func _action(peer: int, kind: int, a: int, b: int, count: int, at: Vector3) -> void:
	var inv = inventory_of(peer)

	if inv == null or _parked.has(peer):
		return   # an absent player (no position report for ABSENT_MS) acts on nothing: a game that stops reporting is no untouchable body that still crafts and eats (gate review); a frozen game's next report puts it back within 0.2 s

	var before: Array = _snapshot(inv)

	if kind == Net.ACT_MOVE:
		inv.move(a, b)             # move() ignores bad slots
	elif kind == Net.ACT_DROP:
		if a == -1:
			lay_down_shoulder(peer, at)
		else:
			_drop(peer, inv, a, count, at)
	elif kind == Net.ACT_PICKUP:
		_pickup(peer, inv, a, count)
	elif kind == Net.ACT_HIT:
		_hit(peer, inv, a, Vector2i(b, count), int(at.x) - 1)   # a tree blow's at.x is the held pack slot + 1 (protocol 115)
	elif kind == Net.ACT_CHEST_OPEN or kind == Net.ACT_CHEST_PUT or kind == Net.ACT_CHEST_TAKE:
		if kind == Net.ACT_CHEST_OPEN and a >= 0 and _tribe_piece_refuses(peer, a):
			return   # a goblin camp's chest: not opened, but it says what is in it

		_chest_action(peer, inv, kind, a, b, count, int(at.x) - 1 if kind == Net.ACT_CHEST_PUT else -1)   # a put's at.x: the store slot it was dragged onto + 1 (protocol 121)
	elif kind == Net.ACT_USE_STRUCT:
		if _tribe_piece_refuses(peer, a):
			return

		_use_struct(peer, inv, a, b, count - 1)   # count: the held pack slot + 1, for the chopping block's axe (protocol 117)
	elif kind == Net.ACT_EAT:
		var fed_before: float = float(vitals_of(peer).get("fed", 0.0))
		var eaten: String = table.id_of(int(inv.numbers[a])) if a >= 0 and a < inv.slot_count else ""   # before it is eaten: the goal counter names the food
		_eat(peer, inv, a, b)

		if float(vitals_of(peer).get("fed", 0.0)) > fed_before:
			_goal_event(peer, "ate_food", eaten)
	elif kind == Net.ACT_DRINK:
		var wet_before: float = float(vitals_of(peer).get("wet", 0.0))
		_drink_water(peer, a, inv)

		if float(vitals_of(peer).get("wet", 0.0)) > wet_before:
			_goal_event(peer, "drink")
	elif kind == Net.ACT_ICEHOLE:
		_cut_hole(peer, inv, a)
	elif kind == Net.ACT_FISH:
		_fish(peer, inv, a, at)
	elif kind == Net.ACT_NET:
		_net_cast(peer, inv, a, b == 1, at)
	elif kind == Net.ACT_SHOOT:
		_shoot(peer, inv, a, b, at, count)
	elif kind == Net.ACT_WEAR:
		_gain_quiet = true
		_wear(peer, inv, a)
		_gain_quiet = false
	elif kind == Net.ACT_UNWEAR:
		_gain_quiet = true
		_unwear(peer, inv, a)
		_gain_quiet = false
	elif kind == Net.ACT_REPAIR:
		_repair(peer, inv, a)
	elif kind == Net.ACT_FUEL:
		var fuel_tier: int = _lit_tier_at(a)
		_fuel(peer, inv, a)
		_goal_fire_tier(peer, a, fuel_tier)
	elif kind == Net.ACT_STANCE:
		_set_stance(peer, a)
	elif kind == Net.ACT_SLEEP:
		_sleep(peer, a)
	elif kind == Net.ACT_LIGHT:
		var was_laid: bool = _items.has(a) and _items[a].has("fire") and int(_items[a]["fire"]["state"]) in [9, FIRE_STATE_ASH]
		_light(peer, inv, a)

		if was_laid and _items.has(a) and _items[a].has("fire") and fire_is_lit(int(_items[a]["fire"]["state"])):
			_goal_event(peer, "fire_lit")
			_goal_fire_tier(peer, a, 0)   # lit straight to a bigger tier (wood already in the store) credits it too
	elif kind == Net.ACT_COOK:
		_cook(peer, inv, a)
	elif kind == Net.ACT_SPLIT:
		_split(inv, a, count, peer)
	elif kind == Net.ACT_PROCESS:
		_process_trunk(peer, inv, a, int(at.x) - 1)   # at.x: the held pack slot + 1 for wood work (protocol 115)
	elif kind == Net.ACT_MINE:
		_mine(peer, inv, at, a - 1, b == 1)   # a: the held pack slot + 1 (protocol 117); b = 1: the swing struck nothing (protocol 118)
	elif kind == Net.ACT_CHEST_CLOSE:
		var closed: int = int(_chest_viewer.get(peer, 0))
		var close_tier: int = _lit_tier_at(closed)
		_sync_fire_from_box(peer, closed)   # a burning fire's store counts when its window closes: the wood put in may lift the tier
		_goal_fire_tier(peer, closed, close_tier)
		_chest_viewer.erase(peer)
	elif kind == Net.ACT_CHEST_KEEP_OUT:
		_set_keep_out(peer, a, b == 1)
	elif kind == Net.ACT_CHEST_LOCK:
		if _tribe_piece_refuses(peer, a):
			return

		_lock_action(peer, inv, a, b, count)
	elif kind == Net.ACT_VIEW_OPEN:
		_view_open(peer, a)
	elif kind == Net.ACT_VIEW_TAKE:
		_view_take(peer, inv, a, b, count)
	elif kind == Net.ACT_VIEW_PUT:
		_view_put(peer, inv, a, b, count)
	elif kind == Net.ACT_CART:
		_carts.action(peer, b, a)
	elif kind == Net.ACT_CRAFT_STOCK:
		_send_stock(peer, a == 1)   # a = 1: the hammer list's poll while walking (held_item.gd), answered cheaply and only when the stock changed
	elif kind == Net.ACT_FAVOURITE:
		if a >= 0 and a < inv.slot_count and inv.numbers[a] != 0:
			inv.set_fav(a, b == 1)
	elif kind == Net.ACT_BULK:
		_bulk(peer, inv, a, b)
	elif kind == Net.ACT_AUTOLOAD:
		_autoload(peer, a, b, count == 1)
	elif kind == Net.ACT_LITTER:
		_pick_litter(peer, inv, at)
	elif kind == Net.ACT_DIG:
		_dig(peer, inv, at, a)   # a: the held pack slot, -1 for nothing in hand
	elif kind == Net.ACT_FILL:
		_fill(peer, inv, at, a)
	elif kind == Net.ACT_GATHER_EDGE:
		gather_edge(peer, inv)
	elif kind == Net.ACT_SET_SPAWN:
		set_spawn_bed(peer, a)
	elif kind == Net.ACT_PUSH_LOG:
		_push_log(peer, a, b >= 1000, float(count), float(b % 1000) / 100.0, at)   # b: 1000 when sprinting + how square the walk is into it in hundredths; count: the heading in degrees (protocol 125)
	elif kind == Net.ACT_TILL_GARDEN:
		till_garden(peer, inv, at, a, b, count)   # a: the held pack slot, b: the grid's turn in degrees, count: check * 10000000 + mode * 10000 + width * 100 + length (protocol 128)
	elif kind == Net.ACT_PLANT_GRID:
		plant_grid(peer, inv, a, b, count, at)   # a: the held pack slot (the hoe), b: the item to plant, count: check * 10000000 + yaw * 10000 + width * 100 + length (protocol 128)
	elif kind == Net.ACT_STUCK:
		_stuck_rescue(peer, at)
	elif kind == Net.ACT_DIG_TRENCH:
		dig_trench(peer, inv, at, a, b)   # a: the held pack slot (the hoe), b: the way the player faces, whole degrees (protocol 135)
	elif kind == Net.ACT_TILL:
		till(peer, inv, at, a, b)   # b: the hoe grid's turn in whole degrees (0: the bed snaps to the world's metre cells)
	elif kind == Net.ACT_HARVEST:
		harvest(peer, inv, a, at)
	elif kind == Net.ACT_WATER_BED:
		water_bed(peer, inv, a, b)   # b: the pack slot of the filled container in hand (WP-R1B), -1 for none; a slot with no water in it is refused
	elif kind == Net.ACT_HOE_PATH:
		_hoe_path(peer, inv, at, a)
	elif kind == Net.ACT_HOE_SMOOTH:
		_hoe_smooth(peer, inv, at, a)
	elif kind == Net.ACT_HOE_GRADE_POINT:
		_hoe_grade_point(peer, inv, b, at, a)
	elif kind == Net.ACT_HOE_GRADE:
		_hoe_grade(peer, inv, at, a)
	elif kind == Net.ACT_PLACE:
		_place(peer, inv, a, at, count, b)
	elif kind == Net.ACT_REPAIR_STRUCT:
		if _tribe_piece_refuses(peer, a):
			return

		_repair_struct(peer, inv, a, b - 1)   # b: the held pack slot + 1 (protocol 117)
	elif kind == Net.ACT_PLACE_BLUEPRINT:
		_place(peer, inv, -1, at, count, b, _blueprints.get(a, {}))
	elif kind == Net.ACT_THROW:
		_throw(peer, inv, a, at)
	elif kind == Net.ACT_HIT_SHRUB:
		_hit_shrub(peer, inv, a, Vector2i(b, count), int(at.x) - 1)   # at.x: the held pack slot + 1 (protocol 117)
	elif kind == Net.ACT_PLANT_BUSH:
		_plant_bush(peer, inv, a, at)
	elif kind == Net.ACT_DOUSE:
		_douse(peer, inv, a, b == 1)
	elif kind == Net.ACT_TORCH_BURN:
		_torch_burn(peer, inv, a)
	elif kind == Net.ACT_RELIGHT:
		_relight(peer, inv, a, b)
	elif kind == Net.ACT_PLACE_TORCH:
		_place_torch(peer, inv, a, b == 1, count, at)
	elif kind == Net.ACT_SEEN:
		shot_seen[peer] = [b, count]
	elif kind == Net.ACT_STRIKE:
		strike_seen[peer] = [b, count]   # protocol 155: when its screen showed the animals (0 from a client that sends none: judged now)
		_strike(peer, inv, a, at)
	elif kind == Net.ACT_CRAFT:
		if (not admin_ok.is_valid() or admin_ok.call(peer)) and _hand_tool_ok(peer, inv, recipes.recipe(a), int(at.x) - 1):   # the instant craft (test keys; admin only, split A5: no station, no time) keeps the tool rule too
			recipes.craft(a, inv)
	elif kind == Net.ACT_FALL:
		_fall(peer, a)
	elif kind == Net.ACT_CRAFT_QUEUE or kind == Net.ACT_CRAFT_CANCEL:
		var now: int = Time.get_ticks_msec()

		if now - int(_last_queue_act.get(peer, -100000)) >= QUEUE_ACT_GAP_MS:
			_last_queue_act[peer] = now

			if kind == Net.ACT_CRAFT_QUEUE:
				_queue_craft(peer, inv, a, count, b, int(at.x) - 1)   # at.x: the held pack slot + 1 (126; a kept tool counts from the pack now)
			else:
				_cancel_craft(peer, a)
	elif kind == Net.ACT_ADMIN_GIVE:
		if table.id_of(a) != "" and (not admin_ok.is_valid() or admin_ok.call(peer)):
			var bag_was: int = inv.bag_from
			inv.bag_from = 0   # an admin give fills from the first slot (tests and the admin tool); player pickups keep to the bag
			var left: int = inv.add(a, clampi(count, 1, 100))
			inv.bag_from = bag_was
			_goal_admin_gave(peer, a, clampi(count, 1, 100) - left)

			if left > 0:
				drop_in_world(a, left, _peer_pos.get(peer, Vector3.ZERO))

	elif kind == Net.ACT_CLEAR_DROPS:
		if not admin_ok.is_valid() or admin_ok.call(peer):
			_say(peer, "Cleared %d dropped items." % clear_dropped(_peer_pos.get(peer, Vector3.ZERO), float(clampi(a, 1, 500))))

	elif kind == Net.ACT_SHOWROOM:
		if not admin_ok.is_valid() or admin_ok.call(peer):
			_showroom_seed(peer, a == 1, at)

	elif kind == Net.ACT_WHEEL_ASK:
		_wheel_ask(peer, a, b, at)
	elif kind == Net.ACT_SPYGLASS:
		if a == 2:
			_look_spyglass_item(peer, inv, count, b)
		elif a != 1:
			spyglass.erase(peer)
			spyglass_tier.erase(peer)
		elif not admin_ok.is_valid() or admin_ok.call(peer):
			spyglass[peer] = maxi(b, 0)
			spyglass_tier.erase(peer)
		else:
			spyglass[peer] = -1   # refused: the server scene tells the client once (animal_info id -1) and forgets it
			_say(peer, "The spyglass is for admins.")

	elif kind == Net.ACT_ADMIN_ENERGY:
		if admin_ok.is_valid() and admin_ok.call(peer):
			vitals_of(peer)["energy"] = clampf(float(count), 0.0, 100.0)

	elif kind == Net.ACT_ADMIN_SKILL:
		if admin_ok.is_valid() and admin_ok.call(peer):
			admin_set_skill(peer, a, count)

	elif kind == Net.ACT_NEW_PLAYER:
		if admin_ok.is_valid() and admin_ok.call(peer):
			_become_new_player(peer)

	elif kind == Net.ACT_ADMIN_MODE:
		if admin_ok.is_valid() and admin_ok.call(peer):
			if a == 1:
				_admin_mode_on[peer] = true
			else:
				_admin_mode_on.erase(peer)
				_drop_free_crafts(peer)

			_say(peer, "Admin mode %s." % ("on: crafting is free" if a == 1 else "off"))
		else:
			_say(peer, "Admin mode is for admins.")

	elif kind == Net.ACT_DUMP_WATER:
		if admin_ok.is_valid() and admin_ok.call(peer) and dump_water.is_valid():
			_say(peer, "Water dump: %s" % str(dump_water.call(at.x, at.z)))
	elif kind == Net.ACT_LAND_TYPES:
		if admin_ok.is_valid() and admin_ok.call(peer) and land_types.is_valid():
			_say(peer, "Land types: %s" % str(land_types.call(at.x, at.z)))
	elif kind == Net.ACT_RESET_EDITS:
		if admin_ok.is_valid() and admin_ok.call(peer) and reset_terrain_edits.is_valid():
			print("server: peer %d reset all terrain edits" % peer)
			reset_terrain_edits.call()
			_say(peer, "All terrain edits are deleted. The ground is rebuilding.")
	elif kind == Net.ACT_RESET_WORLD:
		if admin_ok.is_valid() and admin_ok.call(peer):
			var gone: int = reset_world()
			print("server: peer %d reset the world: %d world rows removed, terrain edits %s" % [peer, gone, "reset" if reset_terrain_edits.is_valid() else "not wired"])

			if reset_terrain_edits.is_valid():
				reset_terrain_edits.call()

			for other in _peer_key:
				_say(int(other), "An admin reset the world: %d dropped items and placed things are gone and the ground is rebuilding." % gone)
		else:
			_say(peer, "Resetting the world is for admins.")

	_end_bag_edit(peer)
	_send_changes(peer, inv, before)
	_dirty = true


var ground_ready: Callable              # (x, z) -> bool: the ground there is in memory; when not, it is being read in the background (unset in tests = always ready)
var water_flow_at: Callable             # set by the server: (Vector3) -> float, the running speed of the water there in m/s (-1 none, 0 still), for placement rules
var water_wheel: Callable               # set by the server: (a: Vector3, b: Vector3) -> {"w": watts, "why": "" or dry/river/still/shallow, "along": bool}, a water wheel spanning a to b (WaterFlow.wheel)
var cave_floor: Callable                # set by the server: (Vector3) -> the floor of the cave air at a point (a passage, chamber or a mouth's cut), NAN outside one; ground_height does not know the caves
var edits_near: Callable                # set by the server: (point, radius) -> [[kind 0 dig / 1 fill, centre, radius]], the saved ground edits near a point, oldest first (ground_ops.gd); ground_height does not know them
var ground_now: Callable               # set by the server: (x, z) -> the ground as dug and filled (edited_ground.height; the top of the highest solid span); unset: ground_height
var floor_below: Callable               # set by the server: (Vector3) -> float, the height a loose item let go there comes to rest at (NAN if none)
var land_types: Callable                # set by the server: (x, z) -> String, classifies the land near a point from the live water and writes a text file
var dump_water: Callable                # set by the server: (x, z) -> String, writes the live water cells near a point to a text file
var reset_terrain_edits: Callable       # set by the server: () -> void, wipes every saved dig and fill
var forgot_key: Callable                # set by the server: (key) -> void, a deleted character's other records go too (server_map.forget_key)
var restore_flora: Callable             # set by the server: () -> void, forgets every felled tree and removed plant (server_flora.restore_all), for reset_world
var admin_ok: Callable                  # set by the server: true when the peer may use admin gives
var spyglass: Dictionary = {}          # peer -> the animal id an admin watches through the spyglass (0 none, -1 refused: not an admin); absent when not looking (ACT_SPYGLASS)
var spyglass_tier: Dictionary = {}     # peer -> the tier of the spyglass item looked through (absent: the admin glass, or not looking)
var _spyglass_tiers: Dictionary = {}   # data/items/spyglass.json "tiers", read on the first look


# ACT_SPYGLASS a = 2 (10 Nov 2026, data/items/spyglass.json): up to the eye through the spyglass item in pack slot `slot`. Needs no admin: the
# item is checked (a spyglass, not broken), one use of it is worn per look, and the server sends animals out to the tier's radius
# (spyglass_reach). The watched animal `watched` counts only for a tier with a readout. Refused: animal_info(-1) brings the client's glass down.
func _look_spyglass_item(peer: int, inv, slot: int, watched: int) -> void:
	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot])) if slot >= 0 and slot < inv.slot_count and inv.numbers[slot] != 0 else {}

	if str(entry.get("tool_class", "")) != "spyglass" or _is_broken(inv, slot):
		spyglass[peer] = -1
		spyglass_tier.erase(peer)
		return

	if _spyglass_tiers.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/spyglass.json")) if FileAccess.file_exists("res://data/items/spyglass.json") else null
		_spyglass_tiers = parsed.get("tiers", {}) if typeof(parsed) == TYPE_DICTIONARY else {}

	var tier: int = int(entry.get("tier", 1))

	if not spyglass_tier.has(peer):
		_wear_slot(peer, inv, slot, "look")   # one use per look, not per resend

	spyglass_tier[peer] = tier
	spyglass[peer] = maxi(watched, 0) if bool(_spyglass_tiers.get(str(tier), {}).get("readout", false)) else 0


# The animals sent to a player looking through a spyglass: [radius m, cap]. The admin glass uses animals.json "spyglass" (`admin_cfg`),
# an item its tier's send_radius_m and cap; [-1, -1] when not looking (the normal send).
func spyglass_reach(peer: int, admin_cfg: Dictionary) -> Array:
	if not spyglass.has(peer) or int(spyglass[peer]) < 0:
		return [-1.0, -1]

	var cfg: Dictionary = _spyglass_tiers.get(str(spyglass_tier[peer]), {}) if spyglass_tier.has(peer) else admin_cfg
	return [float(cfg.get("send_radius_m", 300.0)), int(cfg.get("cap", 60))]


func tick(delta: float) -> void:
	var t0: int = Time.get_ticks_usec()

	if park_quiet_players:
		_park_quiet(Time.get_ticks_msec())
	_slow_parts = []
	_slow_prev_usec = t0
	_throttle_mark = -1   # set by this tick's first scatter cell when a CPU quota holds the server (the slow lines)
	_fly(delta)
	_roll_tick(delta)
	_showroom_retry(delta)
	_road_tick(delta)
	_slow_mark("fly-showroom-roads", t0)
	_slow_in += delta

	# Fires and item lifetimes only need about 4 looks a second (TD note 2026-10-20: 1.5 ms a frame at 1300 records).
	if _slow_in >= SLOW_TICK_S:
		var spent: float = _slow_in
		_slow_in = 0.0
		_slow_tick(spent, t0)
		_night_skip_check()

	# Each player's vitals and goals about 4 times a second as before, but a share of the players each frame, not all on one frame
	# (load test 23 Nov 2026, docs/design/SERVER_SCALE.md: at 32 to 64 players the quarter-second frame took 100 to 400 ms).
	_vitals_spread(delta)
	_slow_mark("vitals", t0)
	_goals_spread(delta)
	_slow_mark("goals-spread", t0)

	_sync_in -= delta
	_road_sync_in -= delta

	if _road_sync_in <= 0.0 and not _road_fresh.is_empty() and _sync_in > 0.0:
		_road_sync_in = ROAD_SYNC_S
		_sync_world_items(_road_fresh, _road_near)
		_road_fresh = []
		_road_near = []

	if _sync_in <= 0.0:
		_sync_in = SYNC_EVERY_S
		_scatter_around_players()
		_slow_mark("scatter", t0)
		_sync_world_items()
		_road_fresh = []   # the full sync sent them
		_road_near = []
		_slow_mark("sync-world-items " + _sync_detail, t0)

	_save_in -= delta
	_save_sweep(_sweep_slice(delta))   # one pass of the save check per save interval (see _item_job)

	_reap_writer()

	_retry_failed_saves()

	_save_parts = []
	_since_save += delta

	if _save_in <= 0.0 or _event_save_due():
		_autosave()

	_slow_mark("save" + (" (stringify %s)" % ", ".join(_save_parts) if not _save_parts.is_empty() else ""), t0)
	var tick_ms: float = float(Time.get_ticks_usec() - t0) / 1000.0

	if tick_ms > SLOW_TICK_LOG_MS:
		# One line a slow tick, naming each part's own time (the old lines gave only the running total, so a 274 ms "scatter reached after"
		# did not say whether scatter or something before it took the time). Printed from a worker: a print can stall the main thread (#397).
		# With a CPU quota and a scatter cell laid this tick, how much the container's throttled time rose since then (as on the slow-cell line;
		# no extra read on a tick that is not slow).
		var paused: String = ""

		if _throttle_mark >= 0:
			var now_paused: int = CpuBudget.throttled_usec(CpuBudget.read_text(_throttle_path))
			paused = "; container CPU quota throttling rose %.0f ms since the first scatter cell (summed over CPUs)" % (float(now_paused - _throttle_mark) / 1000.0) if now_paused >= 0 else ""

		_log_off_main("items tick slow: %.0f ms; parts over %.0f ms: %s%s" % [tick_ms, SLOW_PART_LOG_MS, ", ".join(_slow_parts), paused])


# Testing aid (Tyler, 31 Oct 2026): the items tick times its parts, so a join stall names its part. Each mark closes the part since the last
# one; a part over SLOW_PART_LOG_MS goes on the tick's list, printed at the end of a tick over SLOW_TICK_LOG_MS.
func _slow_mark(part: String, _since_usec: int) -> void:
	var now: int = Time.get_ticks_usec()
	var ms: float = float(now - _slow_prev_usec) / 1000.0
	_slow_prev_usec = now

	if part_profile:
		var key: String = part.get_slice(" ", 0)
		part_ms[key] = float(part_ms.get(key, 0.0)) + ms   # the soak's ranking of the tick's parts (soak_server.gd --players)

	if ms > SLOW_PART_LOG_MS:
		_slow_parts.append("%s %.0f" % [part, ms])


# A log line printed on a worker thread (a print flushes the log on the PC's debug build and stalled the main thread 400+ ms, #397).
# High priority: the low-priority pool threads (30 % of them) can be held for a minute by the flora cover chunks a join starts
# (David4 15 Nov 2026: lines waited 55-63 s behind them). The periodic save never waits for a line (_finish_writer).
func _log_off_main(line: String) -> void:
	_reap_log_lines()
	_log_tasks.append(WorkerThreadPool.add_task(func() -> void: print(line), true, "items log line"))


# Frees the log-line tasks already printed (a task must be waited for once); never waits for one still queued.
func _reap_log_lines() -> void:
	var still: Array = []

	for task in _log_tasks:
		if WorkerThreadPool.is_task_completed(task):
			WorkerThreadPool.wait_for_task_completion(task)
		else:
			still.append(task)

	_log_tasks = still


# A big event (a building finished, a trade, a station craft done, falling asleep or waking, a player leaving) saves soon, not at the next
# 30 s save, so a crash never loses it (D-TODO-2, coordinator 21 Nov 2026; Minecraft and Valheim also save on such moments). Coalesced:
# at most one such save each EVENT_SAVE_GAP_S, and only while the writer is idle, so a run of crafts costs one save and an event save never
# waits for the disk on the tick (the 30 s save still does). `ids`: world items the event changed, marked for the save now; the rolling check
# (_save_sweep) would reach them only within a save interval or two.
func save_soon(ids: Array = []) -> void:
	for id in ids:
		if _items.has(id):
			_save_note(id)

	_dirty = true   # the event changed something saved in the files every save writes (pack, coins, vitals, the character row)
	_event_save = true


# True once every tree felled so far is in files on disk (its stump and logs saved and the writer idle). The server writes the flora's
# removals only then (terrain_server), so a crash never leaves a felled tree gone with no stump and no logs (the coordinator, 23 Nov 2026);
# the other way round, a stump on disk whose tree's removal is not, is put right at the next start (felled_flora).
func fells_on_disk() -> bool:
	return not _fell_unsaved and _writer == null and _pending_writes.is_empty() and _save_failed.is_empty()   # a save that lost a file put its others back (_skip_item_job)


# Every saved stump that was a standing flora tree, as [chunk Vector2i, flora id]: the server cuts each again at start (a no-op for one
# already cut), so a stump saved before the flora's removals were written never stands beside its tree again.
func felled_flora() -> Array:
	var out: Array = []

	for id in _items:
		var tree: Variant = _items[id].get("tree")

		if tree != null and (tree as Dictionary).has("flora_id") and typeof(tree.get("chunk")) == TYPE_ARRAY and (tree["chunk"] as Array).size() == 2:
			out.append([Vector2i(int(tree["chunk"][0]), int(tree["chunk"][1])), int(tree["flora_id"])])

	return out


# An area file the writer could not write (_save_failed) is built again by the next save, and until then a stump in it may not be on disk.
func _retry_failed_saves() -> void:
	if _writer == null and not _save_failed.is_empty():
		_save_failed.clear()
		_dirty = true   # an area file could not be written: the next save builds it again
		_fell_unsaved = true   # the flora's removals wait for that save too (fells_on_disk)


# At start (terrain_server): each saved stump's flora tree is cut again where the flora's removals lack it. Returns how many were cut.
func cut_felled_flora(flora) -> int:
	var cut: int = 0

	for felled in felled_flora():
		if not flora.removed_in(felled[0]).has(int(felled[1])) and flora.cut(felled[0], int(felled[1])):
			cut += 1

	return cut


# A big event's save is due once the gap since the last save has passed and the writer is idle (_reap_writer ran this tick).
func _event_save_due() -> bool:
	if not _event_save and ground_edits.is_valid() and int(ground_edits.call()) != _digs_written:
		_event_save = true   # a dig or fill (a player's, an admin's, a tunnel's collapse, a reset): saved within seconds, so a hard stop drops seconds of them, not 30
	return _event_save and _since_save >= EVENT_SAVE_GAP_S and _writer == null and _pending_writes.is_empty()


# The tick's save: the files are copied now and written off the tick (_start_writer).
func _autosave() -> void:
	_save_in = SAVE_EVERY_S
	_since_save = 0.0
	_event_saves += 1 if _event_save else 0
	_event_save = false
	_async_writes = true
	save()
	_async_writes = false
	_start_writer()


# Save files that exist but could not be read (damaged with no usable .prev, or written by a newer server). While any are listed nothing is
# saved, so a world that came up empty never overwrites the real one; terrain_server.gd refuses to start.
var load_failures: Array = []


func save() -> void:
	if _dir != "" and not _dirty and load_failures.is_empty() and not _water_kind.is_empty():
		_dirty = _water_tanks_save() != _tanks_written   # a tank's litres moved (rain, a pump, a pipe) and nothing else changed (restart drill 23 Nov 2026)

	if not _dirty and ground_edits.is_valid() and int(ground_edits.call()) != _digs_written:
		_dirty = true   # a dig or fill that changed no item still moves the header's "digs": unsaved, the next start would drop it

	if _dir == "" or not _dirty or not load_failures.is_empty():
		return

	var t_wait: int = Time.get_ticks_usec()
	_finish_writer()   # an earlier background write finishes first, so files land in order
	_note_save_part("waiting for the last write", t_wait)   # a save that held the tick 1.2 s on Lane A (21 Nov 2026) names this part if it is the cause

	_dirty = false
	_set_gen = _save_gen + 1   # every file of this save carries the gen _item_job gives the header, written last (_read_json_version)
	_fell_unsaved = false   # this save carries every stump and log felled so far (on disk once the writer is idle: fells_on_disk)
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for key in _picked.keys():
		if now_s - float(_picked[key]) >= REGROW_GAME_S:
			_picked.erase(key)

	var invs: Dictionary = {}

	for key in _inventories:
		invs[key] = _inventories[key].to_json_array()

	_write_atomic("inventories.json", {"version": INVENTORY_VERSION, "inventories": invs, "seed_pinch": true})
	_save_chests()
	_save_vitals()
	_save_characters()
	_save_craft_queues()
	_tanks_written = _water_tanks_save()
	_write_atomic("crops.json", {"version": 1, "crops": _crops, "plots": _plot_water, "tanks": _tanks_written, "wells": _wells_save()})
	_write_atomic("smelters.json", {"version": 1, "smelters": _smelters.save_rows(), "lit": _smelters.lit_rows()})
	_write_atomic("smithies.json", {"version": 1, "smithies": _smithies.save_rows(), "fuel": _smithies.fuel_rows()})
	_write_atomic("tracking_marks.json", _traps.saved_marks())   # the trail signs and snare spots that already trained each character's Tracking

	for name in set_extras:   # other systems' files that must land in the same whole save as the packs (trade_state.json: a shelf and the pack it paid)
		var extra: Variant = (set_extras[name] as Callable).call()

		if extra is Dictionary:
			_write_atomic(str(name), extra)

	_save_item_files(_item_job())
	_set_gen = 0


# The files made from the world items (world_items.json, tree_states.json, lights.json, kilns.json) are built from a deep copy taken on the
# tick (_item_job), and the periodic save hands that copy to the background writer, which builds the rows, turns them into JSON and writes
# them. Building the rows and the JSON of every world item on the tick froze the server once per save, longer the more the world held
# (audit 18 Nov 2026, docs/ai-team/audits/2026-11-18_oversized_reactions_audit.md finding 2). The tick now pays only the native copy.
# The world items are saved by area (Minecraft region files, Paper's chunk saving): each AREA_M square has its own file. A periodic save copies
# and builds only the areas marked dirty and writes them, then world_items.json,
# the header naming each area file's gen. A crash between the two leaves the header naming the gens of the save before, which the files' .prev
# copies hold (_read_area). Any other save (shutdown, world reset, tests) re-indexes every item and writes every area exactly.
#
# The dirty marks come from a rolling check, not from hooks at the change sites: world items change in place at hundreds of spots, and one
# missed hook would lose that change from the save without a sound. Each tick looks at a slice of the items (_save_sweep, bounded in time by
# SWEEP_BUDGET_US, so a huge world stretches the pass, never the tick): a native hash of each item, its running countdowns in AREA_STEP_S steps
# (_save_sig_of), and its area. A changed hash or area marks the old and new areas dirty; the same walk over the world ids finds the gone ones. One pass
# covers the world within a save interval (a longer one is logged), so a change reaches the disk within two save intervals: PROVISIONAL, for
# Dave's review, a crash can lose up to about a minute of world item changes (it was about 30 s); on a world too big for one pass a save interval
# within the budget, up to two passes (logged; David4 18 Nov: about 5 us an item, so a pass fits an interval up to about 100,000 items). Any field the hash does not round is in it,
# so the check errs toward writing too much, never too little.
const AREA_M := 128.0              # PROVISIONAL: the side of a world items area (one file in AREA_DIR)
const AREA_STEP_S := 600.0        # PROVISIONAL: a periodic save compares countdowns (an item's lifetime, a fire's burn) in steps this long, so an area
                                   # where only a fire burns or a drop ages is written about every 10 minutes, not every save; a clean shutdown writes exactly
const AREA_DIR := "world_items"    # the area files, "<ax>_<az>.json": {"version", "gen": the save that wrote it, "items": rows, "world_rows": indices, "by_rows": row index -> who dropped it}
var _area_sums: Dictionary = {}    # area key -> the gen of its file as last written: touched by the writer only (the job carries it)
var _save_gen: int = 0             # the save count, kept in the header: an area file's gen says which save wrote it
# A save is one set of files (coordinator 23 Nov 2026, the live save): save() writes inventories, chests, vitals, characters, craft queues,
# crops, smelters, smithies, trees, lights and kilns, then the areas and last the world_items.json header, one file at a time, so a hard stop
# between two left some files from the new save and the rest from the one before (Stone put into a chest was then in neither; taken out, in
# both: test_save_set). Each of those files now carries "gen", the gen of the header its save writes last; at load a file whose gen is past
# the header's is from a save that never finished and is read from its .prev, the save before. A file with no gen (written outside save(),
# or by a build before this) is read as it is.
var _set_gen: int = 0              # while save() runs: the gen its files carry; 0 outside a save
# Files of other systems written in every save, in the same whole save as the packs (name -> Callable returning the file's Dictionary):
# terrain_server registers trade_state.json, so a hard stop never keeps a trader's shelf from one save and the pack that paid from another.
var set_extras: Dictionary = {}
# () -> int: how many ground edits (digs.dat records) the world holds now. Saved in the header as "digs", so a hard stop drops the digs
# and fills after the last whole save along with the pack changes they made (server_block_store.gd setup, ground_ops.gd open).
var ground_edits: Callable
var _digs_written: int = -1


func _digs_now() -> int:
	_digs_written = int(ground_edits.call()) if ground_edits.is_valid() else -1
	return _digs_written

var _set_lost_file: bool = false   # a file of the save running now (written on the tick, not the writer) could not be written
var _set_written: Array = []       # the files of the save running now written so far on the tick (rolled back when it loses one)
var _head_gen: int = -2            # the gen of the header on disk, read once at load (-1: no header, or one with no gen; -2: not read yet)
const SWEEP_BUDGET_US := 1000      # PROVISIONAL: the most a tick spends on the rolling check (2% of a 50 ms tick)
var _save_sig: Dictionary = {}     # world id -> [hash of its saved fields, its area key ("" = not saved in an area)] as the check last saw it
var _area_ids: Dictionary = {}     # area key -> {world id: true}: the items each area file holds
var _area_dirty: Dictionary = {}   # area key -> true: changed since the last periodic save
var _save_side: Dictionary = {}    # world id -> true: a trunk or stump, a light or a kiln (tree_states, lights, kilns.json are made from these)
var _walk_ids := PackedInt64Array()   # the pass under way walks the new ids (below), then these: the ids live at the last pass, and how far it is
var _walk_at: int = 0
var _walk_hi: int = 0             # first: the ids made since the last pass began, from _walk_lo (_walk_hi: how far) up to _walk_end
var _walk_lo: int = 0
var _sweep_passes: int = 0        # passes begun (tools: measure_save_cost)
var _walk_end: int = 0
var _walk_next := PackedInt64Array()  # the ids found live this pass: the next pass's list
var _sweep_began_ms: int = 0
var _load_changed: Dictionary = {}  # at load: world ids a load step changed in a way the area files must get (server_carts.gd after_load)
var _load_row_of: Dictionary = {}  # at load: world id -> its row's index in the loaded rows, and the area file each row came from
var _load_row_area: Array = []
var _save_failed: Array = []       # area keys the writer could not write (filled by the writer, read on the tick when it is done)
var _area_recovered: Dictionary = {}   # areas read from a .prev or a mismatched copy at load: written again at the first save
var _tilted: Dictionary = {}       # world ids of arrows stuck in a tree (_stick_arrow): saved as fallen to the ground under them
var _kind_info: Dictionary = {}    # structure kind -> [save state, use], for the writer (which must not read _structures)


func _kind_info_now() -> Dictionary:
	if _kind_info.size() != _structures.size():
		_kind_info = {}

		for kind in _structures:
			_kind_info[kind] = [int((_structures[kind] as Dictionary).get("state", 5)), str((_structures[kind] as Dictionary).get("use", ""))]

	return _kind_info


func _sapling_rows() -> Array:
	var plants: Array = []

	for sapling in _saplings:
		plants.append({"slot": sapling["slot"], "chunk": (sapling["chunk"] as Array).duplicate(), "species": sapling["species"], "pos": {"x": sapling["pos"].x, "y": sapling["pos"].y, "z": sapling["pos"].z}, "planted_at": sapling["planted_at"]})

	return plants


# Everything the item files need, copied now: the writer reads only this.
func _item_job() -> Dictionary:
	var tilt_y: Dictionary = {}

	for id in _tilted.keys():
		if not _items.has(id) or not _items[id].has("tilt"):
			_tilted.erase(id)
			continue

		var at: Vector3 = _items[id]["pos"]

		if ground_height.is_valid() and not is_nan(float(ground_height.call(at.x, at.z))):
			tilt_y[id] = float(ground_height.call(at.x, at.z))

	var t0: int = Time.get_ticks_usec()
	var exact: bool = not _async_writes

	if exact:
		_reindex_save()   # shutdown, reset, tests: every item looked at now, every area written

	for key in _area_ids.keys():
		if (_area_ids[key] as Dictionary).is_empty():
			_area_ids.erase(key)   # left empty: the header no longer names it and the writer takes its file away
		elif exact or not _area_sums.has(key):
			_area_dirty[key] = true   # (the writer is idle here: save() waited for it)

	var copy: Dictionary = {}
	var areas: Dictionary = {}

	for key in _area_dirty:
		if _area_ids.has(key):
			var ids: Array = []

			for id in _area_ids[key]:
				if _items.has(id):
					copy[id] = _save_copy(id)
					ids.append(id)

			areas[key] = ids

	for id in _save_side:
		if _items.has(id) and not copy.has(id):
			copy[id] = _save_copy(id)

	_area_dirty = {}
	_note_save_part("world item copy", t0)
	_save_gen += 1
	return {"dir": _dir, "items": copy, "areas": areas, "all": _area_ids.keys(), "kinds": _kind_info_now(), "tilt_y": tilt_y, "saplings": _sapling_rows(), "gen": _save_gen, "sums": _area_sums, "exact": exact, "failed_out": _save_failed, "kiln_lit_by": _kiln_lit_by.duplicate(),
		"world": {"version": VERSION, "next_id": _next_id, "taken": _taken.keys(), "picked": _picked.duplicate(true), "stripped": _stripped_now().duplicate(true), "fruit": _fruit_now().duplicate(true), "boulders": _boulder_left.duplicate(true), "boulder_per_kg": _boulder_per_kg(), "ore_per_kg": _boulder_per_kg(true), "boulders_then": _boulder_pending.duplicate(true), "bog_iron": _bog_left.duplicate(true), "bog_holes": _bog_holes.duplicate(true), "pockets": _pockets_saved(), "seams": _seams_saved(), "layout": FloraLayout.VERSION, "no_kits": true, "seed_pinch": true,
			"digs": _digs_now()}}


func _save_item_files(job: Dictionary) -> void:
	if _async_writes:
		_pending_writes.append(job)   # built and written by the background writer (_write_batch)
		return

	var t0: int = Time.get_ticks_usec()
	_finish_writer()

	if _set_lost_file:
		_skip_item_job(job, _set_written)
	else:
		_write_item_job(job, _set_written)

	_set_lost_file = false
	_set_written = []
	_note_save_part("world items", t0)


# Writes a job's files: tree_states, lights, kilns, the areas that changed, then the header, then takes away the files of areas left empty.
# Static and reads only the job (and its `sums`, which only the writer touches), so the writer thread can run it.
# A power cut (not a process kill: the files are then in the system's cache and still land) could lose what was written but not yet on the
# disk, in any order. Before a save's header and after it the store's file system is flushed to the disk (coreutils `sync -f`, syncfs: one
# call, with digs.dat and every set file), so the header never names files that are not on the disk. Linux servers only (the server image
# is Ubuntu); DYNASTY_SAVE_SYNC=0 turns it off for a comparison. sync_ms adds up the time it took (save timing, the long run).
static var sync_saves: bool = OS.get_environment("DYNASTY_SAVE_SYNC") != "0" and OS.get_name() == "Linux"   # coreutils' sync -f (BSD sync takes no file)
static var sync_ms: float = 0.0
static var syncs: int = 0


static func _sync_store(dir: String) -> void:
	if not sync_saves:
		return

	var t0: int = Time.get_ticks_usec()
	var code: int = OS.execute("sync", ["-f", ProjectSettings.globalize_path(dir)])

	if code != 0:
		push_error("server save: could not flush the store to the disk (sync -f exit %d): saves go on, but a power cut may lose the last one" % code)
		sync_saves = false   # said once; a process kill still loses nothing

	sync_ms += float(Time.get_ticks_usec() - t0) / 1000.0
	syncs += 1


static func _write_item_job(job: Dictionary, written: Array = []) -> void:
	var dir: String = str(job["dir"])
	var items: Dictionary = job["items"]
	var kinds: Dictionary = job["kinds"]
	var gen: int = int(job["gen"])
	var sums: Dictionary = job["sums"]
	var texts: Dictionary = {
		dir + "/tree_states.json": JSON.stringify({"version": TREE_SAVE_VERSION, "gen": gen, "trees": _tree_rows_of(items), "saplings": job["saplings"]}),
		dir + "/lights.json": JSON.stringify({"version": 1, "gen": gen, "lit": _light_rows_of(items, kinds)}),
		dir + "/kilns.json": JSON.stringify({"version": 1, "gen": gen, "kilns": _kiln_rows_of(items, kinds, job.get("kiln_lit_by", {}))})}
	var done: Array = written.duplicate()
	var whole: bool = true

	for path in texts:
		if _write_file(path, texts[path]):
			done.append(path)
		else:
			whole = false

	if not whole:
		_skip_item_job(job, done)
		return

	var areas: Dictionary = {}
	var listed: Dictionary = {}
	DirAccess.make_dir_recursive_absolute(dir + "/" + AREA_DIR)

	for key in job["areas"]:
		var rows: Array = [[], [], {}]

		for id in job["areas"][key]:
			if items.has(id):
				_world_item_row(items[id], id, kinds, job["tilt_y"], rows[0], rows[1], rows[2])

		if not (rows[0] as Array).is_empty():
			areas[key] = rows

	for key in job["all"]:
		if not job["areas"].has(key) and sums.has(key):
			listed[key] = int(sums[key])   # not dirty: its file stands as written

	for key in areas:
		var body: String = JSON.stringify({"items": areas[key][0], "world_rows": areas[key][1], "by_rows": areas[key][2]})
		var path: String = "%s/%s/%s.json" % [dir, AREA_DIR, key]

		if not _write_file(path, "{\"version\":%d,\"gen\":%d,%s" % [VERSION, gen, body.substr(1)]):
			_skip_item_job(job, done)   # an area that could not be written: no header, like any other file of the save (the areas built again next save)
			return

		done.append(path)
		sums[key] = gen
		listed[key] = gen

	var world: Dictionary = (job["world"] as Dictionary).duplicate()
	world["areas"] = listed
	world["gen"] = gen

	_sync_store(dir)   # every other file of the save (and digs.dat) on the disk before the header that names it: a power cut keeps one whole save

	if not _write_file(dir + "/world_items.json", JSON.stringify(world)):
		_skip_item_job(job, done)   # the header itself: the store stays the save before, and what this save wrote goes back
		return

	_sync_store(dir)   # and the header too, so a power cut loses no more than the save being written

	for key in sums.keys():
		if not listed.has(key):
			sums.erase(key)

	for file in DirAccess.get_files_at(dir + "/" + AREA_DIR):
		if file.ends_with(".json") and not listed.has(file.trim_suffix(".json")):
			DirAccess.remove_absolute(dir + "/" + AREA_DIR + "/" + file)   # an area left empty (its .prev goes too: the header no longer names it)
			DirAccess.remove_absolute(dir + "/" + AREA_DIR + "/" + file + ".prev")


# Every saved world item row of a store, for the tests and tools: the header's area files in order, or an older file's own rows.
static func saved_world_rows(dir: String) -> Array:
	var head: Variant = JSON.parse_string(FileAccess.get_file_as_string(dir + "/world_items.json")) if FileAccess.file_exists(dir + "/world_items.json") else null

	if typeof(head) != TYPE_DICTIONARY:
		return []

	if not head.has("areas"):
		return head.get("items", [])

	var rows: Array = []

	for key in head["areas"]:
		var area: Variant = JSON.parse_string(FileAccess.get_file_as_string("%s/%s/%s.json" % [dir, AREA_DIR, key]))

		if typeof(area) == TYPE_DICTIONARY:
			rows.append_array(area.get("items", []))

	return rows


static func area_key_of(x: float, z: float) -> String:
	return "%d_%d" % [int(floor(x / AREA_M)), int(floor(z / AREA_M))]


# A world item as the writer saves it: a set trap also carries what a restart keeps of its state (server_traps.saved_state: its run note,
# away clock and the catch it holds), worked out here on the main thread since the writer cannot read the other items.
func _save_copy(id: int) -> Dictionary:
	var out: Dictionary = _items[id].duplicate(true)

	if out.has("struct") and _traps != null and _traps.is_kind(str(out["struct"].get("kind", ""))):
		out["struct"]["state_json"] = _traps.saved_state(_items[id])
	elif out.has("struct") and out["struct"].has("rolled_s"):
		out["struct"]["state_json"] = JSON.stringify({"rolled_s": float(out["struct"]["rolled_s"])})   # a fish trap: up to when its hours are fished
	elif out.has("struct") and _kept_transient(out["struct"]):
		var st: Dictionary = out["struct"]
		var kept: Dictionary = {"species": str(st.get("species", "")), "blows": int(st.get("blows", 0)), "parts": st.get("parts", null), "snared": bool(st.get("snared", false)), "left": float(out.get("left", CARCASS_LIFE_S))}

		if st.has("look"):
			kept["look"] = int(st["look"])   # the animal's own look (make_carcass body): the same model after a restart
			kept["num"] = int(st.get("num", 0))

		out["struct"]["state_json"] = JSON.stringify(kept)

	return out


# Not saved in an area file: as _world_item_row skips (scatter, trunks and stumps, the showroom, the camp fire, a transient structure).
static func _not_in_area(it: Dictionary) -> bool:
	return it.has("scatter") or it.has("tree") or it.has("showroom") or (it.has("fire") and it["fire"].has("camp")) or (it.has("struct") and bool(it["struct"].get("transient", false)) and not _kept_transient(it["struct"]))


# A transient structure that is saved all the same: a carcass, whole or half cut (the coordinator, 23 Nov 2026: a kill or a catch was
# lost at every restart). Its species, blows, the parts still in it and its time left go in row 24 (_save_copy).
static func _kept_transient(st: Dictionary) -> bool:
	return str(st.get("kind", "")) == "carcass"


# The hash of what a world item's saved row holds, its countdowns in AREA_STEP_S steps. The live record is changed only for the native hash and put
# back at once, value for value, in place (its keys keep their order). Anything not named here is hashed as it is: a change there marks the area.
# Written out field by field, with no arrays made, since it runs for every item once a pass. The hash is 32 bits: a change that hashes the
# same as before (about one in four billion) waits for the next change in its area or the shutdown save, which writes every area exactly.
func _save_sig_of(it: Dictionary) -> int:
	var has_left: bool = it.has("left")
	var left: Variant = it.get("left")

	if has_left:
		it["left"] = floorf(float(left) / AREA_STEP_S)

	var fire: Dictionary = it.get("fire", {})
	var st: Dictionary = it.get("struct", {})
	var fire_kept: Dictionary = {}
	var st_kept: Dictionary = {}

	if not fire.is_empty():
		for field in FIRE_STEPPED:
			if fire.has(field):
				fire_kept[field] = fire[field]

				if field == "recheck" or field == "covered":
					fire[field] = 0   # not saved
				elif field == "char":
					fire[field] = snappedf(float(fire[field]), 0.25)
				elif field == "wood" or field == "burnt":
					if typeof(fire[field]) == TYPE_DICTIONARY:
						var steps: Array = []

						for wood in fire[field]:
							steps.append(floorf(float(fire[field][wood]) / AREA_STEP_S))

						fire[field] = steps
				else:
					fire[field] = floorf(float(fire[field]) / AREA_STEP_S)

	if not st.is_empty():
		for field in STRUCT_SIDE_FIELDS:
			if st.has(field):
				st_kept[field] = st[field]
				st[field] = 0

	var sig: int = it.hash()

	if has_left:
		it["left"] = left

	for field in fire_kept:
		fire[field] = fire_kept[field]

	for field in st_kept:
		st[field] = st_kept[field]

	return sig


const FIRE_STEPPED := ["burn_left", "lit_s", "wood", "burnt", "char", "recheck", "covered"]   # a fire's running fields (_save_sig_of)
const STRUCT_SIDE_FIELDS := ["fuel_left", "kiln", "char"]   # in lights.json and kilns.json, which every save writes (char: a lit light's part lump, lights.json row [4])
var _side_kind: Dictionary = {}   # structure kind -> true when it is a light or a kiln (tree_states, lights, kilns.json come from these)


func _is_side(it: Dictionary) -> bool:
	if it.has("tree"):
		return true

	if not it.has("struct"):
		return false

	if it["struct"].has("lit"):
		return true

	var kind: String = str(it["struct"]["kind"])

	if not _side_kind.has(kind):
		var def: Dictionary = _structures.get(kind, {})
		_side_kind[kind] = bool(def.get("lights", false)) or str(def.get("use", "")) == "kiln"

	return bool(_side_kind[kind])


func _save_note(id) -> void:
	var it: Dictionary = _items[id]
	var key: String = "" if _not_in_area(it) else area_key_of(float(it["pos"].x), float(it["pos"].z))

	if _is_side(it):
		if not _save_side.has(id):
			_save_side[id] = true
			_dirty = true   # a new trunk, stump, light or kiln: tree_states, lights or kilns.json change
	else:
		_save_side.erase(id)

	var old: Variant = _save_sig.get(id)

	if key == "" and old != null and str(old[1]) == "":
		return   # scatter, a trunk or stump: in no area file, and its coming into one shows as a new key

	var sig: int = 0 if key == "" else _save_sig_of(it)

	if old != null and int(old[0]) == sig and str(old[1]) == key:
		return

	if old != null and str(old[1]) != "":
		if _area_ids.has(old[1]):
			(_area_ids[old[1]] as Dictionary).erase(id)

		_area_dirty[old[1]] = true

	if key != "":
		if not _area_ids.has(key):
			_area_ids[key] = {}

		_area_ids[key][id] = true
		_area_dirty[key] = true

	_save_sig[id] = [sig, key]

	if key != "" or (old != null and str(old[1]) != ""):
		_dirty = true   # an area changed: the save writes it even when nothing else asked for a save


func _save_forget(id) -> void:
	var old: Variant = _save_sig.get(id)

	if old == null:
		return

	if str(old[1]) != "":
		if _area_ids.has(old[1]):
			(_area_ids[old[1]] as Dictionary).erase(id)

		_area_dirty[old[1]] = true
		_dirty = true

	_save_sig.erase(id)
	_save_side.erase(id)


# One tick's slice of the rolling check: from where the pass is up to, at most `count` ids and no longer than `budget_us`.
# A pass walks the ids made since the last pass began (_walk_lo to _walk_end; world ids all come from _next_id) and then the ids live at the last pass (_walk_ids;
# their new ids were walked once), building the next pass's list as it goes. So no list of every item is made on one tick (that cost a tick about 6 ms at
# 50,000 items), and the ids that came and went (scatter laid out and taken away as players walk) cost a pass only once, in the interval they
# were made: a pass costs about the live items plus the ids made in one interval, never every id ever given out.
func _save_sweep(count: int, budget_us: int = SWEEP_BUDGET_US) -> void:
	var t0: int = Time.get_ticks_usec()
	var n: int = 0

	while n < count:
		var id: int = 0

		if _walk_hi < _walk_end:   # the new ids first, so a new item is noticed early in the pass after it was made
			id = _walk_hi
			_walk_hi += 1
		elif _walk_at < _walk_ids.size():
			id = _walk_ids[_walk_at]
			_walk_at += 1
		else:
			var took_ms: int = Time.get_ticks_msec() - _sweep_began_ms

			if _sweep_began_ms > 0 and took_ms > int(SAVE_EVERY_S * 1000.0):
				_log_off_main("server items: the save check took %.1f s for %d items, longer than a save interval (changes reach the disk later)" % [float(took_ms) / 1000.0, _items.size()])

			_walk_ids = _walk_next
			_walk_next = PackedInt64Array()
			_walk_at = 0
			_walk_lo = _walk_hi
			_walk_end = _next_id
			_sweep_began_ms = Time.get_ticks_msec()
			_sweep_passes += 1

			if n > 0 or (_walk_ids.is_empty() and _walk_hi >= _walk_end):
				return   # the next pass starts on the next tick

			continue

		n += 1

		if _items.has(id):
			_save_note(id)
			_walk_next.append(id)
		elif _save_sig.has(id):
			_save_forget(id)

		if (n & 7) == 0 and Time.get_ticks_usec() - t0 >= budget_us:
			return


# How many ids the tick's slice takes, so a pass covers them all in about 0.8 of a save interval.
func _sweep_slice(delta: float) -> int:
	return maxi(64, ceili(float(_walk_ids.size() + _walk_end - _walk_lo) * delta / SAVE_EVERY_S * 1.25))


# The whole check at once (tests and tools; the tick spreads it with _save_sweep).
func save_check_now() -> void:
	for id in _items:
		_save_note(id)

	for id in _save_sig.keys():
		if not _items.has(id):
			_save_forget(id)

	_walk_ids = PackedInt64Array()   # a fresh pass over every live item
	_walk_next = PackedInt64Array(_items.keys())
	_walk_at = 0
	_walk_hi = _next_id
	_walk_lo = _next_id
	_walk_end = _next_id


# The save check's index, once, after every load step (one hash pass: two made the load 0.7 s longer at 50,000 items). The load steps change
# what the files hold only where it matters for the area files here: a crate whose cart is gone set down (_load_changed), an item a step made
# (an id from `loaded_next` on), a row filed in another area than where it lies, an area read from its .prev. Those areas are written at the first
# save; the rest of what the steps do they do again at every load (old layouts, beds, supports), or it lives in the side files every save writes
# (lights, kilns, trunks and stumps).
func _index_after_load(loaded_next: int) -> void:
	_reindex_save()
	_area_dirty = _area_recovered.duplicate()

	for id in _load_row_of:
		if _save_sig.has(id) and int(_load_row_of[id]) < _load_row_area.size() and str(_load_row_area[int(_load_row_of[id])]) != str(_save_sig[id][1]):
			_area_dirty[str(_load_row_area[int(_load_row_of[id])])] = true
			_area_dirty[str(_save_sig[id][1])] = true

	for id in range(loaded_next, _next_id):
		_load_changed[id] = true

	for id in _load_changed:
		if _save_sig.has(id) and str(_save_sig[id][1]) != "":
			_area_dirty[str(_save_sig[id][1])] = true

	_load_row_of = {}
	_load_row_area = []
	_load_changed = {}


# Every item looked at afresh: after a load, and before a save that writes every area.
func _reindex_save() -> void:
	_save_sig = {}
	_area_ids = {}
	_save_side = {}
	save_check_now()


# Appends a world item's row to `items` (and its index to `world_rows` when the server put it down, and who dropped a loose one to `by_rows`),
# or nothing for what is never saved.
static func _world_item_row(it: Dictionary, id, kinds: Dictionary, tilt_y: Dictionary, items: Array, world_rows: Array, by_rows: Dictionary) -> void:
	if it.has("scatter") or it.has("tree") or it.has("showroom") or (it.has("fire") and it["fire"].has("camp")):
		return   # the showroom is never saved: an admin fills it again after a restart; the camp fire is laid again at every start (_camp_fire_tick)

	if it.has("struct") and bool(it["struct"].get("transient", false)) and not _kept_transient(it["struct"]):
		return

	if it.has("struct"):
		items.append([int(it["number"]), 1, it["pos"].x, it["pos"].y, it["pos"].z, 1.0e9, int((kinds.get(str(it["struct"]["kind"]), [5, ""]) as Array)[0]), float(it["struct"]["yaw"]), int(it.get("wear", 0)), str(it["struct"]["kind"]), int(it["struct"].get("uid", 0)), str(it["struct"].get("owner", "")), float(it["struct"].get("born", it["struct"].get("seq", 0.0))), bool(it["struct"].get("cave", false)), int(it["struct"].get("coins", 0)), JSON.stringify(it["struct"]["site"]) if it["struct"].has("site") else "", 1 if bool(it["struct"].get("keep_out", false)) else 0, JSON.stringify(it["struct"]["lock"]) if it["struct"].has("lock") else "", int(it["struct"].get("on", 0)), int(it["struct"].get("spot", 0)), 1 if bool(it["struct"].get("road", false)) else 0, JSON.stringify({"pitch": snappedf(float(it["struct"]["pitch"]), 0.001), "len": snappedf(float(it["struct"]["len"]), 0.001), "paid": int(it["struct"].get("paid", 1))}) if it["struct"].has("len") else "", int(it["struct"].get("autoload", 0)), JSON.stringify(it["struct"]["kinds"]) if it["struct"].has("kinds") else ""])

		if it["struct"].has("state_json"):
			(items[items.size() - 1] as Array).append(str(it["struct"]["state_json"]))   # row 24: a set trap's state (server_traps.saved_state), a fish trap's fished hours or a carcass's (_save_copy)

		return

	var at: Vector3 = it["pos"]

	if tilt_y.has(id):
		at.y = float(tilt_y[id])   # an arrow stuck in a tree is saved as fallen to the foot of it (the tilt is not saved)

	var row: Array = [int(it["number"]), int(it["count"]), at.x, at.y, at.z, it["left"], int(it["fire"]["state"]) if it.has("fire") else 0, float(it["fire"]["burn_left"]) if it.has("fire") else 0.0, int(it.get("wear", 0))]

	if not it.has("fire") and it.has("rot_y"):
		row.append(float(it["rot_y"]))   # a loose item's turn (a split log along its trunk); fires use this slot for their store

		if it.has("girth") or it.has("pitch") or it.has("spin"):
			row.append(float(it.get("girth", 1.0)))   # a split log's thickness against the drawn log

		if it.has("pitch") or it.has("spin"):
			row.append(float(it.get("pitch", 0.0)))   # a log's pose as physics left it (lying_logs.gd): tilted on another log, rolled on its axis
			row.append(float(it.get("spin", 0.0)))

	if not it.has("fire") and it.has("inst"):
		row.append(it["inst"])   # the instance data, always the last value of a loose row (a Dictionary: rot_y and girth are floats)

	if it.has("fire"):
		var wood: Dictionary = _fire_wood_of(it["fire"])
		row.append(int(it["fire"].get("uid", 0)))   # a campfire's store (a number here; a structure's kind is a string); 0 = none
		row.append([float(wood["log"]), float(wood["firewood"]), float(wood["weak"])])   # burning seconds by wood class (fire tiers)
		var pc: Dictionary = it["fire"].get("pieces", {})
		row.append([int(pc.get("log", -1)), int(pc.get("firewood", -1)), int(pc.get("weak", -1))])   # pieces laid by class (-1 = not known: counted by time)
		row.append(1 if bool(it["fire"].get("synced", false)) else 0)   # the store holds the fire's wood (older saves: 0, converted at the first opening)
		var burnt: Dictionary = it["fire"].get("burnt", {})
		row.append([float(burnt.get("log", 0.0)), float(burnt.get("firewood", 0.0)), float(burnt.get("weak", 0.0))])   # burned seconds not yet taken out of the store
		var counted: Dictionary = it["fire"].get("counted", {})
		row.append([int(counted.get("log", -1)), int(counted.get("firewood", -1)), int(counted.get("weak", -1))] if it["fire"].has("counted") else [])   # store pieces the last count knew ([] = never counted)
		row.append(float(it["fire"].get("lit_s", 0.0)))   # seconds burned since it was last cold (a coal bed at coals.coal_bed_s)
		row.append(int(it["fire"].get("damp", 0)))   # the wettest wood in it, drying left in tenths of a game hour (cooking.json wet_wood)
		row.append(float(it["fire"].get("char", 0.0)))   # the part-made Charcoal of the wood burned (cooking.json charcoal_left); below 0, owed for wood taken back out
		row.append(1 if bool(it["fire"].get("kept", false)) else 0)   # [18]: cold ash already gave its charcoal one wait (older saves: absent)

	if it.has("world"):
		world_rows.append(items.size())   # put down by the server (a den pile, a gift, loot): the world reset keeps it

	if str(it.get("by", "")) != "":
		by_rows[str(items.size())] = str(it["by"])   # who dropped it (a goblin's gift, food for a stray or a dog): kept over a restart (23 Nov 2026)

	items.append(row)



# A fire's wood by class, as _fire_wood gives it, without adding it to the fire (the writer reads a copy).
static func _fire_wood_of(fire: Dictionary) -> Dictionary:
	if fire.has("wood"):
		return fire["wood"]

	var all: float = maxf(float(fire.get("burn_left", 0.0)), 0.0)
	return {"log": 0.0, "firewood": all if int(fire.get("state", 0)) == 1 else 0.0, "weak": 0.0 if int(fire.get("state", 0)) == 1 else all}


static func _tree_rows_of(items: Dictionary) -> Array:
	var rows: Array = []

	for id in items:
		if items[id].has("tree"):
			var it: Dictionary = items[id]
			rows.append({"pos": [it["pos"].x, it["pos"].y, it["pos"].z], "tree": it["tree"]})

	return rows


static func _light_rows_of(items: Dictionary, kinds: Dictionary) -> Array:
	var rows: Array = []

	for id in items:
		var it: Dictionary = items[id]

		if it.has("struct") and bool(it["struct"].get("lit", false)) and not str((kinds.get(str(it["struct"]["kind"]), [5, ""]) as Array)[1]) in ["kiln", "smelt"]:   # a Kiln is saved in kilns.json, a Smelter in smelters.json
			rows.append([it["pos"].x, it["pos"].y, it["pos"].z, float(it["struct"].get("fuel_left", 0.0)), float(it["struct"].get("char", 0.0))])   # [4]: the part-made Charcoal (older saves: 4 values)

	return rows


static func _kiln_rows_of(items: Dictionary, kinds: Dictionary, lit_by: Dictionary = {}) -> Dictionary:
	var rows: Dictionary = {}

	for id in items:
		var it: Dictionary = items[id]

		if it.has("struct") and it["struct"].has("uid") and str((kinds.get(str(it["struct"]["kind"]), [5, ""]) as Array)[1]) == "kiln" and (it["struct"].has("kiln") or bool(it["struct"].get("lit", false))):
			var k: Dictionary = it["struct"].get("kiln", {})
			rows[str(it["struct"]["uid"])] = [1 if bool(it["struct"].get("lit", false)) else 0, int(k.get("left", 0)), float(k.get("t", 0.0)), (str(lit_by.get(id, "")) if bool(it["struct"].get("lit", false)) else "")]   # [3]: the character who lit it (ADD-18; older saves: 3 values)

	return rows


# Picking from a plant or shrub by hand. The plant stays where it is and is picked bare for
# REGROW_GAME_S of game time. It gives what drops.json says (fibre, sticks) and one of its
# natural yields (berries, leaves, roots...) when that is in season (flora table).
# Returns false when it gives nothing, the player is not near it, or it is not ready.
# True while a plant picked bare under the old regrow rule is still on the list (server_items keeps it for 3 game days).
func was_picked(flora_key: String) -> bool:
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	return now_s - float(_picked.get(flora_key, -1.0e12)) < REGROW_GAME_S


func gather(peer: int, species_name: String, kind: String, flora_key: String, flora_id: int, plant_position: Vector3, plant_height: float = -1.0) -> bool:
	plant_stays = false
	if not _peer_pos.has(peer) or _peer_pos[peer].distance_to(plant_position) > Interact.server_reach_m():
		return false

	var now_ms: int = Time.get_ticks_msec()

	if swath_mult <= 0.0 and now_ms - int(_last_gather.get(peer, -100000)) < gather_pace_ms:
		return false   # a swing cuts its whole circle at once; the hand pace is for E

	_last_gather[peer] = now_ms
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	if now_s - float(_picked.get(flora_key, -1.0e12)) < REGROW_GAME_S:
		return false

	if (_drops.get("fruit_tree", {}) as Dictionary).has(species_name):
		return _gather_fruit_tree(peer, species_name, flora_key, plant_height, flora_id)

	var berry: Dictionary = GatherRules.harvest_row(_drops, species_name)      # berries and every other harvest plant: one path

	if not berry.is_empty():
		return _gather_berries(peer, species_name, flora_key, berry, plant_height)

	var rows: Array = _drops.get("by_species", {}).get(species_name, _drops.get("by_kind", {}).get(kind, []))
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(flora_id) ^ int(now_s / REGROW_GAME_S) ^ 0x5bd1e995
	var entry: Dictionary = _flora_by_name.get(species_name, {})

	var plant_season: String = _plant_season(flora_key) if season_now.is_valid() or season_at.is_valid() else ""

	if not entry.is_empty() and plant_season != "" and not GatherRules.in_season(entry, plant_season):
		return false   # out of season: nothing to pick (the client shows no prompt either); refused quietly, no item and no tool wear
	var natural: String = ""

	if not entry.is_empty() and not entry["yields"].is_empty():
		var seasons: Array = entry["season"]
		var season: String = plant_season if plant_season != "" else "all"

		if seasons.has("all") or seasons.has(season):
			var usable: Array = []
			var missing: String = ""
			var inv = inventory_of(peer)

			for candidate in entry["yields"]:
				var needed: String = _tool_for(str(candidate))

				if table.number_of(str(candidate)) == 0:
					continue

				if needed == "" or (inv != null and _has_tool(inv, needed)):
					usable.append(str(candidate))
				else:
					missing = needed

			if not usable.is_empty():
				natural = usable[rng.randi_range(0, usable.size() - 1)]   # luck-exempt: which yield a plant bears, none better or worse
				var used_class: String = _tool_for(natural)

				if used_class != "":
					_wear_tool(peer, inv, used_class, "gather")
			elif rows.is_empty() and missing != "":
				_say(peer, "You need a %s for that." % str(_drops.get("tool_rules", {}).get("tool_names", {}).get(missing, missing)))
				_reject(peer, 1)
				return false   # the plant is not picked at all: its seeds come with the roots or bark it is taken for, so it stays for when the tool is there (Dave 2026-10-20: roots need a shovel)

	var seed_rows: Array = _seed_rows(species_name, flora_key)

	if rows.is_empty() and natural == "" and seed_rows.is_empty():
		return false

	var more: float = skill_factor(peer, "gather_plant")
	practice(peer, "gather_plant")

	more *= maxf(swath_mult, 1.0)   # a sickle or scythe swing gives more by its tier (drops.json swath yield)

	for row in rows:
		give(peer, table.number_of(str(row[0])), maxi(1, int(round(float(roll_amount(peer, rng, int(row[1]), int(row[2]))) * more))))

	if natural != "":
		var span: Array = ((_drops.get("plant_yield", {}) as Dictionary).get("counts", {}) as Dictionary).get(natural, [1, 3])   # seeds and nuts by the dozen (drops.json plant_yield)
		give(peer, table.number_of(natural), maxi(1, int(round(float(roll_amount(peer, rng, int(span[0]), int(span[1]))) * more))))
		_goal_event(peer, "foraged_new", natural, true)   # ADD-24: a plant's own yield picked by hand (not the fixed sticks and fibre, not seeds)

	for row in seed_rows:
		give(peer, table.number_of(str(row[0])), roll_amount(peer, rng, int(row[1]), int(row[2])))

	_picked[flora_key] = now_s
	_dirty = true
	return true


# Wild seeds a plant gives in this season (drops.json seed_drops), [] when none.
func _seed_rows(species_name: String, flora_key: String = "") -> Array:
	var def: Dictionary = (_drops.get("seed_drops", {}) as Dictionary).get(species_name, {})

	if def.is_empty():
		return []

	var season: String = (_plant_season(flora_key) if flora_key != "" else _season()) if season_now.is_valid() or season_at.is_valid() else "all"   # starter-calendar: the fallback with no plant key
	if not (def.get("seasons", []) as Array).has(season):
		return []

	var rows: Array = def.get("rows", [])

	if bool(def.get("one_of", false)) and rows.size() > 1:   # one of the rows, fixed per plant by its key (tall grass: one grain a tuft, a patch a mix; coordinator for Dave 24 Nov 2026)
		return [rows[posmod(hash(flora_key if flora_key != "" else species_name), rows.size())]]

	return rows


# A berry bush (data/items/drops.json "berry_yield"): E gives that berry only, count scaled by the plant's size, in its season, once a season;
# the plant stays standing and bare until the season changes (Dave 2026-10-23). A full pack: give() drops the rest on the ground at the
# player, beside the plant, so everything is taken and the bush is stripped.
# How many pieces of fruit a tree holds when full: the species range, by the tree's height against the species reference (0.6 to 1.5 times) and a stable
# variance from its id, so no two trees match and the same tree always holds the same.
func fruit_max(species_name: String, flora_id: int, plant_height: float) -> int:
	var cfg: Dictionary = (_drops.get("fruit_tree", {}) as Dictionary).get(species_name, {})

	if cfg.is_empty():
		return 0

	return GatherRules.fruit_max(cfg, _flora_by_name.get(species_name, {}), flora_id, plant_height)


# Pieces taken from a tree this season (0 when none, or from an older season).
func fruit_taken(flora_key: String) -> int:
	var parts: PackedStringArray = flora_key.rsplit(",", true, 1)
	var stamp: int = _stamp_at(_chunk_middle(parts[0]))
	var record: Array = (_fruit.get(parts[0], {}) as Dictionary).get(int(parts[1]), [])
	return int(record[1]) if record.size() == 2 and int(record[0]) == stamp else 0


# The trees of a chunk ("cx,cz" home key) with fruit taken this season: [ids, taken] for a joining client.
func fruit_state(chunk_key: String) -> Array:
	var ids: PackedInt32Array = PackedInt32Array()
	var taken: PackedInt32Array = PackedInt32Array()
	var stamp: int = _stamp_at(_chunk_middle(chunk_key))

	for tree in (_fruit.get(chunk_key, {}) as Dictionary):
		var record: Array = _fruit[chunk_key][tree]

		if int(record[0]) == stamp:
			ids.append(int(tree))
			taken.append(int(record[1]))

	return [ids, taken]


# Pieces of fruit left on a tree this season (a new season starts it full again).
func fruit_left(species_name: String, flora_key: String, flora_id: int, plant_height: float) -> int:
	var parts: PackedStringArray = flora_key.rsplit(",", true, 1)
	var stamp: int = _stamp_at(_chunk_middle(parts[0]))
	var record: Array = (_fruit.get(parts[0], {}) as Dictionary).get(int(parts[1]), [])
	var taken: int = int(record[1]) if record.size() == 2 and int(record[0]) == stamp else 0
	return maxi(fruit_max(species_name, flora_id, plant_height) - taken, 0)


# One press on a fruit tree: up to per_pick pieces, as many as the weight limit lets the player carry, from the tree's real store (shared by all players, saved).
# Partial picks leave the rest on the tree; the last piece strips the tree (the existing bare-plant mark: no prompt, drawn bare) until the next season.
func _gather_fruit_tree(peer: int, species_name: String, flora_key: String, plant_height: float, flora_id: int) -> bool:
	var entry: Dictionary = _flora_by_name.get(species_name, {})
	var season: String = _plant_season(flora_key) if season_now.is_valid() or season_at.is_valid() else "all"

	if not GatherRules.in_season(entry, season):
		return false

	var parts: PackedStringArray = flora_key.rsplit(",", true, 1)
	var plant: int = int(parts[1])
	var stamp: int = _stamp_at(_chunk_middle(parts[0]))
	var left: int = fruit_left(species_name, flora_key, flora_id, plant_height)

	if left <= 0:
		return false

	var item_row: Dictionary = GatherRules.harvest_row(_drops, species_name)
	var number: int = table.number_of(str(item_row.get("item", "")))
	var inv = inventory_of(peer)

	if number == 0 or inv == null:
		return false

	var want: int = mini(int((_drops["fruit_tree"][species_name] as Dictionary).get("per_pick", 5)), left)
	var fits: int = _fit(peer, inv, number, want)

	if fits <= 0:
		_say(peer, "Too heavy to carry more")
		return false

	practice(peer, "gather_plant")
	var given: int = give(peer, number, fits)

	if given <= 0:
		return false

	_goal_event(peer, "foraged_new", str(item_row["item"]), true)   # ADD-24: fruit picked from a tree by hand

	if not _fruit.has(parts[0]):
		_fruit[parts[0]] = {}

	var record: Array = (_fruit[parts[0]] as Dictionary).get(plant, [])
	var taken: int = int(record[1]) if record.size() == 2 and int(record[0]) == stamp else 0
	_fruit[parts[0]][plant] = [stamp, taken + given]

	if left - given <= 0:
		if not _stripped.has(parts[0]):
			_stripped[parts[0]] = {}

		_stripped[parts[0]][plant] = stamp

	plant_stays = true   # the tree stays; its store is what shrinks
	_dirty = true
	return true


func _gather_berries(peer: int, species_name: String, flora_key: String, berry: Dictionary, plant_height: float) -> bool:
	var entry: Dictionary = _flora_by_name.get(species_name, {})
	var seasons: Array = entry.get("season", [])
	var season: String = _plant_season(flora_key) if season_now.is_valid() or season_at.is_valid() else "all"

	if not (seasons.is_empty() or seasons.has("all") or seasons.has(season)):
		_say(peer, "Not in season")
		return false

	var parts: PackedStringArray = flora_key.rsplit(",", true, 1)
	var plant: int = int(parts[1])
	var stamp: int = _stamp_at(_chunk_middle(parts[0]))

	if int((_stripped.get(parts[0], {}) as Dictionary).get(plant, -1)) == stamp:
		_say(peer, "Nothing left to pick this season")
		return false

	berry = GatherRules.harvest_row(_drops, species_name, season)   # a by-season row (wild rose) gives this season's product

	if berry.is_empty():
		_say(peer, "Not in season")
		return false

	var number: int = table.number_of(str(berry["item"]))

	if number == 0:
		return false

	var count: int = GatherRules.harvest_count(berry, GatherRules.harvest_scale(_drops, plant_height, entry))      # the one count rule (Dave: size scaled, 3x cap, rounded up, never 0)
	count = maxi(count, int(round(float(count) * swath_mult)))   # thatching grass cut by a sickle or scythe: more by its tier
	practice(peer, "gather_plant")
	give(peer, number, count)
	_goal_event(peer, "foraged_new", str(berry["item"]), true)   # ADD-24: a berry bush or other harvest plant stripped by hand

	var seed_rng: RandomNumberGenerator = RandomNumberGenerator.new()
	seed_rng.seed = hash(flora_key) ^ stamp ^ 0x2545f491

	for row in _seed_rows(species_name, flora_key):   # wild seeds beside the harvest (drops.json seed_drops, e.g. wild carrot)
		give(peer, table.number_of(str(row[0])), roll_amount(peer, seed_rng, int(row[1]), int(row[2])))

	if not _stripped.has(parts[0]):
		_stripped[parts[0]] = {}

	_stripped[parts[0]][plant] = stamp
	plant_stays = true
	_dirty = true
	return true


# The ids of a chunk's plants that are bare this season ("cx,cz" is the chunk's home key); for a joining client's chunk.
func stripped_ids(chunk_key: String) -> PackedInt32Array:
	var out: PackedInt32Array = PackedInt32Array()
	var stamp: int = _stamp_at(_chunk_middle(chunk_key))

	for plant in _stripped.get(chunk_key, {}):
		if int(_stripped[chunk_key][plant]) == stamp:
			out.append(int(plant))

	return out


# Fruit stores of this season only (an older stamp means the tree is full again).
func _fruit_now() -> Dictionary:
	for chunk_key in _fruit.keys():
		var trees: Dictionary = _fruit[chunk_key]
		var stamp: int = _stamp_at(_chunk_middle(chunk_key))

		for tree in trees.keys():
			if int((trees[tree] as Array)[0]) != stamp:
				trees.erase(tree)

		if trees.is_empty():
			_fruit.erase(chunk_key)

	return _fruit


# Only this season's bare plants are kept (and saved): an older stamp means the bush bears again.
func _stripped_now() -> Dictionary:
	for chunk_key in _stripped.keys():
		var ids: Dictionary = _stripped[chunk_key]
		var stamp: int = _stamp_at(_chunk_middle(chunk_key))

		for plant in ids.keys():
			if int(ids[plant]) != stamp:
				ids.erase(plant)

		if ids.is_empty():
			_stripped.erase(chunk_key)

	return _stripped


func _tool_for(item_id: String) -> String:
	return GatherRules.tool_for(item_id, _drops)


# The factor for an action's PACE (cooldowns and craft time): the skill factor times the Rested buff's action_speed_mult (comfort.json rested.tiers; 1.0 without the buff).
func _pace_factor(peer: int, action_name: String) -> float:
	return skill_factor(peer, action_name) * float(rested_tier(peer).get("action_speed_mult", 1.0)) / cold_pace(peer)


# What a skill does to an action (data/items/skills.json): 1.0 until the skill system exists. Never below 0.25 or above 4.
func skill_factor(peer: int, action_name: String) -> float:
	var def: Dictionary = _skills_cfg.get("actions", {}).get(action_name, {})

	if def.is_empty():
		return 1.0

	if skill_level.is_valid():
		return clampf(float(skill_level.call(peer, str(def.get("skill", "")))), 0.25, 4.0)

	var skill: String = str(def.get("skill", ""))
	return clampf(SkillWeb.factor(_skills_cfg, skill, working_level(peer, skill), attributes_of(peer)), 0.25, 4.0)


# --- Skills (job 87, data/items/skills.json) ---
# Practice comes only from successes the server verified, through practice(). Records live in the character record
# (characters.json "skills"), attributes beside luck and fitness; an old character simply has none and is neutral.

func attributes_of(peer: int) -> Dictionary:
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})
	return {"strength": float(Attributes.clamp_value(row.get("strength", Attributes.NEUTRAL))), "memory": float(Attributes.clamp_value(row.get("memory", Attributes.NEUTRAL))), "fitness": float(fitness_of(peer)),
		"dexterity": float(Attributes.clamp_value(row.get("dexterity", Attributes.NEUTRAL))), "perception": float(Attributes.clamp_value(row.get("perception", Attributes.NEUTRAL))), "charisma": float(Attributes.clamp_value(row.get("charisma", Attributes.NEUTRAL)))}


func set_attribute(peer: int, name: String, value: int) -> void:
	if _characters.has(_peer_key.get(peer, "")) and (_skills_cfg.get("traits", []) as Array).has(name):
		_characters[_peer_key[peer]][name] = Attributes.clamp_value(value)
		_dirty = true
		_sync_skills(peer, true)


func _skill_records(peer: int) -> Dictionary:
	var row: Dictionary = _characters.get(_peer_key.get(peer, ""), {})

	if row.is_empty():
		return {}

	if not row.has("skills"):
		row["skills"] = {}

	return row["skills"]


func working_level(peer: int, skill: String) -> float:
	var records: Dictionary = _skill_records(peer)
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for id in records:
		SkillRules.decay(_skills_cfg, records[id], now_s)

	return SkillWeb.working(_skills_cfg, skill, records)


# One verified success at `action` (a skills.json action): practice for its skill (80 percent) and the parent group (20 percent).
# Nothing for trivial work, a cooldown per skill, a soft cap per game day; returns the points the skill gained.
func practice(peer: int, action_name: String, difficulty: float = 1.0, own_cooldown: bool = false) -> float:
	var def: Dictionary = _skills_cfg.get("actions", {}).get(action_name, {})
	var records: Dictionary = _skill_records(peer)

	if def.is_empty() or not _characters.has(_peer_key.get(peer, "")):
		return 0.0

	var skill: String = SkillWeb.trainable(_skills_cfg, str(def.get("skill", "")), records)   # a locked skill's practice goes to its nearest unlocked parent

	if skill == "":
		return 0.0

	var system: Dictionary = _skills_cfg.get("system", {})
	var now: int = Time.get_ticks_msec()
	var last: Dictionary = _last_practice.get(peer, {})

	var gate: String = skill + ":" + action_name if own_cooldown else skill   # own_cooldown: the action keeps its own (a sign spotted beside a trail-following look)

	if float(now - int(last.get(gate, -100000))) < float(system.get("cooldown_s", 2.0)) * 1000.0:
		return 0.0

	last[gate] = now
	_last_practice[peer] = last
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	var base: float = difficulty * float(def.get("difficulty", 1.0))
	var d: float = base * skill_xp_mult(peer)   # Rested and food (s3.16), added once and capped

	if base >= float(system.get("trivial_below", 0.2)):
		d = maxf(d, float(system.get("trivial_below", 0.2)))   # a dessert penalty never turns real work into trivial work (no XP at all)

	var gained: float = SkillWeb.practice(_skills_cfg, skill, attributes_of(peer), records, d, now_s)

	if gained > 0.0:
		_dirty = true
		_sync_skills(peer, false)

	return gained


# Training level up (a trainer, a teacher or an admin calls this; the trainer action itself comes with the NPC step):
# returns "" on success or why not. teacher_peer < 0 trains without a teacher (admin and tests).
func train_skill(peer: int, skill: String, teacher_peer: int = -1) -> String:
	var records: Dictionary = _skill_records(peer)

	if records.is_empty() and not _characters.has(_peer_key.get(peer, "")):
		return "no such character"

	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	var teacher_value: float = -1.0
	var teacher_level: int = 99

	if teacher_peer >= 0:
		if teacher_peer == peer or _peer_key.get(teacher_peer, "") == _peer_key.get(peer, "x"):
			return "you cannot teach yourself"

		var theirs: Dictionary = _skill_records(teacher_peer)
		teacher_value = SkillWeb.effective(_skills_cfg, skill, theirs)
		teacher_level = int(theirs.get(skill, {}).get("t", 0))

	var problem: String = SkillWeb.train(_skills_cfg, skill, records, now_s, teacher_value, teacher_level)

	if problem == "":
		_dirty = true
		_sync_skills(peer, true)

	return problem


# A trainer NPC (authored dialogue only): trains `skill` one level for `cost` (an item id and count, or empty), as a teacher who
# can teach up to level `max_level`. Returns "" on success or why not; nothing is taken when it fails.
func npc_train(peer: int, skill: String, max_level: int, cost_id: String = "", cost_n: int = 0, dry: bool = false) -> String:
	var records: Dictionary = _skill_records(peer)

	if records.is_empty() and not _characters.has(_peer_key.get(peer, "")):
		return "no such character"

	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	var problem: String = SkillWeb.train_problem(_skills_cfg, skill, records, now_s, 100.0, max_level)

	if problem == "" and cost_id != "" and count_for(peer, cost_id, true) < cost_n:
		problem = "not enough to pay"

	if problem != "" or dry:
		return problem

	if cost_id != "":
		take_from(peer, cost_id, cost_n, true)

	return train_skill(peer, skill, -1)


# Admin (tests and the look rig's --shot-skill): sets the skill at place `index` in skills.json "skills" to `value` (its practice units).
func admin_set_skill(peer: int, index: int, value: int) -> void:
	var names: Array = (_skills_cfg.get("skills", {}) as Dictionary).keys()
	var records: Dictionary = _skill_records(peer)

	if index < 0 or index >= names.size() or not _characters.has(_peer_key.get(peer, "")):
		return

	var skill: String = str(names[index])
	var record: Dictionary = records.get(skill, {})
	record["p"] = SkillWeb.units_for(_skills_cfg, skill, clampf(float(value), 1.0, float(SkillWeb.cap_of(_skills_cfg, skill, records))))
	record["peak"] = maxf(float(record.get("peak", 0.0)), float(record["p"]))
	records[skill] = record
	_dirty = true
	_sync_skills(peer, true)


func _sync_skills(peer: int, force: bool) -> void:
	if not send_skills.is_valid() or not _characters.has(_peer_key.get(peer, "")):
		return

	var now: int = Time.get_ticks_msec()

	if not force and now < int(_skills_send_in.get(peer, 0)):
		return

	var records: Dictionary = _skill_records(peer)
	var attrs: Dictionary = attributes_of(peer)
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	var rows: Array = []
	var index: int = 0

	for id in _skills_cfg.get("skills", {}):
		var eff: float = SkillWeb.effective(_skills_cfg, str(id), records)

		if records.has(id) or eff > 1.0:
			if records.has(id):
				SkillRules.decay(_skills_cfg, records[id], now_s)

			var rec: Dictionary = records.get(id, {})
			var today: int = 1 if int(rec.get("day", -1)) == int(now_s / 86400.0) and float(rec.get("dgain", 0.0)) > 0.0 else 0
			var raw: float = SkillWeb.raw_value(_skills_cfg, str(id), rec)
			var day_left: float = 1.0 - (float(rec.get("dgain", 0.0)) / maxf(float(_skills_cfg.get("system", {}).get("day_cap_units", 300.0)), 1.0) if today == 1 else 0.0)
			# [index, working level, rusty, cap, own training level, practised today, effective value, percent of the way to the next level, percent of today's gain left]
			rows.append([index, int(round(SkillWeb.working(_skills_cfg, str(id), records))), 1 if rec.has("p") and SkillRules.rusty(_skills_cfg, rec) else 0, SkillWeb.cap_of(_skills_cfg, str(id), records), int(rec.get("t", 0)), today, int(floor(eff)), int((raw - floorf(raw)) * 100.0), clampi(int(round(day_left * 100.0)), 0, 100)])

		index += 1

	var sent_key: Array = [int(attrs["strength"]), int(attrs["memory"]), rows]

	if not force and _skills_sent.get(peer, []) == sent_key:
		return

	_skills_sent[peer] = sent_key
	_skills_send_in[peer] = now + int(float(_skills_cfg.get("system", {}).get("send_every_s", 5.0)) * 1000.0)
	send_skills.call(peer, PackedInt32Array([int(attrs["strength"]), int(attrs["memory"])]), rows)


func _reject(peer: int, reason: int) -> void:
	if send_reject.is_valid():
		send_reject.call(peer, reason)


# A refusal with words the player can act on (hands-on screens check, 23 Nov 2026: these were the refusal sound alone). The words come at
# most once every HANDS_FULL_SAY_GAP_MS a player, since a held swing or a held E asks many times a second; the sound comes every time.
var _refusal_said: Dictionary = {}   # peer -> {words: msec last said}


func _reject_said(peer: int, reason: int, words: String) -> void:
	var now: int = Time.get_ticks_msec()
	var said: Dictionary = _refusal_said.get(peer, {})

	if swath_mult <= 0.0 and now - int(said.get(words, -HANDS_FULL_SAY_GAP_MS)) >= HANDS_FULL_SAY_GAP_MS:   # a swath swing says nothing (_say), so it starts no gap
		said[words] = now
		_refusal_said[peer] = said
		_say(peer, words)

	_reject(peer, reason)


func _reject_far(peer: int) -> void:
	_reject_said(peer, 0, "Too far away: step closer.")


func _reject_tool(peer: int, tool: String) -> void:
	_reject_said(peer, 1, "That needs %s in your hand." % tool)


func _say(peer: int, text: String) -> void:
	if swath_mult > 0.0:
		return   # a sickle or scythe swing cuts many plants at once: what one of them refuses is not told (swath_swing says when nothing was cut)

	if send_notice.is_valid():
		send_notice.call(peer, text)


# How many stumps are on record (the persistence drills count them).
func tree_row_count() -> int:
	var n: int = 0

	for id in _items:
		if _items[id].has("tree"):
			n += 1

	return n


# drop_in_world for what the server itself puts down (a goblin den pile or gift, a thief's dropped loot): the new piles are marked "world"
# (saved as world_items.json "world_rows") so the world reset keeps them as world content. Server and player piles never merge (drop_in_world).
# Piles saved before 13 Nov 2026 carry no mark and count as player-made (the first reset takes them once).
var _laying_world: bool = false


func drop_world_made(number: int, count: int, position: Vector3, lifetime_s: float = 0.0, by: String = "") -> bool:
	var first_new: int = _next_id
	_laying_world = true
	var laid: bool = drop_in_world(number, count, position, 0, lifetime_s, NAN, NAN, by)
	_laying_world = false

	for id in range(first_new, _next_id):
		if _items.has(id):
			_items[id]["world"] = true

	return laid


# Admin "Reset world" (BLOCKER-001, Dave 12 Nov 2026; docs/ai-team/missions/B001/BRIEF.md): the world as it was before anyone played in it (Dave
# 12 Nov 20:09), across the whole world, not only the loaded part (every row is in _items). Gone: every loose item a player made or let go
# (drops, stuck arrows, split logs), every placed structure with its contents (buildings, stations, containers, blueprint sites, tilled beds
# and their crops, path patches, traps, carts and crates) and every campfire. Restored: felled trees stand again (trunks and stumps go, the
# flora removals are cleared, saplings go), picked-up scatter, mined boulders and bog iron, picked plants and fruit, shore finds, nests, fish
# and ore patches. Kept: what the server put down ("world": den piles, goblin gifts, loot), the showroom (not saved) and carcasses (saved, they rot by themselves), and
# every character's pack, worn gear, vitals, skills and progression - remains too: they hold a dead character's pack and purse (they expire by
# themselves). The ground is the server scene's part (reset_terrain_edits, after this). Written to disk before it returns, so a hard stop
# cannot bring anything back. Returns how many player-made rows went.
func reset_world() -> int:
	for peer in _carts.puller_of.keys():
		_carts.release(int(peer), "")   # the client is told it holds no handle

	_carts.pulls.clear()
	var gone: int = 0

	for id in _items.keys():
		var it: Dictionary = _items[id]

		if it.has("world") or it.has("showroom") or (it.has("struct") and (bool(it["struct"].get("transient", false)) or str(it["struct"]["kind"]) == "remains")):
			continue

		if it.has("scatter") or it.has("tree"):
			_items.erase(id)   # scatter is laid out again round the players from the seed (_cells_done below); a trunk or stump goes, its tree stands again
			continue

		if it.has("struct"):
			if it["struct"].has("roof") and roof_remove.is_valid():
				roof_remove.call(int(it["struct"]["roof"]))

			_chests.erase(int(it["struct"].get("uid", 0)))
		elif it.has("fire"):
			_chests.erase(int(it["fire"].get("uid", 0)))   # a campfire's store

		_items.erase(id)
		gone += 1

	_grid = StructureGridScript.new()
	_spawn_zones.clear()

	for id in _items:
		if _items[id].has("struct"):
			_grid_add(id, _items[id])
		else:
			_zone_add(id)

	_taken.clear()
	_cells_done.clear()
	_scatter_cells.clear()
	_boulder_left.clear()
	_boulder_pending.clear()
	_bog_left.clear()
	_bog_holes.clear()
	_pockets_open.clear()
	_seam_left.clear()
	_seam_y.clear()
	_picked.clear()
	_stripped.clear()
	_fruit.clear()
	_shore_taken.clear()
	_nest_taken.clear()
	_branch_taken.clear()
	_nest_at.clear()
	_tell_taken_cleared()   # the clients forget what was taken too
	_fish_stock.clear()
	_mined.clear()
	_chops.clear()
	_falls.clear()
	_kiln_lit_by.clear()
	_saplings.clear()

	if restore_flora.is_valid():
		restore_flora.call()   # every felled tree and cleared plant stands again (server_flora.restore_all)

	_crops.clear()
	_plot_water.clear()
	_water_rebuild({})
	_rebuild_supports(true)
	_refresh_pots()
	_lit_valid = false
	_bed_cache.clear()
	_sync_grid = {}
	_still_valid = false   # every record filed again at the next full sync
	_wide_piles.clear()
	_wide_piles_built = false

	for peer in _chest_viewer.keys():
		if int(_chest_viewer[peer]) >= 0:
			_chest_viewer.erase(peer)   # a worn bag (negative) stays open

	for peer in _peer_key:
		_sync_remains(int(peer), true)

	_dirty = true
	_finish_writer()
	_pending_writes = []   # this save writes every file: nothing older may land after it
	var was_async: bool = _async_writes
	_async_writes = false
	save()
	_async_writes = was_async
	return gone


# Removes the loose dropped things (not trunks, stumps, fires, structures, boulders or the natural scatter) within `radius` of `centre`;
# the next sync tells the players they are gone (an admin clean-up; drops are never refused, Dave 16 Nov 2026).
func clear_dropped(centre: Vector3, radius: float) -> int:
	var gone: int = 0

	for id in _items.keys():
		var other: Dictionary = _items[id]

		if other.has("scatter") or other.has("showroom") or other.has("struct") or other.has("fire") or other.has("tree") or other.has("boulder"):
			continue

		if Vector2(other["pos"].x - centre.x, other["pos"].z - centre.z).length() <= radius:
			_items.erase(id)
			gone += 1

	if gone > 0:
		_dirty = true

	return gone


# A spot let go in the air comes down to the ground below it (up to 24 m); where nothing is known it stays.
func _settled(position: Vector3) -> Vector3:
	if not floor_below.is_valid():
		return position

	var rest: float = float(floor_below.call(position))
	return Vector3(position.x, rest, position.z) if not is_nan(rest) and rest < position.y - 0.05 else position


# A loose stack let go at `position` comes down onto what is under it: the ground (_settled), a building floor or a boulder, whichever is higher (physical world
# audit 23 Nov 2026: a stack dropped on a foundation came down to the ground under it, 0.3 m inside the slab where nobody saw it, and one dropped
# upstairs fell through the ceiling to the ground floor). Only lowers it, as _settled. `near`: the ids to look through (_ids_near round it), else looked up.
func _settled_loose(position: Vector3, near: Array = []) -> Vector3:
	var rest: Vector3 = _settled(position)
	var top: float = _floor_top_below(position, near)
	return Vector3(position.x, top, position.z) if not is_nan(top) and top > rest.y and top < position.y + 0.05 else rest


const FLOOR_ROWS_REACH_M := 3.0   # a foundation's or floor's middle is at most this far from a point over it (4 m footprints: half the diagonal 2.83 m; boulders 3 m at most: rock_fields cores and lone giants, test_rock_fields checks)
const BOULDER_TOP_SHARE := 0.7   # a boulder's drawn top over its spot, as a share of its radius (world_audit --walk measured the hull)


# The highest building floor top (a foundation's, or a floor piece's: the storey above's floor) or boulder top over `at` at most 5 cm above it, NAN
# where none: only the records near it (`near`, else _ids_near), never a walk of every record. A stack dropped standing on a boulder lay inside the
# rock. A blueprint site holds nothing up (as everywhere else): a stack there lies on the ground. `rocks` false: building floors only.
func _floor_top_below(at: Vector3, near: Array = [], rocks: bool = true) -> float:
	var best: float = NAN

	for id in (near if not near.is_empty() else _ids_near(at, FLOOR_ROWS_REACH_M)):
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]

		if it.has("boulder") and not rocks:
			continue

		if it.has("boulder"):   # a boulder's drawn top (inventory_view _size_boulder: its hull rises BOULDER_TOP_SHARE x its radius over its spot), rounded off to its edge
			# shortcut: a crag (rock_fields, "tilt") is taken upright here though the client leans it with its steep face; a stack dropped on one may rest a little off its drawn top
			var r: float = BoulderWear.radius_now(float(it["boulder"].get("radius", 0.0)), int(it["count"]), int(it["boulder"].get("total", it["count"])))
			var d: float = Vector2(at.x - it["pos"].x, at.z - it["pos"].z).length()

			if r > 0.0 and d < r:
				var rock: float = float(it["pos"].y) + BOULDER_TOP_SHARE * r * sqrt(1.0 - (d / r) * (d / r))

				if rock <= at.y + 0.05 and (is_nan(best) or rock > best):
					best = rock

			continue

		if not it.has("struct") or it["struct"].has("site"):
			continue

		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

		if not (bool(def.get("foundation", false)) or str(def.get("piece_kind", "")) == "floor"):
			continue

		if not PlacementRules.holds(def, {"pos": it["pos"], "yaw": float(it["struct"].get("yaw", 0.0))}, at):
			continue

		var y: float = float(it["pos"].y) + PlacementRules.anchor_top(def)

		if y <= at.y + 0.05 and (is_nan(best) or y > best):
			best = y

	return best


# The height a dropped stack lands at, from the server's own ground (main gate 21 Nov 2026: the client sends the ground it has under the player,
# or the feet less 1 m when it has none yet; with a coarse or missing client ground a drop landed under the surface, and _settled only lowers
# an item, so it stayed buried). The search starts DROP_LOOK_ABOVE_M over the higher of the player's reported feet and the sent height (that
# height capped DROP_REACH_M over the feet), so a drop up a slope or onto a dug floor finds the right ground; with no ground found the sent
# height stays.
const DROP_LOOK_ABOVE_M := 1.0


func _drop_height(spot: Vector3, feet: Vector3) -> float:
	if not floor_below.is_valid():
		return spot.y

	var start: float = maxf(feet.y, minf(spot.y, feet.y + DROP_REACH_M)) + DROP_LOOK_ABOVE_M
	var rest: float = float(floor_below.call(Vector3(spot.x, start, spot.z)))
	var top: float = _floor_top_below(Vector3(spot.x, start, spot.z))   # a building floor over the ground: the stack lies on it

	if not is_nan(top) and (is_nan(rest) or top > rest):
		rest = top

	return spot.y if is_nan(rest) else rest


# After a dig or fill: loose items near it come down (or stay) onto what the ground is now (boulders first, so a stack on one follows it down).
func settle_loose_near(centre: Vector3, radius: float, fill: bool = false) -> void:
	var loose: Array = []

	for id in _ids_near(centre, radius + 1.5 + FLOOR_ROWS_REACH_M):   # the records round the edit (a boulder's own radius is at most 3 m), never a walk of every record
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]

		if it.has("boulder") and (int(it["scatter"]) & CAVE_KEY) == 0:
			var info: Dictionary = it["boulder"]
			var size_now: float = BoulderWear.radius_now(float(info["radius"]), int(it["count"]), int(info["total"]))

			# A boulder dug under comes down into the hole (Dave 19 Nov 2026, boulders PLAN.md stage 1: boulders floated when dug under):
			# it rests on what is left under its middle, like a loose item. Nothing is saved: laid out again it is settled on the saved digs the same way.
			if Vector2(it["pos"].x - centre.x, it["pos"].z - centre.z).length() <= radius + size_now + 0.5:
				var rest: Vector3 = _settled(it["pos"])

				if rest != it["pos"]:
					var from: Vector3 = it["pos"]
					it["pos"] = rest
					_refile(id)
					_dirty = true

					if (info.get("skirt", []) as Array).size() >= 3:
						info["skirt"][2] = snappedf(float(info["skirt"][2]) + from.y - rest.y, 0.01)   # its talus stays on the ground where it lay

					_boulder_fell(from, rest, size_now)

			continue

		if it.has("struct") and _follows_ground(str(it["struct"].get("kind", ""))) and not it["struct"].has("site"):
			pass   # remains, a carcass, a snare and the hoe's patches lie on the ground like a stack: they follow it down into a dig and up onto a fill
		elif it.has("scatter") or it.has("struct") or it.has("fire") or it.has("tree") or it.has("boulder"):
			continue

		if it["pos"].distance_to(centre) <= radius + 1.5:
			loose.append(id)

	_settle_saplings(centre, radius, fill)

	if loose.is_empty():
		return

	var near: Array = _ids_near(centre, radius + 1.5 + FLOOR_ROWS_REACH_M)   # the floors and boulders round the dig, looked up once

	for id in loose:
		_items[id]["pos"] = _edit_rest(_items[id]["pos"], centre, radius, near, fill)
		_refile(id)
		_wake_log(id)   # a log on ground that was dug or filled under it may roll
		_dirty = true


# A boulder dug under came down from `from` to `to` (boulders step 2, BoulderFall): whoever and whatever it lands on is crushed, dead, even
# with nothing else killing (Dave 27 Nov 2026, R-RES-BOULDER-HARM, his own exception to R-CORE-NO-DEATH); its side striking someone as it
# comes down leaves them at BoulderFall.GLANCE_HP, and from a big drop knocks them out (the strain faint, as a long fall). Only the players
# and the animals round it are looked at.
func _boulder_fell(from: Vector3, to: Vector3, r: float) -> void:
	var drop: float = from.y - to.y

	if drop < BoulderFall.HARM_DROP_M:
		return

	for peer in _peer_pos.keys():
		var what: int = BoulderFall.hit(r, from, to, BOULDER_TOP_SHARE, _peer_pos[peer])

		if what == BoulderFall.CRUSHED and kill(peer, "crushed by a boulder"):
			continue

		var v: Dictionary = vitals_of(peer)

		if what == BoulderFall.NONE or v.is_empty() or _parked.has(peer):
			continue

		v["health"] = minf(float(v["health"]), 1.0 if what == BoulderFall.CRUSHED else BoulderFall.GLANCE_HP)   # crushed with death off: as near as it gets
		_say(peer, "The boulder came down on you." if what == BoulderFall.CRUSHED else "The falling boulder struck you a glancing blow.")

		if (what == BoulderFall.CRUSHED or drop >= BoulderFall.GLANCE_FAINT_M) and not _exertion_cfg.is_empty():
			_strain[peer] = {"s": float(_exertion_cfg.get("faint_at", 1.4)) + 0.05, "state": 1, "t": 0.0, "black": 1.0, "going": true}   # out on the next tick; they wake and can get help

		if not _forced_sleep(peer):
			_asleep.erase(peer)

		_sync_vitals(peer, true)

	if not animals_near.is_valid() or not crush_animal.is_valid():
		return

	for row in animals_near.call(to, r + BoulderFall.GLANCE_M + 1.0):
		var what: int = BoulderFall.hit(r, from, to, BOULDER_TOP_SHARE, row["pos"])

		if what != BoulderFall.NONE:
			crush_animal.call(int(row["id"]), 1.0 if what == BoulderFall.CRUSHED else BoulderFall.GLANCE_ANIMAL_SHARE)


# Round 7 (physical world audit, 23 Nov 2026: what players change in the ground): a fill left every stack, chest and fire under it buried and a dig
# left every fire, chest, station, torch and young plant over it in the air.
const EDIT_SETTLES := ["remains", "carcass", "snare_trap"]   # placed things that lie on the ground and follow it (the walkover ones too)
const EDIT_UNDER_M := 0.2   # a dig may not take the ground this close under a placed thing's foot
const EDIT_LIFT_M := 0.3   # how far over a fill's top the ground under a buried stack is looked for
const HOE_EDGE_SLOPE := 0.6   # the hoe leaves ground falling or rising from a placed thing's footprint no steeper than this (m per m; Steering.MAX_SLOPE 0.9)
const HOE_EDGE_FACE_M := 1.5   # ...and within this of the footprint a cut's or fill's face is no steeper than 1.5 times that
const EDIT_ON_BASE_M := 0.15   # a thing whose foot is this far over the ground at its middle stands on a foundation or floor (the hoe's strokes)


# A placed kind that lies on the ground and follows it into a dig and onto a fill.
func _follows_ground(kind: String) -> bool:
	return EDIT_SETTLES.has(kind) or bool(_structures.get(kind, {}).get("walkover", false))


# Where a stack (or remains, a patch) at `at` rests once the ground round an edit at `centre` changed: down onto what is under it (_settled_loose), or,
# `fill` and buried inside the fill's sphere, up onto its top over it (looked for from just above the sphere: a stack on a tunnel floor under the
# edit is outside it and stays).
func _edit_rest(at: Vector3, centre: Vector3, radius: float, near: Array, fill: bool) -> Vector3:
	var flat_sq: float = (at.x - centre.x) * (at.x - centre.x) + (at.z - centre.z) * (at.z - centre.z)

	if fill and floor_below.is_valid() and flat_sq < radius * radius and at.y > centre.y - sqrt(radius * radius - flat_sq) - 0.1:
		var over: Vector3 = Vector3(at.x, centre.y + sqrt(radius * radius - flat_sq) + EDIT_LIFT_M, at.z)

		if over.y > at.y:
			var top: Vector3 = _settled_loose(over, near)

			if top.y > at.y + 0.05 and top.y < over.y - 0.01:
				return top   # it was under the ground: up onto it

	return _settled_loose(at, near)


# Young plants and planted bushes (_saplings) round an edit come to rest on the ground as it is now, as a stack does.
func _settle_saplings(centre: Vector3, radius: float, fill: bool) -> void:
	var home: Vector2i = Vector2i(int(floor(centre.x / FLORA_CHUNK_M)), int(floor(centre.z / FLORA_CHUNK_M)))

	for sapling in _saplings:
		if absi(int(sapling["chunk"][0]) - home.x) > 1 or absi(int(sapling["chunk"][1]) - home.y) > 1:
			continue   # the chunks round the edit only (the cheap test first)

		var p: Vector3 = sapling["pos"]

		if Vector2(p.x - centre.x, p.z - centre.z).length() > radius + 0.5:
			continue

		var rest: Vector3 = _edit_rest(p, centre, radius, [], fill)

		if absf(rest.y - p.y) > 0.02:
			sapling["pos"] = Vector3(p.x, rest.y, p.z)
			_dirty = true

			if flora_changed.is_valid():
				flora_changed.call(Vector2i(int(sapling["chunk"][0]), int(sapling["chunk"][1])))


# The name of a placed thing a dig at `centre` would take the ground from under (`fill` false: the sphere reaches within EDIT_UNDER_M under its
# foot, inside its footprint) or a fill would bury (`fill` true: the sphere rises over its foot there), "" when none. Fires, stations, chests,
# torches, buildings and every other placed piece count; stacks, remains, patches and hung things (attach_to) do not: they follow the ground or a wall.
# `buildings` false (the hoe's strokes): foundations, and things standing on one or on a floor, do not count; a wall, fence or trough on the
# ground still does.
func _edit_blocker(centre: Vector3, radius: float, fill: bool, buildings: bool = true) -> String:
	for id in _ids_near(centre, radius + FLOOR_ROWS_REACH_M + 1.0):
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]
		var def: Dictionary = {}
		var yaw: float = 0.0
		var name: String = "The campfire"

		if it.has("fire"):
			def = {"footprint_x": 1.2, "footprint_z": 1.2, "height_m": 0.6}
		elif it.has("struct"):
			var kind: String = str(it["struct"].get("kind", ""))
			def = _structures.get(kind, {})

			if def.is_empty() or _follows_ground(kind) or def.has("attach_to") or it["struct"].has("site"):
				continue   # a blueprint site holds nothing up and is not buried (as everywhere else)

			if not buildings and bool(def.get("foundation", false)):
				continue   # the hoe levels round foundations on purpose (LEVEL_BELOW_PIECE_M)

			yaw = float(it["struct"].get("yaw", 0.0))
			name = "The " + (table.sentence_name(int(it["number"])) if int(it["number"]) > 0 else kind.replace("_", " "))
		else:
			continue

		var box: Array = PlacementRules._box(def, it["pos"], yaw)
		var dy: float = float(box[3]) + (0.05 if fill else -EDIT_UNDER_M) - centre.y

		if absf(dy) >= radius:
			continue

		var apart: Vector2 = Vector2(centre.x, centre.z) - (box[0] as Vector2)
		var half: Vector2 = box[1]
		var ax: Vector2 = PlacementRules._side(box, 0)
		var az: Vector2 = PlacementRules._side(box, 1)
		var off: Vector2 = Vector2(maxf(absf(apart.dot(ax)) - half.x, 0.0), maxf(absf(apart.dot(az)) - half.y, 0.0))

		if buildings:
			if off.length() < sqrt(radius * radius - dy * dy):
				return name

			continue

		# The hoe: the ground may fall or rise from the footprint's edge no steeper than HOE_EDGE_SLOPE, so no step is left at the edge for a foot
		# or a cart wheel. Over the sphere's plan on a 9 by 9 grid: where the sphere cuts through that slope (or the foot inside it), it is refused.
		var plane: float = float(box[3])   # from the foot itself, so no drop is left at the edge

		if off.length() - radius >= maxf(HOE_EDGE_FACE_M, (absf(plane - centre.y) + radius) / HOE_EDGE_SLOPE):
			continue   # too far off for the slope or the face rule to reach (most things near a garden): no samples

		if edits_near.is_valid() and ground_height.is_valid():
			var p: Vector3 = it["pos"]
			var ground: float = _edited_height(p.x, p.z, edits_near.call(p, 3.0))

			if not is_nan(ground) and plane > ground + EDIT_ON_BASE_M:
				continue   # it stands on a foundation or a floor, not on the ground: the hoe levels round the house as before

		# The footprint's point nearest the sphere's middle, where a cut goes deepest under it (a fill highest over it): exact for a thin fence.
		var inner: Vector2 = (box[0] as Vector2) + ax * clampf(apart.dot(ax), -half.x, half.x) + az * clampf(apart.dot(az), -half.y, half.y)
		var inner_flat: float = inner.distance_squared_to(Vector2(centre.x, centre.z))

		if inner_flat < radius * radius:
			var inner_v: float = sqrt(radius * radius - inner_flat)

			if centre.y - inner_v < plane and plane < centre.y + inner_v:
				return name

		for i in 9:
			for j in 9:
				var dx: float = radius * (float(i) / 4.0 - 1.0)
				var dz: float = radius * (float(j) / 4.0 - 1.0)
				var flat: float = dx * dx + dz * dz

				if flat >= radius * radius:
					continue

				var v: float = sqrt(radius * radius - flat)
				var rel: Vector2 = Vector2(centre.x + dx, centre.z + dz) - (box[0] as Vector2)
				var out: float = Vector2(maxf(absf(rel.dot(ax)) - half.x, 0.0), maxf(absf(rel.dot(az)) - half.y, 0.0)).length()
				var cone: float = plane + (1.0 if fill else -1.0) * HOE_EDGE_SLOPE * out

				if centre.y - v < cone and cone < centre.y + v:
					return name

				# Near the footprint the sphere's own face must be no steeper than that either where it cuts below (or fills above) the foot:
				# a deep sphere's rim is a wall even when the slope is kept on average.
				var face: bool = (centre.y + v > plane) if fill else (centre.y - v < plane)

				if face and out < HOE_EDGE_FACE_M and sqrt(flat) > HOE_EDGE_SLOPE * 1.5 * v:
					return name

	return ""


# A floor, foundation or boulder under loose stacks went (taken down, retired) or shrank (mined): the stacks within `reach` of `at` come down onto
# what is under them now, so none is left in the air. Only the records near it.
func _resettle_on(at: Vector3, reach: float) -> void:
	var near: Array = _ids_near(at, reach + FLOOR_ROWS_REACH_M)

	for id in near:
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]

		if it.has("scatter") or it.has("showroom") or it.has("struct") or it.has("fire") or it.has("tree") or it.has("boulder"):
			continue

		if Vector2(it["pos"].x - at.x, it["pos"].z - at.z).length() > reach:
			continue

		var rest: Vector3 = _settled_loose(it["pos"], near)

		if rest != it["pos"]:
			it["pos"] = rest
			_refile(id)
			_wake_log(id)
			_dirty = true


func world_item_count() -> int:
	return _items.size()


func _drop(peer: int, inv, slot: int, count: int, at: Vector3) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or count <= 0:
		return

	var here: Vector3 = _peer_pos.get(peer, at)
	var spot: Vector3 = at if at.distance_to(here) <= DROP_REACH_M else here
	spot.y = _drop_height(spot, here)
	var number: int = inv.numbers[slot]
	var amount: int = mini(count, inv.counts[slot])

	drop_in_world(number, amount, spot, inv.wear[slot], 0.0, NAN, NAN, key_of(peer), inv.inst_of(slot))
	inv.take_from_slot(slot, amount)


# A thrown weapon leaves the inventory and flies; where it comes down it lies as a world item.
# Only items marked as weapons can be thrown. Nothing can be hit yet (no creatures).
# Floating damage numbers (Dave 2 Nov 2026: on by default, a toggle in Gameplay). An animal shows the damage it took. A tree or a boulder has no health,
# so it counts as HIT_POINTS split over the blows it takes: each blow shows its share (a 10-blow tree shows 10 a blow).
const HIT_POINTS := 100.0


func hit_number(peer: int, at: Vector3, amount: float) -> void:
	if send_hit_number.is_valid() and amount > 0.0:
		send_hit_number.call(peer, at, maxi(1, int(round(amount))))


# One blow at an animal with the item in hand (Dave 19 Nov 2026: "any thing in your hand should be able to be used as a weapon"): hits the animal in
# front within reach through the animal hook, at most once per recover_ms (else STRIKE_COOLDOWN_MS). A weapon with items.json "damage" (a spear, a
# sword) strikes for that and its reach_m (else MeleeRules.WEAPON_REACH_M, 3 m); any other item for its row in data/items/melee.json (an axe by its class and tier,
# food or a stone weakly; PROVISIONAL MELEE-1). The item is the slot the client names as in hand, checked first (Dave 13 Nov 2026); a broken one
# does nothing, and logs on the shoulder leave no hand free.
func _strike(peer: int, inv, slot: int, direction: Vector3) -> void:
	if slot >= inv.slot_count or _hands_full(inv) or not _peer_pos.has(peer) or direction.length() < 0.1 or not hit_animal.is_valid():
		return

	if slot < 0 or inv.numbers[slot] == 0:
		_punch(peer, direction)
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))

	if _is_broken(inv, slot):
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_strike.get(peer, -100000)) < float(entry.get("recover_ms", STRIKE_COOLDOWN_MS)):   # a greatsword recovers slower than a shortsword
		return

	_last_strike[peer] = now
	var eye: Vector3 = strike_origin(peer, now) + Vector3(0.0, 1.4, 0.0)

	if BIND_ITEMS.has(table.id_of(inv.numbers[slot])) and bind_animal.is_valid() and bool(bind_animal.call(peer, eye, direction, 2.5)):
		var before: Array = _snapshot(inv)
		inv.take_from_slot(slot, 1)   # the rope or twine stays on the bandit
		_send_changes(peer, inv, before)
		_dirty = true
		return

	var melee: Dictionary = MeleeRules.blow(entry, _melee_cfg)
	var damage: float = float(weapon_blow(entry, inv.inst[slot])["damage"]) if float(entry.get("damage", 0.0)) > 0.0 else float(melee["damage"])   # a +2 weapon strikes two harder (master s2.9 item 4)
	var skill_action: String = _blow_action(table.id_of(inv.numbers[slot]), entry)
	damage *= blow_skill_mult(peer, skill_action)   # exactly 1.0 at skill 1, so a new player's blows are as before
	var reach: float = float(melee["reach_m"])   # a pike reaches further than a sword; a knife less than an axe
	var answer: Variant = hit_animal.call(peer, eye, direction, reach, damage)   # {"at": where it struck} from the server (or true from older hooks), {} or false for a miss
	var hit: bool = not (answer as Dictionary).is_empty() if answer is Dictionary else bool(answer)

	if hit:
		# The number floats where the blow struck the animal (Dave 19 Nov 2026: "I couldnt tell it was doing damage"), else in front of the eye.
		var ahead: Vector3 = eye + direction.normalized() * minf(reach, 1.5)
		var at: Vector3 = (answer as Dictionary).get("at", ahead) if answer is Dictionary else ahead
		hit_number(peer, at + Vector3(0.0, 0.3, 0.0), damage)
		_wear_slot(peer, inv, slot, "strike")
		practice(peer, skill_action)
	else:
		_note_work(peer, str(entry.get("tool_class", "")))   # a jab at nothing tires as much as one that lands (BUG-001)


const STRIKE_LEAD_S := 0.3     # a blow's origin: the last reported position carried on its velocity this long at most (a report every 0.2 s, one lost)
const STRIKE_LEAD_M := 1.5     # and this far at most

# Where a striker is when their blow comes (robots 23 Nov 2026, 120 ms and 3% loss: a player who walked up to a bandit and jabbed at once was
# judged from their last position report, a metre behind, and missed 5 of 5): the last report carried on its own velocity for the time since it
# came, at most STRIKE_LEAD_S and STRIKE_LEAD_M, on the ground; not through a wall or shut door (then the report itself). The client also sends
# a report just before a blow (terrain_client send_position_now), which makes the time since it nearly nothing.
func strike_origin(peer: int, now: int) -> Vector3:
	var at: Vector3 = _peer_pos[peer]
	var move: Array = _peer_move.get(peer, [Vector3.ZERO, now])
	var to: Vector3 = carried_on(at, move[0], float(now - int(move[1])) / 1000.0)

	if to != at and structure_blocks_step(at.x, at.z, to.x, to.z, 0.0):
		return at

	return to


static func carried_on(at: Vector3, velocity: Vector3, age_s: float) -> Vector3:
	var on: Vector3 = Vector3(velocity.x, 0.0, velocity.z) * clampf(age_s, 0.0, STRIKE_LEAD_S)
	return at + on.limit_length(STRIKE_LEAD_M)


# What a fighting skill does to a blow: its factor over the factor this character would have at skill 1, so a blow at skill 1 is exactly
# as before whatever the attributes (the trait effect shows only as the skill grows), up to about max_factor at 100.
func blow_skill_mult(peer: int, action_name: String) -> float:
	var skill: String = str(_skills_cfg.get("actions", {}).get(action_name, {}).get("skill", ""))

	if skill == "" or skill_level.is_valid():
		return 1.0

	return skill_factor(peer, action_name) / maxf(SkillWeb.factor(_skills_cfg, skill, 1.0, attributes_of(peer)), 0.01)


# The skills.json action a blow with this item trains (the design's web: Fighting -> Brawling (Hand to hand), Swordplay, Spear, ...; Knives;
# Swordplay -> Rapier, Broadswords; Knives -> Daggers). Anything else in hand (a mace, a club, an axe, a stone) trains Fighting. PROVISIONAL.
static func _blow_action(id: String, entry: Dictionary) -> String:
	var weapon: String = str(entry.get("weapon_class", ""))

	if weapon == "sword":
		if id.contains("rapier"):
			return "strike_rapier"

		if id.contains("greatsword") or id.contains("broadsword") or id.contains("longsword"):
			return "strike_broadsword"

		return "strike_sword"

	if id.contains("dagger"):
		return "strike_dagger"

	if weapon in ["spear", "javelin", "fish_spear"]:
		return "strike_spear"

	if str(entry.get("tool_class", "")) == "knife":
		return "strike_knife"

	return "strike_fighting"


# A bare-handed blow (Dave 23 Nov 2026: punching "should be a basic thing ... a skill like hand to hand"): melee.json bare_hand's damage times the
# Hand to hand skill factor (skills.json action punch), at the animal in front within its reach; one that lands trains the skill. PROVISIONAL.
func _punch(peer: int, direction: Vector3) -> void:
	var row: Dictionary = _melee_cfg.get("bare_hand", {})
	var now: int = Time.get_ticks_msec()

	if now - int(_last_strike.get(peer, -100000)) < float(row.get("recover_ms", STRIKE_COOLDOWN_MS)):
		return

	_last_strike[peer] = now
	var eye: Vector3 = strike_origin(peer, now) + Vector3(0.0, 1.4, 0.0)
	var damage: float = maxf(float(row.get("damage", 2.0)) * blow_skill_mult(peer, "punch"), 0.5)
	var reach: float = float(row.get("reach_m", 1.8))
	var answer: Variant = hit_animal.call(peer, eye, direction, reach, damage)
	var hit: bool = not (answer as Dictionary).is_empty() if answer is Dictionary else bool(answer)

	if hit:
		var at: Vector3 = (answer as Dictionary).get("at", eye + direction.normalized() * minf(reach, 1.5)) if answer is Dictionary else eye + direction.normalized() * minf(reach, 1.5)
		hit_number(peer, at + Vector3(0.0, 0.3, 0.0), damage)
		practice(peer, "punch")

	_note_work(peer, "")   # a punch tires like any blow (BUG-001)


# A carcass where an animal died (and for the admin test carcass): a struct the player works with a knife. Saved over a restart (_kept_transient), rots in 2 game days.
# body: the animal that died (server_animals dead_body_of: its look, row number and heading), kept so the client draws that animal's own
# model lying where it fell (animal_view dead_body); {} (the admin test carcass, a trap's catch, a bird of a flock) leaves the yaw to chance.
func make_carcass(species: String, pos: Vector3, hunter: int = -1, body: Dictionary = {}) -> int:
	if not _carcass_cfg.get("species", {}).has(species) or not _structures.has("carcass"):
		return 0

	if hunter >= 0:
		practice(hunter, "hunt", float(_carcass_cfg["species"][species].get("hunt_difficulty", 1.0)))
		practice(hunter, "track", 0.5)   # following the game to the kill; Tracking also trains from the trail-reading event when it exists

	var ground: float = _ground_under(pos + Vector3(0.0, 0.3, 0.0))   # the ground the animal fell on, a pit's floor or a fill's top too
	var spot: Vector3 = Vector3(pos.x, ground if not is_nan(ground) else pos.y, pos.z)
	var id: int = _next_id
	_next_id += 1
	_items[id] = {"number": table.number_of("carcass"), "count": 1, "pos": spot, "left": CARCASS_LIFE_S, "struct": {"kind": "carcass", "yaw": float(hash(id) % 360), "species": species, "blows": 0, "transient": true}}

	if body.has("look"):
		_items[id]["struct"]["look"] = int(body["look"])
		_items[id]["struct"]["num"] = int(body.get("num", 0))
		_items[id]["struct"]["yaw"] = snappedf(fposmod(rad_to_deg(-float(body.get("heading", 0.0))) - 90.0, 360.0), 0.1)   # the way it faced (animal_view MotionBuffer.face: a node's yaw is -heading - 90 degrees)

	return id


# A structure row's extra for the client. A carcass says whether E takes it whole (a snared one not yet cut: whole); the key is sent
# for carcasses only.
func _struct_extra(it: Dictionary) -> Dictionary:
	var extra: Dictionary = {"yaw": float(it["struct"]["yaw"]), "age": _remains_age(it), "sp": str(it["struct"].get("species", "")), "lit": bool(it["struct"].get("lit", false))}

	if it["struct"].has("look"):
		extra["look"] = int(it["struct"]["look"])   # a carcass: the animal's own look and row number (make_carcass body)
		extra["num"] = int(it["struct"].get("num", 0))

	if _whole_catch(it):
		extra["whole"] = true

	var held: int = _trap_catch(it)

	if held != 0:
		extra["catch"] = held   # a trap holding its catch: which carcass (the client sends E to the trap, not the carcass in it)

	return extra


# A snared carcass not yet cut, of a species with a whole item (traps.json whole_items): E takes it whole.
func _whole_catch(it: Dictionary) -> bool:
	var st: Dictionary = it.get("struct", {})
	return str(st.get("kind", "")) == "carcass" and bool(st.get("snared", false)) and int(st.get("blows", 0)) == 0 and _whole_number(str(st.get("species", ""))) > 0


# The whole item of a species (traps.json whole_items), 0 for none.
func _whole_number(species: String) -> int:
	return 0 if _traps == null else table.number_of(str((_traps.cfg.get("whole_items", {}) as Dictionary).get(species, "")))


# The carcass a set trap holds (its catch, still lying there), 0 for none.
func _trap_catch(it: Dictionary) -> int:
	if _traps == null or not _traps.is_snare(it):
		return 0

	var c: int = int(it["struct"].get("catch", 0))
	return c if _items.has(c) else 0


# Whether the pack takes one whole catch (weight and room: the usual carry rules); says why not. The catch stays where it lies.
func can_take_whole(peer: int, number: int, age: int) -> bool:
	var inv = inventory_of(peer)

	if inv == null:
		return false

	if _fit(peer, inv, number, 1) < 1:
		_say(peer, "Too heavy to carry the %s." % table.in_sentence(table.name_of(number)))
		return false

	if inv.copy().add(number, 1, age) > 0:
		_say(peer, "Your pack has no room for the %s." % table.in_sentence(table.name_of(number)))
		return false

	return true


# A trap's catch carried whole (Dave 25 Nov 2026, server_traps collect; items.json carcass_of): its slot's age (spoilage wear) is how far
# the carcass had gone off, so it rots as fast in the pack as on the ground (spoilage.json shelf = CARCASS_LIFE_S) and lays back down as
# old as it was picked up.
func whole_age(number: int, left_s: float) -> int:
	return clampi(int(round(float(table.shelf_units(number)) * (1.0 - clampf(left_s / CARCASS_LIFE_S, 0.0, 1.0)))), 0, maxi(table.shelf_units(number) - 1, 0))


# A whole catch laid on the ground is the carcass again, still marked as snared (no Hunting for it again), one per item; true when laid.
func _lay_whole(number: int, count: int, position: Vector3, item_wear: int) -> bool:
	var sp: String = str(table.entry(table.id_of(number)).get("carcass_of", ""))
	var shelf: int = table.shelf_units(number)

	if sp == "" or not _carcass_cfg.get("species", {}).has(sp):
		return false

	for n in count:
		var at: Vector3 = position + Vector3(0.3 * float(n % 3), 0.0, 0.3 * floorf(float(n) / 3.0))   # a few laid together lie side by side
		var c: int = make_carcass(sp, at, -1)

		if not _items.has(c):
			return n > 0

		_items[c]["struct"]["snared"] = true
		_items[c]["left"] = clampf(CARCASS_LIFE_S * (1.0 - float(item_wear) / float(maxi(shelf, 1))), 1.0, CARCASS_LIFE_S) if shelf > 0 else CARCASS_LIFE_S

	_dirty = true
	return true


# E on a snared carcass lying on the ground (a whole catch put down again): taken whole, as from the snare. A hunted kill or one begun with
# the knife is worked where it lies.
func _pick_up_whole(peer: int, id: int) -> void:
	if not _whole_catch(_items[id]):
		return

	var number: int = _whole_number(str(_items[id]["struct"].get("species", "")))
	var age: int = whole_age(number, float(_items[id].get("left", 0.0)))

	if not can_take_whole(peer, number, age):
		return

	_items.erase(id)
	_dirty = true
	give(peer, number, 1, {}, age)


# One knife blow on a carcass (data/items/carcass.json): the parts are rolled once (luck applies) and handed out over the blows.
func _process_carcass(peer: int, inv, id: int, held_slot: int) -> void:   # held_slot: the pack slot in hand; the knife there does the work
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not _peer_pos.has(peer) or str(it.get("struct", {}).get("kind", "")) != "carcass":
		return

	var knife: int = _swing_tool(peer, inv, held_slot, str(_carcass_cfg.get("tool_class", "knife")))

	if knife < 0:
		return

	if _peer_pos[peer].distance_to(it["pos"]) > CARCASS_REACH_M:
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_process.get(peer, -100000)) < PROCESS_COOLDOWN_MS:
		return

	_last_process[peer] = now
	var st: Dictionary = it["struct"]
	var blows_total: int = int((_carcass_cfg.get("species", {}).get(str(st.get("species", "")), {}) as Dictionary).get("blows", _carcass_cfg.get("blows", 4)))   # per species (carcass.json species row), else the global number
	# A better knife works it in fewer blows, the same parts (carcass.json knife_speed by the knife's material; tier consistency, 23 Nov 2026).
	var speed: float = float((_carcass_cfg.get("knife_speed", {}) as Dictionary).get(str(table.entry(table.id_of(inv.numbers[knife])).get("material", "")), 1.0))
	blows_total = maxi(ceili(float(blows_total) / maxf(speed, 0.1)), 1)
	_wear_slot(peer, inv, knife, "carcass")

	if not st.has("parts"):
		var rng: RandomNumberGenerator = RandomNumberGenerator.new()
		rng.seed = hash(id) ^ 0x2f6b
		st["parts"] = []

		for row in _carcass_cfg.get("species", {}).get(str(st["species"]), {}).get("parts", []):
			var rolled: int = roll_amount(peer, rng, int(row[1]), int(row[2]))
			st["parts"].append([str(row[0]), maxi(int(round(float(rolled) * skill_factor(peer, "dress_carcass"))), 1) if rolled > 0 else 0])

	var left_blows: int = maxi(blows_total - int(st["blows"]), 1)

	for part in st["parts"]:
		var share: int = ceili(float(part[1]) / float(left_blows))

		if share > 0:
			give(peer, table.number_of(str(part[0])), share)
			part[1] = int(part[1]) - share

	st["blows"] = int(st["blows"]) + 1

	if int(st["blows"]) >= blows_total:
		_items.erase(id)
		practice(peer, "dress_carcass")
		_goal_what[peer] = str(st["species"]).replace("_", " ")   # the done line names the animal (QA #9: a bear was called a rabbit)
		_goal_event(peer, "carcass_worked")

		if bool(st.get("snared", false)):
			_goal_event(peer, "snare_catch")   # a catch from a snare, worked (starter goal "Snare a rabbit", D-TRAP-1)

	_dirty = true


func _throw(peer: int, inv, slot: int, direction: Vector3) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer) or direction.length() < 0.1:
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_throw.get(peer, -100000)) < THROW_COOLDOWN_MS:
		return

	if str(table.entry(table.id_of(inv.numbers[slot])).get("kind", "")) != "weapon":
		return

	if _is_broken(inv, slot):
		return

	_last_throw[peer] = now
	var number: int = inv.numbers[slot]
	var spent: int = inv.wear[slot] + 1
	var thrown: Dictionary = inv.take_from_slot(slot, 1)
	_flights.append({"number": number, "wear": spent, "inst": thrown["inst"], "peer": peer, "pos": _peer_pos[peer] + Vector3(0.0, EYE_HEIGHT, 0.0), "vel": direction.normalized() * THROW_SPEED, "age": 0.0, "lag": shot_lag(peer, now)})

	if send_flight.is_valid():
		send_flight.call(peer, number, _peer_pos[peer] + Vector3(0.0, EYE_HEIGHT, 0.0), direction.normalized() * THROW_SPEED, false)


# How far behind the server the shooter's screen showed the animals when it shot or threw (ACT_SEEN just before): [ms behind for a seen
# animal, ms behind for a committed charge, or -1 when it sent none], or [] for judged now. The flight keeps it, so every step of an arrow
# is judged where that player sees the animals at that moment (docs/design/ANIMAL_NETCODE.md "Fair hits"; at most rewind_max_ms back).
func shot_lag(peer: int, now: int) -> Array:
	var seen: Array = shot_seen.get(peer, [])
	shot_seen.erase(peer)

	if seen.size() < 2 or int(seen[0]) <= 0:
		return []

	return [now - int(seen[0]), now - int(seen[1]) if int(seen[1]) > 0 else -1]


# ACT_SHOOT: one arrow from the bow in slot `slot`, drawn for `draw_ms` (never trusted: clamped), along `direction`. Plan 4b, data/items/bow.json.
# `loaded` is the arrow item the bow is loaded with (Dave 10 Nov 2026: arrows dragged onto the bow); 0, or one not in the pack: the first ammo there.
# The bow skill (the hunting skill's working level) turns the shot by up to aim.spread_deg at random (luck narrows it) and sets aim.damage_mult (BowAim).
func _shoot(peer: int, inv, slot: int, draw_ms: int, direction: Vector3, loaded: int = 0) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer) or direction.length() < 0.1:
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))

	if not BowAim.shoots(entry) or _is_broken(inv, slot):
		return

	if _bow == null:
		_bow = BowScript.new()

	var bow_id: String = table.id_of(inv.numbers[slot])

	var now: int = Time.get_ticks_msec()

	if now - int(_last_shot.get(peer, -100000)) < float(BowAim.pace_ms(_bow.cfg, bow_id)):
		var wait_line: String = BowAim.say(_bow.cfg, bow_id, "say_not_spanned")   # a crossbow says it is not spanned yet; a bow stays silent

		if wait_line != "":
			_say(peer, wait_line)

		return

	var source = _worn_quiver(peer)   # a worn quiver first (master s3.9 rule 4), then the pack
	var ammo: int = _bow.ammo_slot(source, table, loaded, bow_id) if source != null else -1

	if ammo < 0:
		source = inv
		ammo = _bow.ammo_slot(inv, table, loaded, bow_id)

	if ammo < 0:
		_say(peer, BowAim.say(_bow.cfg, bow_id, "say_no_ammo"))
		return

	_last_shot[peer] = now
	var arrow: Dictionary = table.entry(table.id_of(source.numbers[ammo]))
	var number: int = source.numbers[ammo]
	var shot_inst: Dictionary = source.take_from_slot(ammo, 1)["inst"]
	var power: float = 1.0 if BowAim.full_power(_bow.cfg, bow_id) else _bow.power(draw_ms)

	if power <= float(_bow.cfg.get("weak_power", 0.25)):
		_say(peer, str(_bow.cfg.get("say_weak", "")))

	_wear_slot(peer, inv, slot, "strike")
	var level: float = working_level(peer, "hunting")
	var aim: Vector3 = BowAim.spread(direction, BowAim.spread_deg(_bow.cfg, level), LuckScript.low(_aim_rng.randf(), luck_of(peer), _luck_strength()), _aim_rng.randf())   # luck-exempt: the draws that luck nudges (how far out) and which way
	var fire_cfg: Dictionary = _bow.cfg.get("fire_arrow", {})
	var aflame: bool = bool(arrow.get("fire", false)) and not fire_cfg.is_empty() and _flame_near(_peer_pos[peer], float(fire_cfg.get("light_m", 3.0)))
	var damage: float = _bow.damage(float(arrow.get("damage", 5.0)), power, level, bow_id) * (float(fire_cfg.get("damage_mult", 1.5)) if aflame else 1.0)
	_arrows.append({"peer": peer, "number": number, "inst": shot_inst, "tip": str(arrow.get("tip", "wood")), "damage": damage, "fire": aflame,
		"pos": _peer_pos[peer] + Vector3(0.0, EYE_HEIGHT, 0.0), "vel": aim * _bow.speed(power, bow_id), "flown": 0.0, "age": 0.0, "range": _bow.range_m(bow_id), "sticks": BowAim.sticks(_bow.cfg, bow_id), "lag": shot_lag(peer, now)})

	if send_flight.is_valid():
		send_flight.call(peer, number, _peer_pos[peer] + Vector3(0.0, EYE_HEIGHT, 0.0), aim * _bow.speed(power, bow_id), aflame)

	if animal_alarm.is_valid():
		animal_alarm.call(_peer_pos[peer], float(_bow.cfg.get("noise_m", 40.0)) * (float(fire_cfg.get("alarm_mult", 2.0)) if aflame else 1.0))


# A flame to light a fire arrow from (bow.json fire_arrow.light_m, Part C plan 6): a burning fire, a lit placed light or torch, or a
# player bearing a burning torch, within `reach` of `at`.
func _flame_near(at: Vector3, reach: float) -> bool:
	for row in _lit_rows():
		if (row[0] as Vector3).distance_to(at) <= reach:
			return true

	var now: int = Time.get_ticks_msec()

	for peer in _torch_seen:
		if now - int(_torch_seen[peer]) <= TORCH_REPORT_MS and _peer_pos.has(peer) and (_peer_pos[peer] as Vector3).distance_to(at) <= reach:
			return true

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and bool(it["struct"].get("lit", false)) and (it["pos"] as Vector3).distance_to(at) <= reach:
			return true

	return false


# A burning fire arrow comes down (Part C plan 6): a laid fire with wood on it, or an unlit placed light (a torch post), within
# fire_arrow.ignite_m of where it fell catches. Open rain still beats it, as with a lit hand. No spread: nothing else burns.
func _arrow_ignite(at: Vector3) -> String:
	var reach: float = float(_bow.cfg.get("fire_arrow", {}).get("ignite_m", 0.6))
	var raining: bool = _rain_here(at) >= RAIN_PUTS_OUT

	for id in _items:
		var it: Dictionary = _items[id]

		if Vector2(it["pos"].x - at.x, it["pos"].z - at.z).length() > reach or absf(it["pos"].y - at.y) > 2.0:
			continue

		if it.has("fire"):
			var fire: Dictionary = it["fire"]

			if int(fire["state"]) in [9, FIRE_STATE_ASH] and float(fire.get("burn_left", 0.0)) > 0.0 and not (raining and not bool(fire.get("covered", false))):
				fire["state"] = _fire_best_state(fire)
				fire.erase("wet_s")
				it["left"] = 1.0e9
				_lit_valid = false
				_dirty = true
				return "fire"
		elif it.has("struct") and not bool(it["struct"].get("lit", false)):
			var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
			var sheltered: bool = cover_at.is_valid() and float(cover_at.call(it["pos"])) > 0.5

			if str(def.get("use", "")) == "light" and def.has("fuel") and not (raining and bool(def.get("rain_douses", false)) and not sheltered):
				it["struct"]["lit"] = true
				it["struct"]["fuel_left"] = maxf(float(it["struct"].get("fuel_left", 0.0)), light_burn_s(def))
				_lit_valid = false
				_dirty = true
				return "light"

	return ""


# Arrows in the air, in steps of step_s: the first animal on the segment is hurt, otherwise the ground (or water) or the range ends the flight.
func _arrow_fly(delta: float) -> void:
	if _arrows.is_empty():
		return

	var step: float = float(_bow.cfg.get("step_s", 0.05))
	var left: float = delta

	while left > 0.0 and not _arrows.is_empty():
		var dt: float = minf(left, step)
		left -= dt

		for ar in _arrows.duplicate():
			var from: Vector3 = ar["pos"]
			ar["vel"].y -= THROW_GRAVITY * dt
			var to: Vector3 = from + ar["vel"] * dt
			ar["flown"] += from.distance_to(to)
			ar["age"] += dt
			var landed: bool = false
			var hit_animal_now: bool = false
			var at: Vector3 = to
			var stuck: bool = false

			if hit_animal_path.is_valid():
				var hit: Dictionary = hit_animal_path.call(int(ar["peer"]), from, to, float(ar["damage"]), ar.get("lag", []))

				if not hit.is_empty():
					landed = true
					hit_animal_now = true
					at = hit["at"]
					practice(int(ar["peer"]), "bow")
					hit_number(int(ar["peer"]), at, float(ar["damage"]))

			var at_foot: bool = false

			if not landed and trunks_near.is_valid():   # a tree trunk on the way: the arrow sticks in it (Dave 10 Nov 2026); a sling stone drops at its foot
				var into: float = _arrow_trunk(from, to)

				if into >= 0.0:
					landed = true
					stuck = bool(ar.get("sticks", true))
					at_foot = not stuck
					at = from.lerp(to, into)

			var knows: bool = ground_height.is_valid() or ground_now.is_valid()
			var down: Vector3 = _landing(from, to) if knows else Vector3.INF

			if at_foot and knows:
				var foot: float = _ground_under(at)
				at.y = foot if not is_nan(foot) else at.y

			if not landed and (down.x != INF or float(ar["flown"]) >= float(ar.get("range", _bow.range_m())) or float(ar["age"]) >= THROW_MAX_S * 2.0):
				landed = true

				if down.x != INF:
					at = down
				else:   # out of range or time in the air: down on the ground under it
					var ground: float = _ground_under(to) if knows else -1000000.0
					at = Vector3(to.x, ground if not is_nan(ground) else to.y, to.z)

			ar["pos"] = to

			if not landed:
				continue

			_arrows.erase(ar)

			if not hit_animal_now and animal_alarm.is_valid() and float(_bow.cfg.get("land_alarm_m", 0.0)) > 0.0:
				animal_alarm.call(at, float(_bow.cfg.get("land_alarm_m", 0.0)))   # a miss thuds down beside them: animals that close run from where it landed (hearing-range pass, 23 Nov 2026)

			var wet: bool = water_depth_at.is_valid() and float(water_depth_at.call(at)) > 0.05

			if bool(ar.get("fire", false)):   # a burning arrow is always burnt up; where it falls it may light a fire or a torch post
				var lit_what: String = "" if wet else _arrow_ignite(at)
				print("server items: fire arrow came down at x%d z%d after %.0f m (animal %s): burnt up%s" % [int(at.x), int(at.z), float(ar["flown"]), str(hit_animal_now), (", lit a " + lit_what) if lit_what != "" else ""])
			elif stuck and fate(int(ar["peer"]), "arrow", 1.0 - _bow.lost_chance(str(ar["tip"]), false, false)):
				_stick_arrow(int(ar["number"]), at, (ar["vel"] as Vector3).normalized(), ar.get("inst", {}))
				print("server items: arrow stuck in a tree at x%d z%d y%.1f after %.0f m" % [int(at.x), int(at.z), at.y, float(ar["flown"])])
			elif stuck:
				print("server items: arrow hit a tree at x%d z%d after %.0f m: broke" % [int(at.x), int(at.z), float(ar["flown"])])
			elif fate(int(ar["peer"]), "arrow", 1.0 - _bow.lost_chance(str(ar["tip"]), hit_animal_now, wet)):
				drop_in_world(int(ar["number"]), 1, at, 0, 0.0, NAN, NAN, "", ar.get("inst", {}))
				print("server items: arrow landed at x%d z%d y%.1f after %.0f m (animal %s, water %s): lying there" % [int(at.x), int(at.z), at.y, float(ar["flown"]), str(hit_animal_now), str(wet)])
			else:
				print("server items: arrow landed at x%d z%d after %.0f m (animal %s, water %s): broke or lost" % [int(at.x), int(at.z), float(ar["flown"]), str(hit_animal_now), str(wet)])

				if wet:
					_say(int(ar["peer"]), str(_bow.cfg.get("say_lost", "")))


# The share 0..1 along from -> to where the flight first meets a standing trunk, or -1 (BowAim.segment_trunk on each trunk near the segment).
const ARROW_TRUNK_SEARCH_M := 2.0   # an ordinary trunk collider and a little over; wider trunks (tree_trunks.gd SEARCH_TRUNK_M) are found by their own radius (terrain_server _cached_trees)


func _arrow_trunk(from: Vector3, to: Vector3) -> float:
	var best: float = -1.0

	for trunk in trunks_near.call(from.lerp(to, 0.5), from.distance_to(to) * 0.5 + ARROW_TRUNK_SEARCH_M):
		var t: float = BowAim.segment_trunk(from, to, trunk[0], float(trunk[1]), float(trunk[2]))

		if t >= 0.0 and (best < 0.0 or t < best):
			best = t

	return best


# An arrow stuck in a tree where it hit (Dave 10 Nov 2026: "there should be an arrow in that tree until I collect it or it fades out in 5 minutes"):
# a loose arrow at the hit point, not let down to the ground, turned along its flight (rot_y about the vertical, tilt up), bow.json stuck_s seconds
# (300) unless picked up. It never joins another arrow's pile.
func _stick_arrow(number: int, at: Vector3, along: Vector3, item_inst: Dictionary = {}) -> void:
	_items[_next_id] = {"number": number, "count": 1, "pos": at, "left": float(_bow.cfg.get("stuck_s", 300.0)), "wear": 0,
		"rot_y": atan2(-along.z, along.x), "tilt": asin(clampf(along.y, -1.0, 1.0))}
	_tilted[_next_id] = true

	if not item_inst.is_empty():
		_items[_next_id]["inst"] = item_inst.duplicate(true)
	_next_id += 1
	_dirty = true


func _fly(delta: float) -> void:
	_arrow_fly(delta)
	for flight in _flights.duplicate():
		var from: Vector3 = flight["pos"]
		flight["vel"].y -= THROW_GRAVITY * delta
		flight["pos"] += flight["vel"] * delta
		flight["age"] += delta

		# A thrown spear or javelin hits the first animal on its path for the weapon's throw_damage (MikeW, 3 Nov: it flew
		# through them, so a new player could not hunt with the first weapon they make) and drops where it struck.
		var throw_damage: float = float(table.entry(table.id_of(int(flight["number"]))).get("throw_damage", 0.0))

		if throw_damage > 0.0 and hit_animal_path.is_valid() and flight.has("peer"):
			var hit: Dictionary = hit_animal_path.call(int(flight["peer"]), from, flight["pos"], throw_damage, flight.get("lag", []))

			if not hit.is_empty():
				var at: Vector3 = hit["at"]
				hit_number(int(flight["peer"]), at, throw_damage)
				var below: float = _ground_under(at) if ground_height.is_valid() or ground_now.is_valid() else at.y
				_land_thrown(flight, Vector3(at.x, below if not is_nan(below) else at.y, at.z))
				_flights.erase(flight)
				continue

		var knows: bool = ground_height.is_valid() or ground_now.is_valid()
		var down: Vector3 = _landing(from, flight["pos"]) if knows else Vector3.INF

		if down.x != INF or flight["age"] >= THROW_MAX_S:
			var spot: Vector3 = down if down.x != INF else flight["pos"]

			if down.x == INF and knows:   # out of time in the air: not under the ground
				var ground: float = _ground_under(spot)
				spot.y = maxf(ground, spot.y) if not is_nan(ground) else spot.y

			if animal_alarm.is_valid():
				if _bow == null:
					_bow = BowScript.new()   # its cfg holds the landing radius (as _shoot makes it at the first shot)

				animal_alarm.call(spot, float(_bow.cfg.get("land_alarm_m", 0.0)))   # a thrown spear that missed thuds down: as a missed arrow (hearing-range pass)

			_land_thrown(flight, spot)
			_flights.erase(flight)


const GOLDEN_ANGLE := 2.399963   # radians: successive ids spread their turns evenly round the circle


# --- Rolling logs: real physics (TREE_WOOD_TOOLS_DESIGN.md s1.1, s5 "Rolling", W-31; Dave 16 Nov 2026: "I just want normal physics to work for logs.
# they should fall and roll like normal logs would") ---
# A loose shoulder log (or an item in drops.json rolling.also: the plain Log) is a rigid capsule in the engine's own physics (log_physics.gd: Jolt,
# a space of the server's own) while anything happens near it: dropped, landed from a felled tree, pushed by a walker (ACT_PUSH_LOG) or struck by
# another log. Around every awake log the space holds a collision copy of the ground, the boulders, stumps, standing trees, walls and the other loose
# logs near it (_log_surround, every rolling.look_s), so a log rolls down a hill, glances off a trunk, stops against a rock or a wall, knocks the
# log it strikes, stacks on others and settles. The ground holds a rolling log back by rolling.resist (the slope a log at rest stays on, by the
# ground's material: grass more, bare rock and snow less), and a log that has been nearly still for rolling.still_s is put to sleep. A log asleep with
# nothing awake within rolling.look_m is taken out of the space again (its pose is in its record), so a log lying still costs nothing.
# The pose (lying_logs.gd: pos under the middle, rot_y, pitch, spin) is the item's own and saved with it; the players who see a moving log are
# told every rolling.send_s (logs_moved, protocol 125: their client glides it).
# A log more than rolling.rest_m above or below the server ground (on a floor, a deck, a cart, in a tunnel) is not simulated, unless it lies on
# another loose log: it stays where it is and only stands in the way of the others.
# shortcut: the ground copy is ground_height (no saved digs and fills, as before); walkers are not bodies in the space (a client stops its own
# walker at a log and sends the push, lying_logs.walker_touch), so a rolling log does not strike a player; water stops a log at the shore.
const LogPhysicsScript := preload("res://src/stream/log_physics.gd")
const LyingLogsScript := preload("res://src/shared/lying_logs.gd")
var _logs = LogPhysicsScript.new()
var _log_quiet: Dictionary = {}     # world id -> seconds an awake log has been nearly still
var _push_last: Dictionary = {}     # peer -> msec of the last push taken from them


func _rolls_item(number: int) -> bool:
	return is_shoulder_item(number) or (_drops.get("rolling", {}) as Dictionary).get("also", []).has(table.id_of(number))


# A loose log lying free: not a tree, building, fire, boulder, showroom piece or a piece still coming down.
func _free_log(it: Dictionary) -> bool:
	return not it.is_empty() and not it.has("tree") and not it.has("struct") and not it.has("fire") and not it.has("boulder") and not it.has("showroom") and not it.has("scatter") and not it.has("fall") and _rolls_item(int(it["number"]))


func _log_r(it: Dictionary) -> float:
	return float(_drops.get("rolling", {}).get("radius_m", LyingLogsScript.LOG_R)) * float(it.get("girth", 1.0))


func _log_xf(it: Dictionary) -> Transform3D:
	var b: Basis = LyingLogsScript.basis_of(float(it.get("rot_y", 0.0)), float(it.get("pitch", 0.0)), float(it.get("spin", 0.0)))
	return Transform3D(b, it["pos"] + Vector3(0.0, _log_r(it), 0.0))


# Puts a log in motion: into the space (with the ground and what is near it) when it is not there yet, else awake again. False when it is not
# a free log, not lying on the ground or on another log, or off the world.
func _wake_log(id: int) -> bool:
	var it: Dictionary = _items.get(id, {})

	if not _free_log(it) or not ground_height.is_valid():
		return false

	if not it.has("rot_y"):
		it["rot_y"] = fposmod(float(id) * GOLDEN_ANGLE, TAU)   # a log laid down or dropped has a turn of its own

	if _logs.has(id):
		_logs.wake(id)
	elif not _log_supported(it) or not _log_body(id, false):
		return false

	_log_quiet.erase(id)
	_roll_look_in = 0.0   # look round it on the next tick
	return true


func _log_body(id: int, asleep: bool) -> bool:
	var cfg: Dictionary = _drops.get("rolling", {})
	var it: Dictionary = _items[id]
	var xf: Transform3D = _log_xf(it)
	_logs.ground_height = ground_height

	if not _logs.ensure_ground(xf.origin, float(cfg.get("half_len_m", LyingLogsScript.LOG_HALF_M)) + 1.0):
		return false

	var r: float = _log_r(it)

	if not asleep and absf(it["pos"].y - float(ground_height.call(it["pos"].x, it["pos"].z))) <= float(cfg.get("rest_m", 0.6)):   # a neighbour put back asleep keeps the pose physics left it
		var laid: Transform3D = _log_on_ground(xf, r)   # laid level on a slope, one end would be in the ground: it lies along the ground instead

		if laid != xf:
			xf = laid
			var angles: Vector3 = LyingLogsScript.angles_of(xf.basis)
			it["pos"] = xf.origin - Vector3(0.0, r, 0.0)   # the record lies as the body does, so the players see it so before it ever moves
			it["rot_y"] = angles.x
			it["pitch"] = angles.y
			it["spin"] = angles.z
			_roll_moved[id] = true
			_dirty = true

	var kg: float = CarryRules.weight_of(table.id_of(int(it["number"])), _carry_cfg) if not _carry_cfg.is_empty() else 20.0
	_logs.add_log(id, xf, _log_r(it), float(cfg.get("half_len_m", LyingLogsScript.LOG_HALF_M)), maxf(kg, 1.0) * maxf(float(it.get("count", 1)), 1.0), float(cfg.get("friction", 0.8)), float(cfg.get("bounce", 0.1)), asleep)
	return true


# A log on the ground whose underside goes into it (dropped level across a hump or along a slope) is laid along the ground: pitched to the
# ground under its two ends and lifted clear of the ground under its middle. One that is clear stays as it is (a pose physics left).
func _log_on_ground(xf: Transform3D, r: float) -> Transform3D:
	var core: Vector3 = xf.basis.x.normalized() * (float(_drops.get("rolling", {}).get("half_len_m", LyingLogsScript.LOG_HALF_M)) - r)
	var a: Vector3 = xf.origin + core
	var b: Vector3 = xf.origin - core
	var ga: float = float(ground_height.call(a.x, a.z))
	var gb: float = float(ground_height.call(b.x, b.z))
	var gm: float = float(ground_height.call(xf.origin.x, xf.origin.z))

	if is_nan(ga) or is_nan(gb) or is_nan(gm) or (a.y - r >= ga - 0.02 and b.y - r >= gb - 0.02 and xf.origin.y - r >= gm - 0.02):
		return xf

	var angles: Vector3 = LyingLogsScript.angles_of(xf.basis)
	var pitch: float = atan2(ga - gb, 2.0 * Vector2(core.x, core.z).length())   # the rise over the level run between the two ends sampled
	var mid: float = maxf((ga + gb) * 0.5, gm) + r
	return Transform3D(LyingLogsScript.basis_of(angles.x, pitch, angles.z), Vector3(xf.origin.x, mid, xf.origin.z))


# On the ground (within rolling.rest_m of it) or on another loose log.
func _log_supported(it: Dictionary) -> bool:
	var at: Vector3 = it["pos"]
	var ground: float = float(ground_height.call(at.x, at.z))

	if is_nan(ground):
		return false

	var rest: float = float(_drops.get("rolling", {}).get("rest_m", 0.6))
	var floor_top: float = _floor_top_below(at + Vector3(0.0, 0.1, 0.0), [], false) if at.y > ground + 0.05 else NAN   # only a log above the ground looks

	if not is_nan(floor_top) and floor_top > ground + 0.05 and at.y - floor_top < 0.15:
		return false   # lying on a building floor: the rolling world has only the ground (and boulders, which push a log off), so it would roll through the slab

	if absf(at.y - ground) <= rest:
		return true

	if at.y < ground or at.y - ground > 3.0:
		return false

	for sid in _log_near_ids(at, 1.5):
		var other: Dictionary = _items.get(sid, {})

		if not is_same(other, it) and _free_log(other) and other["pos"].y < at.y - 0.1 and at.y - other["pos"].y < 1.5:
			return true   # stacked on a log below it

	return false


# The world ids filed near a point (the last sync's grid; every item when no sync has run).
# shortcut: the grid is up to SYNC_EVERY_S old, so a log or boulder dropped since is not seen by a log already rolling until the next sync.
func _log_near_ids(at: Vector3, reach: float) -> Array:
	if _sync_grid.is_empty():
		return _items.keys()

	var seen: Dictionary = {}

	for sid in _stock_cells(Vector3(at.x, 0.0, at.z), reach / maxf(maxf(CraftStock.LOOSE_STOCK_M, CraftStock.CRAFT_REACH_M), 0.01)):
		seen[sid] = true

	return seen.keys()


# Every rolling.look_s: the space round each awake log is filled in (ground, the loose logs near it asleep, the boulders, stumps, standing
# trees and walls) and what nothing awake is near any more is taken out.
func _log_surround() -> void:
	var cfg: Dictionary = _drops.get("rolling", {})
	var reach: float = float(cfg.get("half_len_m", LyingLogsScript.LOG_HALF_M)) + float(cfg.get("look_m", 4.0))
	var awake: Array = []

	for id in _logs.ids():
		if not _free_log(_items.get(id, {})):
			_logs.remove(id)   # picked up, split or burnt since
			_log_quiet.erase(id)
		elif not _logs.asleep(id):
			awake.append(_logs.pose(id).origin)

	var keep: Dictionary = {}

	for at in awake:
		_logs.ensure_ground(at, reach)

		for sid in _log_near_ids(at, reach):
			var other: Dictionary = _items.get(sid, {})

			if other.is_empty() or Vector2(other["pos"].x - at.x, other["pos"].z - at.z).length() > reach:
				continue

			if _free_log(other):
				if not _logs.has(sid) and _log_supported(other):
					_log_body(sid, true)   # asleep until something strikes it
				elif not _logs.has(sid):
					keep["i%d" % sid] = true   # on a floor or a deck: in the way, never moved
					_log_static("i%d" % sid, _log_capsule(_log_r(other)), _log_xf(other), true)
			elif other.has("struct") and not other["struct"].has("site") and _is_floor_def(_structures.get(str(other["struct"]["kind"]), {})):
				# A foundation or floor piece (physical world audit 23 Nov 2026: a log rolled off the ground through a foundation's slab): a box of its
				# footprint from its top down (a foundation's to under the ground, the wheel's lift with it), so a rolling log meets its edge or rides on it.
				var key: String = "f%d" % sid
				keep[key] = true

				if not _logs.has_static(key):
					var def: Dictionary = _structures[str(other["struct"]["kind"])]
					var top: float = PlacementRules.anchor_top(def)
					var deep: float = top + (PlacementRules.LIFT_MAX_STEPS * PlacementRules.LIFT_STEP_M + 0.5 if bool(def.get("foundation", false)) else 0.0)
					var slab: BoxShape3D = BoxShape3D.new()
					slab.size = Vector3(float(def.get("footprint_x", 4.0)), deep, float(def.get("footprint_z", 4.0)))
					_log_static(key, slab, Transform3D(Basis(Vector3.UP, deg_to_rad(float(other["struct"].get("yaw", 0.0)))), other["pos"] + Vector3(0.0, top - deep * 0.5, 0.0)))
			elif other.has("boulder") or other.has("tree"):
				# A boulder's key carries its stones left: a worked rock that has shrunk (BoulderWear) gets a new, smaller ball and trim_statics drops the old one.
				var static_key: String = "i%d:%d" % [sid, int(other["count"])] if other.has("boulder") else "i%d" % sid
				keep[static_key] = true

				if _logs.has_static(static_key):
					continue   # already in the space: no new shape

				if other.has("boulder"):
					var rock: Dictionary = other["boulder"]
					var rock_r: float = BoulderWear.radius_now(float(rock.get("radius", 0.5)), int(other["count"]), int(rock.get("total", 1)))
					var ball: SphereShape3D = SphereShape3D.new()
					ball.radius = rock_r
					_log_static(static_key, ball, Transform3D(Basis(), other["pos"] + Vector3(0.0, rock_r * 0.4, 0.0)))   # a boulder sits part in the soil
				else:
					_log_static("i%d" % sid, _log_post(float((other["tree"] as Dictionary).get("radius", 0.3)), STUMP_H_M), Transform3D(Basis(), other["pos"] + Vector3(0.0, STUMP_H_M * 0.5, 0.0)))

		# The standing trunks from the server's cached 16 m tree cells (terrain_server _arrow_trunks, felled trees left out). Asked through
		# trees_near and tree_info, every awake log scanned every tree of the nine 256 m flora chunks round it (and could place a chunk) on the
		# main thread every look_s: the server stalled, its physics with it, and every log paused at once (Dave 17 Nov 2026, build 826:
		# "they roll a few feet then pause and they all do it at the same time").
		if trunks_near.is_valid():
			for trunk in trunks_near.call(at, reach):
				var root: Vector3 = trunk[0]
				var key: String = "t%d:%d" % [int(round(root.x * 100.0)), int(round(root.z * 100.0))]
				keep[key] = true

				if not _logs.has_static(key):
					_log_static(key, _log_post(float(trunk[1]), TRUNK_H_M), Transform3D(Basis(), root + Vector3(0.0, TRUNK_H_M * 0.5, 0.0)))

		for rect in _grid.rects_near(at.x, at.z, reach, _items):
			var key: String = "w%d" % int(rect["id"])
			keep[key] = true

			if _logs.has_static(key):
				continue

			var wall: BoxShape3D = BoxShape3D.new()
			wall.size = Vector3(float(rect["hx"]) * 2.0, WALL_H_M, float(rect["hz"]) * 2.0)
			var base: Vector3 = _items[int(rect["id"])]["pos"]
			_log_static(key, wall, Transform3D(Basis(Vector3.UP, atan2(float(rect["sin"]), float(rect["cos"]))), base + Vector3(0.0, WALL_H_M * 0.5, 0.0)))

	# Asleep and nothing awake near: out of the space (its pose stays in the record).
	var circles: Array = []

	for id in _logs.ids():
		var here: Vector3 = _logs.pose(id).origin

		if _logs.asleep(id) and not awake.any(func(a): return Vector2(a.x - here.x, a.z - here.z).length() <= reach * 1.5):
			_logs.remove(id)
			_log_quiet.erase(id)
		else:
			circles.append([here, float(cfg.get("half_len_m", LyingLogsScript.LOG_HALF_M)) + 1.0])

	for at in awake:
		circles.append([at, reach])

	_logs.trim_statics(keep)
	_logs.trim_ground(circles)


const STUMP_H_M := 0.8    # a stump's height in the log space
const TRUNK_H_M := 8.0    # a standing trunk's height there (a log never climbs higher)
const WALL_H_M := 3.0     # a wall's height there


func _log_static(key: String, shape: Shape3D, xf: Transform3D, lying: bool = false) -> void:
	if not _logs.has_static(key):
		_logs.add_static(key, shape, xf, lying)


func _log_capsule(r: float) -> Shape3D:
	var shape: CapsuleShape3D = CapsuleShape3D.new()   # standing on y; laid along the log's x by the lying static (log_physics._lying)
	shape.radius = r
	shape.height = LyingLogsScript.LOG_HALF_M * 2.0
	return shape


func _log_post(r: float, height: float) -> Shape3D:
	var shape: CylinderShape3D = CylinderShape3D.new()
	shape.radius = maxf(r, 0.05)
	shape.height = height
	return shape


func _roll_tick(delta: float) -> void:
	if _logs.count() == 0 and _roll_moved.is_empty():
		return

	var cfg: Dictionary = _drops.get("rolling", {})
	_roll_look_in -= delta

	if _roll_look_in <= 0.0:
		_roll_look_in = float(cfg.get("look_s", 0.25))
		_log_surround()

	var still: float = float(cfg.get("still_mps", 0.15))
	var ready: Array = []   # still long enough to sleep
	var busy: Array = []    # where the awake logs not yet still are

	for id in _logs.ids():
		var it: Dictionary = _items.get(id, {})

		if not _free_log(it):
			_logs.remove(id)
			_log_quiet.erase(id)
			continue

		if _logs.asleep(id):
			continue

		var xf: Transform3D = _logs.pose(id)
		var r: float = _logs.radius(id)
		var ground: float = float(ground_height.call(xf.origin.x, xf.origin.z)) if ground_height.is_valid() else NAN

		if is_nan(ground):
			_logs.sleep(id)   # the edge of the world: it stops there
			continue

		if xf.origin.y < ground + r * 0.5:   # never in the ground (a seam of the ground copy or a hard knock): back on it
			xf.origin.y = ground + r
			_logs.set_pose(id, xf)
			var v_up: Vector3 = _logs.velocity(id)
			_logs.set_velocity(id, Vector3(v_up.x, maxf(v_up.y, 0.0), v_up.z))

		if water_depth_at.is_valid() and float(water_depth_at.call(xf.origin - Vector3(0.0, r, 0.0))) > float(cfg.get("water_m", 0.05)):
			_logs.sleep(id)   # the shore: it stops at the water
		else:
			_log_resist(id, xf, r, cfg, delta)

			var v: Vector3 = _logs.velocity(id)

			if v.length() < still and _logs.spin_rate(id).length() < still / maxf(r, 0.05):
				_log_quiet[id] = float(_log_quiet.get(id, 0.0)) + delta

				if float(_log_quiet[id]) >= float(cfg.get("still_s", 0.4)) * (4.0 if _log_must_roll(xf, cfg) else 1.0):   # on ground steeper than it holds it is given longer to start rolling (pinned against a rock it still sleeps)
					ready.append(id)
				else:
					busy.append(xf.origin)
			else:
				_log_quiet.erase(id)
				busy.append(xf.origin)

		var angles: Vector3 = LyingLogsScript.angles_of(xf.basis)
		it["pos"] = xf.origin - Vector3(0.0, r, 0.0)
		it["rot_y"] = angles.x
		it["pitch"] = angles.y
		it["spin"] = angles.z
		_roll_moved[id] = true
		_dirty = true

	# A still log sleeps only when no log touching it, or near enough to, is still moving: logs resting on each other go to sleep together (put to
	# sleep one by one, the engine woke each again from the one still awake against it; a lane run on a4bc0254).
	var touch: float = float(cfg.get("half_len_m", LyingLogsScript.LOG_HALF_M)) * 2.0 + 0.5

	for id in ready:
		var here: Vector3 = _logs.pose(id).origin

		if not busy.any(func(b): return b.distance_to(here) <= touch):
			_logs.sleep(id)
			_log_quiet.erase(id)

	_roll_send_in -= delta

	if _roll_send_in <= 0.0 and not _roll_moved.is_empty():
		_roll_send_in = float(cfg.get("send_s", 0.1))
		_roll_send()


# The ground holding a log back: rolling resistance, a torque against its roll of rolling.resist (by the ground's material) x its weight x its radius,
# given to the engine as a spin impulse so its own contact solve turns it into the log's motion. A log at rest on ground across it gentler than
# that is held (the torque matches gravity's, never more); on steeper ground it rolls, gaining (2/3) g (slope - resist); a rolling log on flatter
# ground slows to a stop and never rolls back from it. A walker pushing an oak (22 kg) at 100 N moves it on the flat and is held by a hill of
# about 0.27; at 170 N they push it up that hill. A lane run on a4bc0254: overwriting its speed and spin each tick instead kept a log on a 0.5 hill
# from rolling at all; one on ae19daa6: slowing its spin alone, a third as hard, let a walker push an oak up a 0.27 hill.
func _log_resist(id: int, xf: Transform3D, r: float, cfg: Dictionary, delta: float) -> void:
	var at: Vector3 = xf.origin
	var ground: float = float(ground_height.call(at.x, at.z))

	if is_nan(ground) or at.y - r - ground > LOG_RESIST_OFF_M:
		return   # in the air (falling, or lying on other logs): the ground holds nothing back

	var axis: Vector3 = xf.basis.x.normalized()
	var flat: Vector3 = Vector3(axis.x, 0.0, axis.z).normalized() if Vector2(axis.x, axis.z).length() > 0.01 else Vector3.RIGHT
	var east: float = float(ground_height.call(at.x + 0.5, at.z)) - float(ground_height.call(at.x - 0.5, at.z))
	var south: float = float(ground_height.call(at.x, at.z + 0.5)) - float(ground_height.call(at.x, at.z - 0.5))
	var downhill: Vector3 = Vector3(-east, 0.0, -south) if not is_nan(east) and not is_nan(south) else Vector3.ZERO
	downhill -= flat * downhill.dot(flat)   # the fall of the ground across the log: what rolls it
	var slope: float = downhill.length()
	var v: Vector3 = _logs.velocity(id)
	var across: Vector3 = Vector3(v.x, 0.0, v.z) - flat * v.dot(flat)
	var speed: float = across.length()
	var way: Vector3 = across / speed if speed > 0.02 else (downhill / slope if slope > 0.001 else Vector3.ZERO)

	if way == Vector3.ZERO:
		return

	var kg: float = _logs.mass(id)
	var dt: float = minf(delta, 2.0 / float(Engine.physics_ticks_per_second))   # a server hitch never gives one huge impulse (more than the contact can take in one step)
	var hold: float = _log_hold(at, cfg) * kg * 9.8 * r * dt                       # the most the ground holds back this tick (N m s)
	var stop: float = 1.5 * kg * r * speed + kg * 9.8 * r * maxf(downhill.dot(way), 0.0) * dt   # what stops it rolling this way, with what gravity adds this tick
	var roll_dir: Vector3 = Vector3.UP.cross(way)                                  # its spin rolling along `way`
	_logs.spin_push(id, -axis * signf(roll_dir.dot(axis)) * minf(hold, stop))


# rolling.resist by the ground's material at a point: the slope a log at rest stays on.
func _log_hold(at: Vector3, cfg: Dictionary) -> float:
	var resist: Dictionary = cfg.get("resist", {})
	var hold: float = float(resist.get("default", 0.3))

	if ground_material.is_valid():
		hold = float(resist.get(str(ground_material.call(at.x, at.z)), hold))

	return hold


# True when the ground across the log (perpendicular to its long axis, 0.5 m either side) is steeper than it holds a log on: it should roll on, so
# it is given longer before it is put to sleep there (_roll_tick).
func _log_must_roll(xf: Transform3D, cfg: Dictionary) -> bool:
	var axis: Vector3 = xf.basis.x
	var across: Vector2 = Vector2(-axis.z, axis.x).normalized() * 0.5
	var up: float = float(ground_height.call(xf.origin.x + across.x, xf.origin.z + across.y))
	var down: float = float(ground_height.call(xf.origin.x - across.x, xf.origin.z - across.y))
	return not is_nan(up) and not is_nan(down) and absf(up - down) / (2.0 * across.length()) > _log_hold(xf.origin, cfg) + 0.02


const LOG_RESIST_OFF_M := 0.15   # an underside this far over the server ground is not held back by it


# A walker pushing a log (ACT_PUSH_LOG, protocol 125; Dave 16 Nov 2026: "the log will stop me but I should be able to push against it. it might stop me
# going up hill but I should be able to roll it on the flat or downhill. and sprinting should push harder"; "if you 1/4 into the log it will turn and push").
# `at` is where the walker touches it, heading the level direction into it (degrees, atan2 of z over x), share how square they walk into it (0 to 1).
# The push is rolling.push walk_n or sprint_n newtons for push_s seconds at that point, so a push off the middle turns the log too; none once the
# log moves away faster than the walker can follow (walk_mps, sprint_mps). Gravity does the rest: a hill steep enough holds a walker's push.
func _push_log(peer: int, id: int, sprint: bool, heading_deg: float, share: float, at: Vector3) -> void:
	var push: Dictionary = _drops.get("rolling", {}).get("push", {})
	var it: Dictionary = _items.get(id, {})

	if not _free_log(it) or not _peer_pos.has(peer) or (_peer_pos[peer] as Vector3).distance_to(at) > float(push.get("reach_m", 2.5)):
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_push_last.get(peer, -100000)) < int(float(push.get("push_s", 0.1)) * 500.0):
		return   # faster than a client sends them: not counted

	var centre: Vector3 = it["pos"] + Vector3(0.0, _log_r(it), 0.0)

	if centre.distance_to(at) > float(_drops.get("rolling", {}).get("half_len_m", LyingLogsScript.LOG_HALF_M)) + 1.0 or not _wake_log(id):
		return

	_push_last[peer] = now
	var dir: Vector3 = Vector3(cos(deg_to_rad(heading_deg)), 0.0, sin(deg_to_rad(heading_deg)))
	var cap: float = float(push.get("sprint_mps" if sprint else "walk_mps", 2.5))

	if _logs.velocity(id).dot(dir) >= cap:
		return

	var force: float = float(push.get("sprint_n" if sprint else "walk_n", 100.0)) * clampf(share, 0.0, 1.0)
	var xf: Transform3D = _logs.pose(id)
	_logs.push(id, dir * force * float(push.get("push_s", 0.1)), Vector3(at.x, xf.origin.y, at.z))   # level with its middle: it rolls, it is not pressed into the ground
	_log_quiet.erase(id)


# Tells the players who know each log that moved where it is now and how it lies. A log that settled is in the last of these.
func _roll_send() -> void:
	var moved: Array = _roll_moved.keys().filter(func(id): return _items.has(id))
	_roll_moved.clear()

	if moved.is_empty() or not send_logs_moved.is_valid():
		return

	for peer in _known:
		var ids: PackedInt32Array = PackedInt32Array()
		var at: PackedVector3Array = PackedVector3Array()
		var poses: PackedVector3Array = PackedVector3Array()

		for id in moved:
			if (_known[peer] as Dictionary).has(id):
				ids.append(id)
				at.append(_items[id]["pos"])
				poses.append(Vector3(float(_items[id].get("rot_y", 0.0)), float(_items[id].get("pitch", 0.0)), float(_items[id].get("spin", 0.0))))

		if not ids.is_empty():
			send_logs_moved.call(peer, ids, at, poses)


# A thrown weapon lands as a pickup, unless the throw broke a disposable one (the Javelin): that one is gone (master s2.2 rule 2).
func _land_thrown(flight: Dictionary, at: Vector3) -> void:
	var entry: Dictionary = table.entry(table.id_of(int(flight["number"])))
	var most: int = SmithingRules.max_of(entry, flight.get("inst", {}))

	if SmithingRules.disposable(entry) and int(flight.get("wear", 0)) >= most:
		if flight.has("peer"):
			_say(int(flight["peer"]), "Your %s broke and is gone." % table.sentence_name(int(flight["number"])))

		return

	drop_in_world(int(flight["number"]), 1, at, int(flight.get("wear", 0)), 0.0, NAN, NAN, "", flight.get("inst", {}))


# The stone axe used as a pick (Dave: no stone pickaxe): a blow on bare rock gives a stone. The
# server checks the axe, the reach, the pace and that rock really shows there, and each 8 m patch
# of outcrop gives only a few stones before it needs time to recover. No ground is dug.
# One shovel dig (ACT_DIG): needs a whole shovel in the pack and the point within reach; paced like mining.
func _dig(peer: int, inv, at: Vector3, held_slot: int) -> void:
	if not _peer_pos.has(peer) or not dig_ground.is_valid():
		return

	if _peer_pos[peer].distance_to(at) > DIG_REACH_M:
		_reject_far(peer)
		return

	var shovel: int = _swing_tool(peer, inv, held_slot, "shovel")

	if shovel < 0:
		_reject_tool(peer, "a shovel")
		return

	var now: int = Time.get_ticks_msec()
	var reach: float = _shovel_reach(inv, shovel)

	if float(now - int(_last_dig.get(peer, -100000))) < float(DIG_COOLDOWN_MS) * reach:
		return

	_last_dig[peer] = now   # a refused dig waits out the stroke too (no notice and look-up per packet)
	var standing: String = _edit_blocker(at - Vector3(0.0, DIG_DEPTH_M, 0.0), DIG_RADIUS_M * reach, false)

	if standing != "":
		_say(peer, "%s stands on that ground: take it up before you dig under it." % standing)
		return

	for n in maxi(1, int(round(reach))):
		_wear_slot(peer, inv, shovel, "dig")

	var dug: Variant = dig_ground.call(at - Vector3(0.0, DIG_DEPTH_M, 0.0), DIG_RADIUS_M * reach)

	# The ground answers false when the dig changed nothing (a block is full, or the hole was already there): no yield, no fall.
	if typeof(dug) == TYPE_BOOL and not bool(dug):
		if dig_refusal.is_valid():
			_say(peer, str(dig_refusal.call()))

		return

	_give_dig_yield(peer, at, _shovel_tier(inv, shovel), _shovel_pieces(inv, shovel))
	_open_pockets(peer, at, DIG_RADIUS_M * reach)
	_note_bog_hole(at, DIG_RADIUS_M * reach)

	# A dig more than 2.5 m under the surface is a tunnel or a cave: the "cave_in" hint (hints.json digging_under_ceiling) warns about roof supports.
	if ground_height.is_valid() and float(ground_height.call(at.x, at.z)) - at.y > 2.5:
		_goal_event(peer, "dug_under")

	_fell_undermined(peer, at)
	_break_undermined_stumps(at)
	settle_loose_near(at, DIG_RADIUS_M * reach + DIG_DEPTH_M)
	_dirty = true


# One shovel fill (ACT_FILL, saved edits step 3): a sphere of ground added at the point struck, using up one shovelful
# from the pack (digging.json "fill", soil first). Same reach, shovel and pace as a dig; a fill that changes nothing
# hands the shovelful back.
const FILL_RADIUS_M := 0.9
const FILL_UP_M := 0.1         # the fill is centred this far above the point struck (it heaps a little)
const FILL_SOIL := {"soil": 5, "sand": 1, "gravel": 2, "clay": 4, "stone": 9}   # the ground material each fill item makes (data/tables/soils.json ids)


func _fill(peer: int, inv, at: Vector3, held_slot: int) -> void:
	if not _peer_pos.has(peer) or not fill_ground.is_valid():
		return

	if _peer_pos[peer].distance_to(at) > DIG_REACH_M:
		_reject_far(peer)
		return

	var shovel: int = _swing_tool(peer, inv, held_slot, "shovel")

	if shovel < 0:
		_reject_tool(peer, "a shovel")
		return

	var now: int = Time.get_ticks_msec()

	if float(now - int(_last_dig.get(peer, -100000))) < float(DIG_COOLDOWN_MS) * _shovel_reach(inv, shovel):
		return

	# Raise mode (Dave 2026-10-22): no load, every raise takes shovelfuls from the pack (one for a small shovel, 4 medium, 8 large),
	# soil first, then sand, gravel, clay, stone (digging.json "fill"). A short pack raises a smaller heap.
	var material_item: String = ""

	for name in _dig_cfg.get("fill", []):
		var number: int = table.number_of(str(name))

		if number > 0 and inv.count_of(number) > 0:
			material_item = str(name)
			break

	if material_item == "":
		_say(peer, "Nothing to fill with: dig some soil, sand or gravel first")
		return

	var heap_r: float = FILL_RADIUS_M * pow(float(mini(_shovel_pieces(inv, shovel), inv.count_of(table.number_of(material_item)))), 1.0 / 3.0)   # the largest heap this fill can make
	_last_dig[peer] = now
	var buried: String = _edit_blocker(at + Vector3(0.0, FILL_UP_M, 0.0), maxf(heap_r, FILL_RADIUS_M), true)

	if buried != "":
		_say(peer, "%s stands there: the fill would bury it." % buried)
		return
	var pieces: int = 0

	for n in _shovel_pieces(inv, shovel):
		if take_fill_item(peer, material_item) < 1:
			break

		pieces += 1

	if pieces < 1:
		return

	for n in maxi(1, int(round(pow(float(pieces), 1.0 / 3.0)))):
		_wear_slot(peer, inv, shovel, "dig")

	var done: Variant = fill_ground.call(at + Vector3(0.0, FILL_UP_M, 0.0), FILL_RADIUS_M * pow(float(pieces), 1.0 / 3.0), int(FILL_SOIL.get(material_item, 5)))

	if typeof(done) == TYPE_BOOL and not bool(done):
		var was_src: String = _gain_source
		_gain_source = SRC_RETURN
		give(peer, table.number_of(material_item), pieces)   # the ground refused it: the shovelfuls come back
		_gain_source = was_src
	else:
		settle_loose_near(at + Vector3(0.0, FILL_UP_M, 0.0), FILL_RADIUS_M * pow(float(pieces), 1.0 / 3.0), true)   # stacks, remains and young plants under the heap come up onto it

	_dirty = true


# --- The garden hoe (Dave 2026-10-22, items/HOE_AND_SHOVEL_DESIGN.md) ---
# Path: one stroke treads the metre of ground under the crosshair: a path patch (state 32) clears the grass and draws flat tan; the height does
# not change. Smooth (the levelling stroke, _hoe_smooth): the ground within SMOOTH_REACH_M of the point is cut or filled toward the height the player
# stands at. Raising ground uses up Soil and cutting ground gives Soil back at the same rate (_level_soil_units), so levelling neither makes nor
# loses soil (BugsList entry 1); Pathen and the garden jobs level to the ground's own average and move no items.
const HOE_COOLDOWN_MS := 500
# Levelling (Dave 14 Nov 2026: "its to small an area and its too week"; "make the ground level with where you are standing and if you are standing on say a
# foundation it make the ground just a little bit below your feet so it stays below the top of the foundation", the Valheim feel). PROVISIONAL values for Dave
# to tune. Before: 5 spots (the point and 1 m each way), toward their own average, at most 0.25 m a spot a stroke, 0.9 m spheres.
const SMOOTH_REACH_M := 3.0       # the spots of a 1 m grid within this of the point (29 spots over a 6 m circle) are levelled
const LEVEL_MAX_M := 0.5          # at most this much cut or filled at a spot by one edit
const LEVEL_MIN_M := 0.05         # a spot this close to the target height counts as level
const LEVEL_SPHERE_M := 2.5       # the cut and fill spheres: on a 1 m grid the ground between spots is within about 0.1 m of level
const LEVEL_MAX_OPS := 4          # at most this many ground edits a stroke (every edit is a message to every client and a remesh; a path averages 4 per 1.5 s)
const LEVEL_ON_PIECE_M := 0.2     # feet this far above the ground under them, over a built piece, stand on it (a foundation, a floor)...
const LEVEL_BELOW_PIECE_M := 0.1  # ...and the ground is levelled this far below the feet, so the soil stays under the top of the piece
# Level (BugsList_Current.md entry 1, Dave 18 Nov 2026): the target is the bottom of the feet when the action starts, kept for the whole held action, so ground the
# action raises never becomes a higher target; the ground the player stands on is never edited; raising ground uses up soil. PROVISIONAL values (LV-1..LV-3).
const LEVEL_HOLD_MS := 1500       # LV-1: a stroke this soon after the last one, with the feet still within LEVEL_HOLD_MOVE_M, belongs to the same held action
const LEVEL_HOLD_MOVE_M := 0.6
const LEVEL_KEEP_M := 1.2         # LV-2: no levelling spot this close (flat) to the feet: the ground holding the player up stays as it is
const SOIL_FILL_M3 := 0.75        # LV-3: one Soil fills this much ground (a shovel dig of about 1.5 m3 gives two, digging.json)
# LV-4 (BugsList entry 1, Dave play test 19 Nov 2026: "if I am leveling and it has to cut down the soil it should give me back the soil its removing"):
# a cut gives Soil at the fill's rate, whatever the ground was; what the pack cannot take drops at the player's feet (give), where the next fill can use it.
var _level_hold: Dictionary = {}  # peer -> [target height, msec of the last stroke, the feet then]
const GRADE_CLEAR_M := 2.5        # a grade stroke takes up the path patches this close to it (the ground under them moved)
const SMOOTH_MAX_M := 0.25
const SMOOTH_MIN_M := 0.04
const SMOOTH_SPHERE_M := 0.9
const GRADE_REACH_M := 12.0       # a grade stroke works within this of point A (Dave 2026-10-22)
const GRADE_WIDTH_M := 1.5        # and within this of the straight line A to B


# The hoe in hand for a stroke at `at` (-1: refused, out of reach, not a hoe in hand, or too soon after the last stroke).
func _hoe_ready(peer: int, inv, at: Vector3, held_slot: int) -> int:
	if not _peer_pos.has(peer):
		return -1

	if _peer_pos[peer].distance_to(at) > DIG_REACH_M:
		_reject_far(peer)
		return -1

	var hoe: int = _swing_tool(peer, inv, held_slot, "hoe")

	if hoe < 0:
		_reject_tool(peer, "a hoe")
		return -1

	var now: int = Time.get_ticks_msec()

	if now - int(_last_dig.get(peer, -100000)) < HOE_COOLDOWN_MS:
		return -1

	_last_dig[peer] = now
	return hoe


# The hoe's items.json till_speed (Wooden 1 to Steel 2.5; tier consistency, coordinator 23 Nov 2026: every hoe tilled a garden at one pace, so a
# better one gave nothing but durability): a garden job does this many times the ground edits and beds each step. A single stroke keeps
# HOE_COOLDOWN_MS (the client's hold repeat, held_item.gd HOE_REPEAT_S, is paced to it).
func _hoe_speed(inv, slot: int) -> float:
	return maxf(float(table.entry(table.id_of(inv.numbers[slot])).get("till_speed", 1.0)), 0.1) if slot >= 0 else 1.0


# Pathen (Dave 2 Nov 2026; one level spot a click, 18 Nov 2026): the click levels the ground under the spot to its own average (_hoe_path), then lays a round
# trodden patch exactly where the player pointed (not snapped to a grid). The client draws it strong brown for the middle half metre and fading to see-through by
# 1.25 m. Patches stay PATH_SPACING_M apart; patches laid before within PATH_AVERAGE_M + 1.25 m are laid again on ground the click moved.
const PATH_AVERAGE_M := 2.0
const PATH_AVERAGE_MIN_M := 0.08    # ground within a path's reach that is flatter than this is left alone (no edit, no remesh)
const PATH_LEVEL_REACH_M := 0.75   # Pathen: the ring round the patch's middle that is levelled with it (the strong brown is 1 m across)
const PATH_LEVEL_OPS := 6          # PROVISIONAL PA-1: at most this many ground edits a click (every edit is a message to every client, a remesh and a grass rebuild)
const PATH_SPACING_M := 0.7   # the strong middle is 1 m across, so patches this far apart still join; fewer patches means fewer decals along a road

const PATH_BOULDER_MARGIN_M := 1.0   # a path patch is laid no nearer a boulder's edge than this: its brown fades out to 1.25 m, so the path goes round a rock instead of painting on it (Dave 3 Nov)


# Trees and paths (Dave's play test 24 Nov 2026: a standing Beech in the middle of a path another player had trodden; "expected it to be a clear path"):
# a path is never laid on a standing tree, and a tree never grows on a path. A patch is not laid with its strong middle on a standing trunk (placer
# trees, and planted trees grown full; the player fells it first, as a rock is walked round), and the saplings and young trees it is laid over are
# trodden out (they cannot be felled yet). A seed is not planted on a path (_sapling_refusal), and no wild sapling comes within no_spawn_m of one.
const PATH_TREE_MARGIN_M := 0.5      # the patch's strong middle (1 m across) stays off the trunk's edge
const PATH_TRAMPLE_M := 1.25         # a sapling or young tree this close (flat) to a new patch is trodden out: the patch's whole brown reaches this far
const PLANT_PATH_GAP_M := 1.25       # nothing is planted this close (flat) to a path patch


# The name of the standing tree a path patch at `spot` would be laid on, or "" when there is none. Trees from made chunks only (trees_near): the
# player stands at the patch, so its chunk is made.
func _path_tree(spot: Vector3) -> String:
	if trees_near.is_valid() and tree_info.is_valid():
		for found in trees_near.call(spot, 3.0):
			var info: Dictionary = tree_info.call(found[0], int(found[1]))

			if not info.is_empty() and Vector2(info["position"].x - spot.x, info["position"].z - spot.z).length() < _felled_radius(info) + PATH_TREE_MARGIN_M:
				return str(info["name"])

	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for sapling in _saplings:
		if now_s - float(sapling["planted_at"]) >= SAPLING_GROWN_S and Vector2(sapling["pos"].x - spot.x, sapling["pos"].z - spot.z).length() < 0.4 + PATH_TREE_MARGIN_M:
			return str(_flora_by_id.get(int(sapling["species"]), {}).get("name", "tree"))

	return ""


# Treads out the saplings and young trees (not yet grown full) within PATH_TRAMPLE_M of a new path patch, so none grows into a tree on the path.
func _trample_saplings(spot: Vector3) -> void:
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	var gone: Array = []

	for sapling in _saplings:
		if now_s - float(sapling["planted_at"]) < SAPLING_GROWN_S and Vector2(sapling["pos"].x - spot.x, sapling["pos"].z - spot.z).length() < PATH_TRAMPLE_M:
			gone.append([Vector2i(int(sapling["chunk"][0]), int(sapling["chunk"][1])), (int(sapling["species"]) << 16) | (0xFFFF - int(sapling["slot"]))])

	for row in gone:
		if not (cut_tree.is_valid() and bool(cut_tree.call(row[0], int(row[1])))):
			remove_dynamic(row[0], int(row[1]))   # no server scene (tests): the list alone


func _path_blocked_by_boulder(other: Dictionary, spot: Vector3) -> bool:
	if not other.has("boulder"):
		return false

	return Vector2(other["pos"].x - spot.x, other["pos"].z - spot.z).length() < float((other["boulder"] as Dictionary).get("radius", 0.5)) + PATH_BOULDER_MARGIN_M


func _hoe_path(peer: int, inv, at: Vector3, held_slot: int) -> void:
	if not ground_height.is_valid() or not _structures.has("path_patch"):
		return

	var hoe: int = _hoe_ready(peer, inv, at, held_slot)

	if hoe < 0:
		return

	var ground: float = float(ground_height.call(at.x, at.z))

	if is_nan(ground):
		return

	var spot: Vector3 = Vector3(at.x, ground + 0.02, at.z)

	if water_depth_at.is_valid() and float(water_depth_at.call(Vector3(spot.x, ground, spot.z))) > 0.05:
		_say(peer, "You cannot tread a path in water.")
		return

	var near_paths: Array = []   # no cap on path patches (Dave 17 Nov 2026: "It really doesnt need a limit for paths")

	for id in _items:
		var other: Dictionary = _items[id]

		if _path_blocked_by_boulder(other, spot):
			_say(peer, "A rock is in the way: tread the path round it.")
			return

		if not other.has("struct"):
			continue

		if str(other["struct"]["kind"]) == "path_patch":
			var flat: float = Vector2(other["pos"].x - spot.x, other["pos"].z - spot.z).length()

			if flat < PATH_SPACING_M:
				return   # already trodden here

			if flat <= PATH_AVERAGE_M + 1.25:
				near_paths.append(id)
		elif other["pos"].distance_to(spot) < 1.0 and not bool(_structures.get(str(other["struct"]["kind"]), {}).get("walkover", false)):
			_say(peer, "Something stands there.")
			return

	var tree: String = _path_tree(spot)

	if tree != "":
		_say(peer, "A %s stands there: clear it first, or tread the path round it." % tree.to_lower())
		return

	_trample_saplings(spot)

	# Pathen (BugsList entry 5, Dave 18 Nov 2026): "one click makes one level path spot": the ground under the patch is levelled to its own average in the one
	# click (PATH_LEVEL_OPS small cuts and fills, read through the saved edits), then the patch is laid on it.
	var edits: Array = (edits_near.call(at, PATH_LEVEL_REACH_M + SMOOTH_SPHERE_M + 1.0) if edits_near.is_valid() else []) as Array
	var spots: Array = [Vector2.ZERO]
	var radii: Array = [SMOOTH_SPHERE_M]
	var mean: float = _edited_height(at.x, at.z, edits)

	for k in 8:
		var offset: Vector2 = Vector2.from_angle(float(k) * TAU / 8.0) * PATH_LEVEL_REACH_M
		spots.append(offset)
		radii.append(SMOOTH_SPHERE_M)
		mean += _edited_height(at.x + offset.x, at.z + offset.y, edits)

	mean /= float(spots.size())
	var moved: bool = not is_nan(mean) and dig_ground.is_valid() and fill_ground.is_valid() and _level_ground(at, spots, mean, edits, [], radii, Callable(), PATH_LEVEL_OPS) > 0
	_wear_slot(peer, inv, hoe, "dig")

	if moved:
		# The ground under the patches laid before has moved: they are laid again on the new surface (new ids, so the clients redraw them).
		for id in near_paths:
			var old: Dictionary = _items[id]
			var old_ground: float = _edited_height(old["pos"].x, old["pos"].z, edits)

			if not is_nan(old_ground) and absf(old_ground + 0.02 - old["pos"].y) > 0.03:
				_items.erase(id)
				_items[_next_id] = {"number": old["number"], "count": 1, "pos": Vector3(old["pos"].x, old_ground + 0.02, old["pos"].z), "left": 1.0e9, "struct": {"kind": "path_patch", "yaw": 0.0}}
				_zone_add(_next_id)
				_next_id += 1

		var new_ground: float = _edited_height(at.x, at.z, edits)
		spot.y = (new_ground if not is_nan(new_ground) else ground) + 0.02

	_items[_next_id] = {"number": table.number_of("path_patch"), "count": 1, "pos": spot, "left": 1.0e9, "struct": {"kind": "path_patch", "yaw": 0.0}}
	_zone_add(_next_id)
	_next_id += 1
	_dirty = true
	_goal_event(peer, "path_laid")


func _hoe_smooth(peer: int, inv, at: Vector3, held_slot: int) -> void:
	if not ground_height.is_valid() or not dig_ground.is_valid() or not fill_ground.is_valid():
		return

	var hoe: int = _hoe_ready(peer, inv, at, held_slot)

	if hoe < 0:
		return

	var feet: Vector3 = _peer_pos[peer]
	var near: Array = edits_near.call(at, DIG_REACH_M + 1.5) if edits_near.is_valid() else []   # one scan of the edit log: the feet are within DIG_REACH_M of the point
	var target: float = _level_target(peer, feet, near)

	if is_nan(target):
		return

	var edits: Array = near.filter(func(op): return Vector2(op[1].x - at.x, op[1].z - at.z).length() < SMOOTH_REACH_M + float(op[2]))   # the edits over the circle, for the spot loops
	var spots: Array = []
	var reach: int = int(floor(SMOOTH_REACH_M))

	for i in range(-reach, reach + 1):
		for j in range(-reach, reach + 1):
			if float(i * i + j * j) <= SMOOTH_REACH_M * SMOOTH_REACH_M and Vector2(at.x + float(i) - feet.x, at.z + float(j) - feet.z).length() >= LEVEL_KEEP_M:
				spots.append(Vector2(float(i), float(j)))

	var before: Array = _snapshot(inv)
	var stock: Dictionary = _stock_of(peer)
	var soil: int = table.number_of("soil")
	var can_pay := func(depth: float, sphere: float) -> bool: return soil > 0 and _stock_have(inv, soil, stock, true) >= _level_soil_units(depth, sphere)
	var pay := func(depth: float, sphere: float) -> bool: return _stock_take(inv, soil, _level_soil_units(depth, sphere), stock, [], true) > 0
	var cut_soil: Array = [0]   # Soil the cuts of this stroke dug out, given once the stroke is done
	var gain := func(depth: float, sphere: float) -> void: cut_soil[0] += _level_soil_units(depth, sphere)

	var worked: int = _level_ground(at, spots, target, edits, [], [], pay, LEVEL_MAX_OPS, can_pay, gain)
	_send_changes(peer, inv, before)

	if int(cut_soil[0]) > 0 and soil > 0:
		give(peer, soil, int(cut_soil[0]))   # the pack first, the rest at the feet (LV-4)

	if worked < 0:
		return   # the ground there is not loaded

	if worked == 0:
		if _level_unpaid:
			_say(peer, "Not enough soil to raise the low ground: dig some, or carry it or leave it nearby.")
		elif _level_refused and dig_refusal.is_valid():
			_say(peer, str(dig_refusal.call()))
		elif _level_skipped:
			_say(peer, "Only ground under placed things is left: take them up to level it.")
		else:
			_say(peer, "The ground here is already level with where you stand.")

		return

	if _level_unpaid:
		_say(peer, "Out of soil: the high ground was cut, the low ground needs soil to fill.")

	_wear_slot(peer, inv, hoe, "dig")
	_remove_paths_near(at, SMOOTH_REACH_M + 1.0)
	_dirty = true


# The Soil a Level edit of `depth` with a sphere of radius `sphere` moves: the cap of the sphere above the ground (a fill) or below it (a cut) is the same
# shape, so a cut and a fill of the same depth move the same Soil (LV-3, LV-4).
static func _level_soil_units(depth: float, sphere: float) -> int:
	return maxi(1, ceili(PI * depth * depth * (3.0 * sphere - depth) / 3.0 / SOIL_FILL_M3))


# The height Level works toward (BugsList entry 1): the bottom of the feet when the action starts, kept while the button is held (strokes LEVEL_HOLD_MS apart,
# the feet within LEVEL_HOLD_MOVE_M), so ground raised by the action never lifts the target. Standing on the ground the feet are the ground under them; on a
# built piece a little below the feet. Feet above the ground with no piece under them (a jump, a log) use the ground under them. NAN where not loaded.
func _level_target(peer: int, feet: Vector3, near: Array) -> float:
	var now: int = Time.get_ticks_msec()
	var held: Array = _level_hold.get(peer, [])

	if held.size() == 3 and now - int(held[1]) <= LEVEL_HOLD_MS and Vector2(feet.x - held[2].x, feet.z - held[2].z).length() <= LEVEL_HOLD_MOVE_M:
		held[1] = now
		return float(held[0])

	var under: float = _edited_height(feet.x, feet.z, near)   # the ground as dug and filled under the feet

	if is_nan(under):
		return NAN

	var target: float = under

	if feet.y - under > LEVEL_ON_PIECE_M and _piece_under(feet):
		target = feet.y - LEVEL_BELOW_PIECE_M

	_level_hold[peer] = [target, now, feet]
	return target


# Whether a built piece (not a walk-over one) stands under these feet: its footprint holds them and its middle is no higher than they are.
func _piece_under(feet: Vector3) -> bool:
	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or (it["pos"] as Vector3).y > feet.y + 0.1:
			continue

		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

		if def.is_empty() or bool(def.get("walkover", false)) or _is_plot_kind(str(it["struct"]["kind"])):
			continue

		var half: float = maxf(float(def.get("footprint_x", 1.0)), float(def.get("footprint_z", 1.0))) * 0.5 + 0.3

		if Vector2(it["pos"].x - feet.x, it["pos"].z - feet.z).length() <= half:
			return true

	return false


# The ground height at a column with the saved edits laid over the generated surface, oldest first: a dig sphere the surface passes through lowers it to the
# sphere's bottom, a fill sphere that reaches the surface raises it to the sphere's top (a pocket under the surface or a blob in the air leaves it). NAN where not loaded.
func _edited_height(x: float, z: float, edits: Array, base: float = NAN) -> float:
	var surface: float = float(ground_height.call(x, z)) if is_nan(base) else base   # base: the ground before the edits, when it is not the generated surface (a cave floor)

	if is_nan(surface):
		return NAN

	for op in edits:
		var centre: Vector3 = op[1]
		var radius: float = float(op[2])
		var flat_sq: float = (centre.x - x) * (centre.x - x) + (centre.z - z) * (centre.z - z)

		if flat_sq >= radius * radius:
			continue

		var half: float = sqrt(radius * radius - flat_sq)

		if int(op[0]) == 0:
			if surface > centre.y - half and surface <= centre.y + half:
				surface = centre.y - half
		elif centre.y - half <= surface + 0.05 and centre.y + half > surface:
			surface = centre.y + half

	return surface


# Cuts or fills the ground toward `target` at the spots (offsets from `at`), at most `max_ops` edits, each time at the spot now farthest from level
# (heights read through the edits, the ones made in this stroke included, so strokes add up and every spot gets its turn), at most LEVEL_MAX_M an edit.
# Not volume balanced (the Valheim feel Dave asked for). `pay` (Level, BugsList entry 1), when given, is asked before every fill (depth, sphere) -> bool: a fill
# it refuses is not made and that spot is left for this stroke (_level_unpaid); `gain` (Level, entry 1) is told the (depth, sphere) of every cut made.
# Returns the edits made, -1 when a spot is not loaded.
var _level_refused: bool = false   # the last _level_ground stopped on a refused edit (a full block), not because the ground was level
var _level_unpaid: bool = false    # the last _level_ground left low ground unfilled for want of soil
var _level_skipped: bool = false   # the last _level_ground left a spot under a chest, fire or station as it was


# `targets` and `radii` (a garden: till_garden), when given, are each spot's own height and sphere size.
func _level_ground(at: Vector3, spots: Array, target: float, edits: Array, targets: Array = [], radii: Array = [], pay: Callable = Callable(), max_ops: int = LEVEL_MAX_OPS, can_pay: Callable = Callable(), gain: Callable = Callable()) -> int:
	var worked: int = 0
	var skip: Dictionary = {}   # spots whose fill was not paid for, this stroke
	var grid: Dictionary = _edit_buckets(edits) if spots.size() > 64 else {}   # a garden's hundreds of spots read only the edits near each
	_level_refused = false
	_level_unpaid = false
	_level_skipped = false

	while worked < max_ops:
		var best: Vector3 = Vector3.ZERO
		var best_n: int = -1
		var best_off: float = 0.0
		var best_excess: float = 0.0   # how far the worst spot is past its slack
		var sphere: float = LEVEL_SPHERE_M

		for n_spot in spots.size():
			if skip.has(n_spot):
				continue

			var offset: Vector2 = spots[n_spot]
			var h: float = _bucket_height(at.x + offset.x, at.z + offset.y, grid) if spots.size() > 64 else _edited_height(at.x + offset.x, at.z + offset.y, edits)

			if is_nan(h):
				return -1

			var want: float = float(targets[n_spot]) if not targets.is_empty() else target
			var radius: float = float(radii[n_spot]) if not radii.is_empty() else LEVEL_SPHERE_M
			var slack: float = LEVEL_MIN_M if radius >= LEVEL_SPHERE_M else GARDEN_FEATHER_SLACK_M   # smaller spheres (a garden's blend) are near enough sooner

			if absf(h - want) - slack > best_excess:
				best_excess = absf(h - want) - slack
				best_off = h - want
				best = Vector3(at.x + offset.x, h, at.z + offset.y)
				best_n = n_spot
				sphere = radius

		if best_excess <= 0.0:
			break

		var depth: float = minf(absf(best_off), LEVEL_MAX_M)

		var centre: Vector3 = Vector3(best.x, best.y - depth + sphere, best.z) if best_off > 0.0 else Vector3(best.x, best.y + depth - sphere, best.z)

		if _edit_blocker(centre, sphere, best_off < 0.0, false) != "":
			skip[best_n] = true   # a chest, fire or station stands there: the stroke leaves its ground and levels the rest (coordinator 23 Nov 2026)
			_level_skipped = true
			continue

		if best_off < 0.0 and can_pay.is_valid() and not bool(can_pay.call(depth, sphere)):
			skip[best_n] = true
			_level_unpaid = true
			continue

		var done: Variant = dig_ground.call(centre, sphere) if best_off > 0.0 else fill_ground.call(centre, sphere, int(FILL_SOIL["soil"]))

		if typeof(done) == TYPE_BOOL and not bool(done):
			_level_refused = true
			break   # the ground took no more (a full block, a refusal): the next stroke tries again

		if best_off < 0.0 and pay.is_valid():
			pay.call(depth, sphere)   # the soil is taken once the ground has taken the fill
		elif best_off > 0.0 and gain.is_valid():
			gain.call(depth, sphere)   # the soil cut away is counted once the ground has taken the cut

		edits.append([0 if best_off > 0.0 else 1, centre, sphere])
		worked += 1
		settle_loose_near(centre, sphere, best_off < 0.0)   # stacks, remains, patches and young plants follow the levelled ground (round 7)

		if spots.size() > 64:
			_bucket_add(grid, edits[-1])

	return worked


# The grade line (roads): point A, point B, then strokes along the line bring the ground toward the straight ramp between their heights.
# A survey marker is set where the player aims, as far as they can see the ground (SURVEY_REACH_M, the client's SURVEY_AIM_M and some slack for walking).
const SURVEY_REACH_M := 160.0


func _hoe_grade_point(peer: int, inv, which: int, at: Vector3, held_slot: int) -> void:
	if not ground_height.is_valid() or not _peer_pos.has(peer) or Vector2(_peer_pos[peer].x - at.x, _peer_pos[peer].z - at.z).length() > SURVEY_REACH_M or _swing_tool(peer, inv, held_slot, "hoe") < 0:
		return

	var h: float = float(ground_height.call(at.x, at.z))

	if is_nan(h):
		return

	var here: Vector3 = Vector3(at.x, h, at.z)
	var before: Array = _grade_points.get(peer, [null, null])
	_grade_points[peer] = [before[1] if before[1] != null else here, here]   # the last two markers, for the manual grade stroke
	_road_marker(peer, here, which == 1)


# The A and B road (Dave 2 Nov 2026): the moment point B is set, the ground along the line from A to B follows the ground, averaged in 3 m sections (no straight ramp)
# between the two heights and a path is laid along it, by itself. Worked a station at a time (one every ROAD_STEP_S, at most ROAD_EDITS ground edits each), so a road
# never freezes the game the way one big edit would; the hoe wears once every ROAD_WEAR_EVERY stations and the job stops if the hoe is gone.
# The pace is kept by the clock (Dave 18 Nov 2026: twice as fast, about 2.8 m/s, as a first try): a slow server moment is made up on the next ticks,
# at most ROAD_CATCHUP stations in one tick, so the road keeps a steady speed. PROVISIONAL (For Dave, SV-10 to SV-12).
# Any distance (Dave 17 Nov 2026: the old 40 m cap made a far marker start a new road). Straight through trees, stumps and rocks: a standing tree on the
# road is cleared (it drops beside the road in what chopping it gives, no fall: Dave 18 Nov 2026), a stump on it is broken up into what chopping it gives, left on the ground, and a rock is left standing for
# the player's tools; only a building stops a marker (SurveyLine). The road's patches keep the grass off 2 m either side of it (the client, "road").
const ROAD_STATION_M := 0.7   # PROVISIONAL (SV-10): with ROAD_STEP_S, the road's speed (0.7 m every 0.25 s = 2.8 m/s)
const ROAD_STEP_S := 0.25     # PROVISIONAL (SV-10): seconds a station (Dave 18 Nov 2026: double the old 0.5)
const ROAD_CATCHUP := 4       # PROVISIONAL (SV-11): stations one tick may build to make up time lost to a slow moment; more is let go
const ROAD_SYNC_S := 0.25     # PROVISIONAL (SV-12): while a road builds, its new pieces go out to the players near it this soon, not at the next once-a-second sync
var _road_fresh: Array = []    # world ids a road made since its last quick sync (_sync_world_items fresh)
var _road_near: Array = []     # where those stations were (only players near them are looked at)
var _road_sync_in: float = 0.0
const ROAD_EDITS := 3
const ROAD_WEAR_EVERY := 4
const ROAD_HALF_WIDTH_M := SurveyLine.HALF_WIDTH_M
const ROAD_DEPTH_M := 0.5
const ROAD_SECTION_M := 3.0   # the ground is averaged over sections this long along the line
const ROAD_FELLS := 2         # trees a station clears at most (each one's pieces go into the world at once): a road through thick forest clears as it goes, never all at once
const ROAD_TREE_REACH_M := 2.0   # trees whose root is this near the line are looked at (the road's half width and the thickest trunk)
const ROAD_CLEAR_M := 1.3     # PROVISIONAL (SV-6): the road's half width and a little: a cleared tree's pieces lie no nearer the middle line than this
var _roads: Dictionary = {}   # peer -> [jobs], built one after the other; the last takes the player's new markers. A job: {"head": where the road has got to, "last": the last marker set, "markers": [Vector3] waiting, in the order set, "built": true once a stretch has been taken up (a job that has not is still being surveyed), "seg": null or {"a", "b", "n": stations, "i": next station, "wait": seconds to the next one, "trees": its trees still to clear}}
var _road_last: Dictionary = {}   # peer -> the last marker of a road that has caught up: the next marker of the same survey carries on from it


# Surveyor mode (Dave 3 Nov 2026; the line, 17 Nov 2026): the player sets markers; the road builds from each to the next, in the order set, along the
# straight line the surveyor's green line showed. Markers belong to the player who set them (the peer id keys the jobs, so a builder never chases
# another player's markers). The first marker of a job is where the road starts; before its first stretch it is only being surveyed and waits for
# the next marker (BUG-007). A new survey started while a road is still building waits its turn behind it.
const ROAD_MAX_MARKERS := 24


func _marker_done(peer: int, at: Vector3) -> void:
	if send_marker_done.is_valid():
		send_marker_done.call(peer, at)


# Every road of this player stops and their waiting flags come down.
func _road_abandon(peer: int) -> void:
	for job in _roads.get(peer, []):
		_marker_done(peer, job["head"])

		if job["seg"] != null:
			_marker_done(peer, job["seg"]["b"])

		for marker in job["markers"]:
			_marker_done(peer, marker)

	_roads.erase(peer)


# True when a building (SurveyLine.is_building) stands in the road's way on the straight line from a to b.
func survey_blocked(a: Vector3, b: Vector3) -> bool:
	var a2: Vector2 = Vector2(a.x, a.z)
	var b2: Vector2 = Vector2(b.x, b.z)
	var lo: Vector2 = Vector2(minf(a.x, b.x), minf(a.z, b.z))
	var hi: Vector2 = Vector2(maxf(a.x, b.x), maxf(a.z, b.z))

	for id in _items:
		var it: Dictionary = _items[id]
		var foot: Vector2

		if it.has("struct"):
			var kind: String = str(it["struct"]["kind"])
			var def: Dictionary = _structures.get(kind, {})

			if not SurveyLine.is_building(kind, def):
				continue

			foot = Vector2(float(def.get("footprint_x", 1.0)), float(def.get("footprint_z", 1.0)))
		elif it.has("fire"):
			foot = Vector2(SurveyLine.FIRE_FOOT_M, SurveyLine.FIRE_FOOT_M)
		else:
			continue

		var reach: float = foot.length() * 0.5 + ROAD_HALF_WIDTH_M   # a quick box test first: most of the world is nowhere near the line

		if it["pos"].x < lo.x - reach or it["pos"].x > hi.x + reach or it["pos"].z < lo.y - reach or it["pos"].z > hi.y + reach:
			continue

		if SurveyLine.crosses(a2, b2, Vector2(it["pos"].x, it["pos"].z), float(it["struct"]["yaw"]) if it.has("struct") else 0.0, foot):
			return true

	return false


# chained: the client set this marker after another of the same survey (the road goes on from it, at any distance); false starts a road. A survey that has
# only its start marker is dropped for a marker that starts a road elsewhere (its flag comes down), so a lone start marker can always be walked away from.
func _road_marker(peer: int, here: Vector3, chained: bool) -> void:
	var jobs: Array = _roads.get(peer, [])

	if not chained:
		_road_last.erase(peer)
		var open: Dictionary = jobs.back() if not jobs.is_empty() else {}

		if not open.is_empty() and not open["built"] and open["markers"].is_empty():
			jobs.pop_back()   # a lone start marker, walked away from
			_marker_done(peer, open["head"])

		jobs.append({"head": here, "last": here, "markers": [], "built": false, "seg": null})
		_roads[peer] = jobs
		_say(peer, "Survey begun at this marker: set the next marker and the road builds toward it.")
		return

	var last: Vector3 = jobs.back()["last"] if not jobs.is_empty() else _road_last.get(peer, here)   # the road caught up: it carries on from its last marker

	if not jobs.is_empty() and jobs.back()["markers"].size() >= ROAD_MAX_MARKERS:
		_survey_refuse(peer, here, last, "Too many markers waiting: let the road catch up.")
		return

	if last != here and survey_blocked(last, here):
		_survey_refuse(peer, here, last, "A building is in the way: survey the road round it.")
		return

	if jobs.is_empty():
		jobs.append({"head": last, "last": last, "markers": [], "built": _road_last.has(peer), "seg": null})
		_roads[peer] = jobs
		_road_last.erase(peer)

		if last == here:   # with no survey known (a restart), this marker starts one
			_say(peer, "Survey begun at this marker: set the next marker and the road builds toward it.")
			return

	var job: Dictionary = jobs.back()

	job["markers"].append(here)
	job["last"] = here
	_say(peer, "Marker set: the road builds along the line, marker to marker." if job["built"] else "Marker set: the road builds toward it from the first marker.")


# A marker refused: its flag comes down, the player is told why, and their line goes back to the survey's last kept marker.
func _survey_refuse(peer: int, here: Vector3, last: Vector3, why: String) -> void:
	_say(peer, why)
	_marker_done(peer, here)

	if send_survey_refused.is_valid():
		send_survey_refused.call(peer, last)


# Takes the next marker, in the order set, as the next stretch; returns false when no markers are left.
func _road_next_segment(peer: int, job: Dictionary) -> bool:
	while not job["markers"].is_empty():
		var head: Vector3 = job["head"]
		var target: Vector3 = job["markers"].pop_front()

		if Vector2(target.x - head.x, target.z - head.z).length() < 1.0:
			job["head"] = target
			_marker_done(peer, target)
			continue

		job["seg"] = {"a": head, "b": target, "n": int(ceil(Vector2(target.x - head.x, target.z - head.z).length() / ROAD_STATION_M)) + 1, "i": 0, "wait": 0.0}
		job["built"] = true
		return true

	return false


# One road at a time per player (the first of their jobs), a station every ROAD_STEP_S.
func _road_tick(delta: float) -> void:
	if _roads.is_empty():
		return

	for peer in _roads.keys():
		var jobs: Array = _roads[peer]
		var job: Dictionary = jobs[0]
		var inv = inventory_of(peer)

		if inv == null or not _has_tool(inv, "hoe") or not ground_height.is_valid():
			_road_abandon(peer)   # the hoe is gone: the roads stop and the waiting flags come down
			continue

		if job["seg"] == null and not _road_next_segment(peer, job):
			if not job["built"]:
				continue   # only the start marker so far: still being surveyed, there is no road to finish (BUG-007)

			if jobs.size() > 1:
				jobs.pop_front()   # done: the next survey's road builds now
				_marker_done(peer, job["head"])
				continue

			_roads.erase(peer)   # a road was built and no markers are left: the road has caught up
			_road_last[peer] = job["last"]   # the next marker of the same survey carries on from here
			_marker_done(peer, job["head"])
			_say(peer, "The road has caught up: set the next marker to carry on.")
			continue

		var seg: Dictionary = job["seg"]
		seg["wait"] = maxf(float(seg["wait"]) - delta, -ROAD_STEP_S * float(ROAD_CATCHUP))   # by the clock; a long stall is not made up all at once
		var built: int = 0

		while float(seg["wait"]) <= 0.0 and built < ROAD_CATCHUP:
			seg["wait"] = float(seg["wait"]) + ROAD_STEP_S
			built += 1
			var i: int = int(seg["i"])

			if i >= int(seg["n"]) and not seg.get("trees", []).is_empty():
				var first_left: int = _next_id
				_road_fell(seg, 1.0)   # trees left over at the stretch's end (at most ROAD_FELLS a station): cleared before it closes
				_road_fresh.append_array(range(first_left, _next_id))   # their logs go out with the quick sync
				_road_near.append(seg["b"])
				continue

			if i >= int(seg["n"]):
				_marker_done(peer, seg["a"])
				_marker_done(peer, seg["b"])
				job["head"] = seg["b"]   # reached the marker: the next one is next, on the next tick
				job["seg"] = null
				break

			var first_new: int = _next_id
			_road_fell(seg, float(i) / float(maxi(int(seg["n"]) - 1, 1)))
			_road_station(peer, inv, seg["a"], seg["b"], i, int(seg["n"]))
			seg["i"] = i + 1
			_road_fresh.append_array(range(first_new, _next_id))   # the new pieces (patches, felled logs) go out soon, to the players near the road only
			_road_near.append((seg["a"] as Vector3).lerp(seg["b"], float(i) / float(maxi(int(seg["n"]) - 1, 1))))


# The ground height a road station is brought to: the average of the ground along the line within ROAD_SECTION_M (3 m) around the station, so the road
# follows the lie of the land and eases over bumps and dips instead of cutting a straight ramp between the two markers (Dave 3 Nov 2026).
func _road_section_height(a: Vector3, b: Vector3, t: float) -> float:
	var length: float = Vector2(b.x - a.x, b.z - a.z).length()
	var total: float = 0.0
	var count: int = 0

	for k in range(-3, 4):
		var tt: float = clampf(t + float(k) * (ROAD_SECTION_M / 6.0) / maxf(length, 0.01), 0.0, 1.0)
		var h: float = float(ground_height.call(lerpf(a.x, b.x, tt), lerpf(a.z, b.z, tt)))

		if not is_nan(h):
			total += h
			count += 1

	return total / float(count) if count > 0 else lerpf(a.y, b.y, t)


# A stump is broken up where it stands (on a road, or with its ground dug away: _break_undermined_stumps, _land_fall, the load check in _rot): what
# the last axe blow on it gives (drops.json stump, _stump_final_rows) is left on the ground beside it, and it is gone. A world drop (no player's luck,
# nobody's gathering).
func _break_stump(id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("tree") or int(it["tree"]["state"]) != 4:
		return

	_items.erase(id)
	_stump_pieces(id, it["pos"], float(it["tree"]["radius"]))


# What the last axe blow on a stump of this radius gives (drops.json stump), rolled from `seed_id` with no luck, left on the ground round `at`.
func _stump_pieces(seed_id: int, at: Vector3, radius: float) -> void:
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(seed_id) ^ 7919

	for row in _stump_final_rows(_drops.get("stump", {}), radius):
		drop_in_world(table.number_of(str(row[0])), rng.randi_range(int(row[1]), int(row[2])), at + Vector3(rng.randf_range(-0.4, 0.4), 0.3, rng.randf_range(-0.4, 0.4)))   # luck-exempt: world drop, no player

	_dirty = true


# Standing trees on the road up to this station are cleared (Dave 18 Nov 2026: "if they are felled by this tool they just drop. no animation"): the tree is
# cut and what chopping it gives (its logs at their lengths, the rest of its pieces and its stump's last-blow pieces) lies still on the ground beside
# the road, on the side the tree stood (_road_drop). No fall, so no fall wait, no crush and no log woken; the logs are ordinary loose logs from then on.
# A flora chunk's trees on the stretch are listed once, when the road comes within reach of it (trees_along), and taken in order along the line as the
# stations reach them, at most ROAD_FELLS a station (the rest wait for the next one).
# shortcut: a sapling the world regrew into a tree (dynamic_tree_info) is not on the list, as with dig_fell; the road goes under it.
func _road_fell(seg: Dictionary, t: float) -> void:
	if not trees_along.is_valid() or not tree_info.is_valid() or not cut_tree.is_valid():
		return

	var a: Vector2 = Vector2(seg["a"].x, seg["a"].z)
	var b: Vector2 = Vector2(seg["b"].x, seg["b"].z)

	if not seg.has("trees"):
		seg["trees"] = []
		seg["chunks"] = {}

	var here: Vector2 = a.lerp(b, t)
	var more: Array = trees_along.call(seg["a"], seg["b"], ROAD_TREE_REACH_M, Vector3(here.x, 0.0, here.y), seg["chunks"])

	if not more.is_empty():
		seg["trees"].append_array(more)
		seg["trees"].sort_custom(func(x, y): return float(x[2]) < float(y[2]))

	var felled: int = 0

	while not seg["trees"].is_empty() and float(seg["trees"][0][2]) <= t and felled < ROAD_FELLS:
		var found: Array = seg["trees"].pop_front()
		var info: Dictionary = tree_info.call(found[0], int(found[1]))

		if info.is_empty():
			continue

		var at: Vector2 = Vector2(info["position"].x, info["position"].z)
		var off: Vector2 = SurveyLine.offset(a, b, at)

		if off.x > ROAD_HALF_WIDTH_M + _felled_radius(info):
			continue

		var ab: Vector2 = b - a
		var side: Vector2 = Vector2(-ab.y, ab.x).normalized()

		if side.dot(at - a) < 0.0 or (absf(side.dot(at - a)) < 0.01 and int(found[1]) % 2 == 0):
			side = -side

		if NpcCamp.is_camp_tree(info.get("position", Vector3.INF)) or not bool(cut_tree.call(found[0], int(found[1]))):   # the camp tree never comes down
			continue

		_road_drop(info, side, side.dot(at - a))
		felled += 1


# A tree the road cleared, already down: everything _fall_pieces gives for it lying across the road's side (yaw along `side`, the way away from the
# middle line), moved out so no piece lies within ROAD_CLEAR_M of the middle line (`off`: how far the tree stood from it, along `side`), each on the
# ground where it ends up (a log on the ground point, the loose-log convention). Its stump is broken up at once (_stump_pieces). No stump row, no fall.
func _road_drop(info: Dictionary, side: Vector2, off: float) -> void:
	var spot: Vector3 = info["position"]
	var radius: float = _felled_radius(info)
	var yaw: float = atan2(side.x, side.y)
	var tree: Dictionary = {"species": str(info["name"]), "yaw": yaw, "pitch": 0.0, "length": float(info["height"]), "radius": radius}
	tree["crown"] = _crown_circle(spot, info, yaw, 0.0)
	var seed_id: int = _next_id   # the pieces are rolled from this id, as a stump's would be
	_next_id += 1
	var out: Vector3 = Vector3(side.x, 0.0, side.y)
	var shift: float = maxf(ROAD_CLEAR_M - off, 0.0)   # the logs lie end to end from the butt along `side`: the butt is moved out to the clear line

	for piece in _fall_pieces(seed_id, tree, spot):
		var pos: Vector3 = piece[2] + out * shift
		var is_log: bool = piece.size() > 3
		var lat: float = off + shift + (piece[2] - spot).dot(out)   # how far out from the middle line it lies now

		if not is_log and lat < ROAD_CLEAR_M:
			pos += out * (ROAD_CLEAR_M - lat)   # crown litter or a heap that came out over the road

		if ground_height.is_valid():
			var was: float = float(ground_height.call(piece[2].x, piece[2].z))
			var ground: float = float(ground_height.call(pos.x, pos.z))

			if not is_nan(ground):
				pos.y = ground if is_log or is_nan(was) else ground + maxf(float(piece[2].y) - was, 0.0)

		var rot_y: float = float(piece[3]) if is_log else NAN
		var girth: float = clampf(float(piece[4]), 0.25, 2.5) if is_log and not is_nan(float(piece[4])) else NAN
		var left: int = int(piece[1])

		while left > 0:   # straight into the table, as a felled tree's are: a pile over PILE_CAP starts a second one
			var count: int = mini(left, PILE_CAP)
			var rec: Dictionary = {"number": int(piece[0]), "count": count, "pos": pos, "left": maxf(PILE_LIFETIME_S if count >= PILE_MIN else WORLD_ITEM_LIFETIME_S, SPLIT_LIFETIME_S), "wear": 0}

			if is_log:
				rec["rot_y"] = rot_y

				if not is_nan(girth):
					rec["girth"] = girth

			_items[_next_id] = rec
			_next_id += 1
			left -= count

	var heap: Vector3 = spot + out * (shift + 0.5)   # its pieces scatter 0.4 m round this: all clear of the road
	var heap_ground: float = float(ground_height.call(heap.x, heap.z)) if ground_height.is_valid() else NAN
	_stump_pieces(seed_id, Vector3(heap.x, heap_ground if not is_nan(heap_ground) else heap.y, heap.z), radius)   # beside the road with the rest, not on it
	_dirty = true
	_road_sync_in = 0.0   # the pieces go out on the next tick with the flora cut, so the tree never vanishes before they lie there (as _fell_record, bug 6), to the players near the road only (finding 4)


func _road_station(peer: int, inv, a: Vector3, b: Vector3, i: int, n: int) -> void:
	var t: float = float(i) / float(maxi(n - 1, 1))
	var along: Vector2 = Vector2(b.x - a.x, b.z - a.z).normalized()
	var side: Vector2 = Vector2(-along.y, along.x)
	var centre: Vector2 = Vector2(a.x, a.z).lerp(Vector2(b.x, b.z), t)
	var target: float = _road_section_height(a, b, t)
	var edits: int = 0
	var wet: bool = water_depth_at.is_valid() and float(water_depth_at.call(Vector3(centre.x, target, centre.y))) > 0.05   # no digging or filling in water: the road goes on over a ford

	if not wet and dig_ground.is_valid() and fill_ground.is_valid():
		for offset in [0.0, ROAD_HALF_WIDTH_M, -ROAD_HALF_WIDTH_M]:
			if edits >= ROAD_EDITS:
				break

			var spot: Vector2 = centre + side * float(offset)
			var h: float = float(ground_height.call(spot.x, spot.y))

			if is_nan(h) or absf(h - target) < PATH_AVERAGE_MIN_M:
				continue

			var depth: float = minf(absf(h - target), ROAD_DEPTH_M)
			var road_at: Vector3 = Vector3(spot.x, h - depth + SMOOTH_SPHERE_M, spot.y) if h > target else Vector3(spot.x, h + depth - SMOOTH_SPHERE_M, spot.y)

			if _edit_blocker(road_at, SMOOTH_SPHERE_M, h <= target, false) != "":
				continue   # the road leaves the ground under a chest, fire or station as it is

			if h > target:
				dig_ground.call(Vector3(spot.x, h - depth + SMOOTH_SPHERE_M, spot.y), SMOOTH_SPHERE_M)
				settle_loose_near(Vector3(spot.x, h - depth + SMOOTH_SPHERE_M, spot.y), SMOOTH_SPHERE_M)
			else:
				fill_ground.call(Vector3(spot.x, h + depth - SMOOTH_SPHERE_M, spot.y), SMOOTH_SPHERE_M, int(FILL_SOIL["soil"]))
				settle_loose_near(Vector3(spot.x, h + depth - SMOOTH_SPHERE_M, spot.y), SMOOTH_SPHERE_M, true)

			edits += 1

	var ground: float = float(ground_height.call(centre.x, centre.y))

	if is_nan(ground):
		return

	var pos: Vector3 = Vector3(centre.x, ground + 0.02, centre.y)

	var stumps: Array = []   # stumps standing on the road here (chopped before it came): broken up after the look round

	if _structures.has("path_patch") and not (water_depth_at.is_valid() and float(water_depth_at.call(Vector3(pos.x, ground, pos.z))) > 0.05):
		var blocked: bool = false
		# From the sync grid around the station and every id made since it was filed (audit 18 Nov 2026 finding 4: every record in the world
		# was looked at for each station, four times a second).
		for id in _ids_near(pos, ROAD_HALF_WIDTH_M + 8.0):   # every record when no sync has filed a grid yet
			if not _items.has(id):
				continue

			var other: Dictionary = _items[id]

			if other.has("tree") and int(other["tree"]["state"]) == 4 and not _falls.has(id) and Vector2(other["pos"].x - pos.x, other["pos"].z - pos.z).length() < ROAD_HALF_WIDTH_M + float(other["tree"]["radius"]) + ROAD_STATION_M * 0.5:
				stumps.append(id)
				continue

			if not other.has("struct"):
				continue   # a rock stays where it is, the road under it (Dave 17 Nov 2026: rocks are left for tools)

			if str(other["struct"]["kind"]) == "path_patch":
				if Vector2(other["pos"].x - pos.x, other["pos"].z - pos.z).length() < PATH_SPACING_M:
					blocked = true   # no break: the look round goes on for the stumps here
			elif other["pos"].distance_to(pos) < 1.0 and not bool(_structures.get(str(other["struct"]["kind"]), {}).get("walkover", false)):
				blocked = true

		if not blocked:   # no cap on path patches (Dave 17 Nov 2026)
			_items[_next_id] = {"number": table.number_of("path_patch"), "count": 1, "pos": pos, "left": 1.0e9, "struct": {"kind": "path_patch", "yaw": 0.0, "road": true}}   # road: the grass is kept off 2 m either side
			_zone_add(_next_id)
			_trample_saplings(pos)   # no young tree grows up on the road
			_next_id += 1
			_dirty = true
			_goal_event(peer, "path_laid")

	for id in stumps:
		_break_stump(id)

	if i % ROAD_WEAR_EVERY == 0:
		_wear_tool(peer, inv, "hoe", "dig")



func _hoe_grade(peer: int, inv, at: Vector3, held_slot: int) -> void:
	var pair: Array = _grade_points.get(peer, [null, null])

	if pair[1] == null:
		_say(peer, "Set point A and point B first (Shift + right click).")
		return

	if not ground_height.is_valid() or not dig_ground.is_valid() or not fill_ground.is_valid():
		return

	var hoe: int = _hoe_ready(peer, inv, at, held_slot)

	if hoe < 0:
		return

	var a: Vector3 = pair[0]
	var b: Vector3 = pair[1]
	var along: Vector2 = Vector2(b.x - a.x, b.z - a.z)
	var length: float = along.length()

	if length < 1.0:
		_say(peer, "Points A and B are too close together.")
		return

	var dir: Vector2 = along / length
	var worked: int = 0
	var dug: bool = false
	var skipped: bool = false   # a point was left for a placed thing standing on it

	for offset in [Vector2.ZERO, dir, -dir, Vector2(-dir.y, dir.x), Vector2(dir.y, -dir.x)]:
		var x: float = at.x + offset.x
		var z: float = at.z + offset.y
		var from_a: Vector2 = Vector2(x - a.x, z - a.z)
		var t: float = clampf(from_a.dot(dir) / length, 0.0, 1.0)

		if Vector2(x, z).distance_to(Vector2(a.x, a.z) + dir * t * length) > GRADE_WIDTH_M or from_a.length() > GRADE_REACH_M:
			continue

		var h: float = float(ground_height.call(x, z))

		if is_nan(h):
			continue

		var d: float = h - lerpf(a.y, b.y, t)

		if absf(d) < SMOOTH_MIN_M:
			continue

		var depth: float = minf(absf(d), SMOOTH_MAX_M)
		var sphere_at: Vector3 = Vector3(x, h - depth + SMOOTH_SPHERE_M, z) if d > 0.0 else Vector3(x, h + depth - SMOOTH_SPHERE_M, z)

		dug = true

		if _edit_blocker(sphere_at, SMOOTH_SPHERE_M, d <= 0.0, false) != "":
			skipped = true
			continue   # a chest, fire or station stands there: the stroke grades round it

		var done: Variant = dig_ground.call(sphere_at, SMOOTH_SPHERE_M) if d > 0.0 else fill_ground.call(sphere_at, SMOOTH_SPHERE_M, int(FILL_SOIL["soil"]))

		if typeof(done) != TYPE_BOOL or bool(done):
			worked += 1
			settle_loose_near(sphere_at, SMOOTH_SPHERE_M, d <= 0.0)

	if not dug:
		_say(peer, "The ground here is already on the line.")
		return

	if worked == 0:
		_say(peer, "Only ground under placed things is left: take them up to grade it." if skipped else "This ground is worked enough.")
		return

	_wear_slot(peer, inv, hoe, "dig")
	_remove_paths_near(at, GRADE_CLEAR_M)
	_dirty = true


# Ground that was moved takes the path on it with it: patches near a smoothed spot are removed (the hoe treads them again).
func _remove_paths_near(at: Vector3, radius: float) -> void:
	for id in _items.keys():
		var it: Dictionary = _items[id]

		if it.has("struct") and str(it["struct"]["kind"]) == "path_patch" and it["pos"].distance_to(at) <= radius:
			_items.erase(id)


# Takes one shovelful of the named fill item; returns 1 or 0.
func take_fill_item(peer: int, name: String) -> int:
	var inv = inventory_of(peer)
	var number: int = table.number_of(name)

	if inv == null or number <= 0 or inv.count_of(number) < 1:
		return 0

	var before: Array = _snapshot(inv)
	inv.remove(number, 1)
	_send_changes(peer, inv, before)
	return 1


# Dig under trees (job 85, drops.json "dig_fell"): every standing tree near the new hole whose support is now thin enough falls
# away from the hole, already in its logs (_fell_record).
func _fell_undermined(_peer: int, at: Vector3) -> void:
	var cfg: Dictionary = _drops.get("dig_fell", {})

	if cfg.is_empty() or not trees_near.is_valid() or not dig_support.is_valid() or not tree_info.is_valid() or not cut_tree.is_valid():
		return

	for found in trees_near.call(at, float(cfg.get("search_m", 4.0))):
		var chunk: Vector2i = found[0]
		var info: Dictionary = tree_info.call(chunk, int(found[1]))

		if info.is_empty():
			continue

		var trunk: float = float(info["trunk"])
		var radius: float = float(cfg.get("support_r_per_trunk", 2.0)) * trunk + float(cfg.get("support_r_base", 1.0))
		var share: float = float(dig_support.call(info["position"], radius, float(cfg.get("depth_m", 1.0))))
		var limits: Dictionary = cfg.get("fall_below", {})
		var limit: float = float(limits.get("default", 0.35))

		for word in cfg.get("conifer_words", []):
			if str(info["name"]).contains(str(word)):
				limit = float(limits.get("conifer", 0.45))

		if trunk >= float(cfg.get("big_trunk_m", 0.55)):
			limit = minf(limit, float(limits.get("big", 0.25)))

		if share >= limit:
			continue

		var stump_id: int = _fell(chunk, int(found[1]), info, Vector2(info["position"].x - at.x, info["position"].z - at.z))

		if _falls.has(stump_id):
			_falls[stump_id]["undermined"] = true   # a dug-out tree leaves no stump (Dave 19 Nov 2026): it breaks up when the tree lands (_land_fall), whatever ground its own smaller disc keeps


# A stump whose ground is dug away breaks into what chopping it gives, and the pieces fall to the ground (Dave 19 Nov 2026: "the stump can just break
# into its components and fall"; before, it hung in the air where no axe could reach it). True when the share of ground left in the disc under it
# (dig_fell stump_support_r_per_radius x its radius + stump_support_r_base wide, stump_depth_m deep) is under stump_fall_below.
func _stump_undermined(it: Dictionary) -> bool:
	var cfg: Dictionary = _drops.get("dig_fell", {})

	if cfg.is_empty() or not dig_support.is_valid() or not it.has("tree") or int(it["tree"]["state"]) != 4:
		return false

	var radius: float = float(cfg.get("stump_support_r_per_radius", 2.0)) * float(it["tree"]["radius"]) + float(cfg.get("stump_support_r_base", 0.5))
	return float(dig_support.call(it["pos"], radius, float(cfg.get("stump_depth_m", 0.6)))) < float(cfg.get("stump_fall_below", 0.35))


# After a dig: the stumps near it (the sync grid's cells round the hole, not the world) whose ground is now gone break up (_stump_undermined).
# A stump still "fresh" belongs to a tree coming down: it is looked at when it lands.
func _break_undermined_stumps(at: Vector3) -> void:
	var reach: float = float(_drops.get("dig_fell", {}).get("search_m", 4.0))

	for id in _ids_near(at, reach):
		if not _items.has(id) or not _items[id].has("tree") or _items[id]["tree"].has("fresh"):
			continue

		if Vector2(_items[id]["pos"].x - at.x, _items[id]["pos"].z - at.z).length() <= reach and _stump_undermined(_items[id]):
			_break_stump(int(id))


# What a dig brings up (data/items/digging.json): shovelfuls by the surface material at the hole, through luck, counted by weight.
# Shovel sizes (Dave 2026-10-22, digging.json "shovel_sizes"): a small shovel moves 1 piece (shovelful) per stroke, a medium 4, a large 8.
# The sphere it digs or raises grows with the cube root of the pieces (so its volume goes with them), and so do its pace and its wear.
func _shovel_size(inv, slot: int) -> Dictionary:   # slot: the shovel in hand (_swing_tool)
	var name: String = str(table.entry(table.id_of(inv.numbers[slot])).get("shovel_size", "small")) if slot >= 0 else "small"
	return _dig_cfg.get("shovel_sizes", {}).get(name, {"pieces": 1})


func _shovel_pieces(inv, slot: int) -> int:
	return maxi(1, int(_shovel_size(inv, slot).get("pieces", 1)))


func _shovel_reach(inv, slot: int) -> float:
	return pow(float(_shovel_pieces(inv, slot)), 1.0 / 3.0)


func _shovel_tier(inv, slot: int) -> int:
	return int(table.entry(table.id_of(inv.numbers[slot])).get("tier", 1)) if slot >= 0 else 1


func _give_dig_yield(peer: int, at: Vector3, tier: int = 1, pieces: int = 1) -> void:
	if not ground_material.is_valid() or _dig_cfg.is_empty():
		return

	var material: String = str(ground_material.call(at.x, at.z))
	var rows: Array = _dig_cfg.get("yield", {}).get(material, _dig_cfg.get("default", []))

	for row in rows:
		var number: int = table.number_of(str(row[0]))
		var extra: int = int(_dig_cfg.get("tier_extra", {}).get(str(tier), 0)) if int(row[2]) > int(row[1]) or int(row[2]) > 0 else 0
		var amount: int = roll_amount(peer, _fate_rng, int(row[1]), int(row[2]) + extra)

		if number > 0 and amount > 0:
			give(peer, number, maxi(1, int(round(float(amount) * skill_factor(peer, "dig")))) * pieces)

	_dig_bog_iron(peer, at, tier, pieces)
	_dig_seam_coal(peer, at, tier, pieces)
	practice(peer, "dig")
	var under: Array = _dig_cfg.get("under", {}).get(material, [])

	if under.size() >= 2 and roll_chance(peer, _fate_rng, float(under[1])):
		var layer: int = table.number_of(str(under[0]))
		var count: int = roll_amount(peer, _fate_rng, int(under[2]), int(under[3])) if under.size() >= 4 else 1   # [item, chance, min, max]; min..max as a soil row

		if layer > 0 and count > 0:
			give(peer, layer, count * pieces)

	# digging.json finds: a small chance of something living in the soil (a worm in moist living soil), one per stroke at most.
	for find in _dig_cfg.get("finds", []):
		var found: int = table.number_of(str(find.get("item", "")))

		if found > 0 and material in find.get("soils", []) and roll_chance(peer, _fate_rng, float(find.get("chance", 0.0))):
			give(peer, found, 1)


# Bog iron (digging.json bog_iron, Sonny s11): a dig within a patch's radius (_bog_patch_at) also brings up its ore, on top of the peat or mud. It is per_dig rolled like a
# soil row, plus the shovel tier's tier_extra, times the shovel size's pieces, never more than is left; the deposit grows back one ore every
# regrow_game_days (BogIron.regrown, worked out at the dig). The first dig that finds any says first_find once to that character.
func _dig_bog_iron(peer: int, at: Vector3, tier: int, pieces: int) -> void:
	var cfg: Dictionary = _dig_cfg.get("bog_iron", {})

	if cfg.is_empty() or not bog_field.is_valid():
		return

	var deposit: Dictionary = _bog_patch_at(at.x, at.z)
	var number: int = table.number_of(str(cfg.get("item", "iron_ore")))

	if deposit.is_empty() or number <= 0:
		return

	var key: String = str(deposit["key"])
	var size: int = int(deposit["size"])
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	var row: Array = BogIron.regrown(_bog_left.get(key, [size, now_s]), size, now_s, cfg)
	var left: int = int(row[0])

	if left <= 0:
		_bog_left[key] = row
		return

	var per: Array = cfg.get("per_dig", [1, 2])
	var extra: int = int(_dig_cfg.get("tier_extra", {}).get(str(tier), 0))
	var amount: int = mini(maxi(1, int(round(float(roll_amount(peer, _fate_rng, int(per[0]), int(per[1]) + extra)) * skill_factor(peer, "dig")))) * pieces, left)
	give(peer, number, amount)
	_bog_left[key] = [left - amount, float(row[1])]
	_dirty = true
	_say_once(peer, "found_bog_iron", str(cfg.get("first_find", "")))


# The patches of field square (fx, fz), worked out once a run (BogIron.field reads a few thousand samples of the baked tile). bog_field answers
# null while the square's tile is not in memory (the server never reads a tile on its main thread): nothing is kept, and a later call asks again.
func _bog_field_of(fx: int, fz: int) -> Array:
	var key: String = "%d,%d" % [fx, fz]

	if not _bog_fields.has(key):
		var build_started: int = Time.get_ticks_usec()
		var patches: Variant = bog_field.call(fx, fz, _dig_cfg.get("bog_iron", {}))
		_bog_build_usec += Time.get_ticks_usec() - build_started
		_bog_built += 1

		if typeof(patches) != TYPE_ARRAY:
			return []

		if _bog_fields.size() >= BOG_FIELDS_MAX:
			_bog_fields.clear()

		_bog_fields[key] = patches

	return _bog_fields[key]


# Every patch of the field squares within reach of (x, z): [{"key", "x", "z", "size", "r"}, ...] (unsorted; may hold patches out of reach).
func _bog_patches_near(x: float, z: float, reach: float) -> Array:
	var cfg: Dictionary = _dig_cfg.get("bog_iron", {})
	var out: Array = []

	if cfg.is_empty() or not bog_field.is_valid():
		return out

	var low: Vector2i = BogIron.field_of(x - reach, z - reach, cfg)
	var high: Vector2i = BogIron.field_of(x + reach, z + reach, cfg)

	for fz in range(low.y, high.y + 1):
		for fx in range(low.x, high.x + 1):
			out.append_array(_bog_field_of(fx, fz))

	return out


# The patch whose ground point (x, z) lies on (within its radius; the nearest when two touch), or {}.
func _bog_patch_at(x: float, z: float) -> Dictionary:
	var radii: Array = _dig_cfg.get("bog_iron", {}).get("radius_m", [2.5, 4.0])
	var best: Dictionary = {}
	var best_d: float = INF

	for patch in _bog_patches_near(x, z, float(radii[radii.size() - 1])):
		var d: float = Vector2(float(patch["x"]) - x, float(patch["z"]) - z).length()

		if d <= float(patch["r"]) and d < best_d:
			best_d = d
			best = patch

	return best


# The bog iron patches a player can see (digging.json bog_iron seen_m), as world rows for the client's look (inventory_view _note_bog and the
# ground shader's rust, ground_material.gd set_bogs):
#   [id, 0, ore left, the patch centre on the generated ground, BOG_STATE, {"key": "gi,gj", "total": its size, "r": its radius in metres}]
# "left" is the deposit as it has grown back by now (BogIron.regrown, the same sum a dig makes), so a dig or the regrowth sends the row again.
# The centre's height is the ground as generated, not as dug: the client draws rust only on ground still at that level.
func _bog_rows_near(_peer: int, here: Vector3) -> Array:
	var cfg: Dictionary = _dig_cfg.get("bog_iron", {})
	var rows: Array = []

	if cfg.is_empty() or not bog_field.is_valid():
		return rows

	var seen: float = float(cfg.get("seen_m", 50.0))
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for patch in _bog_patches_near(here.x, here.z, seen):
		var x: float = float(patch["x"])
		var z: float = float(patch["z"])

		if Vector2(x - here.x, z - here.z).length() > seen:
			continue

		var key: String = str(patch["key"])
		var size: int = int(patch["size"])

		if not _bog_ids.has(key):
			_bog_ids[key] = BOG_ID_BASE - _bog_ids.size()

		if not _bog_y.has(key):   # the generated ground at the centre, worked out once a run
			_bog_y[key] = float(ground_height.call(x, z)) if ground_height.is_valid() else NAN

		var y: float = float(_bog_y[key])
		var left: int = int(BogIron.regrown(_bog_left.get(key, [size, now_s]), size, now_s, cfg)[0])
		rows.append([int(_bog_ids[key]), 0, left, Vector3(x, here.y if is_nan(y) else y, z), BOG_STATE, {"key": key, "total": size, "r": snappedf(float(patch["r"]), 0.01)}])

	return rows


# A dig that changed the ground on fen, marsh, swamp or bog (BogIron.silt_material) is noted to silt back in refill_game_days later (_bog_holes_tick).
# A dig beside a waiting hole joins it: the larger radius, the later time, the surface it first had.
func _note_bog_hole(at: Vector3, radius: float) -> void:
	var cfg: Dictionary = _dig_cfg.get("bog_iron", {})

	if cfg.is_empty() or not bog_silt_at.is_valid() or not fill_ground.is_valid():
		return

	var material: int = int(bog_silt_at.call(at.x, at.z, cfg))

	if material <= 0:
		return

	var due: float = (float(game_seconds.call()) if game_seconds.is_valid() else 0.0) + float(cfg.get("refill_game_days", 1.0)) * BogIron.SECONDS_PER_GAME_DAY

	for hole in _bog_holes:
		if Vector2(float(hole[0]) - at.x, float(hole[2]) - at.z).length() <= BOG_HOLE_JOIN_M:
			hole[3] = maxf(float(hole[3]), radius)
			hole[4] = due

			if hole.size() >= 7 and at.y >= float(hole[6]) - float(hole[3]) - DIG_DEPTH_M - BOG_PIT_STEP_M:
				hole[6] = minf(float(hole[6]), at.y)   # the deepest dig of one pit dug down from the top: a dig far below it (a tunnel) does not deepen it
			_dirty = true
			return

	var surface: float = float(ground_height.call(at.x, at.z)) if ground_height.is_valid() else NAN

	if not is_nan(surface) and at.y < surface - BOG_HOLE_DEEP_M:
		return   # a dig in a tunnel or cellar under the wetland: the water does not fill that

	_bog_holes.append([at.x, at.y if is_nan(surface) else surface, at.z, radius, due, material, at.y])

	if _bog_holes.size() > BOG_HOLES_MAX:
		_silt_hole(_bog_holes.pop_front())

	_dirty = true


# The slow tick: each hole whose time has come silts back in, unless a player stands in reach of it (then it waits for the next tick).
func _bog_holes_tick() -> void:
	if _bog_holes.is_empty() or not game_seconds.is_valid():
		return

	var now_s: float = float(game_seconds.call())
	var keep: Array = []

	var silted: int = 0

	for hole in _bog_holes:
		if silted >= BOG_SILT_PER_TICK or now_s < float(hole[4]) or _someone_near_hole(hole) or (ground_ready.is_valid() and not bool(ground_ready.call(float(hole[0]), float(hole[2])))):
			keep.append(hole)
		else:
			_silt_hole(hole)
			silted += 1

	if keep.size() != _bog_holes.size():
		_bog_holes = keep
		_dirty = true


func _someone_near_hole(hole: Array) -> bool:
	var reach: float = _silt_radius(hole) + 1.0

	for peer in _peer_pos:
		var p: Vector3 = _peer_pos[peer]

		if Vector2(p.x - float(hole[0]), p.z - float(hole[2])).length() <= reach:
			return true

	return false


func _silt_radius(hole: Array) -> float:
	return maxf(BOG_REFILL_R_MIN, 3.0 * float(hole[3]))


# The points the silting fill would reach that the hole itself did not open: a grid over the fill's sphere, leaving out the pit
# (a column round the hole down to its deepest dig, wide enough for every joined dig, with a half-metre margin) and anything less
# than a step under the generated ground. A tunnel or cellar there must not be filled (coordinator, 22 Nov 2026).
func _silt_reach(hole: Array, r: float) -> Array:
	var centre: Vector3 = Vector3(float(hole[0]), float(hole[1]) - r, float(hole[2]))
	var dug: Vector2 = Vector2(float(hole[0]), float(hole[2]))
	var dug_r: float = float(hole[3]) + 0.5 + BOG_HOLE_JOIN_M   # the pit's column: every dig within the join distance, plus its radius and a margin
	var dug_floor: float = (float(hole[6]) if hole.size() >= 7 else float(hole[1]) - float(hole[3])) - float(hole[3]) - 0.5   # an older hole: as loaded
	var steps: int = int(ceil(r / BOG_OPEN_STEP_M))
	var points: Array = []

	for iy in range(-steps, steps + 1):
		for iz in range(-steps, steps + 1):
			for ix in range(-steps, steps + 1):
				var p: Vector3 = centre + Vector3(ix, iy, iz) * BOG_OPEN_STEP_M

				if p.distance_to(centre) > r or (p.y >= dug_floor and Vector2(p.x, p.z).distance_to(dug) <= dug_r):
					continue

				# Only points well under the ground as generated there: round a hole on a slope the sphere also reaches the open air
				# over lower ground, which is not a tunnel.
				if ground_height.is_valid() and p.y > float(ground_height.call(p.x, p.z)) - BOG_OPEN_STEP_M:
					continue

				points.append(p)

	return points


# One fill of the wetland's own soil (noted with the hole; the draw material stays the generated wetland look): a sphere whose top just meets the surface the ground had before the dig, so the hole fills to a shallow dip at its rim and
# never heaps above the old ground.
func _silt_hole(hole: Array) -> void:
	if not fill_ground.is_valid():
		return

	var r: float = _silt_radius(hole)

	if ground_open.is_valid() and ground_open.call(_silt_reach(hole, r)):
		print("Bog hole at (%.1f, %.1f) left open: its silting would reach open ground under it" % [float(hole[0]), float(hole[2])])
		return
	fill_ground.call(Vector3(float(hole[0]), float(hole[1]) - r, float(hole[2])), r, int(hole[5]) if hole.size() >= 6 else PEAT_SOIL)
	settle_loose_near(Vector3(float(hole[0]), float(hole[1]) - r, float(hole[2])), r, true)   # the refill sphere itself: what lay in the hole comes up onto it


# What filling a hole uses up (digging.json "fill", in that order): takes up to `units` shovelfuls from the pack, returns how many
# it got. The fill operation calls this and fills only as many units as it got. fill_units_of is the same count without taking.
func take_fill(peer: int, units: int) -> int:
	var inv = inventory_of(peer)

	if inv == null or units <= 0:
		return 0

	var before: Array = _snapshot(inv)
	var got: int = 0

	for name in _dig_cfg.get("fill", []):
		var number: int = table.number_of(str(name))
		var took: int = mini(units - got, inv.count_of(number)) if number > 0 else 0

		if took > 0 and inv.remove(number, took):
			got += took

		if got >= units:
			break

	if got > 0:
		_send_changes(peer, inv, before)
		_dirty = true

	return got


func fill_units_of(peer: int) -> int:
	var inv = inventory_of(peer)
	var total: int = 0

	if inv != null:
		for name in _dig_cfg.get("fill", []):
			var number: int = table.number_of(str(name))
			total += inv.count_of(number) if number > 0 else 0

	return total


# A dead branch on the forest floor (Dave 2026-10-22: loose sticks you can see should be pickable): one stick. The branches are drawn
# by the client, so the server only checks reach and pace (the same pace as a plant pick).
func _pick_litter(peer: int, inv, at: Vector3) -> void:
	if not at.is_finite() or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(at) > Interact.server_reach_m():
		return

	var now_ms: int = Time.get_ticks_msec()

	if now_ms - int(_last_gather.get(peer, -100000)) < gather_pace_ms:
		return

	_branches_today()

	if _branch_gone(at):
		return   # this branch was taken today (protocol 160: the clients hide one there)

	_last_gather[peer] = now_ms
	var before: Array = _snapshot(inv)
	_take_in(peer, inv, table.number_of("stick"), 1)

	_send_changes(peer, inv, before)
	_dirty = true
	var cell: Vector2i = _taken_cell_of(at)
	var list: PackedVector3Array = _branch_taken.get(cell, PackedVector3Array())

	if list.size() < BRANCH_SQUARE_MOST:
		list.append(at)
		_branch_taken[cell] = list
		_tell_taken(TAKEN_BRANCH, at, _game_day(), peer)


# --- Forest-floor pickups seen alike (protocol 160; coordinator 23 Nov 2026, two players see the same world) ---
# Dead branches are drawn by each client (grass_view litter), tide-line nodes and bird nests from the cell and the day: a branch one player
# picked stayed for the others, and a node or nest used up showed full to everyone else. The server keeps what was taken and tells the
# players within TAKEN_SEND_M: at once when it goes, and as they walk TAKEN_TELL_CELLS squares from where they were last told (every taken
# spot round them, so a newcomer sees the same). Each client draws its own branches (where depends on its graphics tier and on how it built
# the ground), so a client hides its nearest branch to each taken point (grass_view.gd take_branch), not one at the very spot.
# Branches grow back the next game day (one real hour; Dave: "we are not gate keeping by limiting resources"): the list is memory only,
# cleared when the day turns, and at most BRANCH_SQUARE_MOST a 32 m square is kept (a made-up flood of picks costs nothing more).
const TAKEN_BRANCH := 0
const TAKEN_SHORE := 1
const TAKEN_NEST := 2
const TAKEN_CLEAR := 3               # everything forgotten (an admin world reset): the client clears its lists
const TAKEN_CELL_M := 32.0
const TAKEN_TELL_CELLS := 2          # told again after moving this many squares on either axis (no resend each time a player steps over a line)
const TAKEN_SEND_M := 150.0
const BRANCH_SAME_M := 0.25          # a pick within this of a taken point is that branch again (refused)
const BRANCH_SQUARE_MOST := 400
var send_taken: Callable             # (peer, kind, points PackedVector3Array, game days PackedInt32Array): ground_taken (protocol 160)
var _branch_taken: Dictionary = {}   # Vector2i TAKEN_CELL_M square -> PackedVector3Array of branch points taken today
var _branch_day: int = -1
var _nest_at: Dictionary = {}        # nest id -> its spot, kept from the robbing (memory only: after a restart a robbed nest shows full to others until robbed again)
var _taken_told: Dictionary = {}     # peer -> the TAKEN_CELL_M square it was last told about


func _taken_cell_of(at: Vector3) -> Vector2i:
	return Vector2i(int(floor(at.x / TAKEN_CELL_M)), int(floor(at.z / TAKEN_CELL_M)))


func _branches_today() -> void:
	var day: int = _game_day()

	if day != _branch_day:
		_branch_day = day
		_branch_taken.clear()   # a new day: every branch has grown back


func _branch_gone(at: Vector3) -> bool:
	var cell: Vector2i = _taken_cell_of(at)

	for dx in range(-1, 2):
		for dz in range(-1, 2):
			for p in _branch_taken.get(cell + Vector2i(dx, dz), PackedVector3Array()):
				if Vector2(p.x - at.x, p.z - at.z).length() <= BRANCH_SAME_M:
					return true

	return false


func _shore_cell_middle(key: String) -> Vector3:
	var cell_m: float = float(_shore_data().get("cell_m", 8.0))
	return Vector3((float(key.get_slice(",", 0)) + 0.5) * cell_m, 0.0, (float(key.get_slice(",", 1)) + 0.5) * cell_m)


# To the players near `at` but `skip` (the taker's own client has hidden the very branch it picked).
func _tell_taken(kind: int, at: Vector3, day: int, skip: int = 0) -> void:
	if not send_taken.is_valid():
		return

	for peer in _peer_pos:
		if peer != skip and Vector2(_peer_pos[peer].x - at.x, _peer_pos[peer].z - at.z).length() <= TAKEN_SEND_M:
			send_taken.call(peer, kind, PackedVector3Array([at]), PackedInt32Array([day]))


# An admin world reset: every player forgets what was taken (the reset restores nests, shore finds and branches).
func _tell_taken_cleared() -> void:
	if send_taken.is_valid():
		for peer in _peer_pos:
			send_taken.call(peer, TAKEN_CLEAR, PackedVector3Array(), PackedInt32Array())


# A player TAKEN_TELL_CELLS squares from where it was last told (or just joined): every taken spot within TAKEN_SEND_M, one message per kind.
func _tell_taken_near(peer: int, here: Vector3) -> void:
	var cell: Vector2i = _taken_cell_of(here)
	var told: Variant = _taken_told.get(peer, null)

	if not send_taken.is_valid() or (told != null and absi(cell.x - (told as Vector2i).x) < TAKEN_TELL_CELLS and absi(cell.y - (told as Vector2i).y) < TAKEN_TELL_CELLS):
		return

	_taken_told[peer] = cell
	_branches_today()
	var day: int = _game_day()
	var reach: int = int(ceil(TAKEN_SEND_M / TAKEN_CELL_M))
	var rows: Array = [[PackedVector3Array(), PackedInt32Array()], [PackedVector3Array(), PackedInt32Array()], [PackedVector3Array(), PackedInt32Array()]]
	var near: Callable = func(p: Vector3) -> bool: return Vector2(p.x - here.x, p.z - here.z).length() <= TAKEN_SEND_M

	for dx in range(-reach, reach + 1):
		for dz in range(-reach, reach + 1):
			for p in _branch_taken.get(cell + Vector2i(dx, dz), PackedVector3Array()):
				if near.call(p):
					rows[TAKEN_BRANCH][0].append(p)
					rows[TAKEN_BRANCH][1].append(day)

	for key in _shore_taken:
		if int(_shore_taken[key]) == day:
			var middle: Vector3 = _shore_cell_middle(str(key))

			if near.call(middle):
				rows[TAKEN_SHORE][0].append(middle)
				rows[TAKEN_SHORE][1].append(day)

	for id in _nest_at:
		if _nest_taken.has(id) and near.call(_nest_at[id]):
			rows[TAKEN_NEST][0].append(_nest_at[id])
			rows[TAKEN_NEST][1].append(int(_nest_taken[id]))

	for kind in range(rows.size()):
		if not (rows[kind][0] as PackedVector3Array).is_empty():
			send_taken.call(peer, kind, rows[kind][0], rows[kind][1])


func _mine(peer: int, inv, at: Vector3, held_slot: int, struck_nothing: bool = false) -> void:   # struck_nothing: the client's ray hit nothing (a swing into the air): effort only, whatever lies under the point
	if not _peer_pos.has(peer):
		return

	if _peer_pos[peer].distance_to(at) > MINE_REACH_M:
		_reject_far(peer)
		return

	var tool: int = _held_tool(inv, held_slot, "pick")   # the pick or axe in hand breaks a stone off bare rock (an axe wears 5 a blow, drops.json tool_wear rock)

	if tool < 0:
		tool = _held_tool(inv, held_slot, "axe")

	var now: int = Time.get_ticks_msec()

	if tool < 0:
		if now - int(_last_mine.get(peer, -100000)) >= HANDS_FULL_SAY_GAP_MS and _say_hands_full(peer, inv):   # a swing a tick would say it every time: once in a while
			_last_mine[peer] = now

		_reject(peer, 1)

	if tool < 0 or float(now - int(_last_mine.get(peer, -100000))) < float(MINE_COOLDOWN_MS) / _pace_factor(peer, "mine_rock"):
		return

	_last_mine[peer] = now

	if struck_nothing or not rock_at.is_valid() or not bool(rock_at.call(at.x, at.z)):
		_note_work(peer, str(table.entry(table.id_of(inv.numbers[tool])).get("tool_class", "")))   # a swing at soil or into empty air (b = 1, a point 2.5 m ahead: rock_at is x/z only, so over bare rock a claimed miss still gives nothing): it tires, it breaks no stone, wears nothing, trains nothing
		return

	var patch: Vector2i = Vector2i(int(floor(at.x / MINE_CELL_M)), int(floor(at.z / MINE_CELL_M)))
	var state: Dictionary = _mined.get(patch, {"taken": 0, "since": now})
	var regrown: int = int((now - int(state["since"])) / (MINE_REGROW_S * 1000.0))
	state["taken"] = maxi(int(state["taken"]) - regrown, 0)

	if regrown > 0:
		state["since"] = now

	if int(state["taken"]) >= MINE_STONES_PER_CELL:
		_mined[patch] = state
		_note_work(peer, str(table.entry(table.id_of(inv.numbers[tool])).get("tool_class", "")))   # a resting patch: the swing tires, and wears nothing (it broke nothing)
		return

	# A better tool breaks more off a blow (coordinator's gathering walk, 23 Nov 2026: every pick and axe gave one stone a blow on bare rock):
	# boulders.json tools' rate for the tool in hand, never under one stone a blow (a stone axe keeps its one), a fraction carried in the
	# patch's "part". A patch still takes MINE_STONES_PER_CELL blows before it rests, so a better pick takes more from it, not less.
	var entry: Dictionary = table.entry(table.id_of(inv.numbers[tool]))
	var rates: Dictionary = (_boulder_cfg.get("tools", {}) as Dictionary).get(str(entry.get("tool_class", "")), {})
	# The class's ladder lifted so its stone tool gives one a blow (an axe's 0.5 to 2 becomes 1 to 2.5): every tier still breaks more than the one
	# below (tier consistency, coordinator 23 Nov 2026: stone, copper and bronze axes all gave one), never under one.
	var rate: float = maxf(float(rates.get(str(entry.get("material", "")), rates.get("stone", 1.0))) + maxf(1.0 - float(rates.get("stone", 1.0)), 0.0), 1.0)
	_wear_slot(peer, inv, tool, "rock")   # after reading the tool: one that breaks on this blow leaves its slot empty
	var part: float = float(state.get("part", 0.0)) + rate
	var stones: int = int(floor(part + 0.001))
	state["part"] = part - float(stones)
	state["taken"] = int(state["taken"]) + 1
	_mined[patch] = state
	var before: Array = _snapshot(inv)
	_take_in(peer, inv, table.number_of("stone"), stones)
	practice(peer, "mine_rock")

	_send_changes(peer, inv, before)
	_dirty = true


# Bracing supports (Dave 2026-10-22, BRACING_ITEMS.md): the strength they give the ground at a point, for the tunnel watch. Filed by square
# (finding 10, docs/ai-team/audits/2026-11-18_oversized_reactions_audit.md): a change re-files the supports only, and a query reads one square.
# `scan_all` (load, reset) looks through every world item for them; otherwise the ones _grid_add filed are read again, gone ones dropped.
func _rebuild_supports(scan_all: bool = false) -> void:
	if scan_all:
		_support_ids.clear()

		for id in _items:
			_note_support(id, _items[id])

	var entries: Array = []

	for id in _support_ids.keys():
		var it: Dictionary = _items.get(id, {})
		var support: Dictionary = _structures.get(str(it["struct"]["kind"]), {}).get("support", {}) if it.has("struct") else {}

		if support.is_empty():
			_support_ids.erase(id)   # taken down, or no longer a support
			continue

		entries.append([it["pos"], float(support["reach_m"]), float(support["strength"]), float(support["wear_game_days"]) * 86400.0, float(support.get("floor", 0.25)), float(it["struct"].get("born", 0.0))])

	var cells: Dictionary = _file_supports(entries)
	_supports_mutex.lock()
	_supports = cells
	_supports_mutex.unlock()


# Support entries [pos, reach_m, ...] filed into every SUPPORT_CELL_M square their sphere reaches into.
static func _file_supports(entries: Array) -> Dictionary:
	var cells: Dictionary = {}

	for entry in entries:
		var pos: Vector3 = entry[0]
		var reach: float = float(entry[1])

		for cx in range(floori((pos.x - reach) / SUPPORT_CELL_M), floori((pos.x + reach) / SUPPORT_CELL_M) + 1):
			for cz in range(floori((pos.z - reach) / SUPPORT_CELL_M), floori((pos.z + reach) / SUPPORT_CELL_M) + 1):
				var cell: Vector2i = Vector2i(cx, cz)

				if not cells.has(cell):
					cells[cell] = []

				cells[cell].append(entry)

	return cells


func _note_support(id: int, entry: Dictionary) -> void:
	if entry.has("struct") and _structures.get(str(entry["struct"]["kind"]), {}).has("support"):
		_support_ids[id] = true


# Support at `at`, 0 or 1 (Dave 2026-10-22, spheres of influence): each support covers a sphere of its reach_m radius at full health; the radius
# falls in step with its condition (1 when new, down to its floor over its wear time), so at half health it is half. Overlapping spheres cover
# the whole area; anywhere inside one is held (1), outside all of them is not (0). Safe to call from the tunnel watch's worker thread.
func support_strength_at(at: Vector3, now_game_s: float = -1.0) -> float:
	var now_s: float = _now_game_s() if now_game_s < 0.0 else now_game_s
	_supports_mutex.lock()
	var list: Array = _supports.get(Vector2i(floori(at.x / SUPPORT_CELL_M), floori(at.z / SUPPORT_CELL_M)), [])
	_supports_mutex.unlock()

	for entry in list:
		var worn: float = clampf((now_s - float(entry[5])) / maxf(float(entry[3]), 1.0), 0.0, 1.0)
		var condition: float = lerpf(1.0, float(entry[4]), worn)

		if (entry[0] as Vector3).distance_to(at) <= float(entry[1]) * condition:
			return 1.0

	return 0.0


# Placed foundations as {"pos", "state"} rows, for pieces to snap to.
# Foundations and building pieces, for PlacementRules.snap (anchors and joins).
func _foundation_rows() -> Array:
	var rows: Array = []

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and (bool(_structures.get(str(it["struct"]["kind"]), {}).get("foundation", false)) or bool(_structures.get(str(it["struct"]["kind"]), {}).get("piece", false))):
			rows.append({"pos": it["pos"], "state": int(_structures[str(it["struct"]["kind"])]["state"]), "yaw": float(it["struct"]["yaw"])})

	return rows


# A placeable item (the campfire kit) becomes a fire on the ground in front of the player.
const PLACE_EDITS_REACH_M := 16.0   # the saved ground edits read round a placement: the widest footprint and a 65 roof panel's run, with the edit spheres


const CAVE_PROBE_UP_M := 0.5   # a spot in a cave is looked for in the cave's air this far over the ghost's foot (as terrain_generator and server_carts CAVE_PROBE_UP_M)


# Where a thing let go at `p` comes to rest (round 7, 23 Nov 2026: a carcass or a regrown plant kept to the generated ground, floating over a
# dug pit or buried in a fill): the ground as dug and filled, or under it (in a cave or a dug tunnel) the floor of the air `p` is in. Cheap
# above that top (edited_ground keeps its cells); floor_below, a scan of the edits near, only under it. floor_below from inside rock answers
# at once just over the point (terrain_generator.floor_below): `p` is not in an open space, so the top.
func _ground_under(p: Vector3) -> float:
	var top: float = _ground_top(p.x, p.z)

	if is_nan(top) or p.y >= top - 0.05 or not floor_below.is_valid():
		return top

	var under: float = float(floor_below.call(p))
	return top if is_nan(under) or under > p.y + 0.05 else under


# Where a flight stepping from `from` to `to` comes down (round 7: arrows and thrown things kept to the generated ground, so over a pit they
# stopped in the air, in a fill they went in, and in a tunnel or a cave they came out on the hill above): Vector3.INF while it is still in
# the air (or there is no ground to know). From the open air over its own column it strikes the ground as dug and filled where it is (a pit's
# floor, a fill's top, a hillside), unless it went in at a tunnel's or a cave's mouth (open air under the top there). From under its column's top (a tunnel, a cave) it comes down to the floor of the open column under it,
# or, struck into the rock (a wall or the roof), to the floor where it last was in the open. A flight is only looked at after the step that
# took it into the rock, so the open air is read from `from`, never `to`.
func _landing(from: Vector3, to: Vector3) -> Vector3:
	var top: float = _ground_top(to.x, to.z)

	if is_nan(top) or to.y > top:
		return Vector3.INF

	var own: float = _ground_top(from.x, from.z)

	if not floor_below.is_valid() or is_nan(own) or from.y >= own - 0.05:
		if floor_below.is_valid() and to.y < top - 0.05:   # under the top from the open air: into a tunnel's or a cave's mouth, or into the rock
			var inside: float = float(floor_below.call(to))

			if not is_nan(inside) and inside <= to.y + 0.05:
				return Vector3(to.x, inside, to.z) if to.y <= inside else Vector3.INF

		return Vector3(to.x, top, to.z)   # from the open air: it struck the ground

	var under: float = float(floor_below.call(Vector3(to.x, from.y, to.z)))   # down to's column from the height it was last in the air

	if not is_nan(under) and under <= from.y + 0.05:
		if to.y <= under:
			return Vector3(to.x, under, to.z)

		var here: float = float(floor_below.call(to))

		if not is_nan(here) and here <= to.y + 0.05:
			return Vector3.INF   # still in the open air

	var floor_y: float = float(floor_below.call(from))   # struck into the rock: down where it last was in the open
	return Vector3(from.x, floor_y, from.z) if not is_nan(floor_y) and floor_y <= from.y + 0.05 else Vector3(to.x, top, to.z)


# The ground as dug and filled at (x, z), the top of its highest solid span; the generated ground where the server has not given it.
func _ground_top(x: float, z: float) -> float:
	if ground_now.is_valid():
		return float(ground_now.call(x, z))

	return float(ground_height.call(x, z)) if ground_height.is_valid() else NAN


# The ground under a spot: the cave floor when the spot is under the generated surface `surface` and in a cave's air, else `surface`.
func _cave_ground(at: Vector3, surface: float) -> float:
	if not cave_floor.is_valid() or is_nan(surface) or at.y >= surface - 0.05:
		return surface

	var floor_y: float = float(cave_floor.call(at + Vector3(0.0, CAVE_PROBE_UP_M, 0.0)))
	return surface if is_nan(floor_y) else floor_y


func _place(peer: int, inv, slot: int, at: Vector3, yaw_deg: int = 0, lift_steps: int = 0, blueprint: Dictionary = {}) -> void:
	var number: int = 0
	var kit_id: String = ""

	# Every refusal says why (Dave 5 Nov 2026: all items tell you what is wrong when they will not place): never a silent click.
	if not blueprint.is_empty():   # from the hammer: no kit item, the materials are checked here and taken with the piece
		if not _peer_pos.has(peer):
			_say(peer, "The game does not know where you are yet. Try again in a moment.")
			return

		if not _can_blueprint(peer, inv, blueprint):
			return   # _can_blueprint says why

		kit_id = _kit_of_blueprint(blueprint)
		number = table.number_of(kit_id) if blueprint.has("lays") else 0
	else:
		if slot < 0:
			_say(peer, "That blueprint is not in this game's list. Open the hammer or knife menu (right click) and pick it again.")   # an unknown blueprint number reaches here with no kit
			return

		if slot >= inv.slot_count or inv.numbers[slot] == 0:
			_say(peer, "There is nothing in that slot to place.")
			return

		if not _peer_pos.has(peer):
			_say(peer, "The game does not know where you are yet. Try again in a moment.")
			return

		number = inv.numbers[slot]
		kit_id = table.id_of(number)

		if not inv.inst_of(slot).is_empty():
			_say(peer, "That cannot be set down: a placed piece would lose what makes it special.")   # a structure row keeps no instance data
			return

	if kit_id != "campfire_kit" and (_structure_of_kit(kit_id).is_empty() or bool(_structure_of_kit(kit_id).get("hand_placed", false))):
		if _structure_of_kit(kit_id).is_empty():
			_say(peer, "That cannot be placed.")

		return      # a torch is placed from the hand (_place_torch), not as a kit

	if blueprint.is_empty() and is_dead_kit(number):
		# A kit that survived in a pack (Dave 5 Nov 2026: a Woven chest in the pack showed a ghost and the click did nothing): it turns back into the
		# materials of its blueprint, and the player is told to build it with the hammer. Never a silent refusal.
		var bp_number: int = int(_blueprint_of_kit.get(kit_id, 0))

		if bp_number > 0 and _refund_blueprint(peer, inv, _blueprints[bp_number]):
			inv.take_from_slot(slot, 1)
			_say(peer, "That old kit is gone. Its materials are back in your pack: build it with a hammer or a knife (right click for blueprints).")
			_dirty = true

		return

	if _peer_pos[peer].distance_to(at) > PLACE_REACH_M:
		_say(peer, "Too far to place that.")   # every refusal below says why, so the ghost doing nothing is never a mystery (Dave 31 Oct 2026)
		return

	if NpcCamp.within_keep(at):
		_say(peer, PlacementRules.reason_text(NpcCamp.keep_reason(at)).left(1).to_upper() + PlacementRules.reason_text(NpcCamp.keep_reason(at)).substr(1) + ".")   # the ghost's own rule (PlacementRules.blocked)
		return

	var on_grid: Array = PlacementRules.snap(_structures_cfg, kit_id, at, yaw_deg, _foundation_rows(), clampi(lift_steps, 0, 1))   # lift_steps is also a roof panel's rise (0) or fall (1) from where it rests
	at = on_grid[0]
	yaw_deg = int(on_grid[1])
	var on_base: bool = bool(on_grid[2])
	var lift: float = 0.0
	var panel: bool = str(_structure_of_kit(kit_id).get("piece_kind", "")) == PlacementRules.ROOF_PANEL_KIND

	if panel and not on_base:
		_say(peer, "A roof panel rests on a wall top, a ceiling edge or another panel's end.")   # never a panel standing free on the ground
		return

	var hip_kind: String = ""   # a roof corner's shape (its 45 row or its 65 twin, A-37): the panel beside it decides, else the wheel

	if str(_structure_of_kit(kit_id).get("piece_kind", "")) == PlacementRules.ROOF_HIP_KIND:
		var hip: Array = PlacementRules.roof_hip_pick(_structures_cfg, _structure_of_kit(kit_id), at, clampi(lift_steps, 0, 1), _foundation_rows()) if on_base else []

		if hip.is_empty():
			_say(peer, "A roof corner goes where two wall tops, ceiling edges or panel ends meet at a corner.")
			return

		hip_kind = str(hip[2])

	if str(_structure_of_kit(kit_id).get("attach_to", "")) == PlacementRules.DOOR_ATTACH:   # a door hangs in a doorway of its own shape (BUGLIST-002): `at` is that frame's spot, so it skips the ground checks like a platter on a table
		var fit: Dictionary = PlacementRules.doorway_fit(_structures_cfg, _structure_of_kit(kit_id), at, _foundation_rows())

		if str(fit["why"]) != "":
			var why: String = PlacementRules.reason_text(str(fit["why"]), str(fit["opening"]))
			_say(peer, why.left(1).to_upper() + why.substr(1) + ".")
			return

	if not on_base and bool(_structure_of_kit(kit_id).get("foundation", false)):
		lift = float(clampi(lift_steps, 0, PlacementRules.LIFT_MAX_STEPS)) * PlacementRules.LIFT_STEP_M   # the client sent the lifted height; the ground is checked below it
		at.y -= lift

	# The ground as the player left it (BugsList entry 2, Dave 18 Nov 2026): ground_height is the generated surface, so a site raised and levelled with the hoe
	# read as the old ground and a foundation on it was "too far above or below the ground". Every height check below reads the saved digs and fills too.
	var site_edits: Array = (edits_near.call(at, PLACE_EDITS_REACH_M) if edits_near.is_valid() else []) as Array
	var surface := func(x: float, z: float) -> float: return _edited_height(x, z, site_edits)

	# In a cave the ground under the piece is the cave floor (physical world audit round 6, 23 Nov 2026: the generated surface is the hill over it, so
	# every piece in a cave was refused as "too far above or below the ground" while the ghost showed it fits). A corner off the cave's air (in its
	# wall) reads the hill and the piece is refused as too steep, as on a rock face.
	var generated: float = float(ground_height.call(at.x, at.z)) if ground_height.is_valid() else NAN

	if not on_base and not is_nan(generated) and _cave_ground(at, generated) != generated:
		var cave_y: float = at.y
		surface = func(x: float, z: float) -> float:
			var floor_y: float = float(cave_floor.call(Vector3(x, cave_y + CAVE_PROBE_UP_M, z)))
			return _edited_height(x, z, site_edits) if is_nan(floor_y) else _edited_height(x, z, site_edits, floor_y)

	var ground: float = float(surface.call(at.x, at.z)) if ground_height.is_valid() else at.y

	if is_nan(ground):
		_say(peer, "The ground there is not ready yet. Try again in a moment.")   # the terrain under the ghost has not streamed in
		return

	if ground < PlacementRules.WET_GROUND_M:
		_say(peer, "The ground is too wet here.")   # the ghost's own rule (held_item "wet")
		return

	if PlacementRules.off_ground(_structures_cfg, kit_id, at.y, ground, on_base, on_grid.size() > 3) == "float":   # a piece on a foundation is exempt: the ground under it was the foundation's check (BUG-009)
		_say(peer, "You cannot place that there: %s." % PlacementRules.reason_text("float"))
		return

	var seat: float = ground if on_base or not ground_height.is_valid() else PlacementRules.seated_ground(_structures_cfg, kit_id, at, deg_to_rad(float(yaw_deg)), surface, ground)   # a station sits at the lowest ground under it: no corner in the air
	var spot: Vector3 = Vector3(at.x, at.y if on_base else seat + lift, at.z)

	if panel and ground_height.is_valid() and PlacementRules.roof_panel_buried(_structures_cfg, kit_id, spot, yaw_deg, surface):
		_say(peer, "That end of the roof panel would sink into the ground.")
		return

	if not on_base and not _structure_of_kit(kit_id).has("needs_running_water") and water_depth_at.is_valid() and PlacementRules.over_water(_structures_cfg, kit_id, spot, deg_to_rad(float(yaw_deg)), func(x, z): return float(water_depth_at.call(Vector3(x, spot.y, z)))):
		_say(peer, "You cannot build in water.")
		return

	if water_depth_at.is_valid() and PlacementRules.water_short(_structures_cfg, kit_id, spot, func(x, z): return float(water_depth_at.call(Vector3(x, spot.y, z)))):
		var trap_def: Dictionary = _structure_of_kit(kit_id)
		_say(peer, "A %s needs water at least %s m deep." % [table.sentence_name(table.number_of(str(trap_def.get("item", kit_id)))), str(float(trap_def["min_water_m"]))])
		return

	if not on_base and ground_height.is_valid() and PlacementRules.steep(_structures_cfg, kit_id, spot, deg_to_rad(float(yaw_deg)), surface) == "steep":
		_say(peer, "The ground is too steep there.")
		return

	if trunks_near.is_valid() and PlacementRules.over_trunk(_structures_cfg, kit_id, spot, deg_to_rad(float(yaw_deg)), trunks_near.call(spot, PlacementRules.footprint_reach(_structures_cfg, kit_id))):
		_say(peer, "A tree is in the way: fell it first.")
		return

	if kit_id != "campfire_kit":
		var placed_def: Dictionary = _structure_of_kit(kit_id)

		if hip_kind != "" and _structures.has(hip_kind):
			placed_def = _structures[hip_kind].duplicate()
			placed_def["kind"] = hip_kind

		if placed_def.has("needs_base_lift_m") or placed_def.has("needs_running_water"):
			spot = _station_site(peer, placed_def, spot, yaw_deg)

			if is_nan(spot.y):
				return

		_place_structure(peer, inv, slot, spot, yaw_deg, placed_def, blueprint if (not blueprint.is_empty() and not free_build) else {})   # every hammer placement is a blueprint site: nothing is taken, the hammer fills it (Dave 18 Nov 2026)
		return

	var chunk_fires: int = 0

	for id in _items:   # a pot with no fire under it takes a new fire laid beside it
		if _is_pot(_items[id]) and (_items[id]["pos"] as Vector3).distance_to(spot) <= POT_ATTACH_M and _fire_under_pot(_items[id]["pos"]) < 0:
			spot = _items[id]["pos"]
			break

	for id in _items:
		if _is_fire_site(_items[id]) and _chunk_of(_items[id]["pos"]) == _chunk_of(spot):
			chunk_fires += 1   # a campfire blueprint site is a fire to come; its gap is the structures' gap below

		if _items[id].has("fire"):
			if _items[id]["pos"].distance_to(spot) < _fire_gap_m:
				_say(peer, "Too close to another fire.")
				return

			if _chunk_of(_items[id]["pos"]) == _chunk_of(spot):
				chunk_fires += 1
		elif _items[id].has("struct") and _items[id]["pos"].distance_to(spot) < _struct_gap_m and PlacementRules.blocks_fire(_structures_cfg, int(_structures.get(str(_items[id]["struct"]["kind"]), {}).get("state", -1))):   # the ghost's own rule: a foundation is a floor the fire may stand on
			_say(peer, "Something is in the way.")
			return

	if chunk_fires >= _fires_per_chunk:
		_say(peer, "Too many fires here.")
		return

	if not blueprint.is_empty() and not free_build:   # with the hammer: a site that one or more players fill with hammer hits (_gather_site)
		_place_fire_site(peer, spot, blueprint)
		return

	if blueprint.is_empty():
		inv.take_from_slot(slot, 1)

	_lay_fire(peer, number, spot)


# A laid fire (state 9) at `spot`, as a Campfire set down from the pack leaves it or a finished campfire blueprint becomes it (number: the Campfire).
func _lay_fire(peer: int, number: int, spot: Vector3) -> void:
	var covered: bool = cover_at.is_valid() and float(cover_at.call(spot)) > 0.5
	_items[_next_id] = {"number": number, "count": 1, "pos": spot, "left": FIRE_LAID_S, "fire": {"state": 9, "burn_left": 0.0, "wood": {"log": 0.0, "firewood": 0.0, "weak": 0.0}, "covered": covered, "recheck": COVER_RECHECK_S, "synced": true}}
	_zone_add(_next_id)
	var laid_fire: Dictionary = _items[_next_id]["fire"]
	var start_sticks: int = _fire_start_sticks()   # a fresh fire holds its first sticks in its store, where Dave sees them
	_fire_store(laid_fire).add(table.number_of("stick"), start_sticks)
	_fire_apply_store(laid_fire, _fire_store(laid_fire))
	_next_id += 1
	_dirty = true
	_goal_event(peer, "placed", "campfire")   # the fire hint and goals count a laid fire


# A campfire blueprint site (structures.json "fire_site"): drawn as a blue cold fire, filled by hammer hits, never a fire until it is finished.
func _is_fire_site(it: Dictionary) -> bool:
	return it.has("struct") and bool(_structures.get(str(it["struct"]["kind"]), {}).get("fire_site", false))


func _place_fire_site(peer: int, spot: Vector3, row: Dictionary) -> void:
	var entry: Dictionary = {"number": table.number_of(_kit_of_blueprint(row)), "count": 1, "pos": spot, "left": 1.0e9,
		"struct": {"kind": str(row["structure"]), "yaw": 0.0, "owner": str(_peer_key.get(peer, "")), "site": {"bp": int(row["number"]), "have": {}}}}
	_items[_next_id] = entry
	_grid_add(_next_id, entry)
	_bare_skirts_near(entry["pos"], 1.0)
	_next_id += 1
	_say(peer, "Blueprint down. Hit it with a hammer to add the materials.")
	_dirty = true


# Placement rules of a station that stands on a tall foundation over running water (the sawmill, Dave 2026-10-22): it needs a foundation under it
# lifted at least needs_base_lift_m off the ground, and the water at its wheel (structures.json needs_running_water, offsets from the middle,
# turned with the piece) running along the wheel's span. Returns the spot on the foundation top, or a NAN y after telling the player why.
func _station_site(peer: int, def: Dictionary, spot: Vector3, yaw_deg: int) -> Vector3:
	var lift_need: float = float(def.get("needs_base_lift_m", 0.0))

	if lift_need > 0.0:
		var found: bool = false

		for row in _foundation_rows():
			var base: Dictionary = PlacementRules.structure_of_state(_structures_cfg, int(row["state"]))

			if base.is_empty() or not bool(base.get("foundation", false)):
				continue

			if not PlacementRules.holds(base, row, spot):   # its footprint at its turn (a foundation may face any way)
				continue

			var under: float = float(ground_height.call(row["pos"].x, row["pos"].z)) if ground_height.is_valid() else row["pos"].y

			if row["pos"].y - under >= lift_need - 0.02:
				spot = Vector3(spot.x, row["pos"].y + float(base.get("top_m", 0.3)), spot.z)
				found = true
				break

		if not found:
			_say(peer, "It needs a tall foundation (lifted %.1f m or more)." % lift_need)
			return Vector3(spot.x, NAN, spot.z)

	if def.has("needs_running_water") and water_wheel.is_valid():
		var wheel: Dictionary = _wheel_at(def, spot, yaw_deg)
		var rules: Dictionary = _water_flow_rules()
		var least: float = float(rules.get("min_power_w", 150.0))
		var why: String = str(wheel.get("why", ""))

		if why != "" or float(wheel.get("w", 0.0)) < least:
			_say(peer, WHEEL_SAYS.get(why, "") if why != "" else ("Turn the wheel across the current." if bool(wheel.get("along", false)) else "The wheel would give only %d W here; the saw needs %d W. Find faster or deeper water." % [int(round(float(wheel["w"]))), int(least)]))
			return Vector3(spot.x, NAN, spot.z)

		_say(peer, "The wheel would give %d %% (%d W)." % [int(round(100.0 * WaterFlowScript.wheel_share(float(wheel["w"]), rules))), int(round(float(wheel["w"])))])

	return spot


# The sawmill ghost asks what its wheel would give where it stands (protocol 105): the same rule as placing (_station_site), answered with the
# share in percent and why it would be refused ("along" turned along the current, "weak" under min_power_w).
func _wheel_ask(peer: int, yaw_deg: int, kit_number: int, at: Vector3) -> void:
	var def: Dictionary = _structure_of_kit(table.id_of(kit_number))

	# A water piece's ghost (a barrel, a tank, a well...) asks the same way: the answer is placing's own refusal (_water_refusal: a loop, too many
	# sources, no ground water), percent -1, so a green ghost always places (hands-on screens, 23 Nov 2026: these showed green and were refused).
	if not def.has("needs_running_water") and send_wheel_share.is_valid() and not water_piece(def, at, float(posmod(yaw_deg, 360))).is_empty():
		if not at.is_finite() or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(at) > PLACE_REACH_M:
			return   # only where it could be placed (placing refuses farther first): no far reads of the ground water for a moving ghost

		var judged: Array = _water_ghost_spot(def, at, yaw_deg)
		send_wheel_share.call(peer, at, yaw_deg, -1, _water_refusal(def, judged[0], int(judged[1])))
		return

	if not def.has("needs_running_water") or not water_wheel.is_valid() or not send_wheel_share.is_valid():
		return

	var wheel: Dictionary = _wheel_at(def, at, yaw_deg)
	var rules: Dictionary = _water_flow_rules()
	var why: String = str(wheel.get("why", ""))

	if why == "" and float(wheel.get("w", 0.0)) < float(rules.get("min_power_w", 150.0)):
		why = "along" if bool(wheel.get("along", false)) else "weak"

	send_wheel_share.call(peer, at, yaw_deg, 0 if why != "" else int(round(100.0 * WaterFlowScript.wheel_share(float(wheel["w"]), rules))), why)


# Where placing judges a water piece the ghost stands at (`at`, turned `yaw_deg`): snapped as _place snaps it, set down on the lowest ground under
# it (seated_ground over the dug and filled ground) unless it stands on a foundation, then onto a pipe's end or joint (_tank_spot_on_pipe), as
# _place_structure does before _water_refusal. [spot, yaw]. shortcut: in a cave the ghost's own height (the cave floor it stands on) is kept,
# not seated over the cave floor's corners as _place does; keep this beside _place's own steps if they change.
var _ghost_rows: Array = []          # the foundation rows the water ghost snaps to, read at most every GHOST_ROWS_MS (a whole-world walk)
var _ghost_rows_msec: int = -100000
const GHOST_ROWS_MS := 1000


func _water_ghost_spot(def: Dictionary, at: Vector3, yaw_deg: int) -> Array:
	var kit_id: String = str(def.get("kit", ""))

	if Time.get_ticks_msec() - _ghost_rows_msec >= GHOST_ROWS_MS:
		_ghost_rows = _foundation_rows()
		_ghost_rows_msec = Time.get_ticks_msec()

	var on_grid: Array = PlacementRules.snap(_structures_cfg, kit_id, at, yaw_deg, _ghost_rows, 0)
	var spot: Vector3 = on_grid[0]
	var yaw: int = int(on_grid[1])

	if not bool(on_grid[2]) and ground_height.is_valid():
		var site_edits: Array = (edits_near.call(spot, PLACE_EDITS_REACH_M) if edits_near.is_valid() else []) as Array
		var surface := func(x: float, z: float) -> float: return _edited_height(x, z, site_edits)
		var ground: float = float(surface.call(spot.x, spot.z))
		var generated: float = float(ground_height.call(spot.x, spot.z))

		if not is_nan(ground) and _cave_ground(spot, generated) == generated:   # in a cave the hill's ground is not under it
			spot.y = PlacementRules.seated_ground(_structures_cfg, kit_id, spot, deg_to_rad(float(yaw)), surface, ground)

	return [_tank_spot_on_pipe(str(def.get("kind", "")), spot, yaw), yaw]


const WHEEL_SAYS := {
	"dry": "The wheel needs running water under all of it.",
	"river": "The wheel must stand over a river.",
	"still": "The water does not run here. The wheel needs a current.",
	"shallow": "The water is too shallow for the wheel (0.4 m or more).",
}


# The water wheel of a station that needs running water (structures.json needs_running_water: its span's ends, offsets from the middle, turned
# with the piece) standing at `spot` turned `yaw_deg`: WaterFlow.wheel's {"w", "why", "along"}.
func _wheel_at(def: Dictionary, spot: Vector3, yaw_deg: float) -> Dictionary:
	var water: Dictionary = def.get("needs_running_water", {})
	var turn: float = deg_to_rad(yaw_deg)
	var from_local: Vector2 = Vector2(float(water["from"][0]), float(water["from"][1])).rotated(turn)
	var to_local: Vector2 = Vector2(float(water["to"][0]), float(water["to"][1])).rotated(turn)
	return water_wheel.call(Vector3(spot.x + from_local.x, spot.y, spot.z + from_local.y), Vector3(spot.x + to_local.x, spot.y, spot.z + to_local.y))


var _water_flow_cfg: Dictionary = {}
var _wheel_stations: Dictionary = {}   # station name -> true when a structure serving it needs running water (the sawmill), filled on first ask


func _wheel_station(station: String) -> bool:
	if not _wheel_stations.has(station):
		_wheel_stations[station] = false

		for kind in _structures:
			if str(_structures[kind].get("station", "")) == station and (_structures[kind] as Dictionary).has("needs_running_water"):
				_wheel_stations[station] = true

	return bool(_wheel_stations[station])


func _water_flow_rules() -> Dictionary:
	if _water_flow_cfg.is_empty():
		_water_flow_cfg = WaterFlowScript.load_rules()

	return _water_flow_cfg


# How much slower a station recipe runs at a sawmill whose wheel gives less than full_power_w (Sonny section 10: craft time x full_power_w / P).
# The wheel's watts are worked out once per placed sawmill and kept on it ("wheel_w"); 1.0 for every other station, or with no wheel callable.
func _wheel_slow(peer: int, recipe: Dictionary) -> float:
	var station: String = str(recipe.get("station", ""))

	if station == "" or not (water_wheel.is_valid() and _wheel_station(station)):
		return 1.0

	var id: int = serving_station(peer, station, int(recipe.get("station_level", 1)))

	if id < 0:
		return 1.0

	var watts: float = _wheel_watts(_items[id])
	return 1.0 if watts < 0.0 else 1.0 / WaterFlowScript.wheel_share(watts, _water_flow_rules())


# How much slower a saw recipe (one that keeps "saw", any saw) runs for the saw in the pack (TREE_WOOD_TOOLS_DESIGN.md s5: items.json saw_speed, Copper 0.5,
# Bronze 0.75, Iron 1.0, Steel 1.25; the saw the craft wears counts, the first on the hotbar) and, for a recipe marked "sawbuck" (every hand-saw recipe:
# Wooden blocks, Planks, Hardwood boards; Dave 17 Nov 2026 "if there is a saw buck around it will use that for cutting faster", W-33), at a
# Sawbuck in reach, which saws twice as fast (W-4). serving_station walks the world items like any station recipe's check, once a tick for a sawing peer.
func _saw_slow(peer: int, recipe: Dictionary) -> float:
	var saw_n: int = table.number_of("saw")
	var saws: bool = false

	for keep in recipe.get("keeps", []):
		saws = saws or int(keep[0]) == saw_n

	if not saws:
		return 1.0

	var inv = inventory_of(peer)
	var slot: int = _craft_tool_slot(inv, "saw") if inv != null else -1   # the saw the craft wears (wears_tool "saw": the hotbar's first, else the pack's)
	var speed: float = float(table.entry(table.id_of(int(inv.numbers[slot]))).get("saw_speed", 1.0)) if slot >= 0 else 1.0
	var slow: float = 1.0 / maxf(speed, 0.1)
	return slow * (0.5 if bool(recipe.get("sawbuck", false)) and serving_station(peer, "sawbuck") >= 0 else 1.0)   # a Sawbuck in reach speeds every hand-saw recipe (W-33)


# A placed piece's water wheel share in percent of full power (Sonny section 10: P / full_power_w, floored at min_power_w), or -1 for a piece with no
# wheel (structures.json needs_running_water) or a blueprint site. The watts are worked out once per piece and kept on it ("wheel_w"). Sent on the
# piece's world row ("wheel") so looking at a sawmill shows what its wheel gives.
func wheel_percent(it: Dictionary) -> int:
	var watts: float = _wheel_watts(it)
	return -1 if watts < 0.0 else int(round(100.0 * WaterFlowScript.wheel_share(watts, _water_flow_rules())))


# A placed wheel piece's watts, or -1 for a piece with no wheel. Kept on the piece ("wheel_w") only when the water answered (why ""): a mill first asked
# before its tile's settled water is in memory (a saved mill sent at the join) reads "dry" and 0 W, and keeping that would saw at the floor share for
# good (Sonny's review of #1009); it is asked again next time instead.
func _wheel_watts(it: Dictionary) -> float:
	if not it.has("struct") or it["struct"].has("site") or not water_wheel.is_valid():
		return -1.0

	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

	if not def.has("needs_running_water"):
		return -1.0

	if it["struct"].has("wheel_w"):
		return float(it["struct"]["wheel_w"])

	var wheel: Dictionary = _wheel_at(def, it["pos"], float(it["struct"].get("yaw", 0.0)))
	var watts: float = float(wheel.get("w", 0.0))

	if str(wheel.get("why", "")) == "":
		it["struct"]["wheel_w"] = watts

	return watts


# The admin showroom (Dave 2026-10-23): the rows of data/items/showroom.json laid out east and south of the spawn point as REAL world items
# (pick up, use, inspect). An upsert by key (row label + index): what is missing is placed, what is there stays, so a fill never flickers.
# Never saved and never despawned; the admin fills it again after a restart. clear = true removes them all first (the respawn button).
func _showroom_seed(peer: int, clear: bool, origin: Vector3) -> void:
	if not showroom_enabled or not ground_height.is_valid():
		_say(peer, "The showroom is off here.")
		return

	if clear:
		for id in _items.keys():
			if _items[id].has("showroom"):
				_items.erase(id)

	_showroom_todo.clear()
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(SHOWROOM_PATH))
	var rows: Array = parsed["rows"] if parsed is Dictionary and parsed.get("rows") is Array else []
	var there: Dictionary = {}

	for id in _items:
		if _items[id].has("showroom"):
			there[str(_items[id]["showroom"])] = true

	var planned: int = 0

	for row in rows:
		var start: Array = row.get("start", [0, 0])
		var step: Array = row.get("step", [0, 1.5])
		var at: Vector3 = origin + Vector3(float(start[0]), 0.0, float(start[1]))
		var index: int = 0

		for entry in row.get("items", []):
			var key: String = "%s|%d" % [str(row.get("label", "")), index]
			var number: int = table.number_of(str(entry[0]))
			index += 1

			if number > 0 and not there.has(key) and planned < SHOWROOM_CAP:
				_showroom_todo.append([key, number, maxi(int(entry[1]) if entry.size() > 1 else 1, 1), at])
				planned += 1
			elif number <= 0:
				print("Showroom: unknown item '%s' in row '%s' skipped" % [str(entry[0]), str(row.get("label", ""))])

			at += Vector3(float(step[0]), 0.0, float(step[1]))

	print("Showroom: peer %d %s, %d to place" % [peer, "respawned it" if clear else "filled it", _showroom_todo.size()])
	var placed: int = _showroom_place()
	_say(peer, "Showroom: %d items placed, %d waiting for the ground to load." % [placed, _showroom_todo.size()])


# Places the planned items whose ground is in memory; the rest stay planned and are tried again.
func _showroom_place() -> int:
	var placed: int = 0
	var left: Array = []

	for plan in _showroom_todo:
		var spot: Vector3 = plan[3]

		if ground_ready.is_valid() and not bool(ground_ready.call(spot.x, spot.z)):
			left.append(plan)
			continue

		var ground: float = float(ground_height.call(spot.x, spot.z))

		if is_nan(ground):
			left.append(plan)
			continue

		_items[_next_id] = {"number": int(plan[1]), "count": int(plan[2]), "pos": Vector3(spot.x, ground, spot.z), "left": 1.0e9, "wear": 0, "showroom": str(plan[0])}
		_next_id += 1
		placed += 1

	_showroom_todo = left
	return placed


func _showroom_retry(delta: float) -> void:
	if _showroom_todo.is_empty():
		return

	_showroom_wait += delta

	if _showroom_wait >= 2.0:
		_showroom_wait = 0.0
		_showroom_place()


# Fires burn down; open fires are put out by rain (Dave, 2026-10-20), covered ones are not.
# The slow tick's parts that look for a few kinds of item (fires, lights, pots, items that age) each walked every world item, about six passes
# every SLOW_TICK_S, growing with everything ever dropped or built (audit 18 Nov 2026, docs/ai-team/audits/2026-11-18_oversized_reactions_audit.md
# finding 3). Now each part walks its own list. An item is on a list by what it is, never by a state that changes in place, so no state drops off:
#   fires:  every item with a fire (laid, lit, coals, warm ash, cold, kept for its charcoal), whatever its state;
#   lit:    every structure of a kind that can be lit (a light, a kiln, a smelter, anything with a fuel) and any with a "lit" field, lit or not;
#   pots:   every structure that hangs over a fire;
#   ageing: every fire and every item with a lifetime (a kept pile never gains one in place since 23 Nov 2026; _tick_ageing stays as a guard).
# The lists are sorted from every item once every TICK_INDEX_TICKS slow ticks, and items made since (world ids only grow) are sorted in on each
# tick from their ids alone. Each part checks the item again, as the full walk did. Outside the tick (tests, a placement) _tick_list is every id,
# as before. test_tick_lists runs the old walk and the lists side by side and compares every item after each tick.
const TICK_INDEX_TICKS := 8   # a full sort every 8 slow ticks (2 s): only to drop the ids gone or no longer on a list
var _tick_ids: Dictionary = {}
var _tick_index_kept: Dictionary = {}   # the last full sort: {"fires", "lit", "pots": [ids], "ageing": {id: true}, "upto": first id not sorted, "ticks": slow ticks since}
var _tick_lists_off: bool = false       # tests: the old walk over every item, to compare


func _tick_index() -> Dictionary:
	if _tick_lists_off:
		return {}

	if _tick_index_kept.is_empty() or int(_tick_index_kept["ticks"]) >= TICK_INDEX_TICKS or int(_tick_index_kept["upto"]) > _next_id:
		_tick_index_kept = {"fires": [], "lit": [], "pots": [], "ageing": {}, "upto": _next_id, "ticks": 0}

		for id in _items:
			_sort_into(_tick_index_kept, id)

		return _tick_index_kept

	_tick_index_kept["ticks"] = int(_tick_index_kept["ticks"]) + 1
	_tick_sort_new()
	return _tick_index_kept


# The ids made since the lists were last brought up to date, sorted in: at the start of the tick and again whenever a part asks for its
# list, so an item made by an earlier part of the same tick (charcoal a light or a fire leaves) is tended by the later parts, as the full walk did.
func _tick_sort_new() -> void:
	if int(_tick_index_kept["upto"]) < _next_id:
		for id in range(int(_tick_index_kept["upto"]), _next_id):
			if _items.has(id):
				_sort_into(_tick_index_kept, id)

		_tick_index_kept["upto"] = _next_id


var _litable_kind: Dictionary = {}   # structure kind -> whether it can be lit (_sort_into)


func _sort_into(index: Dictionary, id) -> void:
	var it: Dictionary = _items[id]

	if it.has("fire"):
		index["fires"].append(id)

	if it.has("struct"):
		var kind: String = str(it["struct"].get("kind", ""))

		if not _litable_kind.has(kind):
			var def: Dictionary = _structures.get(kind, {})
			_litable_kind[kind] = def.has("fuel") or def.has("fuel_s") or def.has("smelt") or bool(def.get("lights", false)) or str(def.get("use", "")) in ["light", "kiln"]

		if bool(_litable_kind[kind]) or it["struct"].has("lit"):
			index["lit"].append(id)

		if _is_pot(it):
			index["pots"].append(id)

	if not it.has("scatter") and (it.has("fire") or float(it["left"]) <= 1.0e8):
		index["ageing"][id] = true


# An item given a lifetime in place ages from this tick on. A kept pile added to or taken from stays kept (23 Nov 2026), so today only a guard.
func _tick_ageing(id) -> void:
	if not _tick_index_kept.is_empty() and _items.has(id) and not _items[id].has("scatter"):
		_tick_index_kept["ageing"][id] = true


# A copy, as _items.keys() was: what the part makes while it walks waits for the next part or tick, as before.
func _tick_list(kind: String) -> Array:
	if _tick_ids.is_empty():
		return _items.keys()

	_tick_sort_new()
	return (_tick_ids[kind] as Dictionary).keys() if kind == "ageing" else (_tick_ids[kind] as Array).duplicate()


func _fires(delta: float) -> void:
	_refresh_pots()

	for id in _tick_list("fires"):
		if not _items.has(id):
			continue   # gone since the list was made

		var it: Dictionary = _items[id]

		if not it.has("fire"):
			continue

		var fire: Dictionary = it["fire"]

		if fire.has("camp"):
			continue   # Edda and Hob's fire burns as it is: no wood runs down, no rain puts it out

		var rain_v: float = _rain_here(it["pos"])   # the rain where it burns: snow on a mountain puts no fire out
		var raining: bool = rain_v >= RAIN_PUTS_OUT

		if fire.has("uid"):
			_tend_fire(id, it, fire, delta)

		if not fire_is_lit(int(fire["state"])):
			_fire_embers(it, fire, delta, raining)
			continue

		# Wet wood in it (fire design 5): a tier lower in heat and light while it is wet, back up once it has dried.
		var damp: bool = _fire_damp(fire)

		if damp != bool(fire.get("damp_on", false)):
			fire["damp_on"] = damp
			fire["state"] = _fire_best_state(fire)
			_lit_valid = false

		# A large fire on a coal bed burns on through rain of any strength, uncovered (fire design 4): faster in heavy rain, and smoking.
		# Wet wood burns wet_burn_x as long.
		var rain_proof: bool = _fire_rain_proof(fire)
		var in_rain: bool = raining and not bool(fire["covered"])
		var heavy: bool = rain_proof and in_rain and rain_v >= float(_coals_cfg().get("rain_burn_from", 0.6))
		var pace: float = (float(_coals_cfg().get("rain_burn_x", 1.25)) if heavy else 1.0) / (maxf(float(table.wet_wood().get("wet_burn_x", 1.5)), 0.1) if damp else 1.0)
		_fire_burn(fire, delta * pace)
		_fire_leave_charcoal(id, it, fire)
		fire["lit_s"] = float(fire.get("lit_s", 0.0)) + delta   # the coal bed builds while it burns
		var smoke: int = 1 if (rain_proof and in_rain) or damp else 0

		if smoke != int(fire.get("smoke", 0)):
			fire["smoke"] = smoke   # the row is sent again (fire design 5: thick smoke while it burns wet)

		if bool(fire.get("synced", false)) and fire.has("uid") and _chests.has(int(fire["uid"])) and _fire_trim_store(fire, _chests[int(fire["uid"])]):
			_push_box(id, _chests[int(fire["uid"])])   # burned wood leaves the store; whoever has it open sees it go

		fire["recheck"] -= delta

		if fire["recheck"] <= 0.0:
			fire["recheck"] = COVER_RECHECK_S
			fire["covered"] = cover_at.is_valid() and float(cover_at.call(it["pos"])) > 0.5

		if fire["burn_left"] <= 0.0:
			_fire_burnt_out(it, fire)
			_dirty = true

			fire.erase("burnt")
			fire.erase("counted")

			if bool(fire.get("synced", false)) and fire.has("uid") and _chests.has(int(fire["uid"])) and _fire_clear_wood(_chests[int(fire["uid"])]):
				_push_box(id, _chests[int(fire["uid"])])   # burnt out: the last piece is ash too, so it cannot be counted again when the store is closed
		elif raining and not fire["covered"] and not _fire_rain_proof(fire):
			var grace: float = float(fire.get("rain_grace", 0.0)) - delta   # lit a moment ago in the rain: it burns until the grace is up

			if grace > 0.0:
				fire["rain_grace"] = grace
			else:
				fire.erase("rain_grace")
				fire.erase("lit_s")   # rained out: the coals are drowned too
				fire.erase("smoke")
				_wet_fire_wood(fire)   # and the wood left in it is wet
				fire["state"] = 9
				it["left"] = FIRE_LAID_S
				_dirty = true
				_lit_valid = false   # out: the vitals' fire list is kept a quarter second now (_vitals_spread)


# Item lifetimes run down; an item whose time is up goes, except coals and warm ash, which run on to their next stage, and a fire still holding charcoal (_fire_expire).
func _expire_items(spent: float) -> void:
	for id in _tick_list("ageing"):
		if not _items.has(id):
			continue   # gone since the list was made

		if _items[id].has("scatter") or float(_items[id]["left"]) > 1.0e8 or _items[id].get("inst", {}).has("bag"):
			continue   # a dropped bag that holds anything never despawns, so its contents are never lost (master s3.9 rule 3); empty, it ages as any item

		_items[id]["left"] -= spent

		if _items[id]["left"] <= 0.0:
			if not _fire_expire(_items[id]):
				_items.erase(id)

			_dirty = true


# A fire's world row extra: its burn time, smoke 1 while a large fire burns on in the rain, and, for coals and warm ash, glow (1 fresh .. 0 at
# the end of that stage).
func _fire_extra(it: Dictionary) -> Dictionary:
	if it["fire"].has("camp"):
		if it["fire"].has("tracks"):
			return {"camp": 2, "marks": true, "tracks": it["fire"]["tracks"]}   # a bandit camp's boot prints leading off the road (a mark, no pit drawn)

		return {"camp": 2 if typeof(it["fire"]["camp"]) == TYPE_STRING else 1}   # a camp fire (1 Edda and Hob's or a goblin tribe's, 2 a bandit camp's): the client offers nothing on it and shows no burn time (PROTOCOL.md, world-item rows)

	var extra: Dictionary = {"burn": snappedf(float(it["fire"]["burn_left"]), 0.1)}
	var state: int = int(it["fire"]["state"])

	if int(it["fire"].get("smoke", 0)) > 0 and fire_is_lit(state):
		extra["smoke"] = int(it["fire"]["smoke"])

	if state == FIRE_STATE_COALS or state == FIRE_STATE_ASH:
		extra["glow"] = snappedf(_fire_glow(it), 0.01)

	return extra


func _fire_glow(it: Dictionary) -> float:
	var state: int = int(it["fire"]["state"])

	if state != FIRE_STATE_COALS and state != FIRE_STATE_ASH:
		return 0.0

	var total: float = float(_coals_cfg().get("coals_s" if state == FIRE_STATE_COALS else "ash_s", 7200.0 if state == FIRE_STATE_COALS else 43200.0))
	return clampf(float(it["left"]) / maxf(total, 1.0), 0.0, 1.0)


# After the flames (docs/design/fire_coals_design.md 3, coordinator decision 8 Nov 2026, Dave may revert): a fire that burned coals.coal_bed_s since
# it was last cold leaves coals; a shorter one is cold ash at once, as before.
func _coals_cfg() -> Dictionary:
	return _cooking.get("coals", {})


func _fire_burnt_out(it: Dictionary, fire: Dictionary) -> void:
	var cfg: Dictionary = _coals_cfg()
	_lit_valid = false
	fire.erase("rain_grace")
	fire.erase("smoke")

	if not cfg.is_empty() and float(fire.get("lit_s", 0.0)) >= float(cfg.get("coal_bed_s", 600.0)):
		fire["state"] = FIRE_STATE_COALS
		it["left"] = float(cfg.get("coals_s", 7200.0))
		fire.erase("wet_s")
		return

	_fire_cold(it, fire)


# --- Wet wood (docs/design/fire_coals_design.md 5, step 3; coordinator decision 8 Nov 2026, Dave may revert; cooking.json wet_wood) ---
# A wood item's slot wear is its drying left in tenths of a game hour. A fire keeps "damp", the wettest wood in it: its store's wettest wood, or
# for a fire with no store the wettest piece laid on, drying with it.

func _fire_damp(fire: Dictionary) -> bool:
	return int(fire.get("damp", 0)) > 0


# The slot of this item with the most drying left (the wettest piece goes on the fire first), or -1.
func _wettest_slot(inv, number: int) -> int:
	var best: int = -1

	for slot in range(inv.slot_count):
		if inv.numbers[slot] == number and inv.counts[slot] > 0 and (best < 0 or inv.wear[slot] > inv.wear[best]):
			best = slot

	return best


# The fire's kindling is all wet: its weak wood (or, with none, all its wood) is wet and no dry tinder is in it.
func _fire_wet_kindling(fire: Dictionary) -> bool:
	var box = _chests.get(int(fire.get("uid", 0))) if bool(fire.get("synced", false)) else null

	if box == null:
		return _fire_damp(fire)

	var tinder: Array = [str(_cooking.get("tinder", "plant_fibre"))] + (_cooking.get("tinder_also", []) as Array)
	var weak_seen: bool = false
	var weak_dry: bool = false
	var any_dry: bool = false

	for slot in range(box.usable):
		var number: int = box.numbers[slot]

		if number == 0:
			continue

		if tinder.has(table.id_of(number)) and int(box.wear[slot]) == 0:
			return false   # dry tinder catches whatever the rest is

		var cls: String = table.wood_class(number)

		if cls == "":
			continue

		any_dry = any_dry or int(box.wear[slot]) == 0

		if cls == "weak":
			weak_seen = true
			weak_dry = weak_dry or int(box.wear[slot]) == 0

	return not weak_dry if weak_seen else (_fire_damp(fire) and not any_dry)


# A store fire's damp: the most drying left of the wood in its store.
func _fire_store_damp(fire: Dictionary, box) -> void:
	var damp: int = 0

	for slot in range(box.usable):
		if box.numbers[slot] != 0 and table.wood_class(box.numbers[slot]) != "":
			damp = maxi(damp, int(box.wear[slot]))

	fire["damp"] = damp


# Every wood slot of an inventory wetted to its class's full wet time; true when anything changed.
func _wet_inventory(inv) -> bool:
	var changed: bool = false

	for slot in range(inv.slot_count):
		var full: int = table.wet_units(inv.numbers[slot]) if inv.numbers[slot] != 0 else 0

		if full > int(inv.wear[slot]):
			inv.wear[slot] = full
			changed = true

	return changed


# Every wood slot of an inventory dried by `units`; true when anything changed.
func _dry_inventory(inv, units: int) -> bool:
	var changed: bool = false

	if units <= 0:
		return false

	for slot in range(inv.slot_count):
		if inv.numbers[slot] != 0 and int(inv.wear[slot]) > 0 and table.wood_class(inv.numbers[slot]) != "":
			inv.wear[slot] = maxi(int(inv.wear[slot]) - units, 0)
			changed = true

	return changed


# The rain on an unlit fire (or one it just put out): its wood is wet.
func _wet_fire_wood(fire: Dictionary) -> void:
	var box = _chests.get(int(fire.get("uid", 0))) if bool(fire.get("synced", false)) else null

	if box != null:
		if _wet_inventory(box):
			_fire_store_damp(fire, box)
			_dirty = true

		return

	if float(fire.get("burn_left", 0.0)) <= 0.0:
		return

	var wood: Dictionary = _fire_wood(fire)
	var full: int = 0

	for cls in ["log", "firewood", "weak"]:
		if float(wood.get(cls, 0.0)) > 0.0:
			full = maxi(full, int(round(float((table.wet_wood().get("wet_h", {}) as Dictionary).get(cls, 0.0)) * 10.0)))

	if full > int(fire.get("damp", 0)):
		fire["damp"] = full
		_dirty = true


# Every tick_s: rain wets loose wood lying uncovered and the wood of unlit uncovered fires; everywhere else wood dries, in a lit fire's store or
# within its heat reach fire_dry_x as fast. Packs and chests keep wood dry.
func _wood_tick(spent: float) -> void:
	var cfg: Dictionary = table.wet_wood()

	if cfg.is_empty():
		return

	_wood_in += spent

	if _wood_in < float(cfg.get("tick_s", 15.0)):
		return

	_wood_acc += _wood_in * GAME_RATE / 360.0   # tenths of a game hour
	_wood_in = 0.0
	var units: int = int(_wood_acc)
	_wood_acc -= float(units)
	var fire_x: int = maxi(int(round(float(cfg.get("fire_dry_x", 6.0)))), 1)
	var rain_from: float = float(cfg.get("rain_from", 0.2))   # rain where each piece lies (_rain_here): snow up a mountain wets no wood
	var peer_of_key: Dictionary = {}

	for peer in _peer_key:
		peer_of_key[_peer_key[peer]] = peer

	for key in _inventories:
		var peer: int = int(peer_of_key.get(key, 0))
		var before: Array = _snapshot(_inventories[key]) if peer != 0 else []

		if _dry_inventory(_inventories[key], units):
			_dirty = true

			if peer != 0:
				_send_changes(peer, _inventories[key], before)

	var fire_box: Dictionary = {}

	for id in _items:
		if _items[id].has("fire") and _items[id]["fire"].has("uid"):
			fire_box[int(_items[id]["fire"]["uid"])] = id

	for uid in _chests:
		if not fire_box.has(uid) and _dry_inventory(_chests[uid], units):
			_dirty = true

	var heat: Array = []

	for row in _heat_rows():   # lit campfires and lit Fireplaces and braziers dry the wood round them alike
		heat.append([row[0], float((row[1] as Dictionary).get("heat_radius_m", 4.0))])

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("fire"):
			if not it["fire"].has("camp"):   # the camp fire holds no wood
				_wood_tick_fire(id, it, units, fire_x, _rain_here(it["pos"]) >= rain_from)

			continue

		if it.has("struct") or it.has("tree") or it.has("boulder") or it.has("scatter") or table.wood_class(int(it["number"])) == "":
			continue

		var full: int = table.wet_units(int(it["number"]))

		if _rain_here(it["pos"]) >= rain_from and not (cover_at.is_valid() and float(cover_at.call(it["pos"])) > 0.5):
			if int(it.get("wear", 0)) < full:
				it["wear"] = full
				_dirty = true
		elif int(it.get("wear", 0)) > 0:
			var x: int = 1

			for h in heat:
				if (h[0] as Vector3).distance_to(it["pos"]) <= float(h[1]):
					x = fire_x
					break

			it["wear"] = maxi(int(it["wear"]) - units * x, 0)
			_dirty = true


func _wood_tick_fire(id: int, it: Dictionary, units: int, fire_x: int, raining: bool) -> void:
	var fire: Dictionary = it["fire"]
	var lit: bool = fire_is_lit(int(fire["state"]))
	var box = _chests.get(int(fire.get("uid", 0))) if bool(fire.get("synced", false)) else null
	var tracked: bool = lit or int(fire["state"]) == FIRE_STATE_COALS or int(fire["state"]) == FIRE_STATE_ASH   # these keep fire["covered"] fresh (_fires)
	var covered: bool = bool(fire.get("covered", false)) if tracked else (cover_at.is_valid() and float(cover_at.call(it["pos"])) > 0.5)

	if raining and not covered and not lit:
		_wet_fire_wood(fire)
		return

	var x: int = fire_x if lit else 1

	if box != null:
		if _dry_inventory(box, units * x):
			_fire_store_damp(fire, box)
			_push_box(id, box)
			_dirty = true
	elif int(fire.get("damp", 0)) > 0:
		fire["damp"] = maxi(int(fire["damp"]) - units * x, 0)
		_dirty = true


# A large fire (state 41) with a coal bed (coals.coal_bed_s burned since it was last cold) is not put out by rain (fire design 4, coordinator
# decision 8 Nov 2026). Small and medium fires, and a large one lit a moment ago, go out as before; once a large fire's logs are gone it is
# medium again and the rain takes it.
func _fire_rain_proof(fire: Dictionary) -> bool:
	var large: bool = int(fire["state"]) == FIRE_STATE_BONFIRE or (fire_is_lit(int(fire["state"])) and _fire_damp(fire) and _fire_best_state(fire, false) == FIRE_STATE_BONFIRE)   # a log fire held a tier down by wet wood is still a log fire
	return large and not _coals_cfg().is_empty() and float(fire.get("lit_s", 0.0)) >= float(_coals_cfg().get("coal_bed_s", 600.0))


# Coals run out (or are rained out) to warm ash.
func _fire_to_ash(it: Dictionary, fire: Dictionary) -> void:
	fire["state"] = FIRE_STATE_ASH
	it["left"] = float(_coals_cfg().get("ash_s", 43200.0))

	for key in ["lit_s", "wet_s", "catch"]:   # the coal bed is spent: warm ash lit again needs coal_bed_s more burning to leave coals
		fire.erase(key)
	_lit_valid = false
	_dirty = true


# The fire is cold: cold ash (8) for FIRE_OUT_S, or a laid fire (9) when wood is in it.
func _fire_cold(it: Dictionary, fire: Dictionary) -> void:
	for key in ["lit_s", "wet_s", "catch", "kept"]:
		fire.erase(key)

	if float(fire.get("burn_left", 0.0)) > 0.0:
		fire["state"] = 9
		it["left"] = FIRE_LAID_S
	else:
		fire["state"] = 8
		it["left"] = FIRE_OUT_S

	_lit_valid = false
	_dirty = true


# The item expiry loop found a fire's time run out: coals go on to warm ash, warm ash to cold, a fire holding charcoal stays. False for anything else (it is then removed).
func _fire_expire(it: Dictionary) -> bool:
	if not it.has("fire"):
		return false

	var state: int = int(it["fire"]["state"])

	if state == FIRE_STATE_COALS:
		_fire_to_ash(it, it["fire"])
		return true

	if state == FIRE_STATE_ASH:
		_fire_cold(it, it["fire"])
		return true

	if _fire_keeps_charcoal(it["fire"]):
		if not bool(it["fire"].get("kept", false)):   # cold ash holding charcoal waits charcoal_left.keep_s for the player, once
			it["fire"]["kept"] = true
			it["left"] = float((_cooking.get("charcoal_left", {}) as Dictionary).get("keep_s", 86400.0))
			return true

		# "kept" is saved (world item fire row [18]), so a restart does not give an abandoned fire a second wait.
		var box = _chests[int(it["fire"]["uid"])]
		var c: int = table.number_of("charcoal")
		drop_in_world(c, box.count_of(c), it["pos"] + Vector3(0.6, 0.0, 0.0))   # nobody came for it: it is left on the ground and the fire goes
		box.remove(c, box.count_of(c))

	_fire_spill_store(it)
	return false


# A fire that goes (cold too long, or laid and never lit) leaves what its store still held beside it: food left cooking and spare wood are never
# deleted with it. The store itself goes with the fire. A player's fire leaves its Campfire kit's parts too, as an empty fire picked up does
# (_kit_parts: 16 stones, 2 sticks; coordinator 23 Nov 2026: the kit vanished with it); a camp's pit was never a kit.
func _fire_spill_store(it: Dictionary) -> void:
	if not it["fire"].has("camp") and int(it.get("number", 0)) == table.number_of("campfire_kit"):
		for pair in _kit_parts(int(it["number"]), _fire_start_sticks()):
			drop_in_world(int(pair[0]), int(pair[1]), it["pos"] + Vector3(-0.6, 0.0, 0.0))

	var uid: int = int(it["fire"].get("uid", 0))
	var box = _chests.get(uid)

	if box == null:
		return

	for slot in box.slot_count:
		if box.numbers[slot] != 0 and box.counts[slot] > 0:
			drop_in_world(box.numbers[slot], box.counts[slot], it["pos"] + Vector3(0.6, 0.0, 0.0), box.wear[slot], 0.0, NAN, NAN, "", box.inst_of(slot))

	_chests.erase(uid)


# Coals and warm ash between ticks: rain of RAIN_PUTS_OUT or more on them uncovered turns coals to ash after coals.rain_s and ash cold after a further
# ash_rain_s; out of that rain, wood laid on coals catches by itself after coals.catch_s (by its biggest wood) and the fire is back at its size.
func _fire_embers(it: Dictionary, fire: Dictionary, delta: float, raining: bool) -> void:
	var state: int = int(fire["state"])

	if state != FIRE_STATE_COALS and state != FIRE_STATE_ASH:
		return

	var cfg: Dictionary = _coals_cfg()
	fire["recheck"] = float(fire.get("recheck", 0.0)) - delta

	if float(fire["recheck"]) <= 0.0:
		fire["recheck"] = COVER_RECHECK_S
		fire["covered"] = cover_at.is_valid() and float(cover_at.call(it["pos"])) > 0.5

	if raining and not bool(fire.get("covered", false)):
		fire["wet_s"] = float(fire.get("wet_s", 0.0)) + delta
		fire.erase("catch")

		if state == FIRE_STATE_COALS and float(fire["wet_s"]) >= float(cfg.get("rain_s", 120.0)):
			_fire_to_ash(it, fire)
		elif state == FIRE_STATE_ASH and float(fire["wet_s"]) >= float(cfg.get("ash_rain_s", 600.0)):
			_fire_cold(it, fire)

		return

	if state != FIRE_STATE_COALS or float(fire.get("burn_left", 0.0)) <= 0.0:
		return

	fire["catch"] = float(fire.get("catch", 0.0)) + delta

	if float(fire["catch"]) >= _fire_catch_s(fire):
		fire.erase("catch")
		fire["state"] = _fire_best_state(fire)
		it["left"] = 1.0e9
		_lit_valid = false
		_dirty = true


# How long wood laid on coals takes to catch: the time for the biggest wood class in the fire (coals.catch_s).
func _fire_catch_s(fire: Dictionary) -> float:
	var wood: Dictionary = _fire_wood(fire)
	var times: Dictionary = _coals_cfg().get("catch_s", {})

	for cls in ["log", "firewood", "weak"]:
		if float(wood.get(cls, 0.0)) > 0.0:
			return float(times.get(cls, 45.0))

	return float(times.get("weak", 10.0))


# Edda and Hob's camp fire (Dave 17 Nov 2026, data/npcs/camp.json): a large fire that is laid at every start (it is never saved) as soon as the
# ground under it is known, and laid again if anything clears it (an admin world reset). It holds no wood and burns as it is (_fires skips it).
var _camp_fire_ids: Dictionary = {}   # index in NpcCamp.fires() -> world id of that camp fire
var camp_fire_on: bool = false   # set by the server scene; unit tests that never ask for it see no camp fire in their world


# Every camp fire (NpcCamp.fires(): Edda and Hob's, then each goblin tribe's camp, Dave 19 Nov 2026) is laid once its ground is known.
func _camp_fire_tick() -> void:
	if not camp_fire_on or not ground_height.is_valid():
		return

	var fires: Array = NpcCamp.fires()

	for k in fires.size():
		var laid: Dictionary = _items.get(int(_camp_fire_ids.get(k, 0)), {}).get("fire", {})

		if typeof(laid.get("camp")) == TYPE_INT and int(laid["camp"]) == k:   # this fire still stands (its id may be reused after a world reset, even by another camp fire)
			continue

		var spot: Vector2 = Vector2(float(fires[k]["x"]), float(fires[k]["z"]))

		if ground_ready.is_valid() and not bool(ground_ready.call(spot.x, spot.y)):
			continue   # its ground is still being read in the background: never read a tile on the main thread here

		var y: float = float(ground_height.call(spot.x, spot.y))

		if is_nan(y):
			continue   # the ground there is not made yet: the next slow tick tries again

		var state: int = int(((_cooking.get("fire_tiers", {}) as Dictionary).get(str(fires[k]["wood"]), {}) as Dictionary).get("state", FIRE_STATE_BONFIRE))
		_items[_next_id] = {"number": table.number_of("campfire_kit"), "count": 1, "pos": Vector3(spot.x, y, spot.y), "left": 1.0e9,
			"fire": {"state": state, "burn_left": 1.0e9, "camp": k, "covered": true, "recheck": COVER_RECHECK_S}}
		_camp_fire_ids[k] = _next_id
		_lit_valid = false
		_zone_add(_next_id)   # nothing wild spawns round it (no_spawn_m), as round any fire
		_next_id += 1


# True (after telling the player) when `it` is a camp fire (Edda and Hob's, or a goblin tribe's): nobody feeds, lights, puts out, cooks on, opens or picks it up.
func _camp_refuses(peer: int, it: Dictionary) -> bool:
	if not it.get("fire", {}).has("camp"):
		return false

	if typeof(it["fire"]["camp"]) == TYPE_STRING:
		_say(peer, "That is the bandits' fire. It is not yours to tend.")   # a bandit camp's fire: "camp" holds its site key
		return true

	var fires: Array = NpcCamp.fires()
	var k: int = int(it["fire"]["camp"])
	var owner: String = str(fires[k]["owner"]) if k >= 0 and k < fires.size() else "Edda and Hob's"
	_say(peer, "That is %s fire. It is not yours to tend." % owner)
	return true


# The goblin tribes' camp pieces (NpcCamp.props(): a chest, racks and benches round their fire, Dave 20 Nov 2026), laid like the camp fires: transient
# pieces marked with the tribe, never saved, laid again at every start and again whenever one is gone. Nothing in them: no store, so nobody loots
# the chest; _tribe_piece_refuses turns away every take-down, use, repair and lock, and serving_station skips them.
var _tribe_prop_ids: Dictionary = {}   # index in NpcCamp.props() -> world id of that piece


func _tribe_props_tick() -> void:
	if not camp_fire_on or not ground_height.is_valid():
		return

	var props: Array = NpcCamp.props()

	for k in props.size():
		var laid: Dictionary = _items.get(int(_tribe_prop_ids.get(k, 0)), {}).get("struct", {})

		if str(laid.get("tribe", "")) == str(props[k]["tribe"]) and int(laid.get("prop", -1)) == k:
			continue

		var def: Dictionary = _structures.get(str(props[k]["kind"]), {})

		if def.is_empty():
			continue

		var spot: Vector2 = Vector2(float(props[k]["x"]), float(props[k]["z"]))

		if ground_ready.is_valid() and not bool(ground_ready.call(spot.x, spot.y)):
			continue   # its ground is still being read in the background: never read a tile on the main thread here

		var y: float = float(ground_height.call(spot.x, spot.y))

		if is_nan(y):
			continue

		var entry: Dictionary = {"number": table.number_of(str(def.get("item", props[k]["kind"]))), "count": 1, "pos": Vector3(spot.x, y, spot.y), "left": 1.0e9,
			"struct": {"kind": str(props[k]["kind"]), "yaw": float(props[k]["yaw"]), "transient": true, "tribe": str(props[k]["tribe"]), "prop": k}}
		_items[_next_id] = entry
		_grid_add(_next_id, entry)
		_tribe_prop_ids[k] = _next_id
		_next_id += 1


# True (after telling the player) when world item `id` is a goblin tribe's camp piece: it belongs to the camp, not to anyone who walks up.
func _tribe_piece_refuses(peer: int, id: int) -> bool:
	if not _items.get(id, {}).get("struct", {}).has("tribe"):
		return false

	var tribe: String = str(_items[id]["struct"]["tribe"])
	var holds: String = str(tribe_stock_line.call(tribe, str(_items[id]["struct"].get("kind", "")))) if tribe_stock_line.is_valid() else ""
	_say(peer, ("That belongs to %s." % NpcCamp.camp_name_of(tribe)) + (" " + holds if holds != "" else ""))
	return true


# A bandit camp (server_bandits.gd stage 2, docs/design/BANDIT_CAMPS.md): its fire burns like Edda and Hob's (never saved, no wood, nobody tends
# it; "camp" holds the site's key) and its Lean-tos (open sides `yaw`) are transient pieces marked "bandit", never saved or taken down, laid
# again at every start from the site's row, and again over old_ids (what is left of its last laying) when a piece is gone. Returns the world ids laid.
func lay_bandit_camp(key: String, fire: Vector3, lean_tos: Array, old_ids: Array = [], tracks: Array = [], tracks_at: Vector3 = Vector3.INF) -> Array:
	clear_bandit_camp(key, old_ids)   # what is left of this camp's last laying (a world reset takes the fire, keeps transient Lean-tos): laid whole again
	var ids: Array = []
	var state: int = int(((_cooking.get("fire_tiers", {}) as Dictionary).get(NpcCamp.fire_wood(), {}) as Dictionary).get("state", FIRE_STATE_BONFIRE))
	var pit: bool = not tracks.is_empty() or lean_tos.is_empty()   # the warnings (stage 3): a cold fire pit with boot tracks from the road, no Lean-tos
	_items[_next_id] = {"number": table.number_of("campfire_kit"), "count": 1, "pos": fire, "left": 1.0e9,
		"fire": {"state": FIRE_STATE_COLD if pit else state, "burn_left": 0.0 if pit else 1.0e9, "camp": key, "covered": true, "recheck": COVER_RECHECK_S}}

	_zone_add(_next_id)
	ids.append(_next_id)
	_next_id += 1

	if not tracks.is_empty() and tracks_at.x != INF:   # the prints hang on a mark at the road (a pit 100 to 300 m off it is not sent to travellers)
		_items[_next_id] = {"number": table.number_of("campfire_kit"), "count": 1, "pos": tracks_at, "left": 1.0e9,
			"fire": {"state": FIRE_STATE_COLD, "burn_left": 0.0, "camp": key, "marks": true, "tracks": tracks.slice(0, BANDIT_TRACKS_MAX), "covered": true, "recheck": COVER_RECHECK_S}}
		_zone_add(_next_id)
		ids.append(_next_id)
		_next_id += 1

	var def: Dictionary = _structures.get("lean_to", {})

	for row in lean_tos:
		var entry: Dictionary = {"number": table.number_of(str(def.get("item", "lean_to"))), "count": 1, "pos": row[0], "left": 1.0e9, "struct": {"kind": "lean_to", "yaw": float(row[1]), "transient": true, "bandit": key}}
		_items[_next_id] = entry
		_grid_add(_next_id, entry)
		ids.append(_next_id)
		_next_id += 1

	_lit_valid = false
	return ids


# Takes away what is laid of a bandit camp (only pieces still marked with its key: an id reused since is left alone).
func clear_bandit_camp(key: String, ids: Array) -> void:
	for id in ids:
		var old: Dictionary = _items.get(int(id), {})

		if str(old.get("struct", {}).get("bandit", "")) == key or str(old.get("fire", {}).get("camp", "")) == key:
			_items.erase(int(id))
			_lit_valid = false


# True while every piece of a laid bandit camp still stands (a world reset takes its fire: the camp is laid again).
func bandit_camp_there(ids: Array) -> bool:
	for id in ids:
		if not _items.has(id) or not (_items[id].has("fire") or bool(_items[id].get("struct", {}).has("bandit"))):
			return false

	return true


# E on a burning fire puts it out (Dave 2 Nov 2026). It goes back to a laid fire with its wood kept, the same as when rain puts it out, so it can be lit again.
func _put_out_fire(peer: int, id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("fire") or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(it["pos"]) > FIRE_USE_M or _camp_refuses(peer, it):
		return

	var fire: Dictionary = it["fire"]

	if not fire_is_lit(int(fire["state"])):
		return

	fire["state"] = 9
	fire.erase("lit_s")   # put out: the coals are put out too
	it["left"] = FIRE_LAID_S
	_dirty = true


# Hold E on a fire that is not burning picks it up again (Dave 2 Nov 2026): as a campfire kit while its store holds just its first sticks, as the
# kit's parts less those sticks once it is empty (_give_kit_parts). Refused with a reason while it burns, while a pot hangs on it, or while its
# wood and food store (F) holds anything else.
func _pick_up_fire(peer: int, inv, id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("fire") or not _peer_pos.has(peer) or _camp_refuses(peer, it):
		return

	if _peer_pos[peer].distance_to(it["pos"]) > Interact.server_reach_m():
		_reject_far(peer)
		return

	var fire: Dictionary = it["fire"]

	if fire_is_lit(int(fire["state"])):
		_say(peer, "Let the fire burn out first.")
		return

	if bool(fire.get("pot", false)):
		_say(peer, "Take the pot down first.")
		return

	var box = _chests.get(int(fire.get("uid", 0)))
	var stick: int = table.number_of("stick")
	var start: int = _fire_start_sticks()
	var kit: int = table.number_of("campfire_kit")
	var whole: bool = box != null and box.count_of(stick) == start and _box_holds_only(box, stick)   # its first sticks are still in it: they go back into the kit

	if box != null and not box.is_empty() and not whole:
		_say(peer, "Empty it first, or leave just its %d sticks to pack it up as a Campfire." % start)
		return

	if whole:
		if _fit(peer, inv, kit, 1) == 0 or inv.add(kit, 1) > 0:
			_say(peer, "Too heavy to carry any more")
			return
	elif not _give_kit_parts(peer, inv, kit, start):
		return

	_chests.erase(int(fire.get("uid", 0)))
	_items.erase(id)
	_dirty = true


# The sticks a freshly laid fire holds in its store (_place): its kit's first fuel, start_burn_game_s of burning.
func _fire_start_sticks() -> int:
	var stick_s: float = float((_cooking.get("fuel", {}) as Dictionary).get("stick", 2880.0))
	return maxi(1, int(round(float(_cooking.get("start_burn_game_s", 3600.0)) / maxf(stick_s, 1.0))))


func _box_holds_only(box, number: int) -> bool:
	for i in box.slot_count:
		if box.numbers[i] != 0 and box.numbers[i] != number:
			return false

	return true


# An empty fire picked up (its first sticks taken out or burnt): what the Campfire kit was made of, less those sticks, comes back, never a whole
# kit, which would give its sticks again on the next laying (to-do sweep 23 Nov 2026: lay, take the sticks, pick up, lay again made sticks
# without end). All or nothing; false (and the player told) when it does not fit.
func _give_kit_parts(peer: int, inv, kit: int, start: int) -> bool:
	var parts: Array = _kit_parts(kit, start)

	if parts.is_empty():   # no recipe makes the kit (retired or renamed): the fire stays, never lost for nothing
		_say(peer, "Empty it first.")
		return false

	var trial = inv.copy()

	for pair in parts:
		if _fit(peer, trial, int(pair[0]), int(pair[1])) < int(pair[1]) or trial.add(int(pair[0]), int(pair[1])) > 0:
			_say(peer, "Too heavy to carry any more")
			return false

	for pair in parts:
		inv.add(int(pair[0]), int(pair[1]))

	return true


# What a Campfire kit was made of less its first sticks (in the fire's store, or burnt): [[number, count], ...], empty when no recipe makes it.
func _kit_parts(kit: int, start: int) -> Array:
	var makers: Array = recipes.makers_of(kit) if recipes != null else []
	var parts: Array = []

	for need in (recipes.recipe(int(makers[0])).get("needs", []) if not makers.is_empty() else []):
		var count: int = int(need[1]) - (start if int(need[0]) == table.number_of("stick") else 0)

		if count > 0:
			parts.append([int(need[0]), count])

	return parts


func _pickup(peer: int, inv, id: int, wanted: int = 0) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.has("struct"):
		_take_down(peer, inv, id)
		return

	if it.has("fire"):
		_pick_up_fire(peer, inv, id)
		return

	if it.is_empty() or it.has("tree") or it.has("boulder") or not _peer_pos.has(peer):
		return

	if _peer_pos[peer].distance_to(it["pos"]) > Interact.server_reach_m():
		_reject_far(peer)
		return

	if is_shoulder_item(int(it["number"])):
		if _shoulder_full(peer):
			_say(peer, CarryRules.logs_full_say(_carry_cfg))
			return

		if _fit(peer, inv, int(it["number"]), 1, it.get("inst", {})) == 0:
			_say(peer, "Too heavy to carry any more")
			return

		var took: int = _give_shoulder(peer, int(it["number"]), 1, it.get("inst", {}), false)

		if took > 0:
			if int(it["count"]) > 1:
				it["count"] = int(it["count"]) - 1
			else:
				_items.erase(id)

		return

	var batch: int = int((_batch_cfg.get("batch", {}) as Dictionary).get(table.id_of(int(it["number"])), 0))

	if batch > 0 and int(it.get("wear", 0)) == 0 and not it.has("inst"):
		_pickup_batch(peer, inv, id, batch)
		return

	# A pile gives a handful (or the count the client asks for), anything smaller is taken whole.
	var want: int = int(it["count"])

	if want >= PILE_MIN:
		want = mini(want, wanted if wanted > 0 else int(table.entry(table.id_of(int(it["number"]))).get("pile", {}).get("handful", PILE_HANDFUL)))

	want = mini(want, table.COUNT_MAX)   # one action moves at most a full stack's worth; the rest stays on the ground
	var fits: int = _fit(peer, inv, int(it["number"]), want, it.get("inst", {}))

	if fits == 0:
		_say(peer, "Too heavy to carry any more")
		_reject(peer, 2)
		return

	var over: int = inv.add(int(it["number"]), fits, int(it.get("wear", 0)), it.get("inst", {}))   # what the pack had no slot for (at MAX_SLOTS)
	var got: int = fits - over

	if got == 0:
		_say(peer, "Your pack is full")
		_reject(peer, 2)
		return

	if over > 0:
		_say(peer, "Your pack is full: you took %d of %d" % [got, want])
	elif fits < want:   # the carry limit stops it part way: say so, as a take from a store does (weights loop, 23 Nov 2026)
		_say(peer, "Too heavy: you took %d of %d" % [got, want])

	var left: int = int(it["count"]) - got

	if it.has("scatter"):   # natural scatter is found, not dropped (goal got: counter)
		_goal_got(peer, int(it["number"]), int(it["count"]) - left)

	_take_from(id, int(it["count"]) - left)


# `n` of the ground item `id` were picked up: it holds fewer, or is gone with its last (a natural scatter one stays gone).
func _take_from(id: int, n: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or n <= 0:
		return

	var left: int = int(it["count"]) - n

	if left <= 0:
		if it.has("scatter"):
			_taken[it["scatter"]] = true

		_items.erase(id)
	else:
		it["count"] = left

		if left >= PILE_MIN and float(it["left"]) <= 1.0e8:   # a never-expiring heap stays so when some is taken
			it["left"] = PILE_LIFETIME_S
			_tick_ageing(id)

	_dirty = true


# Sticks and leaves come up in batches (Dave 10 Nov 2026: "when you pick up the sticks and leaves by holding down the E key it picks them up in batches
# of 10 or 20"): one E takes up to `batch` of the item, from the heap picked and then the nearest heaps of the same item within gather_m of it (and in
# reach), as much as the carry limit and the pack allow. Refused (reason 2) only when none at all could be taken.
func _pickup_batch(peer: int, inv, id: int, batch: int) -> void:
	var it: Dictionary = _items[id]
	var number: int = int(it["number"])
	var fits: int = _fit(peer, inv, number, mini(batch, table.COUNT_MAX))

	if fits == 0:
		_say(peer, "Too heavy to carry any more")
		_reject(peer, 2)
		return

	var gather_m: float = float(_batch_cfg.get("gather_m", 2.5))
	var reach: float = Interact.server_reach_m()
	var heaps: Array = [[0.0, id]]

	for other_id in _items:
		var other: Dictionary = _items[other_id]

		if other_id == id or int(other.get("number", 0)) != number or int(other.get("wear", 0)) != 0 or other.has("inst"):
			continue

		if other.has("showroom") or other.has("struct") or other.has("fire") or other.has("tree") or other.has("boulder"):
			continue

		var flat: float = Vector2(other["pos"].x - it["pos"].x, other["pos"].z - it["pos"].z).length()

		if flat <= gather_m and _peer_pos[peer].distance_to(other["pos"]) <= reach:
			heaps.append([flat, other_id])

	heaps.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
	var wanted: int = fits
	var taken: int = 0
	var full: bool = false
	var lying: int = 0   # how many lie in reach: more than `fits` there means the carry limit, not the heaps, cut the take

	for heap in heaps:
		lying += int(_items[heap[1]]["count"])

	for heap in heaps:
		if wanted <= 0:
			break

		var share: int = mini(int(_items[heap[1]]["count"]), wanted)
		var over: int = inv.add(number, share, 0)

		if _items[heap[1]].has("scatter"):   # natural scatter is found, not dropped (goal got: counter)
			_goal_got(peer, number, share - over)

		_take_from(int(heap[1]), share - over)
		taken += share - over
		wanted -= share - over

		if over > 0:
			full = true
			break   # the pack is at MAX_SLOTS

	if taken == 0:
		if full:
			_say(peer, "Your pack is full")
		_reject(peer, 2)
	elif full:
		_say(peer, "Your pack is full: you took %d" % taken)
	elif fits < mini(batch, table.COUNT_MAX) and lying > fits:   # held E on sticks at the limit: say why it stopped, as a single pick-up does
		_say(peer, "Too heavy: you took %d of %d" % [taken, mini(batch, mini(lying, table.COUNT_MAX))])


# `fresh` empty: the full sync (every SYNC_EVERY_S), which files every record in the grid. Otherwise a road's quick sync (_road_tick, every
# ROAD_SYNC_S while a road builds): only the records `fresh` names are looked at, for only the players within 1.5 NEAR_M of a spot in `near_to`,
# so one road no longer runs the whole world's sync four times a second (audit 18 Nov 2026 finding 4). A quick sync files nothing in the grid
# (the road's ids came after the full sync, and _ids_near adds every such id); it drops a record from a player's list only when it is gone from
# the world, and bog rows and everything else wait for the full sync.
#
# The full sync by change (SERVER_SCALE.md item 4, 26 Nov 2026). The rocks thread measured it growing with the world's records: 21 ms a sync
# at 2,098 records and 32 players, 167 ms at 15,334, 297 ms at 28,184 (/mnt/project-files/rock_measure.txt), because each player looked at
# every record in the nine NEAR_M cells round them, each second. Now the records are also filed in FINE_M cells, and each cell's records are
# summed into one number (the ids and their signatures, the same for every player). A cell wholly within a player's NEAR_M and the same as
# the last time that player looked is skipped whole: nothing in it changed and all of it is near. Only the cells on the edge of a player's
# NEAR_M, the cells that changed, and the cells with something that is different for each player (a building site's list, a smelter's
# bellows) are looked at record by record, as before. What is sent is the same as before, row for row.
func _sync_world_items(fresh: Array = [], near_to: Array = []) -> void:
	if not fresh.is_empty():
		_sync_quick(fresh, near_to)
		return

	# The records are filed into a NEAR_M grid once (other lookups read it: _ids_near) and a FINE_M grid (this sync's cells).
	var t_grid: int = Time.get_ticks_usec()
	var send_usec: int = 0
	var bog_usec: int = 0
	_bog_build_usec = 0
	_bog_built = 0
	var sent: int = 0
	var looked: int = 0     # records looked at one by one, for all players
	var skipped: int = 0    # cells skipped whole, for all players
	var grid: Dictionary = {}
	var fine: Dictionary = {}
	var lit: Array = []
	_site_memo = {}   # each player's on-hand counts for the sites' lists, worked out once this sync (_site_view)
	var rec_memo: Dictionary = {}   # world id -> _sync_record, worked out once this sync for every player near it
	var infos: Dictionary = {}      # fine cell -> [sum, every record the same for every player, lowest y, highest y], once this sync
	var cell_ids: Dictionary = {}   # fine cell -> its ids, still and rest, once this sync
	_site_cells_due = true   # filed at the first building site a player sees this sync (_site_memo_of), not every sync: a walk of every record

	_still_file()

	for id in _rest.keys():
		if not _items.has(id):
			_rest.erase(id)   # gone
			continue

		var it: Dictionary = _items[id]
		var at: Vector3 = it["pos"]
		var cell: Vector2i = Vector2i(int(floor(at.x / NEAR_M)), int(floor(at.z / NEAR_M)))
		var fc: Vector2i = Vector2i(int(floor(at.x / FINE_M)), int(floor(at.z / FINE_M)))

		if it.has("fire") and fire_is_lit(int(it["fire"]["state"])):
			lit.append([at, fire_tier_of(int(it["fire"]["state"]))])

		if not grid.has(cell):
			grid[cell] = [id]
		else:
			grid[cell].append(id)

		if not fine.has(fc):
			fine[fc] = [id]
		else:
			fine[fc].append(id)

	for cell in _still_near:   # the still records, filed already: their ids first in each cell
		grid[cell] = (_still_near[cell] as Dictionary).keys() + grid[cell] if grid.has(cell) else (_still_near[cell] as Dictionary).keys()

	var t_scan: int = Time.get_ticks_usec()
	_sync_grid = grid
	_sync_grid_next = _next_id
	_far_fire_spots = lit
	var reach2: float = NEAR_M * NEAR_M

	for peer in _sync_seen.keys():
		if not _known.has(peer):
			_sync_seen.erase(peer)   # gone

	for peer in _known:
		if not _peer_pos.has(peer):
			continue

		var here: Vector3 = _peer_pos[peer]
		var known: Dictionary = _known[peer]
		var seen: Dictionary = _seen_of(peer)
		var cells_seen: Dictionary = seen["cells"]
		var where: Dictionary = seen["where"]
		var held: Dictionary = seen["in"]
		var added: Array = []
		var removed: PackedInt32Array = PackedInt32Array()
		var near: Dictionary = {}
		var whole: Dictionary = {}   # cells skipped whole this time: all of their records stay near and known
		var x0: int = int(floor((here.x - NEAR_M) / FINE_M))
		var x1: int = int(floor((here.x + NEAR_M) / FINE_M))
		var z0: int = int(floor((here.z - NEAR_M) / FINE_M))
		var z1: int = int(floor((here.z + NEAR_M) / FINE_M))

		for cx in range(x0, x1 + 1):
			var west: float = float(cx) * FINE_M - here.x
			var east: float = west + FINE_M
			var gap_x: float = maxf(maxf(west, -east), 0.0)
			var far_x: float = maxf(absf(west), absf(east))

			for cz in range(z0, z1 + 1):
				var fc: Vector2i = Vector2i(cx, cz)
				var ids: Array = cell_ids.get(fc, [])

				if not cell_ids.has(fc):
					ids = (_still_fine[fc] as Dictionary).keys() if _still_fine.has(fc) else []

					if fine.has(fc):
						ids.append_array(fine[fc])

					cell_ids[fc] = ids

				if ids.is_empty():
					continue

				var south: float = float(cz) * FINE_M - here.z
				var north: float = south + FINE_M
				var gap_z: float = maxf(maxf(south, -north), 0.0)

				if gap_x * gap_x + gap_z * gap_z > reach2:
					continue   # no part of the cell is within NEAR_M

				var far_z: float = maxf(absf(south), absf(north))
				var inside: bool = false
				var info: Array = []

				if far_x * far_x + far_z * far_z <= reach2:
					info = infos.get(fc, [])

					if info.is_empty():
						info = _cell_info(ids, rec_memo)
						infos[fc] = info

					var dy: float = maxf(absf(float(info[2]) - here.y), absf(float(info[3]) - here.y))
					inside = bool(info[1]) and far_x * far_x + far_z * far_z + dy * dy <= reach2

				if inside and cells_seen.get(fc, -1) == info[0]:
					whole[fc] = true
					skipped += 1
					continue   # the same as the last time this player looked, and all of it near

				if inside:
					cells_seen[fc] = info[0]
				else:
					cells_seen.erase(fc)

				var got: Dictionary = held.get(fc, {})

				if got.is_empty():
					held[fc] = got

				for id in ids:
					if not _items.has(id):
						continue   # a still record taken since it was filed (the check drops it from its cell)

					var it: Dictionary = _items[id]
					looked += 1

					if not inside and it["pos"].distance_to(here) > NEAR_M:
						continue

					near[id] = true

					if not where.has(id) or where[id] != fc:
						if where.has(id):
							(held[where[id]] as Dictionary).erase(id)

						where[id] = fc
						got[id] = true

					if not it.has("struct") and not it.has("fire") and not it.has("tree"):
						var plain: int = _plain_sig(it)   # loose things and rocks: the same signature, without _sync_record

						if not known.has(id) or known[id] != plain:
							var loose_rec: Array = rec_memo.get(id, [])

							if loose_rec.is_empty():
								loose_rec = _sync_record(int(id), it)
								rec_memo[id] = loose_rec

							added.append(_sync_row(peer, int(id), it, loose_rec, []))
							known[id] = plain

						continue

					var rec: Array = rec_memo.get(id, [])

					if rec.is_empty():
						rec = _sync_record(int(id), it)
						rec_memo[id] = rec

					var signature: int = int(rec[1])
					var bellows_by: int = int(rec[5])
					var site_view: Array = []

					if bellows_by >= 0:
						signature += 523 * (2 if bellows_by == peer else 1)   # someone starts or stops working a smelter's bellows: sent again

					if it.has("struct") and it["struct"].has("site"):
						site_view = _site_view(peer, it)   # this player's own list: what is still needed and what they have to put in (Dave 5 Nov 2026)
						signature += 37

						for line in site_view:
							signature += 101 * int(line[1]) + 7 * mini(int(line[2]), int(line[1]) + 1)   # a deposit, or having enough on hand, sends it again

					if not known.has(id) or known[id] != signature:
						added.append(_sync_row(peer, int(id), it, rec, site_view))
						known[id] = signature

		var bog_started: int = Time.get_ticks_usec()
		var bog_rows: Array = _bog_rows_near(peer, here)
		bog_usec += Time.get_ticks_usec() - bog_started

		for bog in bog_rows:
			var bid: int = int(bog[0])
			near[bid] = true
			var bog_signature: int = int(bog[2]) + 1000 * BOG_STATE

			if not known.has(bid) or known[bid] != bog_signature:
				added.append(bog)
				known[bid] = bog_signature

			if not where.has(bid) or where[bid] != SYNC_LOOSE:
				_seen_hold(seen, bid, SYNC_LOOSE)

		# What this player knew that is no longer near: only the cells not skipped whole can hold any.
		for fc in held.keys():
			if whole.has(fc):
				continue

			var got: Dictionary = held[fc]

			for id in got.keys():
				if not near.has(id):
					got.erase(id)
					where.erase(id)

					if known.has(id):
						removed.append(id)
						known.erase(id)
						cells_seen.erase(fc)

			if got.is_empty():
				held.erase(fc)
				cells_seen.erase(fc)

		if not added.is_empty() or not removed.is_empty():
			var t_send: int = Time.get_ticks_usec()
			send_world_items.call(peer, added, removed)
			send_usec += Time.get_ticks_usec() - t_send
			sent += added.size()

	# For the slow-tick line: where the time went (lag run 5 Nov: sync-world-items 60-124 ms at a join).
	_site_memo = null
	_site_cells = {}
	_site_cells_due = false
	var total_ms: float = float(Time.get_ticks_usec() - t_grid) / 1000.0
	# Bog rows apart from the scan: the first sight of a 512 m field square builds it on the main thread (BogIron.field, 4,096 samples a square).
	_sync_detail = "(%d records, %d still: grid %.0f, scan %.0f (%d looked at, %d cells skipped), bog %.1f (built %d fields in %.1f), send %.0f for %d items; %d still moved unseen)" % [_items.size(), _still_at.size(),
		float(t_scan - t_grid) / 1000.0, total_ms - float(t_scan - t_grid) / 1000.0 - float(send_usec) / 1000.0 - float(bog_usec) / 1000.0, looked, skipped,
		float(bog_usec) / 1000.0, _bog_built, float(_bog_build_usec) / 1000.0, float(send_usec) / 1000.0, sent, _still_moved]


# Files the records made since the last full sync (all of them after a load or a reset): the still ones in their cells for good, the
# others in _rest. A record put in by hand with any other id is found by the count below and everything is filed again. Then checks STILL_CHECK still records: one gone is dropped, one moved without _refile is moved (and counted).
func _still_file() -> void:
	if _still_valid and _next_id >= _still_next:
		for id in range(_still_next, _next_id):
			if _items.has(id):
				_file_one(id)

	# More records than are filed: one was put in without an id from _next_id (a test or a tool building a world by hand; gate review
	# 26 Nov 2026: test_far_smoke's fires). Taken records only make the filed side bigger, so this never fires for them.
	if not _still_valid or _next_id < _still_next or _items.size() > _still_at.size() + _rest.size():
		_still_fine = {}
		_still_near = {}
		_still_at = {}
		_rest = {}
		_still_queue = []

		for id in _items:
			_file_one(int(id))

		_still_valid = true

	_still_next = _next_id

	if _still_queue.is_empty():
		_still_queue = _still_at.keys()

	for k in mini(STILL_CHECK, _still_queue.size()):
		var id: int = int(_still_queue.pop_back())

		if not _still_at.has(id):
			continue

		if not _items.has(id) or not _items[id].has("scatter"):
			_still_out(id)

			if _items.has(id):
				_rest[id] = true   # no longer still (not expected: a record keeps its kind)

			continue

		var was: Array = _still_at[id]
		_still_put(id)

		if _still_at[id] != was:
			_still_moved += 1


func _file_one(id: int) -> void:
	if _items[id].has("scatter"):
		_still_put(id)
	else:
		_rest[id] = true


# Where a record's position is set: a still record moves to its new cell at once (the others are filed again each full sync).
func _refile(id: int) -> void:
	if _still_at.has(id) and _items.has(id):
		_still_put(id)


func _still_put(id: int) -> void:
	var at: Vector3 = _items[id]["pos"]
	var fc: Vector2i = Vector2i(int(floor(at.x / FINE_M)), int(floor(at.z / FINE_M)))
	var cell: Vector2i = Vector2i(int(floor(at.x / NEAR_M)), int(floor(at.z / NEAR_M)))

	if _still_at.has(id):
		if _still_at[id][0] == fc and _still_at[id][1] == cell:
			return

		_still_out(id)

	if not _still_fine.has(fc):
		_still_fine[fc] = {}

	if not _still_near.has(cell):
		_still_near[cell] = {}

	_still_fine[fc][id] = true
	_still_near[cell][id] = true
	_still_at[id] = [fc, cell]


func _still_out(id: int) -> void:
	var was: Array = _still_at[id]
	(_still_fine[was[0]] as Dictionary).erase(id)
	(_still_near[was[1]] as Dictionary).erase(id)

	if (_still_fine[was[0]] as Dictionary).is_empty():
		_still_fine.erase(was[0])

	if (_still_near[was[1]] as Dictionary).is_empty():
		_still_near.erase(was[1])

	_still_at.erase(id)


# A road's quick sync (see _sync_world_items): only the records in `fresh`, for the players near a spot in `near_to`.
func _sync_quick(fresh: Array, near_to: Array) -> void:
	_site_memo = {}
	var rec_memo: Dictionary = {}
	_file_site_cells(true)

	for peer in _known:
		if not _peer_pos.has(peer):
			continue

		if not near_to.any(func(at): return Vector2((at as Vector3).x - _peer_pos[peer].x, (at as Vector3).z - _peer_pos[peer].z).length() <= NEAR_M * 1.5):
			continue   # nowhere near the road: the full sync looks after them

		var here: Vector3 = _peer_pos[peer]
		var known: Dictionary = _known[peer]
		var seen: Dictionary = _seen_of(peer)
		var added: Array = []
		var removed: PackedInt32Array = PackedInt32Array()

		for id in fresh:
			if not _items.has(id):
				if known.has(id):   # a road's id gone again: dropped only when gone from the world
					removed.append(id)
					known.erase(id)
					_seen_drop(seen, id)

				continue

			var it: Dictionary = _items[id]

			if it["pos"].distance_to(here) > NEAR_M:
				continue

			var rec: Array = rec_memo.get(id, [])

			if rec.is_empty():
				rec = _sync_record(int(id), it)
				rec_memo[id] = rec

			var signature: int = int(rec[1])
			var bellows_by: int = int(rec[5])
			var site_view: Array = []

			if bellows_by >= 0:
				signature += 523 * (2 if bellows_by == peer else 1)

			if it.has("struct") and it["struct"].has("site"):
				site_view = _site_view(peer, it)
				signature += 37

				for line in site_view:
					signature += 101 * int(line[1]) + 7 * mini(int(line[2]), int(line[1]) + 1)

			if not known.has(id) or known[id] != signature:
				added.append(_sync_row(peer, int(id), it, rec, site_view))
				known[id] = signature
				_seen_hold(seen, id, SYNC_LOOSE)   # the next full sync looks at it again and files it in its cell (its old cell is not skipped)

		if not added.is_empty() or not removed.is_empty():
			send_world_items.call(peer, added, removed)

	_site_memo = null
	_site_cells = {}


# A player's record of what the full sync last found for them (_sync_world_items): "cells" fine cell -> the cell's sum when it was wholly
# near and looked at in full; "where" id -> the cell it was found near in; "in" cell -> {id: true} the other way round. Started again when
# the player's _known list is new (a join, a fresh start), and made to match it when they differ in size (a safety net: never seen).
func _seen_of(peer: int) -> Dictionary:
	var seen: Dictionary = _sync_seen.get(peer, {})
	var known: Dictionary = _known[peer]

	if seen.is_empty() or not is_same(seen["known"], known):
		seen = {"known": known, "cells": {}, "where": {}, "in": {}}
		_sync_seen[peer] = seen

	if (seen["where"] as Dictionary).size() != known.size():
		for id in (seen["where"] as Dictionary).keys():
			if not known.has(id):
				_seen_drop(seen, id)

		for id in known:
			if not (seen["where"] as Dictionary).has(id):
				_seen_hold(seen, id, SYNC_LOOSE)   # looked at again by the next full sync

	return seen


func _seen_hold(seen: Dictionary, id: int, fc: Vector2i) -> void:
	_seen_drop(seen, id)
	seen["where"][id] = fc

	if not (seen["in"] as Dictionary).has(fc):
		seen["in"][fc] = {}

	seen["in"][fc][id] = true
	(seen["cells"] as Dictionary).erase(fc)


func _seen_drop(seen: Dictionary, id: int) -> void:
	if (seen["where"] as Dictionary).has(id):
		var fc: Vector2i = seen["where"][id]
		(seen["in"][fc] as Dictionary).erase(id)
		(seen["cells"] as Dictionary).erase(fc)
		(seen["where"] as Dictionary).erase(id)


# One fine cell's [sum, every record the same for every player, lowest y, highest y]. The sum is of every id in it and its signature, in
# their order, so a record that comes, goes, moves in or out, or changes how it is sent changes the sum. Two 31-bit sums, no overflow.
func _cell_info(ids: Array, rec_memo: Dictionary) -> Array:
	var a: int = 17
	var b: int = 29
	var same: bool = true
	var low: float = INF
	var high: float = -INF

	for id in ids:
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]
		var sig: int = 0

		if not it.has("struct") and not it.has("fire") and not it.has("tree"):
			sig = _plain_sig(it)   # a rock, a stone, anything loose: no _sync_record needed
		else:
			var rec: Array = rec_memo.get(id, [])

			if rec.is_empty():
				rec = _sync_record(int(id), it)
				rec_memo[id] = rec

			sig = int(rec[1])

			if int(rec[5]) >= 0 or (it.has("struct") and it["struct"].has("site")):
				same = false   # a smelter's bellows or a site's list: different for each player

		var x: int = posmod(int(id) * 131 + sig, 2147483647)
		a = (a * 31 + x) % 2147483647
		b = (b * 37 + x + 1) % 2147483629
		low = minf(low, it["pos"].y)
		high = maxf(high, it["pos"].y)

	return [a * 2147483648 + b, same, low, high]


# _sync_record's signature for a record with no struct, fire or tree (a rock, a boulder, a stone, anything loose), worked out without it:
# the full sync looks at thousands of these each second (sync by change step 3, 26 Nov 2026). test_sync_by_change holds them equal.
func _plain_sig(it: Dictionary) -> int:
	return int(it["count"]) + 1000 * (BOULDER_STATE if it.has("boulder") else 0) + 100000 * int(it["number"]) + 1000000000 * int(round(it["pos"].y * 10.0)) + ((1 << 60) if it.has("boulder") and (it["boulder"] as Dictionary).has("bare") else 0)   # bare: its talus taken off under a building, sent again


# A record's row for send_world_items: [id, number, count, position, state, extras]. `rec` is its _sync_record, `site_view` this player's
# list for a building site.
func _sync_row(peer: int, id: int, it: Dictionary, rec: Array, site_view: Array) -> Array:
	var state: int = int(rec[0])
	var bin_def: Dictionary = rec[2]
	var bin_box = rec[3]
	var fill: int = int(rec[4])
	var bellows_by: int = int(rec[5])
	var crop_extra: Dictionary = rec[6]
	var smithy_look: int = int(rec[7])
	var row: Array = [id, int(it["number"]), int(it["count"]), it["pos"], state, it["tree"] if it.has("tree") else (_struct_extra(it) if it.has("struct") else (it["boulder"] if it.has("boulder") else (_fire_extra(it) if it.has("fire") else (_loose_extra(it) if it.has("rot_y") or it.has("girth") or it.has("tilt") or it.has("fall") or it.has("pitch") else {}))))]
	var extra: Dictionary = row[5]

	if not site_view.is_empty():
		extra["site"] = site_view

	if it.has("struct") and bool(it["struct"].get("road", false)):
		extra["road"] = true   # a surveyed road's patch (the client keeps the grass off 2 m either side)

	if it.has("struct") and it["struct"].has("len"):
		extra["pitch"] = float(it["struct"]["pitch"])   # a pipe run laid from the hand: its tilt and length (protocol 138)
		extra["len"] = float(it["struct"]["len"])

	if it.has("struct") and _water.pieces.get(id, {}).has("level_port"):
		extra["water_l"] = int(floor(_barrel_water_l(id)))   # a barrel's water (E drinks from it instead of opening it)

	if it.has("struct") and it["struct"].has("on"):
		extra["on"] = true   # a crate riding on a cart (the client offers to set it down)

	if it.has("struct") and bool(_serve_kinds().get(str(it["struct"]["kind"]), false)) and it["struct"].has("uid"):
		var plate = _chests.get(int(it["struct"]["uid"]))

		if plate != null and plate.numbers[0] != 0:
			extra["board"] = int(plate.numbers[0])   # a Serving Platter: its board and portions left
			extra["portions"] = int(plate.counts[0])

	if it.has("struct") and not it["struct"].has("site"):
		var wheel: int = wheel_percent(it)

		if wheel >= 0:
			extra["wheel"] = wheel   # a sawmill: its water wheel's share, for the look-at line

		if fill >= 0:
			extra["fill"] = fill   # a station store: 0 empty, 1 to 4 quarters full

		if smithy_look >= 0:
			extra["forge"] = smithy_look   # a smithy's fire: 0 cold, 1 red coals, 2 the flare

		if bellows_by >= 0:
			extra["bellows"] = 2 if bellows_by == peer else 1   # its bellows worked: 2 by this player, 1 by another

		if not crop_extra.is_empty():
			extra.merge(crop_extra)   # a bed's crop and stage (FARMING_SPEC.md step 6): the client draws the stage and words its E prompt

		if bin_box != null:   # a resource bin: what it holds (0 none, -1 mixed from before R6) and its fill in per mille, for the resource surface (no version change: row extras)
			extra["res"] = BinRules.assigned(bin_box)
			extra["fill_pm"] = int(round(BinRules.fill_share(bin_def, bin_box) * 1000.0))

	return row


# The part of a record's sync signature and row extras that is the same for every player (_sync_world_items): [state, signature, structure row,
# resource bin box, store fill, bellows worker peer, crop extras, smithy look]. Worked out once per record per sync, not once per player: with 16
# players around 500 records the per-player work held the tick about 100 ms each sync (load test 23 Nov 2026).
func _sync_record(id: int, it: Dictionary) -> Array:
	var state: int = int(it["fire"]["state"]) if it.has("fire") else (int(it["tree"]["state"]) if it.has("tree") else (_struct_state(it) if it.has("struct") else (BOULDER_STATE if it.has("boulder") else 0)))
	var signature: int = int(it["count"]) + 1000 * state + 100000 * int(it["number"]) + 1000000000 * int(round(it["pos"].y * 10.0))   # the height too: an item that comes down onto the ground after a dig is sent again

	if it.has("struct") and bool(it["struct"].get("lit", false)):
		signature += 7      # a fixture lit or put out is sent again (the client draws or drops its flame)

	if it.has("struct"):
		signature += 7919 * int(round(it["pos"].x * 4.0)) + 104729 * int(round(it["pos"].z * 4.0)) + (3 if it["struct"].has("on") else 0)   # a cart or crate that moved, or a crate lifted or set down, is sent again
		signature += 211 * int(round(float(it["struct"].get("len", 0.0)) * 20.0)) + 409 * int(floor(_barrel_water_l(id) / 5.0))   # a pipe run split shorter, a barrel's water by 5 L
		signature += (89 if _whole_catch(it) else 0) + 97 * _trap_catch(it)   # a catch cut with the knife, or a trap that caught or was emptied, is sent again

	var bin_def: Dictionary = _structures.get(str(it["struct"]["kind"]), {}) if it.has("struct") else {}
	var bin_box = _chests.get(int(it["struct"].get("uid", -1))) if BinRules.is_bin(bin_def) and it["struct"].has("uid") else null
	var fill: int = _store_fill(it) if it.has("struct") and (_keeps_products(str(it["struct"]["kind"])) or _smelters.is_smelter(bin_def) or BinRules.is_bin(bin_def)) else -1

	if bin_box != null:
		signature += 29 * int(round(BinRules.fill_share(bin_def, bin_box) * 50.0)) + 31 * BinRules.assigned(bin_box)   # a bin's surface moves by a fiftieth, or it holds another kind: sent again

	if fill >= 0:
		signature += 23 * (fill + 1)   # a station store that fills or empties by a quarter is sent again (master s2.5 fill levels)

	var bellows_by: int = _smelters.bellows_peer(id) if fill >= 0 else -1
	var crop_extra: Dictionary = crop_row_extra(it) if it.has("struct") else {}

	if crop_extra.has("crop"):
		signature += 61 * (2 + int(crop_extra["stage"])) + 7 * (str(crop_extra["crop"]).hash() % 997) + 13 * (str(crop_extra.get("cells", "")).hash() % 991)   # a crop sown, grown a stage or gone (harvested, frost), in any square metre of a plot, is sent again

	if crop_extra.has("moist"):
		signature += 433 * (1 + int(crop_extra["moist"]))   # a bed's soil wetter or drier by a step is sent again (the look-at line shows it)

	if it.has("struct") and bool(_serve_kinds().get(str(it["struct"]["kind"]), false)) and it["struct"].has("uid") and _chests.has(int(it["struct"]["uid"])):
		signature += 7919 * int(_chests[int(it["struct"]["uid"])].counts[0]) + 3 * int(_chests[int(it["struct"]["uid"])].numbers[0])   # a portion eaten or a board set out is sent again

	var smithy_look: int = -1   # a smithy's fire: 0 cold, 1 red coals (fuel in it), 2 the flare (a craft worked there)

	if it.has("struct") and not it["struct"].has("site") and _fuel_slot_kind(_structures.get(str(it["struct"]["kind"]), {})):
		smithy_look = 2 if _busy_ms.has(id) else (1 if _smithy_fuelled(it, _structures[str(it["struct"]["kind"])]) else 0)
		signature += 547 * (smithy_look + 1)   # a smithy fuelled, emptied, set working or idle is sent again

	if it.has("fire"):
		signature += 13 * int(it["fire"].get("fed", 0))      # wood laid on a fire is sent again (its burn time for the inspection label)
		signature += 17 * int(floor(_fire_glow(it) * 10.0))   # coals and warm ash are sent again each tenth of their time (the client dims them)
		signature += 19 * int(it["fire"].get("smoke", 0))   # a fire that starts or stops smoking is sent again

	return [state, signature, bin_def, bin_box, fill, bellows_by, crop_extra, smithy_look]


func _send_changes(peer: int, inv, before: Array) -> void:
	var out: PackedByteArray = PackedByteArray([0])
	var insts: Dictionary = {}
	_hotbar_autofill(inv, before[0])   # before the slots are sent, so the client sees the tool where it ends up
	inv.trim()   # a pack gives back the empty slots at its end (Inventory.trim)

	if not _gain_quiet and send_received.is_valid():
		_report_gains(peer, inv, before)

	# A pack that grew or shrank: the whole pack, since a slot update cannot add or take away slots (protocol 116).
	if inv.slot_count != before[0].size():
		send_full.call(peer, inv.to_bytes())
		_send_favs(peer, inv)
		_sync_shoulder_if_changed(peer)
		return

	# Protocol 106: a count byte, 9 bytes per changed slot (slot, u32 number, u16 count, u16 wear), then the instance data of those that have one.
	for i in inv.slot_count:
		if inv.numbers[i] != before[0][i] or inv.counts[i] != before[1][i] or inv.wear[i] != before[2][i] or inv.inst_of(i) != (before[4][i] if before.size() > 4 else {}):
			var at: int = out.size()
			out.resize(at + 9)
			out[at] = i
			out.encode_u32(at + 1, inv.numbers[i])
			out.encode_u16(at + 5, inv.counts[i])
			out.encode_u16(at + 7, mini(inv.wear[i], 65535))
			out[0] += 1

			if not inv.inst_of(i).is_empty():
				insts[i] = inv.inst[i]

	if out[0] > 0:
		out.append_array(inv.inst_bytes(insts))
		send_slots.call(peer, out)

	if before.size() > 3 and inv.fav_flags() != before[3]:
		_send_favs(peer, inv)   # after the slots, so the client marks the stacks where they now are

	_sync_shoulder_if_changed(peer)


func _send_favs(peer: int, inv) -> void:
	if send_favourites.is_valid() and inv != null:
		send_favourites.call(peer, inv.fav_flags())


# Every item that is more numerous in the pack than before (all gains pass _send_changes): a pickup, harvest, craft output, reward.
func _report_gains(peer: int, inv, before: Array) -> void:
	var gained: Dictionary = {}

	for i in inv.slot_count:
		var now_n: int = int(inv.numbers[i])

		if now_n > 0:
			gained[now_n] = int(gained.get(now_n, 0)) + int(inv.counts[i])

	for i in before[0].size():
		var was_n: int = int(before[0][i])

		if was_n > 0 and gained.has(was_n):
			gained[was_n] = int(gained[was_n]) - int(before[1][i])

	for number in gained:
		if int(gained[number]) > 0:
			send_received.call(peer, table.id_of(int(number)), int(gained[number]), _gain_source)


func _snapshot(inv) -> Array:
	var insts: Array = []

	for i in inv.slot_count:
		insts.append(inv.inst_of(i).duplicate(true))

	return [inv.numbers.duplicate(), inv.counts.duplicate(), inv.wear.duplicate(), inv.fav_flags(), insts]


func _chunk_of(p: Vector3) -> Vector2i:
	return Vector2i(int(floor(p.x / CHUNK_M)), int(floor(p.z / CHUNK_M)))


func _valid_key(key: String) -> bool:
	if key.length() < 8 or key.length() > 64:
		return false

	for ch in key:
		if not (ch >= "0" and ch <= "9") and not (ch >= "a" and ch <= "z") and not (ch >= "A" and ch <= "Z") and ch != "-" and ch != "_" and ch != "'":
			return false

	return true


func _load_inventories() -> void:
	var parsed: Variant = _read_json_version("inventories.json", INVENTORY_VERSION, 1)

	if parsed == null:
		return

	_old_seed_files["packs"] = not bool(parsed.get("seed_pinch", false))   # each file carries its own mark: a crash between two files never counts one twice

	for key in parsed["inventories"]:
		var inv = InventoryScript.pack(table)
		inv.from_json_array(parsed["inventories"][key])
		_strip_dead_kits(inv)
		_inventories[key] = inv


# A Barrel placed before 22 Nov 2026 held water or goods (PV-6). Dave 22 Nov 2026 split it: the Water barrel (wooden_barrel, 3 slots of water
# containers) and the Storage barrel (storage_barrel). One that holds anything but water containers in its first 3 slots loads as a Storage barrel, its
# goods kept; one that is empty or holds water containers stays a Water barrel (its water and pipes kept). Runs before the water network is built.
func _split_old_barrels() -> void:
	var water_slots: int = int(_structures.get("wooden_barrel", {}).get("slots", 3))

	if not _structures.has("storage_barrel"):
		return

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or str(it["struct"].get("kind", "")) != "wooden_barrel" or it["struct"].has("site"):
			continue

		var box = _chests.get(int(it["struct"].get("uid", 0)))

		if box == null:
			continue

		var goods: bool = false

		for s in box.slot_count:
			if box.numbers[s] != 0 and (s >= water_slots or _container_cap(box.numbers[s]) <= 0):
				goods = true
				break

		if goods:
			it["struct"]["kind"] = "storage_barrel"
			it["number"] = table.number_of("storage_barrel")
			_load_changed[id] = true
			_dirty = true
		elif it["struct"].has("autoload"):
			it["struct"].erase("autoload")   # a Water barrel does not autoload
			_load_changed[id] = true


# A foundation or a floor piece (the storey above's floor): what a stack or log can lie on.
func _is_floor_def(def: Dictionary) -> bool:
	return bool(def.get("foundation", false)) or str(def.get("piece_kind", "")) == "floor"


# Before 23 Nov 2026 a stack dropped on a foundation came down to the ground under it, inside the slab where nobody could see or reach it (physical
# world audit, PR #1709; coordinator 23 Nov 2026: the live world is loaded by the next build). At every load each loose stack whose spot is inside
# a finished foundation's slab (over its footprint, under its top and no more than LIFT_SLAB_M under it) is lifted onto that top. Only its height
# changes: nothing is made, merged or removed, and a stack already on a top is left, so a second load does nothing. One pass over the records.
const LIFT_SLAB_M := 1.5   # how far under a foundation's top a buried stack may lie: the slab (top_m) and the wheel's lift (1.0 m), with room
var lifted_at_load: int = 0   # stacks _lift_out_of_slabs lifted at the last load (the load line, tests)


func _lift_out_of_slabs() -> void:
	lifted_at_load = 0
	var slabs: Dictionary = {}   # 4 m cell -> [[pos, def, yaw], ...] of the finished foundations over it

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or it["struct"].has("site"):
			continue

		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

		if not bool(def.get("foundation", false)):
			continue

		var reach: float = 0.5 * Vector2(float(def.get("footprint_x", 4.0)), float(def.get("footprint_z", 4.0))).length()

		for cx in range(int(floor((it["pos"].x - reach) / 4.0)), int(floor((it["pos"].x + reach) / 4.0)) + 1):
			for cz in range(int(floor((it["pos"].z - reach) / 4.0)), int(floor((it["pos"].z + reach) / 4.0)) + 1):
				var cell: Vector2i = Vector2i(cx, cz)

				if not slabs.has(cell):
					slabs[cell] = []

				slabs[cell].append([it["pos"], def, float(it["struct"].get("yaw", 0.0))])

	if slabs.is_empty():
		return

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("scatter") or it.has("showroom") or it.has("struct") or it.has("fire") or it.has("tree") or it.has("boulder") or it.has("tilt") or it.has("fall"):
			continue

		var cell: Vector2i = Vector2i(int(floor(it["pos"].x / 4.0)), int(floor(it["pos"].z / 4.0)))

		if not slabs.has(cell):
			continue

		var y: float = float(it["pos"].y)
		var best: float = NAN

		for slab in slabs[cell]:
			var top: float = float(slab[0].y) + PlacementRules.anchor_top(slab[1])

			if y < top - 0.02 and y >= top - LIFT_SLAB_M and PlacementRules.holds(slab[1], {"pos": slab[0], "yaw": slab[2]}, it["pos"]) and (is_nan(best) or top > best):
				best = top

		if not is_nan(best):
			it["pos"] = Vector3(it["pos"].x, best, it["pos"].z)
			_refile(id)
			_load_changed[id] = true
			_dirty = true
			lifted_at_load += 1

	if lifted_at_load > 0:
		print("server_items: lifted %d stacks out of foundations onto their tops" % lifted_at_load)


func _load_world_items() -> void:
	_wide_piles.clear()
	_wide_piles_built = false   # the first drop after the load files the loaded cone piles
	var parsed: Variant = _read_json_version("world_items.json", VERSION, 1)

	if parsed == null:
		return

	_old_seed_files["ground"] = not bool(parsed.get("seed_pinch", false))   # the header and the area files it names are read as one save (_read_area)

	if parsed.has("areas"):   # version 4: the rows are in the area files the header names (an older file holds them itself)
		_save_gen = int(parsed.get("gen", 0))
		var all_rows: Array = []
		var all_world: Array = []
		var all_by: Dictionary = {}

		_load_row_area = []

		for key in parsed["areas"]:
			var area: Dictionary = _read_area(str(key), int(parsed["areas"][key]))
			var base: int = all_rows.size()
			_area_sums[str(key)] = int(parsed["areas"][key])   # as written: the header goes on naming it until it changes

			for row in area.get("items", []):
				_load_row_area.append(str(key))

			for n in area.get("world_rows", []):
				all_world.append(base + int(n))

			var by_area: Variant = area.get("by_rows", {})   # added 23 Nov 2026: an older area file has none (its loose items load with no dropper, as before)

			if typeof(by_area) == TYPE_DICTIONARY:
				for n in by_area:
					all_by[str(base + int(n))] = str(by_area[n])

			all_rows.append_array(area.get("items", []))

		parsed["items"] = all_rows
		parsed["world_rows"] = all_world
		parsed["by_rows"] = all_by

	_next_id = int(parsed.get("next_id", 1))
	_still_valid = false   # the loaded records are filed at the next full sync

	_picked = parsed.get("picked", {})
	_stripped = {}
	var same_layout: bool = int(parsed.get("layout", 1)) == FloraLayout.VERSION

	# Picked and bare marks name plants by chunk and id: under another flora layout they would point at the wrong plants, so they start clean
	# (a file from before the stamp counts as layout 1; the removed-plant marks do the same in server_flora.gd).
	if not same_layout:
		_picked = {}
		print("server items: flora layout %d is not %d, picked and bare plant marks cleared" % [int(parsed.get("layout", 1)), FloraLayout.VERSION])

	for chunk_key in (parsed.get("stripped", {}) if same_layout else {}):      # JSON gives the stamps back as floats
		var ids: Dictionary = {}

		for plant in parsed["stripped"][chunk_key]:
			ids[int(plant)] = int(parsed["stripped"][chunk_key][plant])

		_stripped[str(chunk_key)] = ids

	_fruit = {}

	for chunk_key in (parsed.get("fruit", {}) if same_layout else {}):      # JSON gives the numbers back as floats
		var trees: Dictionary = {}

		for tree in parsed["fruit"][chunk_key]:
			var record: Array = parsed["fruit"][chunk_key][tree]
			trees[int(tree)] = [int(record[0]), int(record[1])]

		_fruit[str(chunk_key)] = trees

	for key in parsed.get("taken", []):
		_taken[int(key)] = true

	_load_boulders_left(parsed)

	for key in parsed.get("bog_iron", {}):
		var bog_row: Variant = parsed["bog_iron"][key]

		if typeof(bog_row) == TYPE_ARRAY and (bog_row as Array).size() >= 2:
			_bog_left[str(key)] = [int(bog_row[0]), float(bog_row[1])]

	for id in parsed.get("pockets", {}):   # added 21 Nov 2026 (resource distribution stage 2): an older file has none
		var spot: Variant = parsed["pockets"][id]

		if typeof(spot) == TYPE_ARRAY and (spot as Array).size() >= 3:
			_pockets_open[int(id)] = [float(spot[0]), float(spot[1]), float(spot[2])]

	for id in parsed.get("seams", {}):   # added 21 Nov 2026 (resource distribution): an older file has none
		_seam_left[int(id)] = int(parsed["seams"][id])

	for hole in parsed.get("bog_holes", []):   # added 21 Nov 2026: an older file has none
		if typeof(hole) == TYPE_ARRAY and (hole as Array).size() >= 5:
			var deepest: float = float(hole[6]) if (hole as Array).size() >= 7 else float(hole[1]) - float(hole[3])   # added 22 Nov 2026
			_bog_holes.append([float(hole[0]), float(hole[1]), float(hole[2]), float(hole[3]), float(hole[4]), int(hole[5]) if (hole as Array).size() >= 6 else PEAT_SOIL, deepest])

	var had_kits: bool = not bool(parsed.get("no_kits", false))   # a world saved before kits were dropped (Dave 4 Nov 2026) loses its kit items and every placed building once

	var world_rows: Dictionary = {}   # indexes of the rows the server put down (added 13 Nov 2026; an older file has none)
	var row_n: int = -1

	for n in parsed.get("world_rows", []):
		world_rows[int(n)] = true

	var by_rows: Dictionary = parsed.get("by_rows", {}) if typeof(parsed.get("by_rows", {})) == TYPE_DICTIONARY else {}   # who dropped each loose item (added 23 Nov 2026)

	for row in parsed["items"]:
		row_n += 1
		var entry: Dictionary = {"number": table.current_number(int(row[0])), "count": int(row[1]) * table.rename_count(int(row[0])), "pos": Vector3(row[2], row[3], row[4]), "left": float(row[5])}   # a counted rename: a saved large block lies as 4 Wooden blocks

		if is_dead_kit(int(row[0])):
			continue

		if had_kits and row.size() > 9 and int(row[6]) >= 5 and typeof(row[9]) == TYPE_STRING and str(row[9]) != "remains" and (_traps == null or not _traps.is_kind(str(row[9]))):
			continue

		if row.size() > 9 and int(row[6]) >= 5 and typeof(row[9]) == TYPE_STRING:
			entry["struct"] = {"kind": _kind_now(str(row[9])), "yaw": float(row[7])}

			if row.size() > 10 and int(row[10]) > 0:
				entry["struct"]["uid"] = int(row[10])
				_next_uid = maxi(_next_uid, int(row[10]) + 1)

				if not _chests.has(int(row[10])):
					_chests[int(row[10])] = InventoryScript.new(table)

			if row.size() > 12 and (_structures.get(str(row[9]), {}).has("support") or (not BuildingWear.rule_for(_wear_cfg, str(entry["struct"]["kind"])).is_empty() and float(row[12]) > 0.0)):
				entry["struct"]["born"] = float(row[12])

			if row.size() > 12 and str(row[9]) == "remains":
				entry["struct"]["owner"] = str(row[11])
				entry["struct"]["born"] = float(row[12])
				entry["struct"]["cave"] = row.size() > 13 and bool(row[13])
				entry["struct"]["coins"] = maxi(int(row[14]), 0) if row.size() > 14 else 0

			if row.size() > 11 and str(row[9]) != "remains" and str(row[11]) != "":
				entry["struct"]["owner"] = str(row[11])   # the builder (take-down) and a container's owner (crafting stock); a container saved before owners belongs to its first opener, any other piece saved before stays open to all

			if row.size() > 16 and int(row[16]) == 1:
				entry["struct"]["keep_out"] = true   # the owner keeps it out of crafting and blueprint sites

			if row.size() > 17 and typeof(row[17]) == TYPE_STRING and str(row[17]) != "" and entry["struct"].has("uid"):
				var saved_lock: Dictionary = _clean_lock(JSON.parse_string(str(row[17])))   # world_items version 2: the code lock (s3.13)

				if saved_lock.is_empty() and str(entry["struct"].get("owner", "")) != "":
					saved_lock = {"salt": "", "hash": "", "ok": [], "allow": [], "tries": {}}   # a damaged lock fails closed: only the owner opens it until they set a new code or take it off

				if not saved_lock.is_empty():
					entry["struct"]["lock"] = saved_lock

			if row.size() > 19 and int(row[18]) > 0 and entry["struct"].has("uid"):
				entry["struct"]["on"] = int(row[18])   # world_items version 3: the crate rides on the cart with this uid (_carts.after_load checks it)
				entry["struct"]["spot"] = maxi(int(row[19]), 0)

			if row.size() > 20 and int(row[20]) == 1:
				entry["struct"]["road"] = true   # a surveyed road's patch: the grass is kept off 2 m either side of it

			if row.size() > 22 and int(row[22]) > 0 and entry["struct"].has("uid"):
				entry["struct"]["autoload"] = int(table.current_number(int(row[22])))   # the container's standing autoload item (protocol 139)

			if row.size() > 21 and typeof(row[21]) == TYPE_STRING and str(row[21]) != "":
				var laid: Variant = JSON.parse_string(str(row[21]))   # a pipe run laid from the hand (PLUMBING_DESIGN s9): its tilt, length and the pieces it took

				if typeof(laid) == TYPE_DICTIONARY:
					entry["struct"]["pitch"] = float((laid as Dictionary).get("pitch", 0.0))
					entry["struct"]["len"] = clampf(float((laid as Dictionary).get("len", LEGACY_PIPE_M)), PipeRules.MIN_RUN_M, PipeRules.MAX_RUN_M)
					entry["struct"]["paid"] = maxi(int((laid as Dictionary).get("paid", 1)), 0)   # a half left by a junction may hold none

			_pipe_from_legacy(entry)

			if row.size() > 15 and str(row[15]) != "":
				var saved_site: Variant = JSON.parse_string(str(row[15]))

				if typeof(saved_site) == TYPE_DICTIONARY:
					entry["struct"]["site"] = {"bp": int((saved_site as Dictionary).get("bp", 0)), "have": (saved_site as Dictionary).get("have", {})}

					if typeof((saved_site as Dictionary).get("kinds", null)) == TYPE_DICTIONARY:
						entry["struct"]["site"]["kinds"] = saved_site["kinds"]   # which items went in (_note_kinds); a 9257 site has none

			if row.size() > 23 and str(row[23]) != "":
				var saved_kinds: Variant = JSON.parse_string(str(row[23]))

				if typeof(saved_kinds) == TYPE_DICTIONARY:
					entry["struct"]["kinds"] = saved_kinds   # a built piece's materials as they went in (_finish_site); a 9257 row has 23 values

			if row.size() > 12 and _traps != null and _traps.is_kind(str(row[9])):
				entry["struct"]["owner"] = str(row[11])
				entry["struct"]["seq"] = float(row[12])
				_next_uid = maxi(_next_uid, int(row[12]) + 1)
				entry["wear"] = int(row[8])

				if row.size() > 24 and typeof(row[24]) == TYPE_STRING and str(row[24]) != "":
					_traps.restore_state(entry, str(row[24]))   # its run note, away clock and held catch (laid again by _traps.after_load)

			if bool(_structures.get(str(entry["struct"]["kind"]), {}).get("fish_trap", false)) and row.size() > 24 and typeof(row[24]) == TYPE_STRING:
				var trap_state: Variant = JSON.parse_string(str(row[24]))

				if typeof(trap_state) == TYPE_DICTIONARY and trap_state.has("rolled_s"):
					entry["struct"]["rolled_s"] = float(trap_state["rolled_s"])

			if str(entry["struct"]["kind"]) == "carcass":
				var body: Variant = JSON.parse_string(str(row[24])) if row.size() > 24 and typeof(row[24]) == TYPE_STRING else null

				if typeof(body) != TYPE_DICTIONARY or not _carcass_cfg.get("species", {}).has(str(body.get("species", ""))):
					continue   # a carcass row with nothing to say what it was

				entry["number"] = table.number_of("carcass")
				entry["left"] = clampf(float(body.get("left", CARCASS_LIFE_S)), 1.0, CARCASS_LIFE_S)
				entry["struct"]["transient"] = true
				entry["struct"]["species"] = str(body["species"])
				entry["struct"]["blows"] = maxi(int(body.get("blows", 0)), 0)

				if typeof(body.get("parts", null)) == TYPE_ARRAY:
					entry["struct"]["parts"] = (body["parts"] as Array).map(func(p): return [str(p[0]), int(p[1])])

				if bool(body.get("snared", false)):
					entry["struct"]["snared"] = true

				if body.has("look"):
					entry["struct"]["look"] = int(body["look"])
					entry["struct"]["num"] = int(body.get("num", 0))

			_load_row_of[_next_id] = row_n
			_items[_next_id] = entry
			_grid_add(_next_id, entry)
			_next_id += 1
			continue

		if row.size() > 8:
			entry["wear"] = int(row[8])

		if row.size() > 9 and int(row[6]) == 0 and typeof(row[row.size() - 1]) == TYPE_DICTIONARY:
			var row_inst: Dictionary = InventoryScript.clean_inst_of(table, int(entry["number"]), row[row.size() - 1])   # a non-bag drops an older save's `bag`

			if not row_inst.is_empty():
				entry["inst"] = row_inst

		if row.size() > 9 and int(row[6]) == 0 and typeof(row[9]) == TYPE_FLOAT:
			entry["rot_y"] = float(row[9])

			if row.size() > 10 and typeof(row[10]) == TYPE_FLOAT:
				entry["girth"] = float(row[10])

			if row.size() > 12 and typeof(row[11]) == TYPE_FLOAT and typeof(row[12]) == TYPE_FLOAT:
				entry["pitch"] = float(row[11])
				entry["spin"] = float(row[12])

		if row.size() > 7 and int(row[6]) != 0:
			var saved_state: int = int(row[6])

			if saved_state == 2:   # before protocol 19: an out fire is empty ashes, or loaded when it still has wood
				saved_state = 9 if float(row[7]) > 0.0 else 8

			entry["fire"] = {"state": saved_state, "burn_left": float(row[7]), "covered": false, "recheck": 0.0}

			if row.size() > 10 and typeof(row[10]) == TYPE_ARRAY and (row[10] as Array).size() == 3:   # before fire tiers the one counter is split by the fire's size
				entry["fire"]["wood"] = {"log": float(row[10][0]), "firewood": float(row[10][1]), "weak": float(row[10][2])}

			if row.size() > 11 and typeof(row[11]) == TYPE_ARRAY and (row[11] as Array).size() == 3:
				var pieces: Dictionary = {}

				for k in range(3):
					if int(row[11][k]) >= 0:
						pieces[["log", "firewood", "weak"][k]] = int(row[11][k])

				entry["fire"]["pieces"] = pieces

			if row.size() > 12 and int(row[12]) == 1:
				entry["fire"]["synced"] = true

			# A restart keeps what has burned since the last count and which pieces that count knew, so closing the store after a load does not give
			# burned wood back as fresh burn time, and the half-burned piece still leaves the store when it is done.
			if row.size() > 13 and typeof(row[13]) == TYPE_ARRAY and (row[13] as Array).size() == 3:
				var burnt: Dictionary = {}

				for k in range(3):
					if float(row[13][k]) > 0.0:
						burnt[["log", "firewood", "weak"][k]] = float(row[13][k])

				entry["fire"]["burnt"] = burnt

			if row.size() > 14 and typeof(row[14]) == TYPE_ARRAY and (row[14] as Array).size() == 3:
				var counted: Dictionary = {}

				for k in range(3):
					counted[["log", "firewood", "weak"][k]] = maxi(int(row[14][k]), 0)

				entry["fire"]["counted"] = counted

			if row.size() > 15 and (typeof(row[15]) == TYPE_FLOAT or typeof(row[15]) == TYPE_INT) and float(row[15]) > 0.0:
				entry["fire"]["lit_s"] = float(row[15])

			if row.size() > 16 and (typeof(row[16]) == TYPE_FLOAT or typeof(row[16]) == TYPE_INT) and int(row[16]) > 0:
				entry["fire"]["damp"] = int(row[16])

			if row.size() > 17 and (typeof(row[17]) == TYPE_FLOAT or typeof(row[17]) == TYPE_INT) and float(row[17]) != 0.0:
				entry["fire"]["char"] = float(row[17])

			if row.size() > 18 and (typeof(row[18]) == TYPE_FLOAT or typeof(row[18]) == TYPE_INT) and int(row[18]) == 1:
				entry["fire"]["kept"] = true

			if row.size() > 9 and int(row[9]) > 0:
				entry["fire"]["uid"] = int(row[9])
				_next_uid = maxi(_next_uid, int(row[9]) + 1)

				if not _chests.has(int(row[9])):
					_chests[int(row[9])] = InventoryScript.new(table)

		if world_rows.has(row_n):
			entry["world"] = true

		if by_rows.has(str(row_n)):
			entry["by"] = str(by_rows[str(row_n)])

		_load_row_of[_next_id] = row_n
		_items[_next_id] = entry
		_zone_add(_next_id)   # a saved fire still blocks spawning round it
		_next_id += 1

	_clear_retired_pieces()
	_refresh_pots()   # a pot hangs over whatever fire shares its spot: nothing about it is saved


const CLEARED_LIFETIME_S := 1.0e9   # over _expire_items' never-expires mark: what a cleared piece leaves never despawns (PROVISIONAL, PLUMBING_DESIGN s10 PV-11)

# A retired piece still standing in a loaded world (the pumps; Dave 20 Nov 2026: "the wooden hand pumps should be gone too") is taken away and leaves
# its materials on the ground where it stood: a built one its whole blueprint cost, a site what had been put into it. Only blueprints marked
# clear_at_load are in _retired_blueprint_of_kit, so no other retired piece is touched.
func _clear_retired_pieces() -> void:
	for id in _items.keys():
		var it: Dictionary = _items[id]

		if not it.has("struct"):
			continue

		var row: Dictionary = _retired_blueprint_of_kit.get(str(_structures.get(str(it["struct"]["kind"]), {}).get("kit", "")), {})

		if row.is_empty():
			continue

		var give_back: Dictionary = {}

		if it["struct"].has("site"):
			for item_id in (it["struct"]["site"] as Dictionary).get("have", {}):
				give_back[str(item_id)] = int(it["struct"]["site"]["have"][item_id])
		else:
			for need in row["cost"]:
				give_back[str(need[0])] = int(need[1])

		var at: Vector3 = it["pos"]
		_area_recovered[area_key_of(at.x, at.z)] = true   # its area file is written again at the first save: the piece gone, its materials there

		if _load_row_of.has(id) and int(_load_row_of[id]) < _load_row_area.size():
			_area_recovered[str(_load_row_area[int(_load_row_of[id])])] = true   # and the file its row came from, if another

		_items.erase(id)
		_load_row_of.erase(id)
		_dirty = true
		var gone_def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

		if bool(gone_def.get("foundation", false)) or str(gone_def.get("piece_kind", "")) == "floor":
			_resettle_on(at, FLOOR_ROWS_REACH_M)   # what lay on it comes down

		var kinds: Dictionary = (it["struct"]["site"] as Dictionary).get("kinds", {}) if it["struct"].has("site") else it["struct"].get("kinds", {})

		for item_id in give_back:
			if table.number_of(str(item_id)) <= 0:
				push_error("cleared %s: no item %s to give back" % [str(it["struct"]["kind"]), str(item_id)])
				continue

			for pair in _kinds_back(str(item_id), int(give_back[item_id]), kinds):   # what went in (_note_kinds); a 9257 piece: a group's lowest member
				drop_in_world(int(pair[0]), int(pair[1]), at, 0, CLEARED_LIFETIME_S)   # it waits for its owner, however long they are away


# An area file of the gen the header names. A save that wrote the area but not the header (a crash between) left the gen before in .prev.
# A file that does not parse is set aside as .bad; one of another version is set aside and not replaced, as _read_json_version does.
func _read_area(key: String, gen: int) -> Dictionary:
	var path: String = "%s/%s/%s.json" % [_dir, AREA_DIR, key]
	restore_missing(path)
	var main: Variant = JSON.parse_string(FileAccess.get_file_as_string(path)) if FileAccess.file_exists(path) else null

	if typeof(main) == TYPE_DICTIONARY and int(main.get("version", 0)) > VERSION:
		push_error("server items: %s is from a newer version; the server will not start over it" % path)
		load_failures.append("%s/%s.json" % [AREA_DIR, key])   # nothing renamed: the build that wrote it still reads it
		return {}

	if typeof(main) == TYPE_DICTIONARY and int(main.get("gen", -1)) == gen and typeof(main.get("items")) == TYPE_ARRAY:
		return main

	if FileAccess.file_exists(path) and typeof(main) != TYPE_DICTIONARY:
		push_error("server items: %s is not usable; kept as %s.bad" % [path, path])
		DirAccess.copy_absolute(path, path + ".bad")

	var prev: Variant = JSON.parse_string(FileAccess.get_file_as_string(path + ".prev")) if FileAccess.file_exists(path + ".prev") else null

	if typeof(prev) == TYPE_DICTIONARY and int(prev.get("gen", -1)) == gen and int(prev.get("version", 0)) <= VERSION and typeof(prev.get("items")) == TYPE_ARRAY:
		push_error("server items: %s read from the save before it (.prev, the gen the header names)" % path)
		_area_recovered[key] = true

		if typeof(main) == TYPE_DICTIONARY:
			_set_aside_unfinished(path)

		return prev

	if typeof(main) == TYPE_DICTIONARY and typeof(main.get("items")) == TYPE_ARRAY:
		push_error("server items: %s is gen %d, the header names %d; the newest copy is used" % [path, int(main.get("gen", -1)), gen])
		_area_recovered[key] = true
		return main

	if typeof(prev) == TYPE_DICTIONARY and int(prev.get("version", 0)) <= VERSION and typeof(prev.get("items")) == TYPE_ARRAY:
		push_error("server items: %s restored from the save before it (gen %d)" % [path, int(prev.get("gen", -1))])
		_area_recovered[key] = true
		return prev   # as _read_json_version: a damaged file costs at most one save interval of that area

	push_error("server items: %s is missing or damaged and has no usable earlier copy; the server will not start over it" % path)
	load_failures.append("%s/%s.json" % [AREA_DIR, key])   # the header names it: saving now would drop that area's items for good
	return {}


# Reads a save file. A file that does not parse (a torn write, a damaged disk) is set aside as .bad and the copy kept
# from the save before it (.prev, at most one save interval old) is used instead, so a corrupt file costs seconds,
# not the world. A file from another version is set aside as .bad and NOT replaced by the older copy.
func _read_json_version(name: String, version: int, oldest: int = -1) -> Variant:
	var path: String = _dir + "/" + name
	restore_missing(path)

	if not FileAccess.file_exists(path):
		return null

	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))

	if typeof(parsed) == TYPE_DICTIONARY and int(parsed.get("version", 0)) <= version and int(parsed.get("version", 0)) >= (version if oldest < 0 else oldest):
		if name != "world_items.json" and parsed.has("gen") and int(parsed["gen"]) > _header_gen():
			var before: Variant = JSON.parse_string(FileAccess.get_file_as_string(path + ".prev")) if FileAccess.file_exists(path + ".prev") else null

			if typeof(before) == TYPE_DICTIONARY and int(before.get("version", 0)) <= version and int(before.get("version", 0)) >= (version if oldest < 0 else oldest) and int(before.get("gen", 0)) <= _header_gen():
				push_error("server save: %s is from save %d, which stopped before it finished (the last whole save is %d): read from %s.prev, so the store is that whole save" % [path, int(parsed["gen"]), _header_gen(), path])
				_set_aside_unfinished(path)
				return before

			if before == null and _header_gen() >= 0:
				# New to the store in the save that stopped: the whole save before did not have it, so it is read as absent (an item in it
				# would otherwise also be where the save before had it).
				push_error("server save: %s is from save %d, which stopped before it finished (the last whole save is %d), and the save before had no such file: read as absent, so the store is that whole save" % [path, int(parsed["gen"]), _header_gen()])
				_set_aside_unfinished(path)
				return null

			push_error("server save: %s is from save %d, past the last whole save %d, and has no earlier copy of that save: read as it is" % [path, int(parsed["gen"]), _header_gen()])

		return parsed

	if typeof(parsed) == TYPE_DICTIONARY and int(parsed.get("version", 0)) > version:
		push_error("server items: %s was saved by a newer server (version %d, this one reads %d): not loaded, nothing saved over it" % [path, int(parsed.get("version", 0)), version])
		load_failures.append(name)   # an older build on a newer store: left as it is (terrain_server refuses to start)
		return null

	if typeof(parsed) == TYPE_DICTIONARY:
		push_error("server items: %s is an older format this build no longer reads; kept as %s.bad" % [path, path])
		DirAccess.rename_absolute(path, path + ".bad")   # dropped deliberately, as before
		return null

	if FileAccess.file_exists(path + ".prev"):
		var previous: Variant = JSON.parse_string(FileAccess.get_file_as_string(path + ".prev"))

		if typeof(previous) == TYPE_DICTIONARY and int(previous.get("version", 0)) <= version and int(previous.get("version", 0)) >= (version if oldest < 0 else oldest):
			push_error("server items: %s is damaged; kept as %s.bad and restored from the save before it" % [path, path])
			DirAccess.rename_absolute(path, path + ".bad")
			DirAccess.copy_absolute(path + ".prev", path)
			return previous

	push_error("server items: %s is damaged and has no usable earlier copy: not loaded, and nothing is saved over it" % path)
	load_failures.append(name)   # starting on an empty world here would write it over the players' saves (terrain_server refuses to start)
	return null


# A file from a save that never finished, read from its .prev at load: put aside as .unfinished and the .prev copied back in its place, so the
# next save keeps the whole save as its .prev (a second stop before that save's header lands then still reads whole).
static func _set_aside_unfinished(path: String) -> void:
	_file_lock.lock()
	DirAccess.rename_absolute(path, path + ".unfinished")

	if FileAccess.file_exists(path + ".prev"):
		DirAccess.copy_absolute(path + ".prev", path)
	_file_lock.unlock()


# The gen of the last whole save: the world_items.json header's, or its .prev's when the header is damaged (as _load_world_items reads it).
func _header_gen() -> int:
	if _head_gen == -2:
		_head_gen = -1
		var path: String = _dir + "/world_items.json"
		restore_missing(path)

		for one in [path, path + ".prev"]:
			var head: Variant = JSON.parse_string(FileAccess.get_file_as_string(one)) if FileAccess.file_exists(one) else null

			if typeof(head) == TYPE_DICTIONARY:
				_head_gen = int(head.get("gen", -1)) if head.has("areas") else -1
				break

	return _head_gen


# Writes a save file without ever leaving a half-written one: the new text goes to .tmp and is renamed over the old file,
# and the file it replaces is first copied to .prev (the fallback when a file later turns out torn or damaged).
func _write_atomic(name: String, data: Dictionary) -> void:
	var path: String = _dir + "/" + name
	var t0: int = Time.get_ticks_usec()

	if _set_gen > 0:
		data["gen"] = _set_gen

	if _async_writes:
		_pending_writes.append([path, data.duplicate(true)])   # a copy of its own: the background writer makes the JSON (see _start_writer)
		_note_save_part(name, t0)
		return

	var text: String = JSON.stringify(data)
	_note_save_part(name, t0)
	_finish_writer()

	if _write_file(path, text):
		if _set_gen > 0:
			_set_written.append(path)
	elif _set_gen > 0:
		_set_lost_file = true   # this save's header is not written (_save_item_files)


# A save part that took more than 10 ms on the tick, for the slow-tick line (lag run 5 Nov: a 675 ms save in one tick).
func _note_save_part(name: String, t0: int) -> void:
	var ms: float = float(Time.get_ticks_usec() - t0) / 1000.0

	if ms > 10.0:
		_save_parts.append("%s %.0f" % [name.get_basename(), ms])


# The disk part of a save: the text goes to .tmp, the file it replaces is copied to .prev, then .tmp is renamed over it.
# One write at a time: the background writer and a save from anywhere else (shutdown, a test's last save) used the same path.tmp, and the second rename failed with an error
# line ("Error calling utility function", exit 1 or 139 in the gates, 31 Oct 2026). The lock makes the files land in order.
static var _file_lock: Mutex = Mutex.new()


# A file another system saves through set_extras, read as the save set reads its own (a file from a save that stopped before its header
# is read from its .prev). Null when it is missing or cannot be read.
func read_set_file(name: String, version: int) -> Variant:
	var failures: int = load_failures.size()
	var parsed: Variant = _read_json_version(name, version)

	if load_failures.size() > failures:
		load_failures.resize(failures)   # read after the start's check: that system starts empty (as it did before) rather than stopping every save
		return null

	return parsed


# The number of ground edits the last whole save held (the header's "digs", or its .prev's when the header is damaged), -1 when the store
# has no such header (a new store, or one saved before #1822's follow-up): then the edit log is kept whole. Read before the items load.
static func header_digs(dir: String) -> int:
	var path: String = dir + "/world_items.json"
	restore_missing(path)

	for one in [path, path + ".prev"]:
		var head: Variant = JSON.parse_string(FileAccess.get_file_as_string(one)) if FileAccess.file_exists(one) else null

		if typeof(head) == TYPE_DICTIONARY:
			return int(head.get("digs", -1)) if head.has("areas") and head.has("gen") else -1

	return -1


# A save file that is missing while its .tmp or .prev is there is put back before it is read (22 Nov 2026, the #1597/#1598 reviews). On Windows
# Godot's rename removes the old file before it moves the .tmp over it, so a hard stop between the two leaves only path.tmp (whole: it was closed
# before the rename) and path.prev; every loader saw "no file" and started that part empty, and the next save wrote the empty one over the players'.
# The .tmp is the newer copy and is used when it parses; else the .prev. Returns what was done ("" when the file is there or nothing can be used).
static func restore_missing(path: String) -> String:
	if path == "" or FileAccess.file_exists(path):
		return ""

	_file_lock.lock()

	if FileAccess.file_exists(path):
		_file_lock.unlock()   # a save landed it while this waited for the lock (the writer's own remove-then-rename gap)
		return ""

	var done: String = ""

	if FileAccess.file_exists(path + ".tmp") and typeof(JSON.parse_string(FileAccess.get_file_as_string(path + ".tmp"))) == TYPE_DICTIONARY:
		done = "from its .tmp (the save that was being moved into place)" if DirAccess.rename_absolute(path + ".tmp", path) == OK else ""

	if done == "" and FileAccess.file_exists(path + ".prev") and DirAccess.copy_absolute(path + ".prev", path) == OK:
		done = "from its .prev (the save before it)"

	_file_lock.unlock()

	if done != "":
		push_error("server save: %s was missing; restored %s" % [path, done])

	return done


# The size of a file on disk, read with a handle that is closed before this returns (an open handle stops a rename on Windows); -1 if unreadable.
static func _length_of(path: String) -> int:
	var file: FileAccess = FileAccess.open(path, FileAccess.READ)

	if file == null:
		return -1

	var size: int = file.get_length()
	file.close()
	return size


# locked false: a small file only the main thread writes (traders, NPC flags, tile revisions, picked plants), which need not wait while the
# background writer holds the lock through a big save.
static func _write_file(path: String, text: String, locked: bool = true) -> bool:
	if locked:
		_file_lock.lock()

	var file: FileAccess = FileAccess.open(path + ".tmp", FileAccess.WRITE)

	if file == null:
		if locked:
			_file_lock.unlock()

		push_error("SERVER SAVE FAILED: cannot write %s (%s; a read-only or missing store?): the file on disk is the save before, kept as it is" % [path, error_string(FileAccess.get_open_error())])
		return false

	var stored: bool = file.store_string(text)
	var error: int = file.get_error()
	file.close()
	var whole: bool = stored and (error == OK or error == ERR_FILE_EOF)

	if whole:   # the last buffered bytes go out at the close: what landed is read back by its length
		whole = _length_of(path + ".tmp") == text.to_utf8_buffer().size()

	if not whole:
		DirAccess.remove_absolute(path + ".tmp")   # a disk that filled part way: the torn .tmp is never moved over the whole file

		if locked:
			_file_lock.unlock()

		push_error("SERVER SAVE FAILED: %s could not be written whole (%s; is the disk full?): the file on disk is the save before, kept as it is" % [path, error_string(error)])
		return false

	# The file it replaces becomes .prev by a rename, not a copy: a copy onto a full disk tore the .prev, the one fallback. A stop between the two
	# renames leaves .tmp and .prev and no file, which restore_missing puts back from the whole .tmp.
	if FileAccess.file_exists(path) and DirAccess.rename_absolute(path, path + ".prev") != OK:
		DirAccess.remove_absolute(path + ".tmp")   # the file could not become .prev (held open elsewhere?): nothing is moved, the save before stands

		if locked:
			_file_lock.unlock()

		push_error("SERVER SAVE FAILED: %s could not be moved to %s.prev: the file on disk is the save before, kept as it is" % [path, path])
		return false

	var moved: bool = DirAccess.rename_absolute(path + ".tmp", path) == OK

	if not moved:   # the save before goes back in place, as if this write never began
		DirAccess.remove_absolute(path + ".tmp")
		DirAccess.rename_absolute(path + ".prev", path)

	if locked:
		_file_lock.unlock()

	if not moved:
		push_error("SERVER SAVE FAILED: %s.tmp could not be moved into place: the save before is kept" % path)

	return moved


# The autosave only copies on the tick; the rows, the JSON and the file writes (renames, copies) run on one short-lived
# background thread, so the 20 Hz tick never waits for them. A save() from anywhere else (shutdown, tests) first waits for
# that thread, so files always land in order.
var _async_writes: bool = false
var _pending_writes: Array = []
var _writer: Thread = null


func _start_writer() -> void:
	if _pending_writes.is_empty():
		return

	if _writer != null:
		if _writer.is_alive():
			return   # the last batch is still being written (a slow disk): this one follows it (_reap_writer), never beside it

		_writer.wait_to_finish()
		_writer = null

	var batch: Array = _pending_writes
	_pending_writes = []
	_writer = Thread.new()
	_writer.start(_write_batch.bind(batch))


static func _write_batch(batch: Array) -> void:
	var whole: bool = true   # every file of this save so far written
	var written: Array = []  # the paths this save has written so far

	for row in batch:
		if typeof(row) == TYPE_DICTIONARY:   # an item job (_item_job): its files, the header last; a save that lost a file does not write its header
			if whole:
				_write_item_job(row, written)
			else:
				_skip_item_job(row, written)

			whole = true   # a batch can hold the next save too
			written = []
		elif _write_file(str(row[0]), JSON.stringify(row[1])):
			written.append(str(row[0]))
		else:
			whole = false


# A save one of whose files could not be written: its header is not written, so the store stays the save before as a whole (its other new
# files are read from their .prev at load, _read_json_version). Its areas lose their sums and are built and written again by the next save.
static func _skip_item_job(job: Dictionary, written: Array) -> void:
	var sums: Dictionary = job["sums"]

	# The files it did write go back to the save before (their .prev), so the next save keeps the whole save as their .prev: a stop in that
	# save then still reads as one whole save.
	_file_lock.lock()

	for path in written:
		if FileAccess.file_exists(str(path) + ".prev"):
			DirAccess.rename_absolute(str(path) + ".prev", str(path))
		else:
			DirAccess.remove_absolute(str(path))   # new in this save: the save before had no such file

	_file_lock.unlock()

	for key in job["areas"]:
		sums.erase(key)

	(job["failed_out"] as Array).append_array((job["areas"] as Dictionary).keys())
	(job["failed_out"] as Array).append("")   # nothing to rebuild, still a failure: the tick marks the world dirty and the save runs again
	push_error("SERVER SAVE FAILED: save %d lost a file, so its world items and header were not written: the store stays the save before, whole; the next save tries again" % int(job["gen"]))


func _reap_writer() -> void:
	if _writer != null and not _writer.is_alive():
		_writer.wait_to_finish()
		_writer = null

	_start_writer()   # a batch that waited for the one before


# The periodic save (_async_writes) waits for the last file batch only, never for log lines: it waited for queued lines, and those sat in the
# worker pool behind the flora cover chunks of a join, so the first save after every server start froze the tick 55-110 s (David4 15 Nov 2026).
# Any other save (shutdown, world reset, tests) still prints every line first.
func _finish_writer() -> void:
	if _async_writes:
		_reap_log_lines()
	else:
		for task in _log_tasks:
			WorkerThreadPool.wait_for_task_completion(task)

		_log_tasks = []

	if _writer != null:
		_writer.wait_to_finish()
		_writer = null

	if not _pending_writes.is_empty() and not _async_writes:
		var waiting: Array = _pending_writes   # queued behind a slow batch: written now, before anything newer
		_pending_writes = []
		_write_batch(waiting)


# Loose stones and fallen sticks lie about the ground (Dave, 2026-10-20: more stones near rock
# and on slopes). Laid out cell by cell around players from the world seed, so the same cell
# always has the same things; picked-up ones are remembered in _taken.
func _scatter_around_players() -> void:
	if not ground_height.is_valid():
		return

	var cfg: Dictionary = _drops.get("ground_scatter", {})
	var cell_m: float = float(cfg.get("cell_m", 32.0))
	var budget: int = SCATTER_CELLS_PER_TICK
	_throttle_mark = -1
	var started: int = Time.get_ticks_usec()   # a tick lays out cells for at most SCATTER_TICK_MAX_MS: a join took 0.7 to 6.9 s here in one go (Tyler, 1 Nov 2026)

	for peer in _peer_pos:
		var here: Vector3 = _peer_pos[peer]
		var reach: int = int(ceil(SCATTER_RADIUS_M / cell_m))
		var home: Vector2i = Vector2i(int(floor(here.x / cell_m)), int(floor(here.z / cell_m)))

		for dz in range(-reach, reach + 1):
			for dx in range(-reach, reach + 1):
				var cell: Vector2i = home + Vector2i(dx, dz)

				if budget > 0 and float(Time.get_ticks_usec() - started) / 1000.0 > SCATTER_TICK_MAX_MS:
					budget = 0

				if budget > 0 and not _cells_done.has(cell) and Vector2(dx, dz).length() * cell_m <= SCATTER_RADIUS_M:
					# A tile that is not in memory yet takes over a second to read: ask for it on a worker thread and lay this cell out next time.
					if not _cell_ground_ready(cell, cell_m):
						continue

					_cells_done[cell] = true

					if _throttle_mark < 0 and _throttle_path != "":   # once a tick, and only on a tick that lays a cell: one small kernel file read
						if _throttle_path == "?":
							_throttle_path = CpuBudget.throttle_stat_path()

						_throttle_mark = CpuBudget.throttled_usec(CpuBudget.read_text(_throttle_path)) if _throttle_path != "" else -1

					var cell_usec: int = Time.get_ticks_usec()
					var first_id: int = _next_id
					_lay_out_cell(cell, cell_m, cfg)
					_scatter_cells[cell] = range(first_id, _next_id)   # ids are given out in order: the cell's items are this run
					var cell_ms: float = float(Time.get_ticks_usec() - cell_usec) / 1000.0

					if cell_ms > 50.0:   # names a slow cell (a tile read on the main thread), so a hitch in the log says where
						# With a CPU quota (a container), how much the container's throttled time rose so far this tick (cpu.stat: summed over its
						# CPUs and every process in it, so it can read several times a pause's wall time). Above 0 means the kernel paused the group,
						# the main thread too; a pause lands in whatever sub-step is running, so it explains a slow part that is cheap on its own.
						var paused: String = ""

						if _throttle_mark >= 0:
							var now_paused: int = CpuBudget.throttled_usec(CpuBudget.read_text(_throttle_path))
							paused = "; container CPU quota throttling rose %.0f ms this tick (summed over CPUs)" % (float(now_paused - _throttle_mark) / 1000.0) if now_paused >= 0 else ""

						_log_off_main("items tick slow: scatter cell %s took %.0f ms (%s%s)" % [str(cell), cell_ms, ", ".join(_cell_parts), paused])

					budget -= 1

	# Take away the cells far from every player, with what was laid out in them (they come back from the seed when someone returns). By cell, not by
	# item: with rocky ground (PR #1988) a world holds tens of thousands of scatter rows, and a look at each row for each player took 71 ms a second
	# for 32 players (Lane A measure, 26 Nov 2026).
	var drop_sq: float = SCATTER_DROP_M * SCATTER_DROP_M

	for cell in _scatter_cells.keys():
		var cx: float = (float(cell.x) + 0.5) * cell_m
		var cz: float = (float(cell.y) + 0.5) * cell_m
		var far: bool = true

		for peer in _peer_pos:
			var off_x: float = _peer_pos[peer].x - cx
			var off_z: float = _peer_pos[peer].z - cz

			if off_x * off_x + off_z * off_z < drop_sq:
				far = false
				break

		if not far:
			continue

		for id in _scatter_cells[cell]:
			if _items.has(id) and _items[id].has("scatter"):
				_items.erase(id)

				if _still_at.has(id):
					_still_out(id)   # out of the still grids now, not left for the sync's check round

		_scatter_cells.erase(cell)
		_cells_done.erase(cell)



# The island resource landscape (boulders.json distribution, docs/design/RESOURCE_DISTRIBUTION.md): built once from the baked tiles' coarse
# maps on a worker thread at start (about a second or two; the first scatter waits for it, so no cell is ever laid out without it). Its
# report (sources near spawn, any assured source) goes to the log. dangers: [x, z, radius m] the starting-island routes keep out of
# (terrain_server: unfriendly tribes' camps and bandit camps known at start).
func start_resources(tiles_dir: String, tile_size_m: float, spawn: Vector3, dangers: Array = []) -> void:
	var cfg: Dictionary = _boulder_cfg.get("distribution", {})

	if cfg.is_empty() or _resource_task != -1:
		return

	_resource_building = ResourceContextScript.new()
	_resource_building.set("dangers", dangers.duplicate(true))
	var building: RefCounted = _resource_building
	var seed_value: int = world_seed
	var boulders: Dictionary = _boulder_cfg.duplicate(true)
	var job: Callable = func() -> void:
		var supply: Dictionary = ResourceContextScript.supply_inputs(boulders)   # the first bronze ore from the live recipes (handoff 13; off the main thread)
		building.set("first_bronze", supply["first_bronze"])
		building.set("ore_per_m3", float(supply["ore_per_m3"]))
		building.set("ore_cost", supply["ore_cost"])
		building.load_tiles(tiles_dir, tile_size_m, seed_value, cfg, spawn)

	_resource_task = WorkerThreadPool.add_task(job, false, "resource landscape")


# Waits for a landscape build still running (terrain_server _exit_tree, with the other pool tasks: none may run while the engine shuts its
# worker pool down, PoolTasks; main gate 21 Nov 2026), so a server stopped within its first seconds exits cleanly.
func finish_resources() -> void:
	if _resource_task != -1:
		WorkerThreadPool.wait_for_task_completion(_resource_task)
		_resource_task = -1
		_resource_building = null


# False while the landscape is still being built (start_resources); picks it up when done.
func _resources_ready() -> bool:
	if _resource_task == -1:
		return true

	if not WorkerThreadPool.is_task_completed(_resource_task):
		return false

	WorkerThreadPool.wait_for_task_completion(_resource_task)
	_resource_task = -1

	if bool(_resource_building.call("ready")):
		resource_context = _resource_building

	for line in _resource_building.get("report"):
		_log_off_main(str(line))

	_resource_building = null
	return true


# True when every tile the layout of this cell can read is in memory: the centre, and the four corners pushed out by SCATTER_PAD_M
# (the bank-stone water probe reaches 24 m, boulder hollows 6 m). Only the centre was checked before, so a cell at a tile edge read the
# next tile from disk on the main thread: "items tick slow: scatter reached after 479 ms" in Dave's 2 Nov log. Each missing tile is
# asked for on a worker thread (ground_ready prefetches it) and the cell waits for the next sync.
func _cell_ground_ready(cell: Vector2i, cell_m: float) -> bool:
	if not _resources_ready():
		return false

	if not ground_ready.is_valid():
		return true

	# A coal seam's height is the ground at its centre, up to about 150 m off: the cell waits for that tile too, so its outcrops and their keys
	# never hang on which tiles happened to be loaded (_seam_height).
	var seams_ready: bool = true

	if resource_context != null:
		var seams: Array = resource_context.get("seams")
		var lengths: Array = ((_boulder_cfg.get("distribution", {}) as Dictionary).get("coal", {}) as Dictionary).get("length_m", [60.0, 200.0])
		var mid: Vector2 = (Vector2(cell) + Vector2(0.5, 0.5)) * cell_m

		for n in resource_context.call("seams_near", mid.x, mid.y, float(lengths[1]) * 0.5 + SCATTER_PAD_M + cell_m):
			var seam: Dictionary = seams[n]

			if not _seam_y.has(int(seam["id"])) and not bool(ground_ready.call(float(seam["x"]), float(seam["z"]))):
				seams_ready = false   # keep asking for the rest, so they load together

	var lo: Vector2 = Vector2(cell) * cell_m - Vector2(SCATTER_PAD_M, SCATTER_PAD_M)
	var hi: Vector2 = (Vector2(cell) + Vector2.ONE) * cell_m + Vector2(SCATTER_PAD_M, SCATTER_PAD_M)
	var all_ready: bool = true

	for p in [(lo + hi) * 0.5, lo, hi, Vector2(lo.x, hi.y), Vector2(hi.x, lo.y)]:
		if not bool(ground_ready.call(p.x, p.y)):
			all_ready = false   # keep asking for the others too, so they all load together

	return all_ready and seams_ready


# The spawn boost adds up to the cap but never takes away: a sloped cell already rolling more than the cap keeps its own roll (Dino round 7).
static func boosted(base: int, add: int, cap: int) -> int:
	return maxi(base, mini(base + add, cap))


func _lay_out_cell(cell: Vector2i, cell_m: float, cfg: Dictionary) -> void:
	_cell_first_id = _next_id
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(Vector3i(cell.x, cell.y, world_seed))
	var part_usec: int = Time.get_ticks_usec()
	_cell_parts = []
	_lay_out_cave_items(cell, cell_m, cfg)
	_cell_cave_ms = float(Time.get_ticks_usec() - part_usec) / 1000.0
	part_usec = _cell_part("cave floor", part_usec)
	var centre: Vector2 = (Vector2(cell) + Vector2(0.5, 0.5)) * cell_m
	var h0: float = float(ground_height.call(centre.x, centre.y))
	var h1: float = float(ground_height.call(centre.x + 4.0, centre.y))
	var h2: float = float(ground_height.call(centre.x, centre.y + 4.0))

	if is_nan(h0) or is_nan(h1) or is_nan(h2) or h0 < 1.0:
		return

	var slope: float = (absf(h1 - h0) + absf(h2 - h0)) / 4.0
	var stones: int = mini(int(rng.randf() * (float(cfg.get("stones_flat", 0.5)) + slope * float(cfg.get("stones_per_slope", 3.0))) * 2.0), int(cfg.get("stones_max", 4)))   # luck-exempt: seeded world layout
	var sticks: int = mini(int(rng.randf() * 3.0), int(cfg.get("sticks_max", 2)))   # luck-exempt: seeded world layout
	var boost: Dictionary = cfg.get("spawn_boost", {})

	# Near the spawn every cell holds extra stones and sticks (a new player's first campfire kit; drops.json spawn_boost).
	if not boost.is_empty() and Vector2(centre.x - respawn_point.x, centre.y - respawn_point.z).length() <= float(boost.get("radius_m", 0.0)):
		var more_stones: Array = boost.get("stones_add", [0, 0])
		var more_sticks: Array = boost.get("sticks_add", [0, 0])
		stones = boosted(stones, rng.randi_range(int(more_stones[0]), int(more_stones[1])), int(boost.get("stones_max_boost", 4)))   # luck-exempt: seeded world layout
		sticks = boosted(sticks, rng.randi_range(int(more_sticks[0]), int(more_sticks[1])), int(boost.get("sticks_max_boost", 4)))   # luck-exempt: seeded world layout

	var kinds: Array = []

	for n in stones:
		kinds.append("stone")

	for n in sticks:
		kinds.append("stick")

	for n in kinds.size():
		var key: int = ((cell.x & 0xfffff) << 24) | ((cell.y & 0xfffff) << 4) | n

		if _taken.has(key):
			continue

		var spot: Vector3 = _scatter_spot(rng, cell, cell_m, kinds[n] == "stone")
		var x: float = spot.x
		var z: float = spot.z
		var y: float = spot.y

		if is_nan(y) or y < 1.0:
			continue

		_items[_next_id] = {"number": table.number_of(kinds[n]), "count": 1, "pos": Vector3(x, y, z), "left": 1.0e9, "scatter": key}
		_next_id += 1

	part_usec = _cell_part("stones and sticks", part_usec)
	_bank_ground_usec = 0
	_bank_water_usec = 0
	_lay_out_bank_stones(cell, cell_m, cfg, kinds.size())
	part_usec = _cell_part("bank stones", part_usec)
	_cell_parts[-1] += " (ground %.0f, water %.0f)" % [float(_bank_ground_usec) / 1000.0, float(_bank_water_usec) / 1000.0]
	_ore_usec = PackedInt64Array([0, 0, 0, 0, 0, 0, 0])
	_ore_split.clear()
	var reads: Dictionary = _cell_reads(cell, cell_m)   # one tile look for the boulders and both ores
	_ore_usec[0] = Time.get_ticks_usec() - part_usec
	_lay_out_boulders(cell, cell_m, reads)
	part_usec = _cell_part("boulders", part_usec)
	_lay_out_ore_rocks(cell, cell_m, "copper", reads)
	_lay_out_ore_rocks(cell, cell_m, "tin", reads)
	_lay_out_ore_rocks(cell, cell_m, "iron", reads)
	_lay_out_ore_rocks(cell, cell_m, "meteorite", reads)
	_lay_out_sources(cell, cell_m, reads)
	_lay_out_seams(cell, cell_m, reads)
	_lay_out_pockets(cell, cell_m)
	part_usec = _cell_part("copper, tin and iron rocks and meteorites", part_usec)
	_lay_out_rock_fields(cell, cell_m, reads)
	_cell_part("rocky ground", part_usec)
	var by_ore: PackedStringArray = PackedStringArray()

	for ore in _ore_split:
		by_ore.append("%s %.1f" % [ore, float(_ore_split[ore]) / 1000.0])

	var listed: int = _ore_usec[1] + _ore_usec[2] + _ore_usec[3] + _ore_usec[4] + _ore_usec[6]
	var spent: int = 0

	for ore in _ore_split:
		spent += int(_ore_split[ore])

	_cell_parts[-2] += " (reads bound %.1f, ore bodies %.1f in %d looks, ground %.1f, water %.1f, settling %.1f, foot %.1f, rest %.1f; %s)" % [float(_ore_usec[0]) / 1000.0, float(_ore_usec[1]) / 1000.0, _ore_usec[5],
		float(_ore_usec[6]) / 1000.0, float(_ore_usec[2]) / 1000.0, float(_ore_usec[3]) / 1000.0, float(_ore_usec[4]) / 1000.0, float(spent - listed) / 1000.0, ", ".join(by_ore)]


# A cell's own random stream for one part of its layout (Sonny, 10 Nov 2026). The loose stones and sticks drew first from one stream, and a stick's spot
# takes more or fewer draws as the flora cover reads 0 or 1 (cover_at reads 0 until a worker builds the flora chunk). So the bank stones and boulders after
# them moved with the timing, and a boulder's key (its worked count, its outcrop ore) could land on another boulder after a restart. Bank stones and
# boulders each draw from their own stream, seeded from the cell, the world seed and the part, so their places are fixed per world.
func _layout_rng(cell: Vector2i, part: String) -> RandomNumberGenerator:
	var stream: RandomNumberGenerator = RandomNumberGenerator.new()
	stream.seed = hash([cell.x, cell.y, world_seed, part])
	return stream


# Notes a part of a scatter cell's layout in _cell_parts (for the slow-cell line); returns now, the next part's start.
func _cell_part(part: String, since_usec: int) -> int:
	var now: int = Time.get_ticks_usec()
	_cell_parts.append("%s %.0f" % [part, float(now - since_usec) / 1000.0])
	return now


# The stones left in worked boulders from a saved world (`parsed`: its "boulders" and "boulder_per_kg"). They were counted at the save's own
# stones per kg of rock (boulder_per_kg plain, ore_per_kg ore rocks); a save without boulder_per_kg counted 0.04 stones of 1 kg per kg (before Dave's
# 19 Nov 2026 0.5 kg stones with 30% lost). Saved at other rates they wait in _boulder_pending and are scaled once when the rock is laid out and its
# kind is known (_boulder_left_of), so a half-mined rock stays half mined; layout still caps them at the rock's total.
func _load_boulders_left(parsed: Dictionary) -> void:
	var plain_then: float = float(parsed.get("boulder_per_kg", 0.04))
	var ore_then: float = float(parsed.get("ore_per_kg", plain_then))   # a save from before 21 Nov 2026 had one rate for every rock
	var same: bool = is_equal_approx(plain_then, _boulder_per_kg()) and is_equal_approx(ore_then, _boulder_per_kg(true))

	for key in parsed.get("boulders", {}):
		if same:
			_boulder_left[int(key)] = int(parsed["boulders"][key])
		else:
			_boulder_pending[int(key)] = [int(parsed["boulders"][key]), plain_then, ore_then]

	for key in parsed.get("boulders_then", {}):
		var then: Variant = parsed["boulders_then"][key]

		if typeof(then) == TYPE_ARRAY and (then as Array).size() >= 3:
			_boulder_pending[int(key)] = [int(then[0]), float(then[1]), float(then[2])]


# What is left of the rock `key` whose laid-out `row` has its total: a worked rock saved at other rates (_boulder_pending) is scaled once by
# its own kind's rate, so it keeps the share it had (plain stone and ore rocks have different rates since 21 Nov 2026); untouched = its total.
func _boulder_left_of(key: int, row: Dictionary) -> int:
	if _boulder_pending.has(key) and bool(row.get("ore_only", false)):
		_boulder_left[key] = int(_boulder_pending[key][0])   # a river iron rock's total is whole ores, not its rock's weight: kept as saved
		_boulder_pending.erase(key)

	if _boulder_pending.has(key):
		var then: Array = _boulder_pending[key]
		var ore: bool = _holds_ore(row)
		var rate_then: float = float(then[2]) if ore else float(then[1])
		_boulder_left[key] = int(round(float(then[0]) * _boulder_per_kg(ore) / rate_then)) if rate_then > 0.0 else int(then[0])
		_boulder_pending.erase(key)

	return mini(int(_boulder_left.get(key, row["total"])), int(row["total"]))


# Stones a boulder gives per kg of its rock: boulders.json yield for a plain stone rock, ore_yield for a rock with an ore (Dave 21 Nov 2026,
# BugsList 118: fewer stones from plain rocks, ore rocks as they were), over one stone's weight (weights.json, 0.5 kg). The save keeps both
# with what is left in worked boulders (load scales a save made at other rates).
func _boulder_per_kg(ore: bool = false) -> float:
	var stone_kg: float = maxf(CarryRules.weight_of("stone", _carry_cfg) if not _carry_cfg.is_empty() else 1.0, 0.05)
	return float(_boulder_cfg.get("ore_yield" if ore else "yield", _boulder_cfg.get("yield", 0.5))) / stone_kg


func _boulder_stones(radius: float, ore: bool = false) -> int:
	var volume: float = 4.0 / 3.0 * PI * radius * radius * radius * float(_boulder_cfg.get("height_ratio", 0.85))
	return maxi(int(volume * float(_boulder_cfg.get("density_kg_m3", 2600)) * _boulder_per_kg(ore)), 1)


# Boulders (Dave 2026-10-21), see data/items/boulders.json: server-owned lumps of rock a pick breaks into stones. Laid out per
# cell like loose stones, from the cell's own "boulders" stream (_layout_rng), only where the ground rises or at a
# water bank; what is left of a worked boulder is kept in _boulder_left. The row carries its radius and the stones it started
# with; the item's count is the stones left.
# A cell's ground, water and ore reads: the server's cell_reads bound to the cell's tile (one tile look and lock for the whole cell, not one a read;
# Dave's PC 21 Nov 2026, a cell's copper and tin rocks waited 409 ms on the generator lock while a player ran into new ground), else the general
# callables. The answers are the same either way (src/stream/cell_reads.gd; test_cell_reads compares the layouts).
func _cell_reads(cell: Vector2i, cell_m: float) -> Dictionary:
	var reads: Dictionary = {"ground": ground_height, "water_near": water_near, "water_depth_at": water_depth_at, "ore_near": ore_near}

	if cell_reads.is_valid():
		var mid: Vector2 = (Vector2(cell) + Vector2(0.5, 0.5)) * cell_m
		reads.merge(cell_reads.call(mid.x, mid.y), true)

	return reads


func _lay_out_boulders(cell: Vector2i, cell_m: float, reads: Dictionary = {}) -> void:
	var cfg: Dictionary = _boulder_cfg

	if cfg.is_empty():
		return

	if reads.is_empty():
		reads = _cell_reads(cell, cell_m)

	var ground: Callable = reads["ground"]
	var wet: Callable = reads["water_near"]
	var rng: RandomNumberGenerator = _layout_rng(cell, "boulders")
	var laid: int = 0

	# Every try takes the same five draws whatever happens to it, and the boulder's key is its try, not its count: a try that the live water turns
	# on or off (the bank chance) adds or drops that one boulder and moves no other boulder's key.
	for attempt in range(mini(int(cfg.get("tries", 8)), COPPER_ROCK_FIRST)):   # keys from COPPER_ROCK_FIRST up are the copper rocks' (_lay_out_ore_rocks)
		var x: float = (float(cell.x) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var z: float = (float(cell.y) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var draw: float = rng.randf()   # luck-exempt: seeded world layout
		var size_draw: float = rng.randf()   # luck-exempt: seeded world layout
		var yaw: float = rng.randf() * 360.0   # luck-exempt: seeded world layout
		var y: float = float(ground.call(x, z))

		if is_nan(y) or y < 1.0 or laid >= mini(int(cfg.get("max_per_cell", 4)), 15):
			continue

		var rise: float = (absf(float(ground.call(x + 3.0, z)) - y) + absf(float(ground.call(x, z + 3.0)) - y)) / 3.0
		var chance: float = clampf((rise - float(cfg.get("min_slope", 0.1))) * float(cfg.get("slope_chance", 2.0)), 0.0, float(cfg.get("max_chance", 0.5)))
		var spot: Vector3 = Vector3(x, y, z)

		if wet.is_valid() and not bool(wet.call(spot, 0.0)) and bool(wet.call(spot, float(cfg.get("bank_reach_m", 3.0)))):
			chance = maxf(chance, float(cfg.get("bank_chance", 0.4)))

		# The island landscape (boulders.json distribution boulder_journey_*, Dave 21 Nov 2026): fewer, smaller rounded boulders by the shore,
		# more, bigger and angular ones toward the headwaters.
		var journey: float = float(resource_context.call("journey_at", x, z)) if resource_context != null else -1.0

		if journey >= 0.0:
			var by_journey: Array = (cfg.get("distribution", {}) as Dictionary).get("boulder_journey_chance", [1.0, 1.0])
			chance *= lerpf(float(by_journey[0]), float(by_journey[1]), journey)

		if draw > chance:
			continue

		var key: int = BOULDER_KEY | ((cell.x & 0xfffff) << 24) | ((cell.y & 0xfffff) << 4) | attempt
		laid += 1
		var radius: float = lerpf(float(cfg.get("radius_min", 0.3)), float(cfg.get("radius_max", 1.2)), pow(size_draw, float(cfg.get("radius_power", 2.0))))
		var row: Dictionary = {"radius": radius, "yaw": yaw}

		if journey >= 0.0:
			var sized: Array = (cfg.get("distribution", {}) as Dictionary).get("boulder_journey_size", [1.0, 1.0])
			row["radius"] = radius * lerpf(float(sized[0]), float(sized[1]), journey)
			row["ang"] = _rock_shape(journey, false, key)
		_set_boulder_ore(row, _boulder_ore(spot, key, reads["ore_near"]), key)   # an outcrop: a pick takes this ore out of it (boulders.json ore); copper and tin resized; sets its total
		var left: int = _boulder_left_of(key, row)

		if left <= 0:
			continue

		_items[_next_id] = {"number": 0, "count": left, "pos": _settled(spot), "left": 1.0e9, "scatter": key, "boulder": row}   # on the saved digs: a boulder dug under stays down
		_next_id += 1


# A boulder row's ore: none for "", else the ore, and a copper or tin rock also its grade (boulders.json <ore>_rocks grade_min..grade_max, from
# the key): the share of its pieces that come away as ore, so rocks hold different amounts and a bigger rock more (Dave 16 Nov 2026).
func _set_boulder_ore(row: Dictionary, ore_name: String, key: int) -> void:
	_set_boulder_ore_only(row, ore_name, key)
	row["total"] = _boulder_stones(float(row["radius"]), _holds_ore(row))   # an ore rock holds stones at ore_yield, a plain one at yield (BugsList 118)


# Whether a boulder row is an ore rock (boulders.json ore items: copper, tin, iron, coal, salt), which keeps ore_yield. A limestone, chalk or marble
# rock (ore "rocks") is stone of another kind and holds stones at the plain yield like any rock (Dave 21 Nov 2026, BugsList 118). So does a
# meteorite (meteorite_rocks plain_yield, Dave 21 Nov 2026): a lump of metal the size of a small rock, not a big ore rock.
func _holds_ore(row: Dictionary) -> bool:
	return row.has("ore") and ((_boulder_cfg.get("ore", {}) as Dictionary).get("items", {}) as Dictionary).has(str(row["ore"])) and not bool((_boulder_cfg.get(str(row["ore"]) + "_rocks", {}) as Dictionary).get("plain_yield", false))


func _set_boulder_ore_only(row: Dictionary, ore_name: String, key: int) -> void:
	if ore_name == "":
		return

	row["ore"] = ore_name
	var own: Dictionary = _boulder_cfg.get(ore_name + "_rocks", {})

	if own.is_empty() or bool(own.get("outcrops_unchanged", false)):
		return   # coal, salt and the rest, and iron (its own rule lays only hand stones): an outcrop without a grade or a size range

	var shared: Dictionary = _boulder_cfg.get("ore_rocks", {})   # read in place: _ore_rock_cfg copies, and this runs for every ore boulder

	if own.has("grade_min"):
		row["grade"] = lerpf(float(own["grade_min"]), float(own.get("grade_max", own["grade_min"])), float(hash([key, "grade"]) % 1000) / 999.0)

	# Every copper and tin rock to break is radius_min..radius_max (Dave 17 Nov 2026: "the copper should be the same size as the tin and they
	# can be anywhere from .5m to 2m in size ... for both of them"), the geology's outcrop boulders included.
	var r_min: Variant = own.get("radius_min", shared.get("radius_min"))
	var r_max: Variant = own.get("radius_max", shared.get("radius_max"))

	if r_min != null and r_max != null:
		var radius: float = clampf(float(row["radius"]), float(r_min), float(r_max))

		row["radius"] = radius


# Copper and tin rocks (Dave 16-17 Nov 2026, his photos; one shared rule since his 21 Nov 2026 play test; docs/design/COPPER_ROCKS.md,
# boulders.json ore_rocks, copper_rocks and tin_rocks). Per cell, from the cell's own stream named after the ore, 8 tries that each take the
# same five draws whatever happens to them; both ores alike:
# - along every river and lake: shallow water and dry banks, commoner and bigger the higher the ground (toward the mountains), rarer and
#   smaller near the sea, never none;
# - a small chance anywhere on dry land;
# - very many over a body of its own ore (the geology), wherever the spot lies;
# - the last try a big boulder at a mountain's foot.
# A share hand_share of the sizes is a loose ore item picked up by hand (ORE_KEY, kept in _taken like any scatter); the rest are boulder
# rows with the ore, radius_min..radius_max (0.5 to 2 m across, Dave 17 Nov 2026), broken with a hammer or pick. Slots `slot`.. of the cell: copper 8..15 (BOULDER_KEY, after the cell's
# boulders), tin 16..23 (ORE_KEY | BOULDER_KEY), iron 24..30 (since Dave 21 Nov 2026: commoner by its own chances, half loose stones picked by hand
# and half small all-ore rocks of two or three ores for a bronze or better pick: iron_rocks sizes) and meteorites 32..38 (Dave 21 Nov 2026: Iron
# chunks, the same everywhere, with no ore body or mountain foot). Nothing depends on where spawn is.
func _lay_out_ore_rocks(cell: Vector2i, cell_m: float, ore: String, reads: Dictionary = {}) -> void:
	var started: int = Time.get_ticks_usec()
	_lay_out_ore_rocks_of(cell, cell_m, ore, reads)
	_ore_split[ore] = int(_ore_split.get(ore, 0)) + Time.get_ticks_usec() - started


func _lay_out_ore_rocks_of(cell: Vector2i, cell_m: float, ore: String, reads: Dictionary) -> void:
	var cfg: Dictionary = _ore_rock_cfg(ore)
	var item: String = str((_boulder_cfg.get("ore", {}).get("items", {}) as Dictionary).get(ore, ""))

	if cfg.is_empty() or item == "":
		return

	if reads.is_empty():
		reads = _cell_reads(cell, cell_m)

	var ground: Callable = reads["ground"]
	var wet: Callable = reads["water_near"]
	var depth_at: Callable = reads["water_depth_at"]
	var body_at: Callable = reads["ore_near"]
	var rng: RandomNumberGenerator = _layout_rng(cell, ore)
	var reach: float = float(cfg.get("bank_reach_m", 3.0))
	var bed_m: float = float(cfg.get("bed_depth_m", 0.8))
	var foot: Dictionary = cfg.get("foot", {})
	var slot0: int = int(cfg.get("slot", COPPER_ROCK_FIRST))
	var hand_share: float = float(cfg.get("hand_share", 0.0))
	var sizes: Array = cfg.get("sizes", [])
	var ore_stone_kg: float = maxf(CarryRules.weight_of("stone", _carry_cfg) if not _carry_cfg.is_empty() else 1.0, 0.05)
	var land_p: float = float(cfg.get("chance", 0.0))
	var coast_p: float = float(cfg.get("water_chance_coast", 0.0))
	var mountain_p: float = float(cfg.get("water_chance_mountain", coast_p))
	var low_m: float = float(cfg.get("upland_low_m", 0.0))
	var span_m: float = maxf(float(cfg.get("upland_high_m", low_m + 1.0)) - low_m, 1.0)
	var size_coast: float = float(cfg.get("size_coast", 1.0))
	var body_m: float = float(cfg.get("body_reach_m", 0.0))
	var body_p: float = 0.0
	var cell_bits: int = ((cell.x & 0xfffff) << 28) | ((cell.y & 0xfffff) << 8)
	var names: Dictionary = {ore: item}
	var layer_m: float = float(_boulder_cfg.get("ore", {}).get("layer_depth_m", 10.0))

	# Its own ore body: one geology look for the whole cell first (any of its spots within body_reach_m of a body), so only a cell by a body
	# asks again per spot.
	if body_m > 0.0 and body_at.is_valid():
		var mid: Vector2 = (Vector2(cell) + Vector2(0.5, 0.5)) * cell_m
		var mid_y: float = float(ground.call(mid.x, mid.y))

		var look_usec: int = Time.get_ticks_usec()

		if not is_nan(mid_y) and str(body_at.call(Vector3(mid.x, mid_y, mid.y), body_m + cell_m * 0.71, names, layer_m)) == ore:
			body_p = float(cfg.get("body_chance", 0.0))

		_ore_usec[1] += Time.get_ticks_usec() - look_usec
		_ore_usec[5] += 1

	var top_p: float = maxf(maxf(land_p, maxf(coast_p, mountain_p)), body_p)

	for attempt in range(ORE_ROCK_TRIES):
		var x: float = (float(cell.x) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var z: float = (float(cell.y) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var draw: float = rng.randf()   # luck-exempt: seeded world layout
		var size_draw: float = rng.randf()   # luck-exempt: seeded world layout
		var yaw: float = rng.randf() * 360.0   # luck-exempt: seeded world layout
		var is_foot: bool = not foot.is_empty() and attempt == ORE_ROCK_TRIES - 1   # the last try is the mountain-foot boulder's

		if is_foot:
			if draw > float(foot.get("chance", 0.0)):
				continue
		elif attempt >= mini(int(cfg.get("tries", 4)), ORE_ROCK_TRIES - 1) or draw > top_p:
			continue   # cheap refusals first: most tries end here without reading the ground or the water

		var ground_usec: int = Time.get_ticks_usec()
		var y: float = float(ground.call(x, z))
		_ore_usec[6] += Time.get_ticks_usec() - ground_usec

		if is_nan(y) or y < 1.0:
			continue

		var spot: Vector3 = Vector3(x, y, z)
		var upland: float = clampf((y - low_m) / span_m, 0.0, 1.0)   # 0 on the coastal plain, 1 under the mountains
		var over_body: bool = false
		# The island landscape (boulders.json distribution, Dave 21 Nov 2026): upland is the spot's journey from the shore to the headwaters,
		# and its own area (paint) scales every chance; by water a river clue of its own sources counts as much as the area, so rounded
		# finds lead up their own river from a source (and never far from one). Without the landscape (tests, no tiles): height, everywhere.
		var area: float = 1.0
		var river_clue: float = 0.0

		if resource_context != null and ORE_METALS.has(ore):
			upland = float(resource_context.call("rich_at", x, z))   # the rich layer at the mountain foot (Dave 27 Nov 2026, BugsList 186)
			area = float(resource_context.call("field_at", int(ORE_METALS[ore]), x, z))
			river_clue = float(resource_context.call("clue_at", int(ORE_METALS[ore]), x, z))

		if is_foot and area < 0.5:
			continue   # no mountain-foot boulder of an ore outside its area

		if not is_foot and body_p > 0.0 and draw <= body_p * area:
			var body_usec: int = Time.get_ticks_usec()
			over_body = str(body_at.call(spot, body_m, names, layer_m)) == ore   # the spot itself over its own ore
			_ore_usec[1] += Time.get_ticks_usec() - body_usec
			_ore_usec[5] += 1

		if not is_foot and not over_body and draw > maxf(land_p * area, lerpf(coast_p, mountain_p, upland) * maxf(area, river_clue)):
			continue   # past every chance this far in: no ground water read

		var by_water_only: bool = not is_foot and not over_body and draw > land_p * area
		var water_usec: int = Time.get_ticks_usec()

		if by_water_only and wet.is_valid() and not bool(wet.call(spot, reach)):
			_ore_usec[2] += Time.get_ticks_usec() - water_usec
			continue   # no water within reach (most of the land): no depth read, no second probe

		var depth: float = float(depth_at.call(spot)) if depth_at.is_valid() else 0.0
		_ore_usec[2] += Time.get_ticks_usec() - water_usec

		if depth > bed_m:
			continue   # deep water: nobody would find it

		if is_foot:
			var foot_usec: int = Time.get_ticks_usec()
			var at_foot: bool = depth <= 0.0 and _at_mountain_foot(spot, foot, ground)
			_ore_usec[4] += Time.get_ticks_usec() - foot_usec

			if not at_foot:
				continue
		elif by_water_only:
			# Past the land share: only on a river or lake bed (shallow water) or a dry bank within reach of water.
			var bank_usec: int = Time.get_ticks_usec()
			var bank: bool = depth <= 0.0 and wet.is_valid() and not bool(wet.call(spot, 0.0)) and bool(wet.call(spot, reach))
			_ore_usec[2] += Time.get_ticks_usec() - bank_usec

			if depth <= 0.0 and not bank:
				continue

		# Size: a share s in 0..1, the draw scaled down toward the sea (size_coast) and full under the mountains (over its own body raised by
		# body_upland). Under hand_share it is a loose piece picked up by hand; above it a rock to break, radius_min..radius_max over the rest.
		if over_body:
			upland = minf(upland + float(cfg.get("body_upland", 0.0)), 1.0)

		var s: float = size_draw * lerpf(size_coast, 1.0, upland)

		if by_water_only and river_clue > area:
			s *= lerpf(float(cfg.get("clue_size_min", 0.4)), 1.0, river_clue)   # carried from a source: smaller the farther downstream

		var radius: float

		if is_foot:
			radius = lerpf(float(foot.get("radius_min", 0.6)), float(foot.get("radius_max", 1.0)), pow(size_draw, float(foot.get("radius_power", 1.0))))
		else:
			radius = lerpf(float(cfg.get("radius_min", 0.25)), float(cfg.get("radius_max", 1.0)), pow(clampf((s - hand_share) / maxf(1.0 - hand_share, 0.01), 0.0, 1.0), float(cfg.get("radius_power", 1.0))))

		# Sizes in whole ores (iron_rocks sizes, Dave 21 Nov 2026: "1 ingot sized iron rocks will be 50% of the stones out there, 30% of them should be
		# double that size and 20% can be triple sized"): [[share, ores], ...] by the size draw; one ore is a loose stone picked up by hand, more is a
		# small rock of that many ores' volume (ingot_radius_m for one), all ore, broken with the ore's own pick.
		var ores_in: int = 0

		if not is_foot and not sizes.is_empty():
			var acc: float = 0.0
			ores_in = int((sizes[sizes.size() - 1] as Array)[1])
			# Small by the shore, bigger each layer up (Dave 27 Nov 2026, the layered cake): the size draw shrinks toward the sea like the
			# other ores' (size_coast), so the shore has one-ore stones and the two- and three-ore ones come in going up.
			var ores_draw: float = size_draw * lerpf(size_coast, 1.0, upland)

			for size_row in sizes:
				acc += float(size_row[0])

				if ores_draw < acc:
					ores_in = int(size_row[1])
					break

			radius = float(cfg.get("ingot_radius_m", 0.07)) * pow(float(ores_in), 1.0 / 3.0)

		var slot: int = slot0 + attempt

		if (ores_in == 1) if ores_in > 0 else (s < hand_share and not is_foot):
			var loose_key: int = ORE_KEY | cell_bits | slot

			if not _taken.has(loose_key):
				_items[_next_id] = {"number": table.number_of(item), "count": 1, "pos": spot, "left": 1.0e9, "scatter": loose_key}
				_next_id += 1

			continue

		var key: int = (BOULDER_KEY | ((cell.x & 0xfffff) << 24) | ((cell.y & 0xfffff) << 4) | slot) if slot < BOULDER_TRIES_MAX else (ORE_KEY | BOULDER_KEY | cell_bits | slot)
		var row: Dictionary = {"radius": radius, "yaw": yaw}

		if resource_context != null and ORE_METALS.has(ore):
			row["ang"] = _rock_shape(upland, by_water_only or depth > 0.0, key)   # water-worn round by rivers, broken and angular inland

		_set_boulder_ore(row, ore, key)

		if ores_in > 1:
			row["radius"] = radius   # its own small size, never the shared 0.5 to 2 m clamp
			row["grade"] = 1.0
			row["ore_only"] = true
			row["total"] = ores_in * _ore_cost(item, ore_stone_kg)

		var left: int = _boulder_left_of(key, row)

		if left <= 0:
			continue

		var settle_usec: int = Time.get_ticks_usec()
		var rest: Vector3 = _settled(spot)   # on the saved digs: a boulder dug under stays down
		_ore_usec[3] += Time.get_ticks_usec() - settle_usec
		_items[_next_id] = {"number": 0, "count": left, "pos": rest, "left": 1.0e9, "scatter": key, "boulder": row}
		_next_id += 1


# Rocky ground (boulders PLAN.md sections 6 to 8, stages 2 and 3; Dave 26 Nov 2026 "rocks and boulders on and around mountains where they
# should be"): rocks laid where nature leaves them, over the cell's own boulders and ore rocks, all values in boulders.json rock_fields
# (PROVISIONAL RF-1, to be tuned in play):
# - scree and boulder fields on the gentler ground at the foot of cliffs and steep slopes (the ground rises more than scree_rise_m within
#   relief_reach_m), denser and bigger the higher the wall;
# - rocky ground above the treeline (the tiles' land types: alpine meadow and bare rock from treeline_m);
# - crags standing out of the steep mountainsides (most of the ground above the treeline is steeper than a loose rock lies on), tilted to the face;
# - outcrops on hilltops (the cell's middle stands over all four sides at relief_reach_m by top_drop_m);
# - rounded rocks in shallow river and lake beds and on their banks, more and bigger up toward the headwaters (the journey);
# - now and then a lone giant boulder on an open valley floor;
# - loose stones to pick up on the same rocky ground.
# A seeded patch noise (patch_m across) makes the mountain kinds come in patches, not an even sprinkle. Every try takes the same draws
# from the cell's own "rock fields" stream whatever happens to it and its key is its slot, so a rock never moves to another's key; the keys
# are new (FIELD_KEY), so the cell's older boulders and every worked rock stay as they were. No rock is laid on or beside anything built
# (any structure: buildings, stations, tilled beds, trodden paths and roads), nor in Edda and Hob's camp or a goblin camp (NpcCamp keep);
# nothing depends on where spawn is. No count limit on what is drawn; the tries are the layout's own steps.
func _lay_out_rock_fields(cell: Vector2i, cell_m: float, reads: Dictionary) -> void:
	var cfg: Dictionary = _boulder_cfg.get("rock_fields", {})

	if cfg.is_empty() or not bool(cfg.get("enabled", true)):
		return

	var ground: Callable = reads["ground"]
	var mid: Vector2 = (Vector2(cell) + Vector2(0.5, 0.5)) * cell_m
	var h0: float = float(ground.call(mid.x, mid.y))

	if is_nan(h0) or h0 < 1.0:
		return

	var density: float = float(cfg.get("density_scale", 1.0))
	var reach: float = minf(float(cfg.get("relief_reach_m", 24.0)), SCATTER_PAD_M - 4.0)
	var rise_most: float = 0.0
	var drop_least: float = INF
	var across: Array = []   # the ground east, west, south and north of the middle (how steep the cell is, for the crags)

	for d in [Vector2(reach, 0.0), Vector2(-reach, 0.0), Vector2(0.0, reach), Vector2(0.0, -reach)]:
		var h: float = float(ground.call(mid.x + d.x, mid.y + d.y))
		across.append(h)

		if not is_nan(h):
			rise_most = maxf(rise_most, h - h0)
			drop_least = minf(drop_least, h0 - h)

	var treeline: float = float(cfg.get("treeline_m", 620.0))
	var rise_m: float = maxf(float(cfg.get("scree_rise_m", 10.0)), 0.1)
	var patch: float = smoothstep(1.0 - float(cfg.get("patch_share", 0.35)) - 0.1, 1.0 - float(cfg.get("patch_share", 0.35)) + 0.1, _rock_patch(mid, float(cfg.get("patch_m", 96.0))))
	# Each kind's clusters a cell: scree is worked out per cluster (the wall above its spot), so the cell only asks whether a wall may be near;
	# above the treeline and on a hilltop the cell's middle decides.
	var scree_near: bool = rise_most >= rise_m * 0.5
	var scree_full: float = float(cfg.get("scree_clusters", 2.5)) * lerpf(float(cfg.get("scree_patch_floor", 0.25)), 1.0, patch) * density
	# The foot band (Dave 27 Nov 2026: "right were it starts to transition from hill to flat ground there should be much bigger boulders. the type
	# that make the terrain hard to traverse"): scree spots on near-flat ground (foot.flat_max) take foot.clusters, foot-sized cores and more satellites.
	var foot: Dictionary = cfg.get("foot", {})
	var foot_full: float = float(foot.get("clusters", 0.0)) * lerpf(float(cfg.get("scree_patch_floor", 0.25)), 1.0, patch) * density
	var high: float = smoothstep(treeline - float(cfg.get("treeline_fade_m", 60.0)), treeline + float(cfg.get("treeline_full_m", 40.0)), h0)
	var high_n: float = high * float(cfg.get("high_clusters", 1.6)) * lerpf(float(cfg.get("high_patch_floor", 0.4)), 1.0, patch) * density
	var top_n: float = (float(cfg.get("top_clusters", 1.0)) * density) if drop_least != INF and drop_least >= float(cfg.get("top_drop_m", 8.0)) else 0.0
	# Crags: on ground steeper than `steepest` (the mountainsides; the tiles draw it bare rock from 48 degrees) rocks stand out of the face,
	# tilted to it, by how steep the cell is across relief_reach_m (the four reads above).
	var crag: Dictionary = cfg.get("crag", {})
	var crag_n: float = 0.0

	if not crag.is_empty() and h0 >= float(crag.get("min_height_m", 0.0)):
		var steep: float = Vector2(float(across[0]) - float(across[1]), float(across[2]) - float(across[3])).length() / (2.0 * reach)
		var fade: Array = crag.get("from", [0.8, 1.1])

		if not is_nan(steep):
			crag_n = smoothstep(float(fade[0]), float(fade[1]), steep) * float(crag.get("clusters", 1.5)) * lerpf(float(crag.get("patch_floor", 0.6)), 1.0, patch) * density

	var most: float = maxf(maxf(maxf(maxf(scree_full, foot_full) if scree_near else 0.0, high_n), top_n), crag_n)   # the most clusters any spot of the cell can have
	var rng: RandomNumberGenerator = _layout_rng(cell, "rock fields")
	var cell_bits: int = ((cell.x & 0xfffff) << 28) | ((cell.y & 0xfffff) << 8)
	var journey_mid: float = float(resource_context.call("journey_at", mid.x, mid.y)) if resource_context != null else -1.0
	var built: Array = []   # positions of what stands near the cell (looked up once, and only when it lays something)
	var pieces: Array = []   # of those, the built pieces and fires (not the players): no talus is laid under them (_skirt_clear)
	var taken: Array = []   # [x, z, radius] of the rocks lying near the cell: older boulders and those laid here, so no two overlap
	var looked: Array = [false]
	var wet: Callable = reads["water_near"]
	var depth_at: Callable = reads["water_depth_at"]
	var lone: Dictionary = cfg.get("erratic", {})
	var sizes: Dictionary = cfg.get("radius", {})
	var power: float = float(cfg.get("radius_power", 1.6))
	var centres: Array = []   # [x, z] of the clusters laid here (the loose stones lie round them)

	# One rock at (x, z): on ground no steeper than steepest (a lone giant: gentle ground), out of deep water, off anything built, a fire, a
	# player and a camp, overlapping no other; set into a slope by sink_share of the drop across it. True when its ground is its own (laid, or
	# mined out and kept clear), false when it was refused.
	var lay_rock: Callable = func(slot: int, x: float, z: float, radius: float, yaw: float, kind: String) -> bool:
		var y: float = float(ground.call(x, z))

		if is_nan(y) or y < 1.0:
			return false

		var spot: Vector3 = Vector3(x, y, z)
		var rise: float = _ground_fall(ground, x, z, 1.0)
		var foot_field: bool = kind == "foot"   # a rock of the foot band: scree, with the client's boulder field round it (its skirt's 4th value)

		if foot_field:
			kind = "scree"

		if kind == "crag" and rise <= float(cfg.get("steepest", 1.0)):
			kind = "scree"   # a crag's satellite on ground gentle enough to hold it is a broken-off rock lying at the crag's foot, not a crag

		var steepest: float = float(crag.get("steepest", 2.5)) if kind == "crag" else float(cfg.get("steepest", 1.0)) * (0.3 if kind == "erratic" else 1.0)

		if not (rise <= steepest):
			return false   # a loose rock does not sit on a cliff face (a crag stands out of it, up to its own steepest); a giant lies on gentle ground

		if kind != "water" and depth_at.is_valid() and float(depth_at.call(spot)) > float(cfg.get("water_bed_m", 0.6)):
			return false

		if NpcCamp.within_keep(spot):
			return false

		if not bool(looked[0]):
			looked[0] = true
			_rock_field_neighbours(mid, h0, cell_m, cfg, built, taken, pieces)

		if not _rock_field_clear(x, z, radius, float(cfg.get("keep_clear_m", 4.0)), built, taken):
			return false

		var key: int = FIELD_KEY | BOULDER_KEY | cell_bits | slot
		var row: Dictionary = {"radius": radius, "yaw": yaw, "field": 1}   # "field": the client draws it as rocky-ground rock (world ids do not carry the key)
		var sink: float = rise * radius * float(cfg.get("sink_share", 0.6))   # its low side meets the ground instead of hanging over it

		if kind == "crag":
			# A crag leans with the face (the client tilts it to the ground's normal from its fall per metre along x and z), set into it by
			# crag.sink_share of its radius; it has no apron (nothing loose stays on a face that steep).
			row["tilt"] = [snappedf((float(ground.call(x + 1.0, z)) - float(ground.call(x - 1.0, z))) * 0.5, 0.01), snappedf((float(ground.call(x, z + 1.0)) - float(ground.call(x, z - 1.0))) * 0.5, 0.01)]
			sink = radius * float(crag.get("sink_share", 0.3))
		elif kind in ["scree", "high", "top"] and radius >= float(cfg.get("apron_from_m", 0.8)) and _skirt_clear(spot, radius * (FOOT_SKIRT_REACH if foot_field else SKIRT_REACH), pieces):
			# The client lays an apron of broken stones round a big mountain rock (look only, inventory_view _skirt_mesh): the ground's fall per
			# metre along x and z, and how deep the rock is set (the apron lies on the ground, not at the rock's sunk middle).
			row["skirt"] = [snappedf((float(ground.call(x + 1.0, z)) - float(ground.call(x - 1.0, z))) * 0.5, 0.01), snappedf((float(ground.call(x, z + 1.0)) - float(ground.call(x, z - 1.0))) * 0.5, 0.01), snappedf(sink, 0.01)]

			if foot_field:
				# Dave 27 Nov 2026 on rocks13: "multiply the boulders numbers by like 30 and make them bigger the lower they go". Thirty times the
				# rows would cost the world sync thirty times (rocks5: 38 ms at 154 rocks a player), so the boulders between are the client's: a
				# field of big broken chunks round this rock (inventory_view _skirt_mesh foot variants: look and collision, no rows).
				row["skirt"].append(1)

		row["ang"] = _rock_shape(journey_mid if journey_mid >= 0.0 else 1.0, kind == "water", key) if kind not in ["scree", "crag"] else _rock_shape(1.0, false, key)   # scree and crags are freshly broken
		_set_boulder_ore(row, _boulder_ore(spot, key, reads["ore_near"]), key)   # an outcrop where the geology has an ore near, limestone over limestone
		var left: int = _boulder_left_of(key, row)
		taken.append([x, z, radius])   # a mined-out rock keeps its ground too, so no other try takes its place when the cell is laid again

		if left > 0:
			_items[_next_id] = {"number": 0, "count": left, "pos": _settled(spot) - Vector3(0.0, sink, 0.0), "left": 1.0e9, "scatter": key, "boulder": row}
			_next_id += 1

		return true

	# Mountain clusters: a big core rock with smaller ones round it (a fallen block that broke, a frost-split outcrop). Each try takes the same
	# draws whatever happens to it (6, then 4 for each of its FIELD_CLUSTER_SLOTS - 1 satellites), and its rocks have the try's own slots.
	var satellites: Array = cfg.get("satellites", [1, 4])
	var share: Array = cfg.get("satellite_share", [0.25, 0.6])
	var spread: float = float(cfg.get("satellite_spread", 1.5))

	for attempt in range(FIELD_CLUSTER_TRIES):
		var x: float = (float(cell.x) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var z: float = (float(cell.y) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var draw: float = rng.randf() * float(FIELD_CLUSTER_TRIES)   # luck-exempt: seeded world layout
		var size_draw: float = rng.randf()   # luck-exempt: seeded world layout
		var yaw: float = rng.randf() * 360.0   # luck-exempt: seeded world layout
		var count_draw: float = rng.randf()   # luck-exempt: seeded world layout
		var around: Array = []

		for k in range(FIELD_CLUSTER_SLOTS - 1):
			around.append([rng.randf() * TAU, rng.randf(), rng.randf(), rng.randf() * 360.0])   # luck-exempt: seeded world layout

		if draw >= most:
			continue   # cheap refusals first: most tries end here, no ground read

		var y: float = float(ground.call(x, z))

		if is_nan(y):
			continue

		var rise: float = _ground_fall(ground, x, z, 1.0)
		var scree: float = 0.0

		if scree_near and rise <= float(cfg.get("scree_flat_max", 0.6)):
			scree = clampf((_relief(Vector3(x, y, z), reach, ground) - rise_m) / rise_m, 0.0, 1.0)   # 0 at scree_rise_m within relief_reach_m, 1 at twice it

		var at_foot: bool = scree > 0.0 and not foot.is_empty()   # every scree spot: the band along the whole line where hill meets flat (rocks14: a flat-only band was a few patches)
		var scree_n: float = scree * (foot_full if at_foot else scree_full)
		var kind: String = "scree" if scree_n >= high_n and scree_n >= top_n else ("high" if high_n >= top_n else "top")
		var chance: float = maxf(maxf(scree_n, high_n), top_n)

		if rise > float(cfg.get("steepest", 1.0)):
			kind = "crag"   # too steep for a loose rock: only a crag stands here
			chance = crag_n

		if draw >= chance:
			continue

		if kind == "top" and y < h0 - float(cfg.get("top_near_m", 2.0)):
			continue   # a hilltop's outcrop lies on its crown, not down its sides

		at_foot = at_foot and kind == "scree"
		var range_m: Array = sizes.get("foot" if at_foot else kind, [1.0, 2.0])
		var size: float = pow(size_draw, power)

		if kind == "scree":
			size = minf(size * lerpf(1.0, float(cfg.get("scree_wall_size", 1.4)), scree), 1.0)   # bigger under a higher wall

		var core: float = lerpf(float(range_m[0]), float(range_m[1]), size)

		if at_foot:
			core *= lerpf(1.0, float(foot.get("steep_share", 0.6)), smoothstep(float(foot.get("flat_max", 0.3)), float(cfg.get("scree_flat_max", 0.85)), rise))   # the flatter (the lower), the bigger

		var up_hill: Array = cfg.get("up_hill", [])

		if up_hill.size() >= 3 and not at_foot and kind in ["scree", "crag", "high"]:
			# Smaller the higher up the hill (Dave 27 Nov 2026: "higher up on the hill they should be smaller, the lower they get the bigger they
			# should be"): how far the ground falls below the spot within relief_reach_m, from up_hill[0] m (full size) to up_hill[1] m (up_hill[2]
			# of it).
			var lowest: float = y

			for d in [Vector2(reach, 0.0), Vector2(-reach, 0.0), Vector2(0.0, reach), Vector2(0.0, -reach)]:
				var below_h: float = float(ground.call(x + d.x, z + d.y))

				if not is_nan(below_h):
					lowest = minf(lowest, below_h)

			core *= lerpf(1.0, float(up_hill[2]), smoothstep(float(up_hill[0]), float(up_hill[1]), y - lowest))
		var slot0: int = attempt * FIELD_CLUSTER_SLOTS

		if not bool(lay_rock.call(slot0, x, z, core, yaw, "foot" if at_foot else kind)):
			continue   # no core, no cluster

		centres.append([x, z])
		var counts: Array = foot.get("satellites", satellites) if at_foot else satellites
		var many: int = int(round(lerpf(float(counts[0]), float(counts[1]), count_draw)))

		for k in range(mini(many, FIELD_CLUSTER_SLOTS - 1)):
			var a: Array = around[k]
			var small: float = core * lerpf(float(share[0]), float(share[1]), pow(float(a[2]), power))
			var out: float = minf(core + small + float(a[1]) * core * spread, FIELD_SATELLITE_REACH_M - small)   # within the neighbour lookup's reach
			var sx: float = x + cos(float(a[0])) * out
			var sz: float = z + sin(float(a[0])) * out

			if kind == "top" and float(ground.call(sx, sz)) < h0 - float(cfg.get("top_near_m", 2.0)):
				continue   # a hilltop's rocks stay on its crown

			lay_rock.call(slot0 + 1 + k, sx, sz, small, float(a[3]), "foot" if at_foot else kind)

	# Rivers and lakes: one look whether water is near the cell at all (as the bank stones do), then rounded rocks in the shallows and on the banks.
	var water_p: float = float(cfg.get("water_rocks", 6.0)) * density

	if water_p > 0.0 and wet.is_valid() and bool(wet.call(Vector3(mid.x, h0, mid.y), float(cfg.get("water_probe_m", 24.0)))):
		if journey_mid >= 0.0:
			var by_journey: Array = cfg.get("water_journey", [0.4, 1.6])
			water_p *= lerpf(float(by_journey[0]), float(by_journey[1]), journey_mid)

		for n in range(FIELD_WATER_TRIES):
			var x: float = (float(cell.x) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
			var z: float = (float(cell.y) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
			var draw: float = rng.randf()   # luck-exempt: seeded world layout
			var size_draw: float = rng.randf()   # luck-exempt: seeded world layout
			var yaw: float = rng.randf() * 360.0   # luck-exempt: seeded world layout

			if draw * float(FIELD_WATER_TRIES) >= water_p:
				continue

			var y: float = float(ground.call(x, z))

			if is_nan(y):
				continue

			var spot: Vector3 = Vector3(x, y, z)
			var depth: float = float(depth_at.call(spot)) if depth_at.is_valid() else 0.0

			if depth > float(cfg.get("water_bed_m", 0.6)):
				continue   # deep water: nobody would find it

			if depth <= 0.0 and (bool(wet.call(spot, 0.0)) or not bool(wet.call(spot, float(cfg.get("water_bank_m", 3.0))))):
				continue   # neither in the shallows nor on a bank

			var size: float = pow(size_draw, power) * (lerpf(0.5, 1.0, journey_mid) if journey_mid >= 0.0 else 1.0)   # smaller down toward the sea
			var range_w: Array = sizes.get("water", [0.2, 0.7])
			lay_rock.call(FIELD_WATER_FIRST + n, x, z, lerpf(float(range_w[0]), float(range_w[1]), size), yaw, "water")

	# A lone giant (an erratic): open, gentle ground below the treeline, away from steep ground and water.
	if not lone.is_empty() and not scree_near and high <= 0.0 and h0 >= float(lone.get("min_height_m", 0.0)):
		var lone_draw: float = float(hash([cell.x, cell.y, world_seed, "erratic"]) % 100000) / 100000.0

		if lone_draw < float(lone.get("chance", 0.0)) * density:
			var along: Callable = func(what: String) -> float: return float(hash([cell.x, cell.y, world_seed, what]) % 1000) / 999.0
			var gx: float = (float(cell.x) + 0.2 + 0.6 * along.call("erratic x")) * cell_m
			var gz: float = (float(cell.y) + 0.2 + 0.6 * along.call("erratic z")) * cell_m
			var gy: float = float(ground.call(gx, gz))
			var range_g: Array = sizes.get("erratic", [2.5, 3.0])

			if not is_nan(gy) and not (wet.is_valid() and bool(wet.call(Vector3(gx, gy, gz), float(lone.get("water_clear_m", 8.0))))):
				lay_rock.call(FIELD_ERRATIC_SLOT, gx, gz, lerpf(float(range_g[0]), float(range_g[1]), pow(along.call("erratic size"), power)), along.call("erratic yaw") * 360.0, "erratic")

	# Loose stones round the clusters (drops.json ground_scatter gives every cell a few; a rocky one more).
	var loose: int = mini(int(round(float(centres.size()) * float(cfg.get("loose_per_cluster", 1.0)))), FIELD_LOOSE_MAX)

	if loose <= 0 or table == null or not table.has_method("number_of"):
		return

	var stone: int = table.number_of("stone")
	var loose_rng: RandomNumberGenerator = _layout_rng(cell, "rock field stones")

	for n in range(loose):
		var angle: float = loose_rng.randf() * TAU   # luck-exempt: seeded world layout
		var out_m: float = lerpf(2.0, 7.0, loose_rng.randf())   # luck-exempt: seeded world layout
		var at: Array = centres[n % centres.size()]
		var x: float = float(at[0]) + cos(angle) * out_m
		var z: float = float(at[1]) + sin(angle) * out_m
		var key: int = FIELD_KEY | cell_bits | (FIELD_LOOSE_FIRST + n)

		if _taken.has(key):
			continue

		var y: float = float(ground.call(x, z))

		if is_nan(y) or y < 1.0 or not (_ground_fall(ground, x, z, SCATTER_SLOPE_M) < 1.0) or (depth_at.is_valid() and float(depth_at.call(Vector3(x, y, z))) > 0.05) or NpcCamp.within_keep(Vector3(x, y, z)):
			continue   # not on a face steeper than a player stands on (as _scatter_spot), nor in water or a camp

		if not bool(looked[0]):
			looked[0] = true
			_rock_field_neighbours(mid, h0, cell_m, cfg, built, taken, pieces)

		if not _rock_field_clear(x, z, 0.05, float(cfg.get("keep_clear_m", 4.0)), built, taken):
			continue   # nor on or beside anything built, nor inside a rock

		_items[_next_id] = {"number": stone, "count": 1, "pos": Vector3(x, y, z), "left": 1.0e9, "scatter": key}
		_next_id += 1


# What lies near a rocky-ground cell, looked up once for it: into `built` the positions of structures, fires and the players standing there now
# (nothing is laid on or beside a camp, a station, a fire or a player); into `taken` the cell's own boulders as [x, z, radius], read from the ids
# this cell was given (a rock across the border in the next cell is not looked at: which cell is laid first changes with where players walk).
func _rock_field_neighbours(mid: Vector2, h0: float, cell_m: float, cfg: Dictionary, built: Array, taken: Array, pieces: Array) -> void:
	var reach: float = cell_m * 0.75 + float(cfg.get("keep_clear_m", 4.0)) + 3.0 + FIELD_SATELLITE_REACH_M   # a satellite lies up to that far past its cell
	var talus_reach: float = cell_m * 0.75 + FIELD_SATELLITE_REACH_M + FLOOR_ROWS_REACH_M * FOOT_SKIRT_REACH + 1.0   # and its talus that far past it

	for id in _ids_near(Vector3(mid.x, h0, mid.y), talus_reach):   # the last world sync's grid (every second, after the scatter), so a few cells' ids
		var it: Dictionary = _items.get(id, {})

		if not (it.has("struct") or it.has("fire")):
			continue

		if (it.has("fire") or not (it["struct"].has("transient") or _follows_ground(str(it["struct"].get("kind", ""))))):
			pieces.append(it["pos"])

		if Vector2(float(it["pos"].x) - mid.x, float(it["pos"].z) - mid.y).length() <= reach:
			built.append(it["pos"])

	for peer in _peer_pos:
		if Vector2(_peer_pos[peer].x - mid.x, _peer_pos[peer].z - mid.y).length() <= reach and absf(_peer_pos[peer].y - h0) < reach:   # not one down a mine below
			built.append(_peer_pos[peer])

	for id in range(_cell_first_id, _next_id):
		var it: Dictionary = _items.get(id, {})

		if it.has("boulder") and (int(it.get("scatter", 0)) & CAVE_KEY) == 0 and absf(float(it["pos"].x) - mid.x) < cell_m * 0.5 and absf(float(it["pos"].z) - mid.y) < cell_m * 0.5:
			taken.append([float(it["pos"].x), float(it["pos"].z), float((it["boulder"] as Dictionary).get("radius", 0.5))])


# A big rock's talus (client-drawn chunks with collision, inventory_view _skirt_mesh) reaches this many of its radii: 14 chunks out to 2.6 radii of up
# to 0.7, a foot field's 36 out to 4.5 of up to 0.95.
const SKIRT_REACH := 3.3
const FOOT_SKIRT_REACH := 5.5


# Whether nothing built (a placed piece, a blueprint site, a fire: `pieces`, _rock_field_neighbours) stands within `reach` of a talus's rock at
# `at`: a talus is not laid under a building.
func _skirt_clear(at: Vector3, reach: float, pieces: Array) -> bool:
	for piece in pieces:
		if Vector2((piece as Vector3).x - at.x, (piece as Vector3).z - at.z).length() < reach + 1.0:
			return false

	return true


# A piece built at `at` (its footprint `half` across from its middle): the talus of every rock that reaches under it is taken off, look and
# collision, so nobody stands in rock chunks inside a building (the step 1 shortcut, boulders PLAN_big_boulders.md). Laid again, that talus is not
# laid (_skirt_clear). The rocks themselves stay.
func _bare_skirts_near(at: Vector3, half: float) -> void:
	for id in _ids_near(at, half + FLOOR_ROWS_REACH_M * FOOT_SKIRT_REACH):
		var it: Dictionary = _items.get(id, {})

		if not it.has("boulder") or ((it["boulder"] as Dictionary).get("skirt", []) as Array).size() < 3:
			continue

		var info: Dictionary = it["boulder"]
		var reach: float = float(info["radius"]) * (FOOT_SKIRT_REACH if (info["skirt"] as Array).size() >= 4 else SKIRT_REACH)

		if Vector2(float(it["pos"].x) - at.x, float(it["pos"].z) - at.z).length() < reach + half:
			info.erase("skirt")
			info["bare"] = 1
			_dirty = true


# Whether a rock of `radius` at (x, z) keeps `keep_m` from everything built and does not overlap a rock in `taken`.
func _rock_field_clear(x: float, z: float, radius: float, keep_m: float, built: Array, taken: Array) -> bool:
	for at in built:
		if Vector2((at as Vector3).x - x, (at as Vector3).z - z).length() < radius + keep_m:
			return false

	for rock in taken:
		if Vector2(float(rock[0]) - x, float(rock[1]) - z).length() < radius + float(rock[2]):
			return false

	return true


# How steep the ground is at (x, z): rise per metre across `half` metres each way (NAN where the ground is unknown).
func _ground_fall(ground: Callable, x: float, z: float, half: float) -> float:
	var fall_x: float = float(ground.call(x + half, z)) - float(ground.call(x - half, z))
	var fall_z: float = float(ground.call(x, z + half)) - float(ground.call(x, z - half))
	return Vector2(fall_x, fall_z).length() / (2.0 * half)


# A seeded patch value 0..1 at `at` (smooth value noise on a grid `patch_m` across, from the world seed): where rocky ground comes thick.
func _rock_patch(at: Vector2, patch_m: float) -> float:
	var g: Vector2 = at / maxf(patch_m, 1.0)
	var i: Vector2i = Vector2i(int(floor(g.x)), int(floor(g.y)))
	var f: Vector2 = g - Vector2(i)
	var u: Vector2 = f * f * (Vector2(3.0, 3.0) - 2.0 * f)
	var corner: Callable = func(cx: int, cz: int) -> float: return float(hash([cx, cz, world_seed, "rock patch"]) % 10000) / 9999.0
	return lerpf(lerpf(corner.call(i.x, i.y), corner.call(i.x + 1, i.y), u.x), lerpf(corner.call(i.x, i.y + 1), corner.call(i.x + 1, i.y + 1), u.x), u.y)


# How broken and angular a rock looks, 0 (water-worn, round) to 1 (fresh, jagged; boulders.json distribution shape_*): the journey with a
# little of its own jitter from the key, so the change from shore to headwaters is gradual and never uniform; a rock in or by water is
# worn (shape_worn). Sent in the row ("ang"); the client picks its mesh by it (inventory_view.gd, ore_rock_look.gd).
func _rock_shape(journey: float, worn: bool, key: int) -> float:
	var cfg: Dictionary = _boulder_cfg.get("distribution", {})
	var jitter: float = float(cfg.get("shape_jitter", 0.15)) * (float(hash([key, "shape"]) % 1000) / 999.0 * 2.0 - 1.0)
	var shape: float = clampf(journey + jitter, 0.0, 1.0)
	return snappedf(shape * float(cfg.get("shape_worn", 0.45)) if worn else shape, 0.01)


# The rocks of the metal sources (resource_context.gd deposits) whose layout reaches this cell (boulders.json distribution source_*;
# handoff 10 and 11): at the source, angular outcrop boulders of its ore inside its radius (more and bigger for a bigger source, its grade
# high); below it, broken fragments strewn down the slope (the way downhill from the landscape), smaller the farther they lie, the small
# ones loose ore to pick up by hand. Every rock of a source is placed from the source's own id, so a rock lies in the same place whichever
# cell lays it out, and each is laid only by the cell that holds it. Keys: slots SOURCE_SLOT_FIRST.. of the cell, in the order of the
# sources (stable) and their rocks.
func _lay_out_sources(cell: Vector2i, cell_m: float, reads: Dictionary) -> void:
	var cfg: Dictionary = _boulder_cfg.get("distribution", {})

	if resource_context == null or cfg.is_empty():
		return

	var ground: Callable = reads["ground"]
	var depth_at: Callable = reads["water_depth_at"]
	var lo: Vector2 = Vector2(cell) * cell_m
	var mid: Vector2 = lo + Vector2(cell_m, cell_m) * 0.5
	var frag_max: float = float(cfg.get("source_fragment_reach_max_m", 120.0))
	var reach: float = maxf(float(cfg.get("deposit_radius_max_m", 30.0)), frag_max * 1.07) + cell_m * 0.71   # a fragment lies up to 1.06 x its reach off (0.35 across)
	var cell_bits: int = ((cell.x & 0xfffff) << 28) | ((cell.y & 0xfffff) << 8)
	var slot: int = SOURCE_SLOT_FIRST
	var bed_m: float = float((_ore_rock_cfg("copper") as Dictionary).get("bed_depth_m", 0.8))
	var deposits: Array = resource_context.get("deposits")

	for n in resource_context.call("deposits_near", mid.x, mid.y, reach):
		var d: Dictionary = deposits[n]
		var ore: String = str(d["metal"])
		var item: String = str((_boulder_cfg.get("ore", {}).get("items", {}) as Dictionary).get(ore, ""))
		var size: float = float(d["size"])
		var id: int = int(d["id"])
		var centre: Vector2 = Vector2(float(d["x"]), float(d["z"]))
		var down: Vector2 = resource_context.call("downhill_at", centre.x, centre.y)

		if down == Vector2.ZERO:
			down = Vector2(1.0, 0.0).rotated(ResourceContextScript.unit(id, 7) * TAU)

		var outcrops: int = int(round(lerpf(float(cfg.get("source_outcrops_min", 2)), float(cfg.get("source_outcrops_max", 8)), size)))
		var fragments: int = int(round(lerpf(float(cfg.get("source_fragments_min", 4)), float(cfg.get("source_fragments_max", 14)), size)))
		var frag_reach: float = lerpf(float(cfg.get("source_fragment_reach_min_m", 40.0)), frag_max, size)

		for k in range(outcrops + fragments):
			var outcrop: bool = k < outcrops
			var u1: float = ResourceContextScript.unit(id, k, 1)
			var u2: float = ResourceContextScript.unit(id, k, 2)
			var u3: float = ResourceContextScript.unit(id, k, 3)
			var at: Vector2
			var share: float   # how big the piece is, 0..1 of the biggest at this source

			if outcrop:
				at = centre + Vector2(sqrt(u1) * float(d["radius"]), 0.0).rotated(u2 * TAU)
				share = 1.0
			else:
				var along: float = pow(u1, 0.7) * frag_reach
				at = centre + down * along + down.orthogonal() * (u2 * 2.0 - 1.0) * along * 0.35
				share = 1.0 - along / frag_reach

			if at.x < lo.x or at.y < lo.y or at.x >= lo.x + cell_m or at.y >= lo.y + cell_m:
				continue   # another cell's rock

			var this_slot: int = slot
			slot += 1

			if this_slot > SOURCE_SLOT_LAST:
				break

			var y: float = float(ground.call(at.x, at.y))

			if is_nan(y) or y < 1.0:
				continue

			var spot: Vector3 = Vector3(at.x, y, at.y)

			if depth_at.is_valid() and float(depth_at.call(spot)) > bed_m:
				continue

			var yaw: float = u3 * 360.0
			var hand: bool = not outcrop and u3 * share < float(cfg.get("source_hand_share", 0.35))

			if hand:
				var loose_key: int = ORE_KEY | cell_bits | this_slot

				if not _taken.has(loose_key) and item != "":
					_items[_next_id] = {"number": table.number_of(item), "count": 1, "pos": spot, "left": 1.0e9, "scatter": loose_key}
					_next_id += 1

				continue

			var key: int = ORE_KEY | BOULDER_KEY | cell_bits | this_slot
			var radius: float

			if outcrop:
				radius = lerpf(float(cfg.get("source_outcrop_radius_min", 0.5)), float(cfg.get("source_outcrop_radius_max", 1.4)), size) * lerpf(0.7, 1.0, u3)
			else:
				radius = lerpf(float(cfg.get("source_fragment_radius_min", 0.25)), float(cfg.get("source_fragment_radius_max", 0.6)), share * u3)

			var row: Dictionary = {"radius": radius, "yaw": yaw, "ang": _rock_shape(1.0 if outcrop else 0.7, false, key), "source": id}
			_set_boulder_ore(row, ore, key)
			row["radius"] = radius   # a source's rock keeps its own size (not the ore rocks' 0.5 to 2 m clamp)
			var grades: Array = cfg.get("source_grade", [0.4, 0.8])
			row["grade"] = snappedf(lerpf(float(grades[0]), float(grades[1]), size) * (1.0 if outcrop else 0.7), 0.01)
			row["total"] = _boulder_stones(radius, true)
			var left: int = _boulder_left_of(key, row)

			if left <= 0:
				continue

			_items[_next_id] = {"number": 0, "count": left, "pos": _settled(spot), "left": 1.0e9, "scatter": key, "boulder": row}
			_next_id += 1


# The item a rock's ore gives (boulders.json ore items, then ore finds for a pocket's gold, silver and gems), "" when none.
func _ore_item_of(ore: String) -> String:
	var cfg: Dictionary = _boulder_cfg.get("ore", {})
	return str((cfg.get("items", {}) as Dictionary).get(ore, (cfg.get("finds", {}) as Dictionary).get(ore, "")))


# The height of a coal seam's layer: the generated ground at its centre (ground_height, kept once a run); NAN while unknown (its tile not
# in memory yet: ground_ready asks for it on a worker thread).
func _seam_height(seam: Dictionary) -> float:
	var id: int = int(seam["id"])

	if not _seam_y.has(id):
		if not ground_height.is_valid() or (ground_ready.is_valid() and not bool(ground_ready.call(float(seam["x"]), float(seam["z"])))):
			return NAN   # its tile is not in memory: never read one on the main thread (that seam waits for a later look)

		var y: float = float(ground_height.call(float(seam["x"]), float(seam["z"])))

		if is_nan(y):
			return NAN

		_seam_y[id] = y if _seam_host_ok(Vector3(float(seam["x"]), y, float(seam["z"]))) else NAN   # NAN kept: no seam in this rock, every look

	return float(_seam_y[id])


# Whether the bedrock at a seam's centre can hold coal (handoff: "use sedimentary host rock where the world supports it"; boulders.json
# distribution coal host_families, rocks.json family): the baked tile's layered rock there (rock_near: TileTerrainData.bedrock_name_at).
# Unknown rock (no tile geology, rock_near unset) does not stop a seam.
func _seam_host_ok(spot: Vector3) -> bool:
	var families: Array = ((_boulder_cfg.get("distribution", {}) as Dictionary).get("coal", {}) as Dictionary).get("host_families", [])

	if families.is_empty() or not rock_near.is_valid():
		return true

	if _rock_family.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(ROCKS_PATH))

		for row in (parsed.get("entries", []) if typeof(parsed) == TYPE_DICTIONARY else []):
			_rock_family[str(row.get("name", ""))] = str(row.get("family", ""))

	var rock: String = str(rock_near.call(spot))
	return rock == "" or not _rock_family.has(rock) or _rock_family[rock] == "none" or families.has(_rock_family[rock])


# The coal seam (ResourceContext seams) whose layer holds the point, or {}: within half its length along it, from out_m outside the
# hillside to into_m into it, and within half its thickness of its height.
func _seam_at(spot: Vector3) -> Dictionary:
	var cfg: Dictionary = (_boulder_cfg.get("distribution", {}) as Dictionary).get("coal", {})

	if resource_context == null or cfg.is_empty():
		return {}

	var lengths: Array = cfg.get("length_m", [60.0, 200.0])
	var reach: float = float(lengths[1]) * 0.5 + float(cfg.get("into_m", 80.0))
	var seams: Array = resource_context.get("seams")

	for n in resource_context.call("seams_near", spot.x, spot.z, reach):
		var seam: Dictionary = seams[n]
		var rel: Vector2 = Vector2(spot.x - float(seam["x"]), spot.z - float(seam["z"]))
		var across: float = rel.dot(seam["up"])

		if absf(rel.dot(seam["along"])) > float(seam["length"]) * 0.5 or across < -float(seam["out"]) or across > float(seam["into"]):
			continue

		var y: float = _seam_height(seam)

		if not is_nan(y) and absf(spot.y - y) <= float(seam["thick"]) * 0.5:
			return seam

	return {}


# A shovel dig inside a coal seam's layer also brings up coal (distribution coal per_dig, rolled like a soil row with the shovel tier's
# extra, times the shovel size's pieces), never more than is left: a seam holds its length x coal_per_m (handoff 14: a resource body has a
# bounded recoverable amount; nothing grows back). The first find says first_find once to that character.
func _dig_seam_coal(peer: int, at: Vector3, tier: int, pieces: int) -> void:
	var cfg: Dictionary = (_boulder_cfg.get("distribution", {}) as Dictionary).get("coal", {})
	var number: int = table.number_of("coal")

	if cfg.is_empty() or number <= 0:
		return

	var seam: Dictionary = _seam_at(at - Vector3(0.0, DIG_DEPTH_M, 0.0))

	if seam.is_empty():
		return

	var id: int = int(seam["id"])
	var left: int = int(_seam_left.get(id, int(round(float(seam["length"]) * float(cfg.get("coal_per_m", 2.0))))))

	if left <= 0:
		return

	var per: Array = cfg.get("per_dig", [1, 2])
	var extra: int = int(_dig_cfg.get("tier_extra", {}).get(str(tier), 0))
	var amount: int = mini(maxi(1, int(round(float(roll_amount(peer, _fate_rng, int(per[0]), int(per[1]) + extra)) * skill_factor(peer, "dig")))) * pieces, left)
	give(peer, number, amount)
	_seam_left[id] = left - amount
	_dirty = true
	_say_once(peer, "found_coal_seam", str(cfg.get("first_find", "")))


# Says `line` to the character once ever (kept in its hints_seen like a hint, under `key`).
func _say_once(peer: int, key: String, line: String) -> void:
	var st: Dictionary = _goal_state_of(peer)

	if st.is_empty() or line == "":
		return

	if typeof(st.get("hints_seen", null)) != TYPE_DICTIONARY:
		st["hints_seen"] = {}

	if not st["hints_seen"].has(key):
		st["hints_seen"][key] = Time.get_unix_time_from_system()
		_say(peer, line)


# Coal seam outcrops (distribution coal): along each seam near the cell, every outcrop_every_m, the point up or down the slope (within
# outcrop_search_m) where the ground meets the layer's height; there a dark coal outcrop boulder (ore coal) and loose_below loose coal a
# few metres downhill. Only the points inside this cell are laid here. Keys: slots SEAM_SLOT_FIRST.. of the cell, in order of the seams
# and their points; the loose coal under ORE_KEY, the outcrops under ORE_KEY | BOULDER_KEY, like a source's rocks.
func _lay_out_seams(cell: Vector2i, cell_m: float, reads: Dictionary) -> void:
	var cfg: Dictionary = (_boulder_cfg.get("distribution", {}) as Dictionary).get("coal", {})

	if resource_context == null or cfg.is_empty():
		return

	var ground: Callable = reads["ground"]
	var lo: Vector2 = Vector2(cell) * cell_m
	var hi: Vector2 = lo + Vector2(cell_m, cell_m)
	var search: float = minf(float(cfg.get("outcrop_search_m", 13.0)), (SCATTER_PAD_M - 4.0) * 0.5)   # a station is read up to search outside the cell, plus search along the slope: within the pad
	var every: float = maxf(float(cfg.get("outcrop_every_m", 14.0)), 2.0)
	var lengths: Array = cfg.get("length_m", [60.0, 200.0])
	var radii: Array = cfg.get("outcrop_radius_m", [0.5, 1.0])
	var loose: Array = cfg.get("loose_below", [0, 2])
	var cell_bits: int = ((cell.x & 0xfffff) << 28) | ((cell.y & 0xfffff) << 8)
	var slot: int = SEAM_SLOT_FIRST
	var coal: int = table.number_of("coal")
	var seams: Array = resource_context.get("seams")

	for n in resource_context.call("seams_near", (lo.x + hi.x) * 0.5, (lo.y + hi.y) * 0.5, float(lengths[1]) * 0.5 + search + cell_m):
		var seam: Dictionary = seams[n]
		var along: Vector2 = seam["along"]
		var up: Vector2 = seam["up"]
		var centre: Vector2 = Vector2(float(seam["x"]), float(seam["z"]))
		var stations: int = int(floor(float(seam["length"]) / every))

		for k in range(stations + 1):
			var p0: Vector2 = centre + along * (float(k) * every - float(seam["length"]) * 0.5)

			if p0.x < lo.x - search or p0.y < lo.y - search or p0.x >= hi.x + search or p0.y >= hi.y + search:
				continue   # its outcrop cannot fall in this cell (the reads stay within the cell's loaded ground: 2 x search <= SCATTER_PAD_M - 4)

			var y: float = _seam_height(seam)
			var a: float = -search
			var b: float = search
			var fa: float = float(ground.call(p0.x + up.x * a, p0.y + up.y * a)) - y
			var fb: float = float(ground.call(p0.x + up.x * b, p0.y + up.y * b)) - y

			if is_nan(fa) or is_nan(fb) or fa > 0.0 or fb < 0.0:
				continue   # the ground does not cross the layer here (a gully, a spur): no outcrop at this point

			for _step in 6:
				var m: float = (a + b) * 0.5
				var fm: float = float(ground.call(p0.x + up.x * m, p0.y + up.y * m)) - y

				if is_nan(fm):
					break

				if fm < 0.0:
					a = m
				else:
					b = m

			var at: Vector2 = p0 + up * ((a + b) * 0.5)

			if at.x < lo.x or at.y < lo.y or at.x >= hi.x or at.y >= hi.y:
				continue   # another cell's outcrop

			var u: float = ResourceContextScript.unit(int(seam["id"]), k, 11)
			var key: int = ORE_KEY | BOULDER_KEY | cell_bits | slot
			var below: int = int(loose[0]) + int(floor(ResourceContextScript.unit(int(seam["id"]), k, 12) * float(int(loose[1]) - int(loose[0]) + 1)))
			slot += 1 + below

			if slot - 1 > SEAM_SLOT_LAST:
				return

			var spot: Vector3 = Vector3(at.x, float(ground.call(at.x, at.y)), at.y)
			var row: Dictionary = {"radius": lerpf(float(radii[0]), float(radii[1]), u), "yaw": u * 360.0, "ang": 0.9, "seam": int(seam["id"])}
			_set_boulder_ore(row, "coal", key)
			row["grade"] = float(cfg.get("outcrop_grade", 0.5))
			var left: int = _boulder_left_of(key, row)

			if left > 0 and not is_nan(spot.y):
				_items[_next_id] = {"number": 0, "count": left, "pos": _settled(spot), "left": 1.0e9, "scatter": key, "boulder": row}
				_next_id += 1

			for q in below:
				var loose_key: int = ORE_KEY | cell_bits | ((key & 0xff) + 1 + q)
				var drop: Vector2 = at - up * lerpf(2.0, 6.0, ResourceContextScript.unit(int(seam["id"]), k, 13 + q)) + along * (ResourceContextScript.unit(int(seam["id"]), k, 20 + q) - 0.5) * 3.0
				var dy: float = float(ground.call(drop.x, drop.y))

				if drop.x < lo.x or drop.y < lo.y or drop.x >= hi.x or drop.y >= hi.y:
					continue   # it would roll into the next cell under this cell's key: left out

				if coal > 0 and not _taken.has(loose_key) and not is_nan(dy) and dy >= 1.0:
					_items[_next_id] = {"number": coal, "count": 1, "pos": Vector3(drop.x, dy, drop.y), "left": 1.0e9, "scatter": loose_key}
					_next_id += 1


# The coal left in dug seams, for the save: {id as text: coal}.
func _seams_saved() -> Dictionary:
	var out: Dictionary = {}

	for id in _seam_left:
		out[str(id)] = int(_seam_left[id])

	return out


# The opened pockets, for the save: {id as text: [x, y, z]}.
func _pockets_saved() -> Dictionary:
	var out: Dictionary = {}

	for id in _pockets_open:
		out[str(id)] = _pockets_open[id]

	return out


# A dig opens the pockets (ResourceContext pockets) it reaches: within the pocket's r_m across and its depth under the generated ground
# (less 0.3 m: the hole's own size). An opened pocket's rock lies in the hole from then on (saved), laid now if its cell is out.
func _open_pockets(peer: int, at: Vector3, radius: float) -> void:
	if resource_context == null or not ground_height.is_valid():
		return

	var rows: Array = resource_context.get("pockets")
	var bottom: float = at.y - DIG_DEPTH_M - radius

	for n in resource_context.call("pockets_near", at.x, at.z, 3.0):
		var p: Dictionary = rows[n]
		var id: int = int(p["id"])

		if _pockets_open.has(id) or Vector2(at.x - float(p["x"]), at.z - float(p["z"])).length() > float(p["r"]):
			continue

		var surface: float = float(ground_height.call(float(p["x"]), float(p["z"])))

		if is_nan(surface) or surface - bottom < float(p["depth"]) - 0.3:
			continue

		var spot: Vector3 = _settled(at)
		_pockets_open[id] = [spot.x, spot.y, spot.z]
		_dirty = true
		var cfg: Dictionary = (_boulder_cfg.get("distribution", {}) as Dictionary).get("pocket_rock", {})
		var item: int = table.number_of(_ore_item_of(str(p["find"])))

		if item > 0:
			_say(peer, str(cfg.get("say", "You dig into a pocket of %s.")) % table.name_of(item))

		var cell_m: float = float(_drops.get("ground_scatter", {}).get("cell_m", 32.0))
		var cell: Vector2i = Vector2i(int(floor(spot.x / cell_m)), int(floor(spot.z / cell_m)))

		if _cells_done.has(cell):
			var rock_id: int = _next_id
			_place_pocket(id, p)

			if _next_id > rock_id and _scatter_cells.has(cell):
				(_scatter_cells[cell] as Array).append(rock_id)   # taken away with its cell


# The opened pockets whose rock lies in this cell.
func _lay_out_pockets(cell: Vector2i, cell_m: float) -> void:
	if resource_context == null:
		return

	for id in _pockets_open:
		var spot: Array = _pockets_open[id]

		if int(floor(float(spot[0]) / cell_m)) == cell.x and int(floor(float(spot[2]) / cell_m)) == cell.y:
			var p: Dictionary = resource_context.call("pocket", int(id))

			if not p.is_empty():
				_place_pocket(int(id), p)


# A pocket's rock (distribution pocket_rock): small, its stones and the grade of its find; what is left of it keeps under its key.
func _place_pocket(id: int, p: Dictionary) -> void:
	var cfg: Dictionary = (_boulder_cfg.get("distribution", {}) as Dictionary).get("pocket_rock", {})
	var radii: Array = cfg.get("radius_m", [0.3, 0.45])
	var stones: Array = cfg.get("stones", [6, 12])
	var key: int = POCKET_KEY | id
	var u: float = ResourceContextScript.unit(id, 1)
	var row: Dictionary = {"radius": lerpf(float(radii[0]), float(radii[1]), u), "yaw": u * 360.0, "ang": 0.8, "ore": str(p["find"]),
		"grade": float((cfg.get("grade", {}) as Dictionary).get(str(p["find"]), 0.3)), "pocket": id}
	row["total"] = int(round(lerpf(float(stones[0]), float(stones[1]), ResourceContextScript.unit(id, 2))))
	if _boulder_pending.has(key):   # saved at other stone rates: a pocket rock's total is a fixed count, not a rate, so it is kept as saved
		_boulder_left[key] = int(_boulder_pending[key][0])
		_boulder_pending.erase(key)

	var left: int = mini(int(_boulder_left.get(key, row["total"])), int(row["total"]))

	if left <= 0:
		return

	var spot: Array = _pockets_open[id]
	_items[_next_id] = {"number": 0, "count": left, "pos": Vector3(float(spot[0]), float(spot[1]), float(spot[2])), "left": 1.0e9, "scatter": key, "boulder": row}
	_next_id += 1


# An ore's rock rule: boulders.json ore_rocks (shared by copper and tin, Dave 21 Nov 2026) under the ore's own <ore>_rocks (its slot and
# grade, and any value it sets itself); {} for an ore without its own block (coal, salt: outcrops only).
func _ore_rock_cfg(ore: String) -> Dictionary:
	var own: Dictionary = _boulder_cfg.get(ore + "_rocks", {})

	if own.is_empty():
		return {}

	var cfg: Dictionary = (_boulder_cfg.get("ore_rocks", {}) as Dictionary).duplicate()
	cfg.merge(own, true)
	return cfg


# How far the ground climbs above the spot within reach (at most SCATTER_PAD_M - 4, inside the tiles _cell_ground_ready loaded: a
# farther read loads a tile on the main thread), the highest of the four directions; 0 on flat or falling ground.
func _relief(spot: Vector3, reach_m: float, ground: Callable) -> float:
	var reach: float = minf(reach_m, SCATTER_PAD_M - 4.0)
	var best: float = 0.0

	for d in [Vector2(reach, 0.0), Vector2(-reach, 0.0), Vector2(0.0, reach), Vector2(0.0, -reach)]:
		var h: float = float(ground.call(spot.x + d.x, spot.z + d.y))

		if not is_nan(h):
			best = maxf(best, h - spot.y)

	return best


# The foot of a mountain: the spot itself is gentle (rise per metre under max_slope over 3 m) and the ground climbs more than rise_m
# within reach_m (_relief) in one of the four directions (boulders.json copper_rocks foot).
func _at_mountain_foot(spot: Vector3, foot: Dictionary, ground: Callable) -> bool:
	var near: float = (absf(float(ground.call(spot.x + 3.0, spot.z)) - spot.y) + absf(float(ground.call(spot.x, spot.z + 3.0)) - spot.y)) / 3.0

	if is_nan(near) or near > float(foot.get("max_slope", 0.3)):
		return false

	return _relief(spot, float(foot.get("reach_m", 24.0)), ground) > float(foot.get("rise_m", 20.0))


# The ore a boulder is an outcrop of ("" for a plain boulder): the terrain's ore body within reach of it, for a share of the boulders chosen from the key.
func _boulder_ore(spot: Vector3, key: int, body_at: Callable) -> String:
	var cfg: Dictionary = _boulder_cfg.get("ore", {})

	if cfg.is_empty():
		return ""

	if body_at.is_valid() and float(hash(key) % 1000) < 1000.0 * float(cfg.get("boulder_share", 0.0)):
		var name: String = str(body_at.call(spot, float(cfg.get("reach_m", 40.0)), cfg.get("items", {}), float(cfg.get("layer_depth_m", 10.0))))

		# A geology body of a metal outside that metal's area shows no outcrop (the island landscape keeps copper and tin inland).
		if resource_context != null and ORE_METALS.has(name) and float(resource_context.call("field_at", int(ORE_METALS[name]), spot.x, spot.z)) < 0.5:
			name = ""

		if (cfg.get("items", {}) as Dictionary).has(name):
			return name

	# Else the boulder's own rock (Dave 10 Nov 2026, Concrete = Lime powder + Sand + Stone): over limestone, chalk or marble bedrock a share of the
	# boulders give limestone pieces (boulders.json ore "rocks": rock name -> item, rock_boulder_share, rock_piece_share).
	var rocks: Dictionary = cfg.get("rocks", {})

	if rocks.is_empty() or not rock_near.is_valid() or float(hash([key, "rock"]) % 1000) >= 1000.0 * float(cfg.get("rock_boulder_share", 0.0)):
		return ""

	var rock: String = str(rock_near.call(spot))
	return rock if rocks.has(rock) else ""


# The tool in hand for a boulder blow (TEST-013, Dave 12 Nov 2026: the stone axe and stone pick were the same because the best tool on the
# hotbar did the work, whatever was held): [slot, stones per blow] from boulders.json tools by its class and material, [] when the held slot
# is not a usable boulder tool on the hotbar.
func _boulder_tool(inv, slot: int) -> Array:
	if slot < 0 or slot >= inv.slot_count or not inv.on_hotbar(slot) or _is_broken(inv, slot) or _hands_full(inv):
		return []

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var rate: float = float((_boulder_cfg.get("tools", {}) as Dictionary).get(str(entry.get("tool_class", "")), {}).get(str(entry.get("material", "")), 0.0))
	return [slot, rate] if rate > 0.0 else []


# One blow on a boulder (ACT_HIT with the boulder marker; `held_slot` is the pack slot in hand). The held tool wears once a blow (drops.json
# tool_wear "rock": an axe 5, a pick 1) and takes its stones per blow (boulders.json tools: a better pick more, an axe half; a fraction carries
# over in the boulder's "progress") into the pack, and what does not fit into one pile behind the miner (_boulder_drop_spot). The boulder shrinks and is gone with
# its last stone. Its stones are fixed by its size, so a better tool empties it in fewer blows and wears less doing it (TEST-013).
func _hit_boulder(peer: int, inv, id: int, held_slot: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("boulder") or not _peer_pos.has(peer):
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_hit.get(peer, -100000)) < HIT_COOLDOWN_MS:
		return

	var tool: Array = _boulder_tool(inv, held_slot)

	if tool.is_empty():
		_say_hands_full(peer, inv)
		_reject(peer, 1)
		return

	var info: Dictionary = it["boulder"]
	var size_now: float = BoulderWear.radius_now(float(info["radius"]), int(it["count"]), int(info["total"]))
	var flat: Vector2 = Vector2(_peer_pos[peer].x - it["pos"].x, _peer_pos[peer].z - it["pos"].z)

	if flat.length() > HIT_REACH_M + size_now:
		_reject_far(peer)
		return

	var rate: float = float(tool[1])
	var progress: float = float(info.get("progress", 0.0)) + rate
	var pieces: int = mini(int(floor(progress + 0.001)), int(it["count"]))
	var stone: int = table.number_of("stone")

	# Dave 19 Nov 2026 (boulders PLAN.md 5): never refused for weight. What fits goes in the pack; the rest drops behind the miner, away from
	# the rock, at one spot kept for this miner and this rock so the job makes one pile (_overflow_spot: "just drop it right behind them").
	var held: Dictionary = table.entry(table.id_of(inv.numbers[int(tool[0])]))   # read before the wear: a stone tool that breaks on this blow leaves its slot empty

	# A river iron stone (boulders.json iron_rocks sizes, Dave 21 Nov 2026: "if there are any larger than that they need to be broken down like a
	# normal rock with a pick bronze or better"): all ore, so a tool that cannot take its ore does not grind it to stone; it is refused, unworn.
	if bool(info.get("ore_only", false)):
		var oc: Dictionary = _boulder_cfg.get("ore", {})
		var cls: String = str(held.get("tool_class", ""))
		var mats: Array = (oc.get("needs_material", {}) as Dictionary).get(str(info.get("ore", "")), [])

		if ((oc.get("pick_only", []) as Array).has(str(info.get("ore", ""))) and cls != "pick") or not (oc.get("tool_classes", [oc.get("tool_class", "pick")]) as Array).has(cls) or (not mats.is_empty() and not mats.has(str(held.get("material", "")))):
			_say(peer, "%s needs a bronze or better pick." % table.name_of(table.number_of(str((oc.get("items", {}) as Dictionary).get(str(info.get("ore", "")), "")))))
			return

	_last_hit[peer] = now
	_wear_slot(peer, inv, int(tool[0]), "rock")
	hit_number(peer, it["pos"] + Vector3(0.0, size_now, 0.0), HIT_POINTS * minf(rate, 1.0))
	info["progress"] = progress - float(pieces)

	if pieces == 0:
		return

	var ore_cfg: Dictionary = _boulder_cfg.get("ore", {})
	# tool_classes (boulders.json ore): a pick or, since the Stone Pickaxe retired (TREE_WOOD_TOOLS_DESIGN.md W-12), a hammer takes ore; pick_only ores (iron) want a pick.
	var held_class: String = str(held.get("tool_class", ""))
	var pick_only: bool = info.has("ore") and (ore_cfg.get("pick_only", []) as Array).has(str(info["ore"])) and held_class != "pick"
	var a_pick: bool = (ore_cfg.get("tool_classes", [ore_cfg.get("tool_class", "pick")]) as Array).has(held_class) and not pick_only
	# needs_material (boulders.json ore): the tool materials that may take each ore; no entry = any (iron ore needs a bronze, iron or steel pick: the ladder).
	var material_ok: bool = not info.has("ore") or ((ore_cfg.get("needs_material", {}) as Dictionary).get(str(info["ore"]), []) as Array).is_empty() or ((ore_cfg.get("needs_material", {}) as Dictionary).get(str(info["ore"]), []) as Array).has(str(held.get("material", "")))

	if info.has("ore") and not ore_cfg.is_empty() and pick_only and held_class == "hammer":
		_say(peer, "Iron ore needs a bronze or better pick.")
	elif info.has("ore") and not ore_cfg.is_empty() and a_pick and not material_ok:
		_say(peer, "This pick is too soft for that ore.")   # said once per blow that breaks stone off

	var flint_cfg: Dictionary = _boulder_cfg.get("flint", {})
	var flint_n: int = table.number_of(str(flint_cfg.get("item", "flint"))) if not flint_cfg.is_empty() else 0
	var flint_p: float = float(flint_cfg.get("chance", 0.0))

	if flint_n > 0 and water_near.is_valid() and bool(water_near.call(it["pos"], float(flint_cfg.get("water_reach_m", 6.0)))):
		flint_p = float(flint_cfg.get("near_water_chance", flint_p))

	var taken: int = 0
	var stone_kg: float = maxf(CarryRules.weight_of("stone", _carry_cfg) if not _carry_cfg.is_empty() else 1.0, 0.05)

	for n in range(pieces):
		var left: int = int(it["count"]) - taken

		if left <= 0:
			break

		var out: int = 1

		# Luck (TD condition): a rough stone now and then comes away as two (boulders.json luck_extra, nudged by the peer's luck).
		if left > 1 and fate(peer, "boulder_extra", float(_boulder_cfg.get("luck_extra", 0.05))):
			out = 2

		# Ore (F-23): a pick on an outcrop takes ore out of it now and then, else stone.
		var ore_item: int = 0

		if info.has("ore") and not ore_cfg.is_empty() and a_pick and material_ok:
			var rock_piece: bool = (ore_cfg.get("rocks", {}) as Dictionary).has(str(info["ore"])) and _ore_item_of(str(info["ore"])) == ""
			var share: float = float(ore_cfg.get("rock_piece_share", 0.5)) if rock_piece else float(info.get("grade", ore_cfg.get("piece_share", 0.5)))   # a copper rock's own grade
			var piece_id: String = str((ore_cfg.get("rocks", {}) as Dictionary).get(str(info["ore"]), "")) if rock_piece else _ore_item_of(str(info["ore"]))
			# Ore by weight (boulders PLAN.md 3c, answered for Dave 19 Nov 2026, PROVISIONAL): the share is of the rock's weight, and an ore piece
			# takes its own weight out of the rock in stones (a 1.5 kg ore piece is 3 stones of 0.5 kg), so a 30% copper rock gives about 30% of its
			# kg as ore, not 35 times more pieces than before the 0.5 kg stones. A piece costs c stones (its weight in stones, at least 1), and the
			# chance p per piece meets p c / (p c + 1 - p) = share, the share of the rock taken out as ore; at c = 1 (salt, coal) p is the share.
			var ore_cost: int = _ore_cost(piece_id, stone_kg)
			var chance: float = clampf(share, 0.0, 1.0) / maxf(float(ore_cost) * (1.0 - clampf(share, 0.0, 1.0)) + clampf(share, 0.0, 1.0), 0.0001)

			if left >= ore_cost and fate(peer, "boulder_ore", chance):
				ore_item = table.number_of(piece_id)

				if ore_item > 0 and not rock_piece:
					_goal_event_act(peer, "ore_mined")   # ADD-26: once per blow, however many pieces; a pick took ore from an outcrop (the piece goes into the pack just below); limestone is a rock piece, not ore

		# Flint (F-02): now and then the piece that comes away is a flint nodule (more near water). A nodule or an ore is one piece, never a double.
		if ore_item > 0:
			_take_in(peer, inv, ore_item, 1, 0, _overflow_spot(peer, inv, ore_item, 1, it, size_now, 1.5))   # ore and flint make their own piles beside the stone one
			out = _ore_cost(table.id_of(ore_item), stone_kg)   # the rock gives up the ore's own weight in stones
		elif flint_n > 0 and flint_p > 0.0 and fate(peer, "boulder_flint", flint_p):
			_take_in(peer, inv, flint_n, 1, 0, _overflow_spot(peer, inv, flint_n, 1, it, size_now, -1.5))
			out = 1
		else:
			_take_in(peer, inv, stone, out, 0, _overflow_spot(peer, inv, stone, out, it, size_now, 0.0))   # past the carry limit the stones lie in the pile behind the miner

		taken += out

	practice(peer, "mine_rock")   # breaking a boulder is Mining too
	it["count"] = maxi(int(it["count"]) - taken, 0)
	_boulder_left[it["scatter"]] = int(it["count"])
	_dirty = true

	if int(it["count"]) <= 0:
		_boulder_drops.erase([peer, it["scatter"]])
		_items.erase(id)

	if taken > 0:
		_resettle_on(it["pos"], size_now)   # a stack on the rock comes down as it shrinks or goes


# How many stones of rock one ore piece `id` takes out of a boulder: its own weight in stones of `stone_kg`, at least one (ore by weight, PLAN.md 3c).
func _ore_cost(id: String, stone_kg: float) -> int:
	if id == "" or _carry_cfg.is_empty():
		return 1

	return maxi(int(round(CarryRules.weight_of(id, _carry_cfg) / stone_kg)), 1)


# Where a miner's stones land when the pack is full (boulders PLAN.md 5): 1 m behind the miner on the line from the rock, fixed the first
# time for this miner and this rock (not kept in the save), so walking round the rock does not start a new pile at every blow.
func _boulder_drop_spot(peer: int, it: Dictionary, size_now: float) -> Vector3:
	var key: Array = [peer, it["scatter"]]

	if _boulder_drops.has(key):
		return _boulder_drops[key]

	var flat: Vector2 = Vector2(_peer_pos[peer].x - it["pos"].x, _peer_pos[peer].z - it["pos"].z)
	var away: Vector2 = flat.normalized() if flat.length() > 0.01 else Vector2(1.0, 0.0)
	var reach: float = maxf(flat.length(), size_now) + 1.0
	var spot: Vector3 = Vector3(it["pos"].x + away.x * reach, _peer_pos[peer].y, it["pos"].z + away.y * reach)
	_boulder_drops[key] = spot
	_say(peer, "Too heavy to carry: what you break off piles up behind you.")   # once per miner and rock: the pile was silent (lane A robot run 25 Nov 2026)
	return spot


# Where `count` of `number` that do not fit in the pack land (_boulder_drop_spot, `side` metres across for ore and flint), or INF (the feet,
# unused) when they all fit, so no spot is kept for a miner whose pack never overflows.
func _overflow_spot(peer: int, inv, number: int, count: int, it: Dictionary, size_now: float, side: float) -> Vector3:
	if _fit(peer, inv, number, count) >= count:
		return Vector3.INF

	var spot: Vector3 = _boulder_drop_spot(peer, it, size_now)
	return _beside(spot, it["pos"], side) if side != 0.0 else spot


# `spot` moved `side` metres across the line from `from` (to the miner's right for a positive side).
func _beside(spot: Vector3, from: Vector3, side: float) -> Vector3:
	var along: Vector2 = Vector2(spot.x - from.x, spot.z - from.z)
	along = along.normalized() if along.length() > 0.01 else Vector2(1.0, 0.0)
	return Vector3(spot.x - along.y * side, spot.y, spot.z + along.x * side)


# Caves are riddled with rocks and stones (Dave 4 Nov 2026): the loose stones and boulders the baked caves under this cell hold
# (tile_terrain_data.cave_scatter_in), a share of the stones flint as on the banks. Keys of their own (CAVE_KEY), so a stone taken stays taken.
func _lay_out_cave_items(cell: Vector2i, cell_m: float, cfg: Dictionary) -> void:
	if not cave_scatter.is_valid():
		return

	var spots: PackedFloat32Array = cave_scatter.call(cell, cell_m)
	var flint: float = float(cfg.get("bank", {}).get("flint", 0.0))

	@warning_ignore("integer_division")
	for n in range(mini(spots.size() / 5, CAVE_ITEMS_MAX)):
		var key: int = CAVE_KEY | ((cell.x & 0xfffff) << 28) | ((cell.y & 0xfffff) << 8) | n

		if _taken.has(key):
			continue

		var spot: Vector3 = Vector3(spots[n * 5], spots[n * 5 + 1], spots[n * 5 + 2])

		if int(spots[n * 5 + 3]) == 1 and not _boulder_cfg.is_empty():
			var radius: float = spots[n * 5 + 4]
			var cave_row: Dictionary = {"radius": radius, "yaw": float(hash(key) % 360)}
			_set_boulder_ore(cave_row, _boulder_ore(spot, key, ore_near), key)   # a cave boulder is an outcrop like one on the surface (Kathleen 10 Nov 2026: caves never rolled ore); sets its total
			var left: int = _boulder_left_of(key, cave_row)

			if left > 0:
				_items[_next_id] = {"number": 0, "count": left, "pos": spot, "left": 1.0e9, "scatter": key, "boulder": cave_row}
				_next_id += 1

			continue

		if int(spots[n * 5 + 3]) == 2:   # left behind in an abandoned mine (Dave 19 Nov 2026): a worn tool, a bucket, ore; laid like the stones, saved once taken
			var left_id: String = str(MineSites.LEFTOVERS[clampi(int(spots[n * 5 + 4]), 0, MineSites.LEFTOVERS.size() - 1)])
			var left_number: int = table.number_of(left_id)

			if left_number > 0:
				var spent: int = int(float(table.entry(left_id).get("durability", 0)) * MineSites.OLD_WEAR)
				_items[_next_id] = {"number": left_number, "count": 1, "pos": spot, "left": 1.0e9, "scatter": key, "wear": spent}
				_next_id += 1

			continue

		var number: String = "flint" if flint > 0.0 and float(hash(key) % 1000) < 1000.0 * flint else "stone"
		_items[_next_id] = {"number": table.number_of(number), "count": 1, "pos": spot, "left": 1.0e9, "scatter": key}
		_next_id += 1


# Stones along the water's edge (Dave 2026-10-21: any rock put down is pickable, so Art's drawn pebbles and boulders became
# real stones). A cell with water in or near it tries bank_tries spots; a dry spot within bank_reach_m of water takes a
# stone with chance bank_chance, up to bank_max a cell. Item keys continue after the cell's own scatter (low four bits).
func _lay_out_bank_stones(cell: Vector2i, cell_m: float, cfg: Dictionary, used: int) -> void:
	var bank: Dictionary = cfg.get("bank", {})

	if bank.is_empty() or not water_near.is_valid():
		return

	var rng: RandomNumberGenerator = _layout_rng(cell, "bank stones")   # its own stream: the sticks before it no longer move it

	var centre: Vector3 = Vector3((float(cell.x) + 0.5) * cell_m, 0.0, (float(cell.y) + 0.5) * cell_m)

	if not bool(water_near.call(centre, float(bank.get("cell_probe_m", 24.0)))):
		return

	var reach: float = float(bank.get("reach_m", 3.0))
	var laid: int = 0

	for attempt in range(int(bank.get("tries", 40))):
		var x: float = (float(cell.x) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var z: float = (float(cell.y) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var chance: float = rng.randf()   # luck-exempt: seeded world layout

		if chance > float(bank.get("chance", 0.5)):   # before the ground is read (the draws are in the same order, so the stones lie where they did)
			continue

		var ground_usec: int = Time.get_ticks_usec()
		var y: float = float(ground_height.call(x, z))
		var water_usec: int = Time.get_ticks_usec()
		_bank_ground_usec += water_usec - ground_usec

		if is_nan(y) or y < 1.0:
			continue

		var spot: Vector3 = Vector3(x, y, z)
		var wet: bool = bool(water_near.call(spot, 0.0)) or not bool(water_near.call(spot, reach))
		_bank_water_usec += Time.get_ticks_usec() - water_usec

		if wet:
			continue

		var key: int = ((cell.x & 0xfffff) << 24) | ((cell.y & 0xfffff) << 4) | (used + laid)

		if used + laid >= 15 or laid >= int(bank.get("max", 6)):
			return

		laid += 1

		if _taken.has(key):
			continue

		var driftwood: bool = float(hash([key, "driftwood"]) % 1000) < 1000.0 * float(bank.get("driftwood", 0.12))   # from the key, so every try takes three draws
		var bank_number: String = "driftwood" if driftwood else "stone"

		if not driftwood and float(bank.get("flint", 0.0)) > 0.0 and float(hash(key) % 1000) < 1000.0 * float(bank.get("flint", 0.0)):
			bank_number = "flint"   # F-02: a share of the bank stones are flint (from the key, so the layout's random stream is not touched)

		_items[_next_id] = {"number": table.number_of(bank_number), "count": 1, "pos": spot, "left": 1.0e9, "scatter": key}
		_next_id += 1


const SCATTER_SLOPE_M := 0.5   # _scatter_spot: the slope under a loose stone or stick is read this far either side


# Where in a cell a loose stone or stick lies (Dave 2026-10-20: place them appropriately). A few random spots are
# tried and the first one the terrain "likes" is taken, so the counts stay as they were but the places are natural:
# sticks mostly under and around tree crowns and rarely on bare rock; stones on slopes, on bare rock and gravel, and
# in hollows at the foot of a rise, with a few left in open ground. The odds are in data/items/drops.json. A spot on
# ground over 45 degrees is never taken (round 4, 23 Nov 2026), so a cell that is all cliff gets fewer.
func _scatter_spot(rng: RandomNumberGenerator, cell: Vector2i, cell_m: float, stone: bool) -> Vector3:
	var cfg: Dictionary = _drops.get("ground_scatter", {})
	var tries: int = int(cfg.get("spot_tries", 4))
	var best: Vector3 = Vector3(0.0, NAN, 0.0)

	for attempt in range(tries):
		var x: float = (float(cell.x) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var z: float = (float(cell.y) + rng.randf()) * cell_m   # luck-exempt: seeded world layout
		var y: float = float(ground_height.call(x, z))

		if is_nan(y) or y < 1.0:
			continue

		# Not on ground steeper than a player stands on (45 degrees over 0.5 m): world audit round 4 (23 Nov 2026) found 1 in 5 loose stones and sticks
		# on such faces, 376 of them out of every player's reach. Nothing would rest there; the next try looks again.
		var fall_x: float = float(ground_height.call(x + SCATTER_SLOPE_M, z)) - float(ground_height.call(x - SCATTER_SLOPE_M, z))
		var fall_z: float = float(ground_height.call(x, z + SCATTER_SLOPE_M)) - float(ground_height.call(x, z - SCATTER_SLOPE_M))

		if not (Vector2(fall_x, fall_z).length() < 2.0 * SCATTER_SLOPE_M):
			continue

		var spot: Vector3 = Vector3(x, y, z)
		var like: float

		if stone:
			var east: float = float(ground_height.call(x + 3.0, z))
			var south: float = float(ground_height.call(x, z + 3.0))
			var rise: float = (absf(east - y) + absf(south - y)) / 3.0
			var west: float = float(ground_height.call(x - 6.0, z))
			var north: float = float(ground_height.call(x, z - 6.0))
			var hollow: float = clampf(((west + north + float(ground_height.call(x + 6.0, z)) + float(ground_height.call(x, z + 6.0))) / 4.0 - y) / 3.0, 0.0, 1.0)
			like = float(cfg.get("stone_open", 0.12)) + minf(rise * float(cfg.get("stone_slope", 1.2)), 0.6) + hollow * float(cfg.get("stone_foot", 0.25))

			if rock_at.is_valid() and bool(rock_at.call(x, z)):
				like += float(cfg.get("stone_rock", 0.4))
		else:
			like = float(cfg.get("stick_open", 0.12))

			if cover_at.is_valid() and float(cover_at.call(spot)) > 0.5:
				like += float(cfg.get("stick_tree", 0.88))

			if rock_at.is_valid() and bool(rock_at.call(x, z)):
				like *= float(cfg.get("stick_on_rock", 0.3))

		best = spot

		if like >= rng.randf():   # luck-exempt: seeded world layout
			return spot

	return best


# One blow on a standing tree with the tool in hand (an axe; a pick very slowly, wood_tools). Enough work fells it: the standing tree is removed, a stump
# stays (a record in _items with a "tree" entry, saved in tree_states.json) and the tree comes down in its logs (_fell_record).
func _hit(peer: int, inv, tree_id: int, chunk: Vector2i, held_slot: int) -> void:
	if chunk.x == Net.HIT_BOULDER:
		var rock: Dictionary = _items.get(tree_id, {})
		var rock_spot: Variant = rock.get("pos", null)
		var ore_rock: bool = (rock.get("boulder", {}) as Dictionary).has("ore")
		var hit_before: int = int(_last_hit.get(peer, -100000))
		_hit_boulder(peer, inv, tree_id, chunk.y - 1)   # a boulder blow's count is the held pack slot plus one

		# Only a blow the rock took (past the cooldown, reach and tool checks, which set _last_hit) on a rock with ore: a rock started is marked
		# on the Map, and the mark goes with its last stone. A refused or spammed blow costs nothing here and shows nothing the player cannot see.
		if ore_rock and rock_spot != null and int(_last_hit.get(peer, -100000)) != hit_before and map_look.is_valid():
			map_look.call(peer, rock_spot)

		return

	if not _peer_pos.has(peer) or not tree_info.is_valid() or not cut_tree.is_valid():
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_hit.get(peer, -100000)) < HIT_COOLDOWN_MS:
		return

	var tool: Array = _wood_tool(inv, held_slot)   # an axe, or (very slowly) a pick

	if tool.is_empty():
		_say_hands_full(peer, inv)
		_reject(peer, 1)
		return

	var info: Dictionary = tree_info.call(chunk, tree_id)

	if info.is_empty():
		return

	if NpcCamp.is_camp_tree(info["position"]):
		_say(peer, "This tree shelters Edda and Hob's camp. Leave it be.")   # Dave 17 Nov 2026: the camp tree stays (_fell refuses it too: undermining, roads)
		_reject(peer, 0)
		return

	var spot: Vector3 = info["position"]
	var flat: float = Vector2(_peer_pos[peer].x - spot.x, _peer_pos[peer].z - spot.z).length()

	if flat > HIT_REACH_M + float(info["trunk"]):
		_reject_far(peer)
		return

	_last_hit[peer] = now
	_wear_slot(peer, inv, int(tool[0]), "tree")
	var key: String = "%d,%d,%d" % [chunk.x, chunk.y, tree_id]
	var chop: Dictionary = _chops.get(key, {"hits": 0.0, "msec": now})

	if now - int(chop["msec"]) > CHOP_RESET_MS:
		chop["hits"] = 0.0

	chop["hits"] = float(chop["hits"]) + float(tool[2])   # the work done: a stone axe 1 a blow, a better axe more, a pick a little (wood_tools speed)

	if str(tool[1]) == "pick":
		var splinter_rng: RandomNumberGenerator = RandomNumberGenerator.new()
		splinter_rng.seed = hash([key, int(float(chop["hits"]) * 1000.0)])
		_pick_splinters(peer, splinter_rng)

	chop["msec"] = now
	_chops[key] = chop
	var fell: Dictionary = _drops.get("felling", {})   # data/items/drops.json "felling": the blow counts follow the swing time (balance, Dave tunes)
	var hit_radius: float = float(info["trunk"])

	if bool(fell.get("size_scaled", false)):   # off until Dave says yes (QA card tree-hits-follow-size): the blows follow this tree's own drawn trunk, so a sapling falls in fewer than a giant
		hit_radius = FellPose.standing_radius(float(info["trunk"]), float(info.get("ref_height", 0.0)), float(info["height"]), bool(info.get("broadleaf", false)))

	var needed: int = maxi(1, int(ceil(float(clampi(int(round(float(fell.get("tree_base", 4.0)) + hit_radius * float(fell.get("tree_per_trunk_m", 30.0)))), int(fell.get("tree_min", 4)), int(fell.get("tree_max", 40)))) / skill_factor(peer, "fell_tree"))))

	hit_number(peer, spot + Vector3(0.0, 1.2, 0.0), HIT_POINTS * float(tool[2]) / float(needed))

	if float(chop["hits"]) < float(needed) - 0.001:
		return

	if not bool(cut_tree.call(chunk, tree_id)):
		return

	_chops.erase(key)
	_fell_record(chunk, info, Vector2(spot.x - _peer_pos[peer].x, spot.z - _peer_pos[peer].z), str(_peer_key.get(peer, "")))
	_goal_event(peer, "tree_felled")
	practice(peer, "fell_tree", clampf(float(info["trunk"]) * 3.0, 0.4, 2.0))   # a thick trunk teaches more than a sapling


# Cuts a standing tree and brings it down in its logs beside its stump (the last axe blow and a dug-out tree both end here). `away` is the
# direction it falls in.
func _fell(chunk: Vector2i, tree_id: int, info: Dictionary, away: Vector2) -> int:   # the stump's world id, -1 when the tree was not cut
	if NpcCamp.is_camp_tree(info.get("position", Vector3.INF)) or not bool(cut_tree.call(chunk, tree_id)):   # the tree over Edda and Hob's camp never comes down (undermined, on a road)
		return -1

	return _fell_record(chunk, info, away)


# The butt radius of a felled tree: the radius its standing model is drawn with (fell_pose.gd drawn_radius: its species model and variant, so a slim
# young tree gives a slim trunk, stump and logs; Dave 2 Nov). Without the tree's id, the species trunk scaled with height as before.
func _felled_radius(info: Dictionary) -> float:
	var entry: Dictionary = _flora_by_name.get(str(info.get("name", "")), {})

	if info.has("id") and not entry.is_empty():
		return maxf(FellPose.drawn_radius(entry, int(info["id"]), float(info["height"])), 0.06)

	return maxf(FellPose.standing_radius(float(info["trunk"]), float(info.get("ref_height", 0.0)), float(info["height"]), bool(info.get("broadleaf", false))), 0.1)


# The circle a felled tree's crown lands on (Dave 10 Nov 2026), as [x, z, radius]: the canopy's own size (Cover.crown_radius of its species and height),
# centred on the middle of the crown's part of the trunk (drops.json trunk.crown_scatter.crown_from) as it lies.
func _crown_circle(spot: Vector3, info: Dictionary, yaw: float, pitch: float) -> Array:
	var cfg: Dictionary = (_drops.get("trunk", {}) as Dictionary).get("crown_scatter", {})
	var entry: Dictionary = _flora_by_name.get(str(info.get("name", "")), {})
	var height: float = float(info["height"])
	var span: Array = entry.get("height_m", [])
	var ref_height: float = float(info.get("ref_height", 0.0))

	if ref_height <= 0.0:
		ref_height = 0.5 * (float(span[0]) + float(span[1])) if span.size() >= 2 else height

	var radius: float = maxf(CoverScript.crown_radius(float(entry.get("crown_m", 3.0)), ref_height, height), float(cfg.get("min_radius_m", 1.5)))
	var from: float = clampf(float(cfg.get("crown_from", 0.5)), 0.0, 1.0)
	var along: float = height * (from + (1.0 - from) * 0.5) * cos(pitch)
	return [spot.x + sin(yaw) * along, spot.z + cos(yaw) * along, radius]


# --- A tree coming down (Dave 16 Nov 2026: "when you cut down a tree it should fall to the ground and when it hits the ground it should already be broken
# into logs. we do not care how many items are on the ground already. do not check for items on the ground. try to keep the code light and fast. we don't
# want lag. we want it to feel real. from the second the tree starts to fall it should be in logs and the logs should have collision so if they fall on
# anything they cause damage and roll off. this specifically applies to all trees that break into logs. all other trees do similar but break into whatever
# they should break into.") ---
# The last blow leaves the stump and lays, at once, everything the tree breaks into (_fall_pieces): a large tree's whole 3 m logs end to end along the line
# it falls on, a small tree's Firewood, kindling and sticks, and every tree's crown litter, bark, seeds and the rest. Each piece carries its fall (it["fall"]:
# the hinge at the stump, the fall's turn and its seconds left), so every client swings the pieces down round the stump together over FALL_S: the tree
# falls already in logs. At the landing (_land_fall) what lies under the tree is hurt (drops.json felling.crush), and the logs wake to roll: a log that came
# down on something (a rock, a stump, another log) is pushed off it. The pieces go straight into the record table: no world scans.
# They are the feller's gathering at once (goal got: counter).
# shortcut: a piece can be picked up while it is still coming down (1.5 s); buildings have no hit points yet, so a log only stops against them.
func _fell_record(chunk: Vector2i, info: Dictionary, away: Vector2, feller: String = "") -> int:   # feller: the character key whose axe felled it (what it breaks into is their gathering)
	var spot: Vector3 = info["position"]
	var yaw: float = atan2(away.x, away.y) if away.length() > 0.01 else 0.0
	var pitch: float = 0.0

	if ground_height.is_valid():   # fall away from the player, resting ON the ground and never inside a slope (fell_pose.gd)
		var pose: Dictionary = FellPose.choose(spot, away, float(info["height"]), _felled_radius(info), ground_height)
		yaw = float(pose["yaw"])
		pitch = float(pose["pitch"])

	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	# The same size as the standing tree: its drawn radius (scaled with its height), and its whole height as the length.
	var radius: float = _felled_radius(info)
	var tree: Dictionary = {"species": str(info["name"]), "yaw": yaw, "pitch": pitch, "length": float(info["height"]), "radius": radius, "felled_at": now_s}
	tree["crown"] = _crown_circle(spot, info, yaw, pitch)   # where its crown lands: the client flattens the grass there, the litter falls in it
	var stump: Dictionary = {"species": tree["species"], "yaw": yaw, "pitch": pitch, "length": tree["length"], "radius": radius, "felled_at": now_s, "state": 4, "chunk": [chunk.x, chunk.y], "crown": tree["crown"], "fresh": true}

	if info.has("id") and not bool(info.get("dynamic", false)):   # a planted tree is the items' own (_saplings), saved with the stump
		stump["flora_id"] = int(info["id"])   # the standing tree it was: kept cut on load if a crash wrote this stump but not the flora's removals (felled_flora)
	var stump_id: int = _next_id
	_items[stump_id] = {"number": 0, "count": 1, "pos": spot, "left": 1.0e9, "tree": stump}   # "fresh" until it lands: the client plays the fall from the stump row
	_next_id += 1
	var hinge: Vector3 = spot + Vector3(0.0, radius, 0.0)   # the trunk's axis rides one butt radius up, so the logs lie ON the ground
	var fall: Dictionary = {"hinge": hinge, "yaw": yaw, "left": FALL_S}   # one record shared by every piece: its seconds left run down in _fall_tick
	var pieces: Array = []
	var landed: Dictionary = {}   # item number -> count: the feller's gathering

	for piece in _fall_pieces(stump_id, tree, spot):
		var number: int = int(piece[0])
		var left: int = int(piece[1])

		while left > 0:   # straight into the table: a pile over PILE_CAP starts a second one
			var count: int = mini(left, PILE_CAP)
			var rec: Dictionary = {"number": number, "count": count, "pos": piece[2], "left": maxf(PILE_LIFETIME_S if count >= PILE_MIN else WORLD_ITEM_LIFETIME_S, SPLIT_LIFETIME_S), "wear": 0, "fall": fall}

			if piece.size() > 3:
				rec["rot_y"] = float(piece[3])

				if not is_nan(float(piece[4])):
					rec["girth"] = clampf(float(piece[4]), 0.25, 2.5)

			_items[_next_id] = rec
			pieces.append(_next_id)
			_next_id += 1
			left -= count

		landed[number] = int(landed.get(number, 0)) + int(piece[1])

	var feller_peer: Variant = _peer_key.find_key(feller) if feller != "" else null
	_credit_feller(feller_peer, landed)
	var along: Vector3 = Vector3(sin(yaw) * cos(pitch), sin(pitch), cos(yaw) * cos(pitch))
	_falls[stump_id] = {"shared": fall, "pieces": pieces, "hinge": hinge, "along": along, "length": float(tree["length"]), "radius": radius, "small": _is_small_tree(tree, _drops.get("trunk", {})), "peer": feller_peer}
	_dirty = true
	_sync_in = 0.0   # bug 6: the pieces go out on the next tick with the flora cut, not up to SYNC_EVERY_S later, so the tree never vanishes before it falls
	save_soon([stump_id] + pieces)   # a big event: the stump and its logs are on disk within seconds (the flora's removal waits for it: fells_on_disk)
	_fell_unsaved = true
	return stump_id


# Everything a felled `tree` (lying from `base` along its yaw and pitch) breaks into, as [item number, count, position] rows, a log row with its turn and girth
# after ([..., rot_y, girth]). A large tree: its whole 3 m logs end to end from the butt (the last one stands for the rest of the trunk), the bark, seeds, roots and
# species rows hand-cutting used to give (_trunk_extras) in a heap beside its middle, the crown's sticks and leaves over the circle it lands on, and its 1 to 5
# seeds. A small tree (_is_small_tree): the Firewood of its length (_small_firewood), the kindling and sticks of drops.json trunk.small, the branches (when it
# has no crown litter), its crown litter and its seeds. Rolled from `id` (the stump's) with no player, so no luck (world drops).
func _fall_pieces(id: int, tree: Dictionary, base: Vector3) -> Array:
	var cfg: Dictionary = _drops.get("trunk", {})
	var length: float = float(tree["length"])
	var yaw: float = float(tree["yaw"])
	var pitch: float = float(tree.get("pitch", 0.0))
	var along: Vector3 = Vector3(sin(yaw), 0.0, cos(yaw))
	var radius: float = float(tree["radius"])
	var middle: Vector3 = base + along * (length * 0.5 * cos(pitch)) + Vector3(0.0, sin(pitch) * length * 0.5 + radius, 0.0)
	var litter: Array = _crown_litter(id, tree, cfg, base)   # the crown's sticks and leaves, all over the circle it lands on
	var rows: Array = []
	var log_len: float = float(cfg.get("log_length_m", 3.0))
	var count: int = 0 if _is_small_tree(tree, cfg) else clampi(int(length / log_len), 0, int(cfg.get("max_logs", 20)))

	if count > 0:
		var log_n: int = _log_number(str(tree.get("species", "")))

		for k in range(count):   # each lies at the middle of its piece; the mesh lies along its x axis, so turned by yaw - 90 degrees it runs along the trunk (0 = +Z)
			var from_butt: float = float(k) * log_len
			var mid: float = from_butt + log_len * 0.5   # every log is drawn 3 m long: end to end from the butt (the last one's extra length is in its row, not its place)
			rows.append([log_n, 1, base + along * (mid * cos(pitch)) + Vector3(0.0, sin(pitch) * mid + radius, 0.0), yaw - PI * 0.5, _log_girth(log_n, radius)])

		var heap: Vector3 = middle + Vector3(-along.z, 0.0, along.x) * (radius + 0.7)   # beside the middle of the trunk

		for extra in _trunk_extras(id, tree, count, cfg, base, litter.is_empty()) + _felled_sap(tree):
			rows.append([int(extra[0]), int(extra[1]), heap])
	else:
		var rng: RandomNumberGenerator = RandomNumberGenerator.new()
		rng.seed = hash(id) ^ 7919
		var totals: Dictionary = {}
		var branch: Array = _branch_rows(tree, cfg, base) if litter.is_empty() else []

		for blow in range(int(cfg.get("branch_blows", 3))):
			for row in branch:
				var n: int = table.number_of(str(row[0]))
				totals[n] = int(totals.get(n, 0)) + rng.randi_range(int(row[1]), int(row[2]))   # luck-exempt: world drop, no player

		for blow in range(int(cfg.get("small_blows", 3))):
			for row in cfg.get("small", []):
				var m: int = table.number_of(str(row[0]))
				totals[m] = int(totals.get(m, 0)) + rng.randi_range(int(row[1]), int(row[2]))   # luck-exempt: world drop, no player

		var firewood_n: int = table.number_of("firewood")
		totals[firewood_n] = int(totals.get(firewood_n, 0)) + _small_firewood(tree, cfg)

		for sap in _felled_sap(tree):
			totals[int(sap[0])] = int(totals.get(int(sap[0]), 0)) + int(sap[1])

		for n in totals:
			if int(n) > 0 and int(totals[n]) > 0:
				rows.append([int(n), int(totals[n]), middle])

	for row in litter + _seed_litter(id, tree, middle):   # the crown's sticks and leaves, and its seeds
		if int(row[0]) > 0 and int(row[1]) > 0:
			rows.append([int(row[0]), int(row[1]), row[2]])

	return rows


# Each slow tick: the falling trees' time runs down (the server's own clock, so a test that ticks lands them too), and one whose time is up lands (_land_fall).
func _fall_tick(spent: float) -> void:
	if _falls.is_empty():
		return

	for id in _falls.keys():
		var fall: Dictionary = _falls[id]
		var shared: Dictionary = fall["shared"]
		shared["left"] = float(shared["left"]) - spent

		if _items.has(id) and _items[id].has("tree"):
			_items[id]["tree"]["fall_left"] = maxf(float(shared["left"]), 0.0)   # a client that sees the stump late plays the rest of the fall, not all of it

		if float(shared["left"]) <= 0.0:
			_falls.erase(id)
			_land_fall(int(id), fall)


# A felled tree hits the ground: the stump stops being "fresh" (a client that sees it from now on plays no fall), the pieces stop falling, whatever stands under
# the trunk's line is hurt (drops.json felling.crush: a player loses health, the first animal along it is struck), and its logs become bodies in the log physics
# (_wake_log): one that came down on something (a rock, a stump, a standing tree, a wall, another loose log) is pushed off it and rolls the way physics says.
func _land_fall(stump_id: int, fall: Dictionary) -> void:
	var crush: Dictionary = (_drops.get("felling", {}) as Dictionary).get("crush", {})

	if _items.has(stump_id) and _items[stump_id].has("tree"):
		_items[stump_id]["tree"].erase("fresh")
		_items[stump_id]["tree"].erase("fall_left")

	var logs: Array = []

	for id in fall["pieces"]:
		if _items.has(id):
			_items[id].erase("fall")

			if _rolls_item(int(_items[id]["number"])):
				logs.append(id)

				if ground_height.is_valid():   # down: on the ground point (the loose-log convention, lying_logs.gd), the log space settles it from there
					var at: Vector3 = _items[id]["pos"]
					var ground: float = float(ground_height.call(at.x, at.z))

					if not is_nan(ground):
						_items[id]["pos"] = Vector3(at.x, ground, at.z)
						_refile(id)

	var hinge: Vector3 = fall["hinge"]
	var tip: Vector3 = hinge + (fall["along"] as Vector3) * float(fall["length"])
	var reach: float = float(fall["radius"]) + float(crush.get("reach_m", 0.5))
	var hurt: float = float(crush.get("small_health" if bool(fall["small"]) else "health", 0.0))

	for peer in _peer_pos:
		var at: Vector3 = _peer_pos[peer]
		var t: float = _seg_t(Vector2(hinge.x, hinge.z), Vector2(tip.x, tip.z), Vector2(at.x, at.z))
		var on_line: Vector3 = hinge.lerp(tip, t)

		if hurt > 0.0 and Vector2(at.x - on_line.x, at.z - on_line.z).length() <= reach and absf(at.y - on_line.y) <= float(crush.get("height_m", 2.5)):
			_crushed(int(peer), hurt)

	if hit_animal_path.is_valid() and float(crush.get("animal", 0.0)) > 0.0:
		hit_animal_path.call(fall["peer"] if fall["peer"] != null else 0, hinge + Vector3(0.0, 0.5, 0.0), tip + Vector3(0.0, 0.5, 0.0), float(crush.get("animal", 0.0)) * (0.3 if bool(fall["small"]) else 1.0), [])

	if animal_alarm.is_valid() and float(crush.get("alarm_m", 0.0)) > 0.0:   # the crash: animals near the tree's middle run from it (hearing-range pass, 23 Nov 2026)
		animal_alarm.call(hinge.lerp(tip, 0.5), float(crush.get("alarm_m", 0.0)) * (0.5 if bool(fall["small"]) else 1.0))

	# Down: each log is a body in the log space from here on (_wake_log), so one that came down on a rock, a stump, another tree's logs or a wall is
	# pushed off it and rolls away the way physics says. Its own stump is left behind: the logs lie from just clear of it.
	var clear: float = float(_items[stump_id]["tree"].get("radius", 0.3)) + 0.05 if _items.has(stump_id) and _items[stump_id].has("tree") else 0.0
	var along: Vector3 = Vector3((fall["along"] as Vector3).x, 0.0, (fall["along"] as Vector3).z).normalized()

	for id in logs:
		_items[id]["pos"] += along * clear
		_refile(id)
		_wake_log(id)

	if bool(fall.get("undermined", false)) or (_items.has(stump_id) and _stump_undermined(_items[stump_id])):
		_break_stump(stump_id)   # dug out from under: no stump is left hanging over the hole


# Where on segment a0-a1 (0 at a0 .. 1 at a1) the point p is nearest.
static func _seg_t(a0: Vector2, a1: Vector2, p: Vector2) -> float:
	var run: Vector2 = a1 - a0
	var len_sq: float = run.length_squared()
	return 0.0 if len_sq < 1e-8 else clampf((p - a0).dot(run) / len_sq, 0.0, 1.0)


# A falling tree hits a player: health goes down by `amount` (never under 1, like a fall; drops.json felling.crush), and they are told.
func _crushed(peer: int, amount: float) -> void:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty():
		return

	v["health"] = maxf(float(v["health"]) - amount * comfort_bonus(peer, "damage_taken_mult"), 1.0)
	_say(peer, "A falling tree hit you")

	if not _forced_sleep(peer):
		_asleep.erase(peer)

	_sync_vitals(peer, true)


# THE place a swing resolves its tool: the held pack slot when it is a usable tool of this class on the hotbar, else -1. Every hit, strike or
# stroke goes through here (or _swing_tool, which also says why), never through "the first tool of the class on the hotbar" (Dave 13 Nov
# 2026: "if you do an attack on anything at anytime it needs to know what weapon is in hand"; "swinging any tool or weapon needs to always
# check the tool or weapon first because they might have bonuses to be able to hit stuff"). TEST-013 playtest repair.
func _held_tool(inv, slot: int, tool_class: String) -> int:
	if slot < 0 or slot >= inv.slot_count or not inv.on_hotbar(slot) or _is_broken(inv, slot) or _hands_full(inv):
		return -1

	return slot if str(table.entry(table.id_of(inv.numbers[slot])).get("tool_class", "")) == tool_class else -1


# Logs on the shoulder keep both hands busy: the tool in hand is stowed and no swing uses it (TREE_WOOD_TOOLS_DESIGN.md s1.2; the client puts it away, held_item.gd
# carrying_log). Eating and drinking are not tool work and still go through.
func _hands_full(inv) -> bool:
	return not CarryRules.shoulder_logs(inv, table).is_empty()


const HANDS_FULL_SAY_GAP_MS := 3000


# Says why a swing did nothing when logs are carried; true when that was the reason.
func _say_hands_full(peer: int, inv) -> bool:
	if not _hands_full(inv):
		return false

	_say(peer, "Your hands are full of logs. Put them down first (Q).")
	return true


# The wood tool in hand as [slot, tool class, speed]: an axe, or a pick (the wrong tool: very slow, tears loose sticks and kindling), with
# drops.json wood_tools speed by its class and material; [] when the held slot is neither (TEST-013).
func _wood_tool(inv, slot: int) -> Array:
	var speeds: Dictionary = (_drops.get("wood_tools", {}) as Dictionary).get("speed", {})

	for tool_class in ["axe", "pick"]:
		if _held_tool(inv, slot, tool_class) >= 0:
			var speed: float = float((speeds.get(tool_class, {}) as Dictionary).get(str(table.entry(table.id_of(inv.numbers[slot])).get("material", "")), 0.0))
			return [slot, tool_class, speed] if speed > 0.0 else []

	return []


# What a pick tears loose from wood with every blow (drops.json wood_tools pick_splinters): kindling and thatch, never sticks or wood (Dave 12 Nov 2026).
func _pick_splinters(peer: int, rng: RandomNumberGenerator) -> void:
	for row in (_drops.get("wood_tools", {}) as Dictionary).get("pick_splinters", []):
		give(peer, table.number_of(str(row[0])), roll_amount(peer, rng, int(row[1]), int(row[2])))


# The kindling a pick leaves of a whole log (drops.json wood_tools pick_log_kindling): a shoulder log or a trunk length, else a small log.
func _pick_kindling(big: bool) -> int:
	var counts: Dictionary = (_drops.get("wood_tools", {}) as Dictionary).get("pick_log_kindling", {})
	return maxi(1, int(counts.get("big" if big else "small", 10 if big else 5)))


func _has_tool(inv, tool_class: String) -> bool:
	return _tool_slot(inv, tool_class) >= 0


# The pack slot of a usable (not broken) tool of this class in a hotbar slot (pack slots 0 to 9), or -1.
func _tool_slot(inv, tool_class: String) -> int:
	for slot in range(inv.slot_count):
		if inv.on_hotbar(slot) and str(table.entry(table.id_of(inv.numbers[slot])).get("tool_class", "")) == tool_class and not _is_broken(inv, slot):
			return slot

	return -1


# A recipe that keeps a tool needs it, unbroken, anywhere in the pack or on the hotbar (CraftStock.has_tool; Dave 24 Nov 2026: "if you have a knife
# in you inventory or on your hotbar it should count", replacing the 17 Nov in-hand rule); otherwise says so and answers false. `_hand` (the slot
# the client names in at.x, protocol 126) no longer matters. Any other recipe: true.
func _hand_tool_ok(peer: int, inv, recipe: Dictionary, _hand: int) -> bool:
	if CraftStock.has_tool(recipe, table, inv):
		return true

	_say(peer, "That needs %s in your pack" % CraftStock.hand_words(recipe, table))
	return false


# The slot of the tool a craft wears (wears_tool, the saw): the first on the hotbar, else the first anywhere in the pack (Dave 24 Nov 2026); -1 none.
func _craft_tool_slot(inv, tool_class: String) -> int:
	var slot: int = _tool_slot(inv, tool_class)

	if slot >= 0:
		return slot

	for k in range(inv.slot_count):
		if str(table.entry(table.id_of(inv.numbers[k])).get("tool_class", "")) == tool_class and not _is_broken(inv, k):
			return k

	return -1


# _held_tool for a swing that needs this class, saying why nothing happened when the hand holds something else: the tool in hand is broken,
# or it is not that tool.
func _swing_tool(peer: int, inv, slot: int, tool_class: String) -> int:
	var tool: int = _held_tool(inv, slot, tool_class)

	if tool >= 0:
		return tool

	if _say_hands_full(peer, inv):
		return -1

	if slot >= 0 and slot < inv.slot_count and inv.numbers[slot] != 0 and _is_broken(inv, slot) and str(table.entry(table.id_of(inv.numbers[slot])).get("tool_class", "")) == tool_class:
		_say(peer, "Your %s is broken. %s" % [table.sentence_name(inv.numbers[slot]), _repair_hint(table.entry(table.id_of(inv.numbers[slot])))])
	else:
		_say(peer, "You need a %s in hand for that." % tool_class)

	return -1


# Broken: its wear has reached its current maximum durability (the instance's max_d, else items.json durability); items without it never wear.
func _is_broken(inv, slot: int) -> bool:
	var most: int = inv.max_durability(slot)
	return most > 0 and inv.wear[slot] >= most


# One use spent on the first usable tool of this class on the hotbar; tells the player when it breaks.
# Wear per use comes from drops.json "tool_wear" (per tool class and kind of work, default 1), so a tuning change is data.
func _wear_tool(peer: int, inv, tool_class: String, use: String = "") -> void:
	_wear_slot(peer, inv, _tool_slot(inv, tool_class), use)


# A swing was made with a tool of this class: it holds the body at the class's effort for work_s (exertion.json tool_effort). Every swing that is
# really executed calls this once, on a hit through _wear_slot, on a miss (bare ground, empty air, a jab at nothing) directly: a miss tires
# as much as a hit (BUGLIST-001 BUG-001).
func _note_work(peer: int, tool_class: String) -> void:
	var work_cfg: Dictionary = _exertion_cfg.get("tool_effort", {})
	_work_until[peer] = Time.get_ticks_msec() + int(float(_exertion_cfg.get("work_s", 2.5)) * 1000.0)
	_work_level[peer] = float(work_cfg.get(tool_class, work_cfg.get("default", 0.6)))


func _wear_slot(peer: int, inv, slot: int, use: String = "") -> void:
	if slot < 0 or inv.max_durability(slot) <= 0:
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var tool_class: String = str(entry.get("tool_class", ""))
	_note_work(peer, tool_class)
	# A skilled crafter looks after their tools: wear is spread by the tool_care factor (1.0 for everyone at first), a deterministic
	# carry of the fraction so no dice are involved.
	var per_use: int = maxi(0, int(_drops.get("tool_wear", {}).get("per_use", {}).get(tool_class, {}).get(use, 1)))   # 0: work that cannot wear or dull this tool (a pick on wood)

	if per_use == 0:
		return

	var before: Array = _snapshot(inv)

	var wear_now: float = float(per_use) / skill_factor(peer, "tool_care") + float(_wear_carry.get(peer, 0.0))
	var whole: int = int(floor(wear_now + 0.001))
	_wear_carry[peer] = wear_now - float(whole)
	var dull_at: int = SmithingRules.dull_at(entry, inv.inst[slot])

	# An edge dulls with the work it does (smithing.json dull_share); fully dull, it wears dull_wear_mult times as fast (master s2.2 rules 6-8).
	if dull_at > 0 and whole > 0:
		var item_inst: Dictionary = inv.inst[slot].duplicate()

		if int(item_inst.get("sharp", 0)) >= dull_at:
			whole *= maxi(int(SmithingRules.cfg().get("dull_wear_mult", 2)), 1)
		else:
			item_inst["sharp"] = mini(int(item_inst.get("sharp", 0)) + whole, dull_at)
			inv.inst[slot] = item_inst

	inv.wear[slot] += whole
	_dirty = true

	if _is_broken(inv, slot):
		_tool_broke(peer, inv, slot, entry)

	_send_changes(peer, inv, before)


# A tool at its maximum: stone, wooden and primitive tools are gone (master s2.2 rules 1-3); a metal tool stays in its slot, unusable,
# until it is repaired (rule 4). The caller sends the slot change.
func _tool_broke(peer: int, inv, slot: int, entry: Dictionary) -> void:
	var item_name: String = table.sentence_name(inv.numbers[slot])

	if SmithingRules.disposable(entry):
		inv.clear_slot(slot)
		_say(peer, "Your %s broke and is gone." % item_name)
	else:
		_say(peer, "Your %s broke. %s" % [item_name, _repair_hint(entry)])


# Repair (ACT_REPAIR, R on a slot). A dull edge tool that is not broken is sharpened (_start_sharpen); otherwise, or when sharpening cannot start
# here but its repair station is beside you, the tool takes its items.json repair materials at its repair_station and its wear goes back to 0:
# up to its current maximum, which only sharpening lowers (master s2.2 rule 5). A disposable row (no repair) is never mended.
func _repair(peer: int, inv, slot: int) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0:
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var bench: String = str(entry.get("repair_station", ""))

	if inv.sharpness_used(slot) > 0 and SmithingRules.dull_at(entry, inv.inst[slot]) > 0 and not _is_broken(inv, slot):
		var why: String = _start_sharpen(peer, inv, slot)

		if why == "":
			return

		if inv.wear[slot] <= 0 or (bench != "" and not station_near(peer, bench)):
			_say(peer, why)
			return

	if inv.wear[slot] <= 0:
		return

	var costs: Array = entry.get("repair", [])

	if costs.is_empty():
		_say(peer, "Your %s cannot be mended. Make a new one." % table.sentence_name(inv.numbers[slot]))
		return

	if bench != "" and not station_near(peer, bench):
		# Beside a worn-out or unfuelled smithy the player is told what is wrong with it, as a craft there is (ore loop, 23 Nov 2026).
		if _broken_station_near(peer, bench):
			_say(peer, "Needs repair")
		elif _unfuelled_smithy_near(peer, bench):
			_say(peer, "The %s has no fuel: put Coal or Charcoal in its fuel slot (its first slot)" % _station_name(bench))
		else:
			_say(peer, "Repairing this needs a %s nearby." % _station_name(bench).to_lower())

		return

	# The tool's own slot must not be spent as material. A cost is filled like a recipe's (ingredient groups: an Iron chunk mends what asks
	# for an Iron ingot, Dave 21 Nov 2026).
	var tool_number: int = inv.numbers[slot]

	for cost in costs:
		var number: int = table.number_of(str(cost[0]))
		var have: int = inv.count_fill(number) - (inv.counts[slot] if inv.fills_of(number).has(tool_number) else 0)

		if number == 0 or have < int(cost[1]):
			_say(peer, "Repair needs %s." % _repair_text(costs))
			return

	for cost in costs:
		inv.remove_fill(table.number_of(str(cost[0])), int(cost[1]))

	inv.wear[slot] = 0
	practice(peer, "tool_care")
	_goal_event(peer, "tool_repaired")   # ADD-10: the tool took its repair materials and its wear is back to 0


# What to do with a broken tool: where and with what it is repaired, or that a disposable one is made anew.
func _repair_hint(entry: Dictionary) -> String:
	var costs: Array = entry.get("repair", [])

	if costs.is_empty():
		return "Make a new one."

	var bench: String = str(entry.get("repair_station", ""))
	return "Repair it%s with %s (R in the inventory)." % [(" at a %s" % _station_name(bench).to_lower()) if bench != "" else "", _repair_text(costs)]


# --- Sharpening (master s2.2 rules 6-8, s4 item 2; data/items/smithing.json). A timed job per player, not saved: it stops on quit. ---
var _sharpening: Dictionary = {}   # peer -> {slot, number, how ("whetstone" or "grindstone"), pos (where it started), done (work seconds), need (seconds for this tool), sharp (sharpness used at its start)}


# Sharpens the dull edge tool in `slot`, at a grindstone beside you or else on a whetstone from the pack with water at hand; the other dull edge
# tools follow one after another (_sharpen_tick). "" when it started, else why not.
func _start_sharpen(peer: int, inv, slot: int) -> String:
	if _sharpening.has(peer):
		return "" if int(_sharpening[peer]["slot"]) == slot else "You are already sharpening."

	var how: String = "grindstone" if station_near(peer, _grindstone_station()) else "whetstone"
	var why: String = _sharpen_block(peer, inv, how)

	if why != "":
		return why

	_begin_sharpen(peer, inv, slot, how, _peer_pos[peer])
	_say(peer, "You start sharpening the %s %s." % [table.sentence_name(inv.numbers[slot]), "at the grindstone" if how == "grindstone" else "on your whetstone"])
	return ""


func _grindstone_station() -> String:
	return str(SmithingRules.cfg().get("grindstone", {}).get("station", "grindstone"))


func _begin_sharpen(peer: int, inv, slot: int, how: String, pos: Vector3) -> void:
	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	_sharpening[peer] = {"slot": slot, "number": inv.numbers[slot], "how": how, "pos": pos, "done": 0.0, "need": SmithingRules.sharpen_s(entry, inv.inst[slot], how), "sharp": inv.sharpness_used(slot)}


# Why sharpening cannot go on now ("" when it can): the grindstone is out of reach, or no sound whetstone, or no water at hand for it.
func _sharpen_block(peer: int, inv, how: String) -> String:
	if how == "grindstone":
		return "" if station_near(peer, _grindstone_station()) else "You walked away from the grindstone."

	if _whetstone_slot(inv) < 0:
		return "You need a whetstone or a grindstone to sharpen it."

	if not _water_at_hand(peer, inv):
		return "A whetstone needs water: carry some in a container, or stay by the water."

	return ""


func _whetstone_slot(inv) -> int:
	var stone: int = table.number_of(str(SmithingRules.cfg().get("whetstone", {}).get("item", "whetstone")))

	for s in inv.slot_count:
		if stone != 0 and inv.numbers[s] == stone and not _is_broken(inv, s):
			return s

	return -1


# A filled water container in the pack, or drinkable water within the thirst reach (a tank, the settled water, a spring or brook of the record).
func _water_at_hand(peer: int, inv) -> bool:
	for s in inv.slot_count:
		if _container_cap(inv.numbers[s]) > 0 and inv.wear[s] > 0:
			return true

	var thirst: Dictionary = _vitals_cfg.get("thirst", {})
	var reach: float = float(thirst.get("reach_m", 3.0))
	var pos: Vector3 = _peer_pos[peer]
	return _tank_near(pos, reach) >= 0 or _drink_water_near(pos, reach) or _record_water_near(peer, thirst)


# Water a player at pos can drink or fill from: within reach, and not down a bank or cliff (drink_water_near; water_near where the scene sets none).
func _drink_water_near(pos: Vector3, reach: float) -> bool:
	if drink_water_near.is_valid():
		return bool(drink_water_near.call(pos, reach))

	return water_near.is_valid() and bool(water_near.call(pos, reach))


# Every slow tick: each job's work goes on (seat_speed times faster sitting on a seat at a whetstone); a finished tool gets its sharpness back and
# the next dull edge tool starts. Walking move_m away from a whetstone, leaving the grindstone, or losing the water or whetstone stops it, and what
# was done so far counts in proportion.
func _sharpen_tick(spent: float) -> void:
	for peer in _sharpening.keys():
		var job: Dictionary = _sharpening[peer]
		var inv = inventory_of(peer)

		if inv == null or not _peer_pos.has(peer):
			_sharpening.erase(peer)
			continue

		var slot: int = int(job["slot"])

		if inv.numbers[slot] != int(job["number"]) or _is_broken(inv, slot):   # the tool left the slot or broke: on to the next one
			_next_sharpen(peer, inv, job)
			continue

		var how: String = str(job["how"])
		var whet: Dictionary = SmithingRules.cfg().get("whetstone", {})
		var why: String = _sharpen_block(peer, inv, how)
		var here: Vector3 = _peer_pos[peer]

		if why == "" and how == "whetstone" and Vector2(here.x - job["pos"].x, here.z - job["pos"].z).length() > float(whet.get("move_m", 1.5)):
			why = "You moved away."

		if why != "":
			_apply_sharpen(peer, inv, job)
			_sharpening.erase(peer)
			_say(peer, "You stop sharpening. %s" % why)
			continue

		var speed: float = float(whet.get("seat_speed", 1.5)) if how == "whetstone" and int(_stance.get(peer, 0)) == 2 and _seat_near(here) else 1.0
		job["done"] = float(job["done"]) + spent * speed

		if float(job["done"]) >= float(job["need"]):
			_apply_sharpen(peer, inv, job)
			_next_sharpen(peer, inv, job)


# The job's work so far restores that share of the sharpness it started with, and lowers the tool's maximum durability in proportion
# (SmithingRules.sharpen_loss); the whetstone wears one use per tool.
func _apply_sharpen(peer: int, inv, job: Dictionary) -> void:
	var slot: int = int(job["slot"])
	var share: float = clampf(float(job["done"]) / float(job["need"]), 0.0, 1.0) if float(job["need"]) > 0.0 else 1.0
	var restored: int = mini(int(round(float(job["sharp"]) * share)), inv.sharpness_used(slot))

	if restored <= 0 or inv.numbers[slot] != int(job["number"]):
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var before: Array = _snapshot(inv)
	var item_inst: Dictionary = inv.inst[slot].duplicate()
	item_inst["max_d"] = maxi(SmithingRules.max_of(entry, item_inst) - SmithingRules.sharpen_loss(entry, item_inst, restored), 1)
	item_inst["sharp"] = inv.sharpness_used(slot) - restored
	inv.inst[slot] = InventoryScript.clean_inst(item_inst)
	practice(peer, "tool_care")
	_dirty = true
	_goal_event(peer, "tool_sharpened")   # ADD-09: some edge really came back (restored > 0); a job stopped part-way counts, it restored in proportion

	if _is_broken(inv, slot):   # the lower maximum reached its wear: it breaks as a use would break it
		_tool_broke(peer, inv, slot, entry)

	_send_changes(peer, inv, before)

	if str(job["how"]) == "whetstone":
		_wear_slot(peer, inv, _whetstone_slot(inv), "sharpen")


func _next_sharpen(peer: int, inv, job: Dictionary) -> void:
	for s in inv.slot_count:
		if inv.numbers[s] != 0 and inv.sharpness_used(s) > 0 and not _is_broken(inv, s) and SmithingRules.dull_at(table.entry(table.id_of(inv.numbers[s])), inv.inst[s]) > 0:
			_begin_sharpen(peer, inv, s, str(job["how"]), job["pos"])
			_say(peer, "You sharpen the %s next." % table.sentence_name(inv.numbers[s]))
			return

	_sharpening.erase(peer)
	_say(peer, "Your tools are sharp.")


func _repair_text(costs: Array) -> String:
	var parts: PackedStringArray = PackedStringArray()

	for cost in costs:
		parts.append("%d %s" % [int(cost[1]), _item_name_lower(str(cost[0]))])

	return ", ".join(parts)


# Stumps rot away after 168 game days (the game clock only runs while the server does).
func _rot(delta: float) -> void:
	# Stumps loaded from a save are looked at once, STUMP_LOAD_CHECKS a slow tick (each is a dig_support look at the edits near it): one left over a
	# dug hole breaks up (_stump_undermined).
	if not _stumps_to_check.is_empty() and dig_support.is_valid():
		for id in _stumps_to_check.slice(0, STUMP_LOAD_CHECKS):
			if _items.has(id) and _stump_undermined(_items[id]):
				_break_stump(int(id))

		_stumps_to_check = _stumps_to_check.slice(STUMP_LOAD_CHECKS)

	_rot_in -= delta

	if _rot_in > 0.0 or not game_seconds.is_valid():
		return

	_rot_in = 60.0
	var now_s: float = float(game_seconds.call())
	rot_scanned = 0
	rot_removed = 0

	for id in _items.keys():
		if _items.has(id) and _items[id].has("tree"):
			rot_scanned += 1

		if _items.has(id) and _items[id].has("tree") and now_s - float(_items[id]["tree"]["felled_at"]) >= ROT_GAME_S:
			var rotted: Dictionary = _items[id]
			_items.erase(id)
			_dirty = true
			rot_removed += 1

			# Lazy catch-up: a stump that rotted while nobody was here seeds its sapling at the moment it rotted, so it has
			# grown by the time we look (growth is computed from planted_at, nothing ticks).
			if int(rotted["tree"]["state"]) == 4:
				_maybe_sapling(rotted, float(rotted["tree"]["felled_at"]) + ROT_GAME_S)

	var stale: Array = []
	var now_ms: int = Time.get_ticks_msec()

	for key in _chops:
		if now_ms - int(_chops[key]["msec"]) > CHOP_RESET_MS:
			stale.append(key)

	for key in stale:
		_chops.erase(key)


func _save_trees() -> void:   # tree_states.json alone (the soak's timing); save() writes it with the other item files
	_write_atomic("tree_states.json", {"version": TREE_SAVE_VERSION, "trees": _tree_rows_of(_items), "saplings": _sapling_rows()})


func _load_trees() -> void:
	var parsed: Variant = _read_json_version("tree_states.json", TREE_SAVE_VERSION)

	if parsed == null:
		return

	for sapling in parsed.get("saplings", []):
		_saplings.append({"slot": int(sapling["slot"]), "chunk": [int(sapling["chunk"][0]), int(sapling["chunk"][1])], "species": int(sapling["species"]), "pos": Vector3(sapling["pos"]["x"], sapling["pos"]["y"], sapling["pos"]["z"]), "planted_at": float(sapling["planted_at"])})

	for row in parsed["trees"]:
		var tree: Dictionary = row["tree"]
		tree["state"] = int(tree["state"])
		tree["chunk"] = [int(tree["chunk"][0]), int(tree["chunk"][1])]

		if int(tree["state"]) != 4:
			continue   # only stumps are kept (a felled tree is its logs at once, 16 Nov 2026; no older saves are carried: Dave, new game)

		tree.erase("fresh")   # it landed long ago
		tree.erase("fall_left")
		_items[_next_id] = {"number": 0, "count": 1, "pos": Vector3(row["pos"][0], row["pos"][1], row["pos"][2]), "left": 1.0e9, "tree": tree}
		_stumps_to_check.append(_next_id)
		_next_id += 1


# One blow with the tool in hand on worked wood: a carcass is butchered, a loose log or block is chopped (_chop_loose_log), a stump is chopped up (_chop_stump).
# A felled tree is never a trunk to cut: it comes down already in its logs (_fell_record).
func _process_trunk(peer: int, inv, id: int, held_slot: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if str(it.get("struct", {}).get("kind", "")) == "carcass":
		_process_carcass(peer, inv, id, held_slot)
		return

	var tool: Array = _wood_tool(inv, held_slot)   # wood is worked with the tool in hand: an axe, or (very slowly) a pick (TEST-013)
	var a_log: bool = not it.is_empty() and not it.has("tree") and not it.has("struct") and (table.id_of(int(it["number"])) in ["log", "wooden_block"] or is_shoulder_item(int(it["number"])))

	if tool.is_empty():
		if _say_hands_full(peer, inv):
			return

		if a_log or (not it.is_empty() and it.has("tree")):
			_say(peer, "You need an axe in hand to work wood.")   # the wood sound played, so say why nothing came of it

		return

	if a_log:
		_chop_loose_log(peer, inv, id, tool)
		return

	if not it.is_empty() and it.has("tree") and int(it["tree"]["state"]) == 4:
		_chop_stump(peer, inv, id, tool)


# The rows the last blow gives: the first final_by_radius entry whose max_radius_m reaches the stump's radius (the last has no limit), else the plain "final" rows (Sal and Dave, 1 Nov 2026).
func _stump_final_rows(cfg: Dictionary, radius: float) -> Array:
	for entry in cfg.get("final_by_radius", []):
		if radius <= float(entry.get("max_radius_m", 1.0e9)):
			return entry.get("rows", [])

	return cfg.get("final", [])


# One axe blow on a stump (drops.json "stump"): a few blows (more for a thick one) chop it up for kindling and firewood, then it is gone and its record
# is freed. The blow count is saved with the stump, so a half-chopped stump stays half-chopped across a restart; the pace and skill rules are the trunk's.
func _chop_stump(peer: int, inv, id: int, tool: Array) -> void:   # `tool`: the wood tool in hand, _wood_tool (checked by _process_trunk)
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("tree") or int(it["tree"]["state"]) != 4 or not _peer_pos.has(peer):
		return

	var tree: Dictionary = it["tree"]
	var cfg: Dictionary = _drops.get("stump", {})

	if Vector2(_peer_pos[peer].x - it["pos"].x, _peer_pos[peer].z - it["pos"].z).length() > PROCESS_REACH_M + float(tree["radius"]):
		return

	var now: int = Time.get_ticks_msec()

	if float(now - int(_last_process.get(peer, -100000))) < float(PROCESS_COOLDOWN_MS) / _pace_factor(peer, "work_trunk"):
		return

	_last_process[peer] = now
	_wear_slot(peer, inv, int(tool[0]), "trunk")
	practice(peer, "work_trunk")
	var by_pick: bool = str(tool[1]) == "pick"
	var needed: int = clampi(int(ceil(float(cfg.get("blows_base", 3)) + float(tree["radius"]) * float(cfg.get("blows_per_radius_m", 15)))), int(cfg.get("blows_min", 3)), int(cfg.get("blows_max", 14)))
	needed = maxi(1, int(ceil(float(needed) / float(tool[2]) - 0.001)))   # the stone axe's blows, divided by the tool's speed (wood_tools)
	var blows: int = int(tree.get("blows", 0)) + 1
	tree["blows"] = blows
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(id) ^ (blows * 7919)

	if by_pick:   # a pick only tears the stump up: kindling and thatch every blow, a pile of kindling at the end (Dave 12 Nov 2026)
		_pick_splinters(peer, rng)

		if blows >= needed:
			give(peer, table.number_of("kindling"), _pick_kindling(false))
			_items.erase(id)
		elif send_notice.is_valid():
			send_notice.call(peer, "Breaking up the stump: %d of %d" % [blows, needed])
	elif blows < needed:
		if roll_chance(peer, rng, float(cfg.get("chip_chance", 0.5))):
			for row in cfg.get("chip", []):
				give(peer, table.number_of(str(row[0])), roll_amount(peer, rng, int(row[1]), int(row[2])))

		if send_notice.is_valid():
			send_notice.call(peer, "Chopping the stump: %d of %d" % [blows, needed])
	else:
		for row in _stump_final_rows(cfg, float(tree["radius"])):
			give(peer, table.number_of(str(row[0])), roll_amount(peer, rng, int(row[1]), int(row[2])))

		_items.erase(id)

	_dirty = true


# The item number of a species' log; a species without its own log item (or a retired one: alder, willow...) gives the plain Log.
func _log_number(species: String) -> int:
	var log_n: int = table.number_of("log_" + species)

	if log_n <= 0 or bool(table.entry("log_" + species).get("retired", false)):
		log_n = table.number_of("log")

	return log_n


# A felled tree is SMALL when its trunk is shorter than drops.json trunk.small_tree max_length_m or its butt radius is under min_radius_m (TREE_WOOD_TOOLS_DESIGN.md s5):
# it makes no logs, only Firewood (_small_firewood), kindling and sticks. A large tree comes down as 3 m logs (_fall_pieces).
func _is_small_tree(tree: Dictionary, cfg: Dictionary) -> bool:
	var small: Dictionary = cfg.get("small_tree", {})
	return float(tree["length"]) < float(small.get("max_length_m", 8.0)) or float(tree["radius"]) < float(small.get("min_radius_m", 0.12))


# The Firewood a small tree breaks into: small_tree firewood_per_m a metre of trunk, rounded, within the firewood range (2 to 24).
func _small_firewood(tree: Dictionary, cfg: Dictionary) -> int:
	var small: Dictionary = cfg.get("small_tree", {})
	var span: Array = small.get("firewood", [2, 24])
	return clampi(roundi(float(tree["length"]) * float(small.get("firewood_per_m", 3.0))), int(span[0]), int(span[1]))


# A felled tree's seeds (Dave 14 Nov 2026: "Trees should drop some seeds when cut down. a random number of seeds between 1 and 5 seeds per tree"): [item number,
# count] of its drops.json trunk.felled_seeds by_species seed (every tree's own "<Tree> seed" item, fantasy trees too: Dave 14 Nov 2026), count from felled_seeds.count;
# [] for a species with none. Rolled from the trunk's id like the crown litter; no player, so no luck (world drop).
func _felled_seeds(id: int, tree: Dictionary) -> Array:
	var cfg: Dictionary = (_drops.get("trunk", {}) as Dictionary).get("felled_seeds", {})
	var number: int = table.number_of(str((cfg.get("by_species", {}) as Dictionary).get(str(tree.get("species", "")), "")))

	if number <= 0:
		return []

	var span: Array = cfg.get("count", [1, 5])
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(id) ^ FELLED_SEEDS_SEED
	return [number, rng.randi_range(int(span[0]), int(span[1]))]   # luck-exempt: world drop, no player


const FELLED_SEEDS_SEED := 0x5eed5   # the stream of a felled tree's seed roll (its own, so the crown litter's rolls stay what they were)


# The felled tree's seeds as one heap in its crown circle (tree.crown, _crown_circle), or at `fallback` for a trunk saved without one: [[number, count, Vector3]] or [].
func _seed_litter(id: int, tree: Dictionary, fallback: Vector3) -> Array:
	var seeds: Array = _felled_seeds(id, tree)

	if seeds.is_empty():
		return []

	var circle: Array = tree.get("crown", [])
	var spot: Vector3 = fallback

	if circle.size() >= 3:
		var rng: RandomNumberGenerator = RandomNumberGenerator.new()
		rng.seed = hash(id) ^ FELLED_SEEDS_SEED ^ 0x1
		var angle: float = rng.randf() * TAU   # luck-exempt: where it lands, no player
		var far: float = sqrt(rng.randf()) * float(circle[2]) * 0.5   # luck-exempt: where it lands, no player
		spot = Vector3(float(circle[0]) + cos(angle) * far, fallback.y, float(circle[1]) + sin(angle) * far)

		if ground_height.is_valid() or ground_now.is_valid():
			var ground: float = _ground_top(spot.x, spot.z)   # a pit's floor, a fill's top (a tree's litter never lands in a tunnel)
			spot.y = ground + 0.1 if not is_nan(ground) else spot.y

	return [[int(seeds[0]), int(seeds[1]), spot]]


# What a felled tree breaks into by itself is its feller's gathering, once (Dave 14 Nov 2026: "gathering counts when you pick it or cut it down or
# harvest something by your own hand"): the logs, and the crown's sticks and leaves, bark, seeds and roots that land on the ground (goal got: counter).
# `landed`: item number -> count. shortcut: each item is its own _goal_got (and goal check); a split lays a handful of kinds, so that stays cheap.
func _credit_feller(feller_peer: Variant, landed: Dictionary) -> void:
	if feller_peer == null:
		return

	for number in landed:
		_goal_got(int(feller_peer), int(number), int(landed[number]))


# The branches of a felled tree with no crown litter (drops.json trunk.branch, rolled once per branch_blows), with the leaves sized to the crown (Dave 10 Nov 2026: "everyone
# should be giving me hundreds"): trunk.crown_leaves.per_m leaves per metre of tree, shared over the branch blows. A bare broadleaf in winter (Cover.DECIDUOUS,
# the season where it lies) and the species in crown_leaves.fixed (the conifers) give sticks only.
func _branch_rows(tree: Dictionary, cfg: Dictionary, at: Vector3) -> Array:
	var branch: Array = cfg.get("branch", [])
	var crown: Dictionary = cfg.get("crown_leaves", {})

	if crown.is_empty():
		return branch

	var leafy: bool = _crown_leafy(tree, cfg, at)
	var per_m: Array = crown.get("per_m", [8, 12])
	var share: float = float(tree.get("length", 0.0)) / float(maxi(int(cfg.get("branch_blows", 3)), 1))
	var rows: Array = []

	for row in branch:
		if str(row[0]) != "leaves":
			rows.append(row)
		elif leafy:
			rows.append(["leaves", maxi(roundi(float(per_m[0]) * share), 1), maxi(roundi(float(per_m[1]) * share), 1)])

	return rows


# Whether a felled crown has leaves to give: not a conifer (crown_leaves.fixed) and not a broadleaf bare in winter where it lies.
func _crown_leafy(tree: Dictionary, cfg: Dictionary, at: Vector3) -> bool:
	var species: String = str(tree.get("species", ""))

	if ((cfg.get("crown_leaves", {}) as Dictionary).get("fixed", []) as Array).has(species):
		return false

	return not (CoverScript.is_deciduous(species) and CoverScript.leafless_for(str(season_at.call(at)) if season_at.is_valid() else _season()))   # starter-calendar: the fallback with no season_at (tests)


# A felled crown's sticks and leaves (Dave 10 Nov 2026: "drop like 30 sticks and a hundred leaves all over the forest floor in that circle"), as
# [item number, count, Vector3] rows spread over the circle it landed on (tree.crown, see _crown_circle): trunk.crown_scatter sticks_per_m and
# leaves_per_m per metre of tree, each over `spots` little heaps. Sticks only from a conifer or a bare winter broadleaf. Empty for a trunk without a
# crown circle (saved before it): it keeps the branch rows. Rolled from the trunk's id; no player, so no luck (world drop).
func _crown_litter(id: int, tree: Dictionary, cfg: Dictionary, at: Vector3) -> Array:
	var scatter: Dictionary = cfg.get("crown_scatter", {})
	var circle: Array = tree.get("crown", [])

	if scatter.is_empty() or circle.size() < 3:
		return []

	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(id) ^ 104729
	var length: float = float(tree.get("length", 0.0))
	var sticks: Array = scatter.get("sticks_per_m", [1.6, 2.4])
	var leaves: Array = scatter.get("leaves_per_m", [5.5, 8.0])
	var spots: Dictionary = scatter.get("spots", {})
	var lots: Array = [["stick", roundi(rng.randf_range(float(sticks[0]), float(sticks[1])) * length)]]   # luck-exempt: world drop, no player

	if _crown_leafy(tree, cfg, at):
		lots.append(["leaves", roundi(rng.randf_range(float(leaves[0]), float(leaves[1])) * length)])   # luck-exempt: world drop, no player

	var rows: Array = []

	for lot in lots:
		var total: int = int(lot[1])
		var number: int = table.number_of(str(lot[0]))

		if total <= 0 or number <= 0:
			continue

		var heaps: int = clampi(int(spots.get(str(lot[0]), 6)), 1, total)

		for k in range(heaps):
			var angle: float = rng.randf() * TAU   # luck-exempt: where it lands, no player
			var far: float = sqrt(rng.randf()) * float(circle[2])   # luck-exempt: where it lands, no player
			var x: float = float(circle[0]) + cos(angle) * far
			var z: float = float(circle[1]) + sin(angle) * far
			var y: float = at.y

			if ground_height.is_valid() or ground_now.is_valid():   # on the ground where it lands, not at the stump's height (a slope), as dug and filled
				var ground: float = _ground_top(x, z)
				y = ground + 0.1 if not is_nan(ground) else y

			rows.append([number, floori(float(total) / float(heaps)) + (1 if k < total % heaps else 0), Vector3(x, y, z)])

	return rows


const EXTRA_ROWS_SEED := 0x2f6e2b1   # the stream of a felled tree's extra by_species rows (_trunk_extras)


# The Tree sap every felled softwood tree gives, large or small (Dave 16 Nov 2026; wood_species.json tree_sap.felled), as [[item number, count]], or [].
func _felled_sap(tree: Dictionary) -> Array:
	var number: int = table.number_of(str(table.tree_sap.get("item", "")))
	var count: int = int(table.tree_sap.get("felled", 0))
	return [[number, count]] if number > 0 and count > 0 and table.is_softwood_species(str(tree.get("species", ""))) else []


# The Tree sap the craft at the head of a queue entry earns (Dave 16 Nov 2026: processing softwood logs into anything gives it): per_softwood_log for each
# softwood log this one craft used up. Crafts finish in queue order and use the taken rows from the front (_refund_entry gives the unfinished ones back
# from the end), so this craft's units follow the ones the finished crafts used. entry[1] is the crafts still owed, this one included.
func _craft_sap(entry: Array) -> int:
	var per_log: int = int(table.tree_sap.get("per_softwood_log", 0))
	var logs: int = 0

	for need in entry[2]:
		var rows: Array = need[2] if need.size() > 2 else []
		var total: int = 0

		for unit in rows:
			total += int(unit[3]) if unit.size() > 3 else 1

		var skip: int = maxi(total - int(need[1]) * int(entry[1]), 0)
		var want: int = int(need[1])

		for unit in rows:
			var n: int = int(unit[3]) if unit.size() > 3 else 1
			var passed: int = mini(skip, n)
			skip -= passed
			var used: int = mini(want, n - passed)
			want -= used

			if used > 0 and table.is_softwood_log(int(unit[0])):
				logs += used

			if want <= 0:
				break

	return logs * per_log if per_log > 0 else 0


# The bark a felled trunk of `species` gives once, as [item number, count], or [] for a species that gives none: drops.json trunk "bark_species" names them,
# and the amount is that species' harvest_yield row (oak: Tannin bark; GOALS-REPAIR GA-01, A-2). A standing tree is never stripped: E on it is not offered.
func _bark_row(cfg: Dictionary, species: String) -> Array:
	if not (cfg.get("bark_species", []) as Array).has(species):
		return []

	var row: Dictionary = (_drops.get("harvest_yield", {}) as Dictionary).get(species, {})
	var number: int = table.number_of(str(row.get("item", "")))
	return [number, int(row.get("count", 0))] if number > 0 and int(row.get("count", 0)) > 0 else []


# What a large felled tree gives besides its `logs` whole logs, as [item number, count] rows (_fall_pieces): the branches' sticks and leaves (when it has no crown
# litter), then per log the bark (or thatch) and seed rolls, the species rows, its own bark once and the root ball. Rolled from `id`; no player, so no luck (world drops).
func _trunk_extras(id: int, tree: Dictionary, logs: int, cfg: Dictionary, at: Vector3, with_branches: bool = true) -> Array:
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(id) ^ 7919
	var species: String = str(tree.get("species", ""))
	var totals: Dictionary = {}
	var branch: Array = _branch_rows(tree, cfg, at) if with_branches else []

	for blow in range(int(cfg.get("branch_blows", 3))):
		for row in branch:
			var n: int = table.number_of(str(row[0]))
			totals[n] = int(totals.get(n, 0)) + rng.randi_range(int(row[1]), int(row[2]))   # luck-exempt: world drop, no player

	var thatch_bark: Dictionary = (cfg.get("thatch_bark", {}) as Dictionary).get(species, {})
	var own: Array = cfg.get("by_species", {}).get(species, [])

	for k in range(logs):
		if not thatch_bark.is_empty():
			if rng.randf() < float(thatch_bark.get("chance", 0.3)):   # luck-exempt: world drop, no player
				var span: Array = thatch_bark.get("count", [2, 4])
				var t: int = table.number_of("thatch")
				totals[t] = int(totals.get(t, 0)) + rng.randi_range(int(span[0]), int(span[1]))   # luck-exempt: world drop, no player
		elif rng.randf() < float(cfg.get("bark_chance", 0.3)):   # luck-exempt: world drop, no player
			var b: int = table.number_of("bark")
			totals[b] = int(totals.get(b, 0)) + 1

		if rng.randf() < float(cfg.get("seed_chance", 0.15)):   # luck-exempt: world drop, no player
			var sn: int = table.number_of("seed_bundle") if own.is_empty() else table.number_of(str(own[0][0]))
			totals[sn] = int(totals.get(sn, 0)) + (1 if own.is_empty() else rng.randi_range(int(own[0][1]), int(own[0][2])))   # luck-exempt: world drop, no player

	var extra_rng: RandomNumberGenerator = RandomNumberGenerator.new()   # the rows after the first (willow withies, Scots pine tar) roll on their own stream, so the rolls above stay what they were
	extra_rng.seed = rng.seed ^ EXTRA_ROWS_SEED

	for k in range(logs):
		for row in own.slice(1):
			if extra_rng.randf() < float(cfg.get("seed_chance", 0.15)):   # luck-exempt: world drop, no player
				var xn: int = table.number_of(str(row[0]))
				totals[xn] = int(totals.get(xn, 0)) + extra_rng.randi_range(int(row[1]), int(row[2]))   # luck-exempt: world drop, no player

	var stripped: Array = _bark_row(cfg, species)   # the trunk's own bark, once (GOALS-REPAIR GA-01)

	if not stripped.is_empty():
		totals[int(stripped[0])] = int(totals.get(int(stripped[0]), 0)) + int(stripped[1])

	var roots: Array = cfg.get("roots", [])

	if not roots.is_empty():
		var r: int = table.number_of(str(roots[0]))
		totals[r] = int(totals.get(r, 0)) + rng.randi_range(int(roots[1]), int(roots[2]))   # luck-exempt: world drop, no player

	var rows: Array = []

	for n in totals:
		if int(n) > 0 and int(totals[n]) > 0:
			rows.append([int(n), int(totals[n])])

	return rows


# A stump has rotted away: maybe a sapling grows near a standing tree of the same species. The dice come from the seed and the spot,
# so a restart gives the same answer.
func _maybe_sapling(stump: Dictionary, planted_at: float = -1.0) -> void:
	if not standing_near.is_valid() or not (ground_height.is_valid() or ground_now.is_valid()):
		return

	var tree: Dictionary = stump["tree"]
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(Vector3i(int(stump["pos"].x), int(stump["pos"].z), world_seed))

	if rng.randf() > RESPAWN_CHANCE:   # luck-exempt: world regrowth, no player
		return

	var near: Array = standing_near.call(str(tree["species"]), stump["pos"], RESPAWN_RADIUS_M)

	if near.is_empty():
		return

	var angle: float = rng.randf() * TAU   # luck-exempt: world regrowth, no player
	var spot: Vector3 = near[0] + Vector3(cos(angle), 0.0, sin(angle)) * rng.randf_range(2.0, RESPAWN_PLACE_M)   # luck-exempt: world regrowth, no player
	var ground: float = _ground_top(spot.x, spot.z)   # in a dug pit or on a fill, not in the air over it
	var species_entry: Dictionary = _flora_by_name.get(str(tree["species"]), {})

	if is_nan(ground) or ground < 1.0 or species_entry.is_empty():
		return

	if spawn_blocked(spot.x, spot.z):
		return   # nothing regrows near what players put down (no_spawn_m)

	var home: Vector2i = Vector2i(int(floor(spot.x / FLORA_CHUNK_M)), int(floor(spot.z / FLORA_CHUNK_M)))
	var used: Dictionary = {}

	for sapling in _saplings:
		if sapling["chunk"] == [home.x, home.y]:
			used[sapling["slot"]] = true

	if used.size() >= SAPLINGS_PER_CHUNK:
		return

	var slot: int = 0

	while used.has(slot):
		slot += 1

	spot.y = ground
	_saplings.append({"slot": slot, "chunk": [home.x, home.y], "species": int(species_entry["id"]), "pos": spot, "planted_at": planted_at if planted_at >= 0.0 else (float(game_seconds.call()) if game_seconds.is_valid() else 0.0)})
	_dirty = true

	if flora_changed.is_valid():
		flora_changed.call(home)


# Saplings and grown trees of a flora chunk as flora items (ids, positions, heights, yaws), the
# way the placer lists trees, so the flora view and the cover index treat them as trees. The
# size comes from the age now (computed here, nothing runs per frame). {} when there are none.
func dynamic_items(home: Vector2i) -> Dictionary:
	var result: Dictionary = {}
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for sapling in _saplings:
		if sapling["chunk"] != [home.x, home.y]:
			continue

		if result.is_empty():
			result = {"ids": PackedInt32Array(), "positions": PackedVector3Array(), "heights": PackedFloat32Array(), "yaws": PackedFloat32Array()}

		result["ids"].append((int(sapling["species"]) << 16) | (0xFFFF - int(sapling["slot"])))
		result["positions"].append(sapling["pos"])
		result["heights"].append(_sapling_height(sapling, now_s))
		result["yaws"].append(float(hash(sapling["pos"]) % 628) / 100.0)

	return result


func _sapling_height(sapling: Dictionary, now_s: float) -> float:
	var entry: Dictionary = _flora_by_id.get(int(sapling["species"]), {})
	var full: float = float(entry["height_m"][0]) if not entry.is_empty() else 8.0
	var age: float = now_s - float(sapling["planted_at"])

	if age >= SAPLING_GROWN_S:
		return full

	if age >= SAPLING_YOUNG_S:
		return full * lerpf(0.4, 0.9, (age - SAPLING_YOUNG_S) / (SAPLING_GROWN_S - SAPLING_YOUNG_S))

	return maxf(full * 0.4 * age / SAPLING_YOUNG_S, 0.5)


# A grown tree of the dynamic kind as tree_info answers for placer trees, or {} (saplings and
# young trees cannot be felled, and there is no such id).
func dynamic_tree_info(home: Vector2i, id: int) -> Dictionary:
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for sapling in _saplings:
		if sapling["chunk"] == [home.x, home.y] and ((int(sapling["species"]) << 16) | (0xFFFF - int(sapling["slot"]))) == id:
			if now_s - float(sapling["planted_at"]) < SAPLING_GROWN_S:
				return {}

			var entry: Dictionary = _flora_by_id.get(int(sapling["species"]), {})

			if str(entry.get("kind", "tree")) != "tree":
				return {}   # a planted bush is not a tree to fell (shrub_info finds it)

			var span: Array = entry.get("height_m", [])
			var ref_height: float = 0.5 * (float(span[0]) + float(span[1])) if span.size() >= 2 else 0.0
			return {"name": str(entry.get("name", "")), "position": sapling["pos"], "height": _sapling_height(sapling, now_s), "trunk": float(entry.get("trunk_m", 0.4)), "ref_height": ref_height, "broadleaf": str(entry.get("shape", "")) == "broadleaf", "dynamic": true, "id": id}

	return {}


# A split log's girth against the drawn species log (only species logs: the plain Log has its own small mesh).
func _log_girth(log_n: int, radius: float) -> float:
	return radius / LOG_MESH_RADIUS_M if table.id_of(log_n).begins_with("log_") else NAN


# The extra row fields of a loose item: its turn and a split log's girth.
func _loose_extra(it: Dictionary) -> Dictionary:
	var extra: Dictionary = {}

	if it.has("rot_y"):
		extra["rot_y"] = float(it["rot_y"])

	if it.has("girth"):
		extra["girth"] = float(it["girth"])

	if it.has("tilt"):
		extra["tilt"] = float(it["tilt"])   # an arrow stuck in a tree: drawn where it is, along its flight

	if it.has("pitch") or it.has("spin"):
		extra["pitch"] = float(it.get("pitch", 0.0))   # a log as physics left it (lying_logs.gd basis_of)
		extra["spin"] = float(it.get("spin", 0.0))

	if it.has("fall"):   # a piece of a tree coming down: [hinge x, y, z, fall yaw, seconds left]; the client swings it down round the stump (inventory_view._swing_down)
		var fall: Dictionary = it["fall"]
		var hinge: Vector3 = fall["hinge"]
		extra["fall"] = [hinge.x, hinge.y, hinge.z, float(fall["yaw"]), maxf(float(fall["left"]), 0.0)]

	return extra


# A planted bush or shrub (dynamic flora) as shrub_info gives it, or {}.
func dynamic_shrub_info(home: Vector2i, id: int) -> Dictionary:
	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0

	for sapling in _saplings:
		if sapling["chunk"] == [home.x, home.y] and ((int(sapling["species"]) << 16) | (0xFFFF - int(sapling["slot"]))) == id:
			var entry: Dictionary = _flora_by_id.get(int(sapling["species"]), {})

			if str(entry.get("kind", "")) != "shrub":
				return {}

			return {"name": str(entry.get("name", "")), "position": sapling["pos"], "height": _sapling_height(sapling, now_s), "dynamic": true}

	return {}


# Bushes and shrubs (Dave 2 Nov 2026, hazel too). An axe chops one up into leaves and sticks (drops.json shrub_work axe_blows, axe_gives); a pickaxe
# digs it up whole as <species>_bush, to plant again elsewhere (_plant_bush). Either way the bush is gone from the world.
func _hit_shrub(peer: int, inv, flora_id: int, chunk: Vector2i, held_slot: int) -> void:
	if not _peer_pos.has(peer) or not shrub_info.is_valid() or not cut_tree.is_valid():
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_hit.get(peer, -100000)) < HIT_COOLDOWN_MS:
		return

	var slot: int = _held_tool(inv, held_slot, "pick")   # the tool in hand: a pick digs the bush up, an axe chops it
	var pick: bool = slot >= 0

	if slot < 0:
		slot = _held_tool(inv, held_slot, "axe")

	if slot < 0:
		_say_hands_full(peer, inv)
		_reject(peer, 1)
		return

	var info: Dictionary = shrub_info.call(chunk, flora_id)

	if info.is_empty():
		return

	var spot: Vector3 = info["position"]

	if Vector2(_peer_pos[peer].x - spot.x, _peer_pos[peer].z - spot.z).length() > HIT_REACH_M + 1.0:
		_reject_far(peer)
		return

	var cfg: Dictionary = _drops.get("shrub_work", {})
	var dug_id: String = str(info["name"]) + str(cfg.get("dig_suffix", "_bush"))

	if pick and table.number_of(dug_id) == 0:
		_say(peer, "That one will not come up whole.")
		return

	if pick and _fit(peer, inv, table.number_of(dug_id), 1) == 0:
		_say(peer, "Too heavy to carry any more")
		_reject(peer, 2)
		return

	_last_hit[peer] = now
	_wear_slot(peer, inv, slot, "shrub")
	var key: String = "s%s,%d,%d,%d" % ["p" if pick else "a", chunk.x, chunk.y, flora_id]
	var chop: Dictionary = _chops.get(key, {"hits": 0, "msec": now})

	if now - int(chop["msec"]) > CHOP_RESET_MS:
		chop["hits"] = 0

	chop["hits"] = int(chop["hits"]) + 1
	chop["msec"] = now
	_chops[key] = chop

	if int(chop["hits"]) < int(cfg.get("pick_blows" if pick else "axe_blows", 2)):
		return

	_chops.erase(key)

	if not bool(cut_tree.call(chunk, flora_id)):
		return

	if pick:
		give(peer, table.number_of(dug_id), 1)
		return

	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash(key) ^ now

	for row in cfg.get("axe_gives", []):
		give(peer, table.number_of(str(row[0])), roll_amount(peer, rng, int(row[1]), int(row[2])))


# Planting a dug-up bush (<species>_bush) at `at`, the ground under the crosshair: it grows there as a full bush (dynamic flora, saved with the saplings).
func _plant_bush(peer: int, inv, slot: int, at: Vector3) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer):
		return

	var item_id: String = table.id_of(inv.numbers[slot])

	if _flora_of_plant(item_id).is_empty():
		return

	if Vector2(_peer_pos[peer].x - at.x, _peer_pos[peer].z - at.z).length() > PLANT_BUSH_REACH_M:
		_reject_far(peer)
		return

	var edits: Array = (edits_near.call(at, 4.0) if edits_near.is_valid() else []) as Array
	var dug: float = _edited_height(at.x, at.z, edits) if ground_height.is_valid() else at.y   # the ground as dug and filled
	var in_cave: bool = float(_peer_pos[peer].y) < dug - 0.05   # the cave floor only for a player standing under the ground there (the aim's height is the client's word)
	var spot: Vector3 = Vector3(at.x, _cave_ground(at, dug) if in_cave and ground_height.is_valid() else dug, at.z)
	var why: String = _sapling_refusal(item_id, spot)

	if tree_seed_species(item_id) != "" and dug - spot.y > 1.0:
		why = "A tree needs open sky: it cannot grow in a cave."   # a bush fits under the roof; a tree would grow through it (this reason first)

	if why != "":
		_say(peer, why)
		return

	inv.take_from_slot(slot, 1)
	_plant_sapling(peer, item_id, spot)


# The flora row a plantable item grows into: a dug-up bush's shrub, a tree seed's tree; {} when the item is neither.
func _flora_of_plant(item_id: String) -> Dictionary:
	var suffix: String = str(_drops.get("shrub_work", {}).get("dig_suffix", "_bush"))
	var tree_species: String = tree_seed_species(item_id)   # a tree's seed goes in as a sapling that grows (gardening, 14 Nov 2026)
	var entry: Dictionary = _flora_by_name.get(tree_species if tree_species != "" else item_id.trim_suffix(suffix), {})

	if tree_species == "" and (not item_id.ends_with(suffix) or entry.is_empty() or str(entry.get("kind", "")) != "shrub"):
		return {}

	if tree_species != "" and (entry.is_empty() or str(entry.get("kind", "")) != "tree"):
		return {}

	return entry


# Why a bush or tree seed cannot go into the ground at `spot` (its height the ground's), "" when it can.
func _sapling_refusal(item_id: String, spot: Vector3) -> String:
	if _season_of(spot) == "winter":
		return "The ground is frozen hard: nothing can be planted in winter."   # the hoe's list greys it out too (FarmRules.plantable_now)

	var gap: float = PLANT_TREE_GAP_M if tree_seed_species(item_id) != "" else PLANT_BUSH_GAP_M

	if is_nan(spot.y) or spot.y < 1.0:
		return "The ground is too wet here."

	if _spawn_zones.kind_near(spot.x, spot.z, PLANT_PATH_GAP_M, _items, "path_patch"):
		return "Nothing grows on a trodden path."   # Dave's play test 24 Nov 2026: a tree stood on a path (_path_tree)

	if water_depth_at.is_valid() and float(water_depth_at.call(spot)) >= PlacementRules.FIRE_WATER_BLOCK_M:
		return "You cannot plant it in water."

	var home: Vector2i = Vector2i(int(floor(spot.x / FLORA_CHUNK_M)), int(floor(spot.z / FLORA_CHUNK_M)))
	var used: int = 0

	for sapling in _saplings:
		if sapling["chunk"] == [home.x, home.y]:
			used += 1

			if (sapling["pos"] as Vector3).distance_to(spot) < gap:
				return "Too close to another plant."

	return "Too many young plants here." if used >= SAPLINGS_PER_CHUNK else ""


# A bush or tree seed (already taken) goes into the ground at `spot`.
func _plant_sapling(peer: int, item_id: String, spot: Vector3) -> void:
	var entry: Dictionary = _flora_of_plant(item_id)
	var tree_species: String = tree_seed_species(item_id)
	var home: Vector2i = Vector2i(int(floor(spot.x / FLORA_CHUNK_M)), int(floor(spot.z / FLORA_CHUNK_M)))
	var used: Dictionary = {}

	for sapling in _saplings:
		if sapling["chunk"] == [home.x, home.y]:
			used[sapling["slot"]] = true

	var new_slot: int = 0

	while used.has(new_slot):
		new_slot += 1

	var now_s: float = float(game_seconds.call()) if game_seconds.is_valid() else 0.0
	_saplings.append({"slot": new_slot, "chunk": [home.x, home.y], "species": int(entry["id"]), "pos": spot, "planted_at": now_s if tree_species != "" else now_s - SAPLING_GROWN_S})   # a dug bush goes in full size; a seed starts as a sapling and grows like wild regrowth
	_dirty = true

	if tree_species == "":   # a tree seed is not a replanted bush (no goal counts tree planting yet)
		_goal_event(peer, "bush_replanted")   # ADD-07: a dug-up bush (only digging gives a <species>_bush) planted again

	if flora_changed.is_valid():
		flora_changed.call(home)


# The tree species whose seed `item_id` is (drops.json trunk.felled_seeds by_species: each tree's own "<Tree> seed" item), "" for none. The
# first species listed for an item wins (each seed is one species' today).
func tree_seed_species(item_id: String) -> String:
	var by: Dictionary = ((_drops.get("trunk", {}) as Dictionary).get("felled_seeds", {}) as Dictionary).get("by_species", {})

	for species in by:
		if str(by[species]) == item_id:
			return str(species)

	return ""


# A grown dynamic tree was felled: the record goes. True if there was one.
func remove_dynamic(home: Vector2i, id: int) -> bool:
	for sapling in _saplings:
		if sapling["chunk"] == [home.x, home.y] and ((int(sapling["species"]) << 16) | (0xFFFF - int(sapling["slot"]))) == id:
			_saplings.erase(sapling)
			_dirty = true

			if flora_changed.is_valid():
				flora_changed.call(home)

			return true

	return false


func peers_near(position: Vector3, radius: float) -> Array:
	var out: Array = []

	for peer in _peer_pos:
		if _peer_pos[peer].distance_to(position) <= radius:
			out.append(peer)

	return out


# Splits `count` off a stack into the backpack's first empty slot; a full pack grows a step for it (protocol 116). The stack keeps at least one.
func _split(inv, slot: int, count: int, peer: int = -1) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or count < 1 or count >= inv.counts[slot]:
		return

	var target: int = inv.make_room()

	if target < 0:
		_say(peer, "Your pack has no free slot to split into.")
		return

	inv.numbers[target] = inv.numbers[slot]
	inv.inst[target] = inv.inst[slot].duplicate(true)   # each unit of an instance stack carries it, so both halves keep it
	inv.counts[target] = count
	inv.counts[slot] -= count
	inv.set_fav(target, inv.is_fav(slot))   # both halves of a favourite stay favourites


# --- Fire tiers (Dave 24 Oct, cooking.json fire_tiers): the wood in a fire is kept as burning seconds per class (log, firewood, weak),
# burn_left is their sum. The biggest wood burns first; 3 pieces of a class lift the fire to its tier and it keeps that size until
# that wood is gone. A lit fire's world-item state is its tier (40 survival, 1 campfire, 41 bonfire).
static func fire_is_lit(state: int) -> bool:
	return state == 1 or state == FIRE_STATE_SURVIVAL or state == FIRE_STATE_BONFIRE


# A lit fire's tier for its look: 1 survival (40), 2 campfire (1), 3 bonfire (41), as the client's inventory_view._fire_tier.
static func fire_tier_of(state: int) -> int:
	return 1 if state == FIRE_STATE_SURVIVAL else (3 if state == FIRE_STATE_BONFIRE else 2)


# The tier of the lit fire `id` (1 small, 2 medium, 3 large), 0 when it is not a lit fire.
func _lit_tier_at(id: int) -> int:
	var fire: Dictionary = _items.get(id, {}).get("fire", {})
	return fire_tier_of(int(fire["state"])) if not fire.is_empty() and fire_is_lit(int(fire["state"])) else 0


# A player action took the fire `id` up from tier `before` (0: not burning): each tier newly reached from medium up is a goal event, so a fire
# lit straight to large credits medium too (GOALS-REPAIR F4). Each tier is credited at most once per character, so a fire that burned down and is
# lifted again through the store window cannot farm it. Called only after player actions: burning down credits nothing.
func _goal_fire_tier(peer: int, id: int, before: int) -> void:
	var counts: Dictionary = _goal_state_of(peer).get("goal_counts", {})

	for tier in range(maxi(before, 1) + 1, _lit_tier_at(id) + 1):
		var what: String = ["small", "medium", "large"][tier - 1]

		if int(counts.get(_goal_count_key("fire_tier", what), 0)) == 0:
			_goal_event(peer, "fire_tier", what)


# Far campfire smoke (TEST-011, Dave approved 13 Nov 2026: smoke seen up to 2 km so a camp can be found from a hill): the lit campfires
# farther than NEAR_M (closer ones come whole with world_items) and within far_m of `at`, nearest first, at most `count`, as
# [positions, tiers] (protocol 114 far_fires). From the last world sync (at most SYNC_EVERY_S old).
func far_fires_near(at: Vector3, far_m: float = FAR_FIRE_M, count: int = FAR_FIRE_COUNT) -> Array:
	var rows: Array = []

	for fire in _far_fire_spots:
		var d: float = (fire[0] as Vector3).distance_to(at)

		if d > NEAR_M - FAR_OVERLAP_M and d <= far_m:
			rows.append([d, fire[0], fire[1]])

	rows.sort_custom(func(p: Array, q: Array) -> bool: return float(p[0]) < float(q[0]))
	var points: PackedVector3Array = PackedVector3Array()
	var tiers: PackedByteArray = PackedByteArray()

	for row in rows.slice(0, count):
		points.append(row[1])
		tiers.append(int(row[2]))

	return [points, tiers]


func _fire_wood(fire: Dictionary) -> Dictionary:
	if not fire.has("wood"):
		var all: float = maxf(float(fire.get("burn_left", 0.0)), 0.0)
		fire["wood"] = {"log": 0.0, "firewood": all if int(fire.get("state", 0)) == 1 else 0.0, "weak": 0.0 if int(fire.get("state", 0)) == 1 else all}

	return fire["wood"]


# How many pieces of a wood class the fire holds: the pieces laid on it (fire["pieces"], one each however long it burns, so a soft firewood counts like a hard one),
# never more than the burning time left allows at the shortest piece of that class (piece_game_s).
func _fire_class_pieces(cls: String, seconds: float, laid: int = -1) -> int:
	var row: Dictionary = (_cooking.get("fire_tiers", {}) as Dictionary).get(cls, {})
	var piece_s: float = float((_cooking.get("piece_game_s", {"log": 259200.0, "firewood": 14400.0, "weak": 1440.0}) as Dictionary).get(cls, 1440.0)) / GAME_RATE
	var by_time: int = int(ceil(seconds / piece_s - 0.0001)) if seconds > 0.0 and not row.is_empty() else 0
	return by_time if laid < 0 else mini(by_time, laid)


# The lit state the wood now in the fire supports: the biggest class with at least min_pieces, else the survival fire.
func _fire_best_state(fire: Dictionary, wet_counts: bool = true) -> int:
	var wood: Dictionary = _fire_wood(fire)
	var need: int = int(_cooking.get("min_pieces", 3))
	var best: int = FIRE_STATE_SURVIVAL

	for cls in ["log", "firewood"]:
		var laid: int = int((fire.get("pieces", {}) as Dictionary).get(cls, -1))

		if _fire_class_pieces(cls, float(wood[cls]), laid) >= need:
			if cls == "log" and bool(fire.get("pot", false)):
				best = int(_cooking["fire_tiers"]["firewood"]["state"])   # a campfire pot hangs over this fire: it never grows past the firewood stage
			else:
				best = int(_cooking["fire_tiers"][cls]["state"])

			break

	if wet_counts and _fire_damp(fire):   # wet wood in it (fire design 5): the heat and light of one tier lower until it is dry
		return FIRE_STATE_SURVIVAL if best == 1 else (1 if best == FIRE_STATE_BONFIRE else best)

	return best


# The lit state after the wood in a burning fire changed (a piece put in, its store closed). Dave 2 Nov 2026: three pieces lift the fire a tier and
# it STAYS at that tier until that wood is gone, then drops to the next class with at least three pieces. So a recount never lowers the tier
# while wood of the tier's class is still burning (two of three logs left is still a bonfire); only a hung pot does (_refresh_pots).
func _fire_restate(fire: Dictionary) -> int:
	var state: int = int(fire["state"])
	var best: int = _fire_best_state(fire)

	if not fire_is_lit(state) or state == FIRE_STATE_SURVIVAL or _fire_tier_of_state(best) >= _fire_tier_of_state(state):
		return best

	if state == FIRE_STATE_BONFIRE and bool(fire.get("pot", false)):
		return best

	return state if float(_fire_wood(fire).get(_fire_class_of_state(state), 0.0)) > 0.0 else best


# A structure kind as it is called now (old saves keep their old name: the tripod pot is the campfire pot).
func _kind_now(kind: String) -> String:
	if _structures.has(kind) and _structures[kind].has("becomes"):
		return str(_structures[kind]["becomes"])   # a retired piece whose save loads as another (a Wooden - Pipe elbow or tee: a 2 m pipe run)

	if _structures.has(kind):
		return kind

	for name in _structures:
		if (_structures[name].get("legacy_kinds", []) as Array).has(kind):
			return str(name)

	return kind


func _is_pot(it: Dictionary) -> bool:
	return it.has("struct") and str(_structures.get(str(it["struct"]["kind"]), {}).get("attach_to", "")) == "fire"


# The fire a pot at this spot hangs over, or -1.
func _fire_under_pot(pos: Vector3) -> int:
	for id in _items:
		if _items[id].has("fire") and not _items[id]["fire"].has("marks") and (_items[id]["pos"] as Vector3).distance_to(pos) <= POT_ON_FIRE_M:
			return id

	return -1


# Sets fire["pot"] (not saved: the pot's position is the whole link) on every fire. A fire whose pot is gone gets its tier back;
# a fire that was a bonfire when a pot arrived steps down to the firewood stage.
func _refresh_pots() -> void:
	var pots: Array = []

	for id in _tick_list("pots"):
		if _items.has(id) and _is_pot(_items[id]):
			pots.append(_items[id]["pos"])

	for id in _tick_list("fires"):
		if not _items.has(id):
			continue

		var it: Dictionary = _items[id]

		if not it.has("fire"):
			continue

		var fire: Dictionary = it["fire"]
		var hung: bool = false

		for at in pots:
			if (at as Vector3).distance_to(it["pos"]) <= POT_ON_FIRE_M:
				hung = true
				break

		fire["pot"] = hung

		if not fire_is_lit(int(fire["state"])):
			continue

		var best: int = _fire_best_state(fire)
		var state: int = int(fire["state"])

		if hung and state == FIRE_STATE_BONFIRE:
			fire["state"] = best
			_lit_valid = false
		elif not hung and state != FIRE_STATE_BONFIRE and _fire_tier_of_state(best) > _fire_tier_of_state(state):
			fire["state"] = best
			_lit_valid = false


func _fire_class_of_state(state: int) -> String:
	return "log" if state == FIRE_STATE_BONFIRE else ("firewood" if state == 1 else "weak")


func _fire_tier_of_state(state: int) -> int:
	return 3 if state == FIRE_STATE_BONFIRE else (2 if state == 1 else 1)


func _fire_sum(fire: Dictionary) -> void:
	var wood: Dictionary = _fire_wood(fire)
	fire["burn_left"] = float(wood["log"]) + float(wood["firewood"]) + float(wood["weak"])


func _fire_wood_class(wood_id: String) -> String:
	return str((_cooking.get("fuel_class", {}) as Dictionary).get(wood_id, "weak"))


# One piece of wood onto the fire: its seconds go to its class (never past the stored-fuel cap) and a lit fire may step up a tier.
func _fire_add(fire: Dictionary, wood_id: String, wet: int = 0) -> void:
	if wet > 0:
		fire["damp"] = maxi(int(fire.get("damp", 0)), wet)   # a wet piece: the fire holds wet wood until it has dried (_wood_tick)

	var wood: Dictionary = _fire_wood(fire)
	var cls: String = str((_cooking.get("fuel_class", {}) as Dictionary).get(wood_id, "weak"))
	var seconds: float = float((_cooking.get("fuel", {}) as Dictionary).get(wood_id, 900.0)) / GAME_RATE
	_fire_sum(fire)
	wood[cls] = float(wood[cls]) + maxf(seconds, 0.0)   # no cap (Dave 2 Nov 2026): the burn time is the sum of every piece in the fire
	var pieces: Dictionary = fire.get("pieces", {})
	pieces[cls] = int(pieces.get(cls, 0)) + 1
	fire["pieces"] = pieces
	_fire_sum(fire)
	fire["fed"] = int(fire.get("fed", 0)) + 1

	if fire_is_lit(int(fire["state"])):
		var best: int = _fire_best_state(fire)

		if _fire_tier_of_state(best) > _fire_tier_of_state(int(fire["state"])):
			fire["state"] = best


# Time passes on a lit fire: the biggest wood burns; when the wood that set its tier is gone it drops a tier.
func _fire_burn(fire: Dictionary, delta: float) -> void:
	var wood: Dictionary = _fire_wood(fire)
	var left: float = delta

	for cls in ["log", "firewood", "weak"]:
		if left <= 0.0:
			break

		var used: float = minf(float(wood[cls]), left)
		wood[cls] = float(wood[cls]) - used
		left -= used

		if _charcoal_classes().has(cls):
			fire["char"] = float(fire.get("char", 0.0)) + used * GAME_RATE / _charcoal_game_s()   # the charcoal this wood leaves (_fire_leave_charcoal)

		if bool(fire.get("synced", false)) and used > 0.0:   # what has burned since the store was last counted: whole pieces of it leave the store (_fire_trim_store)
			var burnt: Dictionary = fire.get("burnt", {})
			burnt[cls] = float(burnt.get(cls, 0.0)) + used
			fire["burnt"] = burnt

		if float(wood[cls]) <= 0.0 and fire.has("pieces"):
			(fire["pieces"] as Dictionary).erase(cls)

	_fire_sum(fire)
	var state: int = int(fire["state"])

	if fire_is_lit(state) and state != FIRE_STATE_SURVIVAL and float(wood[_fire_class_of_state(state)]) <= 0.0:
		fire["state"] = _fire_best_state(fire)
		_lit_valid = false   # a smaller fire, or out: the vitals' fire list is kept a quarter second now (_vitals_spread)


# --- Charcoal left by burning wood (Dave 17 Nov 2026: "anything that burns wood should leave behind charcoal"; cooking.json charcoal_left) ---
# Wood of the classes in charcoal_left.classes (firewood and logs; sticks and kindling leave none) leaves charcoal by its burning time: one Charcoal
# for each game_s_each game seconds burned (a Firewood 3, a Wooden block 6, a log 27). A fire keeps the part-made lump in fire["char"] (saved); a light
# (fireplace, brazier: structures.json leaves_charcoal) in its struct (not saved).

func _charcoal_game_s() -> float:
	return maxf(float((_cooking.get("charcoal_left", {}) as Dictionary).get("game_s_each", 9600.0)), 1.0)


func _charcoal_classes() -> Array:
	return (_cooking.get("charcoal_left", {}) as Dictionary).get("classes", ["log", "firewood"])


# The whole Charcoal a fire has made go into its own store; what the store has no room for lands on the ground beside it.
func _fire_leave_charcoal(id: int, it: Dictionary, fire: Dictionary) -> void:
	var lumps: int = int(floor(float(fire.get("char", 0.0)) + 0.0001))   # the small margin: three Firewood's sum of burned slices is 9, not 8.9999

	if lumps <= 0:
		return

	fire["char"] = maxf(float(fire["char"]) - float(lumps), 0.0)
	var box = _fire_store(fire)
	var over: int = box.add(table.number_of("charcoal"), lumps)
	_push_box(id, box)

	if over > 0:
		drop_in_world(table.number_of("charcoal"), over, it["pos"] + Vector3(0.6, 0.0, 0.0))

	_dirty = true


# A lit light that burns wood (structures.json leaves_charcoal) leaves its charcoal on the ground at its foot, by the share of its fuel item burned.
func _light_leave_charcoal(it: Dictionary, def: Dictionary, spent: float) -> void:
	var wood_id: String = str(def.get("fuel", ""))
	var wood_s: float = float((_cooking.get("fuel", {}) as Dictionary).get(wood_id, 0.0))

	if wood_s <= 0.0 or not _charcoal_classes().has(_fire_wood_class(wood_id)):
		return

	# The part-made lump is saved with the light (lights.json row [4]), so a restart keeps it.
	var made: float = float(it["struct"].get("char", 0.0)) + spent / maxf(light_burn_s(def), 1.0) * wood_s / _charcoal_game_s()
	var lumps: int = int(floor(made + 0.0001))
	it["struct"]["char"] = maxf(made - float(lumps), 0.0)

	if lumps > 0:
		drop_in_world(table.number_of("charcoal"), lumps, it["pos"])
		_dirty = true


# A cold or laid fire whose store still holds Charcoal is not taken away for charcoal_left.keep_s (the charcoal is left in the fire for the player).
func _fire_keeps_charcoal(fire: Dictionary) -> bool:
	return _chests.has(int(fire.get("uid", 0))) and _chests[int(fire["uid"])].count_of(table.number_of("charcoal")) > 0


# Wood on the fire: a stick or a log adds burning time (no cap). A fire the rain put out
# lights again when fed where rain no longer reaches it (covered, or the rain has stopped).
func _fuel(peer: int, inv, id: int) -> void:
	var fire: Dictionary = _fire_in_reach(peer, id)

	if fire.is_empty():
		return

	_fire_sum(fire)

	var refused_log: bool = false

	for wood in _cooking.get("fuel_order", ["stick", "log"]):
		var number: int = table.number_of(wood)

		if inv.has(number, 1):
			if bool(fire.get("pot", false)) and _fire_wood_class(wood) == "log":
				refused_log = true   # a pot hangs over this fire: no logs, the fire would be too big for it
				continue

			var slot: int = _wettest_slot(inv, number)
			var wet: int = int(inv.wear[slot]) if slot >= 0 else 0

			if bool(fire.get("synced", false)) and _chests.has(int(fire.get("uid", 0))):
				if _chests[int(fire["uid"])].add(number, 1, wet, inv.inst_of(slot)) > 0:   # the store is what burns: the piece goes into it; a full store keeps it in the pack
					_say(peer, "The fire's store is full.")
					return

				inv.take_from_slot(slot, 1)
				_fire_apply_store(fire, _chests[int(fire["uid"])])
				fire["fed"] = int(fire.get("fed", 0)) + 1   # the row is sent again (the inspection label's burn time)

				if fire_is_lit(int(fire["state"])):
					fire["state"] = _fire_restate(fire)
			else:
				inv.take_from_slot(slot, 1)
				_fire_add(fire, wood, wet)

			# Wood laid in an unlit fire only loads it; Press E to light comes next (ACT_LIGHT).
			if int(fire["state"]) == 8:
				fire["state"] = 9
				_items[id]["left"] = FIRE_LAID_S

			return

	if refused_log:
		_say(peer, "Take the pot down before you put logs on. The fire would be too big for it.")
	else:
		_say(peer, "You have no wood, sticks or logs to put on the fire.")


# Lighting a loaded fire (Dave 5 Nov 2026, simplified): any wood in the fire is enough, E lights it, and no starter (plant fibre, tinder, kindling)
# is needed or used up. Every kind of wood goes in: sticks, kindling, tinder, firewood, blocks, logs. An open fire will not take while it rains.
func _light(peer: int, inv, id: int) -> void:
	var fire: Dictionary = _fire_in_reach(peer, id)

	if fire.is_empty() or (int(fire["state"]) != 9 and int(fire["state"]) != FIRE_STATE_ASH):
		return

	if float(fire["burn_left"]) <= 0.0:
		_say(peer, "Put sticks or wood on the fire first (F), then light it.")
		return

	# Warm ash (docs/design/fire_coals_design.md 3): wood and a tinder item light it at once, with no damp roll, and the tinder is used up.
	# Without tinder it lights like a cold laid fire.
	if int(fire["state"]) == FIRE_STATE_ASH and _use_tinder(fire, inv):
		fire["state"] = _fire_best_state(fire)
		fire.erase("wet_s")
		_items[id]["left"] = 1.0e9
		_lit_valid = false
		_dirty = true
		_say(peer, "The tinder catches on the warm ash.")
		return

	var rain_now_v: float = _rain_here(_items[id]["pos"] if _items.has(id) else _peer_pos.get(peer, Vector3.ZERO))
	var raining: bool = rain_now_v >= RAIN_PUTS_OUT

	var rain_cfg: Dictionary = _cooking.get("rain_light_chance", {})

	# Dave 5 Nov 2026: an open fire does light in the rain, but the rain puts it out again after a few seconds (RAIN_LIGHT_GRACE_S).
	if raining and not bool(fire["covered"]):
		fire["rain_grace"] = RAIN_LIGHT_GRACE_S
		_say(peer, "It catches, but the rain will put it out in a moment. Move it under cover.")
	else:
		# A drizzle makes lighting a gamble (cooking.json rain_light_chance); kindling that is all wet halves the chance (wet_wood.light_x) unless
		# there is dry tinder in the fire (fire design 5).
		var chance: float = 1.0
		var wet_kindling: bool = _fire_wet_kindling(fire)

		if rain_now_v > 0.02 and not bool(fire["covered"]):
			chance = maxf(1.0 - rain_now_v / maxf(float(rain_cfg.get("puts_out", 0.2)), 0.01) * float(rain_cfg.get("loss", 0.8)), float(rain_cfg.get("min_chance", 0.2)))

		if wet_kindling:
			chance *= float(table.wet_wood().get("light_x", 0.5))

		if chance < 1.0 and not roll_chance(peer, _rain_rng, chance):
			_say(peer, "The wet wood will not catch. Try again, or put dry tinder in." if wet_kindling else "The wood will not catch in the damp. Try again.")
			return

	fire["state"] = _fire_best_state(fire)
	fire.erase("wet_s")
	_items[id]["left"] = 1.0e9
	_lit_valid = false
	_dirty = true


# One tinder item (cooking.json tinder and tinder_also) taken for lighting warm ash: from the fire's store first, else from the pack. False when there is none.
func _use_tinder(fire: Dictionary, inv) -> bool:
	var kinds: Array = [str(_cooking.get("tinder", "plant_fibre"))] + (_cooking.get("tinder_also", []) as Array)
	var box = _chests.get(int(fire.get("uid", 0))) if bool(fire.get("synced", false)) else null

	for kind in kinds:
		var number: int = table.number_of(str(kind))

		if number <= 0:
			continue

		if box != null:
			for slot in range(box.usable):
				if box.numbers[slot] == number and box.counts[slot] > 0:
					box.take_from_slot(slot, 1)
					_fire_apply_store(fire, box)
					return true

		if inv != null and inv.has(number, 1):
			inv.remove(number, 1)
			return true

	return false


# Roasting at a lit fire: one raw forage item (cookable_suffixes in cooking.json) becomes Campfire Stew.
func _cook(peer: int, inv, id: int) -> void:
	var fire: Dictionary = _fire_in_reach(peer, id)

	if fire.is_empty() or not fire_is_lit(int(fire["state"])):
		return

	var now: int = Time.get_ticks_msec()

	if now - int(_last_cook.get(peer, -100000)) < int(_cooking.get("pace_ms", 1200)):
		return

	for slot in range(inv.slot_count):
		if inv.numbers[slot] != 0 and _cookable(table.id_of(inv.numbers[slot])):
			_last_cook[peer] = now
			var raw: Dictionary = inv.take_from_slot(slot, 1)
			var cooked: int = table.number_of(str(_cooking.get("cooks_into", {}).get(table.id_of(int(raw["number"])), _cooking.get("gives", "roast_forage"))))
			var age: int = _cooked_age(raw, cooked)
			var was_src: String = _gain_source
			_gain_source = SRC_CRAFT   # a roast is made, not gathered (goal got: counter)
			_take_in(peer, inv, cooked, 1, age)
			_gain_source = was_src
			_goal_event(peer, "cooked_on_fire")   # ADD-03: a roast made on the campfire (the campfire cooks only meat and fish, cooking.json cooks_into)

			return

	# Nothing in the pack the fire can cook: say what it does cook, at most every 5 s while E is held (Sal: the refusal for plants was silent).
	if now - int(_last_cook.get(peer, -100000)) > 5000:
		_last_cook[peer] = now
		_say(peer, "The campfire cooks meat and fish. Plants go in a pot or on the clay hearth.")


# Cooking: the roast keeps for cooked_life_mult times what the raw item had left (Tyler: 1.5 to 2.5 times, about 3 at most), never more than the
# roast's own shelf life. Returns the roast's age (wear). Roasting by hand and in the fire store both use it, so meat near rotting in the store
# does not come out as a fresh roast.
func _cooked_age(raw: Dictionary, cooked: int) -> int:
	var left_units: float = float(table.shelf_units(int(raw["number"])) - int(raw.get("wear", 0))) if table.shelf_units(int(raw["number"])) > 0 else 1.0e9
	var life: int = table.shelf_units(cooked)
	return maxi(life - int(minf(left_units * float(_cooking.get("cooked_life_mult", 2.0)), float(life))), 0)


# Food that should have been cooked (cooking.json raw_sick, hours of sickness by item id or id suffix; Tyler: raw meat 24 h,
# fiddleheads and beans 12, acorns and wild mushrooms mild at 6). It still feeds you; the stomach pays afterwards.
func _raw_hours(item_id: String) -> float:
	var cfg: Dictionary = _cooking.get("raw_sick", {})
	var hours: float = float(cfg.get("by_id", {}).get(item_id, 0.0))

	if hours <= 0.0:
		for suffix in cfg.get("by_suffix", {}):
			if item_id.ends_with(str(suffix)):
				hours = float(cfg["by_suffix"][suffix])
				break

	return hours


func _raw_sickness(peer: int, item_id: String) -> void:
	var hours: float = _raw_hours(item_id)
	var odds: Dictionary = _infection_cfg().get("odds", {})
	var known_harm: bool = str(tried_of(peer).get(item_id, "")) == "harm"     # a known harm costs the full sickness at once (ruling 8 Nov, row 26)

	if hours > 0.0 and odds.has(item_id) and not known_harm and not (not tried_of(peer).has(item_id) and grace_of(peer) > 0.0):
		_infect(peer, item_id, hours, float(odds[item_id]))
	elif hours > 0.0:
		_harm_bite(peer, item_id, hours, "That should have been cooked. Your stomach turns.")
	else:
		_learn_food(peer, item_id, "ok")


# Late, uncertain sickness from raw animal food (docs/design/body_in_weather_design.md 5; sickness.json infection when its flag is on, else empty).
func _infection_cfg() -> Dictionary:
	var inf: Variant = _sick_cfg.get("infection", {})
	return inf if typeof(inf) == TYPE_DICTIONARY and bool(inf.get("enabled", false)) else {}


# One roll at the bite (luck helps you escape it); on a hit the sickness waits onset_h game hours in the vitals' sick_due. A miss teaches nothing:
# the food stays unknown until it makes you sick.
func _infect(peer: int, item_id: String, hours: float, p: float) -> void:
	var v: Dictionary = vitals_of(peer)

	if v.is_empty() or roll_chance(peer, _fate_rng, 1.0 - clampf(p, 0.0, 1.0)):
		return

	var onset: Array = _infection_cfg().get("onset_h", [24, 72])
	var minutes: int = roll_amount(peer, _fate_rng, int(float(onset[0]) * 60.0), int(float(onset[onset.size() - 1]) * 60.0))   # lucky: later

	if typeof(v.get("sick_due", null)) != TYPE_ARRAY:
		v["sick_due"] = []

	v["sick_due"].append([float(minutes) * 60.0, hours, item_id, float(minutes) * 60.0])
	_dirty = true


# Pending sicknesses count down in game seconds while the player is online; one that starts names what was eaten and is learned as harm.
func _sick_due_tick(peer: int, v: Dictionary, game_s: float) -> void:
	if typeof(v.get("sick_due", null)) != TYPE_ARRAY or (v["sick_due"] as Array).is_empty():
		return

	var keep: Array = []

	for due in v["sick_due"]:
		var left: float = float(due[0]) - game_s

		if left > 0.0:
			keep.append([left, due[1], due[2], due[3]])
			continue

		var item_id: String = str(due[2])
		var days: int = maxi(int(round(float(due[3]) / 86400.0)), 1)
		var when: String = "yesterday" if days == 1 else "%d days ago" % days
		var food: String = table.sentence_name(table.number_of(item_id)) if table != null else item_id
		_say(peer, str(_sick_cfg.get("infection", {}).get("say_onset", "Your stomach turns. It was the %s %s.")) % [food, when])
		_learn_food(peer, item_id, "harm")
		make_sick(peer, float(due[1]), false)   # the onset line above says it

	v["sick_due"] = keep


# --- Eat-once learning (EARLY_GAME_PRINCIPLES 5, data/items/eat_memory.json) ---

var _eat_cfg: Dictionary = {}
var _eat_warn: Dictionary = {}      # peer -> {"item": id, "until": msec}: the harm warning the next press confirms


func _eat_cfg_value(key: String, fallback: Variant) -> Variant:
	if _eat_cfg.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/items/eat_memory.json"))
		_eat_cfg = parsed if typeof(parsed) == TYPE_DICTIONARY else {"none": true}

	return _eat_cfg.get(key, fallback)


func tried_of(peer: int) -> Dictionary:
	var key: String = str(_peer_key.get(peer, ""))

	if key == "" or not _characters.has(key):
		return {}

	if typeof(_characters[key].get("tried", null)) != TYPE_DICTIONARY:
		_characters[key]["tried"] = {}

	return _characters[key]["tried"]


func grace_of(peer: int) -> float:
	return float(_characters.get(str(_peer_key.get(peer, "")), {}).get("grace_s", 0.0))


# A harm is never forgotten; "ok" only fills an unknown food.
func _learn_food(peer: int, item_id: String, what: String) -> void:
	var tried: Dictionary = tried_of(peer)

	if str(tried.get(item_id, "")) == "harm" or str(tried.get(item_id, "")) == what:
		return

	if _characters.has(str(_peer_key.get(peer, ""))):
		tried[item_id] = what
		_dirty = true


# A food that harms: in the first hour an unknown one costs food and water only, otherwise the stomach pays. Either way it is remembered.
func _harm_bite(peer: int, item_id: String, hours: float, line: String) -> void:
	var unknown: bool = not tried_of(peer).has(item_id)
	_learn_food(peer, item_id, "harm")

	if unknown and grace_of(peer) > 0.0:
		var v: Dictionary = vitals_of(peer)
		var cost: Dictionary = _eat_cfg_value("first_hour_cost", {})
		v["fed"] = maxf(float(v["fed"]) - float(cost.get("fed_kcal", 150)), 0.0)
		v["wet"] = maxf(float(v["wet"]) - float(cost.get("wet_ml", 150)), 0.0)
		_say(peer, str(_eat_cfg_value("say_first_hour", "")))
		_sync_vitals(peer, true)
		return

	if line != "":
		_say(peer, line)

	make_sick(peer, hours)


# True when the bite must wait: a food that harmed this character before is stopped once, with a hint; a second press within
# confirm_window_s eats it anyway.
func _eat_stopped(peer: int, item_id: String, now: int) -> bool:
	if str(tried_of(peer).get(item_id, "")) != "harm":
		return false

	var warn: Dictionary = _eat_warn.get(peer, {})

	if str(warn.get("item", "")) == item_id and now <= int(warn.get("until", 0)):
		_eat_warn.erase(peer)
		return false

	_eat_warn[peer] = {"item": item_id, "until": now + int(float(_eat_cfg_value("confirm_window_s", 5.0)) * 1000.0)}
	_say(peer, str(_eat_cfg_value("say_warn", "")))
	think(peer, "hint_harm")
	return true


# A hot meal or a hot drink lifts body warmth a little (cooking.json "warms", warmth points); the warmth tick then pulls it back.
func _warm_bite(v: Dictionary, item_id: String) -> void:
	var gain: float = float(_cooking.get("warms", {}).get(item_id, 0.0))

	if gain > 0.0:
		v["warmth"] = minf(float(v.get("warmth", 100.0)) + gain, 100.0)


func _cookable(item_id: String) -> bool:
	return StoreRules.cookable(item_id, _cooking)


# The fire record of a world item id when the player stands within reach of it, else {}.
# A torch in hand goes out under water or in the open rain (Dave, 4 Nov 2026; flame_rules.gd): the client, which knows the held slot, asks. A torch stays
# the same torch, marked out (Dave 16 Nov 2026); a lantern becomes its "doused_item" with the same wear. Rain is checked here too (the world's rain now and the
# cover over the player).
func _douse(peer: int, inv, slot: int, by_rain: bool) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0:
		return

	var row: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var into: String = str(row.get("doused_item", ""))

	if not FlameRules.can_go_out(row) or FlameRules.is_out(row, inv.inst_of(slot)) or (into != "" and table.number_of(into) <= 0):
		return

	if by_rain:
		var rain: float = _rain_here(_peer_pos.get(peer, Vector3.ZERO))

		if not FlameRules.in_rain(rain, _peer_covered(peer)):
			return
	elif not bool(_head_under.get(peer, false)) and not bool(_swimming.get(peer, false)):
		return   # water puts it out only when the server too sees the head under water or the player swimming

	if by_rain and not bool(row.get("rain_douses", false)):
		return   # a lantern burns on in the rain behind its horn panes

	var word: String = FlameRules.flame_word(row)

	if into != "":
		inv.numbers[slot] = table.number_of(into)
	else:
		var marked: Dictionary = inv.inst_of(slot).duplicate(true)
		marked["out"] = 1
		inv.inst[slot] = marked

	_say(peer, ("The rain puts your %s out. Press its key to light it again." if by_rain else "The water puts your %s out. Press its key to light it again.") % word)


# Whether a player is under cover from the rain (a crown, a roof, a cave): at the feet or at the eye, where the flame and the client's own test are
# (Dave 10 Nov 2026: a torch went out in a lean-to). The shelter status reads the same cover (comfort_at).
const EYE_M := 1.6


# The weather over a spot (weather_at: its row and its height, so up a mountain where the client shows snow the server sees snow too, not the
# sea level's rain; weather and seasons walk, 23 Nov 2026). Without weather_at (tests) the one weather_now.
func _weather_here(pos: Vector3) -> Dictionary:
	if weather_at.is_valid():
		return weather_at.call(pos)

	return weather_now.call() if weather_now.is_valid() else {}


# The rain at a spot, 0 to 1 (snow is not rain: it puts no fire or torch out). Without weather_at the one rain_now.
func _rain_here(pos: Vector3) -> float:
	if weather_at.is_valid():
		return float((weather_at.call(pos) as Dictionary).get("rain", 0.0))

	if rain_now.is_valid():
		return float(rain_now.call())

	return float((weather_now.call() as Dictionary).get("rain", 0.0)) if weather_now.is_valid() else 0.0


# The air (C) at a spot from its weather (_weather_here): weather_at's temp_c is at the spot's own height already; weather_now's is at sea
# level, so the height comes off (warmth.json lapse_c_per_m, the climate's 6.5 C a km).
func _air_here(pos: Vector3, weather: Dictionary, fallback_c: float) -> float:
	var air: float = float(weather.get("temp_c", fallback_c))
	return air if weather_at.is_valid() else air - maxf(pos.y, 0.0) * float(_warmth_cfg.get("lapse_c_per_m", 0.0065))


func _peer_covered(peer: int) -> bool:
	if not cover_at.is_valid() or not _peer_pos.has(peer):
		return false

	var feet: Vector3 = _peer_pos[peer]
	return float(cover_at.call(feet)) > 0.5 or float(cover_at.call(feet + Vector3(0.0, EYE_M, 0.0))) > 0.5


# A torch in hand stuck in the ground or on a wall (Dave, 4 Nov 2026): items.json places_as names the structure for each; a burning torch stays lit with
# one stick's worth of fuel (structures.json fuel_s), one that went out is placed out. No gap rule (gap_exempt); the chunk cap holds. Hold E takes it back.
func _place_torch(peer: int, inv, slot: int, on_wall: bool, yaw_deg: int, at: Vector3) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0 or not _peer_pos.has(peer):
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var kind: String = str((entry.get("places_as", {}) as Dictionary).get("wall" if on_wall else "ground", ""))
	var def: Dictionary = _structures.get(kind, {})

	if def.is_empty():
		return

	var kept: Dictionary = inv.inst_of(slot).duplicate()
	kept.erase("out")   # whether it is out is the placed piece's own "lit" (below)

	if not kept.is_empty():
		_say(peer, "That cannot be set down: a placed piece would lose what makes it special.")   # a structure row keeps no instance data
		return

	if _peer_pos[peer].distance_to(at) > float(def.get("use_reach_m", 3.0)) + 1.0:
		_say(peer, "Too far to place that.")
		return

	if NpcCamp.within_keep(at):
		_say(peer, PlacementRules.reason_text(NpcCamp.keep_reason(at)).left(1).to_upper() + PlacementRules.reason_text(NpcCamp.keep_reason(at)).substr(1) + ".")
		return

	if water_depth_at.is_valid() and float(water_depth_at.call(at)) > 0.05:
		_say(peer, "A torch will not burn in water.")
		return

	var spot: Vector3 = at

	if not on_wall:
		var ground: float = _cave_ground(at, float(ground_height.call(at.x, at.z))) if ground_height.is_valid() else at.y   # a torch in a cave goes into the cave floor

		if is_nan(ground) or absf(ground - at.y) > 0.6:
			_say(peer, "Push it into the ground.")
			return

		spot.y = minf(ground, at.y)      # on a floor or a foundation the aimed point stands; on open ground it goes in at the ground

	var of_kind: int = 0

	for id in _items:
		if _items[id].has("struct") and str(_items[id]["struct"]["kind"]) == kind and _chunk_of(_items[id]["pos"]) == _chunk_of(spot):
			of_kind += 1

	if of_kind >= int(def.get("cap_per_chunk", 24)):
		_say(peer, "Too many of these stand here already.")
		return

	var lit: bool = bool(entry.get("flame", false)) and not FlameRules.is_out(entry, inv.inst_of(slot))
	var wear: int = inv.wear[slot]
	inv.take_from_slot(slot, 1)
	var placed: Dictionary = {"number": table.number_of(str(def["item"])), "count": 1, "pos": spot, "left": 1.0e9, "wear": wear, "struct": {"kind": kind, "yaw": float(posmod(yaw_deg, 360))}}

	if lit:
		placed["struct"]["lit"] = true
		placed["struct"]["fuel_left"] = light_burn_s(def)

	placed["struct"]["owner"] = str(_peer_key.get(peer, ""))   # the one who set it: only they take it down (_may_take_down), as a built piece
	_items[_next_id] = placed
	_grid_add(_next_id, placed)
	_next_id += 1
	_dirty = true
	_goal_event(peer, "torch_placed")   # ADD-23: a torch wedged into the ground or a wall (the other lights are built as structures)


# E at a burning fire with a torch that went out (or a dark lantern) in the pack lights the first one again (Dave, 4 Nov 2026).
# `want` is the hotbar slot plus one of the torch the player holds (0 for none): pressing a torch that went out on the hotbar at a burning fire lights that one
# (Dave 6 Nov 2026); otherwise the first one in the pack.
func _relight(peer: int, inv, id: int, want: int = 0) -> void:
	# id 0 is the hotkey: a torch that went out simply lights again, wherever you are (Dave 6 Nov 2026: nobody is stuck in a cave without light). With a fire id
	# (E at a burning fire) the fire has to be lit and in reach, as before.
	if id != 0:
		var fire: Dictionary = _fire_in_reach(peer, id)

		if fire.is_empty() or not fire_is_lit(int(fire["state"])):
			return

	var order_first: int = want - 1 if want >= 1 and want <= inv.slot_count else -1

	if bool(_swimming.get(peer, false)):
		var asked: String = table.id_of(inv.numbers[order_first]) if order_first >= 0 else ""
		_say(peer, "It is too wet to light the %s in the water." % FlameRules.flame_word(table.entry(asked)))      # rain is the client's call: it sees caves and roofs (_flame_wet)
		return

	var order: Array = range(inv.slot_count)

	if want >= 1 and want <= inv.slot_count:
		order.push_front(want - 1)

	for slot in order:
		if inv.numbers[slot] == 0:
			continue

		var here: Dictionary = table.entry(table.id_of(inv.numbers[slot]))

		if FlameRules.is_out(here, inv.inst_of(slot)) and str(here.get("relit_item", "")) == "":   # a torch that went out is lit in place (Dave 16 Nov 2026)
			var lit_again: Dictionary = inv.inst_of(slot).duplicate(true)
			lit_again.erase("out")
			inv.inst[slot] = lit_again
			_say(peer, "You light your torch again.")
			return

		var back: String = str(here.get("relit_item", ""))

		if back == "" or table.number_of(back) <= 0:
			continue

		var lit_row: Dictionary = table.entry(back)
		var said: String = "You light your %s again." % FlameRules.flame_word(lit_row)

		# A lantern whose candle or lamp oil burned out takes one more from the pack (buildables plan B4); with none it stays dark, and only the key of that
		# lantern says so (E at a fire looks on for a torch).
		if FlameRules.out_of_fuel(lit_row, inv.wear[slot]):
			var fuel: int = table.number_of(str(lit_row["fuel"]))
			var fuel_slot: int = _slot_holding(inv, fuel)

			if fuel_slot < 0:
				if slot == order_first:
					_say(peer, "Your lantern is out of fuel. It takes %s." % table.name_of(fuel))
					return

				continue

			inv.take_from_slot(fuel_slot, 1)
			inv.wear[slot] = 0
			said = "You put %s in your lantern and light it." % table.sentence_name(fuel)

		inv.numbers[slot] = table.number_of(back)
		_say(peer, said)
		return


# The first pack slot holding item `number`, or -1.
func _slot_holding(inv, number: int) -> int:
	if number <= 0:
		return -1

	for slot in range(inv.slot_count):
		if inv.numbers[slot] == number and inv.counts[slot] > 0:
			return slot

	return -1


# A torch in hand burns down (Dave 6 Nov 2026: about half an hour of real time). The client says once a second that it holds a burning torch; the server
# adds the elapsed time (tenths of a second, capped, so a gap does not burn it) to the slot's wear and the torch is gone at items.json "burn_s".
func _torch_burn(peer: int, inv, slot: int) -> void:
	if slot < 0 or slot >= inv.slot_count or inv.numbers[slot] == 0:
		return

	var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))
	var burn_s: float = float(entry.get("burn_s", 0.0))

	if burn_s <= 0.0 or not FlameRules.can_go_out(entry) or FlameRules.is_out(entry, inv.inst_of(slot)):
		return   # a torch that went out does not burn (or count as a flame) until it is lit again

	var now: int = Time.get_ticks_msec()
	var last: int = int(_torch_seen.get(peer, now - 1000))
	_torch_seen[peer] = now
	inv.wear[slot] += int(round(float(clampi(now - last, 0, 2000)) / 100.0))
	_dirty = true

	if float(inv.wear[slot]) < burn_s * 10.0:
		return

	var before: Array = _snapshot(inv)
	_torch_seen.erase(peer)
	var dark: int = table.number_of(str(entry.get("doused_item", "")))

	# A carried lantern (buildables plan B4) is not used up: its fuel is. It goes dark with its wear full, and its key loads the next candle or lamp oil.
	if entry.has("fuel") and dark > 0:
		inv.numbers[slot] = dark
		inv.wear[slot] = int(ceil(burn_s * 10.0))
		_say(peer, "Your lantern has burned its %s. Press its key with another in your pack to light it again." % table.sentence_name(table.number_of(str(entry["fuel"]))))
		_send_changes(peer, inv, before)
		return

	inv.clear_slot(slot)
	_say(peer, "Your torch has burned down to nothing.")
	_send_changes(peer, inv, before)


func _fire_in_reach(peer: int, id: int) -> Dictionary:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("fire") or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(it["pos"]) > FIRE_USE_M or _camp_refuses(peer, it):
		return {}

	return it["fire"]


# --- Placed structures (data/items/structures.json): lean-to shelter now, storage chest next ---

func _load_blueprints() -> void:
	_blueprints.clear()
	_blueprint_of_kit.clear()
	_retired_blueprint_of_kit.clear()
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(BLUEPRINTS_PATH))

	if typeof(parsed) != TYPE_DICTIONARY:
		return

	for id in parsed.get("blueprints", {}):
		var row: Dictionary = parsed["blueprints"][id].duplicate()

		if bool(row.get("retired", false)):   # kept in the file for its number only
			if bool(row.get("clear_at_load", false)):   # a retired piece still standing in a saved world is cleared at load and leaves its materials (the pumps, s10)
				_retired_blueprint_of_kit[str(_structures.get(str(row["structure"]), {}).get("kit", ""))] = row

			continue

		row["id"] = id
		_blueprints[int(row["number"])] = row
		_blueprint_of_kit[_kit_of_blueprint(row)] = int(row["number"])


# The item a blueprint places as: its structure's kit, or for the campfire blueprint (blueprints.json "lays") the hand-made Campfire, whose ghost
# and placing rules it uses (Dave 26 Nov 2026, "campfire both").
func _kit_of_blueprint(row: Dictionary) -> String:
	return str(row["lays"]) if row.has("lays") else str(_structures.get(str(row["structure"]), {}).get("kit", ""))


# Whether this blueprint can go down now: a hammer of enough tier on the hotbar (a knife for a "tool": "knife" row), the station near when it needs one. Materials are not checked:
# placing always sets down a site (Dave 18 Nov 2026). Says why when it cannot, and takes nothing.
# Tests and admin tools: lay a piece by its old kit name with no hammer, station or materials needed (kits are gone from the game, Dave 4 Nov 2026).
# The piece still takes down into its blueprint materials like any hammer build.
var free_build: bool = false


func place_piece(peer: int, kit_id: String, at: Vector3, yaw_deg: int = 0, lift_steps: int = 0) -> void:
	if inventory_of(peer) == null:
		return

	var number: int = int(_blueprint_of_kit.get(kit_id, 0))

	if number <= 0:
		return

	free_build = true
	_place(peer, inventory_of(peer), -1, at, yaw_deg, lift_steps, _blueprints[number])
	free_build = false


# Tests: place whatever item number the test holds. A dropped kit lays its piece (and uses up the one in the pack); anything else places from its slot as a player would.
func place_item(peer: int, number: int, at: Vector3, lift_steps: int = 0, yaw_deg: int = 0) -> void:
	var inv = inventory_of(peer)

	if inv == null:
		return

	if is_dead_kit(number):
		inv.remove_fill(number, 1)
		place_piece(peer, table.id_of(number), at, yaw_deg, lift_steps)
		return

	action(peer, Net.ACT_PLACE, inv.numbers.find(number), lift_steps, yaw_deg, at)


func _can_blueprint(peer: int, inv, row: Dictionary) -> bool:
	if free_build:
		return not _structures.get(str(row["structure"]), {}).is_empty()

	if not bool(row.get("known", true)) or _structures.get(str(row["structure"]), {}).is_empty():
		return false

	if str(row.get("tool", "hammer")) == "knife":   # a knife row (blueprints.json "tool": simple wood furnishings and stations, W-9) wants a knife on the hotbar, never a hammer
		if _tool_slot(inv, "knife") < 0:
			_say(peer, "You need a knife in your hand bar to build that. Hold it and right click for its blueprints.")
			return false
	else:
		var hammer: int = _heaviest_hammer_slot(inv)

		if hammer < 0:
			_say(peer, "You need a hammer in your hand bar to build from a blueprint.")
			return false

		if int(table.entry(table.id_of(inv.numbers[hammer])).get("tier", 1)) < int(row.get("hammer", 1)):
			_say(peer, "This hammer is too light for that. You need %s." % _hammers_for(int(row.get("hammer", 1))))
			return false

	if int(row.get("chisel", 0)) > 0 and _best_tier_slot(inv, "chisel") < int(row["chisel"]):   # blueprints.json "chisel": the lowest chisel tier (Dave 18 Nov 2026: Copper 2, Bronze 3, Iron 4, Steel 5; a better one serves), on the hand bar beside the hammer
		_say(peer, "You need %s in your hand bar to build that." % _tools_for("chisel", int(row["chisel"])))
		return false

	if str(row.get("station", "")) != "" and not station_near(peer, str(row["station"]), int(row.get("station_level", 1))):
		_say(peer, "You need a %s close by." % str(row["station"]).replace("_", " "))
		return false

	if str(row.get("near", "")) != "" and not station_near(peer, str(row["near"]), int(row.get("near_level", 1))):
		_say(peer, "You need a %s close by." % str(row["near"]).replace("_", " "))
		return false

	return true


# Better hammers draw building materials from farther (master s2.1: a better hammer gains only sourcing range and durability): building_wear.json
# hammer_reach_x by the tier of the heaviest working hammer on the hotbar times each building distance (the 12 m stock, the site gather, the heavy
# stock beside a site, repairs); 1 with no hammer.
func _hammer_x(peer: int, held: int = -1) -> float:   # held: the hammer in hand for a swing (a repair), which then sets the reach
	var inv = inventory_of(peer)
	var slot: int = held if held >= 0 else (_heaviest_hammer_slot(inv) if inv != null else -1)

	if slot < 0:
		return 1.0

	return _hammer_reach_of(table.entry(table.id_of(inv.numbers[slot])))


# One hammer's reach factor: building_wear.json hammer_reach_material by its material where the tier is shared (copper sits between stone and
# bronze, both tier 2 with stone; tier consistency, coordinator 23 Nov 2026: a better hammer always reaches farther), else hammer_reach_x by its tier.
func _hammer_reach_of(entry: Dictionary) -> float:
	var by_material: Dictionary = _wear_cfg.get("hammer_reach_material", {})

	if by_material.has(str(entry.get("material", ""))):
		return maxf(float(by_material[str(entry["material"])]), 1.0)

	return maxf(float((_wear_cfg.get("hammer_reach_x", {}) as Dictionary).get(str(int(entry.get("tier", 1))), 1.0)), 1.0)


# The heaviest working hammer on the hotbar (-1 none): a stone hammer in key 1 does not hide the iron one in key 4 that the player holds
# (the hammer panel lists rows by the hammer in hand).
func _heaviest_hammer_slot(inv) -> int:
	var best: int = -1

	for slot in range(inv.slot_count):
		if not inv.on_hotbar(slot) or inv.numbers[slot] == 0 or _is_broken(inv, slot):
			continue

		var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))

		if str(entry.get("tool_class", "")) == "hammer" and (best < 0 or _hammer_reach_of(entry) > _hammer_reach_of(table.entry(table.id_of(inv.numbers[best])))):
			best = slot

	return best


# The hammers heavy enough for a blueprint row's "hammer" tier, as said in a sentence, lightest first ("a stone hammer or better"; tier 3 is any
# metal one: "a bronze, iron or steel hammer"). From items.json, so a new hammer is named without a code change.
func _hammers_for(tier_needed: int) -> String:
	return _tools_for("hammer", tier_needed)


# The highest tier of an unbroken tool of this class on the hotbar; 0 with none.
func _best_tier_slot(inv, tool_class: String) -> int:
	var best: int = 0

	for slot in range(inv.slot_count):
		if inv.numbers[slot] == 0 or not inv.on_hotbar(slot) or _is_broken(inv, slot):
			continue

		var entry: Dictionary = table.entry(table.id_of(inv.numbers[slot]))

		if str(entry.get("tool_class", "")) == tool_class:
			best = maxi(best, int(entry.get("tier", 1)))

	return best


# The tools of a class good enough for a tier, as said in a sentence, lightest first ("a bronze, iron or steel chisel" reads "a bronze chisel or better").
func _tools_for(tool_class: String, tier_needed: int) -> String:
	var hammers: Array = []   # [tier, number, material] of every live tool of the class good enough

	for id in table.ids():
		var entry: Dictionary = table.entry(id)

		if str(entry.get("tool_class", "")) == tool_class and not bool(entry.get("retired", false)) and int(entry.get("tier", 1)) >= tier_needed:
			hammers.append([int(entry.get("tier", 1)), int(entry.get("number", 0)), str(entry.get("material", id.trim_suffix("_" + tool_class)))])

	if hammers.is_empty():
		return "a better %s" % tool_class

	hammers.sort()
	var lightest: int = int(hammers[0][0])
	var words: Array = []

	for row in hammers:
		if int(row[0]) == lightest:
			words.append(str(row[2]))

	var listed: String = str(words[0]) if words.size() == 1 else ", ".join(words.slice(0, words.size() - 1)) + " or " + str(words[-1])
	return "a %s %s%s" % [listed, tool_class, " or better" if int(hammers[-1][0]) > lightest else ""]


# All the materials back into the pack, or none (with a word) when they do not fit.
# A blueprint's materials back in the pack, all or nothing. `taken_down`: the piece stood, so what it burned is gone (blueprints.json "spent", [item,
# count], also counted in "cost": a lantern's candle or lamp oil; coordinator ruling 10 Nov 2026) and only the rest comes back.
func _refund_blueprint(peer: int, inv, row: Dictionary, taken_down: bool = false, kinds: Dictionary = {}) -> bool:   # kinds: the built piece's struct["kinds"] (_note_kinds)
	var given: Array = []

	for need in row["cost"]:
		var count: int = int(need[1])

		if taken_down:
			for burnt in row.get("spent", []):
				if str(burnt[0]) == str(need[0]):
					count = maxi(count - int(burnt[1]), 0)

		if count <= 0:
			continue

		var left: int = 0

		for pair in _kinds_back(str(need[0]), count, kinds):   # what was put in; a piece from before kinds were kept: a group cost's lowest member
			var short: int = inv.add(int(pair[0]), int(pair[1]))
			given.append([int(pair[0]), int(pair[1]) - short])
			left += short

		if left > 0:
			for put in given:
				inv.remove(int(put[0]), int(put[1]))

			_say(peer, "Make room in your pack first.")   # a pack at MAX_SLOTS
			return false

	return true


func _structure_of_kit(kit_id: String) -> Dictionary:
	for kind in _structures:
		if str(_structures[kind]["kit"]) == kit_id:
			var def: Dictionary = _structures[kind].duplicate()
			def["kind"] = kind
			return def

	return {}


func _place_structure(peer: int, inv, slot: int, spot: Vector3, yaw_deg: int, def: Dictionary, site_row: Dictionary = {}) -> void:
	var attaching: bool = str(def.get("attach_to", "")) == "fire"

	if attaching:
		spot = _snap_to_fire(peer, spot)

		if is_nan(spot.y):
			return

		for fid in _items:
			var fit: Dictionary = _items[fid]

			if fit.has("fire") and (fit["pos"] as Vector3).distance_to(spot) <= POT_ON_FIRE_M and float(_fire_wood(fit["fire"])["log"]) > 0.0:
				_say(peer, "The fire is too big for a pot. Let the logs burn down first.")
				return

	spot = _tank_spot_on_pipe(str(def.get("kind", "")), spot, yaw_deg)   # a barrel set down by a pipe's end or joint sits on it (Dave 19 Nov 2026 20:31Z)

	if str(def.get("attach_to", "")) == "table":   # a Serving Platter goes on a table top (master s3.15), one to a spot
		spot = PlacementRules.table_spot(_structures_cfg, def, spot, _surface_rows(def))

		if is_nan(spot.y):
			_say(peer, "Set it on a table.")
			return

		for pid in _items:
			if _items[pid].has("struct") and str(_items[pid]["struct"]["kind"]) == str(def["kind"]) and (_items[pid]["pos"] as Vector3).distance_to(spot) < PLATTER_APART_M:
				_say(peer, "There is a platter there already.")
				return

	if _traps.is_kind(str(def["kind"])) and not _traps.allow_place(peer, spot, str(def["kind"])):
		return

	var here_chunk: Vector2i = _chunk_of(spot)
	var of_kind: int = 0

	for id in _items:
		var other: Dictionary = _items[id]

		if not other.has("struct") and not other.has("fire") or other.get("fire", {}).has("marks"):
			continue   # a bandit camp's boot prints stand in nobody's way

		var row: Dictionary = {"pos": other["pos"], "state": int(other["fire"]["state"]) if other.has("fire") else int(_structures.get(str(other["struct"]["kind"]), {}).get("state", -1)), "yaw": float(other["struct"].get("yaw", 0.0)) if other.has("struct") else 0.0}

		if PlacementRules.bed_in_shelter(_structures_cfg, def, row, spot):   # a rough bed goes INSIDE a lean-to (Dave 31 Oct 2026), whatever the gap
			yaw_deg = int(round(float(row["yaw"])))   # the bed lies along the lean-to (1 x 2 m inside 2.6 x 2.4 m), whatever way the player faced

		if PlacementRules.one_to_a_point(str(def.get("piece_kind", ""))) and other.has("struct") and PlacementRules.point_family(str(_structures.get(str(other["struct"]["kind"]), {}).get("piece_kind", ""))) == PlacementRules.point_family(str(def.get("piece_kind", ""))) and PlacementRules.point_of(_structures.get(str(other["struct"]["kind"]), {}), other["pos"]).distance_to(PlacementRules.point_of(def, spot)) < PlacementRules.ANCHOR_TAKEN_M:
			_say(peer, "Something is in the way.")   # one pillar to a point, one wall top to a wall (PlacementRules.blocked)
			return

		if PlacementRules.plots_clash(_structures_cfg, def, spot, float(yaw_deg), row):
			_say(peer, "A bed or planter is already in that spot.")   # every square metre stands BED_GAP_M from every other bed's (two on one spot would share a crop record)
			return

		var why: String = PlacementRules.keeps_off(_structures_cfg, def, spot, float(yaw_deg), row)   # the ghost's own rule, so a green ghost always places

		if why != "":
			_say(peer, "Something is in the way." if why == "close" else PlacementRules.reason_text(why).left(1).to_upper() + PlacementRules.reason_text(why).substr(1) + ".")
			return

		if other.has("struct") and str(other["struct"]["kind"]) == str(def["kind"]) and _chunk_of(other["pos"]) == here_chunk:
			of_kind += 1

	if of_kind >= int(def["cap_per_chunk"]):
		_say(peer, "Too many of these stand here already.")
		return

	var water_why: String = _water_refusal(def, spot, yaw_deg)

	if water_why != "":
		_say(peer, water_why)
		return

	if slot < 0 and free_build:
		pass   # a test or admin piece: nothing is taken
	elif slot < 0:
		pass   # a blueprint site: nothing is taken on placement; only a hammer hit adds the materials (_gather_site, Dave 18 Nov 2026)
	else:
		inv.take_from_slot(slot, 1)

	var entry: Dictionary = {"number": table.number_of(str(def["item"])), "count": 1, "pos": spot, "left": 1.0e9, "struct": {"kind": str(def["kind"]), "yaw": float(posmod(yaw_deg, 360))}}

	entry["struct"]["owner"] = str(_peer_key.get(peer, ""))   # the builder: only they take it down (_may_take_down); crafting draws only on the owner's containers (CraftStock.owner_ok)

	if int(def.get("slots", 0)) > 0:
		entry["struct"]["uid"] = _next_uid
		_chests[_next_uid] = _new_store(str(def["kind"]))
		_next_uid += 1

	if not site_row.is_empty():
		entry["struct"]["site"] = {"bp": int(site_row["number"]), "have": {}}
		_say(peer, "Blueprint down. Hit it with a hammer to add the materials.")

	_items[_next_id] = entry
	_grid_add(_next_id, entry)
	_bare_skirts_near(spot, 0.5 * Vector2(float(def.get("footprint_x", 1.0)), float(def.get("footprint_z", 1.0))).length())

	if _smelters.is_smelter(_structures.get(str(def["kind"]), {})):
		_smelters.note(_next_id)

	_next_id += 1
	_add_roof(entry)

	if _traps.is_kind(str(def["kind"])):
		_traps.on_placed(peer, _next_id - 1)

	if bool(_structures.get(str(def["kind"]), {}).get("fish_trap", false)):
		entry["struct"]["rolled_s"] = _now_game_s()   # its first hour starts now (_fish_trap_catch_up)

	if attaching:
		_refresh_pots()   # the fire under it takes the firewood cap now

	if not BuildingWear.rule_for(_wear_cfg, str(def["kind"])).is_empty():
		entry["struct"]["born"] = _now_game_s()   # last cared for: placed now

	if not site_row.is_empty():
		_dirty = true
		return   # a site counts as built, holds nothing up and shelters nobody until _finish_site

	_after_built(peer, entry, def)
	var placed: int = _next_id - 1   # before a split: the split's new half takes the next id
	_tank_split_pipe(placed)
	_water_add(placed)
	_dirty = true
	save_soon([placed])


# What a piece does once it stands: a support holds the ground, a lean-to is a place to rest, the goal list hears of it.
func _after_built(peer: int, entry: Dictionary, def: Dictionary) -> void:
	var spot: Vector3 = entry["pos"]

	if bool(def.get("blocks_walk", false)):
		_free_trapped(spot)

	if str(def.get("use", "")) == "light" and _blueprint_of_kit.has(str(def.get("kit", ""))):   # a lantern built with its candle or oil ("spent") stands lit on it
		for burnt in _blueprints[int(_blueprint_of_kit[str(def["kit"])])].get("spent", []):
			if str(burnt[0]) == str(def.get("fuel", "")) and int(burnt[1]) > 0:
				entry["struct"]["lit"] = true
				entry["struct"]["fuel_left"] = light_burn_s(def) * float(int(burnt[1]))

	if def.has("support"):
		entry["struct"]["born"] = _now_game_s()
		_rebuild_supports()

		if support_changed.is_valid():
			support_changed.call(spot)

	if bool(def.get("shelter", false)):
		_record_rest(str(_peer_key.get(peer, "")), _shelter_floor(spot, def), "shelter")   # a lean-to you built is a place to come back to

	_goal_event(peer, "placed", str(entry["struct"]["kind"]))   # the piece's own kind: a finished site passes the raw structures row, which has none (GOALS-REPAIR F1)


# A campfire pot goes onto the nearest small fire (laid, lit or burnt out; never a bonfire) within POT_ATTACH_M of where it was put and
# takes that fire's spot. Returns the fire's spot, or a NAN y after telling the player why it cannot go there.
func _snap_to_fire(peer: int, spot: Vector3) -> Vector3:
	var best: int = -1
	var best_d: float = POT_ATTACH_M

	for id in _items:
		if _items[id].has("fire") and not _items[id]["fire"].has("camp") and (_items[id]["pos"] as Vector3).distance_to(spot) <= best_d:
			best = id
			best_d = (_items[id]["pos"] as Vector3).distance_to(spot)

	if best < 0:
		_say(peer, "The campfire pot hangs over a small fire. Lay a fire first.")
		return Vector3(spot.x, NAN, spot.z)

	var at: Vector3 = _items[best]["pos"]

	if int(_items[best]["fire"]["state"]) == FIRE_STATE_BONFIRE:
		_say(peer, "That fire is too big for a pot. Let it burn down first.")
		return Vector3(spot.x, NAN, spot.z)

	for id in _items:
		if _is_pot(_items[id]) and (_items[id]["pos"] as Vector3).distance_to(at) <= POT_ON_FIRE_M:
			_say(peer, "That fire already has a pot.")
			return Vector3(spot.x, NAN, spot.z)

	return at


# The structure's roof joins the cover index (both ends do the same on seeing the structure).
# --- Building wear and repair (DESIGN_IDEAS.md Section 8.13; Dave 4 Nov 2026) ---
const BuildingWear := preload("res://src/shared/building_wear.gd")
var _wear_cfg: Dictionary = BuildingWear.load_config()


# The condition (0 to 1) of a placed piece now; 1.0 for a kind that does not wear. A piece placed before wear existed starts its clock now.
func piece_condition(id: int) -> float:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("struct"):
		return 1.0

	var rule: Dictionary = BuildingWear.rule_for(_wear_cfg, str(it["struct"]["kind"]))

	if rule.is_empty():
		return 1.0

	if not it["struct"].has("born"):
		it["struct"]["born"] = _now_game_s()

	return BuildingWear.condition(rule, float(it["struct"]["born"]), _now_game_s())


# Hammer, Repair mode, left click on a worn piece: spends repair_share of the piece's blueprint materials times what it lost, from loose items near the
# piece, then containers within reach, then the pack (all or nothing), and sets the piece back to full condition.
func _repair_struct(peer: int, inv, id: int, held_slot: int) -> void:   # held_slot: the pack slot in hand, the hammer that does it
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("struct") or not _peer_pos.has(peer):
		return

	if _peer_pos[peer].distance_to(_reach_point(it, _peer_pos[peer])) > Interact.server_reach_m():
		_say(peer, "Too far to build that. Walk up to the blueprint." if it["struct"].has("site") else "Too far to repair that.")   # a blue blueprint is filled by this same hit (lane A robot run 25 Nov 2026: "repair" read wrong)
		return

	var hammer: int = _swing_tool(peer, inv, held_slot, "hammer")

	if hammer < 0:
		return

	if it["struct"].has("site"):
		_gather_site(peer, inv, id, hammer)   # a blue blueprint: the hammer fills it from all around
		return

	var kind: String = str(it["struct"]["kind"])
	var def: Dictionary = _structures.get(kind, {})
	var piece_name: String = kind.replace("_", " ")
	var blueprint: Dictionary = _blueprints.get(int(_blueprint_of_kit.get(str(def.get("kit", "")), 0)), {})

	if def.has("cost_each"):   # a pipe run laid from the hand (PLUMBING_DESIGN s9): its pieces' own cost, times the pieces it took
		blueprint = {"cost": (def["cost_each"] as Array).map(func(c): return [c[0], int(c[1]) * maxi(int(it["struct"].get("paid", 1)), 1)])}
		piece_name = table.in_sentence(str(table.entry(str(def.get("item", kind))).get("name", piece_name)))

	# A smithy also wears with use (server_smithy.gd, master s2.2 item 9): its condition is the lower of the two, and one repair mends both.
	var smithy: bool = _smithies.durability(def) > 0.0

	if smithy:
		piece_name = table.in_sentence(str(table.entry(str(def.get("item", kind))).get("name", piece_name)))   # "improved smithy", not its old kind

	if (BuildingWear.rule_for(_wear_cfg, kind).is_empty() and not smithy) or blueprint.is_empty():
		_say(peer, "The %s does not wear, so it needs no repair." % piece_name)
		return

	var cond: float = minf(piece_condition(id), _smithies.condition(id))

	if cond >= float(_wear_cfg.get("good_condition", 0.98)):
		_say(peer, "The %s is in good repair (%d percent)." % [piece_name, int(round(cond * 100.0))])
		return

	var needs: Array = BuildingWear.repair_needs(_smithies.repair_cost(blueprint["cost"]) if smithy else blueprint["cost"], cond, float(_wear_cfg.get("repair_share", 0.5)))
	var log_need: int = 0

	for need in needs:
		if str(need[0]) == "log":
			log_need = int(need[1])

	if log_need > 0:
		_pull_nearby_logs(peer, inv, maxi(0, log_need - inv.count_fill(table.number_of("log"))))   # shoulder and ground logs count, as for building

	var ground_m: float = float(_wear_cfg.get("ground_m", 6.0)) * _hammer_x(peer, hammer)
	var boxes: Array = _boxes_near(peer, _hammer_x(peer, hammer)).filter(func(box): return int(box[0]) != id)   # never the piece's own store: a repair keeps what it holds (a worn-out smithy's is shut anyway)
	var short: PackedStringArray = []

	for need in needs:
		var number: int = table.number_of(str(need[0]))
		var have: int = inv.count_fill(number, true) + _ground_count(number, it["pos"], ground_m)   # building takes plain units only

		for box in boxes:
			have += box[1].count_fill(number, true)

		if have < int(need[1]):
			short.append("%d %s" % [int(need[1]), _item_name_lower(str(need[0]))])

	if not short.is_empty():
		_say(peer, "Repairing the %s (%d percent) needs %s." % [piece_name, int(round(cond * 100.0)), ", ".join(short)])
		return

	for need in needs:
		var number: int = table.number_of(str(need[0]))
		var left: int = int(need[1])
		left -= _ground_take(number, left, it["pos"], ground_m)

		for box in boxes:
			if left <= 0:
				break

			var from_box: int = mini(left, box[1].count_fill(number, true))

			if from_box > 0 and box[1].remove_fill(number, from_box, [], true):
				left -= from_box
				_push_box(int(box[0]), box[1])

		if left > 0:
			inv.remove_fill(number, left, [], true)

	it["struct"]["born"] = _now_game_s()

	if bool(def.get("wear_slows", false)) and _water.pieces.has(id):
		_water_relink_at.append_array(WaterNetwork.ends(_water.pieces[id]))   # a mended wooden pipe carries its full flow again

	_smithies.repaired(id)
	_dirty = true
	_say(peer, "Repaired the %s (was %d percent)." % [piece_name, int(round(cond * 100.0))])

	_goal_event(peer, "station_repaired" if smithy else "building_repaired")   # ADD-11: a hammer mended a worn building piece; the R5 smithy is the goal activity:repair_station


# Loose items (not structures, fires or trees) of one kind, or of any member of its group, within `radius` of a spot.
func _ground_count(number: int, at: Vector3, radius: float) -> int:
	var total: int = 0
	var fills: PackedInt32Array = _fills(number)

	for gid in _items:
		var g: Dictionary = _items[gid]

		if fills.has(int(g.get("number", 0))) and not g.has("struct") and not g.has("fire") and not g.has("tree") and not g.has("inst") and (g["pos"] as Vector3).distance_to(at) <= radius:
			total += int(g["count"])

	return total


func _ground_take(number: int, want: int, at: Vector3, radius: float) -> int:
	var taken: int = 0
	var fills: PackedInt32Array = _fills(number)
	var stacks: Array = []

	for gid in _items.keys():
		var g: Dictionary = _items[gid]

		if fills.has(int(g.get("number", 0))) and not g.has("struct") and not g.has("fire") and not g.has("tree") and not g.has("inst") and (g["pos"] as Vector3).distance_to(at) <= radius:
			stacks.append(gid)

	for gid in _spend_sorted(stacks, number, func(id): return int(_items[id]["number"])):
		if taken >= want:
			break

		var g: Dictionary = _items[gid]
		var took: int = mini(int(g["count"]), want - taken)

		if took >= int(g["count"]):
			_items.erase(gid)
		else:
			g["count"] = int(g["count"]) - took

		taken += took

	return taken


# The item numbers that fill an ingredient or a blueprint cost: its group's members (item_table.gd load_groups: "log", "bronze_nails", "bronze_hinges"), or the number alone.
# Inventory.fills_of is the same rule for a pack or a chest.
func _fills(number: int) -> PackedInt32Array:
	var members: PackedInt32Array = table.group_members(number)
	return members if not members.is_empty() else PackedInt32Array([number])


# What a group cost gives back when a piece or a site is taken down (coordinator 10 Nov 2026): the group's lowest member, since which member was
# paid in is not recorded. A wall built with Bronze nails must not give back iron Nails, the scarce kind. "Lowest" is ItemTable.spend_order, the same
# ranking a cost spends by (Inventory.remove_fill, _spend_sorted): a cost uses up its lowest member first and gives that member back.
func _refund_number(number: int) -> int:
	var order: PackedInt32Array = table.spend_order(number)
	return order[0] if not order.is_empty() else number


# Loose stacks of a group ingredient in the order they are spent: the lowest member first (ItemTable.spend_order), the order `rows` came in kept within a
# member (nearest first). `member_of` gives a row's item number, or 0 for a row that is not a stack of the ingredient (a chest in _gather_site): it keeps its place.
func _spend_sorted(rows: Array, number: int, member_of: Callable) -> Array:
	var order: PackedInt32Array = table.spend_order(number)
	var at: Array = []
	var keyed: Array = []

	for i in rows.size():
		var member: int = int(member_of.call(rows[i]))

		if member > 0:
			at.append(i)
			keyed.append([order.find(member), at.size(), rows[i]])

	keyed.sort_custom(func(a, b): return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]))
	var out: Array = rows.duplicate()

	for j in at.size():
		out[at[j]] = keyed[j][2]

	return out


# [[item id, inventory], ...] of the player's own containers and station stores (not kept out: the crafting rule, CraftStock.owner_ok) within reach
# (times reach_x: a better hammer repairs from farther). Never another player's container, open or not.
func _boxes_near(peer: int, reach_x: float = 1.0) -> Array:
	var out: Array = []
	var key: String = str(_peer_key.get(peer, ""))

	for sid in _items:
		var s: Dictionary = _items[sid]

		if not s.has("struct") or not s["struct"].has("uid") or not _chests.has(int(s["struct"]["uid"])) or int(_structures.get(str(s["struct"]["kind"]), {}).get("slots", 0)) <= 0 or _smithies.broken_row(s):
			continue   # a worn-out smithy's store is shut (master s2.2 item 9)

		if (s["pos"] as Vector3).distance_to(_peer_pos[peer]) <= (Interact.server_reach_m() + 2.0) * reach_x and _may_access(peer, s) and CraftStock.owner_ok(str(s["struct"].get("owner", "")), key) and not bool(s["struct"].get("keep_out", false)):
			out.append([sid, _chests[int(s["struct"]["uid"])]])

	return out


# --- Blueprint sites (Dave 5 Nov 2026) ---
# Every hammer or knife placement sets down a site, taking nothing (Dave 18 Nov 2026): the real piece, drawn blue and see-through, that can be walked
# through. Only a hammer hit fills it (_gather_site: pack, loose items and the builder's own containers within reach); when every material is in, it becomes the real piece. The site is the piece's own entry with struct["site"] = {"bp": blueprint number,
# "have": {item id: count}}; taking a site down gives back what was put in.


# Which items a site's materials really were (site["kinds"] = {cost item id: {item id: count}}, kept on the built piece as struct["kinds"]), so a
# take-down gives those back, not the cheapest member of a group cost (to-do sweep 23 Nov 2026: Bronze nails put in came back as Copper nails).
# A site or piece from before (build 9257) has none: what it holds comes back as before.
func _note_kinds(site: Dictionary, need_id: String, taken: Array) -> void:
	if table.spend_order(table.number_of(need_id)).is_empty():
		return   # a plain cost comes back as itself anyway: only a group cost is noted, so saves stay small

	if not site.has("kinds"):
		site["kinds"] = {}

	var row: Dictionary = site["kinds"].get(need_id, {})

	for unit in taken:
		if (unit[1] as Dictionary).has("liquid_ml") or int(unit[3]) <= 0:
			continue

		var member: String = table.id_of(int(unit[0]))
		row[member] = int(row.get(member, 0)) + int(unit[3])

	site["kinds"][need_id] = row


# `count` of the cost item `need_id` back as the items they were (`kinds`, from _note_kinds), any rest as its cheapest member: [[number, count], ...].
func _kinds_back(need_id: String, count: int, kinds: Dictionary) -> Array:
	var out: Array = []
	var row: Dictionary = kinds.get(need_id, {}) if typeof(kinds.get(need_id, {})) == TYPE_DICTIONARY else {}

	for member in row:
		var number: int = table.number_of(str(member))
		var n: int = mini(count, int(row[member]))

		if n > 0 and number > 0:
			out.append([table.current_number(number), n])
			count -= n

	if count > 0:
		out.append([_refund_number(table.number_of(need_id)), count])

	return out


func _site_of(it: Dictionary) -> Dictionary:
	if it.has("struct") and it["struct"].has("site"):
		return it["struct"]["site"]

	return {}


# [[item id, still needed, total needed], ...] for a site's blueprint.
func _site_needs(site: Dictionary) -> Array:
	var out: Array = []
	var have: Dictionary = site.get("have", {})

	for need in _blueprints.get(int(site.get("bp", 0)), {}).get("cost", []):
		out.append([str(need[0]), maxi(int(need[1]) - int(have.get(str(need[0]), 0)), 0), int(need[1])])

	return out


# How far beside the builder loose stock counts as "to hand" on a blueprint site's list (times the hammer's reach).
const BUILD_STOCK_M := 4.0


# What a site's list shows one player: [[item id, still needed, on hand], ...], "on hand" being the pack, loose stock beside them and containers within reach.
# During a world sync (_site_memo not null) a player's hammer reach, containers and each item's on-hand count are worked out once for all the sites
# near them: nothing changes within the sync, and doing it per site walked every world record twice per site and player (server load test
# 23 Nov 2026: 16 players beside 130 sites held the tick 1.0 to 1.4 s in every full sync).
var _site_memo = null   # null outside a sync; peer -> {"reach", "boxes", "ground": [[item number, count], ...], "hand": {item number: on hand}}
const SITE_CELL_M := 16.0   # the full sync also files every record in cells this size, so a player's containers and ground stock are found without a walk over the world
var _site_cells: Dictionary = {}   # cell -> [world id, ...], filled by the full sync, empty outside one
var _site_cells_due: bool = false  # a full sync is on and has not filed _site_cells yet: the first site's list files them


# Files every record in its SITE_CELL_M cell for a full sync's site lists (a quick sync files none: its few sites take the full walks).
func _file_site_cells(quick: bool) -> void:
	_site_cells = {}

	for id in ([] if quick else _items.keys()):
		var cell: Vector2i = Vector2i(floori(_items[id]["pos"].x / SITE_CELL_M), floori(_items[id]["pos"].z / SITE_CELL_M))

		if not _site_cells.has(cell):
			_site_cells[cell] = []

		_site_cells[cell].append(id)


# A player's reach, containers and loose stacks beside them for the sites' lists of one sync, from the records in the SITE_CELL_M cells within
# reach (the same records _craft_boxes and _ground_count would find by walking every one); the full walks when the sync filed no cells (a quick sync).
func _site_memo_of(peer: int) -> Dictionary:
	var reach_x: float = _hammer_x(peer)

	if _site_cells_due:
		_site_cells_due = false
		_file_site_cells(false)   # the first site's list this full sync (lag: the sync walked every record for this each second, sites or not)

	if _site_cells.is_empty():
		return {"reach": reach_x, "boxes": _craft_boxes(peer, reach_x), "ground": null, "hand": {}}

	var here: Vector3 = _peer_pos[peer]
	var key: String = str(_peer_key.get(peer, ""))
	var stock: Dictionary = {"boxes": [], "near": [], "kitchens": []}
	var ground: Array = []
	var r: float = maxf(maxf(CraftStock.LOOSE_STOCK_M, CraftStock.CRAFT_REACH_M), BUILD_STOCK_M) * reach_x
	var lo: Vector2i = Vector2i(floori((here.x - r) / SITE_CELL_M), floori((here.z - r) / SITE_CELL_M))
	var hi: Vector2i = Vector2i(floori((here.x + r) / SITE_CELL_M), floori((here.z + r) / SITE_CELL_M))

	for cx in range(lo.x, hi.x + 1):
		for cz in range(lo.y, hi.y + 1):
			for sid in _site_cells.get(Vector2i(cx, cz), []):
				_stock_note(stock, sid, here, key, reach_x)
				var g: Dictionary = _items[sid]

				if not g.has("struct") and not g.has("fire") and not g.has("tree") and not g.has("inst") and (g["pos"] as Vector3).distance_to(here) <= BUILD_STOCK_M * reach_x:
					ground.append([int(g.get("number", 0)), int(g["count"])])   # as _ground_count counts

	(stock["boxes"] as Array).sort_custom(func(a, b): return [a[3], float(a[2])] < [b[3], float(b[2])])
	return {"reach": reach_x, "boxes": stock["boxes"], "ground": ground, "hand": {}}


func _site_view(peer: int, it: Dictionary) -> Array:
	var out: Array = []
	var inv = inventory_of(peer)

	if inv == null or not _peer_pos.has(peer):
		return out

	var memo: Dictionary = {}

	if _site_memo != null:
		if not (_site_memo as Dictionary).has(peer):
			_site_memo[peer] = _site_memo_of(peer)

		memo = _site_memo[peer]

	var reach_x: float = float(memo["reach"]) if not memo.is_empty() else _hammer_x(peer)
	var boxes: Array = memo["boxes"] if not memo.is_empty() else _craft_boxes(peer, reach_x)

	for need in _site_needs(_site_of(it)):
		var number: int = table.number_of(str(need[0]))

		if not memo.is_empty() and memo["hand"].has(number):
			out.append([str(need[0]), int(need[1]), int(memo["hand"][number])])
			continue

		var on_hand: int = inv.count_fill(number, true)

		if not memo.is_empty() and memo["ground"] != null:
			var fills: PackedInt32Array = _fills(number)

			for row in memo["ground"]:
				on_hand += int(row[1]) if fills.has(int(row[0])) else 0
		else:
			on_hand += _ground_count(number, _peer_pos[peer], BUILD_STOCK_M * reach_x)

		for box in boxes:
			on_hand += box[1].count_fill(number, true)

		if not memo.is_empty():
			memo["hand"][number] = on_hand

		out.append([str(need[0]), int(need[1]), on_hand])

	return out


# The hammer in Repair mode on a blueprint site (Dave 10 Nov 2026: "search the area around me for 12 meters. on the ground, in my inventory, in any containers
# near me ... anything for materials that this blue print needs and pull those items and put them in the blueprint"; craft from containers, built in and
# always on). Takes only what the site still needs: the pack first (any member of a group, a `log` need takes any log), then loose items on the ground and
# the builder's own containers (CraftStock.owner_ok, not keep out) within building_wear.json site_gather_m of the builder, nearest first. One line says
# what came and what is still missing; with nothing missing the piece is built.
func _gather_site(peer: int, inv, id: int, hammer: int) -> void:   # hammer: the one in hand (its tier sets the reach)
	var it: Dictionary = _items[id]
	var site: Dictionary = _site_of(it)
	var here: Vector3 = _peer_pos[peer]
	var reach: float = float(_wear_cfg.get("site_gather_m", CraftStock.CRAFT_REACH_M)) * _hammer_x(peer, hammer)
	var key: String = str(_peer_key.get(peer, ""))
	var sources: Array = []   # [distance, world id, is a container], nearest first

	for sid in _items:
		var s: Dictionary = _items[sid]
		var d: float = (s["pos"] as Vector3).distance_to(here)

		if d > reach:
			continue

		if _is_loose(s) or (s.has("scatter") and int(s.get("number", 0)) > 0):   # natural sticks and stones on the ground too
			sources.append([d, sid, false])
		elif _is_storage(s) and CraftStock.owner_ok(str(s["struct"].get("owner", "")), key) and not bool(s["struct"].get("keep_out", false)):
			sources.append([d, sid, true])

	sources.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
	var have: Dictionary = site["have"]
	var pulled: PackedStringArray = []

	for need in _site_needs(site):
		var left: int = int(need[1])

		if left <= 0:
			continue

		var number: int = table.number_of(str(need[0]))
		var fills: PackedInt32Array = inv.fills_of(number)
		var put: int = mini(left, inv.count_fill(number, true))   # building takes plain units only
		var taken: Array = []   # [number, inst, wear, count] rows of what came out of the pack and the containers: the members, for a refund

		if put > 0 and not inv.remove_fill(number, put, taken, true):
			put = 0

		for src in _spend_sorted(sources, number, func(s): return int(_items[s[1]]["number"]) if not bool(s[2]) and _items.has(s[1]) and fills.has(int(_items[s[1]]["number"])) else 0):
			if put >= left:
				break

			if bool(src[2]):
				var box = _chests[int(_items[src[1]]["struct"]["uid"])]
				var from_box: int = mini(left - put, box.count_fill(number, true))

				if from_box > 0 and box.remove_fill(number, from_box, taken, true):
					put += from_box
					_push_box(int(src[1]), box)
			elif _items.has(src[1]) and fills.has(int(_items[src[1]]["number"])) and not _items[src[1]].has("inst"):
				var g: Dictionary = _items[src[1]]
				var from_ground: int = mini(left - put, int(g["count"]))
				put += from_ground
				taken.append([int(g["number"]), {}, 0, from_ground])

				if from_ground >= int(g["count"]):
					if g.has("scatter"):
						_taken[g["scatter"]] = true

					_items.erase(src[1])
				else:
					g["count"] = int(g["count"]) - from_ground

		if put > 0:
			have[str(need[0])] = int(have.get(str(need[0]), 0)) + put
			_note_kinds(site, str(need[0]), taken)
			pulled.append("%d %s" % [put, _item_name_lower(str(need[0]))])

	var missing: PackedStringArray = []

	for need in _site_needs(site):
		if int(need[1]) > 0:
			missing.append("%d %s" % [int(need[1]), _item_name_lower(str(need[0]))])

	if pulled.is_empty():
		_say(peer, "Nothing within %d m that it needs. Still needed: %s." % [int(round(reach)), ", ".join(missing)])
		return

	_dirty = true

	if missing.is_empty():
		_finish_site(peer, id)
		_say(peer, "Pulled %s. Built." % ", ".join(pulled))
	else:
		_say(peer, "Pulled %s. Still needed: %s." % [", ".join(pulled), ", ".join(missing)])


# A cost line's name in a sentence: a group reads under its label ("bronze nails or better"), so the player sees which items fill it.
func _item_name_lower(item_id: String) -> String:
	var number: int = table.number_of(item_id)
	return table.cost_sentence(number) if number > 0 else table.in_sentence(item_id)


# Every material is in: the site becomes the real piece (a campfire site becomes a laid fire, as a Campfire set down from the pack).
func _finish_site(peer: int, id: int) -> void:
	var it: Dictionary = _items[id]

	if _is_fire_site(it):
		_items.erase(id)
		_lay_fire(peer, int(it["number"]), it["pos"])

		for owner_peer in _peer_key:
			if int(owner_peer) != peer and str(_peer_key[owner_peer]) == str(it["struct"].get("owner", "")):
				_goal_event(int(owner_peer), "placed", "campfire")   # a friend's last hammer blow: the one who laid the blueprint gets the goal too
				break

		_dirty = true
		save_soon([_next_id - 1])
		return

	if not (it["struct"]["site"] as Dictionary).get("kinds", {}).is_empty():
		it["struct"]["kinds"] = it["struct"]["site"]["kinds"]   # a take-down gives back what was put in (_refund_blueprint)

	it["struct"].erase("site")
	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
	_grid_add(id, it)
	_add_roof(it)
	_after_built(peer, it, def)

	for owner_peer in _peer_key:
		if int(owner_peer) != peer and str(_peer_key[owner_peer]) == str(it["struct"].get("owner", "")):
			_goal_event(int(owner_peer), "placed", str(it["struct"]["kind"]))   # a friend's last hammer blow: the one who laid the blueprint gets the goal too
			break
	_tank_split_pipe(id)
	_water_add(id)
	_dirty = true
	save_soon([id])   # a finished building is never lost to a crash


# Taking a site down gives back everything deposited (100 percent, like any blueprint).
# The floor under a spot: the foundation top there, else the spot (what another player's piece gives back lands there, not in the air).
func _floor_under(at: Vector3) -> Vector3:
	var top: float = PlacementRules.foundation_top(_structures_cfg, at, _foundation_rows())
	return Vector3(at.x, top, at.z) if not is_nan(top) else at


func _take_down_site(peer: int, _inv, id: int, for_builder: bool = false) -> void:   # for_builder: another player's site on your foundation
	var it: Dictionary = _items[id]

	for item_id in _site_of(it).get("have", {}):
		var count: int = int(_site_of(it)["have"][item_id])

		if count > 0:
			var was_src: String = _gain_source
			_gain_source = SRC_RETURN

			for pair in _kinds_back(str(item_id), count, _site_of(it).get("kinds", {})):
				if for_builder:
					drop_in_world(int(pair[0]), int(pair[1]), _floor_under(it["pos"]), 0, CLEARED_LIFETIME_S)
				else:
					give(peer, int(pair[0]), int(pair[1]))

			_gain_source = was_src

	_items.erase(id)
	_dirty = true


# --- Solid footprints (Dave 3 Nov 2026): the server knows where walls and heavy stations stand, so animals can be stopped by them ---
const StructureGridScript := preload("res://src/stream/structure_grid.gd")
var _grid = StructureGridScript.new()


# Registers a freshly placed or loaded structure when its structures.json row says "blocks_walk".
func _grid_add(id: int, entry: Dictionary) -> void:
	_zone_add(id)   # every structure, a blueprint site too, blocks spawning round it
	_note_support(id, entry)   # read by the next _rebuild_supports, as the old full scan found it

	if entry["struct"].has("site"):
		return   # a blueprint site is walked through and blocks nothing until it is finished (_finish_site)

	var kind: String = str(entry["struct"]["kind"])
	var def: Dictionary = _structures.get(kind, {})

	if bool(def.get("blocks_walk", false)):
		_grid.add(id, kind, entry["pos"].x, entry["pos"].z, float(entry["struct"]["yaw"]), float(def.get("grid_x", def.get("footprint_x", 1.0))), float(def.get("footprint_z", 1.0)))   # grid_x: a shut door stops animals across its whole frame, jambs too (BUGLIST-002)


# True when a wall or a heavy station stands over (x, z); margin grows each piece by an animal's body radius.
func structure_blocks(x: float, z: float, margin: float = 0.0) -> bool:
	return _grid.blocks(x, z, margin, _items)


# --- No-spawn zones (Dave 17 Nov 2026): nothing wild appears or regrows within no_spawn_m of anything put down (spawn_zones.gd) ---
const SpawnZonesScript := preload("res://src/stream/spawn_zones.gd")
var _spawn_zones = SpawnZonesScript.new()


# Registers a freshly placed or loaded row when it is something put down (a structure or a fire). Every spawner asks spawn_blocked.
func _zone_add(id: int) -> void:
	var entry: Dictionary = _items[id]

	if SpawnZonesScript.counts(entry) and _carts.vehicle_of(entry).is_empty() and not entry.get("fire", {}).has("marks"):   # a bandit camp's boot prints are no build   # a cart or barrow goes where it is pulled: not a build
		_spawn_zones.add(id, entry["pos"].x, entry["pos"].z)


# True when something a player put down (or a town piece) still stands within no_spawn_m of (x, z): no sapling, animal or other wild thing
# appears there. What already stood there stays; once the last piece near is gone, spawning comes back.
func spawn_blocked(x: float, z: float) -> bool:
	return _spawn_zones.blocked(x, z, _items)


# True when the straight step from (x0, z0) to (x1, z1) goes through such a piece: a long stride cannot jump a thin wall.
func structure_blocks_step(x0: float, z0: float, x1: float, z1: float, margin: float = 0.0) -> bool:
	return _grid.segment_blocked(x0, z0, x1, z1, margin, _items)


func _add_roof(entry: Dictionary) -> void:
	if entry["struct"].has("site"):
		return

	var def: Dictionary = _structures.get(str(entry["struct"]["kind"]), {})
	var box: Array = CoverScript.structure_roof(def, entry["pos"], deg_to_rad(float(entry["struct"]["yaw"])))

	if box.is_empty() or not roof_add.is_valid() or entry["struct"].has("roof"):
		return

	entry["struct"]["roof"] = int(roof_add.call(box))


# After loading a save and wiring roof_add: put every saved structure's roof in the cover index.
func register_roofs() -> void:
	for id in _items:
		if _items[id].has("struct"):
			_add_roof(_items[id])


# True when another placed piece stands on this foundation (on its top, inside its footprint).
func _stands_on(base: Dictionary, def: Dictionary) -> bool:
	var half_x: float = float(def.get("footprint_x", 4.0)) * 0.5 + 0.1
	var half_z: float = float(def.get("footprint_z", 4.0)) * 0.5 + 0.1
	var row: Dictionary = {"pos": base["pos"], "yaw": float(base["struct"].get("yaw", 0.0))}

	for other in _items.values():
		if other == base or not other.has("struct") or not bool(_structures.get(str(other["struct"]["kind"]), {}).get("piece", false)):
			continue

		var local: Vector2 = PlacementRules.local_of(row, other["pos"])   # along the foundation's own sides, at its turn

		if other["pos"].y - base["pos"].y > 0.1 and absf(local.x) <= half_x and absf(local.y) <= half_z:
			return true

	return false


# Whether a building piece rests on `base` alone: a roof panel or corner on its wall top, a ceiling on the walls round it, a door in its doorway. Each piece
# near it and above its foot is snapped again where it stands (PlacementRules.snap, as when it was placed): held there with `base`, and not without it
# (physical world audit round 5, 23 Nov 2026: a wall under a roof came down and left the roof in the air; only a foundation was asked). A piece that
# still rests on something else (a panel on two walls, a ceiling on its other walls) does not hold `base` up. Rows within HOLDS_UP_ROWS_M only, so a
# take-down reads the pieces round it, never the whole world.
const HOLDS_UP_NEAR_M := 4.5    # a piece resting on `base` stands this close to it across the ground (a 65 panel's middle is a run off its wall top)
const HOLDS_UP_SNAP_M := 7.0    # the rows one piece's snap reads round it (a foundation's anchors, a panel's edges, ROOF_ROW_REACH_M)
const HOLDS_UP_ROWS_M := HOLDS_UP_NEAR_M + HOLDS_UP_SNAP_M   # the rows read at all


func _holds_up(base: Dictionary, base_id: int) -> bool:
	var rows: Array = []
	var near: Array = []
	var flat: Vector2 = Vector2(base["pos"].x, base["pos"].z)

	for id in _items:
		var other: Dictionary = _items[id]

		if not other.has("struct"):
			continue

		var apart: float = Vector2(other["pos"].x, other["pos"].z).distance_to(flat)

		if apart > HOLDS_UP_ROWS_M:
			continue

		var odef: Dictionary = _structures.get(str(other["struct"]["kind"]), {})

		if not (bool(odef.get("foundation", false)) or bool(odef.get("piece", false))):
			continue

		var row: Dictionary = {"pos": other["pos"], "state": int(odef["state"]), "yaw": float(other["struct"].get("yaw", 0.0)), "id": int(id)}
		rows.append(row)

		# Fences stand on a foundation's anchors or the ground: they rest on nothing a take-down of `base` can pull out. An upper storey's wall stands on a
		# ceiling or a lower wall's top (PlacementRules.storey_tops_at), so it is asked like a ceiling.
		if int(id) != base_id and apart <= HOLDS_UP_NEAR_M and float(other["pos"].y) > float(base["pos"].y) + 0.05 and str(odef.get("kit", "")) != "" and not bool(odef.get("foundation", false)) and str(odef.get("piece_kind", "")) != PlacementRules.FENCE_KIND:
			near.append(row)

	for row in near:
		var kit: String = str(_structures[str(_items[int(row["id"])]["struct"]["kind"])]["kit"])
		var at: Vector2 = Vector2(row["pos"].x, row["pos"].z)
		var others: Array = rows.filter(func(r): return int(r["id"]) != int(row["id"]) and Vector2(r["pos"].x, r["pos"].z).distance_to(at) <= HOLDS_UP_SNAP_M)
		var without: Array = others.filter(func(r): return int(r["id"]) != base_id)

		var roof: bool = str(_structures[str(_items[int(row["id"])]["struct"]["kind"])].get("piece_kind", "")) in [PlacementRules.ROOF_PANEL_KIND, PlacementRules.ROOF_HIP_KIND]

		for mode in ([0, 1] if roof else [0]):   # the second mode is a roof's other slope: walls and ceilings snap the same either way
			var with_it: Array = PlacementRules.snap(_structures_cfg, kit, row["pos"], int(round(float(row["yaw"]))), others, mode)

			if not bool(with_it[2]) or (with_it[0] as Vector3).distance_to(row["pos"]) > 0.05:
				continue

			var alone: Array = PlacementRules.snap(_structures_cfg, kit, row["pos"], int(round(float(row["yaw"]))), without, mode)

			if not bool(alone[2]) or (alone[0] as Vector3).distance_to(row["pos"]) > 0.05:
				return true

			break

	return false


# Whether a station, furniture or a fire stands on the top of floor `base` (a foundation or a ceiling cell, structures row `def`), as PlacementRules.support_top
# set it there: taking the floor down would leave it in the air (Dave 17 Nov 2026: stations go on foundations and upper floors).
func _holds_station(base: Dictionary, def: Dictionary) -> bool:
	if not bool(def.get("foundation", false)) and str(def.get("piece_kind", "")) != "floor":
		return false

	var row: Dictionary = {"pos": base["pos"], "yaw": float(base["struct"].get("yaw", 0.0))}
	var top: float = float(base["pos"].y) + PlacementRules.anchor_top(def)

	for other in _items.values():
		if other == base or not (other.has("fire") or (other.has("struct") and not bool(_structures.get(str(other["struct"]["kind"]), {}).get("piece", false)))):
			continue

		if absf(float(other["pos"].y) - top) < 0.05 and PlacementRules.holds(def, row, other["pos"]):
			return true

	return false


# Only the builder takes a placed piece or site down, or an admin in admin mode (coordinator for Dave, 22 Nov 2026: friends must not take each other's
# houses apart for the materials). A piece with no owner (placed before owners were kept on every piece, or by the world) stays open to anyone.
func _may_take_down(peer: int, it: Dictionary) -> bool:
	var owner: String = str(it.get("struct", {}).get("owner", ""))
	var key: String = str(_peer_key.get(peer, ""))

	if owner == "" or owner == key or (admin_mode_on.is_valid() and bool(admin_mode_on.call(peer))):
		return true

	if key != "" and str(_structures.get(str(it.get("struct", {}).get("kind", "")), {}).get("attach_to", "")) == PlacementRules.DOOR_ATTACH and _frame_owner_at(it["pos"]) in [key, ""]:
		return true   # a door another player hung in your doorway (or in an old frame open to all): you may take it out, or the frame could never come down

	if key != "" and _base_owners_of(it).has(key):
		return true   # a piece another player built on your foundation (coordinator 23 Nov 2026): you may take it down; its materials stay there (_take_down)

	var lock: Dictionary = _lock_of(it)   # a locked container: a player the owner let in may take it down too (s3.13 locked-crate movement rule)
	return not lock.is_empty() and key != "" and ((lock.get("ok", []) as Array).has(key) or (lock.get("allow", []) as Array).has(key))


# The builders of the foundation a building piece stands on. A wall, ceiling, door or other piece: the foundations with the highest top at or
# below its foot (a stacked one: only the slab it is on) whose footprint holds it across the ground (BASE_EDGE_M; a wall on the edge between
# two: both). A roof panel or corner: the owners of what it rests on (_rests_on: the wall tops, ceiling edges or panel ends it snaps to),
# however far its eaves reach out, so a stranger's eave cannot pin your walls, and a neighbour's eave near your edge is not yours. A piece on the
# ground beside a foundation stands on none. Anyone may build on a foundation, and its owner may take down what others built there
# (coordinator 23 Nov 2026: a stranger cannot wall you in for good). Owners saved as "" are left out.
const BASE_EDGE_M := 0.1
const BASE_ROOF_DEPTH := 6   # a chain of panels this long is followed down to its walls


func _base_owners_of(it: Dictionary, depth: int = 0, seen: Dictionary = {}) -> Array:   # seen: the roof pieces already followed (each once)
	var def_it: Dictionary = _structures.get(str(it.get("struct", {}).get("kind", "")), {})

	if not bool(def_it.get("piece", false)) or depth > BASE_ROOF_DEPTH:
		return []

	if str(def_it.get("piece_kind", "")) in [PlacementRules.ROOF_PANEL_KIND, PlacementRules.ROOF_HIP_KIND]:
		var from: Array = []
		var walked: Dictionary = seen if depth > 0 else {}
		walked[it] = true

		for rid in _rests_on(it):
			if walked.has(_items[rid]):
				continue

			for o in _base_owners_of(_items[rid], depth + 1, walked):
				if not from.has(o):
					from.append(o)

		return from

	var best_top: float = -INF
	var owners: Array = []

	for id in _items:
		var base: Dictionary = _items[id]

		if base == it or not base.has("struct") or base["struct"].has("site") or Vector2(base["pos"].x - it["pos"].x, base["pos"].z - it["pos"].z).length() > 12.0:
			continue

		var def: Dictionary = _structures.get(str(base["struct"]["kind"]), {})

		if not bool(def.get("foundation", false)):
			continue

		var top: float = float(base["pos"].y) + PlacementRules.anchor_top(def)
		var local: Vector2 = PlacementRules.local_of({"pos": base["pos"], "yaw": float(base["struct"].get("yaw", 0.0))}, it["pos"])

		if top > float(it["pos"].y) + 0.05 or absf(local.x) > float(def.get("footprint_x", 4.0)) * 0.5 + BASE_EDGE_M or absf(local.y) > float(def.get("footprint_z", 4.0)) * 0.5 + BASE_EDGE_M:
			continue

		if top > best_top + 0.05:
			best_top = top
			owners = []

		if top >= best_top - 0.05:
			owners.append(str(base["struct"].get("owner", "")))

	return owners.filter(func(o): return o != "")


# The building pieces a placed piece rests on: each one without which it no longer snaps where it stands (as _holds_up asks the other way round),
# and each wall, ceiling or foundation that alone would hold it there (never a neighbouring panel that merely meets its end: owners come from
# walls, floors and foundations, so a mate built on your ridge from a neighbour's wall gives that neighbour nothing).
func _rests_on(it: Dictionary) -> Array:
	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
	var at: Vector2 = Vector2(it["pos"].x, it["pos"].z)
	var rows: Array = []

	for id in _items:
		var other: Dictionary = _items[id]

		if other == it or not other.has("struct") or other["struct"].has("site") or Vector2(other["pos"].x, other["pos"].z).distance_to(at) > HOLDS_UP_SNAP_M:
			continue

		var odef: Dictionary = _structures.get(str(other["struct"]["kind"]), {})

		if bool(odef.get("foundation", false)) or bool(odef.get("piece", false)):
			rows.append({"pos": other["pos"], "state": int(odef["state"]), "yaw": float(other["struct"].get("yaw", 0.0)), "id": int(id)})

	var kit: String = str(def.get("kit", ""))
	var yaw: int = int(round(float(it["struct"].get("yaw", 0.0))))
	var out: Array = []

	for mode in [0, 1]:
		var with_all: Array = PlacementRules.snap(_structures_cfg, kit, it["pos"], yaw, rows, mode)

		if not bool(with_all[2]) or (with_all[0] as Vector3).distance_to(it["pos"]) > 0.05:
			continue

		for row in rows:
			if float(row["pos"].y) > float(it["pos"].y) + 0.05:
				continue   # nothing above it holds it up

			var without: Array = PlacementRules.snap(_structures_cfg, kit, it["pos"], yaw, rows.filter(func(r): return r != row), mode)
			var only: Array = PlacementRules.snap(_structures_cfg, kit, it["pos"], yaw, [row], mode)

			var roof_row: bool = str(_structures.get(str(_items[int(row["id"])]["struct"]["kind"]), {}).get("piece_kind", "")) in [PlacementRules.ROOF_PANEL_KIND, PlacementRules.ROOF_HIP_KIND]

			if not bool(without[2]) or (without[0] as Vector3).distance_to(it["pos"]) > 0.05 or (not roof_row and bool(only[2]) and (only[0] as Vector3).distance_to(it["pos"]) <= 0.05):
				out.append(int(row["id"]))   # it needs this one, or this wall or ceiling alone holds it (a panel on two walls rests on both); a panel meeting its end at a ridge only when it needs it

		break

	return out


# The builder of the doorway frame a door hangs in ("" for a frame saved before owners, "-" when no frame is within DOOR_TAKEN_M).
func _frame_owner_at(at: Vector3) -> String:
	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or (it["pos"] as Vector3).distance_to(at) >= PlacementRules.DOOR_TAKEN_M:
			continue

		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

		if str(def.get("opening", "")) != "" and str(def.get("attach_to", "")) != PlacementRules.DOOR_ATTACH:   # a door carries "opening" too: only the frame
			return str(it["struct"].get("owner", ""))

	return "-"   # no frame here: nobody gets the door by the frame rule


# Taking a structure down (E near it) gives its kit back. A chest with things in it cannot be taken down.
func _take_down(peer: int, inv, id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not _peer_pos.has(peer) or _peer_pos[peer].distance_to(_reach_point(it, _peer_pos[peer])) > Interact.server_reach_m():
		return

	if str(it["struct"].get("kind", "")) == "carcass":
		_pick_up_whole(peer, id)   # a whole catch put down again; any other carcass is worked where it lies
		return

	_kiln_lit_by.erase(id)   # a kiln taken down forgets who lit it (ADD-18)

	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

	if not _may_take_down(peer, it):
		_say(peer, "Only the one who built it can take it down.")
		return

	if str(def.get("opening", "")) != "" and str(def.get("attach_to", "")) != PlacementRules.DOOR_ATTACH and PlacementRules.door_at(_structures_cfg, it["pos"], _foundation_rows()):
		_say(peer, "Take the door out first.")   # a doorway frame, built or still a site, never leaves its door hanging in the air (BUGLIST-002)
		return

	# Another player's piece (or blueprint site) on your foundation: it comes down, and what it gives back lies on the floor for its builder,
	# never in your pack; it waits there however long they are away.
	var key: String = str(_peer_key.get(peer, ""))
	var for_builder: bool = str(it["struct"].get("owner", "")) not in ["", key] and not (admin_mode_on.is_valid() and bool(admin_mode_on.call(peer))) and _base_owners_of(it).has(key)

	if it["struct"].has("site"):
		_take_down_site(peer, inv, id, for_builder)
		return

	if it["struct"].has("bandit"):
		_say(peer, "That belongs to the bandits' camp.")
		return

	if _tribe_piece_refuses(peer, id):
		return

	if str(def.get("hand_laid", "")) != "":
		_take_down_laid(peer, inv, id, it, def)   # a pipe run, tap or drip head laid from the hand (PLUMBING_DESIGN s9)
		return

	if def.is_empty() or str(def.get("kit", "")) == "":
		return

	if not _may_access(peer, it):
		_say(peer, "It is locked.")   # only the owner or a player with access takes a locked container down (s3.13 locked-crate movement rule)
		return

	if it["struct"].has("on"):
		_say(peer, "Set it down off the %s first." % _carts.noun_for(id))
		return

	if not _carts.vehicle_of(it).is_empty():
		_carts.dismantle(peer, inv, id)   # a cart comes apart with its cargo and crates kept safe (all or nothing)
		return

	if str(def.get("use", "")) == "serve" and not _platter_return(peer, inv, it, def):
		return

	if _platter_on(it):
		_say(peer, "Take the platter off it first.")   # a table never leaves a platter floating
		return

	if _smithies.broken(id):
		_say(peer, "Needs repair")   # a worn-out smithy is repaired before it comes down (PROVISIONAL, GOALS-REPAIR A-23)
		return

	if not _struct_empty(id):
		_say(peer, "Empty it first.")
		return

	if (bool(def.get("foundation", false)) and _stands_on(it, def)) or _holds_station(it, def) or (bool(def.get("piece", false)) and _holds_up(it, id)):
		_say(peer, "Take down what stands on it first.")
		return

	var into = InventoryScript.pack(table) if for_builder else inv

	if _blueprint_of_kit.has(str(def["kit"])):   # a blueprint piece gives its materials back, all of them
		if not _refund_blueprint(peer, into, _blueprints[int(_blueprint_of_kit[str(def["kit"])])], true, it["struct"].get("kinds", {})):
			return
	elif into.add(table.number_of(str(def["kit"])), 1, int(it.get("wear", 0))) > 0:
		_say(peer, "Make room in your pack first.")
		return      # a placed torch comes back as its torch, unmarked: lit in the hand when it is pulled out again (only a pack at MAX_SLOTS refuses)

	if for_builder:
		for s in into.slot_count:
			if into.numbers[s] != 0:
				drop_in_world(into.numbers[s], into.counts[s], _floor_under(it["pos"]), into.wear[s], CLEARED_LIFETIME_S, NAN, NAN, "", into.inst_of(s))

		_say(peer, "Taken down. It was another player's: what it was built from lies here for them.")

	if it["struct"].has("roof") and roof_remove.is_valid():
		roof_remove.call(int(it["struct"]["roof"]))

	_chests.erase(int(it["struct"].get("uid", 0)))
	_items.erase(id)
	_dirty = true

	for viewer in _chest_viewer.keys():
		if int(_chest_viewer[viewer]) == id:
			_chest_viewer.erase(viewer)   # another player who had it open: nothing more is pushed for it (its window closes as the row goes)

	if bool(def.get("foundation", false)) or str(def.get("piece_kind", "")) == "floor":
		_resettle_on(it["pos"], FLOOR_ROWS_REACH_M)   # what lay on it comes down

	if _is_plot_kind(str(it["struct"]["kind"])):
		for cell in _bed_cells(it):
			_crops.erase(_bed_key(cell))   # a garden plot taken down takes its crops with it, so a plot built there later starts empty

	if str(def.get("attach_to", "")) == "fire":
		_refresh_pots()   # the fire keeps burning and gets its tiers back

	if def.has("support"):
		_rebuild_supports()

		if support_changed.is_valid():
			support_changed.call(it["pos"])


# E at a chopping block: one log becomes firewood; the axe wears one use. The server checks the reach,
# a log in the pack, a usable axe on the hotbar and the pace.
func _use_struct(peer: int, inv, id: int, choice: int = 0, held_slot: int = -1) -> void:   # held_slot: the pack slot in hand (the chopping block's axe)
	var it: Dictionary = _items.get(id, {})

	if it.has("fire"):
		_put_out_fire(peer, id)
		return

	if it.is_empty() or not it.has("struct") or not _peer_pos.has(peer):
		return

	if it["struct"].has("site"):
		_say(peer, "Hit the blueprint with a hammer to add the materials.")   # only the hammer fills a site (Dave 18 Nov 2026)
		return

	var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})

	if _peer_pos[peer].distance_to(it["pos"]) > float(def.get("use_reach_m", 3.0)):
		return

	if _traps != null and _traps.collect(peer, id):   # a snare or bird trap holding its catch: E takes the catch whole and sets the trap again (Dave 25 Nov 2026)
		return

	if str(def.get("use", "")) == "serve":   # a placed Serving Platter (master s3.15): E eats one portion of its board
		_serve(peer, id, choice)
		return

	if _water_kind.has(id) and _is_pumpable(_water.pieces[id]):   # a well or pump: E starts working it, E again stops
		_toggle_pump(peer, id)
		return

	if str(def.get("use", "")) == "water_gate":
		_toggle_water_gate(peer, id, def)
		return

	if str(def.get("use", "")) == "tap":   # a Copper - Tap (Dave 19 Nov 2026): E takes a drink while its pipes reach water
		_drink_at_tap(peer, inv, id)
		return

	if str(def.get("use", "")) == "door":
		# A door opens and shuts: the structure turns into its other kind (structures.json "toggle"), the row's state follows.
		var now_ms: int = Time.get_ticks_msec()

		if now_ms - int(_last_use.get(peer, -100000)) >= int(def.get("use_pace_ms", 400)) and _structures.has(str(def.get("toggle", ""))):
			_last_use[peer] = now_ms
			it["struct"]["kind"] = str(def["toggle"])
			_grid_add(id, it)   # a shut door or gate ("blocks_walk") stops animals again; the open one is forgotten by the grid itself (its kind changed)

			if bool(_structures[str(def["toggle"])].get("blocks_walk", false)):
				_free_trapped(it["pos"])   # shut on someone in the frame: they step out
			_dirty = true

		return

	if str(def.get("use", "")) == "light":   # a torch, chandelier or fireplace: E with its fuel in the pack lights it (comfort counts only lit lights)
		_light_fixture(peer, inv, it, def)
		return

	if str(def.get("use", "")) == "set_spawn":   # E on a bed: it becomes this character's spawn point (set_spawn_bed)
		set_spawn_bed(peer, id)
		return

	if str(def.get("use", "")) == "unpile":
		# A rock pile gives back all the stones it was made of (what does not fit in the pack lies on the ground). Only its builder unpiles it.
		if not _may_take_down(peer, it):
			_say(peer, "Only the one who built it can take it down.")
			return

		var was_src: String = _gain_source
		_gain_source = SRC_RETURN
		give(peer, table.number_of("stone"), int(def.get("stones", 90)))
		_gain_source = was_src
		_items.erase(id)
		_dirty = true
		return

	if str(def.get("use", "")) == "kiln":   # E lights the Kiln while it holds wood and puts it out (master s2.6)
		_kiln_use(peer, id, it, def)
		return

	if _smelters.is_smelter(def):   # E at a Smelter lights it or puts it out, as a campfire; at a lit Improved smelter it works the bellows (hold E, choice 1, puts it out)
		_smelters.use(peer, id, it, def, choice)
		return

	if str(def.get("use", "")) != "split_log":
		return

	var now: int = Time.get_ticks_msec()

	if float(now - int(_last_use.get(peer, -100000))) < float(def.get("use_pace_ms", 600)) / _pace_factor(peer, "split_log"):
		return

	# The chopping block splits a Wooden block into Firewood (Dave 15 Nov 2026: it "will pick up blocks from the ground or from a cart or from any container
	# around you or your inventory"): one E with an axe in hand takes one block from the craft stock (pack first, then the ground, carts and containers in
	# reach) and drops firewood_per_block (4, TREE_WOOD_TOOLS_DESIGN.md W-3) beside the block.
	var axe: int = _held_tool(inv, held_slot, "axe")

	if axe < 0:
		if not _say_hands_full(peer, inv):
			_say(peer, "You need an axe in hand to split wood.")

		return

	if _stock_take(inv, table.number_of("wooden_block"), 1, _stock_of(peer)) < 1:
		_say(peer, "You need a wooden block to split. Saw a log into blocks first.")
		return

	_last_use[peer] = now
	_drop_firewood_beside(it, int(def.get("firewood_per_block", 4)))   # the pack change goes out with the action (_action)
	_goal_made(peer, table.number_of("firewood"))   # splitting by hand counts like one craft of the firewood (GOALS-REPAIR F3)
	_wear_slot(peer, inv, axe, "split")
	practice(peer, "split_log")
	_dirty = true


# Split firewood falls beside the chopping block and joins the heap lying there (drop_in_world merges it, PILE_CAP and the pile lifetime included);
# six or more make a pile the client draws from the count (bug 3: before, this had its own merge capped at the 40 stack with the 20-minute loose lifetime).
func _drop_firewood_beside(block: Dictionary, count: int) -> void:
	drop_in_world(table.number_of("firewood"), count, block["pos"] + Vector3(0.9, 0.0, 0.0))


const BLOCK_SPLIT_BLOWS := 2   # axe blows that split a loose wooden block


# A wooden block lying on the ground, struck with an axe, splits into firewood_per_block Firewood (4, W-3) after BLOCK_SPLIT_BLOWS blows. A log
# struck with an axe does not split (TREE_WOOD_TOOLS_DESIGN.md: logs are sawn into blocks) and the player is told so.
# With a pick (Dave 12 Nov 2026: "if you break a log with a pickaxe it will just leave a pile of kindling") a log takes 1 / speed blows, each tearing
# loose kindling and thatch, and the log is left as a pile of kindling where it lay.
func _chop_loose_log(peer: int, inv, id: int, tool: Array) -> void:   # `tool`: the wood tool in hand, _wood_tool (checked by _process_trunk)
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or it.has("struct") or it.has("tree") or it.has("fire") or it.has("scatter") or not _peer_pos.has(peer):
		return

	var item_id: String = table.id_of(int(it["number"]))
	var big: bool = is_shoulder_item(int(it["number"]))
	var block: bool = item_id == "wooden_block"

	if item_id != "log" and not big and not block:
		return

	if _peer_pos[peer].distance_to(it["pos"]) > PROCESS_REACH_M + 1.0:
		return

	var now: int = Time.get_ticks_msec()

	if float(now - int(_last_process.get(peer, -100000))) < float(PROCESS_COOLDOWN_MS):
		return

	_last_process[peer] = now

	if str(tool[1]) == "pick":
		if block:
			_say(peer, "Split a wooden block with an axe.")
			return

		_wear_slot(peer, inv, int(tool[0]), "split")
		var rng: RandomNumberGenerator = RandomNumberGenerator.new()
		var work: float = float(it.get("pick_work", 0.0)) + float(tool[2])
		rng.seed = hash([id, int(work * 1000.0)])
		_pick_splinters(peer, rng)
		it["pick_work"] = work
		_dirty = true

		if work < 1.0 - 0.001:
			return

		it.erase("pick_work")

		if int(it["count"]) > 1:
			it["count"] = int(it["count"]) - 1
		else:
			_items.erase(id)

		drop_in_world(table.number_of("kindling"), _pick_kindling(big), it["pos"] + Vector3(0.0, 0.1, 0.0))

		if table.is_softwood_log(int(it["number"])) and int(table.tree_sap.get("per_softwood_log", 0)) > 0:   # a softwood log picked apart is processed too (Dave 16 Nov 2026)
			drop_in_world(table.number_of(str(table.tree_sap.get("item", ""))), int(table.tree_sap.get("per_softwood_log", 0)), it["pos"] + Vector3(0.0, 0.1, 0.0))

		return

	if not block:
		_say(peer, "Saw the log into wooden blocks first, then split the blocks.")
		return

	_wear_slot(peer, inv, int(tool[0]), "split")
	var blows: int = int(it.get("split_blows", 0)) + 1
	_dirty = true

	if blows < BLOCK_SPLIT_BLOWS:
		it["split_blows"] = blows
		return

	it.erase("split_blows")

	if int(it["count"]) > 1:
		it["count"] = int(it["count"]) - 1
	else:
		_items.erase(id)

	drop_in_world(table.number_of("firewood"), int(_structures.get("chopping_block", {}).get("firewood_per_block", 4)), it["pos"] + Vector3(0.0, 0.1, 0.0))
	_goal_made(peer, table.number_of("firewood"))   # splitting by hand counts like one craft of the firewood (GOALS-REPAIR F3); the pick's kindling counts nothing
	practice(peer, "split_log")


# --- Station stores (master s2.5 [D1][R]; Mission 001 T18) ---
# A station whose structures.json row has "out_slots" keeps a store: its first `slots` slots are the input (players put in, under the row's
# takes; the inventory's usable stays at slots, so every put, Store all, Stack to nearby and view deposit lands there) and the next out_slots
# the output, which only the station's own production fills (a craft run there by its owner, the Kiln's batch). Products stay in the station and
# never drop on the ground; with no room for a craft's product the craft waits. The store is a container in every other way (owner, keep out,
# Phase 9 locks and _may_access, storage views, take-down only when empty), and crafts and building draw on it after the pack, the ground and
# the player's own containers (_stock_of).

func _out_slots(kind: String) -> int:
	return int(_structures.get(kind, {}).get("out_slots", 0))


# A crafting station with ONE store (Dave 17 Nov 2026: "in a station that has an inventory there should only be on inventory not a chest and
# crafting. it should have unlimited inventory slots starting with 20"): structures.json "one_store". Its store holds what is put in and what it
# makes alike, starts at its "slots" (20) and grows like a pack (Inventory.grows, up to MAX_SLOTS); no weight limit (it is never carried).
func _one_store(kind: String) -> bool:
	return bool(_structures.get(kind, {}).get("one_store", false))


# A station store that keeps its owner's products: output slots after its input, or one growing store.
func _keeps_products(kind: String) -> bool:
	return _out_slots(kind) > 0 or _one_store(kind)


# A new container's store: a one-store station's own "slots" (20), from which it grows; any other container at least BASE_SLOTS (30), more when its
# "slots" are more (the Fine, Large wooden and Ornate chests, Dave 18 Nov 2026: a row of 6 more per chest tier).
func _new_store(kind: String):
	return InventoryScript.new(table, int(_structures[kind]["slots"]) if _one_store(kind) else maxi(InventoryScript.BASE_SLOTS, int(_structures[kind].get("slots", 0))))


# The slots a container of `kind` fills from a put, Store all, Stack to nearby or a view deposit: its "slots", every slot of a one-store station
# (which then grows when full). Every caller that readies a container's `usable` comes here.
func _store_usable(kind: String, box) -> int:
	if _one_store(kind):
		box.grows = true
		var last: int = box.slot_count - 1

		while last >= 0 and box.numbers[last] == 0:
			last -= 1

		var want: int = maxi(int(_structures[kind].get("slots", 20)), last + 1)

		if want < box.slot_count:   # empty slots past the 20 and past the last thing in it are given back (a reload brings a chest's 30)
			box._resize(want)

		return box.slot_count

	var slots: int = int(_structures.get(kind, {}).get("slots", box.slot_count))

	if slots > box.slot_count:   # a store saved smaller than its row now says (chest rows grew 18 Nov 2026): the new slots are added empty
		box._resize(mini(slots, InventoryScript.MAX_SLOTS))

	return clampi(slots, 1, box.slot_count)


# The slots a take may reach in a container: its usable slots, and a station's output slots after them.
func _store_span(id: int, box) -> int:
	var kind: String = str(_items.get(id, {}).get("struct", {}).get("kind", "")) if id >= 0 else ""

	if _one_store(kind):
		return box.slot_count

	return mini(box.usable + (_out_slots(kind) if id >= 0 else 0), box.slot_count)


func _is_station_store(it: Dictionary) -> bool:
	return it.has("struct") and _keeps_products(str(it["struct"]["kind"])) and _is_storage(it)


# How many of an item (at this age and instance) a station's output slots still take; an instance only goes into an empty slot.
# A one-store station takes it anywhere in its store, and the slots it may still grow by.
func _out_room(it: Dictionary, number: int, item_inst: Dictionary = {}, item_wear: int = 0) -> int:
	var box = _chests.get(int(it["struct"].get("uid", 0)))
	var kind: String = str(it["struct"]["kind"])

	if box == null or number <= 0:
		return 0

	if _one_store(kind):
		var each: int = table.stack_of(number) if item_inst.is_empty() else 1
		var space: int = (InventoryScript.MAX_SLOTS - box.slot_count) * each

		for i in box.slot_count:
			if box.numbers[i] == 0:
				space += each
			elif item_inst.is_empty() and box.inst[i].is_empty() and box.numbers[i] == number and box._mergeable(number, box.wear[i], item_wear):
				space += maxi(table.stack_of(number) - box.counts[i], 0)

		return space

	var first: int = int(_structures.get(kind, {}).get("slots", 0))
	var stack: int = table.stack_of(number)
	var room: int = 0

	for i in range(first, mini(first + _out_slots(kind), box.slot_count)):
		if box.numbers[i] == 0:
			room += stack if item_inst.is_empty() else 1
		elif item_inst.is_empty() and box.inst[i].is_empty() and box.numbers[i] == number and box._mergeable(number, box.wear[i], item_wear):
			room += maxi(stack - box.counts[i], 0)

	return room


# Puts a product into a station's output slots (the caller checked _out_room); whoever has it open sees it come. Returns what did not fit.
func _out_add(id: int, number: int, count: int, item_wear: int = 0, item_inst: Dictionary = {}) -> int:
	var it: Dictionary = _items[id]
	var box = _chests[int(it["struct"]["uid"])]

	if _one_store(str(it["struct"]["kind"])):
		box.usable = _store_usable(str(it["struct"]["kind"]), box)
		var spill: int = box.add(number, count, item_wear, item_inst, FUEL_SLOT + 1 if _fuel_slot_kind(_structures.get(str(it["struct"]["kind"]), {})) else 0)   # a product never goes into a smithy's fuel slot
		_push_box(id, box)
		_dirty = true
		return spill

	var first: int = int(_structures.get(str(it["struct"]["kind"]), {}).get("slots", 0))
	box.usable = mini(first + _out_slots(str(it["struct"]["kind"])), box.slot_count)
	var left: int = box.add(number, count, item_wear, item_inst, first)
	box.usable = first
	_push_box(id, box)
	_dirty = true
	return left


# The store's fill for the world row (master s2.5 world-visible fill levels; the looks are placeholders): 0 empty, else 1 to 4 quarters of its
# slots in use, rounded up so one stack shows.
func _store_fill(it: Dictionary) -> int:
	var box = _chests.get(int(it["struct"].get("uid", 0)))
	var kind: String = str(it["struct"]["kind"])

	if box == null:
		return 0

	if BinRules.is_bin(_structures.get(kind, {})):
		return BinRules.fill_quarters(_structures[kind], box)   # a resource bin fills by units, not slots

	var total: int = box.slot_count if _one_store(kind) else mini(int(_structures.get(kind, {}).get("slots", 0)) + _out_slots(kind), box.slot_count)
	var used: int = 0

	for i in total:
		if box.numbers[i] != 0:
			used += 1

	return 0 if used == 0 or total <= 0 else clampi(ceili(4.0 * float(used) / float(total)), 1, 4)


# The station that keeps a finished craft: the one serving the recipe beside the player, when it has a store and the crafter owns it (a guest's
# product goes to their pack, as before, so it never lands in someone else's station). -1 for any other craft.
func _craft_store(peer: int, recipe: Dictionary, free_entry: bool) -> int:
	if free_entry or str(recipe.get("station", "")) == "":
		return -1

	var id: int = serving_station(peer, str(recipe["station"]), int(recipe.get("station_level", 1)))

	if id < 0 or not _is_station_store(_items[id]) or not CraftStock.owner_ok(str(_items[id]["struct"].get("owner", "")), str(_peer_key.get(peer, ""))):
		return -1

	return id


# --- The Kilns (master s2.6 [D1]; Mission 001 T18; Dave 17 Nov 2026: Primitive, Improved and Advanced kilns, any wood) ---
# Wood put in (structures.json kilns.yield: a log 100 Charcoal, a Firewood 10, a stick 5, kindling none) turns to charcoal while the kiln is lit:
# the biggest piece first, its yield in pieces, one every kilns.piece_s real seconds, into its output. A kiln holds wood worth batch_logs logs
# (kilns.yield.log each; a piece takes at least kilns.min_space of that room), the piece in the burn included. A piece is taken when its turn
# starts, so taking wood out never undoes a piece; a piece that yields nothing (kindling) burns away at once. With all its wood done and still
# lit, it burns its own charcoal, one every self_burn_s, and goes out when none is left. E lights it while it holds wood and puts it out; put out,
# it keeps everything (the part-burnt piece too). A full output pauses it (it stays lit).
# struct["kiln"] = {"left": pieces still to come from the piece in the burn, "t": seconds toward the next piece}; saved in kilns.json by the store's uid.

func _kilns_cfg() -> Dictionary:
	return _structures_cfg.get("kilns", {})


# The Charcoal one piece of this wood gives in a kiln (a species log counts as a log); -1 when a kiln does not burn it.
func _kiln_yield(number: int) -> int:
	var yields: Dictionary = _kilns_cfg().get("yield", {})
	var id: String = table.id_of(number)

	if yields.has(id):
		return int(yields[id])

	return int(yields.get("log", 100)) if table.group_members(table.number_of("log")).has(number) else -1


# The room one piece takes in a kiln, in Charcoal of yield.
func _kiln_space(number: int) -> int:
	return maxi(_kiln_yield(number), int(_kilns_cfg().get("min_space", 5)))


# The wood in a kiln's input slots, in room units, plus what is left of the piece in the burn.
func _kiln_load(it: Dictionary, box, def: Dictionary) -> int:
	var units: int = maxi(int(it["struct"].get("kiln", {}).get("left", 0)), 0)

	for i in mini(int(def.get("slots", 0)), box.slot_count):
		if box.numbers[i] != 0 and _kiln_yield(box.numbers[i]) >= 0:
			units += box.counts[i] * _kiln_space(box.numbers[i])

	return units


func _kiln_capacity(def: Dictionary) -> int:
	return int(def.get("batch_logs", 0)) * int(_kilns_cfg().get("yield", {}).get("log", 100))


# How many of `amount` pieces of `number` a kiln still takes (every put path: a put, Store all, a view deposit, Stack to nearby); `amount` for anything
# that is not a kiln.
func _kiln_room(id: int, box, number: int, amount: int) -> int:
	var def: Dictionary = _structures.get(str(_items.get(id, {}).get("struct", {}).get("kind", "")), {})

	if int(def.get("batch_logs", 0)) <= 0 or box == null:
		return amount

	if _kiln_yield(number) < 0:
		return 0

	@warning_ignore("integer_division")   # whole pieces that fit
	return clampi((_kiln_capacity(def) - _kiln_load(_items[id], box, def)) / _kiln_space(number), 0, amount)


# The input slot of a kiln holding its biggest piece of wood, or -1.
func _kiln_next_slot(box, def: Dictionary) -> int:
	var best: int = -1

	for i in mini(int(def.get("slots", 0)), box.slot_count):
		if box.numbers[i] != 0 and box.counts[i] > 0 and _kiln_yield(box.numbers[i]) >= 0 and (best < 0 or _kiln_yield(box.numbers[i]) > _kiln_yield(box.numbers[best])):
			best = i

	return best


# kiln world id -> the character key that lit it (server only, never sent: ADD-18 credits that character when the batch is done); saved in kilns.json row [3].
var _kiln_lit_by: Dictionary = {}


# E on a Kiln: lights it while it holds wood, puts it out when it burns.
func _kiln_use(peer: int, id: int, it: Dictionary, def: Dictionary) -> void:
	var box = _chests.get(int(it["struct"].get("uid", 0)))

	if box == null:
		return

	if bool(it["struct"].get("lit", false)):
		it["struct"]["lit"] = false
		_kiln_lit_by.erase(id)
		_say(peer, "You put the kiln out. What is in it stays.")
	elif _kiln_next_slot(box, def) < 0 and int(it["struct"].get("kiln", {}).get("left", 0)) <= 0:
		_say(peer, "Put wood in the kiln first (F).")
		return
	else:
		it["struct"]["lit"] = true
		it["struct"]["kiln"] = it["struct"].get("kiln", {"left": 0, "t": 0.0})
		_kiln_lit_by[id] = str(_peer_key.get(peer, ""))
		_say(peer, "The kiln is lit: a log gives %d charcoal, a firewood %d." % [_kiln_yield(table.number_of("log")), _kiln_yield(table.number_of("firewood"))])

	_dirty = true


# One slow tick of a lit Kiln (_lights_tick).
func _kiln_burn(id: int, it: Dictionary, def: Dictionary, spent: float) -> void:
	var box = _chests.get(int(it["struct"].get("uid", 0)))

	if box == null:
		it["struct"]["lit"] = false
		return

	var k: Dictionary = it["struct"].get("kiln", {"left": 0, "t": 0.0})
	it["struct"]["kiln"] = k
	var per: float = maxf(float(_kilns_cfg().get("piece_s", 3.0)), 0.01)
	var self_s: float = maxf(float(def.get("self_burn_s", 150.0)), 0.01)
	var charcoal: int = table.number_of("charcoal")
	var changed: bool = false
	k["t"] = float(k.get("t", 0.0)) + spent

	for _step in 1000:   # a slow tick is a quarter second, a few pieces at most; the cap only bounds a long jump
		if int(k.get("left", 0)) <= 0 and _kiln_next_slot(box, def) >= 0:
			var next: int = _kiln_next_slot(box, def)
			k["left"] = _kiln_yield(box.numbers[next])   # the next piece's turn starts: it is in the burn now (kindling: 0, it burns away)
			box.take_from_slot(next, 1)
			changed = true

			if int(k["left"]) <= 0:
				continue

		if int(k.get("left", 0)) > 0:
			if float(k["t"]) < per:
				break

			if _out_room(it, charcoal) <= 0:
				k["t"] = per   # full output pauses production
				break

			_out_add(id, charcoal, 1)
			k["left"] = int(k["left"]) - 1
			k["t"] = float(k["t"]) - per
			changed = true

			var after: int = _kiln_next_slot(box, def)

			if int(k["left"]) <= 0 and (after < 0 or _kiln_yield(box.numbers[after]) <= 0):   # ADD-18: the last piece of the batch is charcoal (kindling left gives none): the character who lit it (_kiln_lit_by), if online, else no one
				var lighter: String = str(_kiln_lit_by.get(id, ""))

				for lighter_peer in _peer_key:
					if lighter != "" and str(_peer_key[lighter_peer]) == lighter:
						_goal_event(int(lighter_peer), "kiln_charcoal")
						break
		else:
			if float(k["t"]) < self_s:
				break

			if box.remove(charcoal, 1):   # converted: it slowly burns its own charcoal
				k["t"] = float(k["t"]) - self_s
				changed = true
			else:
				it["struct"]["lit"] = false   # nothing left to burn: it goes out
				k["t"] = 0.0
				changed = true
				break

	if changed:
		_push_box(id, box)
		_dirty = true


func _load_kilns() -> void:
	var parsed: Variant = _read_json_version("kilns.json", 1)

	if parsed == null or typeof(parsed.get("kilns", null)) != TYPE_DICTIONARY or (parsed["kilns"] as Dictionary).is_empty():
		return

	for id in _items:
		var it: Dictionary = _items[id]

		if not it.has("struct") or not it["struct"].has("uid") or str(_structures.get(str(it["struct"]["kind"]), {}).get("use", "")) != "kiln":
			continue

		var row: Variant = parsed["kilns"].get(str(it["struct"]["uid"]), null)

		if typeof(row) == TYPE_ARRAY and (row as Array).size() >= 3:
			it["struct"]["lit"] = int(row[0]) == 1
			var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
			it["struct"]["kiln"] = {"left": clampi(int(row[1]), 0, int(_kilns_cfg().get("yield", {}).get("log", 100))), "t": clampf(float(row[2]), 0.0, maxf(float(_kilns_cfg().get("piece_s", 3.0)), float(def.get("self_burn_s", 150.0))))}

			if (row as Array).size() > 3 and typeof(row[3]) == TYPE_STRING and str(row[3]) != "" and bool(it["struct"]["lit"]):
				_kiln_lit_by[id] = str(row[3])   # who lit the burning batch: still credited after a restart (ADD-18)


# --- Serving platters (master s3.15 [D15]; catalog Phase 8) ---
# A placed Serving Platter is a one-slot container on a table top that takes only food boards (structures.json serving_platter). Its owner
# sets a board on it (the stack moves into the platter) and takes it back; anyone eats a portion with E, exactly as from the pack (one food
# of the board's group, Phase 7). Picking the platter up gives back the board's portions, then the platter. Nothing is ever copied: every
# portion is a count moved or eaten.
const PLATTER_APART_M := 0.35
var _serve_kinds_cache: Dictionary = {}


# The structure kinds that serve (structures.json use "serve"), read once: the world-item sync asks for every row.
func _serve_kinds() -> Dictionary:
	if _serve_kinds_cache.is_empty() and not _structures.is_empty():   # not cached before structures.json is read
		_serve_kinds_cache = {"": false}

		for kind in _structures:
			if str(_structures[kind].get("use", "")) == "serve":
				_serve_kinds_cache[kind] = true

	return _serve_kinds_cache


func _surface_rows(def: Dictionary) -> Array:
	var rows: Array = []
	var kinds: Dictionary = def.get("attach_kinds", {})

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and kinds.has(str(it["struct"]["kind"])) and not it["struct"].has("site"):
			rows.append({"pos": it["pos"], "state": int(_structures[str(it["struct"]["kind"])]["state"]), "yaw": float(it["struct"]["yaw"])})

	return rows


# A placed Serving Platter stands on this table (over its turned top, as PlacementRules.table_spot put it; a neighbouring table is not this one).
func _platter_on(table_it: Dictionary) -> bool:
	var kind: String = str(table_it.get("struct", {}).get("kind", ""))
	var table_def: Dictionary = _structures.get(kind, {})

	for id in _items:
		var it: Dictionary = _items[id]

		if it.has("struct") and _serve_kinds().has(str(it["struct"]["kind"])) and (_structures[str(it["struct"]["kind"])].get("attach_kinds", {}) as Dictionary).has(kind) and it["pos"].y > table_it["pos"].y and PlacementRules.over_table(table_def, table_it["pos"], float(table_it["struct"].get("yaw", 0.0)), it["pos"], 0.0):   # no margin: table_spot keeps a platter inside its own top, so a touching neighbour is free
			return true

	return false


func _platter_mine(peer: int, it: Dictionary) -> bool:
	if it.is_empty() or not it.has("struct") or str(_structures.get(str(it["struct"]["kind"]), {}).get("use", "")) != "serve":
		return true

	var owner: String = str(it["struct"].get("owner", ""))
	return owner == "" or owner == str(_peer_key.get(peer, ""))


# Before the platter itself comes up: its board goes back into the pack whole, or nothing moves.
func _platter_return(peer: int, inv, it: Dictionary, def: Dictionary) -> bool:
	if not _platter_mine(peer, it):
		_say(peer, "Only the one who set out this platter takes it up.")
		return false

	var plate = _chests.get(int(it["struct"].get("uid", 0)))

	if plate == null or plate.numbers[0] == 0:
		return true

	var probe = inv.copy()

	if _fit(peer, inv, plate.numbers[0], plate.counts[0]) < plate.counts[0] or probe.add(plate.numbers[0], plate.counts[0], plate.wear[0]) > 0 or probe.add(table.number_of(str(def.get("kit", ""))), 1) > 0:
		_say(peer, "No room in your pack for the board and the platter.")
		return false

	var before: Array = _snapshot(inv)
	inv.add(plate.numbers[0], plate.counts[0], plate.wear[0])
	plate.take_from_slot(0, plate.counts[0])
	_send_changes(peer, inv, before)
	_dirty = true
	return true


# E on a placed platter: one portion of its board, eaten by this player as from the pack; the question (food_ask) names the platter.
func _serve(peer: int, id: int, choice: int) -> void:
	var plate = _chests.get(int(_items[id]["struct"].get("uid", 0)))

	if plate == null or plate.numbers[0] == 0:
		_say(peer, "The platter is empty.")
		return

	var before: int = plate.counts[0]
	_eat(peer, plate, 0, choice, id)

	if plate.numbers[0] == 0 or plate.counts[0] != before:
		_push_box(id, plate)
		_dirty = true


func _struct_empty(id: int) -> bool:
	var chest = _chests.get(int(_items.get(id, {}).get("struct", {}).get("uid", 0)))

	if int(_items.get(id, {}).get("struct", {}).get("kiln", {}).get("left", 0)) > 0:
		return false   # a Kiln with a log still turning to charcoal holds that log

	if chest == null:
		return true

	for slot in range(chest.slot_count):
		if chest.numbers[slot] != 0:
			return false

	return true


# --- Chest contents: server-owned; the actor gets every slot after every open, put and take ---

# A campfire's own little store (Dave 2026-10-22, F beside a fire): a few slots for wood that feeds it and food that cooks on it.
# Made the first time anyone opens it. _tend_fire does the feeding and cooking.
func _fire_box(peer: int, it: Dictionary):
	if _peer_pos[peer].distance_to(it["pos"]) > CHEST_REACH_M or _camp_refuses(peer, it):
		return null

	var fire: Dictionary = it["fire"]
	var box = _fire_store(fire)

	if not bool(fire.get("synced", false)):
		_fire_unload_to_store(fire, box)   # a fire from before the store held its wood: its wood becomes pieces in the store, the first time it is opened

	return box


# The fire's own store, made on first use (no reach check: the placing code seeds it too). It stacks every item to the u16 count (Dave 2 Nov 2026).
func _fire_store(fire: Dictionary):
	if not _chests.has(int(fire.get("uid", 0))):
		fire["uid"] = _next_uid
		_next_uid += 1
		_chests[int(fire["uid"])] = InventoryScript.new(table)
		_dirty = true

	var box = _chests[int(fire["uid"])]
	box.usable = clampi(int(_cooking.get("fire_slots", 4)), 1, box.slot_count)
	box.stack_all = true
	return box


# The store is what the fire burns (Dave 2 Nov 2026): burn time and tier come from the wood in it, and wood burns out of it. A fire that still carries wood
# of its own (an older save, `synced` false) has that wood turned into plain pieces of its class in the store: stick, firewood or log.
func _fire_unload_to_store(fire: Dictionary, box) -> void:
	var wood: Dictionary = _fire_wood(fire)

	for cls in ["log", "firewood", "weak"]:
		var item_id: String = {"log": "log", "firewood": "firewood", "weak": "stick"}[cls]
		var each: float = float((_cooking.get("fuel", {}) as Dictionary).get(item_id, 900.0)) / GAME_RATE

		if float(wood[cls]) > 0.0 and each > 0.0:
			box.add(table.number_of(item_id), maxi(1, int(ceil(float(wood[cls]) / each - 0.0001))))

	fire["synced"] = true
	_fire_apply_store(fire, box)
	_dirty = true


# The seconds and pieces of wood by class that a store holds (a log is left out under a pot), the stored-fuel cap applied, written onto the fire.
func _fire_apply_store(fire: Dictionary, box) -> void:
	var fuel: Dictionary = _cooking.get("fuel", {})
	var seconds: Dictionary = {"log": 0.0, "firewood": 0.0, "weak": 0.0}
	var pieces: Dictionary = {"log": 0, "firewood": 0, "weak": 0}
	var damp: int = 0

	for slot in range(box.usable):
		var number: int = box.numbers[slot]

		if number == 0:
			continue

		var wood_id: String = table.id_of(number)

		if not fuel.has(wood_id):
			continue

		var cls: String = _fire_wood_class(wood_id)

		if cls == "log" and bool(fire.get("pot", false)):
			continue

		seconds[cls] = float(seconds[cls]) + float(box.counts[slot]) * float(fuel[wood_id]) / GAME_RATE
		pieces[cls] = int(pieces[cls]) + int(box.counts[slot])
		damp = maxi(damp, int(box.wear[slot]) if table.wood_class(number) != "" else 0)

	var wood: Dictionary = _fire_wood(fire)
	var laid: Dictionary = {}

	var burnt: Dictionary = fire.get("burnt", {})
	fire["counted"] = pieces.duplicate()   # the pieces this count knows; only these may burn out of the store (_fire_trim_store), never wood put in after it

	for cls in ["log", "firewood", "weak"]:
		# The piece that is half burned counts only what is left of it, so counting the store again never gives burned wood back.
		var burnt_was: float = float(burnt.get(cls, 0.0))

		if float(seconds[cls]) <= 0.0:
			burnt.erase(cls)
		else:
			burnt[cls] = minf(float(burnt.get(cls, 0.0)), float(seconds[cls]))
			seconds[cls] = float(seconds[cls]) - float(burnt[cls])

		if _charcoal_classes().has(cls):   # a half-burnt piece taken back out comes back whole: so does the charcoal it had made (a debt on the next)
			fire["char"] = float(fire.get("char", 0.0)) - (burnt_was - float(burnt.get(cls, 0.0))) * GAME_RATE / _charcoal_game_s()

		wood[cls] = maxf(float(seconds[cls]), 0.0)   # every piece in the store counts, however much (Dave 2 Nov 2026)

		if int(pieces[cls]) > 0:
			laid[cls] = int(pieces[cls])

	fire["pieces"] = laid
	fire["burnt"] = burnt
	fire["damp"] = damp   # the wettest wood in the store (fire design 5)
	_fire_sum(fire)


# Wood that has burned leaves the store: of each class, one whole piece goes for each piece's worth of burn time since the store was counted
# (fire["burnt"], added up by _fire_burn). Only burned wood goes: wood just put in while the store is open stays until the store is closed and counted
# (Dave 2 Nov 2026: a third log put in vanished, because the old trim compared the store with the fire's burn time before the close had counted it).
func _fire_trim_store(fire: Dictionary, box) -> bool:
	var fuel: Dictionary = _cooking.get("fuel", {})
	var burnt: Dictionary = fire.get("burnt", {})
	var removed: bool = false

	if not fire.has("counted"):   # a fire loaded from a save: what is in its store now is what was counted
		fire["counted"] = _fire_store_pieces(fire, box)

	var counted: Dictionary = fire["counted"]

	for cls in burnt.keys():
		for slot in range(box.usable):
			var number: int = box.numbers[slot]

			if number == 0 or not fuel.has(table.id_of(number)) or _fire_wood_class(table.id_of(number)) != cls or (cls == "log" and bool(fire.get("pot", false))):
				continue

			var each: float = float(fuel[table.id_of(number)]) / GAME_RATE

			while box.numbers[slot] == number and box.counts[slot] > 0 and int(counted.get(cls, 0)) > 0 and float(burnt[cls]) >= each - 0.01:
				box.take_from_slot(slot, 1)
				burnt[cls] = float(burnt[cls]) - each
				counted[cls] = int(counted[cls]) - 1
				removed = true
				print("fire store: one %s burned away (%s burned %.0f s, %d counted left)" % [table.id_of(number), cls, float(burnt[cls]) + each, int(counted[cls])])

		# Dave 2 Nov 2026 (the third log still vanished): burn time with no counted piece left to take (a fire whose burn time ran ahead of its store)
		# is not a debt on wood put in later. It goes, so a new piece stays until the next count.
		if int(counted.get(cls, 0)) <= 0:
			burnt[cls] = 0.0

	return removed


# Pieces of each wood class in a fire's store (logs left out while a pot hangs over it).
func _fire_store_pieces(fire: Dictionary, box) -> Dictionary:
	var fuel: Dictionary = _cooking.get("fuel", {})
	var pieces: Dictionary = {"log": 0, "firewood": 0, "weak": 0}

	for slot in range(box.usable):
		var number: int = box.numbers[slot]

		if number == 0 or not fuel.has(table.id_of(number)):
			continue

		var cls: String = _fire_wood_class(table.id_of(number))

		if cls == "log" and bool(fire.get("pot", false)):
			continue

		pieces[cls] = int(pieces[cls]) + int(box.counts[slot])

	return pieces


# A burnt-out fire's store keeps no wood: the trim leaves the last piece until the fire is out, and it must not come back as fresh burn time. Food stays.
func _fire_clear_wood(box) -> bool:
	var fuel: Dictionary = _cooking.get("fuel", {})
	var removed: bool = false

	for slot in range(box.usable):
		if box.numbers[slot] != 0 and fuel.has(table.id_of(box.numbers[slot])):
			box.take_from_slot(slot, box.counts[slot])
			removed = true

	return removed


# Closing a fire's store (Dave 2 Nov 2026): the burn time and the tier are worked out again from the wood in it. An empty store means no burn time: a burning
# fire goes out, a laid one is empty. The player is told the result.
func _sync_fire_from_box(peer: int, id: int) -> void:
	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not it.has("fire"):
		return

	var fire: Dictionary = it["fire"]
	var box = _chests.get(int(fire.get("uid", 0)))

	if box == null or not bool(fire.get("synced", false)):
		return

	_fire_apply_store(fire, box)
	fire["fed"] = int(fire.get("fed", 0)) + 1   # the row is sent again, so the client's burn timer shows the new time (Dave 2 Nov 2026: it stayed at the old time, counting down)
	var state: int = int(fire["state"])

	if float(fire["burn_left"]) <= 0.0:
		if fire_is_lit(state):
			_fire_burnt_out(it, fire)   # the last wood taken out of a burning fire: what is left is its coals (or cold ash)
		elif state == 9:
			fire["state"] = 8
			it["left"] = FIRE_OUT_S

		if peer > 0:   # 0: a station drew fuel from it by itself (fuel_taken), nobody to tell
			_say(peer, "There is no wood in the fire.")
	else:
		if state == 8:
			fire["state"] = 9
			it["left"] = FIRE_LAID_S
		elif fire_is_lit(state):
			fire["state"] = _fire_restate(fire)

		var secs: int = int(ceil(float(fire["burn_left"])))
		var size: String = ["small", "medium", "large"][_fire_tier_of_state(int(fire["state"]) if fire_is_lit(int(fire["state"])) else _fire_best_state(fire)) - 1]

		if peer > 0:   # 0: a station drew fuel from it by itself (fuel_taken), nobody to tell
			_say(peer, "Wood on the fire: %d:%02d:%02d of burn time, a %s fire." % [floori(secs / 3600.0), floori(secs / 60.0) % 60, secs % 60, size])

	_dirty = true


# Wood or food a fire's store accepts.
func _fire_takes(item_id: String) -> bool:
	return StoreRules.fire_takes(item_id, _cooking)


# Once every couple of seconds: wood in the store feeds a fire that is nearly out (or loads a cold one), and raw food on a lit fire cooks, one item per box_cook_s.
func _tend_fire(id: int, _it: Dictionary, fire: Dictionary, delta: float) -> void:
	if not fire.has("uid") or not _chests.has(int(fire["uid"])):
		return

	fire["tend"] = float(fire.get("tend", 0.0)) - delta

	if float(fire["tend"]) > 0.0:
		return

	fire["tend"] = 2.0
	var box = _chests[int(fire["uid"])]

	if not fire_is_lit(int(fire["state"])):
		return

	fire["cook_t"] = float(fire.get("cook_t", 0.0)) + 2.0

	if float(fire["cook_t"]) < float(_cooking.get("box_cook_s", 8.0)):
		return

	for slot in range(box.usable):
		if box.numbers[slot] != 0 and _cookable(table.id_of(box.numbers[slot])):
			fire["cook_t"] = 0.0
			var raw: Dictionary = box.take_from_slot(slot, 1)
			var cooked: int = table.number_of(str(_cooking.get("cooks_into", {}).get(table.id_of(int(raw["number"])), _cooking.get("gives", "roast_forage"))))

			if box.add(cooked, 1, _cooked_age(raw, cooked)) > 0:
				box.add(int(raw["number"]), 1, int(raw.get("wear", 0)))

			_dirty = true
			_push_box(id, box)
			return


# Sends fresh contents to whoever has this container open and still stands beside it.
func _push_box(id: int, box, skip_peer: int = 0) -> void:
	if not send_chest.is_valid():
		return

	for peer in _chest_viewer:
		if peer != skip_peer and int(_chest_viewer[peer]) == id and _peer_pos.has(peer) and _peer_pos[peer].distance_to(_items[id]["pos"]) <= CHEST_REACH_M and _may_access(peer, _items[id]):
			send_chest.call(peer, id, box.to_bytes())


func _chest_of(peer: int, id: int):
	if id < 0:
		return _worn_bag(peer, -1 - id)   # a worn bag (protocol 109): the container id is -1 - its worn position

	var it: Dictionary = _items.get(id, {})

	if it.is_empty() or not _peer_pos.has(peer):
		return null

	if it.has("fire"):
		return _fire_box(peer, it)

	if not it.has("struct") or not it["struct"].has("uid"):
		return null

	if _peer_pos[peer].distance_to(it["pos"]) > CHEST_REACH_M:
		return null

	if _smithies.broken(id):
		_say(peer, "Needs repair")   # a worn-out smithy's store stays shut, its contents kept, until a hammer repairs it (master s2.2 item 9)
		return null

	if str(it["struct"]["kind"]) == "remains" and not _may_open_remains(peer, it):
		_say(peer, "These remains are not yours to open yet.")
		return null

	if not _may_access(peer, it):
		_send_lock_info(peer, id)   # locked to this player: no contents, the client asks for the code (open, put, take, Take all and Store all all come here)
		return null

	if not _platter_mine(peer, it):   # a Serving Platter opens to its owner only (set a board out, take it back); everyone else eats with E
		_say(peer, "Only the one who set out this platter puts a board on it or takes it back. Press E to eat a portion.")
		return null

	var chest = _chests.get(int(it["struct"]["uid"]))

	if chest != null:
		var def: Dictionary = _structures.get(str(it["struct"]["kind"]), {})
		# A take-only store (a body's remains) never takes anything in, and holds the whole pack it came from, which may have grown past its
		# slots (protocol 116): every slot is in use, so Take all reaches them all.
		chest.usable = chest.slot_count if bool(def.get("take_only", false)) else _store_usable(str(it["struct"]["kind"]), chest)

		if bool(def.get("fish_trap", false)):
			_fish_trap_catch_up(id, it, chest)   # its hours are fished when someone comes to look

	return chest


func _chest_action(peer: int, inv, kind: int, a: int, id: int, count: int, target: int = -1) -> void:
	if kind == Net.ACT_CHEST_OPEN:
		id = a

	var chest = _chest_of(peer, id)

	if chest == null:
		return

	if kind == Net.ACT_CHEST_OPEN:
		var was_open: int = int(_chest_viewer.get(peer, 0))

		if was_open != id:
			var was_tier: int = _lit_tier_at(was_open)
			_sync_fire_from_box(0, was_open)   # another window opened over a fire's: that fire counts its wood as on a close
			_goal_fire_tier(peer, was_open, was_tier)

		_chest_viewer[peer] = id
		var opened: Dictionary = _items.get(id, {})

		if _is_storage(opened) and str(opened["struct"].get("owner", "")) == "" and str(_peer_key.get(peer, "")) != "":
			opened["struct"]["owner"] = str(_peer_key[peer])   # a container from before owners belongs to the first player who opens it (8 Nov 2026)
			_dirty = true

	# A fire with no count yet (loaded, or older than the count) is counted now, before anything is put in: wood put in later is not counted, so
	# burned time can never take it (Tyler's run of #85: the trim's own fallback counted the newly put log, and the old burn time ate it).
	var chest_fire: Dictionary = _items.get(id, {}).get("fire", {})

	if bool(chest_fire.get("synced", false)) and not chest_fire.has("counted"):
		chest_fire["counted"] = _fire_store_pieces(chest_fire, chest)

	# Remains hold the dead character's purse: whoever may open them takes it with the first opening.
	var rec_struct: Dictionary = _items.get(id, {}).get("struct", {})

	if kind != Net.ACT_CHEST_PUT and str(rec_struct.get("kind", "")) == "remains" and int(rec_struct.get("coins", 0)) > 0:
		for pair in purse_breakdown(int(rec_struct["coins"])):   # the remains keep the purse's worth (a world row number), found as the fewest coins
			_add_coin(peer, str(pair[0]), int(pair[1]), "pickup")

		rec_struct["coins"] = 0
		_dirty = true

	if kind == Net.ACT_CHEST_PUT and a == -1:   # slot -1 was the log on the shoulder: it is now the pack slot that holds it
		a = _shoulder_slot(peer)

	var fire_refuses: bool = kind == Net.ACT_CHEST_PUT and _items.get(id, {}).has("fire") and a >= 0 and a < inv.slot_count and inv.numbers[a] != 0 and not _fire_takes(table.id_of(inv.numbers[a]))

	if fire_refuses:
		_say(peer, "A fire takes wood and food.")
		_reject(peer, 3)
	elif kind == Net.ACT_CHEST_PUT:
		_box_put(peer, inv, id, chest, a, count, target)
	elif kind == Net.ACT_CHEST_TAKE:
		_box_take(peer, inv, chest, a, count, id < 0)

	# Wood moved in or out of a fire's store counts at once (Dave 5 Nov 2026), not only when the window closes: the burn time, the tier and the laid state follow.
	# A burning fire waits for the window to close (its burn debt must not take wood put in meanwhile, test_fire_store); a fire that is not burning has no debt.
	if (kind == Net.ACT_CHEST_PUT or kind == Net.ACT_CHEST_TAKE) and _items.get(id, {}).has("fire") and not fire_is_lit(int(_items[id]["fire"]["state"])):
		_sync_fire_from_box(peer, id)

	if send_chest.is_valid():
		send_chest.call(peer, id, chest.to_bytes())

		if (kind == Net.ACT_CHEST_PUT or kind == Net.ACT_CHEST_TAKE) and id >= 0 and _items.has(id):
			_push_box(id, chest, peer)   # a friend with the same chest or fire open sees the change too, not a stale slot they then click

	if kind == Net.ACT_CHEST_OPEN:
		_send_chest_info(peer, id)   # after the contents, so the client knows which container it is about
		_send_autoload_info(peer, id)
		_send_lock_info(peer, id)   # a lockable container: its lock as this player sees it (the owner's lock controls)
		_say_cold_store(peer, id)

	if kind == Net.ACT_CHEST_TAKE and str(_items.get(id, {}).get("struct", {}).get("kind", "")) == "remains":
		_sync_remains(peer, false)


# One put from pack slot `a` into container `id` (its inventory `chest`), up to `count`: the container's own rules (take-only, what it takes,
# its slots; a vehicle's payload). The caller has already checked reach and access (_chest_of, or a storage view's _view_boxes). Returns how many went in.
# `target`: the store slot the stack was dragged onto (-1: none). Only a smelter reads it: Coal or Charcoal dragged onto an Advanced smelter's
# input goes in as steel carbon (server_smelter.part_for).
func _box_put(peer: int, inv, id: int, chest, a: int, count: int, target: int = -1) -> int:
	var kind: String = str(_items.get(id, {}).get("struct", {}).get("kind", ""))

	if bool(_structures.get(kind, {}).get("take_only", false)):
		_say(peer, "Nothing goes back in here: you can only take from it.")   # remains and a carcass (structures.json take_only): a drag in was only the refusal sound
		_reject(peer, 3)
		return 0

	if a < 0 or a >= inv.slot_count or inv.numbers[a] == 0 or count <= 0:
		return 0

	var number: int = inv.numbers[a]

	if not _box_takes(kind, number):
		_say(peer, "The %s does not take that." % table.in_sentence(table.name_of(int(_items[id]["number"]))))
		_reject(peer, 3)
		return 0

	if _water_blocks_goods(id):   # a tank that is a store holds water or goods, never both (PLUMBING_DESIGN s9, PV-6); a Water barrel holds both
		_say(peer, "It holds water. Drink or draw it off first.")
		_reject(peer, 3)
		return 0

	var bag_no: String = _bag_refusal(peer, id, number) if id < 0 else ""   # a worn bag (container -1 - worn position): no bag in a bag, and its bag_takes

	if bag_no != "":
		_say(peer, bag_no)
		_reject(peer, 3)
		return 0

	var held_wear: int = inv.wear[a]
	var held_inst: Dictionary = inv.inst_of(a)
	var amount: int = mini(count, inv.counts[a])
	var smelter: bool = id >= 0 and _smelters.is_smelter(_structures.get(kind, {}))

	if smelter:   # a Smelter's hopper holds smelt.hopper units of fuel and its input smelt.input units of ore (master s2.7)
		amount = _smelters.room(_structures[kind], chest, number, amount, target)

		if amount == 0:
			_say(peer, _smelters.refusal(_structures[kind], chest, number, target))
			_reject(peer, 3)
			return 0

	var smithy: bool = id >= 0 and _fuel_slot_kind(_structures.get(kind, {}))

	if smithy and _smithy_slot_refusal(_structures[kind], number, target) != "":   # a smithy's fuel slot holds its fuel only
		_say(peer, _smithy_slot_refusal(_structures[kind], number, target))
		_reject(peer, 3)
		return 0

	if id >= 0 and BinRules.is_bin(_structures.get(kind, {})):   # a resource bin holds one kind, up to its units (master s2.5, R6)
		amount = BinRules.room(_structures[kind], chest, number, amount)

		if amount == 0:
			_say(peer, BinRules.refusal(_structures[kind], chest, number, table))
			_reject(peer, 3)
			return 0

	if id >= 0 and int(_structures.get(kind, {}).get("batch_logs", 0)) > 0:   # a kiln holds wood worth batch_logs logs, the piece in the burn included (master s2.6)
		amount = _kiln_room(id, chest, number, amount)

		if amount == 0:
			_say(peer, "The kiln is full: it holds %d logs' worth of wood." % int(_structures[kind]["batch_logs"]))
			_reject(peer, 3)
			return 0

	if id < 0:
		amount = mini(amount, BagRules.room(table, _bag_number(peer, id), chest))   # a quiver holds its ammo_capacity of arrows

	# A storage container has no weight limit, only its slots (Dave 19 Nov 2026: "chests ... shouldn't" have one). Only a vehicle's store, or a crate
	# riding on one, stays within the vehicle's payload (its structures.json max_kg, server_carts.room_kg): put what fits, keep the rest. A bag weighs with what it holds.
	var cart_room: float = _carts.room_kg(id) if id >= 0 else INF

	if cart_room < INF and not _carry_cfg.is_empty():
		var each: float = maxf(CarryRules.weight_of(table.id_of(number), _carry_cfg) + CarryRules.bag_kg(held_inst, table, _carry_cfg), 0.001)
		amount = clampi(int(floor(cart_room / each + 0.0001)), 0, amount)

		if amount == 0:
			_say(peer, "The %s cannot carry more." % _carts.noun_for(id))
			_reject(peer, 2)

	var left: int = 0

	if amount > 0:
		if smelter:
			left = _smelters.put(_structures[kind], chest, number, amount, held_wear, held_inst, target)
		elif smithy:
			left = _smithy_add(_structures[kind], chest, number, amount, held_wear, held_inst)
		else:
			left = chest.add(number, amount, held_wear, held_inst)

	inv.take_from_slot(a, amount - left)
	_dirty = true

	if amount > 0 and left == amount and id >= 0:
		_say(peer, "The %s is full." % table.in_sentence(table.name_of(int(_items[id]["number"]))))
		_reject(peer, 2)

	if amount > left and id >= 0 and not smelter and not smithy and not BinRules.is_bin(_structures.get(kind, {})) and int(_structures.get(kind, {}).get("batch_logs", 0)) == 0 and not _is_station_store(_items[id]):
		_goal_stored(peer, number, amount - left)   # put by hand into a storage container (a basket, sack, jar, barrel, crate, chest): the stored_item_any checks

	if amount > left and id >= 0:
		if bool(_structures.get(kind, {}).get("lockable", false)):
			_goal_event_act(peer, "stored_item")   # ADD-13: once per act (Store all and a view deposit put many stacks); items went into a chest or crate (structures.json lockable: the chests and crates), not a fire, smelter, kiln or bin
		elif str(_structures.get(kind, {}).get("use", "")) == "serve":
			_goal_event_act(peer, "platter_served")   # ADD-21: once per act; a food board set out on a Serving platter (it stands on a table, _place), by its owner (_platter_mine)

	return amount - left


# One take of up to `count` from container slot `a` into the pack (a large log onto the shoulder, one at a time, two at most), under the carry cap.
# The caller has already checked reach and access. Returns how many came out. `weighed`: out of a worn bag, whose load is carried already.
func _box_take(peer: int, inv, chest, a: int, count: int, weighed: bool = false) -> int:
	if a < 0 or a >= chest.slot_count or chest.numbers[a] == 0 or count <= 0:
		return 0

	var number: int = chest.numbers[a]
	var held_wear: int = chest.wear[a]
	var held_inst: Dictionary = chest.inst_of(a)
	var amount: int = mini(count, chest.counts[a])

	if is_shoulder_item(number):   # a large log goes on the shoulder, never into the pack
		if _shoulder_full(peer):
			_say(peer, CarryRules.logs_full_say(_carry_cfg))
		elif _give_shoulder(peer, number, 1, held_inst, false) == 1:
			chest.take_from_slot(a, 1)
			_dirty = true
			return 1

		return 0

	var asked: int = amount
	amount = amount if weighed else _fit(peer, inv, number, amount, held_inst)   # a full bag weighs with its contents

	if amount < asked:
		_say(peer, "Too heavy to carry any more" if amount == 0 else "Too heavy: you took %d of %d" % [amount, asked])

	var left: int = inv.add(number, amount, held_wear, held_inst)
	chest.take_from_slot(a, amount - left)
	_dirty = true
	return amount - left


# Whether a container kind takes an item (structures.json "takes_kinds": items.json kinds, "takes": item ids or ingredient groups, any member).
# A kind with neither takes anything (master s3.13: a log rack takes logs, a wardrobe clothes).
func _box_takes(kind: String, number: int) -> bool:
	var def: Dictionary = _structures.get(kind, {})
	return StoreRules.takes(def, number, table) and ((str(def.get("use", "")) != "tap" and not bool(def.get("fills_containers", false))) or _container_cap(number) > 0)   # a tap and a Water barrel take water containers only


func _save_chests() -> void:
	var rows: Dictionary = {}

	for uid in _chests:
		rows[str(uid)] = _chests[uid].to_json_array()

	_write_atomic("chests.json", {"version": 1, "next_uid": _next_uid, "chests": rows, "seed_pinch": true})


# A kit item that was dropped from the game: kits are gone, only the rough bed and the campfire are still made in the pack (Dave 4 Nov 2026).
func is_dead_kit(number: int) -> bool:
	return number > 0 and bool(table.entry(table.id_of(number)).get("retired", false)) and table.id_of(number).ends_with("_kit")


# Empty every slot that holds a dropped kit.
func _strip_dead_kits(inv) -> void:
	for slot in inv.slot_count:
		if is_dead_kit(inv.numbers[slot]):
			inv.clear_slot(slot)


func _load_chests() -> void:
	var parsed: Variant = _read_json_version("chests.json", 1)

	if parsed == null:
		return

	_old_seed_files["stores"] = not bool(parsed.get("seed_pinch", false))
	_next_uid = int(parsed.get("next_uid", 1))

	for key in parsed.get("chests", {}):
		var chest = InventoryScript.new(table)
		chest.from_json_array(parsed["chests"][key])
		_strip_dead_kits(chest)
		_chests[int(key)] = chest


# --- Hunger, health and body weight (data/items/vitals.json; Dave 2026-10-20) ---
# An energy balance: a stomach (kcal) is burnt down by rest metabolism plus work; an empty stomach
# burns body weight, a surplus beyond a full one adds it. The player sees hunger as the stomach's
# share in percent, health in points and weight in tenths of a kilo.

# How many of `count` more of an item the player can carry before the hard cap (weights.json). `item_inst`: a bag weighs with what it holds.
func _fit(peer: int, inv, number: int, count: int, item_inst: Dictionary = {}) -> int:
	if _carry_cfg.is_empty():
		return count

	var body: float = _carry_body(peer)
	var carried: float = _pack_kg(inv) + _shoulder_kg(peer) + _worn_bags_kg(peer) + CarryRules.bag_kg(item_inst, table, _carry_cfg)
	return CarryRules.fit_count(table.id_of(number), count, carried, body, _carry_cfg)


# Into the pack as many as the carry limit allows, the rest dropped at `at` (the player's feet when INF); returns how many went in. A pack grows
# (protocol 116), so weight is what stops a gain: what a player gathers (litter, mining, boulders, fish, cooking) goes through here or give().
# What the game hands back or awards (a piece taken down, a handcart taken apart, a goal reward) is given whatever the load, as before.
func _take_in(peer: int, inv, number: int, count: int, item_wear: int = 0, at: Vector3 = Vector3.INF) -> int:
	var fits: int = _fit(peer, inv, number, count)
	var left: int = inv.add(number, fits, item_wear) + (count - fits)

	if left > 0:   # a cooked roast the pack cannot take never despawns, as give()'s crafted overflow
		drop_in_world(number, left, _peer_pos.get(peer, Vector3.ZERO) if at == Vector3.INF else at, item_wear, CLEARED_LIFETIME_S if _gain_source == SRC_CRAFT else 0.0)

	if _gain_source == SRC_PICKUP:   # litter, mining, boulders, fish (goal got: counter); a cooked roast is tagged craft
		_goal_got(peer, number, count)

	return count - left


# The whole load: the pack (with the bags in it) and what the worn bags hold (worn pieces themselves weigh nothing, as before).
func carried_kg_of(peer: int) -> float:
	if _in_vitals and _kg_cache.has(peer):
		return float(_kg_cache[peer])

	var inv = inventory_of(peer)
	var kg: float = (_pack_kg(inv) + _shoulder_kg(peer) + _worn_bags_kg(peer)) if inv != null and not _carry_cfg.is_empty() else 0.0

	if _in_vitals:
		_kg_cache[peer] = kg   # the carry notice and the load ratio both weigh the pack each tick (load test 23 Nov: 15 ms a second at 32 players)

	return kg


# CarryRules.carried_kg with each item number's weight looked up once (weight_of walks the by_suffix list for most items): the same sum in the
# same order. test_vitals_tick_cost compares the two.
func _pack_kg(inv) -> float:
	if not is_same(_unit_kg_cfg, _carry_cfg) or not is_same(_unit_kg_table, table):
		_unit_kg.clear()
		_unit_kg_cfg = _carry_cfg
		_unit_kg_table = table

	var total: float = 0.0

	for slot in range(inv.usable):
		var number: int = inv.numbers[slot]

		if number == 0:
			continue

		if not _unit_kg.has(number):
			var id: String = table.id_of(number)
			_unit_kg[number] = [CarryRules.weight_of(id, _carry_cfg), int(table.entry(id).get("capacity_ml", 0)) > 0]

		var unit: Array = _unit_kg[number]
		var kg: float = float(unit[0]) * float(inv.counts[slot])

		if bool(unit[1]):
			kg += float(inv.wear[slot]) / 1000.0

		total += kg + CarryRules.bag_kg(inv.inst[slot], table, _carry_cfg)

	return total


func _worn_bags_kg(peer: int) -> float:
	var total: float = 0.0

	for raw in _characters.get(_peer_key.get(peer, ""), {}).get("worn", []):
		if typeof(raw) == TYPE_ARRAY and (raw as Array).size() > 3 and typeof(raw[3]) == TYPE_DICTIONARY:
			total += CarryRules.bag_kg(raw[3], table, _carry_cfg)

	return total


# Migration rule 10 (CATALOG_SAVE_MIGRATION.md): a player over the carry limit is slowed (the client's walk), never stripped, and told once.
func _carry_notice(peer: int) -> void:
	if _carry_cfg.is_empty():
		return

	var over: bool = carried_kg_of(peer) > CarryRules.cap_kg(_carry_body(peer), _carry_cfg) + CarryRules.SLACK_KG

	if over and not _over_cap.has(peer):
		_over_cap[peer] = true
		_say(peer, "You carry more than you can. It slows you down until you put something down.")
	elif not over:
		_over_cap.erase(peer)


func vitals_of(peer: int) -> Dictionary:
	return _vitals.get(_peer_key.get(peer, ""), {})


# ACT_NEW_PLAYER: the admin's own character starts over as a brand new player, to test the early game as a newcomer sees it. No teleport.
func _become_new_player(peer: int) -> void:
	var key: String = str(_peer_key.get(peer, ""))

	if key == "":
		return

	_inventories[key] = InventoryScript.pack(table)
